# WebAssembly (WASI) platform layer for time: there is no local zone, so it
# is UTC, and named zones come from TZif files when the host lends the
# program the database's folder.

import os;
import "zone";

[Target(OS(Wasi))]
_time_sys_local_offset(seconds: long): int {
    return 0;
}

[Target(OS(Wasi))]
_time_sys_named(name: String): Result<TimeZone> {
    return _time_zone_from_database(name, os.environment("TZDIR").value_or("/usr/share/zoneinfo"));
}

[Target(OS(Wasi))]
_time_sys_icu_offset(name: String, seconds: long): int {
    return 0;
}
time/sys_windows
4282
# Windows platform layer for time: the local zone through
# SystemTimeToTzSpecificLocalTime, and named (IANA) zones through the ICU
# that Windows 10 version 1903 and later ship as icu.dll.

import os;
import "civil";
import "zone";

[Target(OS(Windows))]
extern int SystemTimeToTzSpecificLocalTime(void* zone, ushort* universal, ushort* local);
[Target(OS(Windows))]
[Link("icu")]
extern void* ucal_open(ushort* zone, int length, char* locale, int calendar_type, int* status);
[Target(OS(Windows))]
[Link("icu")]
extern void ucal_setMillis(void* calendar, double milliseconds, int* status);
[Target(OS(Windows))]
[Link("icu")]
extern int ucal_get(void* calendar, int field, int* status);
[Target(OS(Windows))]
[Link("icu")]
extern void ucal_close(void* calendar);
[Target(OS(Windows))]
[Link("icu")]
extern int ucal_getCanonicalTimeZoneID(
    ushort* id, int length, ushort* result, int capacity, char* is_system, int* status
);

# SYSTEMTIME reaches the years 1601 to 30827.
const FIRST_SECOND: long = -11644473600;
const LAST_SECOND: long = 910692730000;

# The local offset at `seconds`: SYSTEMTIME in UTC through the zone in
# Windows' settings, and the difference read back.
[Target(OS(Windows))]
_time_sys_local_offset(seconds: long): int {
    var clamped = seconds < FIRST_SECOND ? FIRST_SECOND : (seconds > LAST_SECOND ? LAST_SECOND : seconds);
    var universal = DateTime.from_unix_seconds(clamped);
    # wYear, wMonth, wDayOfWeek, wDay, wHour, wMinute, wSecond, wMilliseconds
    __ptr<u16> parts = _pep_malloc(32);
    parts[0] = universal.year as u16;
    parts[1] = universal.month as u16;
    parts[2] = ((universal.weekday() as int) % 7) as u16;
    parts[3] = universal.day as u16;
    parts[4] = universal.hour as u16;
    parts[5] = universal.minute as u16;
    parts[6] = universal.second as u16;
    parts[7] = 0;
    var offset = 0;
    if (SystemTimeToTzSpecificLocalTime(__null, parts, parts + 8) != 0) {
        var local = DateTime(
            parts[8] as int, parts[9] as int, parts[11] as int, parts[12] as int, parts[13] as int, parts[14] as int
        );
        offset = (local.unix_seconds() - clamped) as int;
    }
    _pep_free(parts);
    return offset;
}

# The zone's name as NUL-terminated UTF-16; zone names are ASCII.
[Target(OS(Windows))]
_time_wide_name(name: String): __ptr<u16> {
    __ptr<u16> wide = _pep_malloc((name.size + 1) * 2);
    for (var i in 0..name.size) {
        wide[i] = name.byte_at(i) as u16;
    }
    wide[name.size] = 0;
    return wide;
}

# A database folder named by TZDIR wins over ICU, as on Linux and macOS.
[Target(OS(Windows))]
_time_sys_named(name: String): Result<TimeZone> {
    var folder = os.environment("TZDIR");
    if (!folder.is_empty()) {
        return _time_zone_from_database(name, folder.value());
    }
    var wide = _time_wide_name(name);
    __ptr<u16> canonical = _pep_malloc(512);
    __ptr<char> is_system = _pep_malloc(1);
    __ptr<int> status = _pep_malloc(4);
    status[0] = 0;
    ucal_getCanonicalTimeZoneID(wide, -1, canonical, 256, is_system, status);
    var known = status[0] <= 0 && is_system[0] != 0;
    _pep_free(status);
    _pep_free(is_system);
    _pep_free(canonical);
    _pep_free(wide);
    if (!known) {
        return Result<TimeZone>.err(Error($"unknown time zone '{name}'"));
    }
    return Result<TimeZone>.ok(TimeZone._from_icu(name));
}

# UCAL_GREGORIAN is 1; UCAL_ZONE_OFFSET 15 and UCAL_DST_OFFSET 16, in
# milliseconds.
[Target(OS(Windows))]
_time_sys_icu_offset(name: String, seconds: long): int {
    var wide = _time_wide_name(name);
    __ptr<int> status = _pep_malloc(4);
    status[0] = 0;
    var offset = 0;
    var calendar = ucal_open(wide, -1, __null, 1, status);
    if (status[0] <= 0 && calendar != __null) {
        ucal_setMillis(calendar, (seconds as double) * 1000.0, status);
        var zone = ucal_get(calendar, 15, status);
        var daylight = ucal_get(calendar, 16, status);
        if (status[0] <= 0) {
            offset = (zone + daylight) / 1000;
        }
    }
    if (calendar != __null) {
        ucal_close(calendar);
    }
    _pep_free(status);
    _pep_free(wide);
    return offset;
}
time/zone
21990
## Time zones: `TimeZone`, the rules that give an instant's offset from UTC,
## for UTC, a fixed offset, the system's local zone, or a named zone such as
## `Europe/Paris` from the system's time zone database; and `now()`.

import io;
import os;
import "civil";
import "offset";
import "sys_posix";
import "sys_wasi";
import "sys_windows";

const KIND_FIXED: int = 0;
const KIND_LOCAL: int = 1;
const KIND_RULES: int = 2;
const KIND_ICU: int = 3;

## The rules that give the offset from UTC at each instant in one place:
## UTC, a fixed offset, the system's local time zone, or a named zone from
## the IANA time zone database, such as `Europe/Paris` or
## `America/New_York`, with its daylight saving time and its history.
##
## Named zones come from the system's database, nothing is bundled: the
## files under `/usr/share/zoneinfo` on Linux and macOS, and ICU's
## (`icu.dll`, Windows 10 version 1903 and later) on Windows. On every
## system, a folder of database files that the `TZDIR` environment variable
## names takes their place. Leap seconds are ignored, as in Unix time.
##
## A zone is a reference, and it does not change once made, so copies share
## it.
##
## @example
##     import os;
##     import time;
##
##     main(): int {
##         var paris = time.TimeZone.named("Europe/Paris").value();
##         var instant = time.OffsetDateTime.parse("2024-07-14T10:00:00Z").value();
##         print(paris.at(instant.to_system_time()));   # 2024-07-14T12:00:00+02:00
##         var local = paris.at_local(time.DateTime(2024, 12, 25, 18, 0));
##         print(local.offset);                         # +01:00
##         return 0;
##     }
export struct TimeZone {
    ## The zone's name: `UTC`, `Local`, the offset of a fixed zone
    ## (`+05:30`), or the database name of a named one (`Europe/Paris`).
    var name: String { get; }
    var _kind: int;
    var _fixed: int;
    # A named zone's history (KIND_RULES): the UTC seconds at which each
    # offset starts, the offset (seconds east) from each, the offset before
    # the first, and the POSIX TZ rule for the times after the last.
    var _starts: long[];
    var _offsets: int[];
    var _initial: int;
    var _rule: _TimeRule;

    ## Makes UTC; the same as `TimeZone.utc()`.
    construct() {
        name = "UTC";
        _kind = KIND_FIXED;
        _fixed = 0;
        _starts = Array<long>();
        _offsets = Array<int>();
        _initial = 0;
        _rule = _TimeRule();
    }

    ## Returns UTC.
    ##
    ## @returns the zone whose offset is always zero
    static utc(): TimeZone {
        return TimeZone();
    }

    ## Returns a zone whose offset is always `offset`.
    ##
    ## @param offset the offset from UTC
    ## @returns the zone, named after the offset (`+05:30`)
    static fixed(offset: Offset): TimeZone {
        var zone = TimeZone();
        zone.name = offset.to_string();
        zone._fixed = offset.seconds;
        return zone;
    }

    ## Returns the system's local time zone, as the C library's `localtime`
    ## sees it: the `TZ` environment variable or `/etc/localtime` on Linux
    ## and macOS, and the zone in Windows' settings. WebAssembly (WASI) has
    ## no local zone, so it is UTC there.
    ##
    ## @returns the local zone, named `Local`
    static local(): TimeZone {
        var zone = TimeZone();
        zone.name = "Local";
        zone._kind = KIND_LOCAL;
        return zone;
    }

    ## Returns the zone `name` from the system's time zone database, such
    ## as `Europe/Paris`, `America/New_York` or `Asia/Kolkata`, or an error
    ## when the system does not know it. `UTC` is always known.
    ##
    ## @param name the IANA name of the zone, which is case-sensitive
    ## @returns the zone, or an error saying it was not found
    static named(name: String): Result<TimeZone> {
        if (name == "UTC") {
            return Result<TimeZone>.ok(TimeZone());
        }
        if (!_time_is_zone_name(name)) {
            return Result<TimeZone>.err(Error($"invalid time zone name '{name}'"));
        }
        return _time_sys_named(name);
    }

    static _from_rules(name: String, starts: long[], offsets: int[], initial: int, rule: _TimeRule): TimeZone {
        var zone = TimeZone();
        zone.name = name;
        zone._kind = KIND_RULES;
        zone._starts = starts;
        zone._offsets = offsets;
        zone._initial = initial;
        zone._rule = rule;
        return zone;
    }

    static _from_icu(name: String): TimeZone {
        var zone = TimeZone();
        zone.name = name;
        zone._kind = KIND_ICU;
        return zone;
    }

    ## Returns the offset from UTC in this zone at `time`.
    ##
    ## @param time the instant
    ## @returns the offset in effect then
    offset_at(time: os.SystemTime): Offset {
        return Offset(_offset_at(time.unix_seconds()));
    }

    # The offset, in seconds east, at `seconds` since the Unix epoch.
    _offset_at(seconds: long): int {
        if (_kind == KIND_FIXED) {
            return _fixed;
        }
        if (_kind == KIND_LOCAL) {
            return _time_sys_local_offset(seconds);
        }
        if (_kind == KIND_ICU) {
            return _time_sys_icu_offset(name, seconds);
        }
        # The last start at or before `seconds`.
        var count = _starts.count;
        if (count == 0 || seconds < _starts[0]) {
            return count == 0 && _rule.is_set ? _rule.offset_at(seconds) : _initial;
        }
        ulong low = 0;
        ulong high = count;
        while (high - low > 1) {
            var middle = low + (high - low) / 2;
            if (_starts[middle] <= seconds) {
                low = middle;
            } else {
                high = middle;
            }
        }
        if (low == count - 1 && _rule.is_set) {
            return _rule.offset_at(seconds);
        }
        return _offsets[low];
    }

    ## Returns the date and time in this zone at `time`.
    ##
    ## @param time the instant
    ## @returns its local date and time, with the offset in effect
    ## @example
    ##     var here = time.TimeZone.local().at(os.SystemTime.now());
    at(time: os.SystemTime): OffsetDateTime {
        return OffsetDateTime.from_system_time(time, offset_at(time));
    }

    ## Returns the instant that a local date and time names in this zone,
    ## with its offset.
    ##
    ## Where the clocks go back, a local time happens twice; this returns
    ## the earlier, at the offset from before the change. Where they go
    ## forward, a local time never happens; this moves it forward by the
    ## length of the gap, so 02:30 on a night that skips from 02:00 to
    ## 03:00 is 03:30. This is what Java's `ZonedDateTime.of` does.
    ##
    ## @param local the date and time on the zone's clocks
    ## @returns the date and time with the zone's offset at that instant
    at_local(local: DateTime): OffsetDateTime {
        var wall = local.unix_seconds();
        # The offsets a day either side cover any one change of the clocks.
        var before = _offset_at(wall - 86400);
        var after = _offset_at(wall + 86400);
        var first = wall - before;
        var second = wall - after;
        var first_fits = _offset_at(first) == before;
        var second_fits = _offset_at(second) == after;
        int offset = before;
        if (first_fits && second_fits) {
            offset = first < second ? before : after;
        } else if (second_fits) {
            offset = after;
        } else if (!first_fits) {
            # A gap: read the time at the offset from before it, which lands
            # after it.
            offset = _offset_at(first);
            var moved = DateTime.from_unix_seconds(first + offset, local.nanosecond);
            return OffsetDateTime(moved, Offset(offset));
        }
        return OffsetDateTime(local, Offset(offset));
    }
}

## Returns the current date and time in the system's local time zone.
##
## @returns now, at the local offset
## @example
##     print(time.now());   # such as 2024-03-01T09:00:00.123456789+01:00
export now(): OffsetDateTime {
    return TimeZone.local().at(os.SystemTime.now());
}

## Returns the current date and time in UTC.
##
## @returns now, at offset zero
export now_utc(): OffsetDateTime {
    return OffsetDateTime.from_system_time(os.SystemTime.now());
}

# Letters, digits, '_', '-', '+' and '/', with no empty, '.' or '..' part:
# a name that cannot leave the database's folder.
_time_is_zone_name(name: String): bool {
    if (name.is_empty || name.size > 255 || name.starts_with("/") || name.ends_with("/")) {
        return false;
    }
    for (var part in name.split("/")) {
        if (part.is_empty || part == "." || part == "..") {
            return false;
        }
    }
    var data = name.bytes();
    for (var c in data) {
        var ok = (c >= 'a' && c <= 'z')
            || (c >= 'A' && c <= 'Z')
            || (c >= '0' && c <= '9')
            || c == '_'
            || c == '-'
            || c == '+'
            || c == '/';
        if (!ok) {
            return false;
        }
    }
    return true;
}

# ── TZif files (RFC 8536) ────────────────────────────────────────────────────

# A named zone from the files of the time zone database under `folder`.
_time_zone_from_database(name: String, folder: String): Result<TimeZone> {
    var read = io.File.read_bytes(io.Path($"{folder}/{name}"));
    if (read.is_err()) {
        return Result<TimeZone>.err(Error($"unknown time zone '{name}'"));
    }
    var zone = _time_parse_tzif(name, read.value());
    if (zone.is_empty()) {
        return Result<TimeZone>.err(Error($"unknown time zone '{name}': not a TZif file"));
    }
    return Result<TimeZone>.ok(zone.value());
}

# A big-endian signed integer of `size` bytes at `at`.
_time_big_endian(data: u8[], at: ulong, size: ulong): long {
    ulong value = 0;
    for (var i in 0..size) {
        value = (value << 8) | data[at + i];
    }
    if (size < 8 && value >= (1 as ulong) << (size * 8 - 1)) {
        return (value as long) - ((1 as long) << (size * 8));
    }
    return value as long;
}

# The zone in a TZif file: the version 2+ block of 64-bit times and the TZ
# rule after it, or the version 1 block of a version 1 file.
_time_parse_tzif(name: String, data: u8[]): TimeZone? {
    var none = Optional<TimeZone>.Empty;
    if (data.count < 44 || data[0] != 'T' || data[1] != 'Z' || data[2] != 'i' || data[3] != 'f') {
        return none;
    }
    var version = data[4];
    ulong at = 0;
    ulong time_size = 4;
    if (version >= '2') {
        # Skip the version 1 header and block.
        var skip = _time_tzif_block_size(data, 0, 4);
        if (skip < 0) {
            return none;
        }
        at = skip as ulong;
        time_size = 8;
        if (data.count < at + 44) {
            return none;
        }
    }
    var block = _time_tzif_block_size(data, at, time_size);
    if (block < 0) {
        return none;
    }
    var time_count = _time_big_endian(data, at + 32, 4) as ulong;
    var type_count = _time_big_endian(data, at + 36, 4) as ulong;
    var times_at = at + 44;
    var indices_at = times_at + time_count * time_size;
    var types_at = indices_at + time_count;
    if (type_count == 0) {
        return none;
    }
    var type_offsets = Array<int>();
    for (var i in 0..type_count) {
        type_offsets.append(_time_big_endian(data, types_at + i * 6, 4) as int);
    }
    var starts = Array<long>();
    var offsets = Array<int>();
    for (var i in 0..time_count) {
        var index = data[indices_at + i] as ulong;
        if (index >= type_count) {
            return none;
        }
        starts.append(_time_big_endian(data, times_at + i * time_size, time_size));
        offsets.append(type_offsets[index]);
    }
    var rule = _TimeRule();
    var end = block as ulong;
    if (time_size == 8 && end < data.count && data[end] == '\n') {
        var rule_end = end + 1;
        while (rule_end < data.count && data[rule_end] != '\n') {
            rule_end = rule_end + 1;
        }
        var text = Array<u8>();
        for (var i in end + 1..rule_end) {
            text.append(data[i]);
        }
        rule = _time_parse_rule(String._from_bytes(text));
    }
    return Optional<TimeZone>.Value(TimeZone._from_rules(name, starts, offsets, type_offsets[0], rule));
}

# The offset just past a TZif header and data block at `at`, or -1 when the
# data is too short.
_time_tzif_block_size(data: u8[], at: ulong, time_size: ulong): long {
    if (data.count < at + 44) {
        return -1;
    }
    var is_ut_count = _time_big_endian(data, at + 20, 4);
    var is_standard_count = _time_big_endian(data, at + 24, 4);
    var leap_count = _time_big_endian(data, at + 28, 4);
    var time_count = _time_big_endian(data, at + 32, 4);
    var type_count = _time_big_endian(data, at + 36, 4);
    var character_count = _time_big_endian(data, at + 40, 4);
    var size = (at as long)
        + 44
        + time_count * (time_size as long)
        + time_count
        + type_count * 6
        + character_count
        + leap_count * ((time_size as long) + 4)
        + is_standard_count
        + is_ut_count;
    if (size > data.count as long) {
        return -1;
    }
    return size;
}

# ── POSIX TZ rules ───────────────────────────────────────────────────────────

# A POSIX TZ string's rule, such as `CET-1CEST,M3.5.0,M10.5.0/3`: standard
# and daylight saving offsets (seconds east), and the dates the change
# happens on.
struct _TimeRule {
    var is_set: bool;
    var standard: int;
    var daylight: int;
    var has_daylight: bool;
    var start: _TimeRuleDate;
    var end: _TimeRuleDate;

    construct() {
        is_set = false;
        standard = 0;
        daylight = 0;
        has_daylight = false;
        start = _TimeRuleDate();
        end = _TimeRuleDate();
    }

    offset_at(seconds: long): int {
        if (!has_daylight) {
            return standard;
        }
        var (year, month, day) = _time_civil_from_days(_time_floor_divide(seconds + standard, 86400));
        var begins = start.seconds_in(year as int) - standard;
        var ends = end.seconds_in(year as int) - daylight;
        if (begins < ends) {
            return seconds >= begins && seconds < ends ? daylight : standard;
        }
        return seconds >= ends && seconds < begins ? standard : daylight;
    }
}

# One of a rule's dates: `Jn` (kind 'J', n from 1 to 365, never February
# 29), `n` (kind 'n', from 0 to 365), or `Mm.w.d` (kind 'M': weekday d,
# Sunday 0, of week w, 5 meaning the last, of month m); then the local time
# of the change, in seconds.
[Value]
struct _TimeRuleDate {
    var kind: int;
    var month: int;
    var week: int;
    var day: int;
    var time: long;

    construct() {
        kind = 'M';
        month = 1;
        week = 1;
        day = 0;
        time = 7200;
    }

    # Seconds from the epoch to this date's change in `year`, on the local
    # clock (as if it were UTC).
    seconds_in(year: int): long {
        long days = 0;
        if (kind == 'J') {
            days = _time_days_from_civil(year, 1, 1) + day - 1;
            if (is_leap_year(year) && day >= 60) {
                days = days + 1;
            }
        } else if (kind == 'n') {
            days = _time_days_from_civil(year, 1, 1) + day;
        } else {
            var first = _time_days_from_civil(year, month, 1);
            # 1970-01-01 was a Thursday: day 4 counting from Sunday.
            var first_weekday = _time_floor_modulo(first + 4, 7);
            var offset = _time_floor_modulo(day - first_weekday, 7) + 7 * (week - 1);
            var length = days_in_month(year, month);
            while (offset >= length) {
                offset = offset - 7;
            }
            days = first + offset;
        }
        return days * 86400 + time;
    }
}

# Reads a POSIX TZ string; an empty or unreadable one gives a rule that is
# not set.
_time_parse_rule(text: String): _TimeRule {
    var rule = _TimeRule();
    var parser = _TimeRuleParser(text);
    if (!parser.name()) {
        return rule;
    }
    var standard = parser.clock();
    if (standard.is_empty()) {
        return rule;
    }
    # POSIX offsets count west of UTC.
    rule.standard = (0 - standard.value()) as int;
    if (parser.at_end()) {
        rule.is_set = true;
        return rule;
    }
    if (!parser.name()) {
        return rule;
    }
    rule.has_daylight = true;
    rule.daylight = rule.standard + 3600;
    if (!parser.at_end() && parser.peek() != ',') {
        var daylight = parser.clock();
        if (daylight.is_empty()) {
            return rule;
        }
        rule.daylight = (0 - daylight.value()) as int;
    }
    if (parser.at_end()) {
        # The US rule, which POSIX leaves to the implementation.
        rule.start = _time_rule_date('M', 3, 2, 0, 7200);
        rule.end = _time_rule_date('M', 11, 1, 0, 7200);
        rule.is_set = true;
        return rule;
    }
    if (!parser.take(',')) {
        return rule;
    }
    var start = parser.date();
    if (start.is_empty() || !parser.take(',')) {
        return rule;
    }
    var end = parser.date();
    if (end.is_empty() || !parser.at_end()) {
        return rule;
    }
    rule.start = start.value();
    rule.end = end.value();
    rule.is_set = true;
    return rule;
}

_time_rule_date(kind: int, month: int, week: int, day: int, time: long): _TimeRuleDate {
    var date = _TimeRuleDate();
    date.kind = kind;
    date.month = month;
    date.week = week;
    date.day = day;
    date.time = time;
    return date;
}

struct _TimeRuleParser {
    var _data: u8[];
    var _index: ulong;

    construct(text: String) {
        _data = text.bytes();
        _index = 0;
    }

    at_end(): bool {
        return _index >= _data.count;
    }

    peek(): int {
        return at_end() ? -1 : _data[_index] as int;
    }

    take(c: int): bool {
        if (peek() != c) {
            return false;
        }
        _index = _index + 1;
        return true;
    }

    # A zone abbreviation: three or more letters, or `<...>` (`<+0530>`).
    name(): bool {
        if (take('<')) {
            while (!at_end() && peek() != '>') {
                _index = _index + 1;
            }
            return take('>');
        }
        var count = 0;
        while (true) {
            var c = peek();
            if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'))) {
                break;
            }
            _index = _index + 1;
            count = count + 1;
        }
        return count >= 3;
    }

    # A number of one or more digits, or -1.
    number(): long {
        long value = -1;
        while (peek() >= '0' && peek() <= '9') {
            value = (value < 0 ? 0 : value * 10) + (peek() - '0');
            _index = _index + 1;
        }
        return value;
    }

    # [+-]hh[:mm[:ss]] in seconds; hours reach 167, as TZif's rules allow.
    clock(): long? {
        long sign = 1;
        if (take('-')) {
            sign = -1;
        } else {
            take('+');
        }
        var hours = number();
        if (hours < 0 || hours > 167) {
            return Optional<long>.Empty;
        }
        long minutes = 0;
        long seconds = 0;
        if (take(':')) {
            minutes = number();
            if (minutes < 0 || minutes > 59) {
                return Optional<long>.Empty;
            }
            if (take(':')) {
                seconds = number();
                if (seconds < 0 || seconds > 59) {
                    return Optional<long>.Empty;
                }
            }
        }
        return Optional<long>.Value(sign * (hours * 3600 + minutes * 60 + seconds));
    }

    # Jn, n or Mm.w.d, then an optional /time.
    date(): _TimeRuleDate? {
        var none = Optional<_TimeRuleDate>.Empty;
        var date = _TimeRuleDate();
        if (take('J')) {
            date.kind = 'J';
            var day = number();
            if (day < 1 || day > 365) {
                return none;
            }
            date.day = day as int;
        } else if (take('M')) {
            var month = number();
            if (month < 1 || month > 12 || !take('.')) {
                return none;
            }
            var week = number();
            if (week < 1 || week > 5 || !take('.')) {
                return none;
            }
            var day = number();
            if (day < 0 || day > 6) {
                return none;
            }
            date.month = month as int;
            date.week = week as int;
            date.day = day as int;
        } else {
            date.kind = 'n';
            var day = number();
            if (day < 0 || day > 365) {
                return none;
            }
            date.day = day as int;
        }
        if (take('/')) {
            var time = clock();
            if (time.is_empty()) {
                return none;
            }
            date.time = time.value();
        }
        return Optional<_TimeRuleDate>.Value(date);
    }
}
tls/module
1642
## Encrypted connections: TLS 1.2 and 1.3 over TCP, for clients and servers.
##
## Bring it in with `import tls`. A `TlsConnector` opens client connections
## and checks each server's certificate; a `TlsAcceptor` accepts connections
## with a certificate and key from PEM files; a `TlsStream` reads and writes
## like an `io.TcpStream`. In a task, a call that has to wait parks only the
## task.
##
## On Linux and macOS the module uses OpenSSL 3, loaded when the first
## connector or acceptor is made; on Windows it uses SChannel. On Android
## the program links a static OpenSSL 3 that the toolchain carries, and a
## connector trusts the system's certificate store. On iOS it uses
## the system's Security.framework (Secure Transport, TLS 1.2), for clients
## only: there `TlsAcceptor.create` and `TlsConnector.set_identity` return
## an error.
##
## - [Streams](tls-stream.md): `TlsConnector`, `TlsAcceptor`, and `TlsStream`
##
## @example
##     import tls;
##
##     main(): int {
##         var connector = tls.TlsConnector.create().value();
##         var stream = connector.connect_host("localhost", 8443).value();
##         stream.write_all("ping");
##         var reply = Array<u8>();
##         while (stream.read(reply, 4096).value() > 0) {
##         }
##         return 0;
##     }

# This file only gathers the module's public API from its other files. The
# platform layer (`_tls_sys_*` in openssl.pep, schannel.pep and
# securetransport.pep) is exported
# between the tls files but not from the module.

import "stream";

export TlsConnector;
export TlsAcceptor;
export TlsStream;
tls/openssl
32531
# The OpenSSL 3 layer for tls on Linux, Android and macOS. Every declaration
# carries [Target(OS(Linux) || (OS(Mac) && !OS(IOS)))] or a narrower target,
# except the few helpers securetransport.pep shares on iOS ([Target(OS(Linux)
# || OS(Mac))]); schannel.pep, securetransport.pep and wasi.pep declare the
# same `_tls_sys_*` functions for Windows, iOS and WASI.
#
# libssl is opened at run time (dlopen) the first time a context is made, so
# a program that imports tls links against nothing extra and needs no
# library search path for Homebrew's OpenSSL. `_OpenSsl` holds the functions
# it uses as C function pointers. Android has no libssl to open: a program
# links a static OpenSSL there, and openssl_android.pep's `_tls_symbol` and
# `_tls_openssl_paths` stand in for the ones here.
#
# The connection's bytes go through a custom BIO whose read and write call
# the io socket layer (`_io_sys_socket_receive` / `_send`). Those wait when
# the socket would block, parking a task inside the callback, so OpenSSL
# never sees SSL_ERROR_WANT_READ/WRITE and every call here reads like
# blocking code. An io error in a callback (a reset, a cancelled task) is
# kept in the session and returned in place of OpenSSL's report.

import async;
import io;
import "openssl_android";
import "schannel";
import "securetransport";
import "wasi";

[Target(OS(Linux))]
[Link("dl")]
extern void* dlopen(char* path, int flags);
[Target(OS(Linux) || OS(Mac))]
extern void* dlsym(void* handle, char* name);

# The libssl names to try, in order.
[Target(OS(Linux) && !OS(Android))]
_tls_openssl_paths(): String[] {
    return ["libssl.so.3"];
}

[Target(OS(Mac))]
extern void* dlopen(char* path, int flags);

[Target(OS(Mac) && !OS(IOS))]
_tls_openssl_paths(): String[] {
    return [
        "/opt/homebrew/opt/openssl@3/lib/libssl.3.dylib",
        "/usr/local/opt/openssl@3/lib/libssl.3.dylib",
        "/opt/local/lib/libssl.3.dylib",
        "libssl.3.dylib",
    ];
}

# The OpenSSL functions tls calls, or none when libssl could not be opened.
[Target(OS(Linux) || (OS(Mac) && !OS(IOS)))]
[Shared]
struct _OpenSsl {
    # Whether libssl was found; every other field is null otherwise.
    const _loaded: bool;
    const _client_method: extern () => __ptr<void>;
    const _server_method: extern () => __ptr<void>;
    const _context_new: extern (__ptr<void>) => __ptr<void>;
    const _context_free: extern (__ptr<void>) => void;
    const _context_ctrl: extern (__ptr<void>, int, long, __ptr<void>) => long;
    const _context_set_options: extern (__ptr<void>, ulong) => ulong;
    const _context_default_roots: extern (__ptr<void>) => int;
    const _context_set_verify: extern (__ptr<void>, int, __ptr<void>) => void;
    const _context_load_roots: extern (__ptr<void>, __ptr<void>, __ptr<void>) => int;
    const _context_use_chain: extern (__ptr<void>, __ptr<void>) => int;
    const _context_use_key: extern (__ptr<void>, __ptr<void>, int) => int;
    const _context_check_key: extern (__ptr<void>) => int;
    const _context_set_client_names: extern (__ptr<void>, __ptr<void>) => void;
    const _context_set_session_id: extern (__ptr<void>, __ptr<void>, uint) => int;
    const _load_client_names: extern (__ptr<void>) => __ptr<void>;
    const _ssl_new: extern (__ptr<void>) => __ptr<void>;
    const _ssl_free: extern (__ptr<void>) => void;
    const _ssl_ctrl: extern (__ptr<void>, int, long, __ptr<void>) => long;
    const _ssl_set_bio: extern (__ptr<void>, __ptr<void>, __ptr<void>) => void;
    const _ssl_set_host: extern (__ptr<void>, __ptr<void>) => int;
    const _ssl_param: extern (__ptr<void>) => __ptr<void>;
    const _ssl_connect: extern (__ptr<void>) => int;
    const _ssl_accept: extern (__ptr<void>) => int;
    const _ssl_read: extern (__ptr<void>, __ptr<void>, int) => int;
    const _ssl_write: extern (__ptr<void>, __ptr<void>, int) => int;
    const _ssl_shutdown: extern (__ptr<void>) => int;
    const _ssl_error: extern (__ptr<void>, int) => int;
    const _ssl_verify_result: extern (__ptr<void>) => long;
    const _param_set_ip: extern (__ptr<void>, __ptr<void>) => int;
    const _verify_error_string: extern (long) => __ptr<void>;
    const _error_get: extern () => ulong;
    const _error_string: extern (ulong, __ptr<void>, ulong) => void;
    const _error_clear: extern () => void;
    const _bio_method_new: extern (int, __ptr<void>) => __ptr<void>;
    const _bio_method_set_write: extern (__ptr<void>, __ptr<void>) => int;
    const _bio_method_set_read: extern (__ptr<void>, __ptr<void>) => int;
    const _bio_method_set_ctrl: extern (__ptr<void>, __ptr<void>) => int;
    const _bio_new_index: extern () => int;
    const _bio_new: extern (__ptr<void>) => __ptr<void>;
    const _bio_set_data: extern (__ptr<void>, __ptr<void>) => void;
    const _bio_get_data: extern (__ptr<void>) => __ptr<void>;
    const _bio_set_init: extern (__ptr<void>, int) => void;
    const _context_set_alpn_protos: extern (__ptr<void>, __ptr<void>, uint) => int;
    const _context_set_alpn_select: extern (__ptr<void>, __ptr<void>, __ptr<void>) => void;
    const _select_next_proto: extern (__ptr<void>, __ptr<void>, __ptr<void>, uint, __ptr<void>, uint) => int;
    const _ssl_alpn_selected: extern (__ptr<void>, __ptr<void>, __ptr<void>) => void;
    const _context_set_data: extern (__ptr<void>, int, __ptr<void>) => int;
    const _context_get_data: extern (__ptr<void>, int) => __ptr<void>;
    # The BIO_meth_set_* setters take the callbacks as untyped addresses
    # (`__function_pointer`): a C function pointer type as a parameter of
    # another is reported as an unknown type.
    # The BIO_METHOD every connection's BIO uses, made once.
    const _bio_method: __ptr<void>;

    construct() {
        var handle: __ptr<void> = __null;
        for (var path in _tls_openssl_paths()) {
            handle = dlopen(path.c_str(), 2);  # RTLD_NOW
            if (handle != __null) {
                break;
            }
        }
        _loaded = handle != __null;
        if (_loaded) {
            _client_method = _tls_symbol(handle, "TLS_client_method") as extern () => __ptr<void>;
            _server_method = _tls_symbol(handle, "TLS_server_method") as extern () => __ptr<void>;
            _context_new = _tls_symbol(handle, "SSL_CTX_new") as extern (__ptr<void>) => __ptr<void>;
            _context_free = _tls_symbol(handle, "SSL_CTX_free") as extern (__ptr<void>) => void;
            _context_ctrl = _tls_symbol(handle, "SSL_CTX_ctrl") as extern (__ptr<void>, int, long, __ptr<void>) => long;
            _context_set_options = _tls_symbol(handle, "SSL_CTX_set_options") as extern (__ptr<void>, ulong) => ulong;
            _context_default_roots = _tls_symbol(
                handle, "SSL_CTX_set_default_verify_paths"
            ) as extern (__ptr<void>) => int;
            _context_set_verify = _tls_symbol(
                handle, "SSL_CTX_set_verify"
            ) as extern (__ptr<void>, int, __ptr<void>) => void;
            _context_load_roots = _tls_symbol(
                handle, "SSL_CTX_load_verify_locations"
            ) as extern (__ptr<void>, __ptr<void>, __ptr<void>) => int;
            _context_use_chain = _tls_symbol(
                handle, "SSL_CTX_use_certificate_chain_file"
            ) as extern (__ptr<void>, __ptr<void>) => int;
            _context_use_key = _tls_symbol(
                handle, "SSL_CTX_use_PrivateKey_file"
            ) as extern (__ptr<void>, __ptr<void>, int) => int;
            _context_check_key = _tls_symbol(handle, "SSL_CTX_check_private_key") as extern (__ptr<void>) => int;
            _context_set_client_names = _tls_symbol(
                handle, "SSL_CTX_set_client_CA_list"
            ) as extern (__ptr<void>, __ptr<void>) => void;
            _context_set_session_id = _tls_symbol(
                handle, "SSL_CTX_set_session_id_context"
            ) as extern (__ptr<void>, __ptr<void>, uint) => int;
            _load_client_names = _tls_symbol(handle, "SSL_load_client_CA_file") as extern (__ptr<void>) => __ptr<void>;
            _ssl_new = _tls_symbol(handle, "SSL_new") as extern (__ptr<void>) => __ptr<void>;
            _ssl_free = _tls_symbol(handle, "SSL_free") as extern (__ptr<void>) => void;
            _ssl_ctrl = _tls_symbol(handle, "SSL_ctrl") as extern (__ptr<void>, int, long, __ptr<void>) => long;
            _ssl_set_bio = _tls_symbol(handle, "SSL_set_bio") as extern (__ptr<void>, __ptr<void>, __ptr<void>) => void;
            _ssl_set_host = _tls_symbol(handle, "SSL_set1_host") as extern (__ptr<void>, __ptr<void>) => int;
            _ssl_param = _tls_symbol(handle, "SSL_get0_param") as extern (__ptr<void>) => __ptr<void>;
            _ssl_connect = _tls_symbol(handle, "SSL_connect") as extern (__ptr<void>) => int;
            _ssl_accept = _tls_symbol(handle, "SSL_accept") as extern (__ptr<void>) => int;
            _ssl_read = _tls_symbol(handle, "SSL_read") as extern (__ptr<void>, __ptr<void>, int) => int;
            _ssl_write = _tls_symbol(handle, "SSL_write") as extern (__ptr<void>, __ptr<void>, int) => int;
            _ssl_shutdown = _tls_symbol(handle, "SSL_shutdown") as extern (__ptr<void>) => int;
            _ssl_error = _tls_symbol(handle, "SSL_get_error") as extern (__ptr<void>, int) => int;
            _ssl_verify_result = _tls_symbol(handle, "SSL_get_verify_result") as extern (__ptr<void>) => long;
            _param_set_ip = _tls_symbol(
                handle, "X509_VERIFY_PARAM_set1_ip_asc"
            ) as extern (__ptr<void>, __ptr<void>) => int;
            _verify_error_string = _tls_symbol(handle, "X509_verify_cert_error_string") as extern (long) => __ptr<void>;
            _error_get = _tls_symbol(handle, "ERR_get_error") as extern () => ulong;
            _error_string = _tls_symbol(handle, "ERR_error_string_n") as extern (ulong, __ptr<void>, ulong) => void;
            _error_clear = _tls_symbol(handle, "ERR_clear_error") as extern () => void;
            _bio_method_new = _tls_symbol(handle, "BIO_meth_new") as extern (int, __ptr<void>) => __ptr<void>;
            _bio_method_set_write = _tls_symbol(
                handle, "BIO_meth_set_write"
            ) as extern (__ptr<void>, __ptr<void>) => int;
            _bio_method_set_read = _tls_symbol(handle, "BIO_meth_set_read") as extern (__ptr<void>, __ptr<void>) => int;
            _bio_method_set_ctrl = _tls_symbol(handle, "BIO_meth_set_ctrl") as extern (__ptr<void>, __ptr<void>) => int;
            _bio_new_index = _tls_symbol(handle, "BIO_get_new_index") as extern () => int;
            _bio_new = _tls_symbol(handle, "BIO_new") as extern (__ptr<void>) => __ptr<void>;
            _bio_set_data = _tls_symbol(handle, "BIO_set_data") as extern (__ptr<void>, __ptr<void>) => void;
            _bio_get_data = _tls_symbol(handle, "BIO_get_data") as extern (__ptr<void>) => __ptr<void>;
            _bio_set_init = _tls_symbol(handle, "BIO_set_init") as extern (__ptr<void>, int) => void;
            _context_set_alpn_protos = _tls_symbol(
                handle, "SSL_CTX_set_alpn_protos"
            ) as extern (__ptr<void>, __ptr<void>, uint) => int;
            _context_set_alpn_select = _tls_symbol(
                handle, "SSL_CTX_set_alpn_select_cb"
            ) as extern (__ptr<void>, __ptr<void>, __ptr<void>) => void;
            _select_next_proto = _tls_symbol(
                handle, "SSL_select_next_proto"
            ) as extern (__ptr<void>, __ptr<void>, __ptr<void>, uint, __ptr<void>, uint) => int;
            _ssl_alpn_selected = _tls_symbol(
                handle, "SSL_get0_alpn_selected"
            ) as extern (__ptr<void>, __ptr<void>, __ptr<void>) => void;
            _context_set_data = _tls_symbol(
                handle, "SSL_CTX_set_ex_data"
            ) as extern (__ptr<void>, int, __ptr<void>) => int;
            _context_get_data = _tls_symbol(handle, "SSL_CTX_get_ex_data") as extern (__ptr<void>, int) => __ptr<void>;

            var method_new = _bio_method_new;
            var new_index = _bio_new_index;
            var name = "pepper socket";
            # BIO_TYPE_SOURCE_SINK (0x0400) marks a BIO that ends the chain.
            var method = method_new(new_index() | 1024, name.c_str());
            var set_write = _bio_method_set_write;
            var set_read = _bio_method_set_read;
            var set_ctrl = _bio_method_set_ctrl;
            set_write(method, __function_pointer(_tls_bio_write));
            set_read(method, __function_pointer(_tls_bio_read));
            set_ctrl(method, __function_pointer(_tls_bio_ctrl));
            _bio_method = method;
        }
    }
}

# The address of `name` in the opened library and its dependencies.
[Target((OS(Linux) && !OS(Android)) || OS(Mac))]
_tls_symbol(handle: __ptr<void>, name: String): __ptr<void> {
    return dlsym(handle, name.c_str());
}

[Target(OS(Linux) || (OS(Mac) && !OS(IOS)))]
const _tls_openssl = async.Lazy<_OpenSsl>(() => {
    return _OpenSsl();
});

# ── Sessions ─────────────────────────────────────────────────────────────────
# A session is a malloc'd block of three words: the SSL*, the socket, and a
# slot holding the io error a BIO callback met (null when none). The BIO's
# data points at the block.

[Target(OS(Linux) || OS(Mac))]
_tls_session_ssl(session: __ptr<void>): __ptr<void> {
    __ptr<__ptr<void>> block = session;
    return block[0];
}

[Target(OS(Linux) || OS(Mac))]
_tls_session_error(session: __ptr<void>): __ptr<io.IoError> {
    __ptr<ulong> block = session;
    return unsafe_cast<__ptr<io.IoError>>(block + 2);
}

# The BIO callbacks. Each finds its session through the BIO's data.

[Target(OS(Linux) || (OS(Mac) && !OS(IOS)))]
_tls_bio_session(bio: __ptr<void>): __ptr<void> {
    var get_data = _tls_openssl.get()._bio_get_data;
    return get_data(bio);
}

[Target(OS(Linux) || (OS(Mac) && !OS(IOS)))]
_tls_bio_write(bio: __ptr<void>, data: __ptr<void>, n: int): int {
    var session = _tls_bio_session(bio);
    __ptr<ulong> block = session;
    var r = io._io_sys_socket_send(block[1] as io.SocketHandle, data as __ptr<u8>, n as ulong);
    if (r.is_err()) {
        _tls_session_error(session)[0] = r.error();
        return -1;
    }
    return r.value() as int;
}

[Target(OS(Linux) || (OS(Mac) && !OS(IOS)))]
_tls_bio_read(bio: __ptr<void>, data: __ptr<void>, n: int): int {
    var session = _tls_bio_session(bio);
    __ptr<ulong> block = session;
    var r = io._io_sys_socket_receive(block[1] as io.SocketHandle, data as __ptr<u8>, n as ulong);
    if (r.is_err()) {
        _tls_session_error(session)[0] = r.error();
        return -1;
    }
    return r.value() as int;
}

# Only BIO_CTRL_FLUSH (11) needs an answer: the writes are not buffered.
[Target(OS(Linux) || (OS(Mac) && !OS(IOS)))]
_tls_bio_ctrl(bio: __ptr<void>, command: int, number: long, pointer: __ptr<void>): long {
    return command == 11 ? 1 : 0;
}

# ── Errors ───────────────────────────────────────────────────────────────────

# EPROTO: the code of every TLS error.
[Target(OS(Linux))]
_tls_sys_code_protocol(): io.ErrorCode { return 71; }

[Target(OS(Mac))]
_tls_sys_code_protocol(): io.ErrorCode { return 100; }

[Target(OS(Linux) || OS(Mac))]
_tls_error(message: String): io.IoError {
    return io.IoError(_tls_sys_code_protocol(), message);
}

# The oldest error in OpenSSL's queue, with `what` in front; clears the
# queue.
[Target(OS(Linux) || (OS(Mac) && !OS(IOS)))]
_tls_openssl_error(what: String): io.IoError {
    var ssl = _tls_openssl.get();
    var get = ssl._error_get;
    var text = ssl._error_string;
    var clear = ssl._error_clear;
    var code = get();
    clear();
    if (code == 0) {
        return _tls_error(what);
    }
    __ptr<char> buffer = _pep_malloc(256);
    text(code, buffer, 256);
    var message = $"{what}: {String(buffer)}";
    _pep_free(buffer);
    return _tls_error(message);
}

# Why an SSL call on `session` that returned `rc` failed: the io error a
# callback met, the certificate check's reason, or OpenSSL's.
[Target(OS(Linux) || (OS(Mac) && !OS(IOS)))]
_tls_session_failure(session: __ptr<void>, rc: int, what: String): io.IoError {
    var ssl = _tls_openssl.get();
    var slot = _tls_session_error(session);
    if (slot[0] != __null) {
        var e = slot[0];
        slot[0] = __default<io.IoError>();
        var clear = ssl._error_clear;
        clear();
        return e;
    }
    var verify_result = ssl._ssl_verify_result;
    var verified = verify_result(_tls_session_ssl(session));
    if (verified != 0) {
        var reason = ssl._verify_error_string;
        var clear = ssl._error_clear;
        clear();
        return _tls_error($"certificate verify failed: {String(reason(verified) as __ptr<char>)}");
    }
    return _tls_openssl_error(what);
}

# ── Contexts ─────────────────────────────────────────────────────────────────

[Target(OS(Linux) || (OS(Mac) && !OS(IOS)))]
_tls_openssl_loaded(): io.IoResult<_OpenSsl> {
    var ssl = _tls_openssl.get();
    if (!ssl._loaded) {
        var names = "";
        for (var path in _tls_openssl_paths()) {
            names = names.size > 0 ? $"{names}, {path}" : path;
        }
        return io.IoResult<_OpenSsl>.err(_tls_error($"OpenSSL 3 was not found (tried {names})"));
    }
    return io.IoResult<_OpenSsl>.ok(ssl);
}

# A new SSL_CTX for TLS 1.2 and later, or null.
[Target(OS(Linux) || (OS(Mac) && !OS(IOS)))]
_tls_context_new(ssl: _OpenSsl, server: bool): __ptr<void> {
    var method = ssl._client_method;
    if (server) {
        method = ssl._server_method;
    }
    var context_new = ssl._context_new;
    var context = context_new(method());
    if (context == __null) {
        return __null;
    }
    var ctrl = ssl._context_ctrl;
    ctrl(context, 123, 771, __null);  # SSL_CTRL_SET_MIN_PROTO_VERSION, TLS1_2_VERSION
    # SSL_MODE_ENABLE_PARTIAL_WRITE | SSL_MODE_ACCEPT_MOVING_WRITE_BUFFER
    ctrl(context, 33, 3, __null);
    # SSL_OP_IGNORE_UNEXPECTED_EOF: a peer that closes without close_notify
    # ends the stream like a TCP close.
    var set_options = ssl._context_set_options;
    set_options(context, 128);
    return context;
}

# A client context that checks the server's certificate against the
# system's trusted roots.
[Target(OS(Linux) || (OS(Mac) && !OS(IOS)))]
_tls_sys_client_context(): io.IoResult<__ptr<void>> {
    var loaded = _tls_openssl_loaded();
    if (loaded.is_err()) {
        return io.IoResult<__ptr<void>>.err(loaded.error());
    }
    var ssl = loaded.value();
    var context = _tls_context_new(ssl, false);
    if (context == __null) {
        return io.IoResult<__ptr<void>>.err(_tls_openssl_error("cannot create a TLS context"));
    }
    var default_roots = ssl._context_default_roots;
    default_roots(context);
    var set_verify = ssl._context_set_verify;
    set_verify(context, 1, __null);  # SSL_VERIFY_PEER
    return io.IoResult<__ptr<void>>.ok(context);
}

# A server context presenting the PEM certificate chain and private key.
[Target(OS(Linux) || (OS(Mac) && !OS(IOS)))]
_tls_sys_server_context(chain: io.Path, key: io.Path): io.IoResult<__ptr<void>> {
    var loaded = _tls_openssl_loaded();
    if (loaded.is_err()) {
        return io.IoResult<__ptr<void>>.err(loaded.error());
    }
    var ssl = loaded.value();
    var context = _tls_context_new(ssl, true);
    if (context == __null) {
        return io.IoResult<__ptr<void>>.err(_tls_openssl_error("cannot create a TLS context"));
    }
    var used = _tls_use_identity(ssl, context, chain, key);
    if (used.is_err()) {
        var context_free = ssl._context_free;
        context_free(context);
        return io.IoResult<__ptr<void>>.err(used.error());
    }
    return io.IoResult<__ptr<void>>.ok(context);
}

# Makes `context` present the PEM certificate chain and private key.
[Target(OS(Linux) || (OS(Mac) && !OS(IOS)))]
_tls_use_identity(ssl: _OpenSsl, context: __ptr<void>, chain: io.Path, key: io.Path): io.IoResult<void> {
    var use_chain = ssl._context_use_chain;
    var use_key = ssl._context_use_key;
    var check_key = ssl._context_check_key;
    var chain_text = chain.to_string();
    var key_text = key.to_string();
    var failure = "";
    if (use_chain(context, chain_text.c_str()) != 1) {
        failure = $"cannot load the certificate chain '{chain_text}'";
    } else if (use_key(context, key_text.c_str(), 1) != 1) {  # SSL_FILETYPE_PEM
        failure = $"cannot load the private key '{key_text}'";
    } else if (check_key(context) != 1) {
        failure = "the private key does not match the certificate";
    }
    if (failure.size > 0) {
        return io.IoResult<void>.err(_tls_openssl_error(failure));
    }
    return io.IoResult<void>.ok();
}

# Makes a client context present the PEM certificate chain and private key
# to servers that ask for one.
[Target(OS(Linux) || (OS(Mac) && !OS(IOS)))]
_tls_sys_set_identity(context: __ptr<void>, chain: io.Path, key: io.Path): io.IoResult<void> {
    return _tls_use_identity(_tls_openssl.get(), context, chain, key);
}

# Makes a server context ask every client for a certificate issued by one in
# the PEM file `roots`, and fail the handshake without one.
[Target(OS(Linux) || (OS(Mac) && !OS(IOS)))]
_tls_sys_require_client_certificate(context: __ptr<void>, roots: io.Path): io.IoResult<void> {
    var ssl = _tls_openssl.get();
    var load = ssl._context_load_roots;
    var text = roots.to_string();
    if (load(context, text.c_str(), __null) != 1) {
        return io.IoResult<void>.err(_tls_openssl_error($"cannot load the certificates in '{text}'"));
    }
    # The certificate request names the accepted issuers.
    var load_names = ssl._load_client_names;
    var names = load_names(text.c_str());
    if (names != __null) {
        var set_names = ssl._context_set_client_names;
        set_names(context, names);  # takes ownership
    }
    # A server that checks clients must name its sessions for resumption.
    var name = "pepper";
    var set_session_id = ssl._context_set_session_id;
    set_session_id(context, name.c_str(), name.size as uint);
    var set_verify = ssl._context_set_verify;
    set_verify(context, 3, __null);  # SSL_VERIFY_PEER | SSL_VERIFY_FAIL_IF_NO_PEER_CERT
    return io.IoResult<void>.ok();
}

# Also trusts the PEM certificates in `path`.
[Target(OS(Linux) || (OS(Mac) && !OS(IOS)))]
_tls_sys_add_root(context: __ptr<void>, path: io.Path): io.IoResult<void> {
    var ssl = _tls_openssl.get();
    var load = ssl._context_load_roots;
    var text = path.to_string();
    if (load(context, text.c_str(), __null) != 1) {
        return io.IoResult<void>.err(_tls_openssl_error($"cannot load the certificates in '{text}'"));
    }
    return io.IoResult<void>.ok();
}

# Sets the protocols a context offers (a client) or accepts (a server)
# through ALPN: `list` is in the wire format, each name after its length.
[Target(OS(Linux) || (OS(Mac) && !OS(IOS)))]
_tls_sys_set_protocols(context: __ptr<void>, list: u8[], server: bool): io.IoResult<void> {
    var ssl = _tls_openssl.get();
    if (!server) {
        var set_protos = ssl._context_set_alpn_protos;
        if (set_protos(context, list._data, list.count as uint) != 0) {  # 0 is success here
            return io.IoResult<void>.err(_tls_openssl_error("cannot set the ALPN protocols"));
        }
        return io.IoResult<void>.ok();
    }
    # The callback reads the list through its argument: a u32 length, then
    # the list. The context's app data (ex_data 0) holds it too, so that
    # freeing the context frees it.
    _tls_free_protocols(ssl, context);
    __ptr<u8> copy = _pep_malloc(4 + list.count);
    unsafe_cast<__ptr<uint>>(copy)[0] = list.count as uint;
    ulong index = 0;
    while (index < list.count) {
        copy[4 + index] = list[index];
        index += 1;
    }
    var set_data = ssl._context_set_data;
    set_data(context, 0, copy);
    var set_select = ssl._context_set_alpn_select;
    set_select(context, __function_pointer(_tls_alpn_select), copy);
    return io.IoResult<void>.ok();
}

# Frees a server context's copy of its ALPN protocols, if it has one.
[Target(OS(Linux) || (OS(Mac) && !OS(IOS)))]
_tls_free_protocols(ssl: _OpenSsl, context: __ptr<void>) {
    var get_data = ssl._context_get_data;
    var copy = get_data(context, 0);
    if (copy != __null) {
        _pep_free(copy);
        var set_data = ssl._context_set_data;
        set_data(context, 0, __null);
    }
}

# SSL_CTX_set_alpn_select_cb's callback: picks the first of the server's
# protocols (`argument`) that the client offers, or none.
[Target(OS(Linux) || (OS(Mac) && !OS(IOS)))]
_tls_alpn_select(
    connection: __ptr<void>,
    out: __ptr<void>,
    out_size: __ptr<void>,
    offered: __ptr<void>,
    offered_size: uint,
    argument: __ptr<void>
): int {
    __ptr<u8> list = argument;
    var select = _tls_openssl.get()._select_next_proto;
    var size = unsafe_cast<__ptr<uint>>(list)[0];
    # OPENSSL_NPN_NEGOTIATED: SSL_TLSEXT_ERR_OK. With nothing in common,
    # SSL_TLSEXT_ERR_ALERT_FATAL sends no_application_protocol (RFC 7301
    # section 3.2), as SChannel does.
    if (select(out, out_size, list + 4, size, offered, offered_size) == 1) {
        return 0;
    }
    return 2;
}

# The protocol the handshake chose through ALPN, or "" for none.
[Target(OS(Linux) || (OS(Mac) && !OS(IOS)))]
_tls_sys_protocol(session: __ptr<void>): String {
    var selected = _tls_openssl.get()._ssl_alpn_selected;
    __ptr<__ptr<char>> data = _pep_malloc(8);
    __ptr<uint> size = _pep_malloc(4);
    data[0] = __null;
    size[0] = 0;
    selected(_tls_session_ssl(session), data, size);
    var name = "";
    if (size[0] > 0) {
        name = String(data[0], size[0] as ulong);
    }
    _pep_free(size);
    _pep_free(data);
    return name;
}

[Target(OS(Linux) || (OS(Mac) && !OS(IOS)))]
_tls_sys_context_free(context: __ptr<void>) {
    var ssl = _tls_openssl.get();
    _tls_free_protocols(ssl, context);
    var context_free = ssl._context_free;
    context_free(context);
}

# ── Connections ──────────────────────────────────────────────────────────────

# A session for socket `h` on `context`, with its BIO; null on failure.
[Target(OS(Linux) || (OS(Mac) && !OS(IOS)))]
_tls_session_new(context: __ptr<void>, h: io.SocketHandle): __ptr<void> {
    var ssl = _tls_openssl.get();
    var ssl_new = ssl._ssl_new;
    var connection = ssl_new(context);
    if (connection == __null) {
        return __null;
    }
    __ptr<void> session = _pep_malloc(3 * sizeof<ulong>());
    __ptr<__ptr<void>> words = session;
    words[0] = connection;
    __ptr<ulong> numbers = session;
    numbers[1] = h as ulong;
    var bio_new = ssl._bio_new;
    var bio = bio_new(ssl._bio_method);
    var set_data = ssl._bio_set_data;
    var set_init = ssl._bio_set_init;
    set_data(bio, session);
    set_init(bio, 1);
    var set_bio = ssl._ssl_set_bio;
    set_bio(connection, bio, bio);
    return session;
}

# Runs the client handshake on socket `h`, checking that the certificate is
# for `host` (a name, or an IP address).
[Target(OS(Linux) || (OS(Mac) && !OS(IOS)))]
_tls_sys_connect(context: __ptr<void>, h: io.SocketHandle, host: String): io.IoResult<__ptr<void>> {
    var session = _tls_session_new(context, h);
    if (session == __null) {
        return io.IoResult<__ptr<void>>.err(_tls_openssl_error("cannot create a TLS connection"));
    }
    var ssl = _tls_openssl.get();
    var connection = _tls_session_ssl(session);
    if (io.IpAddress.parse(host).is_ok()) {
        var param = ssl._ssl_param;
        var set_ip = ssl._param_set_ip;
        set_ip(param(connection), host.c_str());
    } else {
        var ctrl = ssl._ssl_ctrl;
        ctrl(connection, 55, 0, host.c_str());  # SSL_CTRL_SET_TLSEXT_HOSTNAME: SNI
        var set_host = ssl._ssl_set_host;
        set_host(connection, host.c_str());
    }
    var connect = ssl._ssl_connect;
    var rc = connect(connection);
    if (rc != 1) {
        var e = _tls_session_failure(session, rc, "TLS handshake failed");
        _tls_sys_session_free(session);
        return io.IoResult<__ptr<void>>.err(e);
    }
    return io.IoResult<__ptr<void>>.ok(session);
}

# Runs the server handshake on socket `h`.
[Target(OS(Linux) || (OS(Mac) && !OS(IOS)))]
_tls_sys_accept(context: __ptr<void>, h: io.SocketHandle): io.IoResult<__ptr<void>> {
    var session = _tls_session_new(context, h);
    if (session == __null) {
        return io.IoResult<__ptr<void>>.err(_tls_openssl_error("cannot create a TLS connection"));
    }
    var accept = _tls_openssl.get()._ssl_accept;
    var rc = accept(_tls_session_ssl(session));
    if (rc != 1) {
        var e = _tls_session_failure(session, rc, "TLS handshake failed");
        _tls_sys_session_free(session);
        return io.IoResult<__ptr<void>>.err(e);
    }
    return io.IoResult<__ptr<void>>.ok(session);
}

# Reads up to `n` decrypted bytes into `destination`; 0 at the end of the
# stream.
[Target(OS(Linux) || (OS(Mac) && !OS(IOS)))]
_tls_sys_read(session: __ptr<void>, destination: __ptr<u8>, n: ulong): io.IoResult<ulong> {
    var ssl = _tls_openssl.get();
    var read = ssl._ssl_read;
    var connection = _tls_session_ssl(session);
    var rc = read(connection, destination, _tls_chunk(n));
    if (rc > 0) {
        return io.IoResult<ulong>.ok(rc as ulong);
    }
    var get_error = ssl._ssl_error;
    var kind = get_error(connection, rc);
    if (kind == 6) {  # SSL_ERROR_ZERO_RETURN: the peer sent close_notify
        return io.IoResult<ulong>.ok(0);
    }
    if (kind == 5 && _tls_session_error(session)[0] == __null) {
        # SSL_ERROR_SYSCALL with no io error: the socket reached its end.
        var clear = ssl._error_clear;
        clear();
        return io.IoResult<ulong>.ok(0);
    }
    return io.IoResult<ulong>.err(_tls_session_failure(session, rc, "TLS read failed"));
}

# Encrypts and sends up to `n` bytes from `source`.
[Target(OS(Linux) || (OS(Mac) && !OS(IOS)))]
_tls_sys_write(session: __ptr<void>, source: __ptr<u8>, n: ulong): io.IoResult<ulong> {
    if (n == 0) {
        return io.IoResult<ulong>.ok(0);
    }
    var write = _tls_openssl.get()._ssl_write;
    var rc = write(_tls_session_ssl(session), source, _tls_chunk(n));
    if (rc > 0) {
        return io.IoResult<ulong>.ok(rc as ulong);
    }
    return io.IoResult<ulong>.err(_tls_session_failure(session, rc, "TLS write failed"));
}

# Sends close_notify.
[Target(OS(Linux) || (OS(Mac) && !OS(IOS)))]
_tls_sys_shutdown(session: __ptr<void>): io.IoResult<void> {
    var shutdown = _tls_openssl.get()._ssl_shutdown;
    var rc = shutdown(_tls_session_ssl(session));
    if (rc < 0) {
        return io.IoResult<void>.err(_tls_session_failure(session, rc, "TLS shutdown failed"));
    }
    return io.IoResult<void>.ok();
}

# Frees the SSL (and with it the BIO) and the block.
[Target(OS(Linux) || (OS(Mac) && !OS(IOS)))]
_tls_sys_session_free(session: __ptr<void>) {
    var ssl_free = _tls_openssl.get()._ssl_free;
    ssl_free(_tls_session_ssl(session));
    _tls_session_error(session)[0] = __default<io.IoError>();
    _pep_free(session);
}

# SSL_read and SSL_write take an int count.
[Target(OS(Linux) || (OS(Mac) && !OS(IOS)))]
_tls_chunk(n: ulong): int {
    if (n > 1073741824) {
        return 1073741824;
    }
    return n as int;
}
tls/openssl_android
10257
# The OpenSSL 3 that tls links on Android, under openssl.pep. Every
# declaration carries [Target(OS(Android))].
#
# Android ships no OpenSSL a program may load (its BoringSSL is private to
# the system), so a program for `--target *-android` that imports tls links
# a static OpenSSL built for its ABI: `android/<triple>/libssl.a` and
# `libcrypto.a` beside this file. scripts/openssl-android.sh builds them, the
# openssl-android workflow publishes them, and release-build.sh puts them in
# the toolchain's runtime (a checkout fetches them with that script).
#
# openssl.pep runs unchanged on top: its `_OpenSsl` asks `_tls_symbol` for
# each function by name, which here answers with the linked function
# instead of dlsym, and `libc.so` stands in for libssl as the library it
# opens. SSL_CTX_set_default_verify_paths would read the folder OpenSSL was
# built for, which Android lacks, so its name answers with
# `_tls_android_roots`, which loads Android's trusted roots instead.

import io;
import "openssl";

# The libraries, found beside this file for the target's ABI. libssl needs
# libcrypto after it.
[Target(OS(Android) && Arch(aarch64))]
[Link("ssl", path = "android/aarch64-linux-android")]
[Link("crypto")]
extern void TLS_client_method();
[Target(OS(Android) && Arch(x64))]
[Link("ssl", path = "android/x86_64-linux-android")]
[Link("crypto")]
extern void TLS_client_method();

# The other functions openssl.pep calls. Only their addresses are taken, so
# each is declared without its parameters.
[Target(OS(Android))]
extern void BIO_get_data();
[Target(OS(Android))]
extern void BIO_get_new_index();
[Target(OS(Android))]
extern void BIO_meth_new();
[Target(OS(Android))]
extern void BIO_meth_set_ctrl();
[Target(OS(Android))]
extern void BIO_meth_set_read();
[Target(OS(Android))]
extern void BIO_meth_set_write();
[Target(OS(Android))]
extern void BIO_new();
[Target(OS(Android))]
extern void BIO_set_data();
[Target(OS(Android))]
extern void BIO_set_init();
[Target(OS(Android))]
extern void ERR_clear_error();
[Target(OS(Android))]
extern void ERR_error_string_n();
[Target(OS(Android))]
extern void ERR_get_error();
[Target(OS(Android))]
extern void SSL_CTX_check_private_key();
[Target(OS(Android))]
extern void SSL_CTX_ctrl();
[Target(OS(Android))]
extern void SSL_CTX_free();
[Target(OS(Android))]
extern void SSL_CTX_get_ex_data();
[Target(OS(Android))]
extern void SSL_CTX_load_verify_locations();
[Target(OS(Android))]
extern void SSL_CTX_new();
[Target(OS(Android))]
extern void SSL_CTX_set_alpn_protos();
[Target(OS(Android))]
extern void SSL_CTX_set_alpn_select_cb();
[Target(OS(Android))]
