# The iterator protocol behind `for (var x in source) { ... }`.
#
# A `for` loop calls `source.iterate()` when the source's type declares it
# (Iterable<T>), else drives the source itself when it declares `next()` and
# `current()` (Iterator<T>); anything else is a compile error. The loop is
#
#     var it = source.iterate();      # or `var it = source;`
#     while (it.next()) {
#         var x = it.current();
#         ...
#     }
#
# The loop goes by the methods a type has, so declaring the trait is
# optional; declaring it (`extend Foo with Iterator<int>`) checks the methods
# and lets the type be used as an `Iterator<int>` value.
#
# Every type that declares Iterator<T> gets a copy of each non-generic
# default method, checked and compiled whether called or not, which slows
# every build that uses many iterator types. So every default but `filter`
# and `to_array` is generic (`<TElement=T>` when nothing else is): each
# compiles only where called, and a default that returns an adapter type,
# or needs `+` or `compare`, could not be non-generic anyway.

## Something a `for` loop can step through, one element at a time.
##
## `for (var x in source)` drives a source that declares `next()` and
## `current()` directly: it calls `next()` before each pass and binds
## `current()` to the loop variable while `next()` returns true. A type whose
## `for` loop should go through a separate iterator implements `Iterable<T>`
## instead. A type with neither protocol is a compile error in a `for` loop.
##
## The loop goes by the methods a type has, so declaring the trait is
## optional. Declaring it (`extend Foo with Iterator<int>;`) checks that
## the methods match and lets the type be used as an `Iterator<int>` value,
## which a `for` loop drives through the trait.
##
## @typeParam T the type of the elements produced
## @example
##     struct Countdown {
##         int remaining;
##         int now;
##
##         construct(this.remaining = 0) {}
##
##         bool next() {
##             if (remaining == 0) {
##                 return false;
##             }
##             now = remaining;
##             remaining = remaining - 1;
##             return true;
##         }
##
##         int current() {
##             return now;
##         }
##     }
##
##     extend Countdown with Iterator<int>;
##
##     main(): int {
##         var total = 0;
##         for (int n in Countdown(3)) {
##             total = total + n;   # visits 3, 2, 1
##         }
##         return total;
##     }
## @see Iterable
export trait Iterator<T> {
    ## Advances to the next element.
    ##
    ## The first call moves to the first element, if any. Once it returns
    ## false it must keep returning false.
    ##
    ## @returns true if there is a current element, false when the elements are exhausted
    next(): bool;

    ## Returns the element the last successful `next()` moved to.
    ##
    ## Calling it before the first `next()`, or after `next()` returned false,
    ## is an error; the runtime's iterators panic in that case.
    ##
    ## @returns the current element
    current(): T;

    ## Returns an iterator over `transform` applied to each element, in order.
    ##
    ## Lazy: `transform` runs once per element, as the result is advanced, and
    ## the result advances this iterator. Every type that declares
    ## `Iterator<T>` gets this method.
    ##
    ## @typeParam U the type `transform` returns
    ## @param transform the function applied to each element
    ## @returns a `MapIterator<T, U>` over the transformed elements
    ## @example
    ##     var names = Array<String>();
    ##     for (var size in names.iterate().map((name) => name.size)) {
    ##         print(size);
    ##     }
    map<U>(transform: (T) => U): MapIterator<T, U> {
        return MapIterator<T, U>(this, transform);
    }

    ## Returns an iterator over the elements for which `keep` returns true, in
    ## order.
    ##
    ## Lazy: `keep` runs once per element, as the result is advanced, and the
    ## result advances this iterator. Every type that declares `Iterator<T>`
    ## gets this method.
    ##
    ## @param keep the test an element must pass
    ## @returns a `FilterIterator<T>` over the elements that pass
    ## @example
    ##     var nums = Array<int>();
    ##     for (var even in nums.iterate().filter((n) => n % 2 == 0)) {
    ##         print(even);
    ##     }
    filter(keep: (T) => bool): FilterIterator<T> {
        return FilterIterator<T>(this, keep);
    }

    ## Returns an iterator over the elements paired with their positions:
    ## `(0, first)`, `(1, second)`, and so on.
    ##
    ## Lazy, like `map`. Destructure the pair in the loop to name both parts.
    ## The positions count in `ulong`, like `Array.count`; name another
    ## integer type to count in it (`enumerate<int>()`). Every type that
    ## declares `Iterator<T>` gets this method.
    ##
    ## @typeParam TIndex the integer type of the positions, `ulong` by default
    ## @returns an `EnumerateIterator<T, TIndex>` over `(index, element)` tuples
    ## @example
    ##     var names = ["Ada", "Grace"];
    ##     for (var (i, name) in names.iterate().enumerate()) {
    ##         print($"{i}: {name}");   # 0: Ada, then 1: Grace
    ##     }
    enumerate<TIndex=ulong>(): EnumerateIterator<T, TIndex> {
        return EnumerateIterator<T, TIndex>(this);
    }

    ## Returns an iterator over pairs of this iterator's elements and
    ## `other`'s, in step: `(first, other's first)`, and so on. It stops when
    ## either runs out.
    ##
    ## Lazy, like `map`. Every type that declares `Iterator<T>` gets this
    ## method.
    ##
    ## @typeParam U the type of `other`'s elements
    ## @param other the iterator whose elements form the second half of each pair
    ## @returns a `ZipIterator<T, U>` over `(element, other element)` tuples
    ## @example
    ##     var names = ["Ada", "Grace"];
    ##     var ages = [36, 45];
    ##     for (var (name, age) in names.iterate().zip(ages.iterate())) {
    ##         print($"{name} is {age}");
    ##     }
    zip<U>(other: Iterator<U>): ZipIterator<T, U> {
        return ZipIterator<T, U>(this, other);
    }

    ## Returns an iterator over at most the first `count` elements.
    ##
    ## Lazy, like `map`: it stops after `count` elements, or sooner when this
    ## iterator runs out, and never advances this iterator past them. Every
    ## type that declares `Iterator<T>` gets this method.
    ##
    ## @typeParam TElement the element type, `T` by default
    ## @param count the most elements to yield
    ## @returns a `TakeIterator<T>` over the first `count` elements
    ## @example
    ##     var firsts = (1..>10).take(3).to_array();   # [1, 2, 3]
    take<TElement=T>(count: ulong): TakeIterator<TElement> {
        return TakeIterator<TElement>(this, count);
    }

    ## Returns an iterator over the elements after the first `count`.
    ##
    ## Lazy, like `map`: the first `next()` of the result passes over `count`
    ## elements. When there are no more than `count`, it yields nothing.
    ## Every type that declares `Iterator<T>` gets this method.
    ##
    ## @typeParam TElement the element type, `T` by default
    ## @param count how many elements to pass over
    ## @returns a `SkipIterator<T>` over the rest of the elements
    ## @example
    ##     var rest = (1..>5).skip(3).to_array();   # [4, 5]
    skip<TElement=T>(count: ulong): SkipIterator<TElement> {
        return SkipIterator<TElement>(this, count);
    }

    ## Returns an iterator over this iterator's elements, then `other`'s.
    ##
    ## Lazy, like `map`: `other` is not advanced until this iterator runs
    ## out. Every type that declares `Iterator<T>` gets this method.
    ##
    ## @typeParam TElement the element type, `T` by default
    ## @param other the iterator whose elements follow
    ## @returns a `ChainIterator<T>` over both iterators' elements
    ## @example
    ##     var both = (1..>2).chain(7..>8).to_array();   # [1, 2, 7, 8]
    chain<TElement=T>(other: Iterator<T>): ChainIterator<TElement> {
        return ChainIterator<TElement>(this, other);
    }

    ## Returns an iterator over the elements of the iterators `transform`
    ## returns, one source element after another.
    ##
    ## Lazy, like `map`: `transform` runs on a source element only once the
    ## iterator from the one before it has run out. Every type that declares
    ## `Iterator<T>` gets this method.
    ##
    ## @typeParam U the type of the elements of the iterators `transform` returns
    ## @param transform the function that turns each element into an iterator
    ## @returns a `FlatMapIterator<T, U>` over the elements of those iterators
    ## @example
    ##     var words = ["ab", "cd"];
    ##     var letters = words.iterate().flat_map((w) => w.iterate()).to_array();   # a, b, c, d
    flat_map<U>(transform: (T) => Iterator<U>): FlatMapIterator<T, U> {
        return FlatMapIterator<T, U>(MapIterator<T, Iterator<U>>(this, transform));
    }

    ## Returns an iterator over the leading elements for which `keep`
    ## returns true. It stops at the first element that fails.
    ##
    ## Lazy, like `map`: the failing element is read from this iterator but
    ## not yielded. Every type that declares `Iterator<T>` gets this method.
    ##
    ## @typeParam TElement the element type, `T` by default
    ## @param keep the test the leading elements pass
    ## @returns a `TakeWhileIterator<T>` over the leading elements that pass
    ## @example
    ##     var small = [1, 2, 7, 3].iterate().take_while((n) => n < 5).to_array();   # [1, 2]
    take_while<TElement=T>(keep: (T) => bool): TakeWhileIterator<TElement> {
        return TakeWhileIterator<TElement>(this, keep);
    }

    ## Returns an iterator over the elements from the first one for which
    ## `skip` returns false.
    ##
    ## Lazy, like `map`: the first `next()` of the result passes over the
    ## leading elements that `skip` accepts, and later elements are not
    ## tested. Every type that declares `Iterator<T>` gets this method.
    ##
    ## @typeParam TElement the element type, `T` by default
    ## @param skip the test the leading elements to pass over meet
    ## @returns a `SkipWhileIterator<T>` over the rest of the elements
    ## @example
    ##     var rest = [1, 2, 7, 3].iterate().skip_while((n) => n < 5).to_array();   # [7, 3]
    skip_while<TElement=T>(skip: (T) => bool): SkipWhileIterator<TElement> {
        return SkipWhileIterator<TElement>(this, skip);
    }

    ## Returns an iterator over the first element, then every `step`th one
    ## after it.
    ##
    ## Lazy, like `map`. `step_by(1)` yields every element. Every type that
    ## declares `Iterator<T>` gets this method.
    ##
    ## @typeParam TElement the element type, `T` by default
    ## @param step how far apart the yielded elements are
    ## @returns a `StepByIterator<T>` over every `step`th element
    ## @panics if `step` is 0 ("step_by step must be positive")
    ## @example
    ##     var evens = (0..10).step_by(2).to_array();   # [0, 2, 4, 6, 8]
    step_by<TElement=T>(step: ulong): StepByIterator<TElement> {
        return StepByIterator<TElement>(this, step);
    }

    ## Returns an iterator over the same elements that can also look at the
    ## next one without moving to it, with `peek()`.
    ##
    ## Lazy, like `map`. Every type that declares `Iterator<T>` gets this
    ## method.
    ##
    ## @typeParam TElement the element type, `T` by default
    ## @returns a `PeekableIterator<T>` over the elements
    ## @example
    ##     var it = [1, 2].iterate().peekable();
    ##     var ahead = it.peek();   # Value(1); `it` has not moved
    peekable<TElement=T>(): PeekableIterator<TElement> {
        return PeekableIterator<TElement>(this);
    }

    ## Returns an iterator over the elements in arrays of `size`, in order.
    ## The last array is shorter when the elements do not divide evenly.
    ##
    ## Lazy, like `map`: each array is filled as the result is advanced. Each
    ## is a new `Array`, so keeping one is safe. Every type that declares
    ## `Iterator<T>` gets this method.
    ##
    ## @typeParam TElement the element type, `T` by default
    ## @param size the most elements each array holds
    ## @returns a `ChunksIterator<T>` over arrays of up to `size` elements
    ## @panics if `size` is 0 ("chunks size must be positive")
    ## @example
    ##     var rows = (1..>5).chunks(2).to_array();   # [[1, 2], [3, 4], [5]]
    chunks<TElement=T>(size: ulong): ChunksIterator<TElement> {
        return ChunksIterator<TElement>(this, size);
    }

    ## Returns an iterator over every run of `size` consecutive elements:
    ## the first `size`, then the run starting one later, and so on. With
    ## fewer than `size` elements it yields nothing.
    ##
    ## Lazy, like `map`. Each run is a new `Array`, so keeping one is safe.
    ## Every type that declares `Iterator<T>` gets this method.
    ##
    ## @typeParam TElement the element type, `T` by default
    ## @param size how many elements each run holds
    ## @returns a `WindowsIterator<T>` over arrays of `size` elements
    ## @panics if `size` is 0 ("windows size must be positive")
    ## @example
    ##     var pairs = (1..>4).windows(2).to_array();   # [[1, 2], [2, 3], [3, 4]]
    windows<TElement=T>(size: ulong): WindowsIterator<TElement> {
        return WindowsIterator<TElement>(this, size);
    }

    ## Returns a new `Array` holding the remaining elements, in order.
    ##
    ## Runs the iteration to the end. Like the adapters, it works on a copy
    ## of the iterator, so a value iterator (every runtime iterator is one)
    ## is left where it was. Every type that declares `Iterator<T>` gets this
    ## method.
    ##
    ## @returns the elements, possibly none
    ## @example
    ##     var evens = (1..>10).filter((n) => n % 2 == 0).to_array();   # [2, 4, 6, 8, 10]
    to_array(): Array<T> {
        # A copy: a value iterator is left where it was.
        Iterator<T> source = this;
        var result = Array<T>();
        while (source.next()) {
            result.append(source.current());
        }
        return result;
    }

    ## Returns how many elements remain.
    ##
    ## Runs the iteration to the end, on a copy of the iterator, like
    ## `to_array`. Every type that declares `Iterator<T>` gets this method.
    ##
    ## @typeParam TElement the element type, `T` by default
    ## @returns the number of elements, possibly 0
    ## @example
    ##     var evens = (1..>10).filter((n) => n % 2 == 0).count();   # 5
    count<TElement=T>(): ulong {
        Iterator<T> source = this;
        ulong result = 0;
        while (source.next()) {
            result += 1;
        }
        return result;
    }

    ## Combines the elements into one value: `combine(initial, first)`, then
    ## `combine` of that and the second element, and so on.
    ##
    ## Runs the iteration to the end, on a copy of the iterator, like
    ## `to_array`. Every type that declares `Iterator<T>` gets this method.
    ##
    ## @typeParam U the type of the combined value
    ## @param initial the value to start from, returned as is when there are no elements
    ## @param combine the function that folds one more element into the value so far
    ## @returns the value after every element is folded in
    ## @example
    ##     var product = (1..>5).fold(1, (total, n) => total * n);   # 120
    fold<U>(initial: U, combine: (U, T) => U): U {
        Iterator<T> source = this;
        var result = initial;
        while (source.next()) {
            result = combine(result, source.current());
        }
        return result;
    }

    ## Returns whether `test` returns true for some element.
    ##
    ## Stops at the first element that passes, on a copy of the iterator,
    ## like `to_array`. Every type that declares `Iterator<T>` gets this
    ## method.
    ##
    ## @typeParam TElement the element type, `T` by default
    ## @param test the test to apply
    ## @returns true when an element passes, false when none does or there are none
    ## @example
    ##     var has_even = [1, 3, 4].iterate().any((n) => n % 2 == 0);   # true
    any<TElement=T>(test: (T) => bool): bool {
        Iterator<T> source = this;
        while (source.next()) {
            if (test(source.current())) {
                return true;
            }
        }
        return false;
    }

    ## Returns whether `test` returns true for every element.
    ##
    ## Stops at the first element that fails, on a copy of the iterator, like
    ## `to_array`. Every type that declares `Iterator<T>` gets this method.
    ##
    ## @typeParam TElement the element type, `T` by default
    ## @param test the test to apply
    ## @returns true when every element passes, including when there are none
    ## @example
    ##     var all_small = [1, 3, 4].iterate().all((n) => n < 10);   # true
    all<TElement=T>(test: (T) => bool): bool {
        Iterator<T> source = this;
        while (source.next()) {
            if (!test(source.current())) {
                return false;
            }
        }
        return true;
    }

    ## Returns the first element for which `test` returns true.
    ##
    ## Stops at that element, on a copy of the iterator, like `to_array`.
    ## Every type that declares `Iterator<T>` gets this method.
    ##
    ## @typeParam TElement the element type, `T` by default
    ## @param test the test an element must pass
    ## @returns the first element that passes, or Empty when none does
    ## @example
    ##     var first_even = [1, 3, 4, 6].iterate().find((n) => n % 2 == 0);   # Value(4)
    find<TElement=T>(test: (T) => bool): T? {
        Iterator<T> source = this;
        while (source.next()) {
            var element = source.current();
            if (test(element)) {
                return Optional<T>.Value(element);
            }
        }
        return Optional<T>.Empty;
    }

    ## Returns the sum of the elements, with `+`.
    ##
    ## For element types that have `+`, such as the numbers. The sum is
    ## kept in `TSum`, the element type unless named: `sum<long>()` adds
    ## `int` elements without overflowing an `int`. Runs the iteration to
    ## the end, on a copy of the iterator, like `to_array`. Every type that
    ## declares `Iterator<T>` gets this method.
    ##
    ## @typeParam TSum the type the sum is kept in, `T` by default
    ## @returns the sum, or `TSum`'s default value (0 for a number) when there are no elements
    ## @example
    ##     var total = (1..>4).sum();   # 10
    ##     var big = [2000000000, 2000000000].iterate().sum<long>();   # 4000000000
    sum<TSum=T>(): TSum {
        Iterator<T> source = this;
        var result: TSum;
        while (source.next()) {
            result = result + source.current();
        }
        return result;
    }

    ## Returns the smallest element, by `Comparable`'s `compare`.
    ##
    ## For [`Comparable`](compare.md) element types, such as the numbers
    ## and `String`. When several elements sort together, returns the first.
    ## Runs the iteration to the end, on a copy of the iterator, like
    ## `to_array`. Every type that declares `Iterator<T>` gets this method.
    ##
    ## @typeParam TValue the `Comparable` type the elements are compared as, `T` by default
    ## @returns the smallest element, or Empty when there are none
    ## @example
    ##     var lowest = [3, 1, 2].iterate().min();   # Value(1)
    min<TValue=T>(): TValue? {
        Iterator<T> source = this;
        if (!source.next()) {
            return Optional<TValue>.Empty;
        }
        TValue best = source.current();
        while (source.next()) {
            TValue element = source.current();
            if (element.compare(best) < 0) {
                best = element;
            }
        }
        return Optional<TValue>.Value(best);
    }

    ## Returns the largest element, by `Comparable`'s `compare`.
    ##
    ## For [`Comparable`](compare.md) element types, such as the numbers
    ## and `String`. When several elements sort together, returns the first.
    ## Runs the iteration to the end, on a copy of the iterator, like
    ## `to_array`. Every type that declares `Iterator<T>` gets this method.
    ##
    ## @typeParam TValue the `Comparable` type the elements are compared as, `T` by default
    ## @returns the largest element, or Empty when there are none
    ## @example
    ##     var highest = [3, 1, 2].iterate().max();   # Value(3)
    max<TValue=T>(): TValue? {
        Iterator<T> source = this;
        if (!source.next()) {
            return Optional<TValue>.Empty;
        }
        TValue best = source.current();
        while (source.next()) {
            TValue element = source.current();
            if (element.compare(best) > 0) {
                best = element;
            }
        }
        return Optional<TValue>.Value(best);
    }

    ## Combines the elements with `combine`, starting from the first:
    ## `combine(first, second)`, then `combine` of that and the third, and so
    ## on. It is `fold` with the first element as the initial value.
    ##
    ## Runs the iteration to the end, on a copy of the iterator, like
    ## `to_array`. Every type that declares `Iterator<T>` gets this method.
    ##
    ## @typeParam TElement the element type, `T` by default
    ## @param combine the function that folds one more element into the value so far
    ## @returns the combined value, the only element when there is one, or Empty when there are none
    ## @example
    ##     var longest = ["a", "abc", "ab"].iterate().reduce((a, b) => b.size > a.size ? b : a);   # Value("abc")
    reduce<TElement=T>(combine: (T, T) => T): T? {
        Iterator<T> source = this;
        if (!source.next()) {
            return Optional<T>.Empty;
        }
        var result = source.current();
        while (source.next()) {
            result = combine(result, source.current());
        }
        return Optional<T>.Value(result);
    }

    ## Returns the position of the first element for which `test` returns
    ## true, counting from 0.
    ##
    ## Stops at that element, on a copy of the iterator, like `to_array`.
    ## Every type that declares `Iterator<T>` gets this method.
    ##
    ## @typeParam TElement the element type, `T` by default
    ## @param test the test an element must pass
    ## @returns the position of the first element that passes, or Empty when none does
    ## @example
    ##     var at = [1, 3, 4].iterate().position((n) => n % 2 == 0);   # Value(2)
    position<TElement=T>(test: (T) => bool): ulong? {
        Iterator<T> source = this;
        ulong index = 0;
        while (source.next()) {
            if (test(source.current())) {
                return Optional<ulong>.Value(index);
            }
            index += 1;
        }
        return Optional<ulong>.Empty;
    }

    ## Returns the last element.
    ##
    ## Runs the iteration to the end, on a copy of the iterator, like
    ## `to_array`. Every type that declares `Iterator<T>` gets this method.
    ##
    ## @typeParam TElement the element type, `T` by default
    ## @returns the last element, or Empty when there are none
    ## @example
    ##     var final = (1..>4).last();   # Value(4)
    last<TElement=T>(): T? {
        Iterator<T> source = this;
        var result = Optional<T>.Empty;
        while (source.next()) {
            result = Optional<T>.Value(source.current());
        }
        return result;
    }

    ## Calls `action` with each element, in order.
    ##
    ## Runs the iteration to the end, on a copy of the iterator, like
    ## `to_array`; use a `for` loop where `break` or `return` is needed.
    ## Every type that declares `Iterator<T>` gets this method.
    ##
    ## @typeParam TElement the element type, `T` by default
    ## @param action the function called with each element
    ## @example
    ##     var names = Array<String>();
    ##     var people = ["Ada", "Bo"];
    ##     people.iterate().for_each((name) => names.append(name));
    for_each<TElement=T>(action: (T) => void) {
        Iterator<T> source = this;
        while (source.next()) {
            action(source.current());
        }
    }

    ## Returns the smallest element by `compare`, which returns a negative
    ## number, zero or a positive number as its first argument sorts before,
    ## with or after its second, as `Array.sort`'s does.
    ##
    ## When several elements sort together, returns the first. Runs the
    ## iteration to the end, on a copy of the iterator, like `to_array`.
    ## Every type that declares `Iterator<T>` gets this method.
    ##
    ## @typeParam TElement the element type, `T` by default
    ## @param compare the order of two elements
    ## @returns the smallest element, or Empty when there are none
    ## @example
    ##     var shortest = ["abc", "a"].iterate().min_by((a, b) => a.size.compare(b.size));   # Value("a")
    min_by<TElement=T>(compare: (T, T) => int): T? {
        Iterator<T> source = this;
        if (!source.next()) {
            return Optional<T>.Empty;
        }
        var best = source.current();
        while (source.next()) {
            var element = source.current();
            if (compare(element, best) < 0) {
                best = element;
            }
        }
        return Optional<T>.Value(best);
    }

    ## Returns the largest element by `compare`, which returns a negative
    ## number, zero or a positive number as its first argument sorts before,
    ## with or after its second, as `Array.sort`'s does.
    ##
    ## When several elements sort together, returns the first. Runs the
    ## iteration to the end, on a copy of the iterator, like `to_array`.
    ## Every type that declares `Iterator<T>` gets this method.
    ##
    ## @typeParam TElement the element type, `T` by default
    ## @param compare the order of two elements
    ## @returns the largest element, or Empty when there are none
    ## @example
    ##     var longest = ["abc", "a"].iterate().max_by((a, b) => a.size.compare(b.size));   # Value("abc")
    max_by<TElement=T>(compare: (T, T) => int): T? {
        Iterator<T> source = this;
        if (!source.next()) {
            return Optional<T>.Empty;
        }
        var best = source.current();
        while (source.next()) {
            var element = source.current();
            if (compare(element, best) > 0) {
                best = element;
            }
        }
        return Optional<T>.Value(best);
    }

    ## Returns a new `HashSet` holding the remaining elements, each once.
    ##
    ## For element types a `HashSet` can hold. Runs the iteration to the end,
    ## on a copy of the iterator, like `to_array`. Every type that declares
    ## `Iterator<T>` gets this method.
    ##
    ## @typeParam K the type the set holds, `T` by default
    ## @returns the distinct elements, possibly none
    ## @example
    ##     var distinct = [1, 2, 1].iterate().to_set();   # holds 1 and 2
    to_set<K=T>(): HashSet<K> {
        Iterator<T> source = this;
        var result = HashSet<K>();
        while (source.next()) {
            result.insert(source.current());
        }
        return result;
    }

    ## Returns a new `HashMap` from the remaining elements, which are
    ## `(key, value)` tuples. A later element with a key already present
    ## replaces its value.
    ##
    ## For tuple elements; name the key and value types. Runs the iteration
    ## to the end, on a copy of the iterator, like `to_array`. Every type that
    ## declares `Iterator<T>` gets this method.
    ##
    ## @typeParam K the type of the keys
    ## @typeParam V the type of the values
    ## @returns the map, possibly empty
    ## @example
    ##     var ages = [("Ada", 36), ("Bo", 12)].iterate().to_map<String, int>();   # ages["Bo"] == 12
    to_map<K, V>(): HashMap<K, V> {
        Iterator<T> source = this;
        var result = HashMap<K, V>();
        while (source.next()) {
            var entry = source.current();
            result[entry.0] = entry.1;
        }
        return result;
    }

    ## Returns the remaining elements, which are `String`s, with `separator`
    ## between each two, as `String.join` does for an array.
    ##
    ## For `String` elements. Runs the iteration to the end, on a copy of the
    ## iterator, like `to_array`. Every type that declares `Iterator<T>` gets
    ## this method.
    ##
    ## @typeParam TText the element type, `T` by default
    ## @param separator the text put between each two elements
    ## @returns the joined text, or `""` when there are no elements
    ## @example
    ##     var ages = [36, 12].iterate().map((n) => $"{n}").join(", ");   # "36, 12"
    join<TText=T>(separator: String): String {
        Iterator<T> source = this;
        var parts = Array<String>();
        while (source.next()) {
            TText part = source.current();
            parts.append(part);
        }
        return separator.join(parts);
    }
}

## The iterator `Iterator.take` returns: at most the first `count` elements
## of the source iterator.
##
## @typeParam T the type of the elements
## @see Iterator.take
[Value]
export struct TakeIterator<T> {
    ## The iterator whose first elements are yielded.
    Iterator<T> _source;
    ## How many more elements may be yielded.
    ulong _remaining;

    ## Makes an iterator over at most the first `count` elements of `source`.
    ##
    ## @param source the iterator to take from
    ## @param count the most elements to yield
    construct(source: Iterator<T>, count: ulong) {
        _source = source;
        _remaining = count;
    }

    ## Advances to the next element, unless `count` elements were yielded.
    ##
    ## @returns true if there is a current element, false after `count` elements or when the source is exhausted
    next(): bool {
        if (_remaining == 0) {
            return false;
        }
        _remaining -= 1;
        return _source.next();
    }

    ## Returns the element the last successful `next()` moved to.
    ##
    ## @returns the current element
    current(): T {
        return _source.current();
    }
}

extend TakeIterator<T> with Iterator<T>;

## The iterator `Iterator.skip` returns: the elements of the source iterator
## after the first `count`.
##
## @typeParam T the type of the elements
## @see Iterator.skip
[Value]
export struct SkipIterator<T> {
    ## The iterator whose later elements are yielded.
    Iterator<T> _source;
    ## How many elements are still to be passed over.
    ulong _skip;

    ## Makes an iterator over the elements of `source` after the first
    ## `count`.
    ##
    ## @param source the iterator to skip into
    ## @param count how many elements to pass over
    construct(source: Iterator<T>, count: ulong) {
        _source = source;
        _skip = count;
    }

    ## Advances to the next element, passing over the first `count` on the
    ## first call.
    ##
    ## @returns true if there is a current element, false when the source is exhausted
    next(): bool {
        while (_skip > 0) {
            _skip -= 1;
            if (!_source.next()) {
                return false;
            }
        }
        return _source.next();
    }

    ## Returns the element the last successful `next()` moved to.
    ##
    ## @returns the current element
    current(): T {
        return _source.current();
    }
}

extend SkipIterator<T> with Iterator<T>;

## The iterator `Iterator.chain` returns: the elements of one iterator, then
## those of another.
##
## @typeParam T the type of the elements
## @see Iterator.chain
[Value]
export struct ChainIterator<T> {
    ## The iterator whose elements come first.
    Iterator<T> _first;
    ## The iterator whose elements follow.
    Iterator<T> _second;
    ## Whether `_first` has run out, so the elements come from `_second`.
    bool _on_second;

    ## Makes an iterator over the elements of `first`, then `second`.
    ##
    ## @param first the iterator whose elements come first
    ## @param second the iterator whose elements follow
    construct(first: Iterator<T>, second: Iterator<T>) {
        _first = first;
        _second = second;
    }

    ## Advances to the next element of the first iterator, or once it has
    ## run out, of the second.
    ##
    ## @returns true if there is a current element, false when both are exhausted
    next(): bool {
        if (!_on_second && _first.next()) {
            return true;
        }
        _on_second = true;
        return _second.next();
    }

    ## Returns the element the last successful `next()` moved to.
    ##
    ## @returns the current element
    current(): T {
        return _on_second ? _second.current() : _first.current();
    }
}

extend ChainIterator<T> with Iterator<T>;

## The iterator `Iterator.flat_map` returns: the elements of the iterators
## the transform function returns for each source element, in order.
##
## @typeParam T the type of the source's elements
## @typeParam U the type of the elements produced
## @see Iterator.flat_map
[Value]
export struct FlatMapIterator<T, U> {
    # No member names `(T) => Iterator<U>`: the runtime must build with the
    # previous published compiler (stage 0), and compilers without the
    # fix reject that type in a generic struct ("unknown type name 'U'").
    ## The iterators to yield the elements of, one per source element.
    MapIterator<T, Iterator<U>> _source;
    ## The iterator from the current source element, Empty before the first.
    Iterator<U>? _inner;

    ## Makes an iterator over the elements of the iterators `source` yields.
    ##
    ## @param source the source iterator, mapped to an iterator per element
    construct(source: MapIterator<T, Iterator<U>>) {
        _source = source;
    }

    ## Advances to the next element of the current inner iterator, moving to
    ## the next source element's iterator each time one runs out.
    ##
    ## @returns true if there is a current element, false when the source is exhausted
    next(): bool {
        while (true) {
            if (_inner is Value(inner)) {
                if (inner.next()) {
                    return true;
                }
            }
            if (!_source.next()) {
                return false;
            }
            _inner = Optional<Iterator<U>>.Value(_source.current());
        }
    }

    ## Returns the element the last successful `next()` moved to.
    ##
    ## @returns the current element
    ## @panics if `next()` has not moved to an element
    current(): U {
        return _inner.value().current();
    }
}

extend FlatMapIterator<T, U> with Iterator<U>;

## The iterator `Iterator.take_while` returns: the leading elements of the
## source iterator that the test function accepts.
##
## @typeParam T the type of the elements
## @see Iterator.take_while
[Value]
export struct TakeWhileIterator<T> {
    ## The iterator whose leading elements are yielded.
    Iterator<T> _source;
    ## The test the leading elements pass.
    (T) => bool _keep;
    ## Whether an element failed the test, or the source ran out.
    bool _done;

    ## Makes an iterator over the leading elements of `source` that `keep`
    ## accepts.
    ##
    ## @param source the iterator to take from
    ## @param keep the test the leading elements pass
    construct(source: Iterator<T>, keep: (T) => bool) {
        _source = source;
        _keep = keep;
    }

    ## Advances to the next element, unless it or an earlier one failed the
    ## test.
    ##
    ## @returns true if there is a current element, false once an element fails or the source is exhausted
    next(): bool {
        if (_done) {
            return false;
        }
        if (_source.next() && _keep(_source.current())) {
            return true;
        }
        _done = true;
        return false;
    }

    ## Returns the element the last successful `next()` moved to.
    ##
    ## @returns the current element
    current(): T {
        return _source.current();
    }
}

extend TakeWhileIterator<T> with Iterator<T>;

## The iterator `Iterator.skip_while` returns: the elements of the source
## iterator from the first one the test function rejects.
##
## @typeParam T the type of the elements
## @see Iterator.skip_while
[Value]
export struct SkipWhileIterator<T> {
    ## The iterator whose later elements are yielded.
    Iterator<T> _source;
    ## The test the leading elements to pass over meet.
    (T) => bool _skip;
    ## Whether the leading elements were passed over.
    bool _started;

    ## Makes an iterator over the elements of `source` from the first one
    ## `skip` rejects.
    ##
    ## @param source the iterator to skip into
    ## @param skip the test the leading elements to pass over meet
    construct(source: Iterator<T>, skip: (T) => bool) {
        _source = source;
        _skip = skip;
    }

    ## Advances to the next element, passing over the leading elements the
    ## test accepts on the first call.
    ##
    ## @returns true if there is a current element, false when the source is exhausted
    next(): bool {
        if (_started) {
            return _source.next();
        }
        _started = true;
        while (_source.next()) {
            if (!_skip(_source.current())) {
                return true;
            }
        }
        return false;
    }

    ## Returns the element the last successful `next()` moved to.
    ##
    ## @returns the current element
    current(): T {
        return _source.current();
    }
}

extend SkipWhileIterator<T> with Iterator<T>;

## The iterator `Iterator.step_by` returns: the first element of the source
## iterator, then every `step`th one after it.
##
## @typeParam T the type of the elements
## @see Iterator.step_by
[Value]
export struct StepByIterator<T> {
    ## The iterator whose elements are stepped through.
    Iterator<T> _source;
    ## How far apart the yielded elements are.
    ulong _step;
    ## Whether the first element was yielded.
    bool _started;

    ## Makes an iterator over the first element of `source` and every
    ## `step`th one after it.
    ##
    ## @param source the iterator to step through
    ## @param step how far apart the yielded elements are
    ## @panics if `step` is 0 ("step_by step must be positive")
    construct(source: Iterator<T>, step: ulong) {
        assert(step > 0, "step_by step must be positive");
        _source = source;
        _step = step;
    }

    ## Advances to the first element, then `step` elements at a time.
    ##
    ## @returns true if there is a current element, false when the source is exhausted
    next(): bool {
        if (!_started) {
            _started = true;
            return _source.next();
        }
        ulong moved = 0;
        while (moved < _step) {
            if (!_source.next()) {
                return false;
            }
            moved += 1;
        }
        return true;
    }

    ## Returns the element the last successful `next()` moved to.
    ##
    ## @returns the current element
    current(): T {
        return _source.current();
    }
}

extend StepByIterator<T> with Iterator<T>;

## The iterator `Iterator.peekable` returns: the elements of the source
## iterator, with `peek()` to look at the next one without moving to it.
##
## @typeParam T the type of the elements
## @see Iterator.peekable
[Value]
export struct PeekableIterator<T> {
    ## The iterator whose elements are yielded.
    Iterator<T> _source;
    ## The element the last successful `next()` moved to.
    T _current;
    ## The next element, read from the source by `peek()` and not yet yielded.
    T? _ahead;

    ## Makes an iterator over the elements of `source` that can peek.
    ##
    ## @param source the iterator to yield from
    construct(source: Iterator<T>) {
        _source = source;
    }

    ## Advances to the next element: the one `peek()` returned, if any.
    ##
    ## @returns true if there is a current element, false when the source is exhausted
    next(): bool {
        if (_ahead is Value(ahead)) {
            _current = ahead;
            _ahead = Optional<T>.Empty;
            return true;
        }
        if (!_source.next()) {
            return false;
        }
        _current = _source.current();
        return true;
    }

    ## Returns the element the last successful `next()` moved to.
    ##
    ## @returns the current element
    current(): T {
        return _current;
    }

    ## Returns the element the next `next()` will move to, without moving.
    ##
    ## @returns the next element, or Empty when there are no more
    ## @example
    ##     var it = [1, 2].iterate().peekable();
    ##     it.next();               # at 1
    ##     var ahead = it.peek();   # Value(2), still at 1
    peek(): T? {
        if (_ahead.is_value()) {
            return _ahead;
        }
        if (_source.next()) {
            _ahead = Optional<T>.Value(_source.current());
        }
        return _ahead;
    }
}

extend PeekableIterator<T> with Iterator<T>;

## The iterator `Iterator.chunks` returns: the elements of the source
## iterator in arrays of up to `size`.
##
## @typeParam T the type of the elements
## @see Iterator.chunks
[Value]
export struct ChunksIterator<T> {
    ## The iterator whose elements are grouped.
    Iterator<T> _source;
    ## The most elements each array holds.
    ulong _size;
    ## The array the last successful `next()` filled.
    Array<T> _chunk;

    ## Makes an iterator over the elements of `source` in arrays of up to
    ## `size`.
    ##
    ## @param source the iterator to group
    ## @param size the most elements each array holds
    ## @panics if `size` is 0 ("chunks size must be positive")
    construct(source: Iterator<T>, size: ulong) {
        assert(size > 0, "chunks size must be positive");
        _source = source;
        _size = size;
        _chunk = Array<T>();
    }

    ## Fills a new array with up to `size` more elements.
    ##
    ## @returns true if there is a current array, false when the source is exhausted
    next(): bool {
        var chunk = Array<T>();
        while (chunk.count < _size && _source.next()) {
            chunk.append(_source.current());
        }
        _chunk = chunk;
        return chunk.count > 0;
    }

    ## Returns the array the last successful `next()` filled.
    ##
    ## @returns the current array
    current(): Array<T> {
        return _chunk;
    }
}

extend ChunksIterator<T> with Iterator<Array<T>>;

## The iterator `Iterator.windows` returns: every run of `size` consecutive
## elements of the source iterator.
##
## @typeParam T the type of the elements
## @see Iterator.windows
[Value]
export struct WindowsIterator<T> {
    ## The iterator whose elements are grouped.
    Iterator<T> _source;
    ## How many elements each run holds.
    ulong _size;
    ## The run the last successful `next()` made.
    Array<T> _window;

    ## Makes an iterator over every run of `size` consecutive elements of
    ## `source`.
    ##
    ## @param source the iterator to group
    ## @param size how many elements each run holds
    ## @panics if `size` is 0 ("windows size must be positive")
    construct(source: Iterator<T>, size: ulong) {
        assert(size > 0, "windows size must be positive");
        _source = source;
        _size = size;
        _window = Array<T>();
    }

    ## Makes a new run: the last one's elements after its first, then
    ## enough more to fill it.
    ##
    ## @returns true if there is a current run, false when the source is exhausted
    next(): bool {
        var window = Array<T>();
        ulong index = 1;
        while (_window.count == _size && index < _size) {
            window.append(_window[index]);
            index += 1;
        }
        while (window.count < _size) {
            if (!_source.next()) {
                return false;
            }
            window.append(_source.current());
        }
        _window = window;
        return true;
    }

    ## Returns the run the last successful `next()` made.
    ##
    ## @returns the current run
    current(): Array<T> {
        return _window;
    }
}

extend WindowsIterator<T> with Iterator<Array<T>>;

## The iterator `Iterator.map` returns: each element of the source iterator,
## passed through the transform function.
##
## @typeParam T the type of the source's elements
## @typeParam U the type of the elements produced
## @see Iterator.map
[Value]
export struct MapIterator<T, U> {
    ## The iterator whose elements are transformed.
    Iterator<T> _source;
    ## The function applied to each element.
    (T) => U _transform;
    ## The current element, the transform of the source's current element.
    U _value;

    ## Makes an iterator over `transform` applied to the elements of `source`.
    ##
    ## @param source the iterator to transform
    ## @param transform the function applied to each element
    construct(source: Iterator<T>, transform: (T) => U) {
        _source = source;
        _transform = transform;
    }

    ## Advances to the next element, and applies the transform function to it.
    ##
    ## @returns true if there is a current element, false when the source is exhausted
    next(): bool {
        if (_source.next()) {
            _value = _transform(_source.current());
            return true;
        }
        return false;
    }

    ## Returns the transformed element the last successful `next()` produced.
    ##
    ## @returns the current element
    current(): U {
        return _value;
    }
}

extend MapIterator<T, U> with Iterator<U>;

## The iterator `Iterator.filter` returns: the elements of the source
## iterator that the test function accepts.
##
## @typeParam T the type of the elements
## @see Iterator.filter
[Value]
export struct FilterIterator<T> {
    ## The iterator whose elements are tested.
    Iterator<T> _source;
    ## The test an element must pass.
    (T) => bool _keep;

    ## Makes an iterator over the elements of `source` that `keep` accepts.
    ##
    ## @param source the iterator to filter
    ## @param keep the test an element must pass
    construct(source: Iterator<T>, keep: (T) => bool) {
        _source = source;
        _keep = keep;
    }

    ## Advances to the next element that the test function accepts.
    ##
    ## @returns true if there is a current element, false when the source is exhausted
    next(): bool {
        while (_source.next()) {
            if (_keep(_source.current())) {
                return true;
            }
        }
        return false;
    }

    ## Returns the element the last successful `next()` moved to.
    ##
    ## @returns the current element
    current(): T {
        return _source.current();
    }
}

extend FilterIterator<T> with Iterator<T>;

## The iterator `Iterator.enumerate` returns: each element of the source
## iterator, paired with its position.
##
## @typeParam T the type of the source's elements
## @typeParam TIndex the integer type of the positions
## @see Iterator.enumerate
[Value]
export struct EnumerateIterator<T, TIndex> {
    ## The iterator whose elements are numbered.
    Iterator<T> _source;
    ## How many elements `next()` has moved past; the current element's index plus one.
    TIndex _count;

    ## Makes an iterator over the elements of `source`, numbered from 0.
    ##
    ## @param source the iterator to number
    construct(source: Iterator<T>) {
        _source = source;
    }

    ## Advances to the next element.
    ##
    ## @returns true if there is a current element, false when the source is exhausted
    next(): bool {
        if (_source.next()) {
            _count += 1;
            return true;
        }
        return false;
    }

    ## Returns the element the last successful `next()` moved to, with its
    ## index.
    ##
    ## @returns the current `(index, element)` pair
    current(): (TIndex, T) {
        return (_count - 1, _source.current());
    }
}

extend EnumerateIterator<T, TIndex> with Iterator<(TIndex, T)>;

## The iterator `Iterator.zip` returns: the elements of two iterators,
## paired in step, until either runs out.
##
## @typeParam T the type of the first iterator's elements
## @typeParam U the type of the second iterator's elements
## @see Iterator.zip
[Value]
export struct ZipIterator<T, U> {
    ## The iterator giving the first half of each pair.
    Iterator<T> _first;
    ## The iterator giving the second half of each pair.
    Iterator<U> _second;

    ## Makes an iterator over the elements of `first` and `second`, paired.
    ##
    ## @param first the iterator giving the first half of each pair
    ## @param second the iterator giving the second half of each pair
    construct(first: Iterator<T>, second: Iterator<U>) {
        _first = first;
        _second = second;
    }

    ## Advances both iterators. `second` is not advanced once `first` has
    ## run out.
    ##
    ## @returns true if both have a current element, false when either is exhausted
    next(): bool {
        return _first.next() && _second.next();
    }

    ## Returns the pair the last successful `next()` moved to.
    ##
    ## @returns the current `(first element, second element)` pair
    current(): (T, U) {
        return (_first.current(), _second.current());
    }
}

extend ZipIterator<T, U> with Iterator<(T, U)>;

## Something that hands out an `Iterator<T>` over its elements, such as
## `Array<T>` and `String` (which yields one code point at a time, as a
## `String`).
##
## `for (var x in source)` calls `source.iterate()` once, then drives the
## returned iterator with `next()` and `current()`. When a type declares both
## `iterate()` and `next()`/`current()`, the loop uses `iterate()`.
##
## @typeParam T the type of the elements produced
## @example
##     var nums = Array<int>();
##     nums.append(1);
##     nums.append(2);
##     var total = 0;
##     for (var x in nums) {
##         total = total + x;
##     }
## @see Iterator
export trait Iterable<T> {
    ## Returns a new iterator positioned before the first element.
    ##
    ## The result may be any type that satisfies `Iterator<T>` (for example
    ## `ArrayIterator<T>`); each call starts a fresh, independent pass.
    ##
    ## @returns an iterator over the elements
    iterate(): Iterator<T>;
}
json/convert
44051
## Struct conversion: `encode` and `decode` turn Pepper values into JSON text
## and back, through reflection, with no per-type code to write.

import serialize;
import "parse";
import "value";

## What `decode` does with an object key that names no property of the
## struct it is read into.
export enum UnknownKeys {
    ## Skips the key and its value.
    Ignore,
    ## Fails with an error naming the key and its path.
    Reject,
}

## Converts `value` to a `JsonValue`.
##
## `T` may be a number type, `bool`, `String`, an enum (a case that carries
## no values as its name, `"Point"`; one that carries values as
## `{"Circle": {"radius": 2}}`; `[Tag]` and `[Untagged]` choose other forms), `Optional<U>` (the value, or `null`), `Array<U>`, a map with `String` keys (`HashMap`, `OrderedMap` or
## `Map`) as an object, `JsonValue` itself, or a struct, whose public
## properties become an object's members in declaration order. Element and
## property types follow the same rules, so structs nest.
##
## A struct property takes its key from `[Name("key")]` when it has one,
## and is left out when marked `[Ignore]` (the attributes of the `serialize`
## module, which `json` exports). A property of a struct type that holds no
## object (a struct field never assigned) is written as `null`. An empty
## `Array`, even one never assigned, is written as `[]`.
##
## The conversion is generated while compiling, by a `static` block per
## type. A type it cannot convert, such as a `Result` or an `io.File`, is a
## compile error naming the property:
## `'encode' cannot convert property 'outcome' of type 'Result<int>' to JSON`.
##
## @typeParam T the type of the value
## @param value the value to convert
## @returns the value as JSON
## @example
##     import json;
##
##     struct Point {
##         var x: int;
##         var y: int;
##     }
##
##     main(): int {
##         var p = Point();
##         p.x = 1;
##         p.y = 2;
##         assert(json.to_json(p)["y"].as_int().value() == 2, "a member");
##         return 0;
##     }
export to_json<T>(value: T): JsonValue {
    return _to_json(value);
}

## Writes `value` as JSON text, converting it as `to_json` does.
##
## @typeParam T the type of the value
## @param value the value to write
## @param indent spaces per nesting level; 0, the default, writes compact
##   text on one line
## @param ascii_only whether to escape every character outside ASCII as
##   `\u`
## @returns the JSON text
## @example
##     import json;
##
##     struct ServerConfig {
##         var host: String;
##         var port: int;
##         [Name("max-connections")]
##         var max_connections: int;
##         [Ignore]
##         var started_at: long;
##     }
##
##     main(): int {
##         var config = ServerConfig();
##         config.host = "localhost";
##         config.port = 8080;
##         config.max_connections = 16;
##         var text = json.encode(config);
##         assert(text == "{\"host\":\"localhost\",\"port\":8080,\"max-connections\":16}", "compact");
##         return 0;
##     }
export encode<T>(value: T, indent: int = 0, ascii_only: bool = false): String {
    var root = _to_json(value);
    if (indent > 0) {
        return root.to_pretty_string(indent, ascii_only);
    }
    return root.to_string(ascii_only);
}

## Converts a `JsonValue` to a `T`, the reverse of `to_json`.
##
## A struct is made with its constructor that takes no arguments, then each
## property found in the object is read in. A missing key leaves its
## property at its default, unless the property is marked `[Required]`,
## which makes it an error; a property marked `[Ignore]` is never read. A
## key that names no property is skipped, or with
## `unknown_keys = UnknownKeys.Reject` is an error.
##
## A number converts to an integer type when it has no fraction and fits
## the type, and to `float` or `double` always. `null` converts only to an
## `Optional` (as none) and to `JsonValue`.
##
## An error names where in the document it is, as a path from the root `$`
## in its `value_path` and at the start of its message, and has no line or
## column, since there is no text: `$.server.port: expected a number, found
## a string`.
##
## @typeParam T the type to convert to
## @param value the JSON value
## @param unknown_keys what to do with an object key that names no property
## @returns the converted value, or the first error
## @example
##     import json;
##
##     struct Point {
##         var x: int;
##         var y: int;
##     }
##
##     main(): int {
##         var parsed = json.parse("{\"x\": 1, \"y\": 2}");
##         var p = json.from_json<Point>(parsed.value());
##         assert(p.value().y == 2, "a property");
##         return 0;
##     }
export from_json<T>(value: JsonValue, unknown_keys: UnknownKeys = UnknownKeys.Ignore): Result<T, JsonError> {
    var witness: T;
    return _from_json(value, witness, "$", unknown_keys);
}

## Parses JSON text and converts it to a `T`: `parse`, then `from_json`.
##
## @typeParam T the type to convert to
## @param text the JSON text
## @param unknown_keys what to do with an object key that names no property
## @param comments whether to accept JSONC: comments and trailing commas
## @param path the name of the text (a file name, say), which the error's
##   `to_string()` puts first
## @returns the value, or the first error: a syntax error, or a conversion
##   error with its path in the document; either has its line and column
## @example
##     import json;
##
##     struct ServerConfig {
##         var host: String;
##         [Required]
##         var port: int;
##         var tags: Array<String>;
##         var timeout: int?;
##     }
##
##     main(): int {
##         var config = json.decode<ServerConfig>("{\"host\": \"a\", \"port\": 80, \"tags\": [\"x\"]}");
##         assert(config.value().port == 80, "a number");
##         assert(config.value().tags[0] == "x", "an array");
##         assert(config.value().timeout.is_empty(), "a missing optional");
##
##         var bad = json.decode<ServerConfig>("{\"port\": \"80\"}", path = "server.json");
##         assert(bad.error().to_string() == "server.json:1:10: error: $.port: expected a number, found a string", "a path");
##         return 0;
##     }
export decode<T>(
    text: String, unknown_keys: UnknownKeys = UnknownKeys.Ignore, comments: bool = false, path: String = ""
): Result<T, JsonError> {
    var parsed = parse(text, comments = comments, path = path);
    if (parsed.is_err()) {
        return Result<T, JsonError>.err(parsed.error());
    }
    var witness: T;
    var result = _from_json(parsed.value(), witness, "$", unknown_keys);
    if (result.is_err()) {
        var error = result.error();
        error.path = path;
        var offset = _json_locate(text, comments, error.value_path);
        if (offset.is_value()) {
            _json_place(error, text, offset.value());
        }
        return Result<T, JsonError>.err(error);
    }
    return result;
}

# ── Encoding ───────────────────────────────────────────────────────────────
#
# One overload per kind of type: overload resolution picks the most
# specialized, so `Array<T>` and `T?` take their own, and the catch-all
# `_to_json<T>` handles numbers, enums and structs in a static block.

_to_json(value: String): JsonValue {
    if (value === __null) {
        return JsonValue.Null;
    }
    return JsonValue.String(value);
}

_to_json(value: JsonValue): JsonValue {
    if (value === __null) {
        return JsonValue.Null;
    }
    return value;
}

_to_json(value: bool): JsonValue {
    return JsonValue.Bool(value);
}

_to_json<T>(value: T?): JsonValue {
    if (value.is_value()) {
        return _to_json(value.value());
    }
    return JsonValue.Null;
}

_to_json<T>(value: Array<T>): JsonValue {
    var items = Array<JsonValue>(value.count);
    for (var element in value) {
        items.append(_to_json(element));
    }
    return JsonValue.Array(items);
}

_to_json<V>(value: HashMap<String, V>): JsonValue {
    return _json_object_of(value);
}

_to_json<V>(value: OrderedMap<String, V>): JsonValue {
    return _json_object_of(value);
}

_to_json<V>(value: Map<String, V>): JsonValue {
    return _json_object_of(value);
}

# An object of the members of `map`, any map with `String` keys.
_json_object_of<TMap>(map: TMap): JsonValue {
    if (map === __null) {
        return JsonValue.Null;
    }
    var members = OrderedMap<String, JsonValue>();
    for (var (key, member) in map) {
        members[key] = _to_json(member);
    }
    return JsonValue.Object(members);
}

_to_json<T>(value: T): JsonValue {
    var out = JsonValue.Null;
    var present = true;
    static (out, value, present) {
        if (reflect.is_same<T, i8>()
            || reflect.is_same<T, i16>()
            || reflect.is_same<T, i32>()
            || reflect.is_same<T, i64>()
            || reflect.is_same<T, u8>()
            || reflect.is_same<T, u16>()
            || reflect.is_same<T, u32>()) {
            out = JsonValue.Integer(value as long);
        } else if (reflect.is_same<T, u64>()) {
            out = _ulong_to_json(value);
        } else if (reflect.is_same<T, float>() || reflect.is_same<T, double>()) {
            out = JsonValue.Number(value as double);
        } else if (reflect.is_enum<T>()) {
            reflect.assert(
                !reflect.name<T>().starts_with("Result<"), $"'encode' cannot convert type '{reflect.name<T>()}' to JSON"
            );
            # By default a case that carries nothing is its name and one that
            # carries values is `{"Case": {"value": ...}}`; `[Tag]` and
            # `[Untagged]` choose the other forms. A reference enum's slot
            # may hold no value, written as `null`.
            var untagged = reflect.has_attribute<T, serialize.Untagged>();
            var tag_key = "";
            var content_key = "";
            if (reflect.has_attribute<T, serialize.Tag>()) {
                tag_key = reflect.attribute<T, serialize.Tag>().key;
                content_key = reflect.attribute<T, serialize.Tag>().content;
            }
            reflect.assert(
                !untagged || tag_key.is_empty,
                $"'encode' cannot convert '{reflect.name<T>()}': it is both 'Tag' and 'Untagged'"
            );
            if (reflect.is_reference<T>()) {
                present = !_json_object_or_null(value).is_null();
            }
            for (var case in reflect.cases<T>()) {
                var case_name = case.name;
                if (case.has_attribute<serialize.Name>()) {
                    case_name = case.attribute<serialize.Name>().value;
                }
                if (content_key.is_empty) {
                    for (var item in case.values) {
                        reflect.assert(
                            item.name != tag_key,
                            $"'encode' cannot convert case '{case.name}' of '{reflect.name<T>()}': its value '{item.name}' has the name of the tag"
                        );
                    }
                }
                if (present && case.matches(value)) {
                    if (!tag_key.is_empty) {
                        out = _json_tagged_object(tag_key, case_name);
                        if (!case.values.is_empty) {
                            if (content_key.is_empty) {
                                for (var item in case.values) {
                                    _json_put(out, item.name, _to_json(item.get(value)));
                                }
                            } else {
                                _json_put(out, content_key, JsonValue.object());
                                for (var item in case.values) {
                                    _json_put(_json_member(out, content_key), item.name, _to_json(item.get(value)));
                                }
                            }
                        }
                    } else if (case.values.is_empty) {
                        out = JsonValue.String(case_name);
                    } else if (untagged) {
                        out = JsonValue.object();
                        for (var item in case.values) {
                            _json_put(out, item.name, _to_json(item.get(value)));
                        }
                    } else {
                        out = _json_case_object(case_name);
                        for (var item in case.values) {
                            _json_put(_json_member(out, case_name), item.name, _to_json(item.get(value)));
                        }
                    }
                }
            }
        } else if (reflect.is_struct<T>()) {
            out = _json_object_or_null(value);
            for (var field in reflect.properties<T>()) {
                if (field.has_attribute<serialize.Ignore>()) {
                    continue;
                }
                # A shallow check, to name the property; the types
                # inside an array or a struct are checked when they
                # are converted.
                var convertible = !field.type_name.starts_with("Result<")
                    && (reflect.is_struct<field.Type>()
                        || reflect.is_enum<field.Type>()
                        || reflect.is_same<field.Type, bool>()
                        || reflect.is_same<field.Type, i8>()
                        || reflect.is_same<field.Type, i16>()
                        || reflect.is_same<field.Type, i32>()
                        || reflect.is_same<field.Type, i64>()
                        || reflect.is_same<field.Type, u8>()
                        || reflect.is_same<field.Type, u16>()
                        || reflect.is_same<field.Type, u32>()
                        || reflect.is_same<field.Type, u64>()
                        || reflect.is_same<field.Type, float>()
                        || reflect.is_same<field.Type, double>());
                reflect.assert(
                    convertible, $"'encode' cannot convert property '{field.name}' of type '{field.type_name}' to JSON"
                );
                var key = field.name;
                if (field.has_attribute<serialize.Name>()) {
                    key = field.attribute<serialize.Name>().value;
                }
                _json_put(out, key, _to_json(field.get(value)));
            }
        } else {
            reflect.error($"'encode' cannot convert type '{reflect.name<T>()}' to JSON");
        }
    }
    return out;
}

_ulong_to_json(value: ulong): JsonValue {
    if (value <= 9223372036854775807) {
        return JsonValue.Integer(value as long);
    }
    return JsonValue.Number(value as double);
}

# An empty object for a struct value, or `Null` for a struct reference that
# holds none.
_json_object_or_null<T>(value: T): JsonValue {
    if (value === __null) {
        return JsonValue.Null;
    }
    return JsonValue.object();
}

# ── Decoding ───────────────────────────────────────────────────────────────
#
# As for encoding, one overload per kind of type, picked by the type of
# `witness`: a value of the target type whose only use is choosing the
# overload (a struct's current property, or a default-initialized local).

_from_json(
    value: JsonValue, witness: JsonValue, path: String, unknown_keys: UnknownKeys
): Result<JsonValue, JsonError> {
    return Result<JsonValue, JsonError>.ok(value);
}

_from_json(value: JsonValue, witness: String, path: String, unknown_keys: UnknownKeys): Result<String, JsonError> {
    if (value is String(text)) {
        return Result<String, JsonError>.ok(text);
    }
    if (value is Null) {
        return Result<String, JsonError>.ok(__null);
    }
    return Result<String, JsonError>.err(_json_mismatch(path, "a string", value));
}

_from_json(value: JsonValue, witness: bool, path: String, unknown_keys: UnknownKeys): Result<bool, JsonError> {
    if (value is Bool(flag)) {
        return Result<bool, JsonError>.ok(flag);
    }
    return Result<bool, JsonError>.err(_json_mismatch(path, "a boolean", value));
}

_from_json<T>(value: JsonValue, witness: T?, path: String, unknown_keys: UnknownKeys): Result<T?, JsonError> {
    if (value is Null) {
        return Result<T?, JsonError>.ok(Optional<T>.Empty);
    }
    var inner: T;
    var result = _from_json(value, inner, path, unknown_keys);
    if (result.is_err()) {
        return Result<T?, JsonError>.err(result.error());
    }
    return Result<T?, JsonError>.ok(Optional<T>.Value(result.value()));
}

_from_json<T>(
    value: JsonValue, witness: Array<T>, path: String, unknown_keys: UnknownKeys
): Result<Array<T>, JsonError> {
    if (value is Null) {
        return Result<Array<T>, JsonError>.ok(__null);
    }
    var array = value.as_array();
    if (array.is_empty()) {
        return Result<Array<T>, JsonError>.err(_json_mismatch(path, "an array", value));
    }
    var items = array.value();
    var out = Array<T>(items.count);
    var element: T;
    for (var index in 0..items.count) {
        var result = _from_json(items[index], element, $"{path}[{index}]", unknown_keys);
        if (result.is_err()) {
            return Result<Array<T>, JsonError>.err(result.error());
        }
        out.append(result.value());
    }
    return Result<Array<T>, JsonError>.ok(out);
}

_from_json<V>(
    value: JsonValue, witness: HashMap<String, V>, path: String, unknown_keys: UnknownKeys
): Result<HashMap<String, V>, JsonError> {
    if (value is Null) {
        return Result<HashMap<String, V>, JsonError>.ok(__null);
    }
    var element: V;
    return _json_read_members(value, HashMap<String, V>(), element, path, unknown_keys);
}

_from_json<V>(
    value: JsonValue, witness: OrderedMap<String, V>, path: String, unknown_keys: UnknownKeys
): Result<OrderedMap<String, V>, JsonError> {
    if (value is Null) {
        return Result<OrderedMap<String, V>, JsonError>.ok(__null);
    }
    var element: V;
    return _json_read_members(value, OrderedMap<String, V>(), element, path, unknown_keys);
}

_from_json<V>(
    value: JsonValue, witness: Map<String, V>, path: String, unknown_keys: UnknownKeys
): Result<Map<String, V>, JsonError> {
    if (value is Null) {
        return Result<Map<String, V>, JsonError>.ok(__null);
    }
    var element: V;
    return _json_read_members(value, Map<String, V>(), element, path, unknown_keys);
}

# Reads the members of object `value` into `map`, any map with `String`
# keys whose values are `V`s, like `element`.
_json_read_members<TMap, V>(
    value: JsonValue, map: TMap, element: V, path: String, unknown_keys: UnknownKeys
): Result<TMap, JsonError> {
    var members = value.as_object();
    if (members.is_empty()) {
        return Result<TMap, JsonError>.err(_json_mismatch(path, "an object", value));
    }
    for (var (key, member) in members.value()) {
        var result = _from_json(member, element, _json_path_key(path, key), unknown_keys);
        if (result.is_err()) {
            return Result<TMap, JsonError>.err(result.error());
        }
        map[key] = result.value();
    }
    return Result<TMap, JsonError>.ok(map);
}

_from_json<T>(value: JsonValue, witness: T, path: String, unknown_keys: UnknownKeys): Result<T, JsonError> {
    var error = Optional<JsonError>.Empty;
    var out = witness;
    # Runtime locals of the second static block, which a `var` inside it
    # would make compile-time values.
    var known = Array<String>();
    var found = false;
    var failures = Array<JsonError>();
    static (value, path, unknown_keys, error, out) {
        if (reflect.is_same<T, i8>()) {
            error = _json_integer(value, path, -128, 127, reflect.name<T>());
        } else if (reflect.is_same<T, i16>()) {
            error = _json_integer(value, path, -32768, 32767, reflect.name<T>());
        } else if (reflect.is_same<T, i32>()) {
            error = _json_integer(value, path, -2147483648, 2147483647, reflect.name<T>());
        } else if (reflect.is_same<T, i64>()) {
            error = _json_integer(value, path, -9223372036854775807 - 1, 9223372036854775807, reflect.name<T>());
        } else if (reflect.is_same<T, u8>()) {
            error = _json_integer(value, path, 0, 255, reflect.name<T>());
        } else if (reflect.is_same<T, u16>()) {
            error = _json_integer(value, path, 0, 65535, reflect.name<T>());
        } else if (reflect.is_same<T, u32>()) {
            error = _json_integer(value, path, 0, 4294967295, reflect.name<T>());
        } else if (reflect.is_same<T, u64>()) {
            error = _json_integer(value, path, 0, 9223372036854775807, reflect.name<T>());
        } else if (reflect.is_same<T, float>() || reflect.is_same<T, double>()) {
            if (value.as_double().is_empty()) {
                error = Optional<JsonError>.Value(_json_mismatch(path, "a number", value));
            }
        } else if (reflect.is_enum<T>()) {
            reflect.assert(
                !reflect.name<T>().starts_with("Result<"),
                $"'decode' cannot convert type '{reflect.name<T>()}' from JSON"
            );
            if (!(reflect.is_reference<T>() && value.is_null())) {
                if (reflect.has_attribute<T, serialize.Tag>()) {
                    error = _json_tag_error(value, path, reflect.attribute<T, serialize.Tag>().key);
                } else if (!reflect.has_attribute<T, serialize.Untagged>() && _json_case_name(value).is_empty) {
                    error = Optional<JsonError>.Value(
                        _json_mismatch(path, "a string or an object with one key", value)
                    );
                }
            }
        } else if (reflect.is_struct<T>()) {
            if (value.as_object().is_empty() && !value.is_null()) {
                error = Optional<JsonError>.Value(_json_mismatch(path, "an object", value));
            }
        } else {
            reflect.error($"'decode' cannot convert type '{reflect.name<T>()}' from JSON");
        }
    }
    if (error.is_value()) {
        return Result<T, JsonError>.err(error.value());
    }
    static (value, path, unknown_keys, error, out, known, found, failures) {
        if (reflect.is_same<T, i8>()
            || reflect.is_same<T, i16>()
            || reflect.is_same<T, i32>()
            || reflect.is_same<T, i64>()
            || reflect.is_same<T, u8>()
            || reflect.is_same<T, u16>()
            || reflect.is_same<T, u32>()
            || reflect.is_same<T, u64>()) {
            out = value.as_int().value() as T;
        } else if (reflect.is_same<T, float>() || reflect.is_same<T, double>()) {
            out = value.as_double().value() as T;
        } else if (reflect.is_enum<T>()) {
            if (reflect.is_reference<T>()) {
                if (value.is_null()) {
                    out = _json_null(out);
                    found = true;
                }
            }
            var untagged = reflect.has_attribute<T, serialize.Untagged>();
            var tag_key = "";
            var content_key = "";
            if (reflect.has_attribute<T, serialize.Tag>()) {
                tag_key = reflect.attribute<T, serialize.Tag>().key;
                content_key = reflect.attribute<T, serialize.Tag>().content;
            }
            reflect.assert(
                !untagged || tag_key.is_empty,
                $"'decode' cannot convert '{reflect.name<T>()}': it is both 'Tag' and 'Untagged'"
            );
            # The case `value` names, the object its values are read from,
            # and that object's path, in the enum's form.
            var name = _json_case_tag(value, tag_key);
            var payload = _json_case_payload(value, name, tag_key, content_key, untagged);
            var case_path = _json_case_path(path, name, tag_key, content_key, untagged);
            for (var case in reflect.cases<T>()) {
                var case_name = case.name;
                if (case.has_attribute<serialize.Name>()) {
                    case_name = case.attribute<serialize.Name>().value;
                }
                if (content_key.is_empty) {
                    for (var item in case.values) {
                        reflect.assert(
                            item.name != tag_key,
                            $"'decode' cannot convert case '{case.name}' of '{reflect.name<T>()}': its value '{item.name}' has the name of the tag"
                        );
                    }
                }
                # An untagged enum tries each case until one reads.
                if (_json_case_tried(untagged, found, name, case_name)) {
                    if (!untagged) {
                        found = true;
                    }
                    if (case.values.is_empty) {
                        if (untagged) {
                            found = value.as_string().is_value() && name == case_name;
                            if (found) {
                                out = case.get();
                            }
                        } else if (tag_key.is_empty && value.as_string().is_empty()) {
                            error = Optional<JsonError>.Value(
                                _json_error(
                                    path,
                                    $"case '{case_name}' carries no values; write it as the string \"{case_name}\""
                                )
                            );
                        } else {
                            out = case.get();
                            if (!tag_key.is_empty && unknown_keys == UnknownKeys.Reject) {
                                known.append(tag_key);
                                error = _json_unknown_key(value, known, path);
                            }
                        }
                    } else if (!untagged && tag_key.is_empty && value.as_string().is_value()) {
                        error = Optional<JsonError>.Value(
                            _json_error(
                                path, $"case '{case_name}' carries values; write it as {{\"{case_name}\": {{...}}}}"
                            )
                        );
                    } else if (payload.as_object().is_empty()) {
                        if (!untagged) {
                            error = Optional<JsonError>.Value(_json_mismatch(case_path, "an object", payload));
                        }
                    } else {
                        # `case.get(...)` takes every value at once, so each
                        # count has its own call; a failed value records its
                        # error in `failures` and gives a default.
                        if (case.values.count == 1) {
                            var a = case.values[0];
                            out = case.get(
                                _json_case_value<a.Type>(payload, a.name, case_path, unknown_keys, failures)
                            );
                        } else if (case.values.count == 2) {
                            var a = case.values[0];
                            var b = case.values[1];
                            out = case.get(
                                _json_case_value<a.Type>(payload, a.name, case_path, unknown_keys, failures),
                                _json_case_value<b.Type>(payload, b.name, case_path, unknown_keys, failures)
                            );
                        } else if (case.values.count == 3) {
                            var a = case.values[0];
                            var b = case.values[1];
                            var c = case.values[2];
                            out = case.get(
                                _json_case_value<a.Type>(payload, a.name, case_path, unknown_keys, failures),
                                _json_case_value<b.Type>(payload, b.name, case_path, unknown_keys, failures),
                                _json_case_value<c.Type>(payload, c.name, case_path, unknown_keys, failures)
                            );
                        } else if (case.values.count == 4) {
                            var a = case.values[0];
                            var b = case.values[1];
                            var c = case.values[2];
                            var d = case.values[3];
                            out = case.get(
                                _json_case_value<a.Type>(payload, a.name, case_path, unknown_keys, failures),
                                _json_case_value<b.Type>(payload, b.name, case_path, unknown_keys, failures),
                                _json_case_value<c.Type>(payload, c.name, case_path, unknown_keys, failures),
                                _json_case_value<d.Type>(payload, d.name, case_path, unknown_keys, failures)
                            );
                        } else if (case.values.count == 5) {
                            var a = case.values[0];
                            var b = case.values[1];
                            var c = case.values[2];
                            var d = case.values[3];
                            var e = case.values[4];
                            out = case.get(
                                _json_case_value<a.Type>(payload, a.name, case_path, unknown_keys, failures),
                                _json_case_value<b.Type>(payload, b.name, case_path, unknown_keys, failures),
                                _json_case_value<c.Type>(payload, c.name, case_path, unknown_keys, failures),
                                _json_case_value<d.Type>(payload, d.name, case_path, unknown_keys, failures),
                                _json_case_value<e.Type>(payload, e.name, case_path, unknown_keys, failures)
                            );
                        } else if (case.values.count == 6) {
                            var a = case.values[0];
                            var b = case.values[1];
                            var c = case.values[2];
                            var d = case.values[3];
                            var e = case.values[4];
                            var f = case.values[5];
                            out = case.get(
                                _json_case_value<a.Type>(payload, a.name, case_path, unknown_keys, failures),
                                _json_case_value<b.Type>(payload, b.name, case_path, unknown_keys, failures),
                                _json_case_value<c.Type>(payload, c.name, case_path, unknown_keys, failures),
                                _json_case_value<d.Type>(payload, d.name, case_path, unknown_keys, failures),
                                _json_case_value<e.Type>(payload, e.name, case_path, unknown_keys, failures),
                                _json_case_value<f.Type>(payload, f.name, case_path, unknown_keys, failures)
                            );
                        } else {
                            reflect.error(
                                $"'decode' cannot convert case '{case.name}' of '{reflect.name<T>()}': it carries more than 6 values"
                            );
                        }
                        for (var item in case.values) {
                            known.append(item.name);
                        }
                        if (!tag_key.is_empty && content_key.is_empty) {
                            known.append(tag_key);
                        }
                        if (untagged) {
                            # A case that fails to read leaves the next to
                            # try.
                            found = failures.count == 0
                                && (unknown_keys == UnknownKeys.Ignore
                                    || _json_unknown_key(payload, known, case_path).is_empty());
                            failures.clear();
                            known.clear();
                        } else if (failures.count > 0) {
                            error = Optional<JsonError>.Value(failures[0]);
                        } else if (unknown_keys == UnknownKeys.Reject) {
                            error = _json_unknown_key(payload, known, case_path);
                            if (error.is_empty() && !content_key.is_empty) {
                                error = _json_unknown_tag_key(value, tag_key, content_key, path);
                            }
                        }
                    }
                }
            }
            if (!found) {
                if (untagged) {
                    error = Optional<JsonError>.Value(
                        _json_error(path, $"found {_json_kind(value)}, which matches no case of '{reflect.name<T>()}'")
                    );
                } else {
                    error = Optional<JsonError>.Value(
                        _json_error(
                            _json_case_tag_path(path, tag_key), $"'{name}' is not a case of '{reflect.name<T>()}'"
                        )
                    );
                }
            }
        } else if (reflect.is_struct<T>()) {
            out = _json_new(out, value.is_null());
            for (var field in reflect.properties<T>()) {
                if (field.has_attribute<serialize.Ignore>()) {
                    continue;
                }
                # A shallow check, to name the property; the types
                # inside an array or a struct are checked when they
                # are converted.
                var convertible = !field.type_name.starts_with("Result<")
                    && (reflect.is_struct<field.Type>()
                        || reflect.is_enum<field.Type>()
                        || reflect.is_same<field.Type, bool>()
                        || reflect.is_same<field.Type, i8>()
                        || reflect.is_same<field.Type, i16>()
                        || reflect.is_same<field.Type, i32>()
                        || reflect.is_same<field.Type, i64>()
                        || reflect.is_same<field.Type, u8>()
                        || reflect.is_same<field.Type, u16>()
                        || reflect.is_same<field.Type, u32>()
                        || reflect.is_same<field.Type, u64>()
                        || reflect.is_same<field.Type, float>()
                        || reflect.is_same<field.Type, double>());
                reflect.assert(
                    convertible,
                    $"'decode' cannot convert property '{field.name}' of type '{field.type_name}' from JSON"
                );
                var key = field.name;
                if (field.has_attribute<serialize.Name>()) {
                    key = field.attribute<serialize.Name>().value;
                }
                known.append(key);
                if (error.is_empty() && !value.is_null()) {
                    if (value.contains(key)) {
                        var member = _from_json(
                            _json_member(value, key), field.get(out), _json_path_key(path, key), unknown_keys
                        );
                        if (member.is_err()) {
                            error = Optional<JsonError>.Value(member.error());
                        } else {
                            field.set(out, member.value());
                        }
                    } else if (field.has_attribute<serialize.Required>()) {
                        error = Optional<JsonError>.Value(_json_error(path, $"missing required key '{key}'"));
                    }
                }
            }
            if (error.is_empty() && !value.is_null() && unknown_keys == UnknownKeys.Reject) {
                error = _json_unknown_key(value, known, path);
            }
        }
    }
    if (error.is_value()) {
        return Result<T, JsonError>.err(error.value());
    }
    return Result<T, JsonError>.ok(out);
}

# A new `T`, from its constructor that takes no arguments, or a null
# reference for JSON's `null`; `witness` only names the type.
_json_new<T>(witness: T, is_null: bool): T {
    if (is_null) {
        return __null;
    }
    return T();
}

# A null reference of `witness`'s type, for JSON's `null`.
_json_null<T>(witness: T): T {
    return __null;
}

# Empty when `value` is an integer in [low, high], else the error.
_json_integer(value: JsonValue, path: String, low: long, high: long, type_name: String): JsonError? {
    var number = value.as_int();
    if (number.is_empty()) {
        if (value.as_double().is_value()) {
            return Optional<JsonError>.Value(_json_error(path, $"expected an integer, found {value.to_string()}"));
        }
        return Optional<JsonError>.Value(_json_mismatch(path, "a number", value));
    }
    var n = number.value();
    if (n < low || n > high) {
        return Optional<JsonError>.Value(_json_error(path, $"{n} does not fit in '{type_name}'"));
    }
    return Optional<JsonError>.Empty;
}

# The first key of object `value` that is not in `known`, as an error.
_json_unknown_key(value: JsonValue, known: Array<String>, path: String): JsonError? {
    for (var (key, member) in value.as_object().value()) {
        if (!known.contains(key)) {
            return Optional<JsonError>.Value(_json_error(_json_path_key(path, key), $"unknown key '{key}'"));
        }
    }
    return Optional<JsonError>.Empty;
}

# `{"name": {}}`, the form of a case that carries values.
_json_case_object(name: String): JsonValue {
    var object = JsonValue.object();
    object[name] = JsonValue.object();
    return object;
}

# `{"key": "name"}`, a tagged case without its values.
_json_tagged_object(key: String, name: String): JsonValue {
    var object = JsonValue.object();
    object[key] = JsonValue.String(name);
    return object;
}

# Empty when `value` is an object holding a string under `key`, the tag of a
# `[Tag]` enum, else the error.
_json_tag_error(value: JsonValue, path: String, key: String): JsonError? {
    if (value.as_object().is_empty()) {
        return Optional<JsonError>.Value(_json_mismatch(path, "an object", value));
    }
    if (!value.contains(key)) {
        return Optional<JsonError>.Value(_json_error(path, $"missing tag '{key}'"));
    }
    var tag = value[key];
    if (tag.as_string().is_empty()) {
        return Optional<JsonError>.Value(_json_mismatch(_json_path_key(path, key), "a string", tag));
    }
    return Optional<JsonError>.Empty;
}

# The case `value` names: under `tag_key` when the enum has a `[Tag]`, else
# as `_json_case_name` reads it.
_json_case_tag(value: JsonValue, tag_key: String): String {
    if (tag_key.is_empty) {
        return _json_case_name(value);
    }
    var tag = value[tag_key].as_string();
    if (tag.is_value()) {
        return tag.value();
    }
    return "";
}

# The object a case's values are read from: beside the tag, under the
# content key, under the case's name, or `value` itself when untagged.
_json_case_payload(value: JsonValue, name: String, tag_key: String, content_key: String, untagged: bool): JsonValue {
    if (untagged || (!tag_key.is_empty && content_key.is_empty)) {
        return value;
    }
    if (!tag_key.is_empty) {
        return value[content_key];
    }
    return value[name];
}

# The path of `_json_case_payload`'s object.
_json_case_path(path: String, name: String, tag_key: String, content_key: String, untagged: bool): String {
    if (untagged || (!tag_key.is_empty && content_key.is_empty)) {
        return path;
    }
    if (!tag_key.is_empty) {
        return _json_path_key(path, content_key);
    }
    return _json_path_key(path, name);
}

# The path of the tag, for an error about its case name.
_json_case_tag_path(path: String, tag_key: String): String {
    if (tag_key.is_empty) {
        return path;
    }
    return _json_path_key(path, tag_key);
}

# Whether to read case `case_name`: the case `value` names, or for an
# untagged enum, every case until one reads.
_json_case_tried(untagged: bool, found: bool, name: String, case_name: String): bool {
    if (untagged) {
        return !found;
    }
    return name == case_name;
}

# The first key of object `value` other than the tag and content keys, as
# an error.
_json_unknown_tag_key(value: JsonValue, tag_key: String, content_key: String, path: String): JsonError? {
    var known = Array<String>();
    known.append(tag_key);
    known.append(content_key);
    return _json_unknown_key(value, known, path);
}

# The case `value` names: a string, or the one key of an object; empty for
# anything else.
_json_case_name(value: JsonValue): String {
    if (value is String(text)) {
        return text;
    }
    var members = value.as_object();
    if (members.is_value() && members.value().count == 1) {
        for (var (key, member) in members.value()) {
            return key;
        }
    }
    return "";
}

# Value `key` of a case, read from `payload` as a `T`, or a default `T`
# when it or an earlier value failed, which goes in `failures`. A missing
# key reads as `null`.
_json_case_value<T>(
    payload: JsonValue, key: String, path: String, unknown_keys: UnknownKeys, failures: Array<JsonError>
): T {
    var witness: T;
    if (failures.count > 0) {
        return witness;
    }
    var result = _from_json(_json_member(payload, key), witness, _json_path_key(path, key), unknown_keys);
    if (result.is_err()) {
        if (payload.contains(key)) {
            failures.append(result.error());
        } else {
            failures.append(_json_error(path, $"missing value '{key}'"));
        }
        return witness;
    }
    return result.value();
}

# Sets member `key` of `object`, when it is an object (a struct reference
# that holds none was written as `Null`).
_json_put(object: JsonValue, key: String, member: JsonValue) {
    if (object is Object(members)) {
        members[key] = member;
    }
}

# `value[key]`, as a call: an indexer in a static block's emitted code
# cannot choose its overload yet.
_json_member(value: JsonValue, key: String): JsonValue {
    return value[key];
}

_json_error(path: String, message: String): JsonError {
    var error = JsonError($"{path}: {message}", line = 0, column = 0);
    error.value_path = path;
    return error;
}

_json_mismatch(path: String, expected: String, found: JsonValue): JsonError {
    return _json_error(path, $"expected {expected}, found {_json_kind(found)}");
}

# How an error names a value's kind: "a string", "null".
_json_kind(value: JsonValue): String {
    match (value) {
        Null => { return "null"; }
        Bool(flag) => { return "a boolean"; }
        Integer(n) => { return "a number"; }
        Number(n) => { return "a number"; }
        String(text) => { return "a string"; }
        Array(items) => { return "an array"; }
        Object(members) => { return "an object"; }
    }
    return "";
}
json/document
5038
## `JsonDocument`: a JSONC document that keeps its comments, so a settings
## file can be read, changed and written back with them.

import "parse";
import "value";

## A JSON value with the comments of the JSONC text it was read from, as
## `parse_document` makes it.
##
## Each comment belongs to a value, by the value's path from the root `$`
## (`$.editor.tab_size`, `$.files[0]`): the comments on the lines before
## a value, or on the line it ends (after its comma), stay with it, and
## those before a closing bracket stay at the end of their array or object.
## `to_string()` writes them back in those places, so text read and
## written unchanged keeps every comment, in the indented layout
## `to_pretty_string` uses.
##
## Change `root` freely. A comment whose value is gone (a removed key, an
## array shortened past it) is not written; one whose path names another
## value afterwards (an element shifted into its index) goes with that
## value.
##
## @example
##     import json;
##
##     var text = "{\n  // The editor.\n  \"tab_size\": 4, // spaces\n  \"wrap\": true\n}";
##     var document = json.parse_document(text).value();
##     document.root["wrap"] = json.JsonValue.Bool(false);
##     assert(
##         document.to_string() == "{\n  // The editor.\n  \"tab_size\": 4, // spaces\n  \"wrap\": false\n}",
##         "the comments stay"
##     );
##     assert(document.comments("$.tab_size")[0] == "// The editor.", "by path");
export struct JsonDocument {
    ## The document's value.
    var root: JsonValue;
    _JsonComments _notes;

    ## Creates a document holding `root`, with no comments.
    ##
    ## @param root the document's value
    construct(root: JsonValue = JsonValue.Null) {
        this.root = root;
        _notes = _JsonComments();
    }

    ## Returns the comments on the lines before the value at `path`, each
    ## with its `//` or `/* */`.
    ##
    ## @param path the value's path from the root: `$`, `$.key`, `$[0]`, or
    ##   `$["a key"]` for a key that is not an identifier
    ## @returns the comments, oldest first; empty when there are none
    comments(path: String): Array<String> {
        var filed = _notes.before.try_get(path);
        var copy = Array<String>();
        if (filed.is_value()) {
            for (var comment in filed.value()) {
                copy.append(comment);
            }
        }
        return copy;
    }

    ## Replaces the comments on the lines before the value at `path`. Each
    ## must be a whole comment, `// ...` (one line) or `/* ... */`.
    ##
    ## @param path the value's path from the root, as for `comments`
    ## @param comments the comments to write before the value; empty
    ##   removes them
    ## @panics if a comment does not start with `//` or `/*` ("a JSONC
    ##   comment starts with '//' or '/*'")
    set_comments(path: String, comments: Array<String>) {
        for (var comment in comments) {
            assert(comment.starts_with("//") || comment.starts_with("/*"), "a JSONC comment starts with '//' or '/*'");
        }
        _notes.before.remove(path);
        _notes.add(_notes.before, path, comments);
    }

    ## Returns the document as indented JSONC text with its comments, each
    ## element and member on its own line, as `to_pretty_string` writes it.
    ##
    ## @param indent the number of spaces per level of nesting
    ## @param ascii_only whether to escape every non-ASCII character as `\u`
    ## @returns the text, without a final line break
    ## @panics if `indent` is negative ("JsonDocument.to_string needs a
    ##   non-negative indent")
    to_string(indent: int = 2, ascii_only: bool = false): String {
        assert(indent >= 0, "JsonDocument.to_string needs a non-negative indent");
        return _json_write_commented(root, _notes, indent + 1, ascii_only);
    }
}

## Parses JSONC text into a `JsonDocument`, keeping its comments.
##
## The text is read as `parse` reads it with `comments = true`: `//` and
## `/* */` comments, and a trailing comma after the last element or member.
## Use it to change a file people edit, such as a settings file, and write
## it back with its comments; use `parse` when the comments do not matter.
##
## @param text the JSONC text
## @param path the name of the text (a file name, say), which the error's
##   `to_string()` puts first
## @param max_depth how deeply arrays and objects may nest
## @returns the document, or an error naming the first problem and its
##   line and column
export parse_document(text: String, path: String = "", max_depth: ulong = 1000): Result<JsonDocument, JsonError> {
    var document = JsonDocument();
    var parsed = _json_parse_commented(text, document._notes, path, max_depth);
    if (parsed.is_err()) {
        return Result<JsonDocument, JsonError>.err(parsed.error());
    }
    document.root = parsed.value();
    return Result<JsonDocument, JsonError>.ok(document);
}
json/module
1815
## JSON: parse text into a `JsonValue`, look values up and change them, and
## write them back as compact or indented text.
##
## Bring it in with `import json`. Parsing follows RFC 8259 strictly, and
## accepts JSONC (comments and trailing commas) on request. Objects keep
## their keys in the order they were written, so a document round-trips
## unchanged. `encode` and `decode` convert structs to JSON text and back.
##
## - [JsonValue](json-value.md): `JsonValue`
## - [Parsing](json-parse.md): `parse`, `JsonError`
## - [Documents with comments](json-document.md): `parse_document`,
##   `JsonDocument`
## - [Struct conversion](json-convert.md): `encode`, `decode`, `to_json`,
##   `from_json`, `UnknownKeys`, with the attributes of the
##   [serialize](serialize-module.md) module
##
## @example
##     import json;
##
##     main(): int {
##         var parsed = json.parse("{\"name\": \"pepper\", \"port\": 8080}");
##         if (parsed.is_err()) {
##             print(parsed.error().to_string());
##             return 1;
##         }
##         var root = parsed.value();
##         assert(root["name"].as_string().value() == "pepper", "a string");
##         assert(root["port"].as_int().value_or(80) == 8080, "a number");
##         root["debug"] = json.JsonValue.Bool(true);
##         assert(root.to_string() == "{\"name\":\"pepper\",\"port\":8080,\"debug\":true}", "compact");
##         return 0;
##     }

# This file only gathers the module's public API from its other files.

import serialize;
import "convert";
import "document";
import "parse";
import "value";

export JsonValue;
export JsonError;
export parse;
export UnknownKeys;
export to_json;
export from_json;
export encode;
export decode;
export JsonDocument;
export parse_document;
json/parse
26539
## `parse`: reading JSON text into a `JsonValue`, and `JsonError`, what it
## reports when the text is not JSON.

import text;
import "value";

## What `parse` reports when the text is not JSON: what is wrong, and the
## line and column where it is.
##
## `to_string()` renders it like a compiler error:
## `config.json:3:17: error: expected ',' or '}'`.
export struct JsonError {
    ## What is wrong, worded like a compiler error (`expected ':'`).
    var message: String;
    ## The path given to `parse`, which names the text in `to_string()`;
    ## empty when none was given.
    var path: String;
    ## The line of the error, from 1; 0 for an error from `from_json`, which
    ## has no text to point into.
    var line: ulong;
    ## The column of the error, from 1, counting bytes as clang does; 0
    ## when `line` is.
    var column: ulong;
    ## The byte offset of the error in the text, from 0.
    var offset: ulong;
    ## Where in the document the value an error is about is, as a path from
    ## the root `$` (`$.server.port`); empty for an error in the text's
    ## syntax. `decode` and `from_json` set it, and start `message` with it.
    var value_path: String;

    ## Creates an error.
    ##
    ## @param message what is wrong
    ## @param path the name of the text, or empty
    ## @param line the line of the error, from 1
    ## @param column the column of the error, from 1
    ## @param offset the byte offset of the error, from 0
    construct(message: String = "", path: String = "", line: ulong = 1, column: ulong = 1, offset: ulong = 0) {
        this.message = message;
        this.path = path;
        this.line = line;
        this.column = column;
        this.offset = offset;
    }

    ## Returns the error as a compiler prints one:
    ## `path:line:column: error: message`, without the `path:` when there
    ## is no path and without `line:column:` when `line` is 0.
    ##
    ## @returns the rendered error
    to_string(): String {
        if (line == 0) {
            if (path.is_empty) {
                return $"error: {message}";
            }
            return $"{path}: error: {message}";
        }
        if (path.is_empty) {
            return $"{line}:{column}: error: {message}";
        }
        return $"{path}:{line}:{column}: error: {message}";
    }
}

## Parses JSON text into a `JsonValue`.
##
## Parsing is strict RFC 8259: one value, surrounded only by spaces, tabs
## and line breaks. A byte-order mark at the start is skipped. The text
## must be valid UTF-8, and a string cannot hold a raw control character
## or a `\u` escape of an unpaired surrogate (`"\uD800"`). When an object
## repeats a key, the last value wins, in the place of the first.
##
## With `comments = true` the text may be JSONC, as VS Code's settings
## files are: `//` line comments, `/* */` block comments, and a trailing
## comma after the last element or member. The comments are skipped.
##
## Nesting comes from the text, so the parser keeps its own stack rather
## than recursing, and `max_depth` bounds it.
##
## @param text the JSON text
## @param comments whether to accept comments and trailing commas
## @param path the name of the text (a file name, say), which the error's
##   `to_string()` puts first
## @param max_depth how deeply arrays and objects may nest
## @returns the value, or an error naming the first problem and its line
##   and column
## @example
##     import json;
##
##     var parsed = json.parse("{\"server\": {\"port\": 8080}}");
##     assert(parsed.value()["server"]["port"].as_int().value() == 8080, "a lookup");
##     var bad = json.parse("[1 2]", path = "list.json");
##     assert(bad.error().to_string() == "list.json:1:4: error: expected ',' or ']'", "where");
export parse(
    text: String, comments: bool = false, path: String = "", max_depth: ulong = 1000
): Result<JsonValue, JsonError> {
    var parser = _JsonParser(text, comments, path, max_depth);
    return parser.run();
}

# Parses JSONC `text` like `parse` with `comments = true`, filing its
# comments in `notes`.
_json_parse_commented(
    text: String, notes: _JsonComments, path: String, max_depth: ulong
): Result<JsonValue, JsonError> {
    var parser = _JsonParser(text, true, path, max_depth);
    parser._notes = Optional<_JsonComments>.Value(notes);
    return parser.run();
}

# The byte offset in `text`, which must parse, of the value at `value_path`
# (`$.server.port`, as `_json_path_key` writes it), or none when it is not
# there. Parses the text again, so it is only for errors.
_json_locate(text: String, comments: bool, value_path: String): ulong? {
    var parser = _JsonParser(text, comments, "", 1000000);
    parser._find = value_path;
    parser.run();
    if (parser._found >= 0) {
        return Optional<ulong>.Value(parser._found as ulong);
    }
    return Optional<ulong>.Empty;
}

# Reads one value from `_text`. Each method that can fail returns false
# after recording the first error in `_error`.
struct _JsonParser {
    String _text;
    ulong _size;
    ulong _position;
    bool _comments;
    String _path;
    ulong _max_depth;
    JsonError _error;
    # The value the last `_scalar` or `_string` read.
    JsonValue _scalar_value;
    String _string_value;
    # A string literal makes a new String each time it runs, so the words
    # live in fields, made once.
    String _true;
    String _false;
    String _null;
    String _no_key;
    # With `_json_locate`: the path of the value to find, and its offset
    # once found (-1 until then).
    String _find;
    long _found;
    # With `_json_parse_commented`: where the comments go, the comments
    # read since the last value was filed, whether each began on the line
    # the last value ended on, and whether a line break came since then.
    _JsonComments? _notes;
    Array<String> _pending;
    Array<bool> _inline;
    bool _newline;

    construct(text: String, comments: bool, path: String, max_depth: ulong) {
        _text = text;
        _size = text.size;
        _comments = comments;
        _path = path;
        _max_depth = max_depth;
        _true = "true";
        _false = "false";
        _null = "null";
        _no_key = "";
        _find = "";
        _found = -1;
        _notes = Optional<_JsonComments>.Empty;
        _pending = Array<String>();
        _inline = Array<bool>();
        _newline = false;
    }

    # Files the comments read since the last value under `path` in `kind`,
    # only those on the last value's line when `inline_only`.
    _file(kind: HashMap<String, Array<String>>, path: String, inline_only: bool) {
        if (_pending.is_empty) {
            return;
        }
        var filed = Array<String>();
        var rest = Array<String>();
        var rest_inline = Array<bool>();
        for (var index in 0.._pending.count) {
            if (!inline_only || _inline[index]) {
                filed.append(_pending[index]);
            } else {
                rest.append(_pending[index]);
                rest_inline.append(false);
            }
        }
        _notes.value().add(kind, path, filed);
        _pending = rest;
        _inline = rest_inline;
    }

    run(): Result<JsonValue, JsonError> {
        if (_size >= 3 and _text.byte_at(0) == 239 and _text.byte_at(1) == 187 and _text.byte_at(2) == 191) {
            _position = 3;
        }
        var invalid = text.Utf8.find_invalid(_text);
        if (invalid.is_value()) {
            _fail_at("invalid UTF-8", invalid.value());
            return Result<JsonValue, JsonError>.err(_error);
        }
        var value = _parse();
        if (value.is_empty()) {
            return Result<JsonValue, JsonError>.err(_error);
        }
        return Result<JsonValue, JsonError>.ok(value.value());
    }

    # The parse loop. Each container still open is on `containers`, with
    # the key of the member being read on `keys` ("" for an array).
    _parse(): JsonValue? {
        var none = Optional<JsonValue>.Empty;
        var containers = Array<JsonValue>();
        var keys = Array<String>();
        # With `_find` or `_notes`: each open container's path, and each
        # array's index.
        var keeping = _notes.is_value();
        var tracking = keeping || !_find.is_empty;
        var paths = Array<String>();
        var indexes = Array<ulong>();
        var here = "$";
        while (true) {
            # Read a value, or open a container.
            if (!_skip_space()) {
                return none;
            }
            if (tracking) {
                if (containers.is_empty) {
                    here = "$";
                } else if (containers.last() is Array) {
                    here = $"{paths.last()}[{indexes.last()}]";
                } else {
                    here = _json_path_key(paths.last(), keys.last());
                }
                if (here == _find) {
                    _found = _position as long;
                    return none;
                }
                if (keeping) {
                    _file(_notes.value().before, here, false);
                }
            }
            var value = JsonValue.Null;
            var b = _peek();
            if (b == '[' or b == '{') {
                if (containers.count >= _max_depth) {
                    _fail($"arrays and objects nest more than {_max_depth} deep");
                    return none;
                }
                _position = _position + 1;
                var opened = b == '[' ? JsonValue.array() : JsonValue.object();
                if (!_skip_space()) {
                    return none;
                }
                if (_peek() != (b == '[' ? ']' : '}')) {
                    containers.append(opened);
                    if (tracking) {
                        paths.append(here);
                        indexes.append(0);
                    }
                    if (b == '{') {
                        if (!_key()) {
                            return none;
                        }
                        keys.append(_string_value);
                    } else {
                        keys.append(_no_key);
                    }
                    continue;
                }
                if (keeping) {
                    _file(_notes.value().end, here, false);
                }
                _position = _position + 1;
                value = opened;
            } else {
                if (!_scalar()) {
                    return none;
                }
                value = _scalar_value;
            }
            # Store the value in its container, then close every container
            # that ends after it.
            while (true) {
                _newline = false;
                if (containers.is_empty) {
                    if (!_skip_space()) {
                        return none;
                    }
                    if (_position < _size) {
                        _fail("expected the end of the text after the value");
                        return none;
                    }
                    if (keeping) {
                        _file(_notes.value().after, "$", true);
                        _file(_notes.value().end, "", false);
                    }
                    return Optional<JsonValue>.Value(value);
                }
                var top = containers.last();
                var is_array = top is Array;
                # The path of the value just read, for its comments.
                var stored = _no_key;
                if (top is Array(items)) {
                    items.append(value);
                    if (tracking) {
                        if (keeping) {
                            stored = $"{paths.last()}[{indexes.last()}]";
                        }
                        indexes[indexes.count - 1] = indexes.last() + 1;
                    }
                } else if (top is Object(members)) {
                    members[keys.last()] = value;
                    if (keeping) {
                        stored = _json_path_key(paths.last(), keys.last());
                    }
                }
                if (!_skip_space()) {
                    return none;
                }
                byte closing = is_array ? ']' : '}';
                var next = _peek();
                if (next == ',') {
                    var comma = _position;
                    _position = _position + 1;
                    if (!_skip_space()) {
                        return none;
                    }
                    if (keeping) {
                        _file(_notes.value().after, stored, true);
                    }
                    if (_peek() != closing) {
                        if (!is_array) {
                            if (!_key()) {
                                return none;
                            }
                            keys[keys.count - 1] = _string_value;
                        }
                        break;
                    }
                    if (!_comments) {
                        _fail_at("trailing comma is not allowed; parse with 'comments = true' to accept JSONC", comma);
                        return none;
                    }
                } else if (next != closing) {
                    _fail(is_array ? "expected ',' or ']'" : "expected ',' or '}'");
                    return none;
                }
                if (keeping) {
                    _file(_notes.value().after, stored, true);
                    _file(_notes.value().end, paths.last(), false);
                }
                _position = _position + 1;
                value = containers.pop();
                keys.pop();
                if (tracking) {
                    paths.pop();
                    indexes.pop();
                }
            }
        }
        return none;
    }

    # The byte at the position, or 0 at the end of the text.
    _peek(): byte {
        if (_position < _size) {
            return _text.byte_at(_position);
        }
        return 0;
    }

    # Skips spaces, tabs and line breaks, and with `_comments` the comments
    # among them. Fails only on a comment that is not allowed or not closed.
    _skip_space(): bool {
        while (_position < _size) {
            var b = _text.byte_at(_position);
            if (b == ' ' or b == '\t' or b == '\n' or b == '\r') {
                if (b == '\n') {
                    _newline = true;
                }
                _position = _position + 1;
            } else if (b == '/'
                and _position + 1 < _size
                and (_text.byte_at(_position + 1) == '/' or _text.byte_at(_position + 1) == '*')) {
                if (!_comments) {
                    _fail("comments are not allowed; parse with 'comments = true' to accept JSONC");
                    return false;
                }
                var start = _position;
                if (_text.byte_at(_position + 1) == '/') {
                    while (_position < _size and _text.byte_at(_position) != '\n') {
                        _position = _position + 1;
                    }
                } else {
                    var end = _text.find("*/", _position + 2);
                    if (end < 0) {
                        _fail_at("unterminated '/*' comment", start);
                        return false;
                    }
                    _position = (end as ulong) + 2;
                }
                if (_notes.is_value()) {
                    var size = _position - start;
                    if (_text.byte_at(_position - 1) == '\r') {
                        size = size - 1;
                    }
                    _pending.append(_text.substr_bytes(start, size));
                    _inline.append(!_newline);
                }
            } else {
                return true;
            }
        }
        return true;
    }

    # Reads an object member's key and the ':' after it into `_string_value`.
    _key(): bool {
        if (_peek() != '"') {
            _fail("expected a member name in double quotes");
            return false;
        }
        if (!_string()) {
            return false;
        }
        if (!_skip_space()) {
            return false;
        }
        if (_peek() != ':') {
            _fail("expected ':'");
            return false;
        }
        _position = _position + 1;
        return true;
    }

    # Reads a value that is not an array or object into `_scalar_value`.
    _scalar(): bool {
        var b = _peek();
        if (b == '"') {
            if (!_string()) {
                return false;
            }
            _scalar_value = JsonValue.String(_string_value);
            return true;
        }
        if (b == '-' or (b >= '0' and b <= '9')) {
            return _number();
        }
        if (_word(_true)) {
            _scalar_value = JsonValue.Bool(true);
            return true;
        }
        if (_word(_false)) {
            _scalar_value = JsonValue.Bool(false);
            return true;
        }
        if (_word(_null)) {
            _scalar_value = JsonValue.Null;
            return true;
        }
        if (_position >= _size) {
            _fail("expected a value");
        } else if (b == ']' or b == '}') {
            _fail($"expected a value before '{_text.substr_bytes(_position, 1)}'");
        } else {
            _fail("expected a value");
        }
        return false;
    }

    # Consumes `word` when the text continues with it and no letter or
    # digit follows.
    _word(word: String): bool {
        var size = word.size;
        if (_position + size > _size) {
            return false;
        }
        ulong index = 0;
        while (index < size) {
            if (_text.byte_at(_position + index) != word.byte_at(index)) {
                return false;
            }
            index = index + 1;
        }
        if (_position + size < _size) {
            var after = _text.byte_at(_position + size);
            if ((after >= 'a' and after <= 'z') or (after >= 'A' and after <= 'Z') or (after >= '0' and after <= '9')) {
                return false;
            }
        }
        _position = _position + size;
        return true;
    }

    # Reads a number: `-`, then `0` or digits not starting with `0`, then an
    # optional fraction and exponent, each with at least one digit.
    _number(): bool {
        var start = _position;
        var whole = true;
        if (_peek() == '-') {
            _position = _position + 1;
        }
        if (_peek() == '0') {
            _position = _position + 1;
            if (_peek().is_digit()) {
                _fail("a number cannot start with '0'");
                return false;
            }
        } else if (!_digits()) {
            return false;
        }
        if (_peek() == '.') {
            whole = false;
            _position = _position + 1;
            if (!_digits()) {
                return false;
            }
        }
        if (_peek() == 'e' or _peek() == 'E') {
            whole = false;
            _position = _position + 1;
            if (_peek() == '+' or _peek() == '-') {
                _position = _position + 1;
            }
            if (!_digits()) {
                return false;
            }
        }
        var spelled = _text.substr_bytes(start, _position - start);
        if (whole) {
            # 2^53 - 1, the largest integer every JSON reader agrees on.
            var parsed = long.parse(spelled);
            if (parsed.is_value() and parsed.value() <= 9007199254740991 and parsed.value() >= -9007199254740991) {
                _scalar_value = JsonValue.Integer(parsed.value());
                return true;
            }
        }
        var number = double.parse(spelled);
        if (number.is_empty()) {
            _fail_at("number is too large for a double", start);
            return false;
        }
        _scalar_value = JsonValue.Number(number.value());
        return true;
    }

    # Consumes one or more digits.
    _digits(): bool {
        if (!_peek().is_digit()) {
            _fail("expected a digit");
            return false;
        }
        while (_peek().is_digit()) {
            _position = _position + 1;
        }
        return true;
    }

    # Reads a string, starting at its opening '"', into `_string_value`.
    # Text without escapes is copied whole; escapes decode into bytes.
    _string(): bool {
        var open = _position;
        _position = _position + 1;
        var start = _position;
        Array<u8> decoded = __null;
        while (true) {
            if (_position >= _size) {
                _fail_at("unterminated string", open);
                return false;
            }
            var b = _text.byte_at(_position);
            if (b == '"') {
                break;
            }
            if (b < 32) {
                _fail("control character in a string; write it as an escape such as '\\n'");
                return false;
            }
            if (b != '\\') {
                _position = _position + 1;
                continue;
            }
            if (decoded === __null) {
                decoded = Array<u8>();
            }
            _append_bytes(decoded, start, _position);
            if (!_escape(decoded)) {
                return false;
            }
            start = _position;
        }
        if (decoded === __null) {
            _string_value = _text.substr_bytes(start, _position - start);
        } else {
            _append_bytes(decoded, start, _position);
            _string_value = text.Utf8.decode_lossy(decoded);
        }
        _position = _position + 1;
        return true;
    }

    # Appends the bytes of `_text` from `start` up to `end` to `out`.
    _append_bytes(out: u8[], start: ulong, end: ulong) {
        var index = start;
        while (index < end) {
            out.append(_text.byte_at(index) as u8);
            index = index + 1;
        }
    }

    # Decodes the escape at the position, a '\', onto `out`.
    _escape(out: u8[]): bool {
        var start = _position;
        _position = _position + 1;
        var b = _peek();
        _position = _position + 1;
        if (b == '"' or b == '\\' or b == '/') {
            out.append(b as u8);
        } else if (b == 'n') {
            out.append(10);
        } else if (b == 't') {
            out.append(9);
        } else if (b == 'r') {
            out.append(13);
        } else if (b == 'b') {
            out.append(8);
        } else if (b == 'f') {
            out.append(12);
        } else if (b == 'u') {
            var unit = _hex4(start);
            if (unit < 0) {
                return false;
            }
            var point = unit as uint;
            if (unit >= 56320 and unit <= 57343) {
                _fail_at($"unpaired surrogate '{_text.substr_bytes(start, 6)}'", start);
                return false;
            }
            if (unit >= 55296 and unit <= 56319) {
                var low = -1;
                if (_position + 1 < _size
                    and _text.byte_at(_position) == '\\'
                    and _text.byte_at(_position + 1) == 'u') {
                    var second = _position;
                    _position = _position + 2;
                    low = _hex4(second);
                    if (low < 0) {
                        return false;
                    }
                }
                if (low < 56320 or low > 57343) {
                    _fail_at($"unpaired surrogate '{_text.substr_bytes(start, 6)}'", start);
                    return false;
                }
                point = 65536 + (((unit - 55296) as uint) << 10) + ((low - 56320) as uint);
            }
            text.Utf8.append_code_point(out, point);
        } else {
            if (_position > _size) {
                _fail_at("unterminated string", start);
            } else {
                _fail_at($"invalid escape '{_text.substr_bytes(start, _position - start)}'", start);
            }
            return false;
        }
        return true;
    }

    # Reads the four hexadecimal digits after a `\u` that starts at
    # `start`, giving -1 after recording an error when they are not there.
    _hex4(start: ulong): int {
        var value = 0;
        var count = 0;
        while (count < 4) {
            var b = _peek();
            var digit = -1;
            if (b >= '0' and b <= '9') {
                digit = (b - '0') as int;
            } else if (b >= 'a' and b <= 'f') {
                digit = (b - 'a') as int + 10;
            } else if (b >= 'A' and b <= 'F') {
                digit = (b - 'A') as int + 10;
            }
            if (digit < 0) {
                _fail_at("'\\u' needs four hexadecimal digits", start);
                return -1;
            }
            value = value * 16 + digit;
            _position = _position + 1;
            count = count + 1;
        }
        return value;
    }

    _fail(message: String) {
        _fail_at(message, _position);
    }

    # Records the error `message` at byte `offset`, working out its line and
    # column.
    _fail_at(message: String, offset: ulong) {
        _error = JsonError(message, _path);
        _json_place(_error, _text, offset);
    }
}

# Sets `error`'s offset, and the line and column of that offset in `text`.
_json_place(error: JsonError, text: String, offset: ulong) {
    ulong line = 1;
    ulong line_start = 0;
    ulong index = 0;
    while (index < offset and index < text.size) {
        if (text.byte_at(index) == '\n') {
            line = line + 1;
            line_start = index + 1;
        }
        index = index + 1;
    }
    error.line = line;
    error.column = offset - line_start + 1;
    error.offset = offset;
}
json/value
