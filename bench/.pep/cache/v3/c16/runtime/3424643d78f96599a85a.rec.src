import "internals";

# Elements of a struct-typed Array are references: the constructor initializes
# each to null (zero-init), every store into a slot releases the old occupant
# and acquires the new value (codegen, at the store site), and every place an
# element leaves the live range nulls its slot so the reference is released
# (or moves out with `move`). The destructor detaches the buffer and releases
# each element (`data[i].__release()`) without writing the slot, since the
# buffer is freed next. A plain-value `T` (`int`,
# a tuple of numbers) owns nothing, so none of this applies to it: its slots
# are left as they are.
#
# Shifts (insert, remove_at) move a whole run of slots with one memmove, swap
# exchanges two slots' bytes, and sort permutes raw slots through a scratch
# buffer: a move does not change a reference's count, exactly as moving
# shared_ptrs between slots would not.
#
# Every mutating method (element store, append, insert, remove_at, pop, clear,
# truncate, swap) bumps _version; an ArrayIterator panics when it sees a
# _version other than the one it started with, so modifying an Array while a
# `for` loop iterates it is a panic rather than skipped or repeated elements.
#
# `[__Lazy]`: an empty Array is a null reference until it is written
# or shared. `Array<T>()` is null; codegen allocates the object (this
# constructor with capacity 0) when a place holding null is read for anything
# but a `[__Reads]` method's receiver or a field read, and a field read
# through null reads a zeroed constant. So the `[__Reads]` methods below run
# with a null `this`, and `check_lazy` keeps them from writing to it. An
# iterator made from an empty Array holds null, so appending to the Array
# while it runs is not detected; it simply ends.

## A growable, contiguous, zero-indexed sequence of `T` values.
##
## Elements live in one heap buffer that doubles when full (starting at 4
## slots), so `append` is amortized O(1) and indexing is O(1). When `T` is a
## struct type, each slot holds a counted reference, exactly like a
## `std::vector<std::shared_ptr<T>>`: storing an element acquires it,
## overwriting or removing one releases the old occupant, and destroying the
## Array releases every element it still holds. Moving elements within the
## Array (`insert`, `remove_at`, `swap`, `reverse`) does not change their
## reference counts.
##
## `Array` is itself a struct, so assigning it or passing it to a function
## shares the same Array rather than copying its elements; use `clone()` for
## an independent copy.
##
## An empty Array allocates nothing: `Array<T>()` makes no object until the
## Array is first written (`append`, `insert`, `reserve`, ...) or shared
## (assigned, stored, passed or returned), and reading it (`count`,
## `is_empty`, `capacity`, `find`, `contains`, iterating) allocates nothing.
## Sharing allocates first, so every name for an Array sees the same
## elements.
##
## An Array is `Iterable<T>`: `for (var x in a)` visits each element in index
## order. Every mutating operation (an element store through `[]`, `append`,
## `insert`, `remove_at`, `pop`, `clear`, a shrinking `truncate`, `swap`,
## `fill`, `retain`, `remove_if`, `resize`, `split_off`, `drain`,
## `extend_from`, `rotate`, `select_nth`, `partial_sort`, and `reverse`,
## `sort`, `sort_unstable` or `dedup` of two or more elements) invalidates
## running iterators and slices
## (`slice`), and the next step of such a loop panics with "Array modified
## during iteration".
##
## @typeParam T the element type
## @example
##     main(): int {
##         var a = Array<int>();
##         a.append(1);
##         a.append(2);
##         a[0] = 5;
##         var total = 0;
##         for (var x in a) {
##             total = total + x;
##         }
##         return total;   # 7
##     }
## @see ArrayIterator
[__Lazy]
export struct Array<T> {
    ## The element buffer: `_capacity` slots, of which the first `_size` hold
    ## live elements. When `T` holds references the rest are zeroed (null for
    ## struct `T`); for a plain-value `T` they may hold stale values. Null while
    ## `_capacity` is 0. Internal storage; use the methods instead of touching
    ## it directly.
    __ptr<T> _data;
    ## The number of live elements; always at most `_capacity`. Read it through `count`.
    ulong _size;
    ## The number of element slots allocated in `_data`; never shrinks. Read it through `capacity`.
    ulong _capacity;
    ## The modification counter: incremented by every mutating operation so
    ## that an `ArrayIterator` can detect changes made while it runs. Its
    ## value carries no other meaning.
    ulong _version;
    ## The number of I/O operations using the buffer right now (a file read
    ## or write in a task, which another thread or the kernel carries out
    ## while other tasks run). While it is not 0 the buffer must not move,
    ## so growing it panics.
    ulong _pins;

    ## Creates an empty Array, optionally preallocating room for `capacity`
    ## elements.
    ##
    ## With the default `capacity` of 0, nothing is allocated, not even the
    ## Array itself, until the Array is first written or shared (see `Array`).
    ## Preallocating avoids the reallocations `append`
    ## would otherwise perform while the Array grows to a known size.
    ##
    ## @param capacity the number of element slots to allocate up front; `count` is still 0
    ## @example
    ##     var a = Array<int>(16);   # a.count == 0, a.capacity == 16
    construct(capacity: ulong = 0) {
        if (capacity > 0) {
            _data = _pep_malloc(sizeof<T>() * capacity);
            _capacity = capacity;
        }
    }

    destruct {
        # Detach the buffer before releasing anything: an element's
        # destructor that reaches this Array through a cycle then finds it
        # empty, never an element being destroyed. The slots are not
        # written, since the buffer is freed next. Anything such a
        # destructor appends lands in a new buffer, released the same way.
        # The pointer compares as bytes: `__ptr<T>` would pick `T`'s own `!=`.
        while (unsafe_cast<__ptr<u8>>(_data) != __null) {
            __ptr<T> data = _data;
            ulong count = _size;
            _data = __null;
            _size = 0;
            _capacity = 0;
            # A plain value owns nothing, so it is skipped.
            if (!__is_pod<T>()) {
                ulong index = 0;
                while (index < count) {
                    data[index].__release();
                    index = index + 1;
                }
            }
            _pep_free(data);
        }
    }

    # The address of slot `index`, in bytes: `_data + index` would pick `T`'s
    # own `+` when `T` has one.
    _slot(index: ulong): __ptr<u8> {
        __ptr<u8> bytes = unsafe_cast<__ptr<u8>>(_data);
        return bytes + index * sizeof<T>();
    }

    # Releases the elements in slots `start` up to `end`, nulling each slot
    # before its element is released (`operator=`), so a destructor that
    # reads the Array finds null there, never the element being destroyed.
    # Leaves `_size` alone.
    _release_range(start: ulong, end: ulong) {
        if (!__is_pod<T>()) {
            ulong index = start;
            while (index < end) {
                _data[index] = __default<T>();
                index = index + 1;
            }
        }
    }

    # Makes room for `extra` more elements, at least doubling the capacity
    # when it must grow so that repeated bulk appends stay amortized O(1).
    _reserve_extra(extra: ulong) {
        if (_size + extra > _capacity) {
            var capacity = _capacity * 2;
            if (capacity < _size + extra) {
                capacity = _size + extra;
            }
            reserve(capacity);
        }
    }

    ## Returns an iterator over the elements in index order; this is what
    ## `for (var x in array)` calls (the `Iterable<T>` protocol).
    ##
    ## The iterator holds a reference to the Array, so iterating a temporary
    ## keeps it alive for the whole loop. Modifying the Array while the
    ## iterator is in use makes the iterator's next `next()` or `current()`
    ## panic, except when the Array was empty when the iterator was made:
    ## the iterator then sees no elements and ends.
    ##
    ## @returns a new iterator positioned before the first element
    ## @example
    ##     for (var x in a) {
    ##         total = total + x;
    ##     }
    [__Reads]
    iterate(): ArrayIterator<T> {
        var it = ArrayIterator<T>();
        it._source = this;
        it._version = _version;
        return it;
    }

    ## The number of elements in the Array.
    [__Reads]
    var count: ulong {
        get {
            return _size;
        }
    }

    ## The number of elements the Array can hold before its buffer
    ## must be reallocated.
    [__Reads]
    var capacity: ulong {
        get {
            return _capacity;
        }
    }

    ## Returns a pointer to the first element, for passing the elements to C,
    ## as `String.c_str()` does for text.
    ##
    ## The pointer is owned by the Array. It is valid until the Array is
    ## destroyed or its buffer reallocates (`append`, `insert`, `reserve`, or
    ## anything else that grows it); writes through it change the elements.
    ## For an empty Array it is `__null`, even when capacity is reserved.
    ##
    ## @returns the address of element 0, or `__null` when the Array is empty
    ## @see append_from
    ## @example
    ##     var a = Array<int>();
    ##     a.append(7);
    ##     var p = a.data();   # p[0] == 7
    [__Reads]
    data(): __ptr<T> {
        if (_size == 0) {
            return __null;
        }
        return _data;
    }

    ## Whether the Array has no elements.
    [__Reads]
    var is_empty: bool {
        get {
            return _size == 0;
        }
    }

    ## Ensures the buffer has room for at least `capacity` elements,
    ## reallocating it when it is smaller.
    ##
    ## Never shrinks the buffer: a `capacity` at or below the current one does
    ## nothing. Elements, their order, and their reference counts are
    ## unchanged, and running iterators stay valid. Growing copies the
    ## existing elements, which costs O(count).
    ##
    ## @param capacity the minimum number of element slots required
    ## @panics if the buffer must grow while an I/O operation in a task is using it
    ## @example
    ##     var a = Array<int>();
    ##     a.reserve(8);   # a.capacity >= 8
    ##     a.reserve(2);   # no effect: capacity never shrinks
    reserve(capacity: ulong) {
        if (capacity > _capacity) {
            assert(_pins == 0, "Array: the buffer is in use by an I/O operation");
            ulong prev_size = sizeof<T>() * _capacity;
            ulong new_size = sizeof<T>() * capacity;
            # Slots past `count` are read only when they hold references, which must start null.
            _data = __is_pod<T>() ?
                _pep_realloc_uninit(_data, prev_size, new_size) :
                _pep_realloc(_data, prev_size, new_size);
            _capacity = capacity;
        }
    }

    ## Makes room for one more element: when the buffer is full, doubles its
    ## capacity (to at least 4); otherwise does nothing.
    ##
    ## `append` and `insert` call this themselves; callers rarely need it.
    ## Does not change the elements or invalidate iterators.
    ##
    ## @panics if the buffer must grow while an I/O operation in a task is using it
    grow() {
        if (_size >= _capacity) {
            ulong next = _capacity * 2;
            if (next < 4) {
                next = 4;
            }
            reserve(next);
        }
    }

    ## Returns the element at `idx`; this is the indexer read `a[idx]`.
    ##
    ## Runs in O(1). For a struct `T` the result is the stored reference
    ## itself; binding it to a variable acquires it like any shared copy.
    ##
    ## @param idx the zero-based position to read
    ## @returns the element at `idx`
    ## @panics if `idx < count` does not hold ("Array index read out of bounds")
    ## @example
    ##     var first = a[0];
    [__Reads]
    [](idx: ulong, location: __ptr<char> = __caller_location()): T {
        _pep_check_bounds(idx < _size, "Array index read out of bounds", location);
        return _data[idx];
    }

    ## Replaces the element at `idx` with `value`; this is the indexer write
    ## `a[idx] = value`.
    ##
    ## For a struct `T` the slot acquires `value` and releases its previous
    ## occupant; assigning an element to its own slot (`a[i] = a[i]`) leaves
    ## counts unchanged. Only replaces an existing element: use `append` to
    ## add one. Invalidates running iterators, even when the value is
    ## unchanged.
    ##
    ## @param idx the zero-based position to overwrite
    ## @param value the new element
    ## @returns the element now stored at `idx` (that is, `value`)
    ## @panics if `idx < count` does not hold ("Array index write out of bounds")
    ## @example
    ##     a[0] = 42;
    [](idx: ulong, value: T, location: __ptr<char> = __caller_location()): T {
        _pep_check_bounds(idx < _size, "Array index write out of bounds", location);
        _version = _version + 1;
        _data[idx] = value;
        return _data[idx];
    }

    ## Adds `item` to the end of the Array.
    ##
    ## Amortized O(1): when the buffer is full it doubles (O(count) for that
    ## call). For a struct `T` the Array acquires a reference to `item`.
    ## Invalidates running iterators.
    ##
    ## @param item the element to add
    ## @panics if the buffer must grow while an I/O operation in a task is using it
    ## @example
    ##     var a = Array<int>();
    ##     a.append(1);
    ##     a.append(2);   # a holds [1, 2]
    append(item: T) {
        _version = _version + 1;
        grow();
        # Slots past `count` are kept empty, so the store only acquires.
        __construct_at(_data[_size], item);
        _size = _size + 1;
    }

    ## Appends the `count` elements at `source`, in order: the way to fill an
    ## Array from a C buffer, as `String(data, size)` does for text.
    ##
    ## Runs in O(count), with one copy of the whole range for a POD `T`. For
    ## a struct `T` the Array acquires a reference to each element. `source`
    ## must point at `count` valid elements, and not into this Array, which
    ## may reallocate. Invalidates running iterators.
    ##
    ## @param source the first element to copy; may be `__null` when `count` is 0
    ## @param count the number of elements to copy
    ## @panics if the buffer must grow while an I/O operation in a task is using it
    ## @see data
    ## @example
    ##     var a = Array<u8>();
    ##     a.append(1);
    ##     a.append(2);
    ##     var b = Array<u8>();
    ##     b.append_from(a.data(), a.count);   # b holds [1, 2]
    append_from(source: __ptr<T>, count: ulong) {
        if (count == 0) {
            return;
        }
        if (__is_pod<T>()) {
            _append_raw(source, count);
            return;
        }
        _version = _version + 1;
        _reserve_extra(count);
        ulong index = 0;
        while (index < count) {
            # Slots past `count` are kept empty, so the store only acquires.
            __construct_at(_data[_size], source[index]);
            _size = _size + 1;
            index = index + 1;
        }
    }

    # Appends the `count` elements at `source` with one copy, for a POD `T`
    # only (no reference counting is done): a byte buffer filling from
    # another. Internal.
    _append_raw(source: __ptr<T>, count: ulong) {
        if (count == 0) {
            return;
        }
        _version = _version + 1;
        _reserve_extra(count);
        _array_copy(_slot(_size), source, count * sizeof<T>());
        _size = _size + count;
    }

    ## Inserts `item` at position `idx`, shifting the element there and every
    ## later element up by one.
    ##
    ## Runs in O(count - idx), plus a reallocation when the buffer is full.
    ## `idx == count` appends. For a struct `T` the Array acquires a
    ## reference to `item`; shifted elements keep their reference counts.
    ## Invalidates running iterators.
    ##
    ## @param idx the position `item` will occupy; from 0 through `count`
    ## @param item the element to insert
    ## @panics if `idx <= count` does not hold ("Array insert index out of bounds")
    ## @panics if the buffer must grow while an I/O operation in a task is using it
    ## @example
    ##     var a = Array<int>();
    ##     a.append(1);
    ##     a.append(3);
    ##     a.insert(1, 2);   # a holds [1, 2, 3]
    insert(idx: ulong, item: T, location: __ptr<char> = __caller_location()) {
        assert(idx <= _size, "Array insert index out of bounds", location);
        _version = _version + 1;
        grow();
        # Shift the tail up one slot as raw bytes: each reference moves to
        # its new slot without changing its count, exactly as moving
        # `shared_ptr`s between slots would. The vacated slot still holds a
        # copy of the bits it moved, so it is zeroed, leaving an empty slot
        # for the store to construct into.
        if (idx < _size) {
            _array_move(_slot(idx + 1), _slot(idx), (_size - idx) * sizeof<T>());
            _array_zero(_slot(idx), sizeof<T>());
        }
        __construct_at(_data[idx], item);
        _size = _size + 1;
    }
    ## Removes and returns the element at `idx`, shifting every later element
    ## down by one.
    ##
    ## Runs in O(count - idx). For a struct `T` the Array's reference is
    ## transferred to the caller, so the element stays alive as long as the
    ## result is held; shifted elements keep their reference counts. The
    ## capacity is unchanged. Invalidates running iterators.
    ##
    ## @param idx the position of the element to remove
    ## @returns the removed element
    ## @panics if `idx < count` does not hold ("Array remove index out of bounds")
    ## @example
    ##     var a = Array<int>();
    ##     a.append(1);
    ##     a.append(2);
    ##     var x = a.remove_at(0);   # x == 1; a holds [2]
    remove_at(idx: ulong, location: __ptr<char> = __caller_location()): T {
        assert(idx < _size, "Array remove index out of bounds", location);
        _version = _version + 1;
        # The slot's reference moves to the caller, with no count step.
        var removed = move(_data[idx]);
        # Shift the tail down one slot as raw bytes (references keep their
        # counts), then zero the last slot, whose reference moved down.
        _array_move(_slot(idx), _slot(idx + 1), (_size - idx - 1) * sizeof<T>());
        if (!__is_pod<T>()) {
            _array_zero(_slot(_size - 1), sizeof<T>());
        }
        _size = _size - 1;
        return removed;
    }

    ## Removes and returns the last element.
    ##
    ## Runs in O(1). For a struct `T` the Array's reference is transferred to
    ## the caller. The capacity is unchanged. Invalidates running iterators.
    ##
    ## @returns the element that was last
    ## @panics if the Array is empty ("Array pop on empty Array")
    ## @example
    ##     var top = a.pop();
    pop(location: __ptr<char> = __caller_location()): T {
        assert(_size > 0, "Array pop on empty Array", location);
        _version = _version + 1;
        _size = _size - 1;
        # The slot's reference moves to the caller, with no count step.
        return move(_data[_size]);
    }

    ## Returns the first element without removing it; the same as `a[0]`.
    ##
    ## @returns the element at index 0
    ## @panics if the Array is empty ("Array first on empty Array")
    [__Reads]
    first(location: __ptr<char> = __caller_location()): T {
        assert(_size > 0, "Array first on empty Array", location);
        return _data[0];
    }

    ## Returns the last element without removing it; the same as
    ## `a[a.count - 1]`.
    ##
    ## @returns the element at index `count - 1`
    ## @panics if the Array is empty ("Array last on empty Array")
    [__Reads]
    last(location: __ptr<char> = __caller_location()): T {
        assert(_size > 0, "Array last on empty Array", location);
        return _data[_size - 1];
    }

    ## Removes every element, leaving the Array empty.
    ##
    ## Runs in O(count) for a `T` holding references, each of which is
    ## released, and in O(1) for a plain value `T` (`int`, `u8`, a tuple of
    ## numbers). The capacity is kept, so refilling the Array does not
    ## reallocate. Always invalidates running iterators, even on an empty
    ## Array.
    clear() {
        _version = _version + 1;
        _release_range(0, _size);
        _size = 0;
    }

    ## Shortens the Array to its first `count` elements, removing the rest.
    ##
    ## Runs in O(removed elements). For a struct `T` each removed element's
    ## reference is released. A `count` at or above the current `count`
    ## does nothing (the Array never grows) and leaves iterators valid; an
    ## actual shrink invalidates them. The capacity is kept.
    ##
    ## @param count the number of leading elements to keep
    ## @example
    ##     a.truncate(1);   # keeps only a[0]
    ##     a.truncate(5);   # no effect when a has fewer than 5 elements
    truncate(count: ulong) {
        if (count < _size) {
            _version = _version + 1;
            _release_range(count, _size);
            _size = count;
        }
    }

    ## Exchanges the elements at positions `a` and `b`.
    ##
    ## Runs in O(1). Reference counts are unchanged: the two references just
    ## trade slots. Swapping a position with itself is allowed and changes no
    ## element, but still invalidates running iterators like every swap.
    ##
    ## @param a the position of the first element
    ## @param b the position of the second element
    ## @panics if `a < count` does not hold ("Array swap index out of bounds")
    ## @panics if `b < count` does not hold ("Array swap index out of bounds")
    swap(a: ulong, b: ulong, location: __ptr<char> = __caller_location()) {
        assert(a < _size, "Array swap index out of bounds", location);
        assert(b < _size, "Array swap index out of bounds", location);
        _version = _version + 1;
        if (a != b) {
            _array_swap(_slot(a), _slot(b), sizeof<T>());
        }
    }

    ## Reverses the order of the elements in place.
    ##
    ## Runs in O(count), exchanging elements pairwise, so reference counts
    ## are unchanged. An Array of fewer than two elements is left untouched
    ## and its iterators stay valid; otherwise running iterators are
    ## invalidated.
    ##
    ## @example
    ##     a.reverse();   # [1, 2, 3] becomes [3, 2, 1]
    reverse() {
        if (_size >= 2) {
            _version = _version + 1;
            _reverse_range(0, _size);
        }
    }

    # Reverses slots `start` up to `end` by exchanging raw slots, so no
    # count changes. Leaves `_version` alone.
    _reverse_range(start: ulong, end: ulong) {
        if (end - start < 2) {
            return;
        }
        ulong low = start;
        ulong high = end - 1;
        while (low < high) {
            _array_swap(_slot(low), _slot(high), sizeof<T>());
            low = low + 1;
            high = high - 1;
        }
    }

    ## Moves the first `count` elements to the end, keeping the order within
    ## each part: the element at `count` becomes the first.
    ##
    ## Runs in O(count of the Array), exchanging elements, so reference
    ## counts are unchanged. Rotating by 0 or by the Array's `count` changes
    ## nothing and leaves iterators valid; any other rotation invalidates
    ## them.
    ##
    ## @param count the number of leading elements to move; from 0 through the Array's `count`
    ## @panics if `count` is more than the Array's `count` ("Array rotate count out of bounds")
    ## @example
    ##     var a = [1, 2, 3, 4, 5];
    ##     a.rotate(2);   # [3, 4, 5, 1, 2]
    rotate(count: ulong, location: __ptr<char> = __caller_location()) {
        assert(count <= _size, "Array rotate count out of bounds", location);
        if (count == 0 || count == _size) {
            return;
        }
        _version = _version + 1;
        _reverse_range(0, count);
        _reverse_range(count, _size);
        _reverse_range(0, _size);
    }

    ## Sorts the elements in place into the order `compare` defines. The
    ## sort is stable: elements that compare equal keep their relative
    ## order.
    ##
    ## `compare(a, b)` returns a negative number when `a` belongs before
    ## `b`, 0 when their order does not matter, and a positive number when
    ## `a` belongs after `b`, the convention `String.compare` follows. It is
    ## a merge sort: O(count log count) calls to `compare`, plus a scratch
    ## buffer of `count` slots. Elements move between the two buffers
    ## without changing any reference count. Invalidates running iterators
    ## when there are two or more elements.
    ##
    ## `compare` must not modify the Array: its elements are spread over
    ## the two buffers while the sort runs.
    ##
    ## @param compare returns the order of its two arguments, as above
    ## @panics if `compare` modifies the Array ("Array modified during sort")
    ## @example
    ##     var names = Array<String>();
    ##     names.append("pear");
    ##     names.append("apple");
    ##     names.sort((a, b) => a.compare(b));   # ["apple", "pear"]
    ##     var numbers = Array<int>();
    ##     numbers.append(3);
    ##     numbers.append(1);
    ##     numbers.sort((a, b) => b - a);        # descending: [3, 1]
    sort(compare: (T, T) => int) {
        _merge_sort(compare);
    }

    ## Sorts the elements in place into the order `compare` defines, without
    ## keeping equal elements in their original order.
    ##
    ## `compare` follows the convention of `sort(compare)`. It is
    ## pattern-defeating quicksort (pdqsort): O(count log count) calls to
    ## `compare` in the worst case, O(count) on an Array that is already
    ## sorted or all equal, and no scratch buffer, so it is the faster sort
    ## when stability does not matter. Elements only trade slots, so no
    ## reference count changes. Invalidates running iterators when there
    ## are two or more elements.
    ##
    ## @param compare returns the order of its two arguments, as for `sort`
    ## @panics if `compare` modifies the Array ("Array modified during sort")
    ## @example
    ##     var a = [5, 1, 4, 2, 3];
    ##     a.sort_unstable((x, y) => x - y);   # [1, 2, 3, 4, 5]
    sort_unstable(compare: (T, T) => int) {
        _pdq_sort(compare);
    }

    # The body of `sort_unstable(compare)`, which `sort_unstable()` calls
    # too (see `_merge_sort`).
    _pdq_sort(compare: (T, T) => int) {
        if (_size < 2) {
            return;
        }
        var sorter = _ArraySorter<T>(this, compare);
        sorter.sort(0, _size);
    }

    ## Reorders the elements so that the one at `nth` is the element a full
    ## sort would put there, every element before it sorts before or with
    ## it, and every element after it sorts after or with it (C++'s
    ## `nth_element`). Each side is otherwise in no particular order.
    ##
    ## `compare` follows the convention of `sort(compare)`. Runs in O(count)
    ## calls to `compare` on average and O(count log count) in the worst
    ## case, with no scratch buffer. Elements only trade slots, so no
    ## reference count changes. Invalidates running iterators.
    ##
    ## @param nth the position to settle; less than `count`
    ## @param compare returns the order of its two arguments, as for `sort`
    ## @panics if `nth < count` does not hold ("Array select_nth index out of bounds")
    ## @panics if `compare` modifies the Array ("Array modified during sort")
    ## @example
    ##     var a = [9, 1, 8, 2, 7, 3];
    ##     a.select_nth(2, (x, y) => x - y);   # a[2] == 3, the third smallest
    select_nth(nth: ulong, compare: (T, T) => int, location: __ptr<char> = __caller_location()) {
        _select_nth(nth, compare, location);
    }

    # The body of `select_nth(nth, compare)`, shared with `select_nth(nth)`.
    _select_nth(nth: ulong, compare: (T, T) => int, location: __ptr<char>) {
        assert(nth < _size, "Array select_nth index out of bounds", location);
        var sorter = _ArraySorter<T>(this, compare);
        sorter.select(nth);
    }

    ## Puts the `count` elements that sort first into the first `count`
    ## positions, in order, and leaves the rest after them in no particular
    ## order: the start of a full sort, found faster.
    ##
    ## `compare` follows the convention of `sort(compare)`. Runs in
    ## O(count of the Array + `count` log `count`) calls to `compare` on
    ## average, with no scratch buffer; it is not stable. Elements only
    ## trade slots, so no reference count changes. Invalidates running
    ## iterators.
    ##
    ## @param count the number of leading elements to sort; from 0 through the Array's `count`
    ## @param compare returns the order of its two arguments, as for `sort`
    ## @panics if `count` is more than the Array's `count` ("Array partial_sort count out of bounds")
    ## @panics if `compare` modifies the Array ("Array modified during sort")
    ## @example
    ##     var scores = [40, 95, 12, 77, 63];
    ##     scores.partial_sort(3, (x, y) => y - x);   # starts [95, 77, 63]
    partial_sort(count: ulong, compare: (T, T) => int, location: __ptr<char> = __caller_location()) {
        _partial_sort(count, compare, location);
    }

    # The body of `partial_sort(count, compare)`, shared with
    # `partial_sort(count)`.
    _partial_sort(count: ulong, compare: (T, T) => int, location: __ptr<char>) {
        assert(count <= _size, "Array partial_sort count out of bounds", location);
        var sorter = _ArraySorter<T>(this, compare);
        if (count > 0 && count < _size) {
            sorter.select(count - 1);
        }
        sorter.sort(0, count);
    }

    # The body of `sort(compare)`, which `sort()` on `Comparable` elements
    # (runtime/compare.pep) calls too: a call to `sort` from there is
    # ambiguous, as the extension's lookup finds this overload twice.
    _merge_sort(compare: (T, T) => int) {
        if (_size < 2) {
            return;
        }
        _version = _version + 1;
        var version = _version;
        # Bottom-up merge sort: runs of `width` merge from `source` into
        # `target`, and the two swap each pass. Each element moves (`move`
        # nulls the slot it leaves and the store takes its reference without
        # a count step), so the sort changes no count, and every pass starts
        # with an all-null `target` (`_pep_malloc` zeroes `scratch`).
        __ptr<T> scratch = _pep_malloc(sizeof<T>() * _size);
        __ptr<T> source = _data;
        __ptr<T> target = scratch;
        ulong width = 1;
        while (width < _size) {
            ulong low = 0;
            while (low < _size) {
                ulong middle = _min(low + width, _size);
                ulong high = _min(low + 2 * width, _size);
                ulong left = low;
                ulong right = middle;
                ulong out = low;
                while (out < high) {
                    # Take from the right run only when it is strictly
                    # smaller, which keeps equal elements in order.
                    var take_left = left < middle;
                    if (take_left && right < high) {
                        take_left = compare(source[right], source[left]) >= 0;
                        # `compare` must not change the Array: its elements
                        # are spread over two buffers.
                        assert(_version == version, "Array modified during sort");
                    }
                    if (take_left) {
                        target[out] = move(source[left]);
                        left = left + 1;
                    } else {
                        target[out] = move(source[right]);
                        right = right + 1;
                    }
                    out = out + 1;
                }
                low = high;
            }
            var swapped = source;
            source = target;
            target = swapped;
            width = width * 2;
        }
        # The sorted elements ended in `scratch`: copy them back as bytes,
        # leaving `scratch` with copies it does not own, and free it as is.
        if (unsafe_cast<__ptr<u8>>(source) == unsafe_cast<__ptr<u8>>(scratch)) {
            _array_copy(_data, scratch, sizeof<T>() * _size);
        }
        _pep_free(scratch);
    }

    # An array literal `[a, b, c]` is built as
    # `_array_literal(a)._literal_append(b)._literal_append(c)`: each step
    # appends and returns the same Array.
    _literal_append(item: T): Array<T> {
        append(item);
        return this;
    }

    # A literal too long for one chain is built as a balanced tree of short
    # chains, all appending to the same Array, joined left to right by this
    # (see `_build_literal` in tools/compiler/sema/builder.pep): `this` is built first, then
    # `next`, and both are that Array.
    _literal_then(next: Array<T>): Array<T> {
        return next;
    }

    static _min(a: ulong, b: ulong): ulong {
        if (a < b) {
            return a;
        }
        return b;
    }

    ## Returns the position of the first element equal to `item`, or none
    ## when no element matches.
    ##
    ## Runs in O(count), scanning from the front. Elements are compared with
    ## `==`: when `T` declares an `==` operator (as `String` does) that
    ## operator decides; for any other struct `T` it compares references, so
    ## only the very same object matches.
    ##
    ## Breaking change: `find` used to return a `long` that was `-1` when
    ## nothing matched. It now returns `ulong?`: test it with `is_some()` (or
    ## as a condition) and read the index with `value()`.
    ##
    ## @param item the value to look for
    ## @returns the index of the first match, or none when no element matches
    ## (always none for an empty Array)
    ## @example
    ##     var a = [3, 9, 4];
    ##     var i = a.find(9);         # i.value() == 1
    ##     var missing = a.find(7);   # missing.is_empty() == true
    [__Reads]
    find(item: T): ulong? {
        ulong index = 0;
        while (index < _size) {
            if (_data[index] == item) {
                return Optional<ulong>.Value(index);
            }
            index = index + 1;
        }
        return Optional<ulong>.Empty;
    }

    ## Reports whether any element equals `item`, compared as `find` does.
    ##
    ## Runs in O(count).
    ##
    ## @param item the value to look for
    ## @returns true when `find(item)` finds a match
    [__Reads]
    contains(item: T): bool {
        return find(item).is_value();
    }

    ## Returns a read-only view of the elements from `start` up to but not
    ## including `end`, without copying them.
    ##
    ## The slice holds a reference to this Array, so it cannot outlive it,
    ## and it is fail-fast like an iterator: once the Array is modified (see
    ## `Array` for which operations count), every later use of the slice
    ## panics, so it never reads elements that moved or were freed.
    ##
    ## @param start the position of the first element in the slice
    ## @param end the position one past the last element; from `start` through `count`
    ## @returns a view of `end - start` elements
    ## @panics if `start <= end` and `end <= count` do not both hold ("Array slice out of bounds")
    ## @example
    ##     var a = [1, 2, 3, 4, 5];
    ##     var middle = a.slice(1, 4);   # views [2, 3, 4]
    ##     var second = middle[1];       # 3
    [__Reads]
    slice(start: ulong, end: ulong, location: __ptr<char> = __caller_location()): ArrayView<T> {
        _pep_check_bounds(start <= end && end <= _size, "Array slice out of bounds", location);
        var view = ArrayView<T>();
        view._source = this;
        view._start = start;
        view._end = end;
        view._version = _version;
        return view;
    }

    ## Returns an iterator over the Array in runs of `size` elements, as
    ## slices; the last run is shorter when `size` does not divide `count`.
    ## The same as `slice(0, count).chunks(size)`.
    ##
    ## @typeParam TElement the element type, `T` by default
    ## @param size the number of elements in each run
    ## @returns an iterator over `count / size` runs, rounded up
    ## @panics if `size` is 0 ("ArrayView chunk size is 0")
    ## @example
    ##     var rows = Array<int>();
    ##     for (var row in [1, 2, 3, 4, 5, 6].chunks(3)) {
    ##         rows.append(row[0]);   # 1, then 4
    ##     }
    [__Reads]
    chunks<TElement=T>(size: ulong, location: __ptr<char> = __caller_location()): ArrayChunks<TElement> {
        # `chunks` and `windows` here and on ArrayView are generic only so they
        # compile when called: compiled with every Array type, they would make
        # `ArrayChunks<T>`, whose `Iterator` methods make `Array<ArrayView<T>>`,
        # whose `chunks` makes `ArrayChunks<ArrayView<T>>`, without end.
        return ArrayChunks<TElement>(slice(0, _size), size, size, location);
    }

    ## Returns an iterator over every run of `size` consecutive elements,
    ## as slices, each starting one element after the one before. The same
    ## as `slice(0, count).windows(size)`.
    ##
    ## @typeParam TElement the element type, `T` by default
    ## @param size the number of elements in each run
    ## @returns an iterator over `count - size + 1` runs, or none when the Array is shorter than `size`
    ## @panics if `size` is 0 ("ArrayView chunk size is 0")
    ## @example
    ##     var rises = 0;
    ##     for (var pair in [1, 3, 2, 5].windows(2)) {
    ##         if (pair[1] > pair[0]) {
    ##             rises = rises + 1;   # 2 in all
    ##         }
    ##     }
    [__Reads]
    windows<TElement=T>(size: ulong, location: __ptr<char> = __caller_location()): ArrayChunks<TElement> {
        return ArrayChunks<TElement>(slice(0, _size), size, 1, location);
    }

    ## Returns the position of the element that `order` reports equal to the
    ## target, searching an Array sorted in the order `order` follows, or
    ## none when there is none.
    ##
    ## Runs in O(log count) calls to `order`, which must not modify the
    ## Array. When several elements match, the first of them is found.
    ##
    ## @param order returns a negative number when its argument sorts before
    ##   the target, 0 when it matches, and a positive number when it sorts after
    ## @returns the index of the first matching element, or none
    ## @panics if `order` modifies the Array ("Array modified while a slice of it is in use")
    ## @example
    ##     var a = [10, 20, 30];
    ##     var i = a.binary_search_by((x) => x.compare(20));   # i.value() == 1
    [__Reads]
    binary_search_by(order: (T) => int): ulong? {
        return slice(0, _size).binary_search_by(order);
    }

    ## Replaces every element with `value`.
    ##
    ## Runs in O(count). For a struct `T` every slot acquires `value` and
    ## releases its previous occupant. Invalidates running iterators.
    ##
    ## @param value the value each element becomes
    ## @example
    ##     var a = [1, 2, 3];
    ##     a.fill(0);   # [0, 0, 0]
    fill(value: T) {
        _version = _version + 1;
        ulong index = 0;
        while (index < _size) {
            _data[index] = value;
            index = index + 1;
        }
    }

    ## Removes every element for which `keep` returns false, keeping the
    ## order of the rest.
    ##
    ## Runs in O(count) calls to `keep`, which sees each element once, in
    ## index order, and must not modify the Array. For a struct `T` each
    ## removed element is released and kept elements keep their counts. The
    ## capacity is unchanged. Invalidates running iterators.
    ##
    ## @param keep returns true for an element to keep
    ## @panics if `keep` modifies the Array ("Array modified during retain")
    ## @example
    ##     var a = [1, 2, 3, 4];
    ##     a.retain((x) => x % 2 == 0);   # [2, 4]
    retain(keep: (T) => bool) {
        _version = _version + 1;
        var version = _version;
        ulong kept = 0;
        ulong index = 0;
        while (index < _size) {
            var keeping = keep(_data[index]);
            assert(_version == version, "Array modified during retain");
            if (keeping) {
                _keep_at(kept, index);
                kept = kept + 1;
            }
            index = index + 1;
        }
        _release_range(kept, _size);
        _size = kept;
    }

    ## Removes every element for which `remove` returns true, keeping the
    ## order of the rest; the opposite of `retain`.
    ##
    ## Runs in O(count) calls to `remove`, which sees each element once, in
    ## index order, and must not modify the Array. For a struct `T` each
    ## removed element is released. Invalidates running iterators.
    ##
    ## @param remove returns true for an element to remove
    ## @panics if `remove` modifies the Array ("Array modified during retain")
    ## @example
    ##     var a = [1, 2, 3, 4];
    ##     a.remove_if((x) => x > 2);   # [1, 2]
    remove_if(remove: (T) => bool) {
        retain((x) => !remove(x));
    }

    ## Removes each element equal (`==`) to the one before it, so a run of
    ## equal elements keeps only its first. On a sorted Array this removes
    ## every duplicate.
    ##
    ## Runs in O(count). Elements are compared as `find` does. For a struct
    ## `T` each removed element is released. Invalidates running iterators
    ## when there are two or more elements.
    ##
    ## @example
    ##     var a = [1, 1, 2, 3, 3, 3, 1];
    ##     a.dedup();   # [1, 2, 3, 1]
    dedup() {
        if (_size < 2) {
            return;
        }
        _version = _version + 1;
        ulong kept = 1;
        ulong index = 1;
        while (index < _size) {
            if (!(_data[index] == _data[kept - 1])) {
                _keep_at(kept, index);
                kept = kept + 1;
            }
            index = index + 1;
        }
        _release_range(kept, _size);
        _size = kept;
    }

    # Moves the element at `index` down to slot `kept` (at or before it) for
    # `retain` and `dedup`: the store releases the dropped element there, and
    # `move` nulls `index`'s slot, so the reference keeps its count.
    _keep_at(kept: ulong, index: ulong) {
        if (kept != index) {
            _data[kept] = move(_data[index]);
        }
    }

    ## Changes the count to `count`: removes elements past it, as
    ## `truncate` does, or appends copies of `value` until there are
    ## `count` elements.
    ##
    ## Runs in O(difference in count), plus at most one reallocation.
    ## Invalidates running iterators when the count changes.
    ##
    ## @param count the number of elements the Array will hold
    ## @param value the element to append when the Array grows
    ## @panics if the buffer must grow while an I/O operation in a task is using it
    ## @example
    ##     var a = [1, 2];
    ##     a.resize(4, 0);   # [1, 2, 0, 0]
    ##     a.resize(1, 0);   # [1]
    resize(count: ulong, value: T) {
        if (count <= _size) {
            truncate(count);
            return;
        }
        reserve(count);
        while (_size < count) {
            append(value);
        }
    }

    ## Removes the elements from `index` on and returns them as a new Array,
    ## leaving this Array with its first `index` elements.
    ##
    ## Runs in O(count - index). The elements move without changing their
    ## reference counts. This Array's capacity is unchanged. Invalidates
    ## running iterators when any element moves.
    ##
    ## @param index the position of the first element to move; from 0 through `count`
    ## @returns a new Array holding the elements that were at `index` and after
    ## @panics if `index <= count` does not hold ("Array split_off index out of bounds")
    ## @example
    ##     var a = [1, 2, 3, 4];
    ##     var tail = a.split_off(1);   # a holds [1]; tail holds [2, 3, 4]
    split_off(index: ulong, location: __ptr<char> = __caller_location()): Array<T> {
        assert(index <= _size, "Array split_off index out of bounds", location);
        return drain(index, _size);
    }

    ## Removes the elements from `start` up to but not including `end` and
    ## returns them as a new Array, shifting the later elements down.
    ##
    ## Runs in O(count - start). The elements move without changing their
    ## reference counts. This Array's capacity is unchanged. Invalidates
    ## running iterators when any element is removed.
    ##
    ## @param start the position of the first element to remove
    ## @param end the position one past the last element to remove; from `start` through `count`
    ## @returns a new Array holding the removed elements, in order
    ## @panics if `start <= end` and `end <= count` do not both hold ("Array drain range out of bounds")
    ## @example
    ##     var a = [1, 2, 3, 4, 5];
    ##     var middle = a.drain(1, 3);   # a holds [1, 4, 5]; middle holds [2, 3]
    drain(start: ulong, end: ulong, location: __ptr<char> = __caller_location()): Array<T> {
        assert(start <= end && end <= _size, "Array drain range out of bounds", location);
        ulong moved = end - start;
        if (moved == 0) {
            return Array<T>();
        }
        _version = _version + 1;
        Array<T> drained = Array<T>(moved);
        # The references move to `drained` and the tail moves down as raw
        # bytes, so no count changes; the slots vacated at the end are
        # zeroed to stay empty.
        _array_copy(drained._data, _slot(start), moved * sizeof<T>());
        _array_move(_slot(start), _slot(end), (_size - end) * sizeof<T>());
        if (!__is_pod<T>()) {
            _array_zero(_slot(_size - moved), moved * sizeof<T>());
        }
        drained._size = moved;
        _size = _size - moved;
        return drained;
    }

    ## Appends every element of `rhs`, in order, to the end of this Array.
    ##
    ## Runs in O(count of `rhs`), growing the buffer at most once and copying
    ## the elements in one block. `rhs` is unchanged, and it may be this same Array
    ## (`a.append_all(a)` doubles `a`). For a struct `T` each appended element
    ## is acquired once more, since both Arrays now hold it. Invalidates this
    ## Array's running iterators when `rhs` is not empty.
    ##
    ## @param rhs the Array whose elements are copied
    ## @panics if the buffer must grow while an I/O operation in a task is using it
    ## @see +=
    append_all(rhs: Array<T>) {
        _append_from(rhs, 0, rhs._size);
    }

    ## Appends every element of `items`, in order, to the end of this Array.
    ##
    ## Runs in O(count of `items`), growing the buffer at most once. `items`
    ## may view this same Array. For a struct `T` each appended element is
    ## acquired once more. Invalidates this Array's running iterators and
    ## slices (`items` among them, when it views this Array) when `items`
    ## is not empty.
    ##
    ## @param items the elements to copy
    ## @panics if the Array `items` views was modified since `items` was made ("Array modified while a slice of it is in use")
    ## @panics if the buffer must grow while an I/O operation in a task is using it
    ## @example
    ##     var a = [1, 2];
    ##     var b = [7, 8, 9];
    ##     a.extend_from(b.slice(1, 3));   # [1, 2, 8, 9]
    extend_from(items: ArrayView<T>, location: __ptr<char> = __caller_location()) {
        items._check(location);
        _append_from(items._source, items._start, items.count);
    }

    # Appends `count` elements of `source` from `start` on with one block
    # copy. `count` is read by the caller first and `source`'s buffer only
    # after growing, since `source` may be this Array (`a += a`).
    _append_from(source: Array<T>, start: ulong, count: ulong) {
        if (count == 0) {
            return;
        }
        _version = _version + 1;
        _reserve_extra(count);
        _array_copy(_slot(_size), source._slot(start), count * sizeof<T>());
        # The copied slots are new references to the same elements.
        if (!__is_pod<T>()) {
            ulong index = _size;
            while (index < _size + count) {
                _data[index].__acquire();
                index = index + 1;
            }
        }
        _size = _size + count;
    }

    ## Returns a new Array holding the same elements in the same order.
    ##
    ## Runs in O(count). The copy is shallow: for a struct `T` both Arrays
    ## refer to the same element objects (each acquired once more), but adding
    ## or removing elements in one does not affect the other. The new Array's
    ## capacity equals this Array's `count`.
    ##
    ## @returns an independent Array with the same elements
    ## @example
    ##     var b = a.clone();
    ##     b.append(7);   # a is unchanged
    [__Reads]
    clone(): Array<T> {
        Array<T> result = Array<T>(_size);
        result.append_all(this);
        return result;
    }

    ## Returns a deep copy: a new Array holding a copy of each element, made
    ## with `copy`. This is how `copy(value)` copies an Array (the
    ## `Copyable<Array<T>>` implementation); call `copy(array)` rather than
    ## this method.
    ##
    ## Unlike `clone()`, which shares struct elements, the result shares no
    ## element that is not thread-safe with this Array. An element that
    ## appears twice is copied once. Runs in O(count) plus the cost of
    ## copying the elements.
    ##
    ## @returns the copy
    ## @example
    ##     var names = Array<String>();
    ##     names.append("ada");
    ##     var copied = copy(names);   # calls this method
    copy(): Array<T> {
        Array<T> made = Array<T>(_size);
        register_copy<Array<T>>(this, made);
        # Numbers are their own copies: one block copy, and no element
        # visits the running copy.
        if (__is_pod<T>()) {
            made.append_all(this);
            return made;
        }
        ulong i = 0;
        while (i < _size) {
            made.append(copy<T>(_data[i]));
            i = i + 1;
        }
        return made;
    }

    ## Reports whether both Arrays have the same count and pairwise equal
    ## elements, compared with `==` as `find` does.
    ##
    ## Runs in O(count); stops at the first difference. Two empty Arrays are
    ## equal. `capacity` is not compared.
    ##
    ## @param rhs the Array to compare with
    ## @returns true when the Arrays are element-wise equal
    [__Reads]
    ==(rhs: Array<T>): bool {
        if (_size != rhs._size) {
            return false;
        }
        ulong idx = 0;
        while (idx < _size) {
            if (!(_data[idx] == rhs._data[idx])) {
                return false;
            }
            idx = idx + 1;
        }
        return true;
    }

    ## Reports whether the Arrays differ in count or in any element; the
    ## negation of `==`.
    ##
    ## @param rhs the Array to compare with
    ## @returns true when the Arrays are not element-wise equal
    [__Reads]
    !=(rhs: Array<T>): bool {
        return !(this == rhs);
    }

    ## Appends every element of `rhs` to this Array in place (`a += b`); the
    ## same as `append_all`.
    ##
    ## `a += a` is allowed and doubles `a`.
    ##
    ## @param rhs the Array whose elements are appended
    ## @returns this Array, after the append
    ## @example
    ##     a += b;   # a now ends with b's elements
    ## @see append_all
    +=(rhs: Array<T>): Array<T> {
        append_all(rhs);
        return this;
    }

    ## Returns a new Array holding this Array's elements followed by those of
    ## `rhs` (`a + b`).
    ##
    ## Runs in O(count + count of `rhs`). Neither operand is modified; like
    ## `clone`, the result shares struct elements with its operands.
    ##
    ## @param rhs the Array whose elements come second
    ## @returns the concatenation of this Array and `rhs`
    ## @example
    ##     var c = a + b;
    [__Reads]
    +(rhs: Array<T>): Array<T> {
        Array<T> result = Array<T>(_size + rhs._size);
        result.append_all(this);
        result.append_all(rhs);
        return result;
    }
}

## The searches of a sorted Array, for an element type with an order
## (see `Comparable`).
##
## @typeParam T the element type, `Comparable`
export extend Array<T: Comparable> {
    ## Returns the position of an element equal to `item` in this Array,
    ## which must be sorted in `compare` order, or none when there is
    ## none.
    ##
    ## Runs in O(log count). When several elements equal `item`, the first
    ## of them is found. On an Array that is not sorted the result is
    ## unspecified (but never out of bounds).
    ##
    ## @param item the value to look for
    ## @returns the index of the first element equal to `item`, or none
    ## @example
    ##     var a = [1, 3, 5, 7];
    ##     var i = a.binary_search(5);   # i.value() == 2
    [__Reads]
    binary_search(item: T): ulong? {
        return slice(0, _size).binary_search(item);
    }

    ## Returns the first position at which `item` could be inserted while
    ## keeping this sorted Array sorted: the index of the first element that
    ## does not sort before `item` (in `compare` order), or `count` when
    ## every element does.
    ##
    ## Runs in O(log count).
    ##
    ## @param item the value to place
    ## @returns the index of the first element at or after `item`
    ## @example
    ##     var a = [1, 3, 3, 5];
    ##     var i = a.lower_bound(3);   # 1
    [__Reads]
    lower_bound(item: T): ulong {
        return slice(0, _size).lower_bound(item);
    }

    ## Returns the last position at which `item` could be inserted while
    ## keeping this sorted Array sorted: the index of the first element that
    ## sorts after `item` (in `compare` order), or `count` when none does.
    ##
    ## Runs in O(log count). `upper_bound(x) - lower_bound(x)` is the number
    ## of elements equal to `x`.
    ##
    ## @param item the value to place
    ## @returns the index of the first element after `item`
    ## @example
    ##     var a = [1, 3, 3, 5];
    ##     var i = a.upper_bound(3);   # 3
    [__Reads]
    upper_bound(item: T): ulong {
        return slice(0, _size).upper_bound(item);
    }

    ## Reports whether the elements are in `compare` order: no element
    ## sorts after the one that follows it.
    ##
    ## Runs in O(count). An Array of fewer than two elements is sorted.
    ##
    ## @returns true when the Array is sorted
    [__Reads]
    is_sorted(): bool {
        return slice(0, _size).is_sorted();
    }

    ## Sorts the elements in place into their own order, `compare`, without
    ## keeping equal elements in their original order; otherwise behaves
    ## like `sort_unstable(compare)`.
    ##
    ## @panics if comparing modifies the Array ("Array modified during sort")
    ## @example
    ##     var a = [3, 1, 2];
    ##     a.sort_unstable();   # [1, 2, 3]
    sort_unstable() {
        _pdq_sort((a, b) => a.compare(b));
    }

    ## Reorders the elements so that the one at `nth` is the one sorting
    ## would put there, with the elements before it sorting before or with
    ## it and those after it after or with it; see
    ## `select_nth(nth, compare)`.
    ##
    ## @param nth the position to settle; less than `count`
    ## @panics if `nth < count` does not hold ("Array select_nth index out of bounds")
    ## @panics if comparing modifies the Array ("Array modified during sort")
    ## @example
    ##     var a = [9, 1, 8, 2, 7];
    ##     a.select_nth(2);   # a[2] == 7, the median
    select_nth(nth: ulong, location: __ptr<char> = __caller_location()) {
        _select_nth(nth, (a, b) => a.compare(b), location);
    }

    ## Puts the `count` smallest elements into the first `count` positions,
    ## in order; see `partial_sort(count, compare)`.
    ##
    ## @param count the number of leading elements to sort; from 0 through the Array's `count`
    ## @panics if `count` is more than the Array's `count` ("Array partial_sort count out of bounds")
    ## @panics if comparing modifies the Array ("Array modified during sort")
    ## @example
    ##     var a = [5, 3, 9, 1, 7];
    ##     a.partial_sort(2);   # starts [1, 3]
    partial_sort(count: ulong, location: __ptr<char> = __caller_location()) {
        _partial_sort(count, (a, b) => a.compare(b), location);
    }

    ## Returns the lexicographic order of this Array and `other`: the order
    ## of the first pair of elements that differ (by their `compare`), or,
    ## when one Array is the start of the other, the shorter first.
    ##
    ## Runs in O(count); stops at the first difference. Two empty Arrays
    ## sort together. It follows `Comparable`'s convention, so an Array of
    ## Arrays sorts with `sort((a, b) => a.compare(b))`.
    ##
    ## @param other the Array to compare with
    ## @returns a negative number, zero or a positive number as this Array
    ##   sorts before, with or after `other`
    ## @example
    ##     assert([1, 2, 3].compare([1, 3]) < 0, "2 sorts before 3");
    ##     assert([1, 2].compare([1, 2, 0]) < 0, "the shorter first");
    [__Reads]
    compare(other: Array<T>): int {
        ulong index = 0;
        while (index < _size && index < other._size) {
            var order = _data[index].compare(other._data[index]);
            if (order != 0) {
                return order;
            }
            index = index + 1;
        }
        return _size.compare(other._size);
    }
}

## An `Iterator<T>` over the elements of an Array, in index order; returned by
## `Array.iterate()` and driven by `for (var x in array)`.
##
## Holds a reference to the Array, so iterating a temporary keeps it alive for
## the whole loop. The iterator is fail-fast: if the Array is modified after
## the iterator was created (see `Array` for which operations count), its next
## `next()` or `current()` panics instead of skipping or repeating elements
## (an iterator over an Array that was empty when it was made just ends).
##
## @typeParam T the element type of the source Array
## @example
##     var it = a.iterate();
##     while (it.next()) {
##         var x = it.current();
##     }
## @see Array.iterate
[Value]
export struct ArrayIterator<T> {
    ## The Array being iterated; the iterator holds a reference to it for its whole lifetime.
    Array<T> _source;
    ## The position of the current element in `_source`. Meaningful only after
    ## `_started` is set; equals `_source.count` once iteration has finished.
    ulong _index;
    ## The `_source._version` recorded when iteration began; a mismatch means the Array was modified.
    ulong _version;
    ## Whether `next()` has been called at least once; the first call stays at index 0 instead of advancing.
    bool _started;

    ## Advances to the next element.
    ##
    ## The first call moves to index 0. Once it returns false it keeps
    ## returning false.
    ##
    ## @returns true when there is a current element, false once past the end
    ## @panics if the Array was modified since the iterator was created ("Array modified during iteration")
    next(): bool {
        assert(_source._version == _version, "Array modified during iteration");
        if (_started) {
            if (_index < _source._size) {
                _index = _index + 1;
            }
        } else {
            _started = true;
        }
        return _index < _source._size;
    }

    ## Returns the element the last successful `next()` moved to.
    ##
    ## @returns the current element
    ## @panics if the Array was modified since the iterator was created ("Array modified during iteration")
    ## @panics if `next()` was never called ("ArrayIterator.current() before next()")
    ## @panics if `next()` already returned false ("ArrayIterator.current() past the end")
    current(): T {
        assert(_source._version == _version, "Array modified during iteration");
        assert(_started, "ArrayIterator.current() before next()");
        assert(_index < _source._size, "ArrayIterator.current() past the end");
        return _source._data[_index];
    }
}

## A read-only view of a run of an Array's elements, made by `Array.slice`,
## that lets a function take "some of the elements" without copying them.
##
## A slice holds a reference to its Array, so the Array lives at least as
## long as the slice. It is fail-fast like `ArrayIterator`: once the Array
## is modified (see `Array` for which operations count), every later use of
## the slice panics with "Array modified while a slice of it is in use"
## instead of reading elements that moved or were freed. Make a new slice
## after changing the Array.
##
## A slice is `Iterable<T>`: `for (var x in slice)` visits its elements in
## order.
##
## @typeParam T the element type of the Array
## @example
##     total(values: ArrayView<int>): int {
##         var sum = 0;
##         for (var x in values) {
##             sum = sum + x;
##         }
##         return sum;
##     }
##
##     var a = [1, 2, 3, 4];
##     var tail_sum = total(a.slice(2, 4));   # 7
## @see Array.slice
[Value]
export struct ArrayView<T> {
    ## The Array viewed; the slice holds a reference to it.
    Array<T> _source;
    ## The position in `_source` of the slice's first element.
    ulong _start;
    ## The position in `_source` one past the slice's last element.
    ulong _end;
    ## The `_source._version` when the slice was made; a mismatch means the Array was modified.
    ulong _version;

    # Panics when the Array changed since the slice was made.
    _check(location: __ptr<char>) {
        assert(_source._version == _version, "Array modified while a slice of it is in use", location);
    }

    # The element at `index` in the slice, already bounds-checked.
    _at(index: ulong): T {
        _check(__caller_location());
        return _source._data[_start + index];
    }

    ## The number of elements in the slice.
    var count: ulong {
        get {
            return _end - _start;
        }
    }

    ## Whether the slice has no elements.
    var is_empty: bool {
        get {
            return _end == _start;
        }
    }

    ## Returns the element at `index` in the slice, `index` 0 being the
    ## slice's first element; this is the indexer read `slice[index]`.
    ##
    ## @param index the zero-based position in the slice
    ## @returns the element at `index`
    ## @panics if the Array was modified since the slice was made ("Array modified while a slice of it is in use")
    ## @panics if `index < count` does not hold ("ArrayView index out of bounds")
    [](index: ulong, location: __ptr<char> = __caller_location()): T {
        _check(location);
        _pep_check_bounds(index < _end - _start, "ArrayView index out of bounds", location);
        return _source._data[_start + index];
    }

    ## Returns a view of this slice's elements from `start` up to but not
    ## including `end`, positions counted within this slice.
    ##
    ## @param start the position of the first element
    ## @param end the position one past the last element; from `start` through `count`
    ## @returns a view of `end - start` elements of the same Array
    ## @panics if the Array was modified since the slice was made ("Array modified while a slice of it is in use")
    ## @panics if `start <= end` and `end <= count` do not both hold ("ArrayView slice out of bounds")
    slice(start: ulong, end: ulong, location: __ptr<char> = __caller_location()): ArrayView<T> {
        _check(location);
        _pep_check_bounds(start <= end && end <= _end - _start, "ArrayView slice out of bounds", location);
        var view = this;
        view._start = _start + start;
        view._end = _start + end;
        return view;
    }

    ## Returns an iterator over the slice's elements in order; this is what
    ## `for (var x in slice)` calls.
    ##
    ## @returns a new iterator positioned before the first element
    iterate(): ArrayViewIterator<T> {
        var it = ArrayViewIterator<T>();
        it._slice = this;
        return it;
    }

    ## Splits the slice in two at `index`: the elements before it, and the
    ## elements from it on.
    ##
    ## @param index the position the second slice starts at; from 0 through `count`
    ## @returns the slices `slice(0, index)` and `slice(index, count)`
    ## @panics if the Array was modified since the slice was made ("Array modified while a slice of it is in use")
    ## @panics if `index <= count` does not hold ("ArrayView slice out of bounds")
    ## @example
    ##     var a = [1, 2, 3, 4, 5];
    ##     var (head, tail) = a.slice(0, 5).split_at(2);   # [1, 2] and [3, 4, 5]
    split_at(index: ulong, location: __ptr<char> = __caller_location()): (ArrayView<T>, ArrayView<T>) {
        return (slice(0, index, location), slice(index, count, location));
    }

    ## Returns an iterator over the slice in runs of `size` elements, as
    ## slices, from the start; the last run is shorter when `size` does not
    ## divide `count`.
    ##
    ## @typeParam TElement the element type, `T` by default
    ## @param size the number of elements in each run
    ## @returns an iterator over `count / size` runs, rounded up
    ## @panics if `size` is 0 ("ArrayView chunk size is 0")
    ## @example
    ##     var a = [1, 2, 3, 4, 5];
    ##     for (var run in a.slice(0, 5).chunks(2)) {
    ##         # [1, 2], then [3, 4], then [5]
    ##     }
    chunks<TElement=T>(size: ulong, location: __ptr<char> = __caller_location()): ArrayChunks<TElement> {
        return ArrayChunks<TElement>(this, size, size, location);
    }

    ## Returns an iterator over every run of `size` consecutive elements,
    ## as slices, each starting one element after the one before; none when
    ## the slice is shorter than `size`.
    ##
    ## @typeParam TElement the element type, `T` by default
    ## @param size the number of elements in each run
    ## @returns an iterator over `count - size + 1` runs, or none
    ## @panics if `size` is 0 ("ArrayView chunk size is 0")
    ## @example
    ##     var a = [1, 2, 3];
    ##     for (var pair in a.slice(0, 3).windows(2)) {
    ##         # [1, 2], then [2, 3]
    ##     }
    windows<TElement=T>(size: ulong, location: __ptr<char> = __caller_location()): ArrayChunks<TElement> {
        return ArrayChunks<TElement>(this, size, 1, location);
    }

    ## Reports whether both slices have the same count and pairwise equal
    ## elements, compared with `==` as `Array.find` does. Where the slices
    ## are is not compared.
    ##
    ## @param rhs the slice to compare with
    ## @returns true when the slices are element-wise equal
    ## @panics if either Array was modified since its slice was made ("Array modified while a slice of it is in use")
    ==(rhs: ArrayView<T>): bool {
        _check(__caller_location());
        rhs._check(__caller_location());
        if (count != rhs.count) {
            return false;
        }
        ulong index = 0;
        while (index < count) {
            if (!(_at(index) == rhs._at(index))) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    ## Reports whether the slices differ in count or in any element; the
    ## negation of `==`.
    ##
    ## @param rhs the slice to compare with
    ## @returns true when the slices are not element-wise equal
    ## @panics if either Array was modified since its slice was made ("Array modified while a slice of it is in use")
    !=(rhs: ArrayView<T>): bool {
        return !(this == rhs);
    }

    ## Returns a new Array holding a copy of the slice's elements, in order.
    ##
    ## The copy is shallow, as `Array.clone` is: for a struct `T` the new
    ## Array shares the element objects.
    ##
    ## @returns an independent Array with the slice's elements
    ## @panics if the Array was modified since the slice was made ("Array modified while a slice of it is in use")
    to_array(): Array<T> {
        _check(__caller_location());
        Array<T> result = Array<T>(count);
        ulong index = 0;
        while (index < count) {
            result.append(_at(index));
            index = index + 1;
        }
        return result;
    }

    ## Returns the position in the slice of the first element equal (`==`)
    ## to `item`, or none, compared as `Array.find` does.
    ##
    ## @param item the value to look for
    ## @returns the index of the first match, or none when no element matches
    ## @panics if the Array was modified since the slice was made ("Array modified while a slice of it is in use")
    find(item: T): ulong? {
        ulong index = 0;
        while (index < count) {
            if (_at(index) == item) {
                return Optional<ulong>.Value(index);
            }
            index = index + 1;
        }
        return Optional<ulong>.Empty;
    }

    ## Reports whether any element equals `item`, compared as `find` does.
    ##
    ## @param item the value to look for
    ## @returns true when `find(item)` finds a match
    ## @panics if the Array was modified since the slice was made ("Array modified while a slice of it is in use")
    contains(item: T): bool {
        return find(item).is_value();
    }

    ## Returns the position of the first element that `order` reports equal
    ## to the target, in a slice sorted in the order `order` follows, or
    ## none; see `Array.binary_search_by`.
    ##
    ## @param order returns a negative number when its argument sorts before
    ##   the target, 0 when it matches, and a positive number when it sorts after
    ## @returns the index of the first matching element, or none
    ## @panics if the Array was modified since the slice was made, `order` included ("Array modified while a slice of it is in use")
    binary_search_by(order: (T) => int): ulong? {
        var index = _partition(order, true);
        if (index == count || order(_at(index)) != 0) {
            return Optional<ulong>.Empty;
        }
        return Optional<ulong>.Value(index);
    }

    # The first index whose element `order` places at or after the target
    # (`at_equal`), or strictly after it, by binary search. `_at` checks the
    # version before each read, so an `order` that changes the Array panics.
    _partition(order: (T) => int, at_equal: bool): ulong {
        ulong low = 0;
        ulong high = count;
        while (low < high) {
            ulong middle = low + (high - low) / 2;
            var side = order(_at(middle));
            if (side < 0 || (side == 0 && !at_equal)) {
                low = middle + 1;
                continue;
            }
            high = middle;
        }
        _check(__caller_location());
        return low;
    }
}

## The searches of a sorted ArrayView, for an element type with an order
## (see `Comparable`).
##
## @typeParam T the element type, `Comparable`
export extend ArrayView<T: Comparable> {
    ## Returns the position of the first element equal to `item` in this
    ## slice, which must be sorted in `compare` order, or none; see
    ## `Array.binary_search`.
    ##
    ## @param item the value to look for
    ## @returns the index of the first element equal to `item`, or none
    ## @panics if the Array was modified since the slice was made ("Array modified while a slice of it is in use")
    binary_search(item: T): ulong? {
        return binary_search_by((x) => x.compare(item));
    }

    ## Returns the index of the first element of this sorted slice that
    ## does not sort before `item`, or `count`; see `Array.lower_bound`.
    ##
    ## @param item the value to place
    ## @returns the index of the first element at or after `item`
    ## @panics if the Array was modified since the slice was made ("Array modified while a slice of it is in use")
    lower_bound(item: T): ulong {
        return _partition((x) => x.compare(item), true);
    }

    ## Returns the index of the first element of this sorted slice that
    ## sorts after `item`, or `count`; see `Array.upper_bound`.
    ##
    ## @param item the value to place
    ## @returns the index of the first element after `item`
    ## @panics if the Array was modified since the slice was made ("Array modified while a slice of it is in use")
    upper_bound(item: T): ulong {
        return _partition((x) => x.compare(item), false);
    }

    ## Reports whether the elements are in `compare` order; see
    ## `Array.is_sorted`.
    ##
    ## @returns true when no element sorts after the one that follows it
    ## @panics if the Array was modified since the slice was made ("Array modified while a slice of it is in use")
    is_sorted(): bool {
        ulong index = 1;
        while (index < count) {
            if (_at(index - 1).compare(_at(index)) > 0) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    ## Returns the lexicographic order of this slice and `other`: the order
    ## of the first pair of elements that differ (by their `compare`), or,
    ## when one slice is the start of the other, the shorter first.
    ##
    ## @param other the slice to compare with
    ## @returns a negative number, zero or a positive number as this slice
    ##   sorts before, with or after `other`
    ## @panics if either Array was modified since its slice was made ("Array modified while a slice of it is in use")
    ## @example
    ##     var a = [1, 2, 3];
    ##     assert(a.slice(0, 2).compare(a.slice(1, 3)) < 0, "[1, 2] before [2, 3]");
    compare(other: ArrayView<T>): int {
        _check(__caller_location());
        other._check(__caller_location());
        ulong index = 0;
        while (index < count && index < other.count) {
            var order = _at(index).compare(other._at(index));
            if (order != 0) {
                return order;
            }
            index = index + 1;
        }
        return count.compare(other.count);
    }
}

## An `Iterator<T>` over the elements of an `ArrayView`, in order; returned
## by `ArrayView.iterate()` and driven by `for (var x in slice)`.
##
## @typeParam T the element type of the slice
## @see ArrayView.iterate
[Value]
export struct ArrayViewIterator<T> {
    ## The slice being iterated.
    ArrayView<T> _slice;
    ## The position of the current element in `_slice`; meaningful once `_started` is set.
    ulong _index;
    ## Whether `next()` has been called at least once.
    bool _started;

    ## Advances to the next element.
    ##
    ## @returns true when there is a current element, false once past the end
    ## @panics if the Array was modified since the slice was made ("Array modified while a slice of it is in use")
    next(): bool {
        _slice._check(__caller_location());
        if (!_started) {
            _started = true;
            return _index < _slice.count;
        }
        if (_index < _slice.count) {
            _index = _index + 1;
        }
        return _index < _slice.count;
    }

    ## Returns the element the last successful `next()` moved to.
    ##
    ## @returns the current element
    ## @panics if the Array was modified since the slice was made ("Array modified while a slice of it is in use")
    ## @panics if `next()` was never called ("ArrayViewIterator.current() before next()")
    ## @panics if `next()` already returned false ("ArrayView index out of bounds")
    current(): T {
        assert(_started, "ArrayViewIterator.current() before next()");
        return _slice[_index];
    }
}

extend ArrayViewIterator<T> with Iterator<T>;

## Deprecated: use `ArrayView` instead.
##
## @typeParam T the element type of the Array
[Deprecated("use 'ArrayView' instead", "ArrayView")]
export type ArraySlice<T> = ArrayView<T>;

## Deprecated: use `ArrayViewIterator` instead.
##
## @typeParam T the element type of the view
[Deprecated("use 'ArrayViewIterator' instead", "ArrayViewIterator")]
export type ArraySliceIterator<T> = ArrayViewIterator<T>;

# `_ArraySorter` insertion sorts a range this small, or smaller.
const _SORT_INSERTION_SIZE: ulong = 24;
# `_ArraySorter` takes the pivot of a larger range as a median of three medians.
const _SORT_NINTHER_SIZE: ulong = 128;

# One `sort_unstable`, `select_nth` or `partial_sort` of `_array`:
# pattern-defeating quicksort (Orson Peters' pdqsort), which falls back to
# heapsort when partitions keep coming out unbalanced, so it is
# O(count log count) in the worst case with no scratch buffer. Elements only
# trade slots (`_swap`), so no count changes. Every comparison is followed
# by a version check, so a `compare` that changes the Array panics before
# the next slot is read; and every scan is bounded by its range, so even an
# inconsistent `compare` stays in bounds (its result is then just unsorted).
[Value]
struct _ArraySorter<T> {
    Array<T> _array;
    (T, T) => int _compare;
    ulong _version;
    # Whether the last `_partition_right` found the range already partitioned.
    bool _partitioned;

    construct(array: Array<T>, compare: (T, T) => int) {
        array._version = array._version + 1;
        _array = array;
        _compare = compare;
        _version = array._version;
    }

    # Sorts slots `begin` up to `end`.
    sort(begin: ulong, end: ulong) {
        _sort(begin, end, _bad_allowed(end - begin), true);
    }

    # Moves the element a full sort puts at `nth` there, with every element
    # before it sorting before or with it and every element after it after
    # or with it: quickselect on the same partitions as `_sort`.
    select(nth: ulong) {
        ulong begin = 0;
        ulong end = _array._size;
        var bad_allowed = _bad_allowed(end);
        var leftmost = true;
        while (end - begin > _SORT_INSERTION_SIZE) {
            _choose_pivot(begin, end);
            # See `_sort`: every element of the range sorts with or after
            # the pivot, so the equal ones go left and are in place.
            if (!leftmost && !_less(begin - 1, begin)) {
                ulong equal_end = _partition_left(begin, end);
                if (nth <= equal_end) {
                    return;
                }
                begin = equal_end + 1;
                continue;
            }
            ulong size = end - begin;
            ulong pivot = _partition_right(begin, end);
            if (pivot == nth) {
                return;
            }
            if (pivot - begin < size / 8 || end - pivot - 1 < size / 8) {
                bad_allowed = bad_allowed - 1;
                if (bad_allowed == 0) {
                    _heap_sort(begin, end);
                    return;
                }
                _break_patterns(begin, pivot, end);
            }
            if (nth < pivot) {
                end = pivot;
            } else {
                begin = pivot + 1;
                leftmost = false;
            }
        }
        _insertion_sort(begin, end);
    }

    # The number of unbalanced partitions a range of `count` may take
    # before it falls back to heapsort: log2(count), at least 1.
    static _bad_allowed(count: ulong): ulong {
        ulong log = 1;
        while (count > 2) {
            count = count / 2;
            log = log + 1;
        }
        return log;
    }

    # Whether the element at `a` sorts before the one at `b`.
    _less(a: ulong, b: ulong): bool {
        var order = _compare(_array._data[a], _array._data[b]);
        assert(_array._version == _version, "Array modified during sort");
        return order < 0;
    }

    _swap(a: ulong, b: ulong) {
        if (a != b) {
            _array_swap(_array._slot(a), _array._slot(b), sizeof<T>());
        }
    }

    # Orders the elements at `a` and `b`.
    _sort2(a: ulong, b: ulong) {
        if (_less(b, a)) {
            _swap(a, b);
        }
    }

    # Orders the elements at `a`, `b` and `c`.
    _sort3(a: ulong, b: ulong, c: ulong) {
        _sort2(a, b);
        _sort2(b, c);
        _sort2(a, b);
    }

    _sort(begin: ulong, end: ulong, bad_allowed: ulong, leftmost: bool) {
        while (true) {
            ulong size = end - begin;
            if (size <= _SORT_INSERTION_SIZE) {
                _insertion_sort(begin, end);
                return;
            }
            _choose_pivot(begin, end);
            # Outside the leftmost range the element before `begin` is a
            # pivot that sorts before or with every element here. A pivot
            # that sorts with it is the smallest, so the elements equal to it
            # go left and need no more sorting: runs of equal elements cost
            # O(count).
            if (!leftmost && !_less(begin - 1, begin)) {
                begin = _partition_left(begin, end) + 1;
                continue;
            }
            ulong pivot = _partition_right(begin, end);
            bool partitioned = _partitioned;
            if (pivot - begin < size / 8 || end - pivot - 1 < size / 8) {
                bad_allowed = bad_allowed - 1;
                if (bad_allowed == 0) {
                    _heap_sort(begin, end);
                    return;
                }
                _break_patterns(begin, pivot, end);
            } else if (partitioned
                && _partial_insertion_sort(begin, pivot)
                && _partial_insertion_sort(pivot + 1, end)) {
                # Already sorted input stops here, in O(count).
                return;
            }
            _sort(begin, pivot, bad_allowed, leftmost);
            begin = pivot + 1;
            leftmost = false;
        }
    }

    # Moves the median of a sample of the range to `begin`, as the pivot.
    _choose_pivot(begin: ulong, end: ulong) {
        ulong half = (end - begin) / 2;
        if (end - begin > _SORT_NINTHER_SIZE) {
            _sort3(begin, begin + half, end - 1);
            _sort3(begin + 1, begin + half - 1, end - 2);
            _sort3(begin + 2, begin + half + 1, end - 3);
            _sort3(begin + half - 1, begin + half, begin + half + 1);
            _swap(begin, begin + half);
        } else {
            _sort3(begin + half, begin, end - 1);
        }
    }

    # Partitions the range around the pivot at `begin`: elements that sort
    # before it go left, the rest right. Returns the pivot's new position,
    # and sets `_partitioned` when no element had to move.
    _partition_right(begin: ulong, end: ulong): ulong {
        ulong first = begin + 1;
        while (first < end && _less(first, begin)) {
            first = first + 1;
        }
        ulong last = end;
        while (last > first) {
            last = last - 1;
            if (_less(last, begin)) {
                break;
            }
        }
        _partitioned = first >= last;
        while (first < last) {
            _swap(first, last);
            first = first + 1;
            while (first < end && _less(first, begin)) {
                first = first + 1;
            }
            last = last - 1;
            while (last > first && !_less(last, begin)) {
                last = last - 1;
            }
        }
        ulong pivot = first - 1;
        _swap(begin, pivot);
        return pivot;
    }

    # Partitions the range around the pivot at `begin`, elements that sort
    # with it going left; for a pivot no element sorts before. Returns the
    # pivot's new position, the last of the elements equal to it.
    _partition_left(begin: ulong, end: ulong): ulong {
        ulong last = end - 1;
        while (last > begin && _less(begin, last)) {
            last = last - 1;
        }
        ulong first = begin;
        while (first < last) {
            first = first + 1;
            if (_less(begin, first)) {
                break;
            }
        }
        while (first < last) {
            _swap(first, last);
            last = last - 1;
            while (last > first && _less(begin, last)) {
                last = last - 1;
            }
            first = first + 1;
            while (first < last && !_less(begin, first)) {
                first = first + 1;
            }
        }
        _swap(begin, last);
        return last;
    }

    # Swaps a few elements on each side of an unbalanced partition into new
    # places, breaking up the pattern that made it unbalanced.
    _break_patterns(begin: ulong, pivot: ulong, end: ulong) {
        ulong left = pivot - begin;
        ulong right = end - pivot - 1;
        if (left >= _SORT_INSERTION_SIZE) {
            _swap(begin, begin + left / 4);
            _swap(pivot - 1, pivot - left / 4);
            if (left > _SORT_NINTHER_SIZE) {
                _swap(begin + 1, begin + left / 4 + 1);
                _swap(begin + 2, begin + left / 4 + 2);
                _swap(pivot - 2, pivot - left / 4 - 1);
                _swap(pivot - 3, pivot - left / 4 - 2);
            }
        }
        if (right >= _SORT_INSERTION_SIZE) {
            _swap(pivot + 1, pivot + 1 + right / 4);
            _swap(end - 1, end - right / 4);
            if (right > _SORT_NINTHER_SIZE) {
                _swap(pivot + 2, pivot + 2 + right / 4);
                _swap(pivot + 3, pivot + 3 + right / 4);
                _swap(end - 2, end - right / 4 - 1);
                _swap(end - 3, end - right / 4 - 2);
            }
        }
    }

    _insertion_sort(begin: ulong, end: ulong) {
        ulong index = begin + 1;
        while (index < end) {
            ulong at = index;
            while (at > begin && _less(at, at - 1)) {
                _swap(at, at - 1);
                at = at - 1;
            }
            index = index + 1;
        }
    }

    # Insertion sorts the range unless that would move elements more than
    # 8 places in all; returns whether it finished.
    _partial_insertion_sort(begin: ulong, end: ulong): bool {
        ulong moves = 0;
        ulong index = begin + 1;
        while (index < end) {
            ulong at = index;
            while (at > begin && _less(at, at - 1)) {
                _swap(at, at - 1);
                at = at - 1;
            }
            moves = moves + (index - at);
            if (moves > 8) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    _heap_sort(begin: ulong, end: ulong) {
        ulong count = end - begin;
        ulong index = count / 2;
        while (index > 0) {
            index = index - 1;
            _sift_down(begin, index, count);
        }
        while (count > 1) {
            count = count - 1;
            _swap(begin, begin + count);
            _sift_down(begin, 0, count);
        }
    }

    # Moves the element at heap position `root` down the max-heap of
    # `count` elements starting at slot `begin`.
    _sift_down(begin: ulong, root: ulong, count: ulong) {
        while (true) {
            ulong child = 2 * root + 1;
            if (child >= count) {
                return;
            }
            if (child + 1 < count && _less(begin + child, begin + child + 1)) {
                child = child + 1;
            }
            if (!_less(begin + root, begin + child)) {
                return;
            }
            _swap(begin + root, begin + child);
            root = child;
        }
    }
}

## An `Iterator` over runs of an `ArrayView`, each itself a slice:
## returned by `chunks` (runs side by side, the last perhaps shorter) and
## `windows` (overlapping runs, each one element on).
##
## Each run is a slice of the same Array, so it is fail-fast like any
## slice: once the Array is modified, the next step panics.
##
## @typeParam T the element type of the slice
## @see ArrayView.chunks
## @see ArrayView.windows
[Value]
export struct ArrayChunks<T> {
    ## The slice being split into runs.
    ArrayView<T> _slice;
    ## The number of elements in each run.
    ulong _size;
    ## How far each run starts after the one before: `_size` for chunks, 1 for windows.
    ulong _step;
    ## The position in `_slice` of the current run; meaningful once `_started` is set.
    ulong _start;
    ## Whether `next()` has been called at least once.
    bool _started;

    ## Makes an iterator over the runs of `size` elements of `slice`, each
    ## starting `step` after the one before. With `step` equal to `size`
    ## the last run may be shorter (chunks); otherwise every run is whole
    ## (windows).
    ##
    ## @param slice the slice to split
    ## @param size the number of elements in each run
    ## @param step how far each run starts after the one before
    ## @panics if `size` is 0 ("ArrayView chunk size is 0")
    construct(slice: ArrayView<T>, size: ulong, step: ulong, location: __ptr<char> = __caller_location()) {
        assert(size > 0, "ArrayView chunk size is 0", location);
        _slice = slice;
        _size = size;
        _step = step;
    }

    # Whether a run starts at `_start`: any element left for chunks, a
    # whole run for windows.
    _has_run(): bool {
        if (_step == _size) {
            return _start < _slice.count;
        }
        return _slice.count >= _size && _start <= _slice.count - _size;
    }

    ## Advances to the next run.
    ##
    ## @returns true when there is a current run, false once past the end
    ## @panics if the Array was modified since the slice was made ("Array modified while a slice of it is in use")
    next(): bool {
        _slice._check(__caller_location());
        if (!_started) {
            _started = true;
        } else if (_has_run()) {
            _start = _start + _step;
        }
        return _has_run();
    }

    ## Returns the run the last successful `next()` moved to.
    ##
    ## @returns the current run, a slice of up to `size` elements
    ## @panics if the Array was modified since the slice was made ("Array modified while a slice of it is in use")
    ## @panics if `next()` was never called ("ArrayChunks.current() before next()")
    ## @panics if `next()` already returned false ("ArrayChunks.current() past the end")
    current(): ArrayView<T> {
        assert(_started, "ArrayChunks.current() before next()");
        assert(_has_run(), "ArrayChunks.current() past the end");
        return _slice.slice(_start, Array<T>._min(_start + _size, _slice.count));
    }
}

extend ArrayChunks<T> with Iterator<ArrayView<T>>;

# The start of an array literal: a new Array holding `first`, whose type
# gives the literal's element type (see `_literal_append`).
export _array_literal<T>(first: T): Array<T> {
    var result = Array<T>();
    result.append(first);
    return result;
}

extend ArrayIterator<T> with Iterator<T>;

extend Array<T> with Copyable<Array<T>>;

extern void memcpy(void* dest, void* src, ulong n);
extern void memmove(void* dest, void* src, ulong n);
extern void memset(void* p, int c, ulong n);

# Copies `size` bytes from `source` to `target`; the two must not overlap.
_array_copy(target: __ptr<void>, source: __ptr<void>, size: ulong) {
    memcpy(target, source, size);
}

# Copies `size` bytes from `source` to `target`, which may overlap.
_array_move(target: __ptr<void>, source: __ptr<void>, size: ulong) {
    memmove(target, source, size);
}

# Sets `size` bytes at `target` to 0.
_array_zero(target: __ptr<void>, size: ulong) {
    memset(target, 0, size);
}

# Exchanges the `size` bytes at `a` with those at `b` (distinct slots of one
# buffer), eight at a time while `size` allows and then byte by byte, with
# no allocation.
_array_swap(a: __ptr<u8>, b: __ptr<u8>, size: ulong) {
    ulong offset = 0;
    if (size % 8 == 0) {
        while (offset < size) {
            __ptr<ulong> x = unsafe_cast<__ptr<ulong>>(a + offset);
            __ptr<ulong> y = unsafe_cast<__ptr<ulong>>(b + offset);
            ulong held = x[0];
            x[0] = y[0];
            y[0] = held;
            offset = offset + 8;
        }
        return;
    }
    while (offset < size) {
        u8 held = a[offset];
        a[offset] = b[offset];
        b[offset] = held;
        offset = offset + 1;
    }
}
async/atomic
8839
# std::atomic<T>-equivalent. The storage slot is a malloc'd block of the
# T-sized value (POD) or one pointer (struct T stores its reference there),
# so every operation lowers to an LLVM atomic instruction on that slot:
# load = acquire, store = release (a shared_ptr `operator=` for struct T),
# compare_exchange = cmpxchg, fetch_* = atomicrmw. exchange is a CAS loop
# over compare_exchange.

## A value of type `T` that threads can read and update without data races,
## like C++ `std::atomic<T>`.
##
## `T` may be a numeric type, a pointer, or a struct type. For a struct `T`
## the Atomic holds a counted reference and every operation follows
## `std::shared_ptr` rules: `store` and a successful `compare_exchange` acquire
## the new reference and release the one they replace, and `load` hands the
## caller its own reference. Memory ordering: `load` is an acquire,
## `store` a release, and `compare_exchange` and the `fetch_*` operations are
## acquire-release.
##
## `Atomic` is a `[Shared]` struct, so copies of it share one slot and may
## be used from several threads at once: pass the Atomic around (or keep it
## in a `const` global) to share the value between threads, so `T` is
## constrained `Shared`: a number, `bool`, an enum, a `[Shared]` struct, or
## another thread-safe type. `async.Atomic<String>` is a compile error at
## `String`.
##
## @typeParam T the type of the stored value, which must be thread-safe
##   (`T: Shared`)
## @example
##     main(): int {
##         var counter = async.Atomic<long>(0);
##         var before = counter.fetch_add(5);   # before == 0
##         if (counter.load() != 5) { return 1; }
##         return 0;
##     }
[Shared]
export struct Atomic<T: Shared> {
    ## The heap slot the value lives in: `sizeof<T>()` bytes for a POD `T`,
    ## or one reference pointer for a struct `T`. Allocated by the
    ## constructor and never null afterwards. Internal storage; access it only
    ## through the methods, which keep every access atomic.
    const _data: __ptr<T>;

    ## Creates an Atomic holding `value`.
    ##
    ## For a struct `T` the Atomic acquires a reference to `value`.
    ##
    ## @param value the initial value; defaults to zero for a POD `T` and null for a struct `T`
    ## @example
    ##     var a = async.Atomic<int>(41);
    ##     var p = async.Atomic<Point>();   # holds null until a store
    construct(value: T = __default<T>()) {
        # A struct T occupies its reference pointer in the slot; a POD T
        # occupies sizeof(T) bytes of the value itself.
        ulong sz = __is_pod<T>() ? sizeof<T>() : 8;
        this._data = _pep_malloc(sz);
        __atomic_store<T>(this._data, value);
    }

    destruct {
        # Storing the zero value releases a struct T's reference in the slot.
        __atomic_store<T>(this._data, __default<T>());
        _pep_free(this._data);
    }

    ## Atomically reads the current value, with acquire ordering.
    ##
    ## For a struct `T` the returned reference is acquired for the caller, so
    ## it stays valid even if another thread stores a new value afterwards.
    ##
    ## @returns the value currently stored
    load(): T {
        return __atomic_load<T>(this._data);
    }

    ## Atomically replaces the stored value with `v`, with release ordering.
    ##
    ## For a struct `T` this is a `shared_ptr` assignment: the slot acquires
    ## `v` and releases its previous occupant, and the swap is a single atomic
    ## exchange, so concurrent stores never leak or double-release.
    ##
    ## @param v the new value
    store(v: T) {
        __atomic_store<T>(this._data, v);
    }

    ## Atomically replaces the stored value with `desired` if and only if it
    ## currently equals `expected` (a compare-and-swap).
    ##
    ## Equality is bitwise: a struct `T` compares references (the same object,
    ## not equal contents), and a floating-point `T` compares bit patterns, so
    ## `0.0` and `-0.0` differ. Unlike C++ `compare_exchange_strong`,
    ## `expected` is not updated on failure; call `load()` to retry. On success
    ## a struct slot acquires `desired` and releases the old occupant; on
    ## failure no reference count changes.
    ##
    ## @param expected the value the slot must hold for the exchange to happen
    ## @param desired the value to store when it does
    ## @returns true if the slot held `expected` and now holds `desired`, false if it was left unchanged
    ## @example
    ##     var cur = counter.load();
    ##     while (!counter.compare_exchange(cur, cur + 1)) {
    ##         cur = counter.load();
    ##     }
    compare_exchange(expected: T, desired: T): bool {
        return __atomic_cmpxchg<T>(this._data, expected, desired);
    }

    ## Atomically replaces the stored value with `v` and returns the value it
    ## replaced.
    ##
    ## Implemented as a `compare_exchange` retry loop, so under heavy
    ## contention it may retry several times. For a struct `T` the slot
    ## acquires `v`, and the caller owns the returned reference.
    ##
    ## @param v the new value
    ## @returns the value stored immediately before the exchange
    ## @example
    ##     var e = async.Atomic<int>(1);
    ##     var old = e.exchange(2);   # old == 1, e.load() == 2
    exchange(v: T): T {
        var old = this.load();
        while (true) {
            if (__atomic_cmpxchg<T>(this._data, old, v)) {
                return old;
            }
            old = this.load();
        }
    }

    ## Reports whether this Atomic's slot fits a native atomic instruction,
    ## so its operations never need a lock or an atomic library call.
    ##
    ## True for every POD `T` of 8 bytes or less and for every struct `T`
    ## (whose slot is one pointer). The answer depends only on `T`, never on
    ## the stored value.
    ##
    ## @returns true when the operations are lock-free
    is_lock_free(): bool {
        return __is_pod<T>() ? sizeof<T>() <= 8 : true;
    }

    # One method per operation (Pepper has no method overloading), each a
    # single native atomicrmw on the slot.

    ## Atomically adds `v` to the stored value and returns the value before
    ## the addition, like `std::atomic<T>::fetch_add`.
    ##
    ## Integer `T` only. Overflow wraps around. For a non-integer `T` (a
    ## floating-point or struct type) the call compiles but aborts the
    ## program when it runs.
    ##
    ## @param v the amount to add
    ## @returns the value stored immediately before the addition
    ## @example
    ##     var c = async.Atomic<long>(10);
    ##     var old = c.fetch_add(5);   # old == 10, c.load() == 15
    fetch_add(v: T): T {
        return __atomic_fetch_add<T>(this._data, v);
    }

    ## Atomically subtracts `v` from the stored value and returns the value
    ## before the subtraction, like `std::atomic<T>::fetch_sub`.
    ##
    ## Integer `T` only. Overflow wraps around. For a non-integer `T` the call
    ## compiles but aborts the program when it runs.
    ##
    ## @param v the amount to subtract
    ## @returns the value stored immediately before the subtraction
    fetch_sub(v: T): T {
        return __atomic_fetch_sub<T>(this._data, v);
    }

    ## Atomically replaces the stored value with its bitwise AND with `v` and
    ## returns the value before the operation, like
    ## `std::atomic<T>::fetch_and`.
    ##
    ## Integer `T` only. For a non-integer `T` the call compiles but aborts
    ## the program when it runs.
    ##
    ## @param v the mask to AND with
    ## @returns the value stored immediately before the operation
    fetch_and(v: T): T {
        return __atomic_fetch_and<T>(this._data, v);
    }

    ## Atomically replaces the stored value with its bitwise OR with `v` and
    ## returns the value before the operation, like
    ## `std::atomic<T>::fetch_or`.
    ##
    ## Integer `T` only. For a non-integer `T` the call compiles but aborts
    ## the program when it runs.
    ##
    ## @param v the bits to OR in
    ## @returns the value stored immediately before the operation
    fetch_or(v: T): T {
        return __atomic_fetch_or<T>(this._data, v);
    }

    ## Atomically replaces the stored value with its bitwise XOR with `v` and
    ## returns the value before the operation, like
    ## `std::atomic<T>::fetch_xor`.
    ##
    ## Integer `T` only. For a non-integer `T` the call compiles but aborts
    ## the program when it runs.
    ##
    ## @param v the bits to XOR with
    ## @returns the value stored immediately before the operation
    fetch_xor(v: T): T {
        return __atomic_fetch_xor<T>(this._data, v);
    }
}
async/channel
21931
## Channels: `Channel<T>` carries values from threads that send to threads
## that receive, and `ChannelIterator<T>` receives in a `for` loop.

# A Channel is `[Shared]`, so its fields are const. Its changing state lives
# in raw heap blocks that are read and written only under `_lock`:
#
# - `_state`: four `ulong`s: the head index, the number of queued values, the
#   number of slots in the buffer, and 1 once closed.
# - `_buffer`: one pointer to the ring buffer of `T` slots (one reference each
#   for a struct `T`). An unbounded channel replaces the buffer with one
#   twice the size when it fills.
#
# `_buffer` is a `__ptr<__ptr<void>>`, so `check_shared_types` accepts any
# `T`; the methods view the buffer as `T` slots. A value that is not
# thread-safe counts its references plainly, so no two threads may ever
# touch its counts. `send` takes a `[Move]` value, which nothing else
# references (the compiler checks the caller), and the caller hands its one
# reference over; under the lock `_push` moves it into its slot, so after
# unlocking only the slot references the value. `_pop` takes it out with
# `move(buffer[head])` under the lock the same way: the runtime's promise (the
# compiler cannot follow raw memory) that the slot held the only reference.
# No count step on a sent value happens on either side, and what `receive`
# returns is a new value, which may move into a locked value.
#
# Senders wait on `_not_full` (bounded channels only) and receivers on
# `_not_empty`; `close` wakes both. A task on a worker waits in
# `_senders` or `_receivers` instead (see sync_wait.pep), so its worker
# keeps running other tasks: whatever notifies a condition also wakes one
# task from the matching queue. A task adds its waiter under `_lock`, and a
# waker wakes under it, so no wake is missed.
#
# A `Select` (select.pep) waits on several channels through the same
# queues: `_select_join` adds its one waiter to `_receivers` unless a value
# is already there or the channel is closed, and `_select_take` takes a
# value the way `try_receive` does, telling an empty channel from a closed
# one. A send arm joins `_senders` instead (`_select_join_send`, unless
# there is room or the channel is closed), and `_select_put` moves its
# value in only when there is room.

import "atomic";
import "lock";
import "sync_wait";
import "sys_posix";
import "sys_wasi";
import "sys_windows";
import "task";

## A queue that carries values from threads that send to threads that
## receive, like Go channels or Rust's `mpsc`, with any number of each.
##
## Values arrive in the order they were sent (from any one sender). A
## bounded channel holds at most `capacity` values, and `send` waits while it
## is full; `Channel<T>(0)`, the default, is unbounded and `send` never waits.
##
## `close()` ends the stream: later sends fail, and receivers take what is
## left and then get an error. Only `close()` closes a channel; dropping it
## or the threads that use it does not. `for (var v in channel)` receives
## until the channel is closed and empty.
##
## `send` takes a new value, which nothing on the sending thread references,
## and hands it to the receiver without copying it: a constructor call, a
## literal, a call that returns a fresh value, `move(x)` (a variable that
## holds the only reference) or `copy(x)` (a copy, when the sender keeps
## using `x`). Sending a variable that something else still references is a
## compile error. A thread-safe value (a number, a `[Shared]` struct, a
## `shared` function value such as a `ThreadBody`) passes freely.
##
## A Channel is `[Shared]`: keep it in a module-scope variable or pass it to
## threads.
##
## @typeParam T the type of the values carried
## @example
##     import async;
##
##     const jobs = async.Channel<long>(64);
##     const total = Atomic<long>(0);
##
##     worker() {
##         for (var job in jobs) {
##             total.fetch_add(job);
##         }
##     }
##
##     main(): int {
##         var thread = async.Thread.spawn(worker);
##         jobs.send(20);
##         jobs.send(22);
##         jobs.close();
##         thread.join();
##         assert(total.load() == 42, "the worker received both jobs");
##         return 0;
##     }
[Shared]
export struct Channel<T> {
    # The most values that may wait before `send` blocks, or 0 for no limit.
    const _capacity: ulong;

    # The platform mutex that guards `_state` and `_buffer`.
    const _lock: __ptr<void>;

    # The platform condition variable receivers wait on.
    const _not_empty: __ptr<void>;

    # The platform condition variable senders wait on while a bounded
    # channel is full.
    const _not_full: __ptr<void>;

    # The head index, the number of queued values, the number of slots in
    # the buffer, and 1 once closed. Read and written only under `_lock`.
    const _state: __ptr<ulong>;

    # Holds the ring buffer of values (`T` slots). Read and written only
    # under `_lock`.
    const _buffer: __ptr<__ptr<void>>;

    # The tasks waiting to receive, and to send to a full bounded channel.
    const _receivers: _SyncQueue;
    const _senders: _SyncQueue;

    ## Creates an open, empty channel.
    ##
    ## @param capacity how many values may wait before `send` blocks; 0 (the default) for no limit
    ## @example
    ##     var bounded = async.Channel<long>(16);
    ##     var unbounded = async.Channel<long>();
    construct(capacity: ulong = 0) {
        _capacity = capacity;
        _lock = _async_sys_mutex_create();
        _not_empty = _async_sys_condition_create();
        _not_full = _async_sys_condition_create();
        _state = _pep_malloc(4 * sizeof<ulong>());
        var slots = capacity > 0 ? capacity : 16;
        _state[2] = slots;
        _buffer = _pep_malloc(sizeof<__ptr<void>>());
        _buffer[0] = _pep_malloc(slots * sizeof<T>());
        _receivers = _SyncQueue();
        _senders = _SyncQueue();
    }

    destruct {
        # Release the values still queued, under the lock the senders stored
        # them under.
        _async_sys_mutex_lock(_lock);
        __ptr<T> buffer = this._slots();
        var i: ulong = 0;
        while (i < _state[1]) {
            buffer[(_state[0] + i) % _state[2]] = __default<T>();
            i = i + 1;
        }
        _async_sys_mutex_unlock(_lock);
        _pep_free(buffer);
        _pep_free(_buffer);
        _pep_free(_state);
        _async_sys_condition_destroy(_not_full);
        _async_sys_condition_destroy(_not_empty);
        _async_sys_mutex_destroy(_lock);
    }

    ## Queues `value`, first waiting while a bounded channel is full.
    ##
    ## `value` must be a new value: nothing else may reference it. The caller
    ## hands its reference over and the value itself is queued, with no copy.
    ## Pass `move(x)` to send a variable's value, or `copy(x)` to keep using
    ## `x`.
    ##
    ## In a task (see `run`), waiting parks the task and its worker runs
    ## other tasks; a cancel or the task's `timeout` ends the wait.
    ##
    ## @param value the value to send; a new value, which the compiler checks
    ## @returns true if the value was queued, false if the channel is closed or the task's wait was cancelled or timed out (the value is dropped)
    ## @example
    ##     var line = "hello";
    ##     lines.send(copy(line));
    ##     line.append(" again");   # the receiver still gets "hello"
    ##     lines.send(move(line));   # line is null now
    send([Move] value: T): bool {
        _async_sys_mutex_lock(_lock);
        var in_task = _async_in_task();
        while (_capacity > 0 && _state[1] == _capacity && _state[3] == 0) {
            if (!in_task) {
                _async_sys_condition_wait(_not_full, _lock);
            } else if (this._park_task(_senders, 0) != _SyncWake.Woken) {
                _async_sys_mutex_unlock(_lock);
                return false;
            }
        }
        var queued = this._push(move(value));
        _async_sys_mutex_unlock(_lock);
        return queued;
    }

    ## Queues `value` only if there is room right now, without waiting. The
    ## value is dropped when it is not queued.
    ##
    ## @param value the value to send; a new value, as for `send`
    ## @returns true if the value was queued, false if the channel is full or closed
    try_send([Move] value: T): bool {
        _async_sys_mutex_lock(_lock);
        var queued = false;
        if (_capacity == 0 || _state[1] < _capacity) {
            queued = this._push(move(value));
        }
        _async_sys_mutex_unlock(_lock);
        return queued;
    }

    ## Takes the next value, waiting until one arrives.
    ##
    ## In a task (see `run`), waiting parks the task and its worker runs
    ## other tasks; a cancel or the task's `timeout` ends the wait.
    ##
    ## @returns the value, or an error once the channel is closed and empty, or when the task's wait was cancelled or timed out
    ## @example
    ##     var job = jobs.receive();
    ##     if (job.is_ok()) {
    ##         run(job.value());
    ##     }
    receive(): Result<T> {
        _async_sys_mutex_lock(_lock);
        var in_task = _async_in_task();
        while (_state[1] == 0 && _state[3] == 0) {
            if (!in_task) {
                _async_sys_condition_wait(_not_empty, _lock);
                continue;
            }
            var woken = this._park_task(_receivers, 0);
            if (woken == _SyncWake.Cancelled) {
                _async_sys_mutex_unlock(_lock);
                return Result<T>.err(Error("the task was cancelled"));
            }
            if (woken == _SyncWake.TimedOut) {
                break;
            }
        }
        var received = this._pop();
        _async_sys_mutex_unlock(_lock);
        return received;
    }

    ## Takes the next value if one is waiting, without waiting.
    ##
    ## @returns the value, or an error if none is waiting (see `is_closed()` to tell an empty channel from a closed one)
    try_receive(): Result<T> {
        _async_sys_mutex_lock(_lock);
        var received = this._pop();
        _async_sys_mutex_unlock(_lock);
        return received;
    }

    ## Like `receive()`, but gives up after about `milliseconds` milliseconds.
    ##
    ## @param milliseconds the longest time to wait
    ## @returns the value, or an error if the time ran out, once the channel is closed and empty, or when the task's wait was cancelled
    receive_for(milliseconds: ulong): Result<T> {
        var deadline = _async_sys_monotonic_milliseconds() + milliseconds;
        _async_sys_mutex_lock(_lock);
        var in_task = _async_in_task();
        while (_state[1] == 0 && _state[3] == 0) {
            if (in_task) {
                var woken = this._park_task(_receivers, deadline);
                if (woken == _SyncWake.Cancelled) {
                    _async_sys_mutex_unlock(_lock);
                    return Result<T>.err(Error("the task was cancelled"));
                }
                if (woken == _SyncWake.TimedOut) {
                    break;
                }
                continue;
            }
            var now = _async_sys_monotonic_milliseconds();
            if (now >= deadline) {
                break;
            }
            _async_sys_condition_wait_for(_not_empty, _lock, deadline - now);
        }
        var received = this._pop();
        _async_sys_mutex_unlock(_lock);
        return received;
    }

    ## Closes the channel and wakes every waiting sender and receiver.
    ##
    ## Later sends fail. Values already queued stay, and receivers still get
    ## them; after the last one, `receive()` returns an error and `for` loops
    ## end. Closing a closed channel does nothing.
    close() {
        _async_sys_mutex_lock(_lock);
        _state[3] = 1;
        _async_sys_condition_notify_all(_not_empty);
        _async_sys_condition_notify_all(_not_full);
        _receivers._wake_all();
        _senders._wake_all();
        _async_sys_mutex_unlock(_lock);
    }

    ## Reports whether `close()` has been called.
    ##
    ## @returns true once the channel is closed, even while values are still queued
    is_closed(): bool {
        _async_sys_mutex_lock(_lock);
        var closed = _state[3] != 0;
        _async_sys_mutex_unlock(_lock);
        return closed;
    }

    ## The number of values waiting to be received. Other threads may
    ## change it as soon as it returns.
    var count: ulong {
        get {
            _async_sys_mutex_lock(_lock);
            var queued = _state[1];
            _async_sys_mutex_unlock(_lock);
            return queued;
        }
    }

    ## Returns an iterator that receives until the channel is closed and
    ## empty. A `for` loop over the channel calls it.
    ##
    ## Several threads may loop over one channel at once; each value goes to
    ## exactly one of them.
    ##
    ## @returns the iterator a `for` loop drives
    ## @example
    ##     for (var line in lines) {
    ##         print(line, "\n");
    ##     }   # ends once `lines` is closed and empty
    iterate(): ChannelIterator<T> {
        return ChannelIterator<T>(this);
    }

    # Queues `value` at the tail, growing an unbounded buffer when full; false
    # if closed, when `value` is dropped here, under the lock. The caller
    # holds the lock and has checked a bounded channel's capacity.
    _push([Move] value: T): bool {
        if (_state[3] != 0) {
            return false;
        }
        if (_state[1] == _state[2]) {
            this._grow();
        }
        __ptr<T> buffer = this._slots();
        buffer[(_state[0] + _state[1]) % _state[2]] = move(value);
        _state[1] = _state[1] + 1;
        _async_sys_condition_notify_one(_not_empty);
        _receivers._wake_one();
        return true;
    }

    # Takes the value at the head; an error if none is queued. The caller
    # holds the lock.
    _pop(): Result<T> {
        if (_state[1] == 0) {
            if (_state[3] != 0) {
                return Result<T>.err(Error("the channel is closed"));
            }
            return Result<T>.err(Error("no value is waiting"));
        }
        __ptr<T> buffer = this._slots();
        var head = _state[0];
        var received = Result<T>.ok(move(buffer[head]));
        _state[0] = (head + 1) % _state[2];
        _state[1] = _state[1] - 1;
        _async_sys_condition_notify_one(_not_full);
        _senders._wake_one();
        return received;
    }

    # Takes the value at the head if one is waiting: `(true, value)`, or
    # `(false, default)` when none is. For the scheduler, which polls
    # channels that are usually empty: unlike `try_receive`, a miss
    # allocates nothing (no `Result`, `Error` or message).
    _try_take(): (bool, T) {
        _async_sys_mutex_lock(_lock);
        if (_state[1] == 0) {
            _async_sys_mutex_unlock(_lock);
            return (false, __default<T>());
        }
        __ptr<T> buffer = this._slots();
        var head = _state[0];
        T value = move(buffer[head]);
        _state[0] = (head + 1) % _state[2];
        _state[1] = _state[1] - 1;
        _async_sys_condition_notify_one(_not_full);
        _senders._wake_one();
        _async_sys_mutex_unlock(_lock);
        return (true, value);
    }

    # For `Select`: takes the value at the head if there is one, and
    # otherwise reports whether the channel is closed.
    _select_take(): _Polled<T> {
        _async_sys_mutex_lock(_lock);
        if (_state[1] != 0) {
            var received = this._pop();
            _async_sys_mutex_unlock(_lock);
            return _Polled<T>.Ready(received.value());
        }
        var closed = _state[3] != 0;
        _async_sys_mutex_unlock(_lock);
        if (closed) {
            return _Polled<T>.Closed;
        }
        return _Polled<T>.Empty;
    }

    # For `Select`: adds `waiter` to `_receivers` and returns
    # `_Joined.Empty`. Returns `_Joined.Ready` without adding it when a
    # value is waiting (the select should look again instead of sleeping),
    # and `_Joined.Closed` when the channel is closed and empty (nothing
    # will ever wake it).
    _select_join(waiter: _SyncWaiter): _Joined {
        _async_sys_mutex_lock(_lock);
        var found = _Joined.Empty;
        if (_state[1] != 0) {
            found = _Joined.Ready;
        } else if (_state[3] != 0) {
            found = _Joined.Closed;
        } else {
            _receivers._push(waiter);
        }
        _async_sys_mutex_unlock(_lock);
        return found;
    }

    # For `Select`: takes `waiter` out of `_receivers`, if it is there.
    _select_leave(waiter: _SyncWaiter) {
        _receivers._remove(waiter);
    }

    # For a `Select` send arm: moves the value in `slot` into the channel if
    # there is room now (`_Joined.Ready`, `slot` then holds nothing), and
    # otherwise leaves it in `slot` and reports a full channel
    # (`_Joined.Empty`) or a closed one (`_Joined.Closed`). `slot` holds the
    # only reference to its value, the runtime's promise as for `send`.
    _select_put(slot: __ptr<T>): _Joined {
        _async_sys_mutex_lock(_lock);
        var found = _Joined.Empty;
        if (_state[3] != 0) {
            found = _Joined.Closed;
        } else if (_capacity == 0 || _state[1] < _capacity) {
            this._push(move(slot[0]));
            found = _Joined.Ready;
        }
        _async_sys_mutex_unlock(_lock);
        return found;
    }

    # For a `Select` send arm: adds `waiter` to `_senders` and returns
    # `_Joined.Empty`. Returns `_Joined.Ready` without adding it when there
    # is room for a value, and `_Joined.Closed` when the channel is closed.
    _select_join_send(waiter: _SyncWaiter): _Joined {
        _async_sys_mutex_lock(_lock);
        var found = _Joined.Empty;
        if (_state[3] != 0) {
            found = _Joined.Closed;
        } else if (_capacity == 0 || _state[1] < _capacity) {
            found = _Joined.Ready;
        } else {
            _senders._push(waiter);
        }
        _async_sys_mutex_unlock(_lock);
        return found;
    }

    # For a `Select` send arm: takes `waiter` out of `_senders`, if it is
    # there.
    _select_leave_send(waiter: _SyncWaiter) {
        _senders._remove(waiter);
    }

    # Parks the running task in `queue` until a waker wakes it, `deadline`
    # passes (0 for none), or the task is cancelled or its `timeout` expires;
    # returns which (see `_async_sync_park`). The caller holds the lock,
    # which is released while the task waits and held again on return.
    _park_task(queue: _SyncQueue, deadline: ulong): _SyncWake {
        var waiter = _async_sync_waiter();
        queue._push(waiter);
        _async_sys_mutex_unlock(_lock);
        var woken = _async_sync_park(queue, waiter, deadline, true);
        _async_sys_mutex_lock(_lock);
        return woken;
    }

    # The ring buffer, as `T` slots.
    _slots(): __ptr<T> {
        __ptr<void> raw = _buffer[0];
        return raw;
    }

    # Moves the queued values, in order, into a buffer twice the size. The
    # caller holds the lock.
    _grow() {
        __ptr<T> old = this._slots();
        var slots = _state[2];
        __ptr<T> grown = _pep_malloc(2 * slots * sizeof<T>());
        var i: ulong = 0;
        while (i < _state[1]) {
            var from = (_state[0] + i) % slots;
            grown[i] = old[from];
            old[from] = __default<T>();
            i = i + 1;
        }
        _pep_free(old);
        _buffer[0] = grown;
        _state[0] = 0;
        _state[2] = 2 * slots;
    }
}

# What `Channel._select_join` found (and, in select.pep, what a case's
# last `_take` found).
enum _Joined {
    Ready,
    Empty,
    Closed,
}

# What `Channel._select_take` found: a value, nothing yet, or a closed and
# empty channel.
enum _Polled<T> {
    Ready(value: T),
    Empty,
    Closed,
}

## Receives from a `Channel<T>` in a `for` loop: `next()` waits for the next
## value and returns false once the channel is closed and empty.
##
## `Channel.iterate()` returns one; a `for` loop over a channel uses it
## without naming it. It belongs to the thread that runs the loop.
##
## @typeParam T the type of the values carried
## @example
##     var values = jobs.iterate();
##     while (values.next()) {
##         total = total + values.current();
##     }
[Value]
export struct ChannelIterator<T> {
    # The channel it receives from.
    const _source: Channel<T>;

    # The value the last successful `next()` received.
    T _current;

    ## Creates an iterator that receives from `source`. `source.iterate()`
    ## does the same.
    ##
    ## @param source the channel to receive from
    construct(source: Channel<T>) {
        _source = source;
    }

    ## Waits for the next value.
    ##
    ## @returns true if a value arrived (read it with `current()`), false once the channel is closed and empty
    next(): bool {
        var received = _source.receive();
        if (received.is_err()) {
            _current = __default<T>();
            return false;
        }
        _current = received.value();
        return true;
    }

    ## Returns the value the last successful `next()` received.
    ##
    ## @returns the current value
    current(): T {
        return _current;
    }
}

extend ChannelIterator<T> with Iterator<T>;
async/coordination
10281
## Coordination between threads: `Semaphore` bounds how many threads do
## something at once, `Barrier` makes a group of threads meet before any
## goes on, and `Latch` lets threads wait until a count of events has
## happened.

# Each type is a Mutex over a small struct of counts, with a Condition that
# its waiters sleep on. The counts are plain numbers, read and written only
# inside `with` blocks over the Mutex, so the types are `[Shared]` with no
# confinement concerns, and in a task their waits park the task (see
# mutex.pep).

import "mutex";

## A count of permits that threads take and give back, like Java's
## `Semaphore` or C++20 `std::counting_semaphore`: at most `permits` threads
## hold one at a time.
##
## `acquire()` waits until a permit is free and takes it; `release()` gives
## one back. The usual form is a `with` block, which gives the permit back
## on every path out: `with (semaphore.permit()) { ... }`.
##
## A Semaphore is `[Shared]`: keep it in a module-scope variable or pass it
## to threads. Permits are not tied to a thread: any thread may release a
## permit that another acquired, and `release()` may raise the count above
## where it started.
##
## In a task (see `run`), waiting for a permit parks the task, not its worker
## thread.
##
## @example
##     import async;
##
##     # At most two downloads at once.
##     const downloads = async.Semaphore(2);
##
##     download(url: String) {
##         with (downloads.permit()) {
##             # ... fetch url ...
##         }
##     }
[Shared]
export struct Semaphore {
    # The free permits.
    const _state: Mutex<_Permits>;

    # Signalled when a permit is given back.
    const _released: Condition<_Permits>;

    ## Creates a Semaphore with `permits` free permits.
    ##
    ## @param permits how many permits are free at first; 0 makes every `acquire()` wait for a `release()`
    construct(permits: ulong) {
        _state = Mutex<_Permits>(_Permits(permits));
        _released = _state.condition();
    }

    ## Waits until a permit is free, and takes it.
    ##
    ## Give it back with `release()`, or use `permit()` in a `with` block,
    ## which gives it back for you.
    acquire() {
        with (var permits = _state.lock()) {
            while (permits.free == 0) {
                _released.wait();
            }
            permits.free = permits.free - 1;
        }
    }

    ## Takes a permit only if one is free right now, without waiting.
    ##
    ## @returns true if the caller now holds a permit, false if none was free
    try_acquire(): bool {
        with (var permits = _state.lock()) {
            if (permits.free == 0) {
                return false;
            }
            permits.free = permits.free - 1;
        }
        return true;
    }

    ## Gives a permit back, waking one thread waiting in `acquire()` if any.
    release() {
        with (var permits = _state.lock()) {
            permits.free = permits.free + 1;
            _released.notify_one();
        }
    }

    ## Waits until a permit is free, takes it, and returns a guard that gives
    ## it back when destroyed: at the end of `with (semaphore.permit()) { ... }`
    ## by any path.
    ##
    ## @returns the guard holding the permit
    ## @example
    ##     with (connections.permit()) {
    ##         serve(client);
    ##     }   # the permit is given back here
    permit(): SemaphorePermit {
        return SemaphorePermit(this);
    }
}

## A permit taken from a `Semaphore`, given back when the guard is destroyed.
## Get one from `Semaphore.permit()` in a `with` header.
##
## @example
##     with (var permit = pool.permit()) {
##         # holds one of the pool's permits
##     }
export struct SemaphorePermit {
    # The Semaphore the permit came from.
    const _semaphore: Semaphore;

    # Whether the permit is still held: false once `exit()` gave it back.
    var _held: bool;

    ## Waits for a permit from `semaphore` and holds it; the same as
    ## `semaphore.permit()`.
    ##
    ## @param semaphore the Semaphore to take a permit from
    construct(semaphore: Semaphore) {
        _semaphore = semaphore;
        semaphore.acquire();
        _held = true;
    }

    destruct {
        this.exit();
    }

    ## Returns this guard, for the `with` header.
    ##
    ## @returns this permit
    enter(): SemaphorePermit {
        return this;
    }

    ## Gives the permit back if it is still held. The destructor calls it;
    ## calling it again does nothing.
    exit() {
        if (_held) {
            _held = false;
            _semaphore.release();
        }
    }
}

extend SemaphorePermit with Scoped<SemaphorePermit>;

## A meeting point for a fixed number of threads, like Rust's
## `std::sync::Barrier`: each thread that calls `wait()` sleeps until `count`
## threads have called it, then all of them go on together.
##
## Exactly one thread of each group, the leader, gets true from `wait()`, so
## it can do the work that must happen once per round. The barrier then
## resets, and the next `count` calls make the next round.
##
## A Barrier is `[Shared]`. In a task (see `run`), `wait()` parks the task,
## not its worker thread; the other tasks of a round must then run on other
## workers or later on the same one.
##
## @example
##     import async;
##
##     const step_done = async.Barrier(4);
##
##     work(id: long) {
##         var step = 0;
##         while (step < 10) {
##             # ... this thread's share of the step ...
##             if (step_done.wait()) {
##                 print($"step {step} done\n");   # once per step
##             }
##             step = step + 1;
##         }
##     }
[Shared]
export struct Barrier {
    # How many threads make a round.
    const _count: ulong;

    # The round in progress and how many have arrived at it.
    const _state: Mutex<_BarrierState>;

    # Signalled when a round completes.
    const _round_done: Condition<_BarrierState>;

    ## Creates a barrier for groups of `count` threads.
    ##
    ## @param count how many threads each round waits for; 0 counts as 1, so every `wait()` returns at once as the leader
    construct(count: ulong) {
        _count = count == 0 ? 1 : count;
        _state = Mutex<_BarrierState>(_BarrierState());
        _round_done = _state.condition();
    }

    ## Waits until `count` threads, this one included, have called `wait()`
    ## in this round.
    ##
    ## @returns true on exactly one thread of each round, the last to arrive; false on the others
    wait(): bool {
        with (var state = _state.lock()) {
            var round = state.round;
            state.arrived = state.arrived + 1;
            if (state.arrived < _count) {
                while (state.round == round) {
                    _round_done.wait();
                }
                return false;
            }
            state.arrived = 0;
            state.round = state.round + 1;
            _round_done.notify_all();
        }
        return true;
    }
}

## A one-shot countdown, like C++20 `std::latch`: threads wait until
## `count_down()` has been called `count` times. Once open it stays open.
##
## Unlike a `Barrier`, the threads that count down need not wait, and the
## threads that wait need not count down: a typical use is a thread that
## starts workers and waits for each to report that it is ready.
##
## A Latch is `[Shared]`. In a task (see `run`), `wait()` parks the task, not
## its worker thread.
##
## @example
##     import async;
##
##     const ready = async.Latch(3);
##
##     worker() {
##         # ... set up ...
##         ready.count_down();
##         # ... work ...
##     }
##
##     main(): int {
##         var threads = Array<async.Thread>();
##         var i = 0;
##         while (i < 3) {
##             threads.append(async.Thread.spawn(worker));
##             i = i + 1;
##         }
##         ready.wait();   # every worker has set up
##         for (var t in threads) {
##             t.join();
##         }
##         return 0;
##     }
[Shared]
export struct Latch {
    # How many `count_down()` calls are still to come.
    const _state: Mutex<_LatchState>;

    # Signalled when the count reaches zero.
    const _opened: Condition<_LatchState>;

    ## Creates a latch that opens after `count` calls to `count_down()`.
    ##
    ## @param count how many calls open it; 0 makes a latch that is open from the start
    construct(count: ulong) {
        _state = Mutex<_LatchState>(_LatchState(count));
        _opened = _state.condition();
    }

    ## Counts one event, and opens the latch, waking every waiter, if it was
    ## the last one.
    ##
    ## @panics if the latch is already open
    count_down() {
        with (var state = _state.lock()) {
            if (state.remaining == 0) {
                panic("Latch.count_down: the latch is already open");
            }
            state.remaining = state.remaining - 1;
            if (state.remaining == 0) {
                _opened.notify_all();
            }
        }
    }

    ## Waits until the latch is open. Returns at once if it already is.
    wait() {
        with (var state = _state.lock()) {
            while (state.remaining != 0) {
                _opened.wait();
            }
        }
    }

    ## Reports whether the latch is open, without waiting.
    ##
    ## @returns true once `count_down()` has been called `count` times
    is_ready(): bool {
        with (var state = _state.lock()) {
            return state.remaining == 0;
        }
        return false;
    }
}

# A Semaphore's count.
struct _Permits {
    var free: ulong;
    construct(this.free = 0) {}
}

# A Barrier's round number and how many threads have arrived at it.
struct _BarrierState {
    var round: ulong;
    var arrived: ulong;
}

# How many `count_down()` calls a Latch still waits for.
struct _LatchState {
    var remaining: ulong;
    construct(this.remaining = 0) {}
}
async/cpus
1986
## Processor counts.

import "sys_posix";
import "sys_wasi";
import "sys_windows";

## Returns the number of logical processors the operating system can run
## threads on: every hardware thread, so a core with hyperthreading (SMT)
## counts two or more times.
##
## This is the upper bound on how many threads can run at the same moment,
## and a sensible default size for a pool of CPU-bound worker threads. Inside
## a virtual machine it counts the processors the guest sees. On Linux, a
## CPU quota on the process's cgroup or any cgroup above it (cgroup v2's
## `cpu.max`, or v1's `cpu.cfs_quota_us` over `cpu.cfs_period_us`, as
## `docker run --cpus` sets) caps the count, rounded up to whole processors,
## as Go and the JVM do: a quota of 1.5 processors counts as 2.
##
## @returns the number of logical processors, at least 1
## @see physical_cpus
## @example
##     import async;
##
##     main(): int {
##         print(async.logical_cpus(), " logical processors\n");
##         return 0;
##     }
export logical_cpus(): ulong {
    var count = _async_sys_logical_cpus();
    return count == 0 ? 1 : count;
}

## Returns the number of physical processor cores: hardware threads that
## share a core through hyperthreading (SMT) count once.
##
## On Linux the count comes from the kernel's CPU topology
## (`/sys/devices/system/cpu`), on macOS from `hw.physicalcpu`, and on
## Windows from `GetLogicalProcessorInformationEx`. Inside a virtual machine
## the guest cannot see the host's hardware, so this counts the cores the
## hypervisor presents. Where the topology is not available, it returns
## `logical_cpus()`.
##
## @returns the number of physical cores, at least 1 and at most `logical_cpus()`
## @see logical_cpus
export physical_cpus(): ulong {
    var logical = logical_cpus();
    var count = _async_sys_physical_cpus();
    if (count == 0 || count > logical) {
        return logical;
    }
    return count;
}
async/driver
10953
## I/O backends: how a task runtime waits for sockets.

# The driver seam. A worker owns one `_Driver`, chosen when `run` starts
# (`_async_open_driver`): epoll (driver_epoll.pep), io_uring
# (driver_io_uring.pep), kqueue (driver_kqueue.pep), IOCP (driver_iocp.pep),
# or poll(), the portable reference (driver_poll.pep). Every driver type
# exists on every OS; the system calls behind one are [Target]ed, with stubs
# elsewhere that make it unavailable, so the choice can be made at run time.
#
# Each driver also has a doorbell (`_Doorbell`): any thread can ring it to
# end the worker's current or next wait early, so a worker blocked in its
# driver notices messages from other workers. It is an eventfd (epoll and
# io_uring), an EVFILT_USER event (kqueue), a posted completion (IOCP), or a
# self-pipe (poll on POSIX) or a loopback UDP socket that a second socket
# sends to (poll on Windows). A ring is remembered until the next wait, so a
# ring that lands just before the worker blocks still wakes it.

import io;
import "driver_epoll";
import "driver_io_uring";
import "driver_iocp";
import "driver_kqueue";
import "driver_poll";
import "task";

## The I/O backend a runtime waits on sockets with (see
## `RuntimeOptions.backend`).
export enum Backend {
    ## The best one the system has: epoll on Linux, kqueue on macOS, IOCP on
    ## Windows. The `PEPPER_IO_BACKEND` environment variable (`epoll`,
    ## `io_uring`, `kqueue`, `iocp` or `poll`) picks another.
    Automatic,
    ## Linux's epoll, edge-triggered.
    Epoll,
    ## Linux's io_uring (kernel 5.11 or later), waiting for sockets with
    ## one multishot poll request each. Not the default: container seccomp
    ## profiles and hardened kernels often refuse it.
    IoUring,
    ## The BSD and macOS kqueue, edge-triggered.
    Kqueue,
    ## A Windows I/O completion port, fed readiness by AFD poll requests.
    Iocp,
    ## `poll()` (`WSAPoll` on Windows): available everywhere, but each wait
    ## passes every waiting socket to the system, so it suits few
    ## connections. The reference the others are tested against.
    Poll,
}

# How a worker waits for sockets.
trait _Driver {
    # Starts watching `handle`, the first time a task waits on it; false if
    # this driver cannot watch it.
    _watch(handle: io.SocketHandle): bool;

    # A task is about to wait for `interest` on `handle` (already watched);
    # false if the driver cannot wait for it (the task then blocks the
    # thread instead).
    _want(handle: io.SocketHandle, interest: int): bool;

    # Waits up to `timeout` milliseconds (forever when negative) until a
    # socket in `waits` may be ready for what its tasks wait for, and
    # appends each ready socket with what it allows (io._IO_READABLE and
    # io._IO_WRITABLE or'ed) to `ready_sockets`. Returns early, with nothing, on a
    # signal.
    _poll(waits: HashMap<ulong, _SocketWaits>, timeout: long, ready_sockets: Array<(handle: ulong, interest: int)>);

    # `handle` is about to be closed.
    _forget(handle: io.SocketHandle);

    # `handle` stays open but moves to another worker (see
    # `io.TcpStream.into_transfer`): stops watching it.
    _release(handle: io.SocketHandle);

    # Starts reading `count` bytes into the memory at address `buffer` from
    # the file `handle` (or writing them from it, when `write`) at the
    # file's position, for the task `task`; false if this driver cannot (the
    # worker then runs the call on a pool thread). `_finished_files` reports
    # it. (The address is a ulong: a `__ptr` parameter in a trait method
    # does not compile yet.)
    _start_file(handle: long, buffer: ulong, count: ulong, write: bool, task: ulong): bool {
        return false;
    }

    # Starts receiving up to `count` bytes into the memory at address
    # `buffer` from the stream socket `handle` (or sending them from it,
    # when `write`) as soon as the socket is ready, for the task `task`.
    # Returns a request number for `_cancel_transfer`, or 0 if this driver
    # cannot (the task then waits for readiness and makes the call itself).
    # `_finished_files` reports it, with the result `-1 - ECANCELED` when it
    # was cancelled first, and `_forget` and `_release` cancel those in
    # flight on their socket.
    _start_socket(handle: io.SocketHandle, buffer: ulong, count: ulong, write: bool, task: ulong): ulong {
        return 0;
    }

    # Windows: starts a ReadDirectoryChangesW request on the directory
    # `handle` into the `count` bytes at address `buffer`, for the task
    # `task` (see `io._IoWaiter._directory_changes`). Returns a request
    # number for `_cancel_transfer`, or 0 if this driver cannot (the task
    # then blocks the thread instead). `_finished_files` reports it: the
    # byte count, or `-1 - ECANCELED` when it was cancelled or the handle
    # closed.
    _start_directory_changes(handle: ulong, buffer: ulong, count: ulong, task: ulong): ulong {
        return 0;
    }

    # Asks the kernel to cancel the socket transfer `request`, which
    # still finishes through `_finished_files`: cancelled, or with the bytes
    # it moved first.
    _cancel_transfer(request: ulong) {}

    # Moves the file and socket transfers finished since the last call to
    # `finished`: each task's id and its result (a byte count, or -1 minus
    # the error code, as `io._io_file_transfer_raw` returns).
    _finished_files(finished: Array<(task: ulong, result: long)>) {}

    # The doorbell that ends this driver's waits early, from any thread.
    _doorbell(): _Doorbell;

    # Releases the driver's system resources, the doorbell's included.
    _close();
}

# What a doorbell rings.
enum _DoorbellKind {
    EventFd,
    Kqueue,
    Iocp,
    Poll,
}

# Wakes a worker blocked in its driver, from any thread (see the notes at
# the top of this file). The driver that made it keeps its resources open
# until every worker has stopped, so a ring never reaches a closed handle.
[Shared]
struct _Doorbell {
    const _kind: _DoorbellKind;
    # The eventfd, kqueue or pipe's write end, or the sending UDP socket.
    const _descriptor: long;
    # The completion port (IOCP).
    const _port: __ptr<void>;
    # The address of the UDP socket a ring sends to (a sockaddr_in).
    const _address: __ptr<u8>;

    # An eventfd or kqueue doorbell: `descriptor` is rung.
    construct(kind: _DoorbellKind, descriptor: long) {
        _kind = kind;
        _descriptor = descriptor;
        _port = __null;
        _address = __null;
    }

    # An IOCP doorbell: a completion is posted to `port`.
    construct(port: __ptr<void>) {
        _kind = _DoorbellKind.Iocp;
        _descriptor = 0;
        _port = port;
        _address = __null;
    }

    # A poll doorbell: a byte is sent from `descriptor` to `address`.
    construct(descriptor: long, address: __ptr<u8>) {
        _kind = _DoorbellKind.Poll;
        _descriptor = descriptor;
        _port = __null;
        _address = address;
    }

    # Ends the worker's current wait, or its next one.
    _ring() {
        match (_kind) {
            EventFd => {
                _async_epoll_ring(_descriptor);
            }
            Kqueue => {
                _async_kqueue_ring(_descriptor);
            }
            Iocp => {
                _async_iocp_ring(_port);
            }
            Poll => {
                _async_poll_ring(_descriptor, _address);
            }
        }
    }
}

# The data word a driver gives its doorbell's registration, which no socket
# has.
_async_doorbell_key(): ulong {
    return ~(0 as ulong);
}

# The driver for `requested`, and the backend it is. Automatic takes
# PEPPER_IO_BACKEND if set, else the system's best, and falls back to poll
# when that cannot start.
_async_open_driver(requested: Backend): (_Driver, Backend) {
    var backend = requested;
    if (backend == Backend.Automatic) {
        backend = _async_backend_from_environment();
    }
    var automatic = backend == Backend.Automatic;
    if (automatic) {
        backend = _async_best_backend();
    }
    match (backend) {
        Epoll => {
            var epoll = _EpollDriver.open();
            if (epoll.is_value()) {
                return (epoll.value(), backend);
            }
        }
        IoUring => {
            var io_uring = _IoUringDriver.open();
            if (io_uring.is_value()) {
                return (io_uring.value(), backend);
            }
        }
        Kqueue => {
            var kqueue = _KqueueDriver.open();
            if (kqueue.is_value()) {
                return (kqueue.value(), backend);
            }
        }
        Iocp => {
            var iocp = _IocpDriver.open();
            if (iocp.is_value()) {
                return (iocp.value(), backend);
            }
        }
        Poll, Automatic => {
            return (_PollDriver(), Backend.Poll);
        }
    }
    assert(automatic, "async.run: the " + backend.name() + " I/O backend is not available on this system");
    return (_PollDriver(), Backend.Poll);
}

[Target(OS(Linux))]
_async_best_backend(): Backend {
    return Backend.Epoll;
}

[Target(OS(Mac))]
_async_best_backend(): Backend {
    return Backend.Kqueue;
}

[Target(OS(Windows))]
_async_best_backend(): Backend {
    return Backend.Iocp;
}

[Target(OS(Wasi))]
_async_best_backend(): Backend {
    return Backend.Poll;
}

extern char* getenv(char* name);

# PEPPER_IO_BACKEND as a backend: Automatic when unset.
# @panics when it names no backend
_async_backend_from_environment(): Backend {
    var name = "PEPPER_IO_BACKEND";
    var value = getenv(name.c_str());
    if (value == __null) {
        return Backend.Automatic;
    }
    match (String(value)) {
        "epoll" => {
            return Backend.Epoll;
        }
        "io_uring" => {
            return Backend.IoUring;
        }
        "kqueue" => {
            return Backend.Kqueue;
        }
        "iocp" => {
            return Backend.Iocp;
        }
        "poll" => {
            return Backend.Poll;
        }
        else => {}
    }
    panic("async.run: PEPPER_IO_BACKEND must be epoll, io_uring, kqueue, iocp or poll");
    return Backend.Automatic;
}

# The `io._IO_READABLE` and `io._IO_WRITABLE` bits a system event mask
# `events` allows: readable when it has any bit of `readable`, writable when
# it has any bit of `writable`.
_async_ready_mask(events: long, readable: long, writable: long): int {
    var ready = 0;
    if ((events & readable) != 0) {
        ready = ready | io._IO_READABLE;
    }
    if ((events & writable) != 0) {
        ready = ready | io._IO_WRITABLE;
    }
    return ready;
}
async/driver_epoll
8375
# The epoll I/O driver (Linux) for the task runtime; see driver.pep.
#
# A socket is registered once, edge-triggered, for both reading and writing
# (EPOLLIN | EPOLLOUT | EPOLLRDHUP | EPOLLET), the first time a task waits on
# it. Closing the socket removes it from the epoll set. The registration's
# data word is the socket, so an event names the socket it is for.
#
# struct epoll_event is { u32 events; u64 data; }: packed to 12 bytes on
# x86-64, 16 bytes with the data at offset 8 on AArch64. The system calls
# are [Target(OS(Linux))]; elsewhere `_async_epoll_create` fails, so the
# driver is unavailable.
#
# The doorbell is an eventfd registered like a socket, with
# `_async_doorbell_key()` as its data word; a ring writes 1 to it, and the
# poll that sees it reads it back to 0.

import io;
import "driver";
import "task";

[Target(OS(Linux))]
extern int epoll_create1(int flags);
[Target(OS(Linux))]
extern int epoll_ctl(int epoll, int operation, int descriptor, void* event);
[Target(OS(Linux))]
extern int epoll_wait(int epoll, void* events, int capacity, int timeout);
[Target(OS(Linux))]
extern int close(int descriptor);
[Target(OS(Linux))]
extern int eventfd(uint initial, int flags);
[Target(OS(Linux))]
extern long read(int fd, void* buf, ulong n);
[Target(OS(Linux))]
extern long write(int fd, void* buf, ulong n);

[Target(OS(Linux) && Arch(x64))]
const _EPOLL_EVENT_SIZE = 12;
[Target(OS(Linux) && Arch(x64))]
const _EPOLL_DATA_OFFSET = 4;
[Target(OS(Linux) && Arch(aarch64))]
const _EPOLL_EVENT_SIZE = 16;
[Target(OS(Linux) && Arch(aarch64))]
const _EPOLL_DATA_OFFSET = 8;

# EPOLLIN | EPOLLOUT | EPOLLRDHUP | EPOLLET.
[Target(OS(Linux))]
const _EPOLL_INTEREST: uint = 2147491845;
# Events that let a reader make progress: EPOLLIN, EPOLLERR, EPOLLHUP,
# EPOLLRDHUP. A writer: EPOLLOUT, EPOLLERR, EPOLLHUP.
[Target(OS(Linux))]
const _EPOLL_READABLE_EVENTS: uint = 8217;
[Target(OS(Linux))]
const _EPOLL_WRITABLE_EVENTS: uint = 28;

# The most events one poll returns.
const _EPOLL_CAPACITY = 256;

# A worker's epoll instance.
struct _EpollDriver {
    var _epoll: long;
    # Room for `_EPOLL_CAPACITY` events.
    var _events: __ptr<u8>;
    # The doorbell's eventfd.
    var _bell: long;

    construct(epoll: long, bell: long) {
        this._epoll = epoll;
        this._bell = bell;
        this._events = _async_epoll_events();
    }

    # A new driver, or none when the system has no epoll.
    static open(): _EpollDriver? {
        var epoll = _async_epoll_create();
        if (epoll < 0) {
            return Optional<_EpollDriver>.Empty;
        }
        var bell = _async_epoll_create_bell(epoll);
        if (bell < 0) {
            _async_epoll_close(epoll);
            return Optional<_EpollDriver>.Empty;
        }
        return Optional<_EpollDriver>.Value(_EpollDriver(epoll, bell));
    }
}

extend _EpollDriver with _Driver {
    _watch(handle: io.SocketHandle): bool {
        return _async_epoll_add(this._epoll, handle);
    }

    _poll(waits: HashMap<ulong, _SocketWaits>, timeout: long, ready_sockets: Array<(handle: ulong, interest: int)>) {
        var count = _async_epoll_wait(this._epoll, this._events, timeout);
        var i: ulong = 0;
        while (i < count) {
            var handle = _async_epoll_event_handle(this._events, i);
            if (handle == _async_doorbell_key()) {
                _async_epoll_drain(this._bell);
            } else {
                ready_sockets.append((handle, _async_epoll_event_interest(this._events, i)));
            }
            i = i + 1;
        }
    }

    _want(handle: io.SocketHandle, interest: int): bool {
        return true;
    }

    _forget(handle: io.SocketHandle) {}

    _release(handle: io.SocketHandle) {
        _async_epoll_remove(this._epoll, handle);
    }

    _doorbell(): _Doorbell {
        return _Doorbell(_DoorbellKind.EventFd, this._bell);
    }

    _close() {
        _async_epoll_close(this._bell);
        _async_epoll_close(this._epoll);
        _pep_free(this._events);
    }
}

# A new epoll instance (close-on-exec), or -1.
[Target(OS(Linux))]
_async_epoll_create(): long {
    return epoll_create1(524288) as long;  # EPOLL_CLOEXEC
}

[Target(OS(Linux))]
_async_epoll_close(epoll: long) {
    close(epoll as int);
}

[Target(OS(Linux))]
_async_epoll_events(): __ptr<u8> {
    return _pep_malloc((_EPOLL_CAPACITY * _EPOLL_EVENT_SIZE) as ulong);
}

# Watches `handle` for both reading and writing until it is closed; false
# for a descriptor epoll cannot watch.
[Target(OS(Linux))]
_async_epoll_add(epoll: long, handle: io.SocketHandle): bool {
    __ptr<u8> event = _pep_malloc(16);
    unsafe_cast<__ptr<uint>>(event)[0] = _EPOLL_INTEREST;
    unsafe_cast<__ptr<ulong>>(event + _EPOLL_DATA_OFFSET)[0] = handle as ulong;
    var rc = epoll_ctl(epoll as int, 1, handle, event);  # EPOLL_CTL_ADD
    _pep_free(event);
    return rc == 0;
}

# Stops watching `handle`.
[Target(OS(Linux))]
_async_epoll_remove(epoll: long, handle: io.SocketHandle) {
    __ptr<u8> event = _pep_malloc(16);          # ignored, but not null for kernels before 2.6.9
    epoll_ctl(epoll as int, 2, handle, event);  # EPOLL_CTL_DEL
    _pep_free(event);
}

# A non-blocking eventfd watched by `epoll` under the doorbell key, or -1.
[Target(OS(Linux))]
_async_epoll_create_bell(epoll: long): long {
    var bell = eventfd(0, 526336);  # EFD_NONBLOCK | EFD_CLOEXEC
    if (bell < 0) {
        return -1;
    }
    __ptr<u8> event = _pep_malloc(16);
    unsafe_cast<__ptr<uint>>(event)[0] = _EPOLL_INTEREST;
    unsafe_cast<__ptr<ulong>>(event + _EPOLL_DATA_OFFSET)[0] = _async_doorbell_key();
    var rc = epoll_ctl(epoll as int, 1, bell, event);  # EPOLL_CTL_ADD
    _pep_free(event);
    if (rc != 0) {
        close(bell);
        return -1;
    }
    return bell as long;
}

# Rings the doorbell eventfd `bell`.
[Target(OS(Linux))]
_async_epoll_ring(bell: long) {
    __ptr<ulong> one = _pep_malloc(8);
    one[0] = 1;
    write(bell as int, one, 8);
    _pep_free(one);
}

# Resets the doorbell eventfd `bell` to 0. The io_uring driver's doorbell is
# an eventfd too, and drains with this.
[Target(OS(Linux))]
_async_epoll_drain(bell: long) {
    __ptr<ulong> value = _pep_malloc(8);
    read(bell as int, value, 8);
    _pep_free(value);
}

# Waits up to `timeout` milliseconds (forever when negative) and returns how
# many events it stored; 0 on a timeout or a signal.
[Target(OS(Linux))]
_async_epoll_wait(epoll: long, events: __ptr<u8>, timeout: long): ulong {
    var count = epoll_wait(epoll as int, events, _EPOLL_CAPACITY, timeout as int);
    if (count < 0) {
        return 0;
    }
    return count as ulong;
}

[Target(OS(Linux))]
_async_epoll_event_handle(events: __ptr<u8>, index: ulong): ulong {
    var event = events + index * (_EPOLL_EVENT_SIZE as ulong);
    return unsafe_cast<__ptr<ulong>>(event + _EPOLL_DATA_OFFSET)[0];
}

[Target(OS(Linux))]
_async_epoll_event_interest(events: __ptr<u8>, index: ulong): int {
    var event = events + index * (_EPOLL_EVENT_SIZE as ulong);
    var bits = unsafe_cast<__ptr<uint>>(event)[0];
    return _async_ready_mask(bits, _EPOLL_READABLE_EVENTS, _EPOLL_WRITABLE_EVENTS);
}

# Elsewhere there is no epoll.

[Target(!OS(Linux))]
