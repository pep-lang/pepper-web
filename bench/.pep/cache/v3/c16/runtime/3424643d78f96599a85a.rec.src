## `float` values sort by value, with NaN after every number.
export extend float with Comparable {
    ## Returns the order of this value and `other` in a total order: by
    ## value, with NaN after every number and equal to every NaN, and
    ## `-0.0` equal to `0.0`.
    ##
    ## @param other the value to compare with
    ## @returns -1, 0 or 1 as this value sorts before, with or after `other`
    ## @example
    ##     var nan = (0.0 / 0.0) as float;
    ##     assert((1.0 as float).compare(nan) < 0, "NaN sorts last");
    ##     assert(nan.compare(nan) == 0, "NaNs sort together");
    compare(other: float): int {
        if (this < other) {
            return -1;
        }
        if (this > other) {
            return 1;
        }
        if (this == other) {
            return 0;
        }
        # One or both are NaN, the only value not equal to itself.
        var nan = this != this;
        if (nan == (other != other)) {
            return 0;
        }
        return nan ? 1 : -1;
    }
}

## `double` values sort by value, with NaN after every number.
export extend double with Comparable {
    ## Returns the order of this value and `other` in a total order: by
    ## value, with NaN after every number and equal to every NaN, and
    ## `-0.0` equal to `0.0`.
    ##
    ## @param other the value to compare with
    ## @returns -1, 0 or 1 as this value sorts before, with or after `other`
    ## @example
    ##     var nan = 0.0 / 0.0;
    ##     assert((1.0).compare(nan) < 0, "NaN sorts last");
    ##     assert(nan.compare(nan) == 0, "NaNs sort together");
    compare(other: double): int {
        if (this < other) {
            return -1;
        }
        if (this > other) {
            return 1;
        }
        if (this == other) {
            return 0;
        }
        # One or both are NaN, the only value not equal to itself.
        var nan = this != this;
        if (nan == (other != other)) {
            return 0;
        }
        return nan ? 1 : -1;
    }
}

## Arrays of `Comparable` elements sort in the elements' own order.
export extend Array<T: Comparable> {
    ## Sorts the elements in place into their own order, `compare`: by value
    ## for numbers (NaN last), by content for `String`. The sort is stable
    ## and otherwise behaves like `sort(compare)`.
    ##
    ## @panics if comparing modifies the Array ("Array modified during sort")
    ## @example
    ##     var numbers = [3, 1, 2];
    ##     numbers.sort();   # [1, 2, 3]
    sort() {
        _merge_sort((a, b) => a.compare(b));
    }
}
compress/checksum
