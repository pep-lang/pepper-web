## The HTTP server: `Server` accepts HTTP/1.1 and HTTP/2 connections on
## every worker of `async.run` and answers each request with a handler
## function.

import async;
import io;
import tls;
import "h2";
import "message";
import "wire";

## The largest request body a `Server` reads: 16 MiB. A larger one gets
## `413 Content Too Large`.
export const MAX_REQUEST_BODY: ulong = 16777216;

## An HTTP/1.1 and HTTP/2 server.
##
## `Server.bind` listens on an address (`Server.bind_tls` serves HTTPS);
## `serve` then accepts connections on every worker of the running
## `async.run` and serves each connection in a task of its own, calling the
## handler for every request. Connections are kept open between requests
## unless the client asks to close (or speaks HTTP/1.0).
##
## The handler gets the `Request` with its body read in full and returns the
## `Response`; the server adds `Content-Length` (and `Connection: close`
## when it will close). A request the server cannot parse gets `400 Bad
## Request`, one with header fields over 64 KiB `431 Request Header Fields
## Too Large`, and one with a body over `MAX_REQUEST_BODY` `413 Content Too
## Large`; the connection then closes. A response whose reason phrase or
## field value holds CR, LF or NUL, or whose field name is not an RFC 9110
## token, is sent as `500 Internal Server Error` instead, since those
## characters would split the response; the 500's text body names the
## field (or the reason phrase) at fault.
##
## HTTP/2 is served to a client that chooses it through ALPN (see
## `bind_tls`) or that starts a plain TCP connection with the HTTP/2
## preface (prior knowledge): each stream is a request, answered by the same
## handler in a task of its own.
##
## @example
##     import async;
##     import http;
##     import io;
##
##     hello(request: http.Request): http.Response {
##         var response = http.Response(200).set_text("hello from " + request.path());
##         response.headers["Content-Type"] = "text/plain";
##         return response;
##     }
##
##     main(): int {
##         async.run(() => {
##             var server = http.Server.bind(io.SocketAddress.parse("0.0.0.0:8080").value()).value();
##             server.serve(hello);
##         });
##         return 0;
##     }
[Shared]
export struct Server {
    # The listening socket, and for HTTPS (`_secure`) the certificate.
    const _listener: io.SharedTcpListener;
    const _secure: bool;
    const _acceptor: tls.TlsAcceptor;

    ## Wraps a listening socket. Use `Server.bind` or `Server.bind_tls`.
    ##
    ## @param listener the listening socket
    ## @param secure whether to serve HTTPS with `acceptor`
    ## @param acceptor the certificate for HTTPS; ignored for HTTP
    construct(listener: io.SharedTcpListener, secure: bool, acceptor: tls.TlsAcceptor) {
        _listener = listener;
        _secure = secure;
        _acceptor = acceptor;
    }

    ## Listens for HTTP connections on `address`.
    ##
    ## @param address the local address (port 0 for any free port)
    ## @returns the server; the errors of `io.TcpListener.bind`
    static bind(address: io.SocketAddress): io.IoResult<Server> {
        var listener = io.SharedTcpListener.bind(address);
        if (listener.is_err()) {
            return io.IoResult<Server>.err(listener.error());
        }
        return io.IoResult<Server>.ok(Server(listener.value(), false, tls.TlsAcceptor(__null)));
    }

    ## Listens for HTTPS connections on `address`, presenting `acceptor`'s
    ## certificate. It sets the acceptor's ALPN protocols to `h2` and
    ## `http/1.1`, so clients that offer HTTP/2 get it.
    ##
    ## @param address the local address (port 0 for any free port)
    ## @param acceptor the certificate and key to serve with
    ## @returns the server; the errors of `io.TcpListener.bind`
    static bind_tls(address: io.SocketAddress, acceptor: tls.TlsAcceptor): io.IoResult<Server> {
        var listener = io.SharedTcpListener.bind(address);
        if (listener.is_err()) {
            return io.IoResult<Server>.err(listener.error());
        }
        acceptor.set_protocols(["h2", "http/1.1"]);
        return io.IoResult<Server>.ok(Server(listener.value(), true, acceptor));
    }

    ## Returns the address the server listens on, with the port the system
    ## chose for port 0.
    ##
    ## @returns the local address, or a platform error
    local_address(): io.IoResult<io.SocketAddress> {
        return _listener.local_address();
    }

    ## Serves connections until the task is cancelled (when `async.run`
    ## ends): accepts on every worker and serves each connection in a task
    ## on the worker that accepted it.
    ##
    ## @param handler answers one request; it runs in the connection's task,
    ##   so it may wait (on sockets, files, locks) without holding up other
    ##   connections
    ## @panics outside `async.run`
    serve(handler: shared (Request) => Response) {
        var server = this;
        var loops = async.spawn_on_each_worker(() => {
            while (true) {
                var accepted = server._listener.accept();
                if (accepted.is_err()) {
                    return;
                }
                var (tcp, peer) = accepted.value();
                async.Task<void>.spawn_local(() => {
                    _http_serve_connection(server, tcp, handler);
                });
            }
        });
        for (var loop in loops) {
            loop.join();
        }
    }
}

# Serves one connection until it closes, fails, or asks to close.
_http_serve_connection(server: Server, tcp: io.TcpStream, handler: shared (Request) => Response) {
    var connection = _HttpConnection(tcp);
    if (server._secure) {
        var stream = server._acceptor.accept(tcp);
        if (stream.is_err()) {
            tcp.close();
            return;
        }
        connection._use_tls(stream.value());
    }
    var reader = _HttpReader(connection);
    var chosen = connection._tls.is_value() ? connection._tls.value().protocol() : Optional<String>.Empty;
    if (chosen.is_value() && chosen.value() == "h2") {
        # HTTP/2 through ALPN: the client's preface comes first.
        var first = reader._line(_HTTP_MAX_LINE);
        if (first.is_ok() && first.value().is_value() && first.value().value() == "PRI * HTTP/2.0") {
            if (_http_finish_preface(reader)) {
                _h2_serve(reader, handler);
            }
        }
        connection._close();
        return;
    }
    while (true) {
        if (!_http_serve_one(reader, handler)) {
            break;
        }
    }
    connection._close();
}

# Reads one request and answers it; whether to keep the connection.
_http_serve_one(reader: _HttpReader, handler: shared (Request) => Response): bool {
    var first = reader._line(_HTTP_MAX_LINE);
    if (first.is_err()) {
        _http_refuse(reader, 400);
        return false;
    }
    if (first.value().is_empty()) {
        return false;  # the client closed between requests
    }
    var line = first.value().value();
    if (line == "PRI * HTTP/2.0") {
        # HTTP/2 with prior knowledge (h2c): the rest of the preface.
        if (_http_finish_preface(reader)) {
            _h2_serve(reader, handler);
        }
        return false;
    }
    # METHOD SP target SP HTTP/1.x
    var space = line.find(" ");
    var last = _http_last_space(line);
    if (space <= 0
        || last <= space
        || !line.substr_bytes(last as ulong + 1, line.size - last as ulong - 1).starts_with("HTTP/1.")) {
        _http_refuse(reader, 400);
        return false;
    }
    var method = line.substr_bytes(0, space as ulong);
    var target = line.substr_bytes(space as ulong + 1, (last - space - 1) as ulong);
    var version = line.substr_bytes(last as ulong + 1, line.size - last as ulong - 1);
    var request = Request(method, target);
    request._upgradable = version == "HTTP/1.1";
    var fields = _http_read_headers(reader, request.headers);
    if (fields.is_err()) {
        if (fields.error().code == _http_code_too_large()) {
            _http_refuse(reader, 431);
        } else {
            _http_refuse(reader, 400);
        }
        return false;
    }
    var keep = version == "HTTP/1.1";
    var connection_field = request.headers.get("Connection");
    if (connection_field.is_value()) {
        if (_http_contains_token(connection_field.value(), "close")) {
            keep = false;
        } else if (_http_contains_token(connection_field.value(), "keep-alive")) {
            keep = true;
        }
    }
    var expect = request.headers.get("Expect");
    if (expect.is_value()) {
        if (expect.value().lower() == "100-continue") {
            var go_on = Array<u8>();
            _http_append(go_on, "HTTP/1.1 100 Continue\r\n\r\n");
            reader._connection._write_all(go_on);
        }
    }
    var body = _http_read_body(reader, request.headers, request._body, MAX_REQUEST_BODY);
    if (body.is_err()) {
        if (body.error().code == _http_code_too_large()) {
            _http_refuse(reader, 413);
        } else {
            _http_refuse(reader, 400);
        }
        return false;
    }
    var response = _http_sendable(handler(request));
    if (response._upgrade && !request._upgradable) {
        response = Response(501);  # HTTP/1.0 cannot switch protocols
    }
    var sent = _http_send_response(reader._connection, response, method == "HEAD", keep, version == "HTTP/1.1");
    if (response._upgrade) {
        if (sent) {
            response._takeover(Connection(reader));
        }
        return false;
    }
    return keep && sent;
}

# Reads the rest of the HTTP/2 client preface after its first line: an
# empty line, `SM`, and another empty line. Whether it was all there.
_http_finish_preface(reader: _HttpReader): bool {
    for (var expected in ["", "SM", ""]) {
        var line = reader._line(4);
        if (line.is_err() || line.value().is_empty() || line.value().value() != expected) {
            return false;
        }
    }
    return true;
}

# The position of the last space in `line`, or -1.
_http_last_space(line: String): long {
    var p = unsafe_cast<__ptr<u8>>(line.c_str());
    var i = line.size;
    while (i > 0) {
        i = i - 1;
        if (p[i] == ' ') {
            return i as long;
        }
    }
    return -1;
}

# `response`, or a 500 when its reason phrase or a field cannot be sent as
# it is: a CR or LF there would split the response. The 500's body says
# which, so the handler's author sees it without a server log.
_http_sendable(response: Response): Response {
    var bad = _http_is_field_value(response.reason) ?
        _http_bad_fields(response.headers) :
        Optional<String>.Value("the reason phrase holds CR, LF or NUL");
    if (bad.is_value()) {
        return Response(500).set_text($"the response cannot be sent: {bad.value()}");
    }
    return response;
}

# Answers a request the server will not serve, and closes.
_http_refuse(reader: _HttpReader, status: int) {
    _http_send_response(reader._connection, Response(status), false, false, true);
}

# Writes `response`; whether the connection can serve another request. A
# streamed body of unknown length goes chunked when `chunked` (HTTP/1.1),
# and otherwise unframed, ending the connection.
_http_send_response(connection: _HttpConnection, response: Response, head: bool, keep: bool, chunked: bool): bool {
    var headers = Headers();
    for (var name in response.headers.names()) {
        match (name) {
            "content-length", "transfer-encoding", "connection" => {}
            else => {
                for (var value in response.headers.values(name)) {
                    headers.add(name, value);
                }
            }
        }
    }
    var status = response.status;
    if (response._upgrade) {
        headers.add("Connection", "Upgrade");
        var upgrade = Array<u8>();
        _http_write_head(upgrade, "HTTP/1.1 101 Switching Protocols", headers);
        return connection._write_all(upgrade).is_ok();
    }
    var bodiless = status < 200 || status == 204 || status == 304;
    var streamed = response._streamed && !bodiless;
    if (streamed) {
        if (response._length >= 0) {
            headers.add("Content-Length", to_string(response._length));
        } else if (chunked) {
            headers.add("Transfer-Encoding", "chunked");
        } else {
            keep = false;  # the end of the connection ends the body
        }
    } else if (!bodiless) {
        headers.add("Content-Length", to_string(response._body.count));
    }
    if (!keep) {
        headers.add("Connection", "close");
    }
    var reason = response.reason;
    if (reason.size == 0) {
        reason = reason_phrase(status);
    }
    var out = Array<u8>();
    _http_write_head(out, $"HTTP/1.1 {status} {reason}", headers);
    if (!head && !bodiless && !streamed) {
        out.append_all(response._body);
    }
    if (connection._write_all(out).is_err()) {
        return false;
    }
    if (streamed && !head) {
        if (_http_write_stream(connection, response._source, response._length, chunked).is_err()) {
            return false;
        }
    }
    return keep;
}

## A connection a `Server` handler took over by answering with
## `Response.upgrade`: the raw stream after the `101 Switching Protocols`
## head, TCP or (under `Server.bind_tls`) TLS, as an `io.Reader` and an
## `io.Writer`.
##
## Reads return first the bytes the server had already read past the
## request (a client may send its first message right after the request),
## then what arrives. Like the handler, it belongs to the connection's task.
##
## @example
##     upgraded(request: http.Request): http.Response {
##         return http.Response().upgrade("echo", (connection) => {
##             var data = Array<u8>();
##             while (connection.read(data, 4096).value() > 0) {
##                 connection.write_all(data);
##                 data.clear();
##             }
##         });
##     }
export struct Connection {
    # The connection's reader, holding the bytes read past the request.
    var _reader: _HttpReader;

    ## Wraps the connection `reader` reads. The server makes one for
    ## `Response.upgrade`.
    ##
    ## @param reader the connection and the bytes it buffered
    construct(reader: _HttpReader) {
        this._reader = reader;
    }

    ## Waits until some bytes are available, then appends up to `max` of
    ## them to `buffer`: the ones buffered past the request first.
    ##
    ## @param buffer the array the bytes are appended to
    ## @param max the most bytes to read
    ## @returns the number of bytes appended, 0 at the end of the stream; an
    ##   error when the stream fails
    read(buffer: u8[], max: ulong): io.IoResult<ulong> {
        return this._reader._some(buffer, max);
    }

    ## Writes what the stream takes in one call, which may be less than all
    ## of `data`.
    ##
    ## @param data the bytes to write
    ## @returns the number of bytes written; an error when the stream fails
    write(data: u8[]): io.IoResult<ulong> {
        return this._reader._connection._writer.write(data);
    }

    ## Writes all of `data`.
    ##
    ## @param data the bytes to write
    ## @returns an Ok result once every byte is written; an error when the
    ##   stream fails
    write_all(data: u8[]): io.IoResult<void> {
        return this._reader._connection._write_all(data);
    }

    ## Closes the connection, sending TLS close_notify first under TLS. The
    ## server also closes it when the `takeover` function returns; closing
    ## again does nothing.
    close() {
        this._reader._connection._close();
    }
}

extend Connection with io.Reader;

extend Connection with io.Writer;

## Returns the standard reason phrase for an HTTP status code.
##
## @param status the status code
## @returns the phrase, such as `Not Found` for 404; an empty string for a
##   code without one
export reason_phrase(status: int): String {
    return match (status) {
        100 => "Continue",
        101 => "Switching Protocols",
        200 => "OK",
        201 => "Created",
        202 => "Accepted",
        204 => "No Content",
        206 => "Partial Content",
        301 => "Moved Permanently",
        302 => "Found",
        303 => "See Other",
        304 => "Not Modified",
        307 => "Temporary Redirect",
        308 => "Permanent Redirect",
        400 => "Bad Request",
        401 => "Unauthorized",
        403 => "Forbidden",
        404 => "Not Found",
        405 => "Method Not Allowed",
        408 => "Request Timeout",
        409 => "Conflict",
        410 => "Gone",
        413 => "Content Too Large",
        415 => "Unsupported Media Type",
        429 => "Too Many Requests",
        431 => "Request Header Fields Too Large",
        500 => "Internal Server Error",
        501 => "Not Implemented",
        502 => "Bad Gateway",
        503 => "Service Unavailable",
        504 => "Gateway Timeout",
        else => "",
    };
}
http/wire
17195
# HTTP/1.1 on the wire, shared by the client and the server: a connection
# that reads and writes a TcpStream or a TlsStream, a buffered reader over it, header and
# body parsing (Content-Length, chunked), and writing a message
# head.

import io;
import text;
import tls;
import "message";

# The most bytes a request or status line, or all the header fields of one
# message, may take.
const _HTTP_MAX_LINE: ulong = 8192;
const _HTTP_MAX_HEAD: ulong = 65536;

# EPROTO (ERROR_INVALID_DATA on Windows): the code of every HTTP error.
[Target(OS(Linux))]
_http_code_protocol(): io.ErrorCode { return 71; }

[Target(OS(Mac))]
_http_code_protocol(): io.ErrorCode { return 100; }

[Target(OS(Windows))]
_http_code_protocol(): io.ErrorCode { return 13; }

[Target(OS(Wasi))]
_http_code_protocol(): io.ErrorCode { return 65; }

_http_error(message: String): io.IoError {
    return io.IoError(_http_code_protocol(), message);
}

# EMSGSIZE (WSAEMSGSIZE on Windows): a message too large to accept, which a
# server answers with 431 (the head) or 413 (the body) rather than 400.
[Target(OS(Linux))]
_http_code_too_large(): io.ErrorCode { return 90; }

[Target(OS(Mac))]
_http_code_too_large(): io.ErrorCode { return 40; }

[Target(OS(Windows))]
_http_code_too_large(): io.ErrorCode { return 10040; }

[Target(OS(Wasi))]
_http_code_too_large(): io.ErrorCode { return 35; }

_http_too_large(message: String): io.IoError {
    return io.IoError(_http_code_too_large(), message);
}

# One connection: plain TCP, or TLS over it. Reads and writes go through
# `_reader` and `_writer`, which are the TLS stream once `_use_tls` is called
# and the TCP stream before.
struct _HttpConnection {
    var _tcp: io.TcpStream;
    var _tls: tls.TlsStream?;
    var _reader: io.Reader;
    var _writer: io.Writer;
    var _closed: bool;

    construct(tcp: io.TcpStream) {
        this._closed = false;
        this._tcp = tcp;
        this._tls = Optional<tls.TlsStream>.Empty;
        this._reader = tcp;
        this._writer = tcp;
    }

    # Reads and writes through `stream`, a TLS session over `_tcp`.
    _use_tls(stream: tls.TlsStream) {
        this._tls = Optional<tls.TlsStream>.Value(stream);
        this._reader = stream;
        this._writer = stream;
    }

    _read(buffer: u8[], max: ulong): io.IoResult<ulong> {
        return this._reader.read(buffer, max);
    }

    _write_all(data: u8[]): io.IoResult<void> {
        return this._writer.write_all(data);
    }

    # Ends the connection: close_notify over TLS, then the socket. Again,
    # it does nothing.
    _close() {
        if (this._closed) {
            return;
        }
        this._closed = true;
        if (this._tls.is_value()) {
            this._tls.value().shutdown();
            this._tls.value().close();
        }
        this._tcp.close();
    }
}

# Reads lines and byte runs from a connection, keeping what arrived beyond
# them for the next read.
struct _HttpReader {
    var _connection: _HttpConnection;
    # Bytes read but not consumed start at `_start`.
    var _buffer: u8[];
    var _start: ulong;

    construct(connection: _HttpConnection) {
        this._connection = connection;
        this._buffer = Array<u8>();
        this._start = 0;
    }

    _available(): ulong {
        return this._buffer.count - this._start;
    }

    # Reads more bytes; 0 at the end of the stream.
    _fill(): io.IoResult<ulong> {
        if (this._start > 0 && this._start == this._buffer.count) {
            this._buffer.clear();
            this._start = 0;
        }
        return this._connection._read(this._buffer, 16384);
    }

    # The next line without its CRLF (or LF). Empty when the stream ends
    # before any byte of it; an error when it ends mid-line or the line is
    # longer than `limit`.
    _line(limit: ulong): io.IoResult<String?> {
        ulong scanned = 0;
        while (true) {
            var p = this._buffer._data;
            while (scanned < this._available()) {
                if (p[this._start + scanned] == '\n') {
                    var end = scanned;
                    if (end > 0) {
                        if (p[this._start + end - 1] == '\r') {
                            end = end - 1;
                        }
                    }
                    var line = _http_line_text(p + this._start, end);
                    this._start = this._start + scanned + 1;
                    return io.IoResult<String?>.ok(Optional<String>.Value(line));
                }
                scanned = scanned + 1;
            }
            if (scanned > limit) {
                return io.IoResult<String?>.err(_http_error("line too long"));
            }
            var got = this._fill();
            if (got.is_err()) {
                return io.IoResult<String?>.err(got.error());
            }
            if (got.value() == 0) {
                if (this._available() == 0) {
                    return io.IoResult<String?>.ok(Optional<String>.Empty);
                }
                return io.IoResult<String?>.err(_http_error("the connection closed in the middle of a line"));
            }
        }
        return io.IoResult<String?>.ok(Optional<String>.Empty);
    }

    # A line that must be there.
    _required_line(limit: ulong): io.IoResult<String> {
        var line = this._line(limit);
        if (line.is_err()) {
            return io.IoResult<String>.err(line.error());
        }
        if (line.value().is_empty()) {
            return io.IoResult<String>.err(_http_error("the connection closed early"));
        }
        return io.IoResult<String>.ok(line.value().value());
    }

    # Appends exactly `count` bytes to `into`.
    _bytes(into: u8[], count: ulong): io.IoResult<void> {
        ulong left = count;
        while (left > 0) {
            if (this._available() == 0) {
                var got = this._fill();
                if (got.is_err()) {
                    return io.IoResult<void>.err(got.error());
                }
                if (got.value() == 0) {
                    return io.IoResult<void>.err(_http_error("the connection closed before the whole body arrived"));
                }
            }
            var take = this._available();
            if (take > left) {
                take = left;
            }
            into._append_raw(this._buffer._data + this._start, take);
            this._start = this._start + take;
            left = left - take;
        }
        return io.IoResult<void>.ok();
    }

    # Appends up to `max` bytes to `into`: what is buffered, or else what
    # one read of the connection gives. 0 at the end of the stream.
    _some(into: u8[], max: ulong): io.IoResult<ulong> {
        var take = this._available();
        if (take == 0) {
            if (this._start > 0) {
                this._buffer.clear();
                this._start = 0;
            }
            return this._connection._read(into, max);
        }
        if (take > max) {
            take = max;
        }
        into._append_raw(this._buffer._data + this._start, take);
        this._start = this._start + take;
        return io.IoResult<ulong>.ok(take);
    }
}

# Reads header fields up to the empty line into `headers`.
_http_read_headers(reader: _HttpReader, headers: Headers): io.IoResult<void> {
    ulong total = 0;
    while (true) {
        var read = reader._required_line(_HTTP_MAX_LINE);
        if (read.is_err()) {
            return io.IoResult<void>.err(read.error());
        }
        var line = read.value();
        if (line.size == 0) {
            return io.IoResult<void>.ok();
        }
        total = total + line.size;
        if (total > _HTTP_MAX_HEAD) {
            return io.IoResult<void>.err(_http_too_large("the header fields are too large"));
        }
        var colon = line.find(":");
        if (colon <= 0) {
            return io.IoResult<void>.err(_http_error($"a header field has no name: '{line}'"));
        }
        var name = line.substr_bytes(0, colon as ulong);
        var value = line.substr_bytes(colon as ulong + 1, line.size - colon as ulong - 1).trim();
        headers.add(name, value);
    }
    return io.IoResult<void>.ok();
}

# Reads a request body framed by `headers` into `into`: chunked or
# Content-Length; nothing otherwise.
_http_read_body(reader: _HttpReader, headers: Headers, into: u8[], limit: ulong): io.IoResult<void> {
    var encoding = headers.get("Transfer-Encoding");
    if (encoding.is_value()) {
        if (_http_contains_token(encoding.value(), "chunked")) {
            return _http_read_chunked(reader, into, limit);
        }
    }
    var length = headers.get("Content-Length");
    if (length.is_value()) {
        var n = _http_parse_decimal(length.value());
        if (n < 0) {
            return io.IoResult<void>.err(_http_error($"invalid Content-Length: '{length.value()}'"));
        }
        if (n as ulong > limit) {
            return io.IoResult<void>.err(_http_too_large("the body is too large"));
        }
        return reader._bytes(into, n as ulong);
    }
    return io.IoResult<void>.ok();
}

# A chunked body: hex size lines, data, and a trailer section.
_http_read_chunked(reader: _HttpReader, into: u8[], limit: ulong): io.IoResult<void> {
    while (true) {
        var read = reader._required_line(_HTTP_MAX_LINE);
        if (read.is_err()) {
            return io.IoResult<void>.err(read.error());
        }
        var line = read.value();
        var semicolon = line.find(";");
        if (semicolon >= 0) {
            line = line.substr_bytes(0, semicolon as ulong);
        }
        var size = _http_parse_hex(line.trim());
        if (size < 0) {
            return io.IoResult<void>.err(_http_error($"invalid chunk size: '{line}'"));
        }
        if (size == 0) {
            # The trailer fields, which are dropped.
            return _http_read_headers(reader, Headers());
        }
        if (into.count + size as ulong > limit) {
            return io.IoResult<void>.err(_http_too_large("the body is too large"));
        }
        var data = reader._bytes(into, size as ulong);
        if (data.is_err()) {
            return data;
        }
        var end = reader._required_line(2);
        if (end.is_err()) {
            return io.IoResult<void>.err(end.error());
        }
    }
    return io.IoResult<void>.ok();
}

# Writes the body `source` gives to `connection`: exactly `length` bytes, or
# when `length` is -1 everything to its end, as chunks when `chunked` and
# unframed otherwise.
_http_write_stream(connection: _HttpConnection, source: io.Reader, length: long, chunked: bool): io.IoResult<void> {
    ulong left = 0;
    if (length >= 0) {
        left = length as ulong;
    }
    var data = Array<u8>(65536);
    while (length < 0 || left > 0) {
        data.clear();
        var want: ulong = 65536;
        if (length >= 0 && left < want) {
            want = left;
        }
        var read = source.read(data, want);
        if (read.is_err()) {
            return io.IoResult<void>.err(read.error());
        }
        var got = read.value();
        if (got == 0) {
            if (length >= 0) {
                return io.IoResult<void>.err(_http_error("the body ended before its Content-Length"));
            }
            break;
        }
        if (length >= 0) {
            left = left - got;
        }
        if (length < 0 && chunked) {
            var framed = Array<u8>(got + 16);
            _http_append(framed, $"{got:x}\r\n");
            framed.append_all(data);
            _http_append(framed, "\r\n");
            var sent = connection._write_all(framed);
            if (sent.is_err()) {
                return sent;
            }
        } else {
            var sent = connection._write_all(data);
            if (sent.is_err()) {
                return sent;
            }
        }
    }
    if (length < 0 && chunked) {
        var end = Array<u8>();
        _http_append(end, "0\r\n\r\n");
        return connection._write_all(end);
    }
    return io.IoResult<void>.ok();
}

# Why `headers` cannot be sent, or none: a field name that is not a token,
# or a value with CR, LF or NUL, would let it add fields or end the head
# (RFC 9110 §5.1, §5.5).
# It reads the fields in place: `names()` and `values()` would copy them.
_http_bad_fields(headers: Headers): String? {
    for (var (name, values) in headers._fields) {
        if (!_http_is_token(name)) {
            # Not quoted: a server's 500 shows this text, and the name may
            # come from the request.
            return Optional<String>.Value("a field name is not a token");
        }
        for (var value in values) {
            if (!_http_is_field_value(value)) {
                return Optional<String>.Value($"the value of the field '{name}' holds CR, LF or NUL");
            }
        }
    }
    return Optional<String>.Empty;
}

# Whether `text` is an RFC 9110 token: one or more letters, digits and
# "!#$%&'*+-.^_`|~".
_http_is_token(text: String): bool {
    if (text.size == 0) {
        return false;
    }
    ulong i = 0;
    while (i < text.size) {
        var c = text.byte_at(i);
        var alphanumeric = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9');
        if (!alphanumeric && (c >= 128 || !"!#$%&'*+-.^_`|~".contains(text.substr_bytes(i, 1)))) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

# Whether `text` can be sent as a field value or reason phrase: it has no
# CR, LF or NUL.
_http_is_field_value(text: String): bool {
    ulong i = 0;
    while (i < text.size) {
        var c = text.byte_at(i);
        if (c == 0 || c == '\r' || c == '\n') {
            return false;
        }
        i = i + 1;
    }
    return true;
}

# Appends a start line, the fields and the empty line to `out`.
_http_write_head(out: u8[], start: String, headers: Headers) {
    _http_append(out, start);
    _http_append(out, "\r\n");
    for (var name in headers.names()) {
        for (var value in headers.values(name)) {
            _http_append(out, name);
            _http_append(out, ": ");
            _http_append(out, value);
            _http_append(out, "\r\n");
        }
    }
    _http_append(out, "\r\n");
}

# The `size` bytes at `data` as a String. Field values may hold bytes that
# are not UTF-8 (obs-text, such as Latin-1): each of those becomes U+FFFD,
# so the String is valid and `find` still sees the ':' and the rest.
_http_line_text(data: __ptr<u8>, size: ulong): String {
    if (size == 0) {
        return "";
    }
    if (String.length_of(unsafe_cast<__ptr<char>>(data), size) > 0) {
        return String(unsafe_cast<__ptr<char>>(data), size);
    }
    var bytes = Array<u8>(size);
    bytes._append_raw(data, size);
    return text.Utf8.decode_lossy(bytes);
}

_http_append(out: u8[], text: String) {
    out._append_raw(unsafe_cast<__ptr<u8>>(text.c_str()), text.size);
}

# ── Text ─────────────────────────────────────────────────────────────────────

# A non-negative decimal number, or -1.
_http_parse_decimal(text: String): long {
    var t = text.trim();
    if (t.size == 0 || t.size > 18) {
        return -1;
    }
    var p = unsafe_cast<__ptr<u8>>(t.c_str());
    long value = 0;
    ulong i = 0;
    while (i < t.size) {
        var c = p[i];
        if (c < '0' || c > '9') {
            return -1;
        }
        value = value * 10 + (c - '0') as long;
        i = i + 1;
    }
    return value;
}

# A non-negative hexadecimal number, or -1.
_http_parse_hex(text: String): long {
    if (text.size == 0 || text.size > 15) {
        return -1;
    }
    var p = unsafe_cast<__ptr<u8>>(text.c_str());
    long value = 0;
    ulong i = 0;
    while (i < text.size) {
        var digit = _pep_hex_digit(p[i]);
        if (digit < 0) {
            return -1;
        }
        value = value * 16 + digit as long;
        i = i + 1;
    }
    return value;
}

# Whether the comma-separated `list` has `token`, ignoring case.
_http_contains_token(list: String, token: String): bool {
    var wanted = token.lower();
    var rest = list;
    while (true) {
        var comma = rest.find(",");
        var item = rest;
        if (comma >= 0) {
            item = rest.substr_bytes(0, comma as ulong);
        }
        if (item.trim().lower() == wanted) {
            return true;
        }
        if (comma < 0) {
            return false;
        }
        rest = rest.substr_bytes(comma as ulong + 1, rest.size - comma as ulong - 1);
    }
    return false;
}
