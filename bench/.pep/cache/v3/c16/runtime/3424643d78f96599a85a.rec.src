io/socket_windows
20103
# Windows socket layer for io (Winsock 2, ws2_32). Every declaration carries
# [Target(OS(Windows))]; socket_posix.pep declares the same `_io_sys_*`
# socket functions with the same signatures for Linux and macOS.
#
# Winsock is started once per process with WSAStartup before the first
# socket or lookup, and never cleaned up. Sockets are created overlapped
# (so the event loop can later drive them through I/O completion ports),
# non-blocking (a call that would block waits in `_io_socket_wait` and tries
# again), and not inherited by child processes. Errors come from WSAGetLastError, whose
# WSAE* codes FormatMessageW describes like any other system error.

import async;
import "address";
import "socket";
import "sys_windows";
import "types";
import "wait";

# ── C functions (ws2_32, iphlpapi, kernel32) ─────────────────────────────────

[Target(OS(Windows))]
[Link("ws2_32")]
extern int WSAStartup(ushort version, void* data);
[Target(OS(Windows))]
[Link("ws2_32")]
extern int WSAGetLastError();
[Target(OS(Windows))]
[Link("ws2_32")]
extern ulong WSASocketW(int family, int kind, int protocol, void* info, uint group, uint flags);
[Target(OS(Windows))]
[Link("ws2_32")]
extern int closesocket(ulong s);
[Target(OS(Windows))]
[Link("ws2_32")]
extern int bind(ulong s, void* address, int length);
[Target(OS(Windows))]
[Link("ws2_32")]
extern int listen(ulong s, int backlog);
[Target(OS(Windows))]
[Link("ws2_32")]
extern ulong accept(ulong s, void* address, int* length);
[Target(OS(Windows))]
[Link("ws2_32")]
extern int connect(ulong s, void* address, int length);
[Target(OS(Windows))]
[Link("ws2_32")]
extern int recv(ulong s, void* buffer, int length, int flags);
[Target(OS(Windows))]
[Link("ws2_32")]
extern int send(ulong s, void* buffer, int length, int flags);
[Target(OS(Windows))]
[Link("ws2_32")]
extern int recvfrom(ulong s, void* buffer, int length, int flags, void* address, int* address_length);
[Target(OS(Windows))]
[Link("ws2_32")]
extern int sendto(ulong s, void* buffer, int length, int flags, void* address, int address_length);
[Target(OS(Windows))]
[Link("ws2_32")]
extern int shutdown(ulong s, int how);
[Target(OS(Windows))]
[Link("ws2_32")]
extern int setsockopt(ulong s, int level, int name, void* value, int length);
[Target(OS(Windows))]
[Link("ws2_32")]
extern int getsockname(ulong s, void* address, int* length);
[Target(OS(Windows))]
[Link("ws2_32")]
extern int getpeername(ulong s, void* address, int* length);
[Target(OS(Windows))]
[Link("ws2_32")]
extern int GetAddrInfoW(ushort* node, ushort* service, void* hints, void* result);
[Target(OS(Windows))]
[Link("ws2_32")]
extern void FreeAddrInfoW(void* list);
[Target(OS(Windows))]
[Link("ws2_32")]
extern int ioctlsocket(ulong s, int command, uint* argument);
[Target(OS(Windows))]
[Link("ws2_32")]
extern int getsockopt(ulong s, int level, int name, void* value, int* length);
[Target(OS(Windows))]
[Link("ws2_32")]
extern int WSAPoll(void* descriptors, uint count, int timeout);
[Target(OS(Windows))]
extern int SetHandleInformation(ulong h, uint mask, uint flags);  # the SOCKET as a HANDLE
[Target(OS(Windows))]
[Link("iphlpapi")]
extern uint if_nametoindex(char* name);
[Target(OS(Windows))]
[Link("iphlpapi")]
extern char* if_indextoname(uint index, void* name);

# ── Startup ──────────────────────────────────────────────────────────────────

# Set once Winsock is started. Two threads may both call WSAStartup the first
# time; it counts calls, so the extra one is harmless.
[Target(OS(Windows))]
const _io_winsock_started = async.Atomic<int>(0);

[Target(OS(Windows))]
_io_win_socket_startup() {
    if (_io_winsock_started.load() != 0) {
        return;
    }
    var data = _pep_malloc(1024);  # WSADATA (408 bytes on 64-bit)
    WSAStartup(514, data);         # version 2.2
    _pep_free(data);
    _io_winsock_started.store(1);
}

# ── Errors ───────────────────────────────────────────────────────────────────

[Target(OS(Windows))]
_io_sys_code_timed_out(): ErrorCode { return 10060; }

# Code for a stream that ended before the bytes asked for: ERROR_HANDLE_EOF.
[Target(OS(Windows))]
_io_sys_code_unexpected_end(): ErrorCode { return 38; }

# The calling thread's last Winsock error.
[Target(OS(Windows))]
_io_win_socket_error(): IoError {
    var code = WSAGetLastError() as ErrorCode;
    return IoError(code, _io_sys_error_message(code));
}

# 0 -> Ok, SOCKET_ERROR (-1) -> the Winsock error.
[Target(OS(Windows))]
_io_win_socket_check(rc: int): IoResult<void> {
    if (rc == 0) {
        return _io_ok_void();
    }
    return IoResult<void>.err(_io_win_socket_error());
}

# ── Handles ──────────────────────────────────────────────────────────────────

[Target(OS(Windows))]
_io_sys_socket_invalid(): SocketHandle {
    return ~(0 as ulong);  # INVALID_SOCKET
}

[Target(OS(Windows))]
_io_sys_socket_valid(h: SocketHandle): bool {
    return h != _io_sys_socket_invalid();
}

[Target(OS(Windows))]
_io_sys_socket_close(h: SocketHandle): IoResult<void> {
    _io_socket_forget(h);
    return _io_win_socket_check(closesocket(h));
}

# Blocks the thread until `h` is ready for `interest`, or reports an error
# (WSAPoll); fails when `timeout` milliseconds (0 for none) pass first.
[Target(OS(Windows))]
_io_sys_socket_poll(h: SocketHandle, interest: int, timeout: ulong): IoResult<void> {
    var descriptor = _pep_malloc(16) as __ptr<ulong>;
    var events = unsafe_cast<__ptr<u16>>(descriptor);
    descriptor[0] = h;
    events[4] = 256;  # POLLRDNORM
    if (interest == _IO_WRITABLE) {
        events[4] = 16;  # POLLWRNORM
    }
    events[5] = 0;
    var rc = WSAPoll(descriptor, 1, _io_poll_timeout(timeout));
    _pep_free(descriptor);
    if (rc < 0) {
        return IoResult<void>.err(_io_win_socket_error());
    }
    if (rc == 0) {
        return IoResult<void>.err(_io_timed_out_error());
    }
    return _io_ok_void();
}

# ── sockaddr ─────────────────────────────────────────────────────────────────

# A 16-bit family at 0: AF_INET 2, AF_INET6 23.
[Target(OS(Windows))]
_io_sys_sockaddr_header(buffer: __ptr<u8>, v6: bool, length: int) {
    var family = 2;
    if (v6) {
        family = 23;
    }
    unsafe_cast<__ptr<u16>>(buffer)[0] = family as u16;
}

# 4 for IPv4, 6 for IPv6, 0 for any other family.
[Target(OS(Windows))]
_io_sys_sockaddr_family(buffer: __ptr<u8>): int {
    var family = unsafe_cast<__ptr<u16>>(buffer)[0] as int;
    if (family == 2) {
        return 4;
    }
    if (family == 23) {
        return 6;
    }
    return 0;
}

# sockaddr_un: a 16-bit family (AF_UNIX, 1), then the path, NUL-terminated,
# at 2: at most 108 bytes.
[Target(OS(Windows))]
_io_sys_sockaddr_unix_header(buffer: __ptr<u8>, length: int) {
    unsafe_cast<__ptr<u16>>(buffer)[0] = 1;
}

[Target(OS(Windows))]
_io_sys_unix_path_capacity(): ulong { return 108; }

# ── Socket calls ─────────────────────────────────────────────────────────────

# A new overlapped, non-inheritable, non-blocking socket (SOCK_STREAM 1 or
# SOCK_DGRAM 2). Every socket is non-blocking: a call that would block waits
# in `_io_socket_wait` and tries again.
[Target(OS(Windows))]
_io_sys_socket_open(v6: bool, stream: bool): IoResult<SocketHandle> {
    _io_win_socket_startup();
    var family = 2;
    if (v6) {
        family = 23;
    }
    var kind = 2;
    if (stream) {
        kind = 1;
    }
    var s = WSASocketW(family, kind, 0, __null, 0, 129);  # WSA_FLAG_OVERLAPPED | WSA_FLAG_NO_HANDLE_INHERIT
    if (!_io_sys_socket_valid(s)) {
        return IoResult<SocketHandle>.err(_io_win_socket_error());
    }
    _io_win_set_non_blocking(s);
    return IoResult<SocketHandle>.ok(s);
}

# A new overlapped, non-inheritable, non-blocking Unix domain stream socket
# (AF_UNIX 1, SOCK_STREAM 1; Windows 10 1803 and later).
[Target(OS(Windows))]
_io_sys_socket_open_unix(): IoResult<SocketHandle> {
    _io_win_socket_startup();
    var s = WSASocketW(1, 1, 0, __null, 0, 129);  # WSA_FLAG_OVERLAPPED | WSA_FLAG_NO_HANDLE_INHERIT
    if (!_io_sys_socket_valid(s)) {
        return IoResult<SocketHandle>.err(_io_win_socket_error());
    }
    _io_win_set_non_blocking(s);
    return IoResult<SocketHandle>.ok(s);
}

# FIONBIO: makes `s` non-blocking.
[Target(OS(Windows))]
_io_win_set_non_blocking(s: SocketHandle) {
    var on = _pep_malloc(4) as __ptr<uint>;
    on[0] = 1;
    ioctlsocket(s, -2147195266, on);  # FIONBIO (0x8004667E)
    _pep_free(on);
}

# After a failed call with Winsock error `code`: waits for `interest` when
# the call would block (WSAEWOULDBLOCK), and succeeds when the call should be
# tried again; otherwise fails with the error to return. The error's message
# is looked up only then, since would-block is the common case.
[Target(OS(Windows))]
_io_win_retry(h: SocketHandle, code: ErrorCode, interest: int): IoResult<void> {
    if (code == 10035) {  # WSAEWOULDBLOCK
        return _io_socket_wait(h, interest);
    }
    return IoResult<void>.err(IoError(code, _io_sys_error_message(code)));
}

[Target(OS(Windows))]
_io_win_set_int_option(s: SocketHandle, level: int, name: int, value: int): IoResult<void> {
    var slot = _pep_malloc(4) as __ptr<int>;
    slot[0] = value;
    var rc = setsockopt(s, level, name, slot, 4);
    var result = _io_win_socket_check(rc);
    _pep_free(slot);
    return result;
}

# SO_REUSEADDR on Windows lets another socket take over a bound port, which
# POSIX's does not; listeners go without it, as Rust's do.
[Target(OS(Windows))]
_io_sys_socket_set_reuse_address(h: SocketHandle): IoResult<void> {
    return _io_ok_void();
}

[Target(OS(Windows))]
_io_sys_socket_set_no_delay(h: SocketHandle, enabled: bool): IoResult<void> {
    return _io_win_set_int_option(h, 6, 1, enabled ? 1 : 0);  # IPPROTO_TCP, TCP_NODELAY
}

[Target(OS(Windows))]
_io_sys_socket_set_broadcast(h: SocketHandle, enabled: bool): IoResult<void> {
    return _io_win_set_int_option(h, 65535, 32, enabled ? 1 : 0);  # SOL_SOCKET, SO_BROADCAST
}

[Target(OS(Windows))]
_io_sys_socket_bind(h: SocketHandle, address: SocketAddress): IoResult<void> {
    var sockaddr = _io_sockaddr_write(address);
    return _io_sys_socket_bind_raw(h, sockaddr._bytes, sockaddr._length);
}

# Binds `h` to the `length`-byte sockaddr at `buffer`, of any family.
[Target(OS(Windows))]
_io_sys_socket_bind_raw(h: SocketHandle, buffer: __ptr<u8>, length: int): IoResult<void> {
    return _io_win_socket_check(bind(h, buffer, length));
}

[Target(OS(Windows))]
_io_sys_socket_listen(h: SocketHandle, backlog: int): IoResult<void> {
    return _io_win_socket_check(listen(h, backlog));
}

# A non-blocking connect fails with WSAEWOULDBLOCK; it has finished when the
# socket is writable (or reports an error), and SO_ERROR says how.
[Target(OS(Windows))]
_io_sys_socket_connect(h: SocketHandle, address: SocketAddress): IoResult<void> {
    var sockaddr = _io_sockaddr_write(address);
    return _io_sys_socket_connect_raw(h, sockaddr._bytes, sockaddr._length);
}

# Connects `h` to the `length`-byte sockaddr at `buffer`, of any family.
[Target(OS(Windows))]
_io_sys_socket_connect_raw(h: SocketHandle, buffer: __ptr<u8>, length: int): IoResult<void> {
    var rc = connect(h, buffer, length);
    if (rc == 0) {
        return _io_ok_void();
    }
    var e = _io_win_socket_error();
    if (e.code != 10035) {  # WSAEWOULDBLOCK
        return IoResult<void>.err(e);
    }
    var waited = _io_socket_wait(h, _IO_WRITABLE);
    if (waited.is_err()) {
        return waited;
    }
    var slot = _pep_malloc(8) as __ptr<int>;
    var size = slot + 1;
    slot[0] = 0;
    size[0] = 4;
    var got = getsockopt(h, 65535, 4103, slot, size);  # SOL_SOCKET, SO_ERROR
    var code = slot[0];
    _pep_free(slot);
    if (got != 0) {
        return IoResult<void>.err(_io_win_socket_error());
    }
    if (code != 0) {
        return IoResult<void>.err(IoError(code as ErrorCode, _io_sys_error_message(code as ErrorCode)));
    }
    return _io_ok_void();
}

[Target(OS(Windows))]
_io_sys_socket_accept(h: SocketHandle): IoResult<(SocketHandle, SocketAddress)> {
    var peer = _SockAddr();
    var s = _io_sys_socket_invalid();
    while (true) {
        s = accept(h, peer._bytes, unsafe_cast<__ptr<int>>(peer._length_slot()));
        if (_io_sys_socket_valid(s)) {
            break;
        }
        var retry = _io_win_retry(h, WSAGetLastError() as ErrorCode, _IO_READABLE);
        if (retry.is_err()) {
            return IoResult<(SocketHandle, SocketAddress)>.err(retry.error());
        }
    }
    SetHandleInformation(s, 1, 0);  # HANDLE_FLAG_INHERIT off
    _io_win_set_non_blocking(s);
    return IoResult<(SocketHandle, SocketAddress)>.ok((s, peer._read()));
}

[Target(OS(Windows))]
export _io_sys_socket_receive(h: SocketHandle, destination: __ptr<u8>, n: ulong): IoResult<ulong> {
    while (true) {
        var r = recv(h, destination, (_io_win_max_rw(n) as int), 0);
        if (r >= 0) {
            return IoResult<ulong>.ok(r as ulong);
        }
        var retry = _io_win_retry(h, WSAGetLastError() as ErrorCode, _IO_READABLE);
        if (retry.is_err()) {
            return IoResult<ulong>.err(retry.error());
        }
    }
    return IoResult<ulong>.ok(0);
}

[Target(OS(Windows))]
export _io_sys_socket_send(h: SocketHandle, source: __ptr<u8>, n: ulong): IoResult<ulong> {
    while (true) {
        var r = send(h, source, (_io_win_max_rw(n) as int), 0);
        if (r >= 0) {
            return IoResult<ulong>.ok(r as ulong);
        }
        var retry = _io_win_retry(h, WSAGetLastError() as ErrorCode, _IO_WRITABLE);
        if (retry.is_err()) {
            return IoResult<ulong>.err(retry.error());
        }
    }
    return IoResult<ulong>.ok(0);
}

[Target(OS(Windows))]
_io_sys_socket_send_to(h: SocketHandle, source: __ptr<u8>, n: ulong, address: SocketAddress): IoResult<ulong> {
    var sockaddr = _io_sockaddr_write(address);
    while (true) {
        var r = sendto(h, source, (_io_win_max_rw(n) as int), 0, sockaddr._bytes, sockaddr._length);
        if (r >= 0) {
            return IoResult<ulong>.ok(r as ulong);
        }
        var retry = _io_win_retry(h, WSAGetLastError() as ErrorCode, _IO_WRITABLE);
        if (retry.is_err()) {
            return IoResult<ulong>.err(retry.error());
        }
    }
    return IoResult<ulong>.ok(0);
}

# A datagram longer than `n` is truncated to `n` bytes; Winsock reports that
# as WSAEMSGSIZE with the buffer filled, which counts as success here, as on
# POSIX.
[Target(OS(Windows))]
_io_sys_socket_receive_from(h: SocketHandle, destination: __ptr<u8>, n: ulong): IoResult<(ulong, SocketAddress)> {
    var from = _SockAddr();
    var limit = (_io_win_max_rw(n) as int);
    var r = 0;
    while (true) {
        r = recvfrom(h, destination, limit, 0, from._bytes, unsafe_cast<__ptr<int>>(from._length_slot()));
        if (r >= 0) {
            break;
        }
        var code = WSAGetLastError() as ErrorCode;
        if (code == 10040) {  # WSAEMSGSIZE
            r = limit;
            break;
        }
        var retry = _io_win_retry(h, code, _IO_READABLE);
        if (retry.is_err()) {
            return IoResult<(ulong, SocketAddress)>.err(retry.error());
        }
    }
    return IoResult<(ulong, SocketAddress)>.ok((r as ulong, from._read()));
}

# how: 0 reading, 1 writing, 2 both (SD_RECEIVE, SD_SEND, SD_BOTH).
[Target(OS(Windows))]
_io_sys_socket_shutdown(h: SocketHandle, how: int): IoResult<void> {
    return _io_win_socket_check(shutdown(h, how));
}

[Target(OS(Windows))]
_io_sys_socket_local_address(h: SocketHandle): IoResult<SocketAddress> {
    var address = _SockAddr();
    return _io_win_address_result(
        getsockname(h, address._bytes, unsafe_cast<__ptr<int>>(address._length_slot())), address
    );
}

[Target(OS(Windows))]
_io_sys_socket_peer_address(h: SocketHandle): IoResult<SocketAddress> {
    var address = _SockAddr();
    return _io_win_address_result(
        getpeername(h, address._bytes, unsafe_cast<__ptr<int>>(address._length_slot())), address
    );
}

# The address getsockname/getpeername wrote into `address`, or the Winsock
# error.
[Target(OS(Windows))]
_io_win_address_result(rc: int, address: _SockAddr): IoResult<SocketAddress> {
    if (rc != 0) {
        return IoResult<SocketAddress>.err(_io_win_socket_error());
    }
    return IoResult<SocketAddress>.ok(address._read());
}

# ── Name resolution ──────────────────────────────────────────────────────────
# ADDRINFOW: ai_flags @0, ai_family @4, ai_socktype @8, ai_protocol @12,
# ai_addrlen (size_t) @16, ai_canonname @24, ai_addr @32, ai_next @40; 48
# bytes in all.

[Target(OS(Windows))]
_io_sys_resolve(host: String, port: u16): IoResult<SocketAddress[]> {
    _io_win_socket_startup();
    var hints = _IoBuffer(48);
    unsafe_cast<__ptr<int>>(hints._bytes)[2] = 1;  # ai_socktype = SOCK_STREAM: one entry per address
    var result = _IoBuffer(8);
    var list = unsafe_cast<__ptr<__ptr<u8>>>(result._bytes);
    var node = _io_win_wide(host);
    var rc = GetAddrInfoW(node, __null, hints._bytes, list);
    _pep_free(node);
    if (rc != 0) {
        var code = rc as ErrorCode;
        var message = "failed to resolve '" + host + "': " + _io_sys_error_message(code);
        if (code == 11001 || code == 11004) {  # WSAHOST_NOT_FOUND, WSANO_DATA
            return IoResult<SocketAddress[]>.err(IoError(_io_sys_code_not_found(), message));
        }
        return IoResult<SocketAddress[]>.err(IoError(code, message));
    }
    var out = Array<SocketAddress>();
    var entry = list[0];
    while (entry != __null) {
        var address = unsafe_cast<__ptr<__ptr<u8>>>(entry + 32)[0];
        if (address != __null) {
            if (_io_sys_sockaddr_family(address) != 0) {
                var found = _io_sockaddr_read(address);
                out.append(SocketAddress(found.address(), port));
            }
        }
        entry = unsafe_cast<__ptr<__ptr<u8>>>(entry + 40)[0];
    }
    FreeAddrInfoW(list[0]);
    return IoResult<SocketAddress[]>.ok(out);
}

# ── Network interfaces ───────────────────────────────────────────────────────

# The index of the network interface called `name` (its NDIS name, such as
# `ethernet_32769`), or 0 when there is none.
[Target(OS(Windows))]
_io_sys_interface_index(name: String): uint {
    return if_nametoindex(name.c_str());
}

# The name of network interface `index`, or "" when there is none.
[Target(OS(Windows))]
_io_sys_interface_name(index: uint): String {
    var buffer = _IoBuffer(257);  # NDIS_IF_MAX_STRING_SIZE + 1
    var name = if_indextoname(index, buffer._bytes);
    if (name == __null) {
        return "";
    }
    return String(name);
}
io/stream
11540
## `Reader` and `Writer`: the traits of byte streams, such as a `File`, a
## `TcpStream`, a `UnixStream` or a `tls.TlsStream`, so code can read from
## or write to any of them.

import text;
import "file";
import "socket";
import "sys_posix";
import "sys_windows";
import "types";
import "unix";

## A stream of bytes that can be read: a `File`, `TcpStream`, `UnixStream`
## or `tls.TlsStream`, or any type with `read(buffer, max)`.
##
## A type has the trait by providing `read`; it then gets `lines()` and
## `chunks(size)`, which read the stream as a `for` loop asks for more.
## Take a `Reader` (or `<R: Reader>`) to accept any stream.
##
## @example
##     import io;
##
##     count_lines(source: io.Reader): int {
##         var count = 0;
##         for (var line in source.lines()) {
##             if (line.is_err()) {
##                 break;
##             }
##             count += 1;
##         }
##         return count;
##     }
export trait Reader {
    ## Waits until some bytes are available, then appends up to `max` of
    ## them to `buffer`.
    ##
    ## @param buffer the array the bytes are appended to
    ## @param max the most bytes to read
    ## @returns the number of bytes appended, 0 at the end of the stream; an
    ##   error when the stream fails
    read(buffer: u8[], max: ulong): IoResult<ulong>;

    ## Returns an iterator over the rest of the stream's lines, read as it
    ## goes, so a `for` loop handles a large file without reading it all.
    ##
    ## Each element is an `IoResult<String>`: a line without its line ending
    ## (`\n`, or `\r\n`). The last line counts even without a final line
    ## ending, and a stream that ends with one has no empty line after it. A
    ## read error, or a line that is not valid UTF-8 (`is_invalid_input()`),
    ## is yielded as an error and ends the lines. The stream is read in
    ## 64 KiB chunks, so a file's position after the loop is not the end of
    ## the last line returned.
    ##
    ## @returns a new `Lines` positioned before the first line
    ## @example
    ##     var f = File.open(Path("notes.txt")).value();
    ##     for (var line in f.lines()) {
    ##         print(line.value());
    ##     }
    lines(): Lines {
        return Lines(this);
    }

    ## Returns an iterator over the rest of the stream in chunks of at most
    ## `size` bytes, each read as the loop asks for it.
    ##
    ## Each element is an `IoResult<u8[]>`: a new array of what one `read`
    ## returned, which may be fewer than `size` bytes (a socket returns what
    ## has arrived). The iteration ends at the end of the stream; a read
    ## error is yielded and ends it.
    ##
    ## @param size the most bytes in one chunk
    ## @returns a new `Chunks` positioned before the first chunk
    ## @panics if `size` is 0 ("Reader.chunks() needs a size above 0")
    ## @example
    ##     var total = 0;
    ##     for (var chunk in stream.chunks(4096)) {
    ##         total += chunk.value().count;
    ##     }
    chunks(size: ulong): Chunks {
        assert(size > 0, "Reader.chunks() needs a size above 0");
        return Chunks(this, size);
    }
}

## A stream of bytes that can be written: a `File`, `TcpStream`,
## `UnixStream` or `tls.TlsStream`, or any type with `write` and
## `write_all`.
##
## A type has the trait by providing `write` and `write_all(data: u8[])`; it
## then gets `print` and `print_line`, which write the text `to_string` makes
## of a value (the text `$"{value}"` would hold).
##
## @example
##     import io;
##
##     main(): int {
##         var path = io.Directory.temp().join("report.txt");
##         var file = io.File.create(path).value();
##         file.print("total: ");
##         file.print_line(42);
##         file.close();
##         assert(io.File.read_to_string(path).value() == "total: 42\n", "printed");
##         io.File.remove(path);
##         return 0;
##     }
export trait Writer {
    ## Writes what the stream takes in one call, which may be less than all
    ## of `data`.
    ##
    ## @param data the bytes to write
    ## @returns the number of bytes written; an error when the stream fails
    write(data: u8[]): IoResult<ulong>;

    ## Writes all of `data`.
    ##
    ## @param data the bytes to write
    ## @returns an Ok result once every byte is written; an error when the
    ##   stream fails
    write_all(data: u8[]): IoResult<void>;

    ## Writes the text of `value`, with no line break after it: a String as
    ## it is, anything else through `to_string`.
    ##
    ## @typeParam T the type of `value`
    ## @param value the value to print
    ## @returns an Ok result once the text is written; an error as for
    ##   `write_all`
    ## @example
    ##     file.print("n = ");
    ##     file.print(3);   # the file now holds "n = 3"
    print<T>(value: T): IoResult<void> {
        return write_all(to_string(value).bytes());
    }

    ## Writes the text of `value` and a line break (`\n`), as the global
    ## `print` does on standard output.
    ##
    ## @typeParam T the type of `value`
    ## @param value the value to print
    ## @returns an Ok result once the line is written; an error as for
    ##   `write_all`
    ## @example
    ##     file.print_line($"total: {total}");
    ##     file.print_line((1, "two"));   # (1, two)
    print_line<T>(value: T): IoResult<void> {
        return write_all((to_string(value) + "\n").bytes());
    }
}

extend File with Reader;

extend File with Writer;

extend TcpStream with Reader;

extend TcpStream with Writer;

extend UnixStream with Reader;

extend UnixStream with Writer;

## The iterator `Reader.lines()` returns: the lines of a stream, read in
## chunks as the loop asks for them, each as an `IoResult<String>`.
##
## @example
##     var f = File.open(Path("notes.txt")).value();
##     var it = f.lines();
##     while (it.next()) {
##         var line = it.current();
##     }
## @see Reader.lines
export struct Lines {
    ## The stream being read.
    Reader _source;
    ## The last chunk read from the file.
    u8[] _chunk;
    ## The position in `_chunk` of the first byte not yet looked at.
    ulong _position;
    ## The bytes of the line being collected.
    u8[] _line;
    ## Whether the lines have ended (at the end of the file, or after an
    ## error); `next()` then returns false.
    bool _finished;
    ## Whether `_value` holds the element the last `next()` moved to.
    bool _has_value;
    ## The current element.
    IoResult<String> _value;

    ## Makes an iterator over the lines of `source`, from what it reads next.
    ##
    ## @param source the open stream to read
    construct(source: Reader) {
        _source = source;
        _chunk = Array<u8>();
        _line = Array<u8>();
        _value = IoResult<String>.ok("");
    }

    ## Reads the next line.
    ##
    ## Once it returns false it keeps returning false.
    ##
    ## @returns true if there is a current element (a line, or the error that
    ## ends the lines), false at the end of the stream
    next(): bool {
        _has_value = false;
        if (_finished) {
            return false;
        }
        _line.clear();
        while (true) {
            if (_position == _chunk.count) {
                _chunk.clear();
                _position = 0;
                var read = _source.read(_chunk, _io_chunk_size());
                if (read.is_err()) {
                    _finished = true;
                    return _yield(IoResult<String>.err(read.error()));
                }
                if (read.value() == 0) {
                    _finished = true;
                    if (_line.is_empty) {
                        return false;
                    }
                    return _yield_line();
                }
            }
            var byte = _chunk[_position];
            _position += 1;
            if (byte == '\n') {
                return _yield_line();
            }
            _line.append(byte);
        }
    }

    # Makes the collected bytes, without a final `\r`, the current element.
    _yield_line(): bool {
        if (!_line.is_empty && _line.last() == '\r') {
            _line.pop();
        }
        var decoded = text.Utf8.decode(_line);
        if (decoded.is_empty()) {
            _finished = true;
            return _yield(IoResult<String>.err(IoError(_io_sys_code_invalid_input(), "line is not valid UTF-8")));
        }
        return _yield(IoResult<String>.ok(decoded.value()));
    }

    # Makes `value` the current element.
    _yield(value: IoResult<String>): bool {
        _value = value;
        _has_value = true;
        return true;
    }

    ## Returns the element the last successful `next()` moved to.
    ##
    ## @returns the current line, or the error that ended the lines
    ## @panics if `next()` was never called, or already returned false ("Lines.current() without a line")
    current(): IoResult<String> {
        assert(_has_value, "Lines.current() without a line");
        return _value;
    }
}

extend Lines with Iterator<IoResult<String>>;

## The iterator `Reader.chunks(size)` returns: the rest of a stream, one
## `read` of at most `size` bytes at a time, each as an `IoResult<u8[]>`.
##
## @see Reader.chunks
export struct Chunks {
    ## The stream being read.
    Reader _source;
    ## The most bytes in one chunk.
    ulong _size;
    ## Whether the chunks have ended (at the end of the stream, or after an
    ## error); `next()` then returns false.
    bool _finished;
    ## Whether `_value` holds the element the last `next()` moved to.
    bool _has_value;
    ## The current element.
    IoResult<u8[]> _value;

    ## Makes an iterator over `source` in chunks of at most `size` bytes.
    ##
    ## @param source the open stream to read
    ## @param size the most bytes in one chunk
    construct(source: Reader, size: ulong) {
        _source = source;
        _size = size;
        _value = IoResult<u8[]>.ok(Array<u8>());
    }

    ## Reads the next chunk.
    ##
    ## Once it returns false it keeps returning false.
    ##
    ## @returns true if there is a current element (a chunk, or the error
    ## that ends the chunks), false at the end of the stream
    next(): bool {
        _has_value = false;
        if (_finished) {
            return false;
        }
        var chunk = Array<u8>();
        var read = _source.read(chunk, _size);
        if (read.is_err()) {
            _finished = true;
            _value = IoResult<u8[]>.err(read.error());
            _has_value = true;
            return true;
        }
        if (read.value() == 0) {
            _finished = true;
            return false;
        }
        _value = IoResult<u8[]>.ok(chunk);
        _has_value = true;
        return true;
    }

    ## Returns the element the last successful `next()` moved to.
    ##
    ## @returns the current chunk, or the error that ended the chunks
    ## @panics if `next()` was never called, or already returned false ("Chunks.current() without a chunk")
    current(): IoResult<u8[]> {
        assert(_has_value, "Chunks.current() without a chunk");
        return _value;
    }
}

extend Chunks with Iterator<IoResult<u8[]>>;
io/sys_posix
35206
# POSIX (Linux, macOS, and WASI through wasi-libc) platform layer for io.
# Every declaration carries [Target(!OS(Windows))] or a narrower target;
# sys_windows.pep declares the same `_io_sys_*` functions with the same
# signatures for Windows. These are exported to the other io files only:
# module.pep does not re-export them.
#
# Linux, macOS and WASI differ in the errno accessor and values, O_* flag
# values, the stat call and layout, and the dirent layout. C structs are
# read from raw `_pep_malloc` buffers at the byte offsets the small [Target]
# functions below return. wasi-libc's `long` is 32 bits, so a C `off_t` is
# declared `i64`, and a `long` field is never read as a Pepper `long`.

import "directory";
import "file";
import "path";
import "types";

# ── C functions ──────────────────────────────────────────────────────────────

[Target(!OS(Windows))]
extern int open(char* path, int flags, ...);
[Target(!OS(Windows))]
extern long read(int fd, void* buf, ulong n);
[Target(!OS(Windows))]
extern long write(int fd, void* buf, ulong n);
[Target(!OS(Windows))]
extern int close(int fd);
[Target(!OS(Windows))]
extern i64 lseek(int fd, i64 offset, int whence);
[Target(!OS(Windows))]
extern int ftruncate(int fd, i64 size);
[Target(!OS(Windows))]
extern int fsync(int fd);
[Target(!OS(Windows))]
extern int mkdir(char* path, uint mode);
[Target(!OS(Windows))]
extern int rmdir(char* path);
[Target(!OS(Windows))]
extern int unlink(char* path);
[Target(!OS(Windows))]
extern int rename(char* from, char* to);
[Target(!OS(Windows))]
extern char* getcwd(char* buf, ulong size);
[Target(!OS(Windows))]
extern int chdir(char* path);
[Target(!OS(Windows))]
extern char* realpath(char* path, char* resolved);
[Target(!OS(Windows))]
extern char* strerror(int code);
[Target(!OS(Windows))]
extern char* getenv(char* name);
[Target(!OS(Windows))]
extern int closedir(void* dir);
[Target(!OS(Windows))]
extern int utimensat(int dirfd, char* path, void* times, int flags);
[Target(!OS(Windows))]
extern int futimens(int fd, void* times);
[Target(!OS(Windows))]
extern int symlink(char* target, char* link);
[Target(!OS(Windows))]
extern int link(char* from, char* to);
[Target(!OS(Windows))]
extern long readlink(char* path, char* buf, ulong size);

# WASI preview 1 has no permission bits, and wasi-libc no chmod.
[Target(OS(Linux) || OS(Mac))]
extern int chmod(char* path, uint mode);
[Target(OS(Linux) || OS(Mac))]
extern int fchmod(int fd, uint mode);

# Linux: errno through glibc's accessor (bionic's on Android); statx for
# stat (one layout on x64 and aarch64, and present where glibc < 2.33 has no
# `stat` symbol; bionic has it from API level 30, the oldest Pepper targets).
[Target((OS(Linux) && !OS(Android)) || OS(Wasi))]
extern int* __errno_location();
[Target(OS(Android))]
extern int* __errno();
[Target(OS(Linux))]
extern int statx(int dirfd, char* path, int flags, uint mask, void* buf);
[Target(OS(Linux))]
extern void* opendir(char* path);
[Target(OS(Linux))]
extern void* readdir(void* dir);

# macOS: x64 binds the 64-bit-inode variants by their `$INODE64` symbols;
# aarch64 only has those layouts, under the plain names, and so does iOS on
# both (its simulator included), which never had 32-bit inodes.
[Target(OS(Mac))]
extern int* __error();
[Target(OS(Mac) && !OS(IOS) && Arch(x64))]
[Link(name = "stat$INODE64")]
extern int stat(char* path, void* buf);
[Target(OS(Mac) && !OS(IOS) && Arch(x64))]
[Link(name = "lstat$INODE64")]
extern int lstat(char* path, void* buf);
[Target(OS(Mac) && !OS(IOS) && Arch(x64))]
[Link(name = "fstat$INODE64")]
extern int fstat(int fd, void* buf);
[Target(OS(Mac) && !OS(IOS) && Arch(x64))]
[Link(name = "opendir$INODE64")]
extern void* opendir(char* path);
[Target(OS(Mac) && !OS(IOS) && Arch(x64))]
[Link(name = "readdir$INODE64")]
extern void* readdir(void* dir);
[Target(OS(Mac) && (Arch(aarch64) || OS(IOS)))]
extern int stat(char* path, void* buf);
[Target(OS(Mac) && (Arch(aarch64) || OS(IOS)))]
extern int lstat(char* path, void* buf);
[Target(OS(Mac) && (Arch(aarch64) || OS(IOS)))]
extern int fstat(int fd, void* buf);
[Target(OS(Mac) && (Arch(aarch64) || OS(IOS)))]
extern void* opendir(char* path);
[Target(OS(Mac) && (Arch(aarch64) || OS(IOS)))]
extern void* readdir(void* dir);

# WASI: wasi-libc's own stat and dirent layouts, under the plain names.
[Target(OS(Wasi))]
extern int stat(char* path, void* buf);
[Target(OS(Wasi))]
extern int lstat(char* path, void* buf);
[Target(OS(Wasi))]
extern int fstat(int fd, void* buf);
[Target(OS(Wasi))]
extern void* opendir(char* path);
[Target(OS(Wasi))]
extern void* readdir(void* dir);

# ── errno ────────────────────────────────────────────────────────────────────

[Target((OS(Linux) && !OS(Android)) || OS(Wasi))]
_io_errno(): __ptr<int> {
    return __errno_location();
}

[Target(OS(Android))]
_io_errno(): __ptr<int> {
    return __errno();
}

[Target(OS(Mac))]
_io_errno(): __ptr<int> {
    return __error();
}

[Target(!OS(Windows))]
_io_sys_last_error(): ErrorCode {
    return _io_errno()[0];
}

[Target(!OS(Windows))]
export _io_sys_error_message(code: ErrorCode): String {
    return String(strerror(code));
}

# The ErrorKind of an errno value. Linux and macOS share the file codes
# except ENOTEMPTY and ECANCELED; most socket codes differ.
[Target(OS(Linux))]
_io_sys_error_kind(code: ErrorCode): ErrorKind {
    return match (code) {
        2 => ErrorKind.NotFound,                    # ENOENT
        13, 1 => ErrorKind.PermissionDenied,        # EACCES, EPERM
        17 => ErrorKind.AlreadyExists,              # EEXIST
        20 => ErrorKind.NotADirectory,              # ENOTDIR
        21 => ErrorKind.IsADirectory,               # EISDIR
        39 => ErrorKind.DirectoryNotEmpty,          # ENOTEMPTY
        22 => ErrorKind.InvalidInput,               # EINVAL
        4 => ErrorKind.Interrupted,                 # EINTR
        111 => ErrorKind.ConnectionRefused,         # ECONNREFUSED
        104, 103, 32 => ErrorKind.ConnectionReset,  # ECONNRESET, ECONNABORTED, EPIPE
        98 => ErrorKind.AddressInUse,               # EADDRINUSE
        99 => ErrorKind.AddressNotAvailable,        # EADDRNOTAVAIL
        110 => ErrorKind.TimedOut,                  # ETIMEDOUT
        125 => ErrorKind.Cancelled,                 # ECANCELED
        else => ErrorKind.Other,
    };
}

[Target(OS(Mac))]
_io_sys_error_kind(code: ErrorCode): ErrorKind {
    return match (code) {
        2 => ErrorKind.NotFound,                  # ENOENT
        13, 1 => ErrorKind.PermissionDenied,      # EACCES, EPERM
        17 => ErrorKind.AlreadyExists,            # EEXIST
        20 => ErrorKind.NotADirectory,            # ENOTDIR
        21 => ErrorKind.IsADirectory,             # EISDIR
        66 => ErrorKind.DirectoryNotEmpty,        # ENOTEMPTY
        22 => ErrorKind.InvalidInput,             # EINVAL
        4 => ErrorKind.Interrupted,               # EINTR
        61 => ErrorKind.ConnectionRefused,        # ECONNREFUSED
        54, 53, 32 => ErrorKind.ConnectionReset,  # ECONNRESET, ECONNABORTED, EPIPE
        48 => ErrorKind.AddressInUse,             # EADDRINUSE
        49 => ErrorKind.AddressNotAvailable,      # EADDRNOTAVAIL
        60 => ErrorKind.TimedOut,                 # ETIMEDOUT
        89 => ErrorKind.Cancelled,                # ECANCELED
        else => ErrorKind.Other,
    };
}

# WASI numbers errno values its own way (wasi/api.h's __WASI_ERRNO_*).
[Target(OS(Wasi))]
_io_sys_error_kind(code: ErrorCode): ErrorKind {
    return match (code) {
        44 => ErrorKind.NotFound,                 # ENOENT
        2, 63 => ErrorKind.PermissionDenied,      # EACCES, EPERM
        20 => ErrorKind.AlreadyExists,            # EEXIST
        54 => ErrorKind.NotADirectory,            # ENOTDIR
        31 => ErrorKind.IsADirectory,             # EISDIR
        55 => ErrorKind.DirectoryNotEmpty,        # ENOTEMPTY
        28 => ErrorKind.InvalidInput,             # EINVAL
        27 => ErrorKind.Interrupted,              # EINTR
        14 => ErrorKind.ConnectionRefused,        # ECONNREFUSED
        15, 13, 64 => ErrorKind.ConnectionReset,  # ECONNRESET, ECONNABORTED, EPIPE
        3 => ErrorKind.AddressInUse,              # EADDRINUSE
        4 => ErrorKind.AddressNotAvailable,       # EADDRNOTAVAIL
        73 => ErrorKind.TimedOut,                 # ETIMEDOUT
        11 => ErrorKind.Cancelled,                # ECANCELED
        else => ErrorKind.Other,
    };
}

# Codes for errors Pepper raises itself.
[Target(OS(Linux) || OS(Mac))]
export _io_sys_code_invalid_input(): ErrorCode {
    return 22;
}  # EINVAL

[Target(OS(Linux) || OS(Mac))]
_io_sys_code_not_a_directory(): ErrorCode {
    return 20;
}  # ENOTDIR

[Target(OS(Linux) || OS(Mac))]
_io_sys_code_not_found(): ErrorCode {
    return 2;
}  # ENOENT

[Target(OS(Linux) || OS(Mac))]
_io_sys_code_bad_handle(): ErrorCode {
    return 9;
}  # EBADF

[Target(OS(Linux) || OS(Mac))]
export _io_sys_code_write_zero(): ErrorCode {
    return 5;
}  # EIO

[Target(OS(Wasi))]
export _io_sys_code_invalid_input(): ErrorCode {
    return 28;
}  # EINVAL

[Target(OS(Wasi))]
_io_sys_code_not_a_directory(): ErrorCode {
    return 54;
}  # ENOTDIR

[Target(OS(Wasi))]
_io_sys_code_not_found(): ErrorCode {
    return 44;
}  # ENOENT

[Target(OS(Wasi))]
_io_sys_code_bad_handle(): ErrorCode {
    return 8;
}  # EBADF

[Target(OS(Wasi))]
export _io_sys_code_write_zero(): ErrorCode {
    return 29;
}  # EIO

# ERANGE: a buffer was too small.
[Target(OS(Linux) || OS(Mac))]
_io_posix_code_range(): ErrorCode {
    return 34;
}

[Target(OS(Wasi))]
_io_posix_code_range(): ErrorCode {
    return 68;
}

[Target(OS(Linux))]
_io_sys_code_cancelled(): ErrorCode {
    return 125;
}  # ECANCELED

[Target(OS(Mac))]
_io_sys_code_cancelled(): ErrorCode {
    return 89;
}  # ECANCELED

[Target(OS(Wasi))]
_io_sys_code_cancelled(): ErrorCode {
    return 11;
}  # ECANCELED

[Target(!OS(Windows))]
_io_posix_err_none(): IoResult<void> {
    return IoResult<void>.err(IoError.last());
}

# 0 -> Ok, -1 -> the errno error.
[Target(!OS(Windows))]
_io_posix_check(rc: int): IoResult<void> {
    if (rc == 0) {
        return _io_ok_void();
    }
    return _io_posix_err_none();
}

# An empty path names nothing (and an empty String has no C string).
[Target(!OS(Windows))]
_io_posix_empty_path(): IoError {
    return IoError(_io_sys_code_not_found(), "empty path");
}

# ── Handles ──────────────────────────────────────────────────────────────────

[Target(!OS(Windows))]
_io_sys_invalid_handle(): FileHandle {
    return -1;
}

[Target(!OS(Windows))]
_io_sys_handle_valid(h: FileHandle): bool {
    return h >= 0;
}

# `h` as a number, for a `FileTransfer`.
[Target(!OS(Windows))]
_io_sys_handle_bits(h: FileHandle): long {
    return h as long;
}

# The handle `_io_sys_handle_bits` gave `bits` for.
[Target(!OS(Windows))]
_io_sys_handle_from_bits(bits: long): FileHandle {
    return bits as FileHandle;
}

[Target(!OS(Windows))]
_io_sys_std_handle(stream: StdStream): FileHandle {
    return match (stream) {
        Input => 0,
        Output => 1,
        Error => 2,
    };
}

# ── O_* flags ────────────────────────────────────────────────────────────────

[Target(OS(Linux) || OS(Mac))]
_io_o_rdonly(): int { return 0; }

[Target(OS(Linux) || OS(Mac))]
_io_o_wronly(): int { return 1; }

[Target(OS(Linux) || OS(Mac))]
_io_o_rdwr(): int { return 2; }

[Target(OS(Linux))]
_io_o_creat(): int {
    return 64;
}  # 0x40

[Target(OS(Linux))]
_io_o_excl(): int {
    return 128;
}  # 0x80

[Target(OS(Linux))]
_io_o_trunc(): int {
    return 512;
}  # 0x200

[Target(OS(Linux))]
_io_o_append(): int {
    return 1024;
}  # 0x400

[Target(OS(Linux))]
_io_o_cloexec(): int {
    return 524288;
}  # 0x80000

[Target(OS(Mac))]
_io_o_creat(): int {
    return 512;
}  # 0x200

[Target(OS(Mac))]
_io_o_excl(): int {
    return 2048;
}  # 0x800

[Target(OS(Mac))]
_io_o_trunc(): int {
    return 1024;
}  # 0x400

[Target(OS(Mac))]
_io_o_append(): int {
    return 8;
}  # 0x8

[Target(OS(Mac))]
_io_o_cloexec(): int {
    return 16777216;
}  # 0x1000000

# WASI: the access mode is two rights bits, O_CREAT, O_EXCL and O_TRUNC are
# WASI's open flags shifted up 12, and there is no exec to close on.
[Target(OS(Wasi))]
_io_o_rdonly(): int {
    return 67108864;
}  # 0x4000000

[Target(OS(Wasi))]
_io_o_wronly(): int {
    return 268435456;
}  # 0x10000000

[Target(OS(Wasi))]
_io_o_rdwr(): int {
    return 335544320;
}  # 0x14000000

[Target(OS(Wasi))]
_io_o_creat(): int {
    return 4096;
}  # 0x1000

[Target(OS(Wasi))]
_io_o_excl(): int {
    return 16384;
}  # 0x4000

[Target(OS(Wasi))]
_io_o_trunc(): int {
    return 32768;
}  # 0x8000

[Target(OS(Wasi))]
_io_o_append(): int {
    return 1;
}

[Target(OS(Wasi))]
_io_o_cloexec(): int {
    return 0;
}

# ── File operations ──────────────────────────────────────────────────────────

[Target(!OS(Windows))]
_io_sys_open(path: Path, options: OpenOptions): IoResult<FileHandle> {
    if (path._value.size == 0) {
        return IoResult<FileHandle>.err(_io_posix_empty_path());
    }
    var writes = options._write || options._append;
    var flags = _io_o_rdonly();
    if (writes) {
        flags = _io_o_wronly();
        if (options._read) {
            flags = _io_o_rdwr();
        }
    }
    if (options._append) {
        flags = flags | _io_o_append();
    }
    if (options._truncate) {
        flags = flags | _io_o_trunc();
    }
    if (options._create) {
        flags = flags | _io_o_creat();
    }
    if (options._create_new) {
        flags = flags | _io_o_creat() | _io_o_excl();
    }
    flags = flags | _io_o_cloexec();
    while (true) {
        var fd = open(path._value.c_str(), flags, options._mode);  # less the umask
        if (fd >= 0) {
            return IoResult<FileHandle>.ok(fd);
        }
        var e = IoError.last();
        if (!e.is_interrupted()) {
            return IoResult<FileHandle>.err(e);
        }
    }
    return IoResult<FileHandle>.err(IoError(4, "interrupted"));
}

[Target(!OS(Windows))]
_io_sys_close(h: FileHandle): IoResult<void> {
    return _io_posix_check(close(h));
}

# One read/write call moves at most this many bytes (Linux caps at
# 0x7ffff000, macOS at INT_MAX).
[Target(!OS(Windows))]
_io_posix_max_rw(n: ulong): ulong {
    if (n > 2147479552) {
        return 2147479552;
    }
    return n;
}

[Target(!OS(Windows))]
_io_sys_read(h: FileHandle, dst: __ptr<u8>, n: ulong): IoResult<ulong> {
    while (true) {
        var r = read(h, dst, _io_posix_max_rw(n));
        if (r >= 0) {
            return IoResult<ulong>.ok(r as ulong);
        }
        var e = IoError.last();
        if (!e.is_interrupted()) {
            return IoResult<ulong>.err(e);
        }
    }
    return IoResult<ulong>.ok(0);
}

[Target(!OS(Windows))]
_io_sys_write(h: FileHandle, src: __ptr<u8>, n: ulong): IoResult<ulong> {
    while (true) {
        var r = write(h, src, _io_posix_max_rw(n));
        if (r >= 0) {
            return IoResult<ulong>.ok(r as ulong);
        }
        var e = IoError.last();
        if (!e.is_interrupted()) {
            return IoResult<ulong>.err(e);
        }
    }
    return IoResult<ulong>.ok(0);
}

# whence: 0 start, 1 current, 2 end (SEEK_SET/SEEK_CUR/SEEK_END).
[Target(!OS(Windows))]
_io_sys_seek(h: FileHandle, offset: Offset, whence: int): IoResult<Offset> {
    var r = lseek(h, offset, whence);
    if (r < 0) {
        return IoResult<Offset>.err(IoError.last());
    }
    return IoResult<Offset>.ok(r);
}

[Target(!OS(Windows))]
_io_sys_truncate(h: FileHandle, size: ulong): IoResult<void> {
    return _io_posix_check(ftruncate(h, size as long));
}

[Target(!OS(Windows))]
_io_sys_sync(h: FileHandle): IoResult<void> {
    return _io_posix_check(fsync(h));
}

# ── stat ─────────────────────────────────────────────────────────────────────
# Linux `struct statx` (x64 and aarch64 alike): stx_mask u32 @0,
# stx_mode u16 @28, stx_size u64 @40, then statx_timestamp {i64 sec;
# u32 nsec; i32 pad} for atime @64, btime @80, ctime @96, mtime @112; 256
# bytes in all.
# macOS `struct stat` (64-bit inode layout, x64 and aarch64 alike): st_mode
# u16 @4, timespec {i64 sec; i64 nsec} for atime @32, mtime @48, ctime @64,
# birthtime @80, st_size i64 @96; 144 bytes in all.
# wasi-libc `struct stat` (wasm32): st_mode u32 @24, st_size i64 @48,
# timespec {i64 sec; i32 nsec; pad} for atime @72, mtime @88, ctime @104;
# 144 bytes in all, and no birth time.

[Target(OS(Linux))]
_io_stat_buf_size(): ulong { return 256; }

[Target(OS(Linux))]
_io_stat_mode_offset(): ulong { return 28; }

[Target(OS(Linux))]
_io_stat_size_offset(): ulong { return 40; }

[Target(OS(Linux))]
_io_stat_atime_offset(): ulong { return 64; }

[Target(OS(Linux))]
_io_stat_btime_offset(): ulong { return 80; }

[Target(OS(Linux))]
_io_stat_mtime_offset(): ulong { return 112; }

[Target(OS(Mac))]
_io_stat_buf_size(): ulong { return 144; }

[Target(OS(Mac))]
_io_stat_mode_offset(): ulong { return 4; }

[Target(OS(Mac))]
_io_stat_size_offset(): ulong { return 96; }

[Target(OS(Mac))]
_io_stat_atime_offset(): ulong { return 32; }

[Target(OS(Mac))]
_io_stat_btime_offset(): ulong { return 80; }

[Target(OS(Mac))]
_io_stat_mtime_offset(): ulong { return 48; }

[Target(OS(Wasi))]
_io_stat_buf_size(): ulong { return 144; }

[Target(OS(Wasi))]
_io_stat_mode_offset(): ulong { return 24; }

[Target(OS(Wasi))]
_io_stat_size_offset(): ulong { return 48; }

[Target(OS(Wasi))]
_io_stat_atime_offset(): ulong { return 72; }

# Never read: `_io_stat_has_btime` is false.
[Target(OS(Wasi))]
_io_stat_btime_offset(): ulong { return 72; }

[Target(OS(Wasi))]
_io_stat_mtime_offset(): ulong { return 88; }

# statx reports a birth time only when the file system has one.
[Target(OS(Linux))]
_io_stat_has_btime(buf: __ptr<void>): bool {
    return ((buf as __ptr<uint>)[0] & 2048) != 0;  # STATX_BTIME
}

[Target(OS(Mac))]
_io_stat_has_btime(buf: __ptr<void>): bool {
    return true;
}

[Target(OS(Wasi))]
_io_stat_has_btime(buf: __ptr<void>): bool {
    return false;
}

# Whether st_mode carries permission bits: WASI preview 1 has none, and
# wasi-libc reports only the file type.
[Target(OS(Linux) || OS(Mac))]
_io_stat_has_permissions(): bool {
    return true;
}

[Target(OS(Wasi))]
_io_stat_has_permissions(): bool {
    return false;
}

# AT_FDCWD, AT_SYMLINK_NOFOLLOW, STATX_BASIC_STATS | STATX_BTIME.
[Target(OS(Linux))]
_io_stat_path(path: __ptr<char>, follow: bool, buf: __ptr<void>): int {
    var flags = 0;
    if (!follow) {
        flags = 256;
    }
    return statx(-100, path, flags, 4095, buf);
}

[Target(OS(Mac) || OS(Wasi))]
_io_stat_path(path: __ptr<char>, follow: bool, buf: __ptr<void>): int {
    if (follow) {
        return stat(path, buf);
    }
    return lstat(path, buf);
}

# statx on the descriptor itself: AT_EMPTY_PATH with "".
[Target(OS(Linux))]
_io_stat_fd(fd: int, buf: __ptr<void>): int {
    return statx(fd, "", 4096, 4095, buf);
}

[Target(OS(Mac) || OS(Wasi))]
_io_stat_fd(fd: int, buf: __ptr<void>): int {
    return fstat(fd, buf);
}

[Target(!OS(Windows))]
_io_read_u16(buf: __ptr<void>, offset: ulong): uint {
    return ((buf + offset) as __ptr<u16>)[0];
}

[Target(!OS(Windows))]
_io_read_i64(buf: __ptr<void>, offset: ulong): long {
    return ((buf + offset) as __ptr<long>)[0];
}

[Target(!OS(Windows))]
_io_read_u32(buf: __ptr<void>, offset: ulong): uint {
    return ((buf + offset) as __ptr<uint>)[0];
}

# A {seconds, nanoseconds} pair as ns since the epoch. The nanoseconds are
# read as 32 bits: statx stores a u32, macOS a long whose value (< 10^9) sits
# in its low half, and wasi-libc a 32-bit long.
[Target(!OS(Windows))]
_io_stat_time(buf: __ptr<void>, offset: ulong): long {
    var sec = _io_read_i64(buf, offset);
    var nsec = _io_read_u32(buf, offset + 8) as long;
    return sec * 1000000000 + nsec;
}

[Target(!OS(Windows))]
_io_metadata_from_stat(buf: __ptr<void>): Metadata {
    var m = Metadata();
    var mode = _io_read_u16(buf, _io_stat_mode_offset());
    var kind = mode & 61440;         # S_IFMT 0170000
    m.is_file = kind == 32768;       # S_IFREG 0100000
    m.is_directory = kind == 16384;  # S_IFDIR 0040000
    m.is_symlink = kind == 40960;    # S_IFLNK 0120000
    m.file_type = _io_file_type(m.is_file, m.is_directory, m.is_symlink);
    if (_io_stat_has_permissions()) {
        m.permissions = mode & 4095;      # 07777
        m.read_only = (mode & 146) == 0;  # no 0222 write bit
    }
    m.size = _io_read_i64(buf, _io_stat_size_offset()) as ulong;
    m.accessed = _io_stat_time(buf, _io_stat_atime_offset());
    m.modified = _io_stat_time(buf, _io_stat_mtime_offset());
    if (_io_stat_has_btime(buf)) {
        m.created = Optional<long>.Value(_io_stat_time(buf, _io_stat_btime_offset()));
    }
    return m;
}

[Target(!OS(Windows))]
_io_sys_stat(path: Path, follow: bool): IoResult<Metadata> {
    if (path._value.size == 0) {
        return IoResult<Metadata>.err(_io_posix_empty_path());
    }
    var buf = _IoBuffer(_io_stat_buf_size());
    return _io_posix_stat_result(_io_stat_path(path._value.c_str(), follow, buf._bytes), buf);
}

[Target(!OS(Windows))]
_io_sys_fstat(h: FileHandle): IoResult<Metadata> {
    var buf = _IoBuffer(_io_stat_buf_size());
    return _io_posix_stat_result(_io_stat_fd(h, buf._bytes), buf);
}

# The metadata a stat call that returned `rc` wrote into `buf`, or errno.
[Target(!OS(Windows))]
_io_posix_stat_result(rc: int, buf: _IoBuffer): IoResult<Metadata> {
    if (rc != 0) {
        return IoResult<Metadata>.err(IoError.last());
    }
    return IoResult<Metadata>.ok(_io_metadata_from_stat(buf._bytes));
}

# ── Directories ──────────────────────────────────────────────────────────────
# dirent: d_type u8 and d_name char[] at 18/19 (Linux dirent64), 20/21
# (macOS 64-bit inode dirent) or 8/9 (wasi-libc). d_type's values are
# DT_DIR 4, DT_REG 8 and DT_LNK 10, except on WASI, whose are its file
# types: 3, 4 and 7.

[Target(OS(Linux))]
_io_dirent_type_offset(): ulong { return 18; }

[Target(OS(Linux))]
_io_dirent_name_offset(): ulong { return 19; }

[Target(OS(Mac))]
_io_dirent_type_offset(): ulong { return 20; }

[Target(OS(Mac))]
_io_dirent_name_offset(): ulong { return 21; }

[Target(OS(Wasi))]
_io_dirent_type_offset(): ulong { return 8; }

[Target(OS(Wasi))]
_io_dirent_name_offset(): ulong { return 9; }

[Target(OS(Linux) || OS(Mac))]
_io_dirent_directory(): u8 { return 4; }

[Target(OS(Linux) || OS(Mac))]
_io_dirent_file(): u8 { return 8; }

[Target(OS(Linux) || OS(Mac))]
_io_dirent_symlink(): u8 { return 10; }

[Target(OS(Wasi))]
_io_dirent_directory(): u8 { return 3; }

[Target(OS(Wasi))]
_io_dirent_file(): u8 { return 4; }

[Target(OS(Wasi))]
_io_dirent_symlink(): u8 { return 7; }

# Opens the listing of `iterator._path` and reads its first entry into
# `iterator._entry`: false when there is none.
[Target(!OS(Windows))]
_io_sys_directory_first(iterator: DirectoryIterator): IoResult<bool> {
    if (iterator._path._value.size == 0) {
        return IoResult<bool>.err(_io_posix_empty_path());
    }
    iterator._handle = opendir(iterator._path._value.c_str());
    if (iterator._handle == __null) {
        return IoResult<bool>.err(IoError.last());
    }
    return _io_sys_directory_next(iterator);
}

# Reads the next entry of an open listing into `iterator._entry`, skipping
# `.` and `..`: false at the end.
[Target(!OS(Windows))]
_io_sys_directory_next(iterator: DirectoryIterator): IoResult<bool> {
    while (true) {
        # readdir returns null at the end and on error; only errno tells.
        _io_errno()[0] = 0;
        var ent: __ptr<u8> = readdir(iterator._handle);
        if (ent == __null) {
            var code = _io_sys_last_error();
            if (code != 0) {
                return IoResult<bool>.err(IoError(code, _io_sys_error_message(code)));
            }
            return IoResult<bool>.ok(false);
        }
        var name = String(unsafe_cast<__ptr<char>>(ent + _io_dirent_name_offset()));
        if (name == "." || name == "..") {
            continue;
        }
        var entry = DirEntry();
        entry.name = name;
        entry.path = iterator._path.join(Path(name));
        var kind = ent[_io_dirent_type_offset()];
        if (kind == 0) {
            # DT_UNKNOWN: the file system did not say; ask lstat.
            var m = _io_sys_stat(entry.path, false);
            if (m.is_ok()) {
                entry.is_file = m.value().is_file;
                entry.is_directory = m.value().is_directory;
                entry.is_symlink = m.value().is_symlink;
                entry.file_type = m.value().file_type;
            }
        } else {
            entry.is_directory = kind == _io_dirent_directory();
            entry.is_file = kind == _io_dirent_file();
            entry.is_symlink = kind == _io_dirent_symlink();
            entry.file_type = _io_file_type(entry.is_file, entry.is_directory, entry.is_symlink);
        }
        iterator._entry = entry;
        return IoResult<bool>.ok(true);
    }
}

# Closes an open listing.
[Target(!OS(Windows))]
_io_sys_directory_close(handle: __ptr<void>) {
    closedir(handle);
}

[Target(!OS(Windows))]
_io_sys_mkdir(path: Path, mode: Mode): IoResult<void> {
    if (path._value.size == 0) {
        return IoResult<void>.err(_io_posix_empty_path());
    }
    return _io_posix_check(mkdir(path._value.c_str(), mode));  # less the umask
}

[Target(!OS(Windows))]
_io_sys_rmdir(path: Path): IoResult<void> {
    if (path._value.size == 0) {
        return IoResult<void>.err(_io_posix_empty_path());
    }
    return _io_posix_check(rmdir(path._value.c_str()));
}

[Target(!OS(Windows))]
_io_sys_unlink(path: Path): IoResult<void> {
    if (path._value.size == 0) {
        return IoResult<void>.err(_io_posix_empty_path());
    }
    return _io_posix_check(unlink(path._value.c_str()));
}

# Remove a non-directory or a symlink (to anything); `unlink` handles both.
[Target(!OS(Windows))]
_io_sys_remove_link(path: Path, is_dir: bool): IoResult<void> {
    return _io_sys_unlink(path);
}

[Target(!OS(Windows))]
_io_sys_rename(from: Path, to: Path): IoResult<void> {
    if (from._value.size == 0 || to._value.size == 0) {
        return IoResult<void>.err(_io_posix_empty_path());
    }
    return _io_posix_check(rename(from._value.c_str(), to._value.c_str()));
}

[Target(!OS(Windows))]
_io_sys_getcwd(): IoResult<Path> {
    ulong size = 4096;
    while (true) {
        var buf = _IoBuffer(size);
        var r = getcwd(unsafe_cast<__ptr<char>>(buf._bytes), size);
        if (r != __null) {
            return IoResult<Path>.ok(Path(_io_string_from_c(r)));
        }
        var e = IoError.last();
        if (e.code != _io_posix_code_range()) {  # retry with a bigger buffer
            return IoResult<Path>.err(e);
        }
        size = size * 2;
    }
    return IoResult<Path>.err(IoError(_io_posix_code_range(), "path too long"));
}

[Target(!OS(Windows))]
_io_sys_chdir(path: Path): IoResult<void> {
    if (path._value.size == 0) {
        return IoResult<void>.err(_io_posix_empty_path());
    }
    return _io_posix_check(chdir(path._value.c_str()));
}

[Target(!OS(Windows))]
_io_sys_realpath(path: Path): IoResult<Path> {
    if (path._value.size == 0) {
        return IoResult<Path>.err(_io_posix_empty_path());
    }
    var buf = _IoBuffer(4096);  # PATH_MAX (Linux 4096, macOS 1024)
    var r = realpath(path._value.c_str(), unsafe_cast<__ptr<char>>(buf._bytes));
    if (r == __null) {
        return IoResult<Path>.err(IoError.last());
    }
    return IoResult<Path>.ok(Path(_io_string_from_c(r)));
}

# Android has no /tmp; /data/local/tmp is the one any process may write.
[Target(!OS(Windows) && !OS(Android))]
_io_default_temp_dir(): String { return "/tmp"; }

[Target(OS(Android))]
_io_default_temp_dir(): String { return "/data/local/tmp"; }

[Target(!OS(Windows))]
export _io_sys_temp_dir(): Path {
    var s = String(getenv("TMPDIR"));
    if (s.size == 0) {
        return Path(_io_default_temp_dir());
    }
    # macOS's TMPDIR ends in '/'.
    var p = unsafe_cast<__ptr<u8>>(s.c_str());
    var n = s.size;
    while (n > 1 && _io_byte(p, s.size, n - 1) == '/') {
        n = n - 1;
    }
    return Path(_io_slice(s, 0, n));
}

# ── Permissions, times and links ─────────────────────────────────────────────

[Target(OS(Linux) || OS(Mac))]
_io_sys_chmod(path: Path, mode: Mode): IoResult<void> {
    if (path._value.size == 0) {
        return IoResult<void>.err(_io_posix_empty_path());
    }
    return _io_posix_check(chmod(path._value.c_str(), mode));
}

[Target(OS(Linux) || OS(Mac))]
_io_sys_fchmod(h: FileHandle, mode: Mode): IoResult<void> {
    return _io_posix_check(fchmod(h, mode));
}

# WASI's ENOTSUP.
[Target(OS(Wasi))]
_io_wasi_no_permissions(): IoResult<void> {
    return IoResult<void>.err(IoError(58, "WASI has no permission bits"));
}

[Target(OS(Wasi))]
_io_sys_chmod(path: Path, mode: Mode): IoResult<void> {
    return _io_wasi_no_permissions();
}

[Target(OS(Wasi))]
_io_sys_fchmod(h: FileHandle, mode: Mode): IoResult<void> {
    return _io_wasi_no_permissions();
}

# `current` with every write bit (0222) cleared, or with the owner's (0200)
# set: making a file writable never opens it to group or others.
[Target(!OS(Windows))]
_io_sys_read_only_mode(current: Mode, read_only: bool): Mode {
    if (read_only) {
        return (current | 146) ^ 146;
    }
    return current | 128;
}

# `current` with an execute bit (0111) for each class that may read it
# (0444), as `chmod +x` gives, or with every execute bit cleared.
[Target(!OS(Windows))]
_io_sys_executable_mode(current: Mode, executable: bool): Mode {
    if (executable) {
        return current | ((current & 292) >> 2);
    }
    return (current | 73) ^ 73;
}

# AT_FDCWD.
[Target(OS(Linux))]
_io_at_fdcwd(): int { return -100; }

[Target(OS(Mac) || OS(Wasi))]
_io_at_fdcwd(): int { return -2; }

# UTIME_OMIT, for the time a `utimensat` leaves alone.
[Target(OS(Linux))]
_io_utime_omit(): long { return 1073741822; }

[Target(OS(Mac) || OS(Wasi))]
_io_utime_omit(): long { return -2; }

# Writes the two timespecs `utimensat` and `futimens` take (access, then
# modification) into a 32-byte buffer. The nanoseconds are written as 64
# bits: wasi-libc's 32-bit `long` takes the low half, and the rest is
# padding.
[Target(!OS(Windows))]
_io_posix_times(accessed: long?, modified: long?): _IoBuffer {
    var buf = _IoBuffer(32);
    _io_posix_timespec(buf._bytes, accessed);
    _io_posix_timespec(buf._bytes + 16, modified);
    return buf;
}

[Target(!OS(Windows))]
_io_posix_timespec(at: __ptr<u8>, time: long?) {
    var fields = unsafe_cast<__ptr<long>>(at);
    if (time.is_empty()) {
        fields[0] = 0;
        fields[1] = _io_utime_omit();
        return;
    }
    var ns = time.value();
    var seconds = ns / 1000000000;
    var rest = ns - seconds * 1000000000;
    if (rest < 0) {  # division truncates toward zero
        seconds = seconds - 1;
        rest = rest + 1000000000;
    }
    fields[0] = seconds;
    fields[1] = rest;
}

[Target(!OS(Windows))]
_io_sys_set_times(path: Path, accessed: long?, modified: long?): IoResult<void> {
    if (path._value.size == 0) {
        return IoResult<void>.err(_io_posix_empty_path());
    }
    var times = _io_posix_times(accessed, modified);
    return _io_posix_check(utimensat(_io_at_fdcwd(), path._value.c_str(), times._bytes, 0));
}

[Target(!OS(Windows))]
_io_sys_fset_times(h: FileHandle, accessed: long?, modified: long?): IoResult<void> {
    var times = _io_posix_times(accessed, modified);
    return _io_posix_check(futimens(h, times._bytes));
}

# POSIX makes one kind of symlink, whatever it points to.
[Target(!OS(Windows))]
_io_sys_symlink(target: Path, link: Path, directory: bool): IoResult<void> {
    if (target._value.size == 0 || link._value.size == 0) {
        return IoResult<void>.err(_io_posix_empty_path());
    }
    return _io_posix_check(symlink(target._value.c_str(), link._value.c_str()));
}

[Target(!OS(Windows))]
_io_sys_hard_link(from: Path, to: Path): IoResult<void> {
    if (from._value.size == 0 || to._value.size == 0) {
        return IoResult<void>.err(_io_posix_empty_path());
    }
    return _io_posix_check(link(from._value.c_str(), to._value.c_str()));
}

# readlink does not say when the buffer was too small, only fills it: retry
# with a bigger one until the target fits with room to spare.
[Target(!OS(Windows))]
_io_sys_readlink(path: Path): IoResult<Path> {
    if (path._value.size == 0) {
        return IoResult<Path>.err(_io_posix_empty_path());
    }
    ulong size = 256;
    while (true) {
        var buf = _IoBuffer(size);
        var n = readlink(path._value.c_str(), unsafe_cast<__ptr<char>>(buf._bytes), size);
        if (n < 0) {
            return IoResult<Path>.err(IoError.last());
        }
        if ((n as ulong) < size) {
            return IoResult<Path>.ok(Path(_io_string_from(unsafe_cast<__ptr<char>>(buf._bytes), n as ulong)));
        }
        size = size * 2;
    }
    return IoResult<Path>.err(IoError(_io_posix_code_range(), "link target too long"));
}
io/sys_windows
31977
# Windows platform layer for io. Every declaration carries
# [Target(OS(Windows))]; sys_posix.pep declares the same `_io_sys_*`
# functions with the same signatures for Linux and macOS. These are exported
# to the other io files only: module.pep does not re-export them.
#
# Paths go through the UTF-16 *W APIs: UTF-8 Strings are converted with
# MultiByteToWideChar into NUL-terminated `__ptr<u16>` buffers (freed by the
# caller) and back with WideCharToMultiByte. Everything here is in kernel32,
# which is linked by default. C structs are read from raw `_pep_malloc`
# buffers at fixed byte offsets (identical on x64 and aarch64).

import "directory";
import "file";
import "path";
import "types";

# ── C functions (kernel32) ───────────────────────────────────────────────────

[Target(OS(Windows))]
extern void* CreateFileW(
    ushort* name, uint access, uint share, void* security, uint disposition, uint flags, void* template
);
[Target(OS(Windows))]
extern int ReadFile(void* h, void* buf, uint n, uint* done, void* overlapped);
[Target(OS(Windows))]
extern int WriteFile(void* h, void* buf, uint n, uint* done, void* overlapped);
[Target(OS(Windows))]
extern int CloseHandle(void* h);
[Target(OS(Windows))]
extern int SetFilePointerEx(void* h, long distance, long* position, uint method);
[Target(OS(Windows))]
extern int SetFileInformationByHandle(void* h, int info_class, void* info, uint size);
[Target(OS(Windows))]
extern int FlushFileBuffers(void* h);
[Target(OS(Windows))]
extern int SetFileTime(void* h, void* created, void* accessed, void* written);
[Target(OS(Windows))]
extern u8 CreateSymbolicLinkW(ushort* link, ushort* target, uint flags);
[Target(OS(Windows))]
extern int DeviceIoControl(
    void* h, uint code, void* input, uint input_size, void* output, uint output_size, uint* returned, void* overlapped
);
[Target(OS(Windows))]
extern int GetFileInformationByHandle(void* h, void* info);
[Target(OS(Windows))]
extern void* FindFirstFileW(ushort* pattern, void* data);
[Target(OS(Windows))]
extern int FindNextFileW(void* h, void* data);
[Target(OS(Windows))]
extern int FindClose(void* h);
[Target(OS(Windows))]
extern int CreateDirectoryW(ushort* path, void* security);
[Target(OS(Windows))]
extern int RemoveDirectoryW(ushort* path);
[Target(OS(Windows))]
extern int DeleteFileW(ushort* path);
[Target(OS(Windows))]
extern int CreateHardLinkW(ushort* link, ushort* existing, void* security);
[Target(OS(Windows))]
extern int MoveFileExW(ushort* from, ushort* to, uint flags);
[Target(OS(Windows))]
extern uint GetFullPathNameW(ushort* name, uint size, ushort* buf, void* file_part);
[Target(OS(Windows))]
extern uint GetCurrentDirectoryW(uint size, ushort* buf);
[Target(OS(Windows))]
extern int SetCurrentDirectoryW(ushort* path);
[Target(OS(Windows))]
extern uint GetFinalPathNameByHandleW(void* h, ushort* buf, uint size, uint flags);
[Target(OS(Windows))]
extern uint GetTempPathW(uint size, ushort* buf);
[Target(OS(Windows))]
extern void* GetStdHandle(uint which);
[Target(OS(Windows))]
extern uint GetLastError();
[Target(OS(Windows))]
extern uint FormatMessageW(uint flags, void* source, uint id, uint language, ushort* buf, uint size, void* args);
[Target(OS(Windows))]
extern int MultiByteToWideChar(uint codepage, uint flags, char* src, int src_len, ushort* dst, int dst_len);

# ── UTF-8 <-> UTF-16 ─────────────────────────────────────────────────────────

# A NUL-terminated UTF-16 copy of `s`; the caller frees it with _pep_free.
# One UTF-8 byte never yields more than one UTF-16 unit, so Size + 1 units
# always suffice.
[Target(OS(Windows))]
export _io_win_wide(s: String): __ptr<u16> {
    var units = s.size + 1;
    var w = _pep_malloc(units * 2) as __ptr<u16>;
    if (s.size > 0) {
        MultiByteToWideChar(65001, 0, s.c_str(), s.size as int, w, units as int);  # CP_UTF8
    }
    return w;
}

# Number of UTF-16 units before the terminating NUL.
[Target(OS(Windows))]
export _io_win_wide_len(w: __ptr<u16>): int {
    var n = 0;
    while (w[n] != 0) {
        n = n + 1;
    }
    return n;
}

# `n` UTF-16 units at `w` as a UTF-8 String.
[Target(OS(Windows))]
export _io_win_narrow(w: __ptr<u16>, n: int): String {
    return _pep_win_narrow(w, n);
}

# ── Errors ───────────────────────────────────────────────────────────────────

[Target(OS(Windows))]
_io_sys_last_error(): ErrorCode {
    return GetLastError();
}

# FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_IGNORE_INSERTS, trailing
# whitespace (the ". \r\n" tail) trimmed.
[Target(OS(Windows))]
export _io_sys_error_message(code: ErrorCode): String {
    var buf = _pep_malloc(1024) as __ptr<u16>;
    var n = FormatMessageW(4608, __null, code, 0, buf, 512, __null) as int;
    while (n > 0) {
        var c = buf[n - 1];
        if (c != '\n' && c != '\r' && c != ' ' && c != '.') {
            break;
        }
        n = n - 1;
    }
    var s = _io_win_narrow(buf, n);
    _pep_free(buf);
    if (s.size == 0) {
        return "unknown error";
    }
    return s;
}

# The ErrorKind of a GetLastError() / WSAGetLastError() code.
[Target(OS(Windows))]
_io_sys_error_kind(code: ErrorCode): ErrorKind {
    return match (code) {
        2, 3 => ErrorKind.NotFound,                    # FILE_NOT_FOUND, PATH_NOT_FOUND
        5, 1314 => ErrorKind.PermissionDenied,         # ACCESS_DENIED, PRIVILEGE_NOT_HELD
        80, 183 => ErrorKind.AlreadyExists,            # FILE_EXISTS, ALREADY_EXISTS
        267 => ErrorKind.NotADirectory,                # DIRECTORY (invalid directory name)
        336 => ErrorKind.IsADirectory,                 # DIRECTORY_NOT_SUPPORTED
        145 => ErrorKind.DirectoryNotEmpty,            # DIR_NOT_EMPTY
        87, 123, 131, 4390 => ErrorKind.InvalidInput,  # INVALID_PARAMETER, INVALID_NAME, NEGATIVE_SEEK, NOT_A_REPARSE_POINT
        10004 => ErrorKind.Interrupted,                # WSAEINTR
        10061 => ErrorKind.ConnectionRefused,          # WSAECONNREFUSED
        10054, 10053 => ErrorKind.ConnectionReset,     # WSAECONNRESET, WSAECONNABORTED
        10048 => ErrorKind.AddressInUse,               # WSAEADDRINUSE
        10049 => ErrorKind.AddressNotAvailable,        # WSAEADDRNOTAVAIL
        10060 => ErrorKind.TimedOut,                   # WSAETIMEDOUT
        995, 1223 => ErrorKind.Cancelled,              # OPERATION_ABORTED, CANCELLED
        else => ErrorKind.Other,
    };
}

# Codes for errors Pepper raises itself.
[Target(OS(Windows))]
export _io_sys_code_invalid_input(): ErrorCode {
    return 87;
}  # INVALID_PARAMETER

[Target(OS(Windows))]
_io_sys_code_not_a_directory(): ErrorCode {
    return 267;
}  # DIRECTORY

[Target(OS(Windows))]
_io_sys_code_not_found(): ErrorCode {
    return 2;
}  # FILE_NOT_FOUND

[Target(OS(Windows))]
_io_sys_code_bad_handle(): ErrorCode {
    return 6;
}  # INVALID_HANDLE

[Target(OS(Windows))]
export _io_sys_code_write_zero(): ErrorCode {
    return 29;
}  # WRITE_FAULT

[Target(OS(Windows))]
_io_sys_code_cancelled(): ErrorCode {
    return 995;
}  # OPERATION_ABORTED

# A BOOL result: nonzero -> Ok, 0 -> the GetLastError() error.
[Target(OS(Windows))]
_io_win_check(ok: int): IoResult<void> {
    if (ok != 0) {
        return _io_ok_void();
    }
    return IoResult<void>.err(IoError.last());
}

# A BOOL result `ok`, with `code`, the GetLastError() read right after the
# call (before freeing its arguments could change it): nonzero -> Ok, 0 ->
# that error.
[Target(OS(Windows))]
_io_win_check_code(ok: int, code: ErrorCode): IoResult<void> {
    if (ok != 0) {
        return _io_ok_void();
    }
    return IoResult<void>.err(IoError(code, _io_sys_error_message(code)));
}

# ── Handles ──────────────────────────────────────────────────────────────────

[Target(OS(Windows))]
_io_sys_invalid_handle(): FileHandle {
    return __null;
}

# Neither null nor INVALID_HANDLE_VALUE (-1).
[Target(OS(Windows))]
_io_sys_handle_valid(h: FileHandle): bool {
    return h != __null && unsafe_cast<long>(h) != -1;
}

# `h` as a number, for a `FileTransfer`.
[Target(OS(Windows))]
_io_sys_handle_bits(h: FileHandle): long {
    return unsafe_cast<long>(h);
}

# The handle `_io_sys_handle_bits` gave `bits` for.
[Target(OS(Windows))]
_io_sys_handle_from_bits(bits: long): FileHandle {
    return unsafe_cast<FileHandle>(bits);
}

# STD_INPUT_HANDLE, STD_OUTPUT_HANDLE, STD_ERROR_HANDLE are (DWORD)-10,
# -11 and -12.
[Target(OS(Windows))]
_io_sys_std_handle(stream: StdStream): FileHandle {
    uint which = match (stream) {
        Input => 4294967286,   # STD_INPUT_HANDLE (-10)
        Output => 4294967285,  # STD_OUTPUT_HANDLE (-11)
        Error => 4294967284,   # STD_ERROR_HANDLE (-12)
    };
    return GetStdHandle(which);
}

# CreateFileW sharing everything (FILE_SHARE_READ | WRITE | DELETE) with
# FILE_FLAG_BACKUP_SEMANTICS, so directories open too.
[Target(OS(Windows))]
_io_win_create(path: Path, access: ulong, disposition: uint, extra_flags: ulong): IoResult<FileHandle> {
    var w = _io_win_path(path);
    var flags = 33554560 | extra_flags;  # BACKUP_SEMANTICS | ATTRIBUTE_NORMAL
    var h = CreateFileW(w, access as uint, 7, __null, disposition, flags as uint, __null);
    var code = GetLastError();
    _pep_free(w);
    if (!_io_sys_handle_valid(h)) {
        return IoResult<FileHandle>.err(IoError(code, _io_sys_error_message(code)));
    }
    return IoResult<FileHandle>.ok(h);
}

# A NUL-terminated UTF-16 copy of `path` for the *W file functions; the
# caller frees it with _pep_free. A path that is 248 units or more once
# absolute (the room CreateDirectoryW leaves under MAX_PATH) is made
# absolute and given the `\\?\` prefix (`\\?\UNC\` for `\\server\share`),
# which lifts the limit to 32767 units whatever the system's long-path
# setting. That prefix turns off Win32's own normalizing (`/`,
# `.`, `..`), so GetFullPathNameW does it first, as Rust's std does.
[Target(OS(Windows))]
_io_win_path(path: Path): __ptr<u16> {
    var s = path._value;
    var w = _io_win_wide(s);
    if ((s.size < 248 && path.is_absolute()) || s.starts_with("\\\\?\\") || s.starts_with("\\\\.\\")) {
        return w;
    }
    var need = GetFullPathNameW(w, 0, __null, __null);
    if (need == 0) {
        return w;
    }
    var full = _pep_malloc((need as ulong) * 2) as __ptr<u16>;
    var n = GetFullPathNameW(w, need, full, __null) as int;
    if (n < 248 || n >= (need as int)) {
        _pep_free(full);
        return w;
    }
    _pep_free(w);
    var absolute = _io_win_narrow(full, n);
    _pep_free(full);
    if (absolute.starts_with("\\\\")) {
        return _io_win_wide("\\\\?\\UNC\\" + _io_slice(absolute, 2, absolute.size));
    }
    return _io_win_wide("\\\\?\\" + absolute);
}

# ── File operations ──────────────────────────────────────────────────────────

[Target(OS(Windows))]
_io_sys_open(path: Path, options: OpenOptions): IoResult<FileHandle> {
    ulong access = 0;
    if (options._read) {
        access = access | 2147483648;  # GENERIC_READ
    }
    if (options._append) {
        # FILE_GENERIC_WRITE without FILE_WRITE_DATA: writes only append.
        access = access | 1179924;
    } else {
        if (options._write) {
            access = access | 1073741824;  # GENERIC_WRITE
        }
    }
    uint disposition = 3;  # OPEN_EXISTING
    if (options._truncate) {
        disposition = 5;  # TRUNCATE_EXISTING
    }
    if (options._create) {
        disposition = 4;  # OPEN_ALWAYS
        if (options._truncate) {
            disposition = 2;  # CREATE_ALWAYS
        }
    }
    if (options._create_new) {
        disposition = 1;  # CREATE_NEW
    }
    return _io_win_create(path, access, disposition, 0);
}

[Target(OS(Windows))]
_io_sys_close(h: FileHandle): IoResult<void> {
    return _io_win_check(CloseHandle(h));
}

# One ReadFile/WriteFile call moves at most 1 GiB (the count is a DWORD);
# sockets use the same limit (their length is an int).
[Target(OS(Windows))]
_io_win_max_rw(n: ulong): uint {
    if (n > 1073741824) {
        return 1073741824;
    }
    return n as uint;
}

[Target(OS(Windows))]
_io_sys_read(h: FileHandle, dst: __ptr<u8>, n: ulong): IoResult<ulong> {
    var done = _pep_malloc(4) as __ptr<uint>;
    var ok = ReadFile(h, dst, _io_win_max_rw(n), done, __null);
    var count = done[0] as ulong;
    _pep_free(done);
    if (ok == 0) {
        var code = GetLastError();
        if (code == 109) {  # BROKEN_PIPE: the writer closed; EOF
            return IoResult<ulong>.ok(0);
        }
        if (code == 1) {
            # INVALID_FUNCTION is what ReadFile says about a directory handle
            # (opened with BACKUP_SEMANTICS); report it as POSIX's EISDIR does.
            var m = _io_sys_fstat(h);
            if (m.is_ok() && m.value().is_directory) {
                code = 336;  # DIRECTORY_NOT_SUPPORTED: is_is_a_directory
            }
        }
        return IoResult<ulong>.err(IoError(code, _io_sys_error_message(code)));
    }
    return IoResult<ulong>.ok(count);
}

[Target(OS(Windows))]
_io_sys_write(h: FileHandle, src: __ptr<u8>, n: ulong): IoResult<ulong> {
    var done = _pep_malloc(4) as __ptr<uint>;
    var ok = WriteFile(h, src, _io_win_max_rw(n), done, __null);
    var count = done[0] as ulong;
    _pep_free(done);
    if (ok == 0) {
        return IoResult<ulong>.err(IoError.last());
    }
    return IoResult<ulong>.ok(count);
}

# whence: 0 FILE_BEGIN, 1 FILE_CURRENT, 2 FILE_END (the POSIX values).
[Target(OS(Windows))]
_io_sys_seek(h: FileHandle, offset: Offset, whence: int): IoResult<Offset> {
    var pos = _pep_malloc(8) as __ptr<long>;
    var ok = SetFilePointerEx(h, offset, pos, whence as uint);
    var at = pos[0];
    _pep_free(pos);
    if (ok == 0) {
        return IoResult<Offset>.err(IoError.last());
    }
    return IoResult<Offset>.ok(at);
}

# FILE_END_OF_FILE_INFO through SetFileInformationByHandle(FileEndOfFileInfo):
# unlike SetEndOfFile it leaves the file pointer where it is.
[Target(OS(Windows))]
_io_sys_truncate(h: FileHandle, size: ulong): IoResult<void> {
    var info = _pep_malloc(8) as __ptr<long>;
    info[0] = size as long;
    var ok = SetFileInformationByHandle(h, 6, info, 8);
    var code = GetLastError();
    _pep_free(info);
    return _io_win_check_code(ok, code);
}

[Target(OS(Windows))]
_io_sys_sync(h: FileHandle): IoResult<void> {
    return _io_win_check(FlushFileBuffers(h));
}

# ── Metadata ─────────────────────────────────────────────────────────────────
# BY_HANDLE_FILE_INFORMATION (52 bytes): dwFileAttributes u32 @0, FILETIMEs
# {u32 low; u32 high} for creation @4, last access @12, last write @20,
# nFileSizeHigh @32, nFileSizeLow @36.

[Target(OS(Windows))]
_io_win_u32(buf: __ptr<void>, offset: ulong): ulong {
    return ((buf + offset) as __ptr<uint>)[0] as ulong;
}

# A FILETIME (100 ns ticks since 1601) as ns since the Unix epoch; 0 stays 0.
[Target(OS(Windows))]
_io_win_time(buf: __ptr<void>, offset: ulong): long {
    var ticks = ((_io_win_u32(buf, offset + 4) << 32) | _io_win_u32(buf, offset)) as long;
    if (ticks == 0) {
        return 0;
    }
    return (ticks - 116444736000000000) * 100;
}

[Target(OS(Windows))]
_io_win_metadata(
    buf: __ptr<void>,
    attrs_offset: ulong,
    created: ulong,
    accessed: ulong,
    written: ulong,
    size_high: ulong,
    size_low: ulong
): Metadata {
    var m = Metadata();
    var attrs = _io_win_u32(buf, attrs_offset);
    m.is_directory = (attrs & 16) != 0;  # FILE_ATTRIBUTE_DIRECTORY
    m.is_symlink = (attrs & 1024) != 0;  # FILE_ATTRIBUTE_REPARSE_POINT
    m.is_file = !m.is_directory && !m.is_symlink;
    m.file_type = _io_file_type(m.is_file, m.is_directory, m.is_symlink);
    m.read_only = (attrs & 1) != 0;  # FILE_ATTRIBUTE_READONLY
    m.permissions = attrs as uint;
    m.size = (_io_win_u32(buf, size_high) << 32) | _io_win_u32(buf, size_low);
    var born = _io_win_time(buf, created);
    if (born != 0) {
        m.created = Optional<long>.Value(born);
    }
    m.accessed = _io_win_time(buf, accessed);
    m.modified = _io_win_time(buf, written);
    return m;
}

[Target(OS(Windows))]
_io_sys_fstat(h: FileHandle): IoResult<Metadata> {
    var info = _IoBuffer(52);
    if (GetFileInformationByHandle(h, info._bytes) == 0) {
        return IoResult<Metadata>.err(IoError.last());
    }
    return IoResult<Metadata>.ok(_io_win_metadata(info._bytes, 0, 4, 12, 20, 32, 36));
}

# Opens the path for no access (attributes only); without `follow`,
# FILE_FLAG_OPEN_REPARSE_POINT opens a symlink itself.
[Target(OS(Windows))]
_io_win_open_query(path: Path, follow: bool): IoResult<FileHandle> {
    ulong extra = 0;
    if (!follow) {
        extra = 2097152;  # FILE_FLAG_OPEN_REPARSE_POINT
    }
    return _io_win_create(path, 0, 3, extra);
}

[Target(OS(Windows))]
_io_sys_stat(path: Path, follow: bool): IoResult<Metadata> {
    var h = _io_win_open_query(path, follow);
    if (h.is_err()) {
        return IoResult<Metadata>.err(h.error());
    }
    var m = _io_sys_fstat(h.value());
    CloseHandle(h.value());
    return m;
}

# ── Directories ──────────────────────────────────────────────────────────────
# WIN32_FIND_DATAW (592 bytes): dwFileAttributes @0, FILETIMEs @4/@12/@20,
# nFileSizeHigh @28, nFileSizeLow @32, cFileName (NUL-terminated WCHAR[260])
# @44.

# Opens the listing of `iterator._path` and reads its first entry into
# `iterator._entry`: false when there is none.
[Target(OS(Windows))]
_io_sys_directory_first(iterator: DirectoryIterator): IoResult<bool> {
    var path = iterator._path;
    # An empty path would search `*`, the current directory; POSIX fails.
    if (path._value.size == 0) {
        return IoResult<bool>.err(IoError(_io_sys_code_not_found(), "empty path"));
    }
    var w = _io_win_path(path.join(Path("*")));
    iterator._data = _pep_malloc(592);
    var h = FindFirstFileW(w, iterator._data);
    _pep_free(w);
    if (!_io_sys_handle_valid(h)) {
        var e = IoError.last();
        # FILE_NOT_FOUND means nothing matched `*`: an empty directory with
        # no `.` or `..` entries, as a drive root is. A missing directory
        # says PATH_NOT_FOUND, but confirm it is a directory regardless.
        if (e.code == 2) {
            var m = _io_sys_stat(path, true);
            if (m.is_ok() && m.value().is_directory) {
                return IoResult<bool>.ok(false);
            }
        }
        return IoResult<bool>.err(e);
    }
    iterator._handle = h;
    # FindFirstFileW already read the first entry into `_data`.
    iterator._pending = true;
    return _io_sys_directory_next(iterator);
}

# Reads the next entry of an open listing into `iterator._entry`, skipping
# `.` and `..`: false at the end.
[Target(OS(Windows))]
_io_sys_directory_next(iterator: DirectoryIterator): IoResult<bool> {
    var data = iterator._data;
    while (true) {
        if (iterator._pending) {
            iterator._pending = false;
        } else if (FindNextFileW(iterator._handle, data) == 0) {
            var code = GetLastError();
            if (code != 18) {  # NO_MORE_FILES
                return IoResult<bool>.err(IoError(code, _io_sys_error_message(code)));
            }
            return IoResult<bool>.ok(false);
        }
        var name_ptr = unsafe_cast<__ptr<u16>>(data + 44);
        var name = _io_win_narrow(name_ptr, _io_win_wide_len(name_ptr));
        if (name == "." || name == "..") {
            continue;
        }
        var m = _io_win_metadata(data, 0, 4, 12, 20, 28, 32);
        var entry = DirEntry();
        entry.name = name;
        entry.path = iterator._path.join(Path(name));
        entry.is_file = m.is_file;
        entry.is_directory = m.is_directory;
        entry.is_symlink = m.is_symlink;
        entry.file_type = m.file_type;
        iterator._entry = entry;
        return IoResult<bool>.ok(true);
    }
}

# Closes an open listing.
[Target(OS(Windows))]
_io_sys_directory_close(handle: __ptr<void>) {
    FindClose(handle);
}

[Target(OS(Windows))]
_io_sys_mkdir(path: Path, mode: Mode): IoResult<void> {
    var w = _io_win_path(path);
    var ok = CreateDirectoryW(w, __null);
    var code = GetLastError();
    _pep_free(w);
    return _io_win_check_code(ok, code);
}

[Target(OS(Windows))]
_io_sys_rmdir(path: Path): IoResult<void> {
    var w = _io_win_path(path);
    var ok = RemoveDirectoryW(w);
    var code = GetLastError();
    _pep_free(w);
    return _io_win_check_code(ok, code);
}

[Target(OS(Windows))]
_io_sys_unlink(path: Path): IoResult<void> {
    var w = _io_win_path(path);
    var ok = DeleteFileW(w);
    var code = GetLastError();
    _pep_free(w);
    return _io_win_check_code(ok, code);
}

# A directory symlink (junction) is removed with RemoveDirectoryW, anything
# else with DeleteFileW.
[Target(OS(Windows))]
_io_sys_remove_link(path: Path, is_dir: bool): IoResult<void> {
    if (is_dir) {
        return _io_sys_rmdir(path);
    }
    return _io_sys_unlink(path);
}

# MOVEFILE_REPLACE_EXISTING, as POSIX rename replaces.
[Target(OS(Windows))]
_io_sys_rename(from: Path, to: Path): IoResult<void> {
    var wf = _io_win_path(from);
    var wt = _io_win_path(to);
    var ok = MoveFileExW(wf, wt, 1);
    var code = GetLastError();
    _pep_free(wf);
    _pep_free(wt);
    return _io_win_check_code(ok, code);
}

[Target(OS(Windows))]
_io_sys_hard_link(from: Path, to: Path): IoResult<void> {
    var wf = _io_win_path(from);
    var wt = _io_win_path(to);
    var ok = CreateHardLinkW(wt, wf, __null);
    var code = GetLastError();
    _pep_free(wf);
    _pep_free(wt);
    return _io_win_check_code(ok, code);
}

[Target(OS(Windows))]
_io_sys_getcwd(): IoResult<Path> {
    var need = GetCurrentDirectoryW(0, __null);  # units, NUL included
    if (need == 0) {
        return IoResult<Path>.err(IoError.last());
    }
    var buffer = _IoBuffer((need as ulong) * 2);
    var buf = unsafe_cast<__ptr<u16>>(buffer._bytes);
    var n = GetCurrentDirectoryW(need, buf);
    if (n == 0) {
        return IoResult<Path>.err(IoError.last());
    }
    return IoResult<Path>.ok(Path(_io_win_narrow(buf, n as int)));
}

[Target(OS(Windows))]
_io_sys_chdir(path: Path): IoResult<void> {
    var w = _io_win_wide(path._value);
    var ok = SetCurrentDirectoryW(w);
    var code = GetLastError();
    _pep_free(w);
    return _io_win_check_code(ok, code);
}

# GetFinalPathNameByHandleW answers `\\?\C:\x` or `\\?\UNC\server\share`;
# drop the verbatim prefix (`\\?\UNC\` becomes `\\`).
[Target(OS(Windows))]
_io_sys_realpath(path: Path): IoResult<Path> {
    var h = _io_win_open_query(path, true);
    if (h.is_err()) {
        return IoResult<Path>.err(h.error());
    }
    var need = GetFinalPathNameByHandleW(h.value(), __null, 0, 0);
    if (need == 0) {
        var e = IoError.last();
        CloseHandle(h.value());
        return IoResult<Path>.err(e);
    }
    var buffer = _IoBuffer((need as ulong) * 2 + 2);
    var buf = unsafe_cast<__ptr<u16>>(buffer._bytes);
    var n = GetFinalPathNameByHandleW(h.value(), buf, need, 0);
    var code = GetLastError();
    CloseHandle(h.value());
    if (n == 0) {
        return IoResult<Path>.err(IoError(code, _io_sys_error_message(code)));
    }
    var s = _io_win_narrow(buf, n as int);
    # Drop the `\\?\` prefix, keeping a UNC path's `\\`.
    if (s.starts_with("\\\\?\\UNC\\")) {
        return IoResult<Path>.ok(Path("\\\\" + _io_slice(s, 8, s.size)));
    }
    if (s.starts_with("\\\\?\\")) {
        return IoResult<Path>.ok(Path(_io_slice(s, 4, s.size)));
    }
    return IoResult<Path>.ok(Path(s));
}

# GetTempPathW's answer ends in a separator; drop it unless it is the root.
[Target(OS(Windows))]
export _io_sys_temp_dir(): Path {
    var need = GetTempPathW(0, __null);
    if (need == 0) {
        return Path(".");
    }
    var buf = _pep_malloc((need as ulong) * 2 + 2) as __ptr<u16>;
    var n = GetTempPathW(need, buf) as int;
    var s = _io_win_narrow(buf, n);
    _pep_free(buf);
    return Path(_io_slice(s, 0, _io_path_trimmed_end(s)));
}

# ── Permissions, times and links ─────────────────────────────────────────────

# Only FILE_ATTRIBUTE_READONLY (1) of `mode` is applied, through
# FILE_BASIC_INFO (40 bytes: four LARGE_INTEGER times, 0 meaning unchanged,
# then FileAttributes u32 @32), where 0 attributes would also mean
# unchanged, so a file left with none gets FILE_ATTRIBUTE_NORMAL.
[Target(OS(Windows))]
_io_sys_fchmod(h: FileHandle, mode: Mode): IoResult<void> {
    var query = _IoBuffer(52);
    if (GetFileInformationByHandle(h, query._bytes) == 0) {
        return IoResult<void>.err(IoError.last());
    }
    var attributes = ((_io_win_u32(query._bytes, 0) | 1) ^ 1) | ((mode & 1) as ulong);
    if (attributes == 0) {
        attributes = 128;  # FILE_ATTRIBUTE_NORMAL
    }
    var info = _IoBuffer(40);
    var fields = unsafe_cast<__ptr<long>>(info._bytes);
    fields[0] = 0;
    fields[1] = 0;
    fields[2] = 0;
    fields[3] = 0;
    fields[4] = attributes as long;
    var ok = SetFileInformationByHandle(h, 0, info._bytes, 40);  # FileBasicInfo
    return _io_win_check(ok);
}

# Opens `path`, following links, to change its attributes or times
# (FILE_READ_ATTRIBUTES | FILE_WRITE_ATTRIBUTES).
[Target(OS(Windows))]
_io_win_open_attributes(path: Path): IoResult<FileHandle> {
    if (path._value.size == 0) {
        return IoResult<FileHandle>.err(IoError(_io_sys_code_not_found(), "empty path"));
    }
    return _io_win_create(path, 384, 3, 0);  # OPEN_EXISTING
}

[Target(OS(Windows))]
_io_sys_chmod(path: Path, mode: Mode): IoResult<void> {
    var h = _io_win_open_attributes(path);
    if (h.is_err()) {
        return IoResult<void>.err(h.error());
    }
    var r = _io_sys_fchmod(h.value(), mode);
    CloseHandle(h.value());
    return r;
}

[Target(OS(Windows))]
_io_sys_read_only_mode(current: Mode, read_only: bool): Mode {
    if (read_only) {
        return current | 1;
    }
    return (current | 1) ^ 1;
}

# Windows has no execute bit: whether a file runs depends on its extension.
[Target(OS(Windows))]
_io_sys_executable_mode(current: Mode, executable: bool): Mode {
    return current;
}

# A FILETIME (100 ns ticks since 1601) for ns since the Unix epoch, written
# at `at`; null for a time left alone.
[Target(OS(Windows))]
_io_win_filetime(at: __ptr<u8>, time: long?): __ptr<void> {
    if (time.is_empty()) {
        return __null;
    }
    var ns = time.value();
    var ticks = ns / 100;
    if (ticks * 100 > ns) {  # round toward the past, as POSIX truncates
        ticks = ticks - 1;
    }
    unsafe_cast<__ptr<long>>(at)[0] = ticks + 116444736000000000;
    return at;
}

[Target(OS(Windows))]
_io_sys_fset_times(h: FileHandle, accessed: long?, modified: long?): IoResult<void> {
    var buf = _IoBuffer(16);
    var a = _io_win_filetime(buf._bytes, accessed);
    var m = _io_win_filetime(buf._bytes + 8, modified);
    return _io_win_check(SetFileTime(h, __null, a, m));
}

[Target(OS(Windows))]
_io_sys_set_times(path: Path, accessed: long?, modified: long?): IoResult<void> {
    var h = _io_win_open_attributes(path);
    if (h.is_err()) {
        return IoResult<void>.err(h.error());
    }
    var r = _io_sys_fset_times(h.value(), accessed, modified);
    CloseHandle(h.value());
    return r;
}

# SYMBOLIC_LINK_FLAG_DIRECTORY (1) for a link to a directory, and
# SYMBOLIC_LINK_FLAG_ALLOW_UNPRIVILEGED_CREATE (2), which Developer Mode
# needs; Windows before 10 1703 rejects that flag, so try again without it.
[Target(OS(Windows))]
_io_sys_symlink(target: Path, link: Path, directory: bool): IoResult<void> {
    if (target._value.size == 0 || link._value.size == 0) {
        return IoResult<void>.err(IoError(_io_sys_code_not_found(), "empty path"));
    }
    uint flags = 2;
    if (directory) {
        flags = 3;
    }
    var wt = _io_win_wide(target._value);
    var wl = _io_win_path(link);
    var ok = CreateSymbolicLinkW(wl, wt, flags);
    var code = GetLastError();
    if (ok == 0 && code == 87) {  # INVALID_PARAMETER
        ok = CreateSymbolicLinkW(wl, wt, flags ^ 2);
        code = GetLastError();
    }
    _pep_free(wt);
    _pep_free(wl);
    return _io_win_check_code(ok as int, code);
}

# FSCTL_GET_REPARSE_POINT fills a REPARSE_DATA_BUFFER: ReparseTag u32 @0,
# then SubstituteNameOffset and SubstituteNameLength u16 @8 and @10 (bytes
# into the path buffer), and the path buffer itself at @20 for a symlink
# (after its Flags u32 @16) or @16 for a junction. The substitute name of an
# absolute target starts `\??\`, dropped here (`\??\UNC\` becomes `\\`).
[Target(OS(Windows))]
_io_sys_readlink(path: Path): IoResult<Path> {
    if (path._value.size == 0) {
        return IoResult<Path>.err(IoError(_io_sys_code_not_found(), "empty path"));
    }
    var h = _io_win_open_query(path, false);
    if (h.is_err()) {
        return IoResult<Path>.err(h.error());
    }
    var size: uint = 16384;  # MAXIMUM_REPARSE_DATA_BUFFER_SIZE
    var buf = _IoBuffer(size as ulong);
    var returned = _IoBuffer(4);
    var ok = DeviceIoControl(
        h.value(), 589992, __null, 0, buf._bytes, size, unsafe_cast<__ptr<uint>>(returned._bytes), __null
    );
    var code = GetLastError();
    CloseHandle(h.value());
    if (ok == 0) {
        return IoResult<Path>.err(IoError(code, _io_sys_error_message(code)));
    }
    var tag = _io_win_u32(buf._bytes, 0);
    ulong names = 0;
    if (tag == 2684354572) {  # IO_REPARSE_TAG_SYMLINK
        names = 20;
    } else if (tag == 2684354563) {  # IO_REPARSE_TAG_MOUNT_POINT
        names = 16;
    } else {
        return IoResult<Path>.err(IoError(4390, _io_sys_error_message(4390)));  # NOT_A_REPARSE_POINT
    }
    var offset = _io_win_u16(buf._bytes, 8);
    var length = _io_win_u16(buf._bytes, 10);
    var name = unsafe_cast<__ptr<u16>>(buf._bytes + names + offset);
    var s = _io_win_narrow(name, (length / 2) as int);
    if (s.starts_with("\\??\\UNC\\")) {
        return IoResult<Path>.ok(Path("\\\\" + _io_slice(s, 8, s.size)));
    }
    if (s.starts_with("\\??\\")) {
        return IoResult<Path>.ok(Path(_io_slice(s, 4, s.size)));
    }
    return IoResult<Path>.ok(Path(s));
}

[Target(OS(Windows))]
_io_win_u16(buf: __ptr<void>, offset: ulong): ulong {
    return ((buf + offset) as __ptr<u16>)[0] as ulong;
}
io/types
18793
# Platform aliases and the io error type.
#
# The raw types differ per platform; everything above the `_io_sys_*` layer
# is written against these names only.

import "socket_posix";
import "socket_wasi";
import "socket_windows";
import "sys_posix";
import "sys_windows";

# POSIX

## The raw operating-system handle of an open file: a POSIX file descriptor.
##
## `File.Handle` holds one. A valid descriptor is `>= 0`; a `File` that is
## closed (or was never opened) holds `-1`. The standard streams are
## descriptors 0, 1 and 2. On Windows this is a `HANDLE` instead.
##
## @note code that must build for every target should not rely on this being
## an `int`
## @see File
[Target(!OS(Windows))]
export type FileHandle = int;

## The raw operating-system handle of a socket: a POSIX file descriptor.
##
## `TcpListener`, `TcpStream` and `UdpSocket` hold one. A valid descriptor
## is `>= 0`; a closed socket holds `-1`. On Windows this is a `SOCKET`
## instead.
##
## @note code that must build for every target should not rely on this being
## an `int`
## @see TcpStream
[Target(!OS(Windows))]
export type SocketHandle = int;

## The raw platform error code carried by `IoError.code`: a POSIX `errno`
## value such as `ENOENT` (2). On Windows this is a `DWORD` from
## `GetLastError()` instead.
##
## The numbers differ between platforms (and a few between Linux and
## macOS), so portable code classifies an error with `IoError.kind()` or
## its predicates (`is_not_found()`, ...) rather than comparing codes.
##
## @see IoError
[Target(!OS(Windows))]
export type ErrorCode = int;

## File mode bits as reported in `Metadata.Permissions`: on POSIX the
## `mode_t` permission bits `mode & 07777` (the `rwx` bits for owner, group
## and others plus setuid, setgid and sticky; the file-type bits are
## removed). On Windows the same field holds `FILE_ATTRIBUTE_*` bits
## instead.
##
## @see Metadata
[Target(!OS(Windows))]
export type Mode = uint;

# Windows

## The raw operating-system handle of an open file: a Windows `HANDLE`.
##
## `File.Handle` holds one. A `File` that is closed (or was never opened)
## holds null; neither null nor `INVALID_HANDLE_VALUE` (-1) is a valid
## handle. The standard streams are the handles from `GetStdHandle`. On
## POSIX this is an `int` file descriptor instead.
##
## @note code that must build for every target should not rely on this being
## a `__ptr<void>`
## @see File
[Target(OS(Windows))]
export type FileHandle = __ptr<void>;

## The raw operating-system handle of a socket: a Winsock `SOCKET`, an
## unsigned pointer-sized integer.
##
## `TcpListener`, `TcpStream` and `UdpSocket` hold one. A closed socket
## holds `INVALID_SOCKET` (all bits set). On POSIX this is an `int` file
## descriptor instead.
##
## @note code that must build for every target should not rely on this being
## a `ulong`
## @see TcpStream
[Target(OS(Windows))]
export type SocketHandle = ulong;

## The raw platform error code carried by `IoError.code`: a Windows
## `DWORD` error code from `GetLastError()`, such as `ERROR_FILE_NOT_FOUND`
## (2). On POSIX this is an `errno` value instead.
##
## The numbers differ between platforms, so portable code classifies an
## error with `IoError.kind()` or its predicates (`is_not_found()`, ...)
## rather than comparing codes.
##
## @see IoError
[Target(OS(Windows))]
export type ErrorCode = uint;

## File attribute bits as reported in `Metadata.Permissions`: on Windows the
## whole `FILE_ATTRIBUTE_*` word of the file (`FILE_ATTRIBUTE_READONLY` is
## 1, `FILE_ATTRIBUTE_DIRECTORY` 16, `FILE_ATTRIBUTE_REPARSE_POINT` 1024,
## ...). On POSIX the same field holds `mode_t` permission bits instead.
##
## @see Metadata
[Target(OS(Windows))]
export type Mode = uint;

## A byte position or distance within a file, as taken and returned by the
## `File.seek*` methods: a signed 64-bit integer on every target (`off_t` on
## POSIX, `LARGE_INTEGER` on Windows), so files larger than 4 GiB work
## everywhere.
export type Offset = long;

## The portable kind of an `IoError`, as `IoError.kind()` returns it: the
## platform's error code sorted into the cases a program usually handles.
##
## Each case except `Other` has a matching `IoError` predicate
## (`NotFound` and `is_not_found()`, ...), whose documentation lists the
## codes it covers on each platform. A code that fits none of them, such as
## the `EIO` of a short write or the `EBADF` of a closed `File`, is `Other`.
##
## @example
##     import io;
##
##     var r = io.File.open(io.Path("settings.txt"));
##     if (r.is_err()) {
##         match (r.error().kind()) {
##             NotFound => { print("no settings file"); }
##             PermissionDenied => { print("settings file is not readable"); }
##             else => { print(r.error().message); }
##         }
##     }
## @see IoError.kind
export enum ErrorKind {
    ## The file, directory or host name does not exist (`is_not_found()`).
    NotFound,
    ## Access was denied (`is_permission_denied()`).
    PermissionDenied,
    ## The target already exists (`is_already_exists()`).
    AlreadyExists,
    ## A directory was expected but something else was found
    ## (`is_not_a_directory()`).
    NotADirectory,
    ## A file was expected but a directory was found (`is_is_a_directory()`).
    IsADirectory,
    ## A directory to remove still has entries (`is_directory_not_empty()`).
    DirectoryNotEmpty,
    ## An argument or the data was invalid (`is_invalid_input()`).
    InvalidInput,
    ## The operation was interrupted before it finished (`is_interrupted()`).
    Interrupted,
    ## Nothing accepted the connection (`is_connection_refused()`).
    ConnectionRefused,
    ## The peer reset, aborted or closed the connection
    ## (`is_connection_reset()`).
    ConnectionReset,
    ## Another socket already uses the address (`is_address_in_use()`).
    AddressInUse,
    ## The address cannot be used on this machine
    ## (`is_address_not_available()`).
    AddressNotAvailable,
    ## The operation timed out (`is_timed_out()`).
    TimedOut,
    ## Cancelling the task ended the operation (`is_cancelled()`).
    Cancelled,
    ## Any other code, including 0 (no error).
    Other,
}

## An I/O failure: the raw platform error code plus a human-readable
## message.
##
## `kind()` sorts the code into an `ErrorKind`, and a predicate per kind
## (`is_not_found()`, `is_permission_denied()`, ...) tests for one of them;
## each knows the matching codes on the current platform. Test with those
## rather than comparing `code` against numbers. Failures that Pepper detects
## itself (invalid UTF-8, an empty path, a short write, a closed `File`)
## use the platform's own code for the kind they are (`EINVAL` /
## `ERROR_INVALID_PARAMETER` for invalid input, `ENOENT` /
## `ERROR_FILE_NOT_FOUND` for an empty path, ...), so the kinds hold
## for them too. A short write uses `EIO` / `ERROR_WRITE_FAULT` and a closed
## `File` uses `EBADF` / `ERROR_INVALID_HANDLE`; those are `ErrorKind.Other`.
##
## @example
##     import io;
##
##     var r = io.File.open(io.Path("settings.txt"));
##     if (r.is_err()) {
##         if (r.error().is_not_found()) {
##             print("no settings file");
##         } else {
##             print(r.error().message);
##         }
##     }
## @see IoResult
## @see ErrorKind
export struct IoError {
    ## The raw platform error code: an `errno` value on POSIX, a
    ## `GetLastError()` code on Windows; 0 means no error.
    ErrorCode code;
    ## A human-readable description: the platform's text for `code`
    ## (`strerror` on POSIX, `FormatMessageW` on Windows, without its
    ## trailing period and line break), or Pepper's own text such as
    ## `"empty path"` for errors it detects itself.
    String message;

    ## Creates an error from a platform code and a message.
    ##
    ## The default, `IoError()`, has code 0 and an empty message; no
    ## predicate holds for it.
    ##
    ## @param code the raw platform error code (`errno` on POSIX,
    ## `GetLastError()` on Windows)
    ## @param message the human-readable description
    construct(code: ErrorCode = 0, message: String = "") {
        this.code = code;
        this.message = message;
    }

    ## Captures the calling thread's last platform error now: `errno` on
    ## POSIX, `GetLastError()` on Windows, with the platform's message for
    ## it.
    ##
    ## Call it immediately after the failing system call; any call in
    ## between (including one that allocates) may overwrite the code.
    ##
    ## @returns an error holding the current `errno` / `GetLastError()` code
    ## and its message
    static last(): IoError {
        var code = _io_sys_last_error();
        return IoError(code, _io_sys_error_message(code));
    }

    ## Makes an error for data or an argument that is not valid, such as a
    ## damaged file a library parses, with the platform's code for invalid
    ## input, so `is_invalid_input()` holds.
    ##
    ## @param message what is wrong
    ## @returns the error
    ## @example
    ##     import io;
    ##
    ##     var error = io.IoError.invalid_input("data.bin: bad header");
    ##     assert(error.is_invalid_input(), "the kind");
    static invalid_input(message: String): IoError {
        return IoError(_io_sys_code_invalid_input(), message);
    }

    ## Returns the portable kind of the error: `code` sorted by the codes the
    ## current platform uses for each kind. Each predicate below is
    ## `kind() == ErrorKind.X` for its kind.
    ##
    ## @returns the kind of `code`; `ErrorKind.Other` for a code that fits no
    ##   kind, and for 0
    ## @example
    ##     import io;
    ##
    ##     var r = io.File.open(io.Path("missing.txt"));
    ##     if (r.is_err() && r.error().kind() == io.ErrorKind.NotFound) {
    ##         print("no such file");
    ##     }
    kind(): ErrorKind { return _io_sys_error_kind(code); }

    ## Returns whether the error means the file or directory does not exist.
    ##
    ## Matches `ENOENT` on POSIX, and `ERROR_FILE_NOT_FOUND` or
    ## `ERROR_PATH_NOT_FOUND` on Windows. An empty path fails with this kind
    ## on POSIX (with the message `"empty path"`), and in `File.open_with`
    ## on every platform.
    ##
    ## `resolve` and `TcpStream.connect_host` fail with this kind too when a
    ## host name has no address.
    ##
    ## @returns true when a path, or a directory on the way to it, is missing,
    ##   or a host name has no address
    is_not_found(): bool { return kind() == ErrorKind.NotFound; }

    ## Returns whether the operation was refused for lack of permission.
    ##
    ## Matches `EACCES` or `EPERM` on POSIX, and `ERROR_ACCESS_DENIED` on
    ## Windows (which Windows also reports for, among others, deleting a
    ## read-only file).
    ##
    ## @returns true when access was denied
    is_permission_denied(): bool { return kind() == ErrorKind.PermissionDenied; }

    ## Returns whether the operation failed because its target already
    ## exists, such as `Directory.create` on an existing path or opening with
    ## `create_new`.
    ##
    ## Matches `EEXIST` on POSIX, and `ERROR_FILE_EXISTS` or
    ## `ERROR_ALREADY_EXISTS` on Windows.
    ##
    ## @returns true when the target already exists
    is_already_exists(): bool { return kind() == ErrorKind.AlreadyExists; }

    ## Returns whether a path that had to name a directory names something
    ## else, such as `Directory.open` or `Directory.remove` on a file (or,
    ## on POSIX, a file used as a directory in the middle of a path).
    ##
    ## Matches `ENOTDIR` on POSIX, and `ERROR_DIRECTORY` (267, "the directory
    ## name is invalid") on Windows.
    ##
    ## @returns true when a directory was expected
    is_not_a_directory(): bool { return kind() == ErrorKind.NotADirectory; }

    ## Returns whether an operation that needs a file was given a directory,
    ## such as reading from a directory opened as a `File`.
    ##
    ## Matches `EISDIR` on POSIX, and `ERROR_DIRECTORY_NOT_SUPPORTED` on
    ## Windows (which `File` reads report for a directory handle).
    ##
    ## @returns true when a directory was given where a file was expected
    is_is_a_directory(): bool { return kind() == ErrorKind.IsADirectory; }

    ## Returns whether a directory could not be removed because it still has
    ## entries (`Directory.remove` on a non-empty directory).
    ##
    ## Matches `ENOTEMPTY` on POSIX (39 on Linux, 66 on macOS) and
    ## `ERROR_DIR_NOT_EMPTY` on Windows.
    ##
    ## @returns true when the directory is not empty
    is_directory_not_empty(): bool { return kind() == ErrorKind.DirectoryNotEmpty; }

    ## Returns whether an argument was invalid: bad options (such as opening
    ## with no access mode), data that is not valid UTF-8 where text was
    ## expected, or a malformed path.
    ##
    ## Matches `EINVAL` on POSIX, and `ERROR_INVALID_PARAMETER` or
    ## `ERROR_INVALID_NAME` on Windows.
    ##
    ## @returns true when the input was invalid
    is_invalid_input(): bool { return kind() == ErrorKind.InvalidInput; }

    ## Returns whether the operation was interrupted before it finished.
    ##
    ## Matches `EINTR` on POSIX and `WSAEINTR` on Windows. An aborted
    ## Windows operation (`ERROR_OPERATION_ABORTED`) is `is_cancelled()`
    ## instead. The io functions retry interrupted POSIX opens, reads and writes
    ## themselves, so callers rarely see this.
    ##
    ## @returns true when the operation was interrupted
    is_interrupted(): bool { return kind() == ErrorKind.Interrupted; }

    ## Returns whether a connection attempt was refused: nothing listens on
    ## that port (the peer answered with a reset).
    ##
    ## Matches `ECONNREFUSED` on POSIX and `WSAECONNREFUSED` on Windows.
    ##
    ## @returns true when the connection was refused
    is_connection_refused(): bool { return kind() == ErrorKind.ConnectionRefused; }

    ## Returns whether an established connection was broken by the peer:
    ## reset, aborted, or (when writing) already closed.
    ##
    ## Matches `ECONNRESET`, `ECONNABORTED` or `EPIPE` on POSIX, and
    ## `WSAECONNRESET` or `WSAECONNABORTED` on Windows.
    ##
    ## @returns true when the connection was reset or closed by the peer
    is_connection_reset(): bool { return kind() == ErrorKind.ConnectionReset; }

    ## Returns whether binding failed because another socket already uses
    ## the address and port.
    ##
    ## Matches `EADDRINUSE` on POSIX and `WSAEADDRINUSE` on Windows.
    ##
    ## @returns true when the address is in use
    is_address_in_use(): bool { return kind() == ErrorKind.AddressInUse; }

    ## Returns whether an address cannot be used here: binding to an IP
    ## address that is not one of this machine's, or connecting to port 0.
    ##
    ## Matches `EADDRNOTAVAIL` on POSIX and `WSAEADDRNOTAVAIL` on Windows.
    ##
    ## @returns true when the address is not available
    is_address_not_available(): bool { return kind() == ErrorKind.AddressNotAvailable; }

    ## Returns whether an operation gave up because the peer did not answer
    ## in time, such as a connection attempt to an unreachable host, or
    ## because an `async.timeout` scope around it expired.
    ##
    ## Matches `ETIMEDOUT` on POSIX and `WSAETIMEDOUT` on Windows.
    ##
    ## @returns true when the operation timed out
    is_timed_out(): bool { return kind() == ErrorKind.TimedOut; }

    ## Returns whether an operation stopped because the task waiting for it
    ## was cancelled (see `async.Task.cancel`).
    ##
    ## Matches `ECANCELED` on POSIX, and `ERROR_OPERATION_ABORTED` or
    ## `ERROR_CANCELLED` on Windows.
    ##
    ## @returns true when cancellation ended the operation
    is_cancelled(): bool { return kind() == ErrorKind.Cancelled; }
}

## The result of an io operation: a value on success, an `IoError` on
## failure. Check `is_ok()` / `is_err()` before calling `value()` or `error()`;
## operations that produce nothing return `IoResult<void>`.
##
## @typeParam T the value an operation produces on success
## @example
##     import io;
##
##     var cwd = io.Directory.current();
##     if (cwd.is_ok()) {
##         print(cwd.value().to_string());
##     } else {
##         print(cwd.error().message);
##     }
## @see IoError
export type IoResult<T> = Result<T, IoError>;

# ── Module-private helpers shared by the io files ───────────────────────────

# A String holding a copy of `n` bytes at `p`; `n == 0` must not reach the
# constructor, which would read `p` as a NUL-terminated C string. (For a C
# string, `String(p)` measures it and takes a null `p` as empty.)
_io_string_from(p: __ptr<char>, n: ulong): String {
    if (p == __null || n == 0) {
        return String();
    }
    return String(p, n);
}

extern void memcpy(void* dest, void* src, ulong n);

# A new buffer (free it with `_pep_free`) holding a copy of `text`'s bytes,
# for a write that may wait while another task changes `text`.
export _io_text_copy(text: String): __ptr<u8> {
    __ptr<u8> bytes = _pep_malloc(text.size + 1);
    memcpy(bytes, text.c_str(), text.size);
    return bytes;
}

# A zeroed scratch buffer for a system call wrapper, freed when the last
# reference goes: a wrapper declares it as a local, and every return frees
# it at scope exit, so no early return has to.
struct _IoBuffer {
    # The buffer's `size` bytes.
    __ptr<u8> _bytes;

    construct(size: ulong) {
        _bytes = _pep_malloc(size);
    }

    destruct {
        _pep_free(_bytes);
    }
}

# A String from a NUL-terminated C string.
_io_string_from_c(p: __ptr<char>): String {
    if (p == __null) {
        return String();
    }
    return _io_string_from(p, _pep_c_strlen(p));
}

# Byte `i` of the `n` bytes at `p`, or 0 past the end: a bounds-checked read
# for scanning a String's bytes (an empty String has no buffer at all).
_io_byte(p: __ptr<u8>, n: ulong, i: ulong): int {
    if (i >= n) {
        return 0;
    }
    return p[i];
}

_io_ok_void(): IoResult<void> {
    return IoResult<void>.ok();
}

_io_err_void(e: IoError): IoResult<void> {
    return IoResult<void>.err(e);
}

_io_last_void(): IoResult<void> {
    return IoResult<void>.err(IoError.last());
}
io/unix
33286
## Unix domain sockets: `UnixListener` accepts connections on a path in the
## file system, `UnixStream` is one connection, and `UnixDatagram` sends and
## receives datagrams.
##
## They work like `TcpListener`, `TcpStream` and `UdpSocket`, for processes
## on the same machine: a path names the socket instead of an IP address and
## a port. Linux, macOS and Windows (10 version 1803 and later) all have the
## stream sockets; `UnixDatagram` is Linux and macOS only.
##
## Binding creates a socket file at the path, and closing the listener does
## not remove it: remove it with `File.remove` when the server is done, and
## before binding again, since binding to a path that exists fails with
## `is_address_in_use()`.

# The listener and stream use the same `_io_sys_socket_*` layer as TCP; only
# opening the socket and the sockaddr (sockaddr_un) differ.

import "address";
import "path";
import "socket";
import "socket_posix";
import "socket_wasi";
import "socket_windows";
import "sys_posix";
import "sys_windows";
import "types";
import "wait";

# `path` as a sockaddr_un.
_io_sockaddr_unix_write(path: Path): IoResult<_SockAddr> {
    var text = path._value;
    var n = text.size;
    var capacity = _io_sys_unix_path_capacity();
    if (n == 0 || n + 1 > capacity) {
        var message = $"a Unix socket path must be 1 to {capacity - 1} bytes: '{text}'";
        return IoResult<_SockAddr>.err(IoError(_io_sys_code_invalid_input(), message));
    }
    var sockaddr = _SockAddr();
    var buffer = sockaddr._bytes;
    var p = unsafe_cast<__ptr<u8>>(text.c_str());
    ulong i = 0;
    while (i < n) {
        buffer[2 + i] = p[i];
        i = i + 1;
    }
    buffer[2 + n] = 0;
    sockaddr._length = (2 + n + 1) as int;
    _io_sys_sockaddr_unix_header(buffer, sockaddr._length);
    return IoResult<_SockAddr>.ok(sockaddr);
}

# Binds the socket `h` to `path`.
_io_unix_bind(h: SocketHandle, path: Path): IoResult<void> {
    var sockaddr = _io_sockaddr_unix_write(path);
    if (sockaddr.is_err()) {
        return IoResult<void>.err(sockaddr.error());
    }
    var address = sockaddr.value();
    return _io_sys_socket_bind_raw(h, address._bytes, address._length);
}

# Connects the socket `h` to the listener at `path`.
_io_unix_connect(h: SocketHandle, path: Path): IoResult<void> {
    var sockaddr = _io_sockaddr_unix_write(path);
    if (sockaddr.is_err()) {
        return IoResult<void>.err(sockaddr.error());
    }
    var address = sockaddr.value();
    var result = _io_sys_socket_connect_raw(h, address._bytes, address._length);
    if (result.is_err() && !result.error().is_not_found()) {
        # Windows reports a missing socket file as WSAECONNREFUSED (the same
        # as a file nobody listens on) and a missing directory as
        # WSAENETDOWN; look at the path to report it as not found.
        var file = _io_sys_stat(path, false);
        if (file.is_err() && file.error().is_not_found()) {
            return IoResult<void>.err(file.error());
        }
    }
    return result;
}

# ── UnixListener ─────────────────────────────────────────────────────────────

## A Unix domain socket that listens for connections on a path.
##
## `UnixListener.bind` creates the socket file and listens on it; each
## `accept()` waits for the next connection and returns it as a
## `UnixStream`.
##
## Closing: the destructor closes the socket when the last reference goes;
## `close()` closes it earlier and reports errors. Neither removes the socket
## file. Every operation on a closed listener fails with an error no
## `IoError` predicate identifies (`EBADF` on POSIX, `ERROR_INVALID_HANDLE`
## on Windows).
##
## @example
##     import io;
##
##     var path = io.Directory.temp().join("server.sock");
##     io.File.remove(path);   # left over from an earlier run
##     var listener = io.UnixListener.bind(path).value();
##     while (true) {
##         var stream = listener.accept().value();
##         stream.write_all("hello");
##     }
## @see UnixStream
[NotCopyable("owns an operating-system socket and cannot be copied")]
export struct UnixListener {
    ## The socket: a descriptor on POSIX (-1 when closed), a `SOCKET` on
    ## Windows (`INVALID_SOCKET` when closed).
    SocketHandle _handle;
    ## The path the listener was bound to.
    Path _path;

    ## Creates a closed listener: `is_open()` is false and every operation
    ## fails. Use `UnixListener.bind` to get an open one.
    construct() {
        _handle = _io_sys_socket_invalid();
        _path = Path();
    }

    ## Closes the socket if it is still open when the last reference goes.
    ## Errors are ignored; call `close()` to see them. The socket file stays.
    destruct {
        _io_socket_close_taken(_handle);
    }

    ## Creates a Unix domain socket at `path` and starts listening on it.
    ##
    ## @param path where to create the socket file: at most 107 bytes (103
    ##   on macOS)
    ## @returns the listening socket; an error with `is_address_in_use()`
    ##   when a file already exists at `path`, `is_invalid_input()` when the
    ##   path is empty or too long, `is_not_found()` when its directory does
    ##   not exist, `is_permission_denied()` when the directory cannot be
    ##   written, or another platform error
    static bind(path: Path): IoResult<UnixListener> {
        var opened = _io_sys_socket_open_unix();
        if (opened.is_err()) {
            return IoResult<UnixListener>.err(opened.error());
        }
        var listener = UnixListener();
        listener._handle = opened.value();
        var bound = _io_unix_bind(listener._handle, path);
        if (bound.is_err()) {
            return IoResult<UnixListener>.err(bound.error());
        }
        var listening = _io_sys_socket_listen(listener._handle, _io_listen_backlog());
        if (listening.is_err()) {
            return IoResult<UnixListener>.err(listening.error());
        }
        listener._path = path;
        return IoResult<UnixListener>.ok(listener);
    }

    ## Returns whether the listener is open.
    ##
    ## @returns false after `close()` and for a `UnixListener()` never bound
    is_open(): bool {
        return _io_sys_socket_valid(_handle);
    }

    ## Returns the path the listener was bound to.
    ##
    ## @returns the path given to `bind`; an empty path for a
    ##   `UnixListener()` never bound
    path(): Path {
        return _path;
    }

    ## Waits for the next incoming connection and returns it.
    ##
    ## @returns the connected stream; an error when the listener is closed,
    ##   or another platform error
    accept(): IoResult<UnixStream> {
        return UnixStream._accepted(_io_listener_accept(_handle, false));
    }

    ## Closes the listener now. Closing a closed listener does nothing.
    ## Connections already accepted stay open, and the socket file stays.
    ##
    ## @returns an Ok result on success or when already closed; the platform
    ##   error when closing fails
    close(): IoResult<void> {
        var h = _handle;
        _handle = _io_sys_socket_invalid();
        return _io_socket_close_taken(h);
    }
}

## A Unix domain listening socket that any thread can accept connections on:
## the thread-safe counterpart of `UnixListener`, as `SharedTcpListener` is
## of `TcpListener`. Each connection goes to one of the threads waiting in
## `accept`, and the stream it returns belongs to that thread.
##
## A `shared` function may capture it. There is no `close()`, since another
## thread may be waiting on it: the socket closes when the last reference
## goes. The socket file stays.
##
## @example
##     import async;
##     import io;
##
##     main(): int {
##         async.run(() => {
##             var listener = io.SharedUnixListener.bind(io.Path("/tmp/server.sock")).value();
##             async.spawn_on_each_worker(() => {
##                 while (true) {
##                     var accepted = listener.accept();
##                     if (accepted.is_err()) {
##                         return;
##                     }
##                     accepted.value().write_all("hello");
##                 }
##             });
##         });
##         return 0;
##     }
## @see UnixListener
[Shared]
export struct SharedUnixListener {
    # The socket (`SocketHandle` widened to `long`; -1 for none).
    const _handle: long;

    ## Wraps a listening socket. Use `SharedUnixListener.bind`.
    ##
    ## @param handle the listening socket, or an invalid handle for none
    construct(handle: SocketHandle) {
        _handle = handle as long;
    }

    ## Closes the socket when the last reference goes.
    destruct {
        _io_socket_close_taken(_handle as SocketHandle);
    }

    ## Creates a Unix domain socket at `path` and starts listening on it, as
    ## `UnixListener.bind` does.
    ##
    ## @param path where to create the socket file
    ## @returns the listening socket, or the errors `UnixListener.bind`
    ##   returns
    static bind(path: Path): IoResult<SharedUnixListener> {
        var bound = UnixListener.bind(path);
        if (bound.is_err()) {
            return IoResult<SharedUnixListener>.err(bound.error());
        }
        var listener = bound.value();
        var h = listener._handle;
        listener._handle = _io_sys_socket_invalid();
        return IoResult<SharedUnixListener>.ok(SharedUnixListener(h));
    }

    ## Waits for the next incoming connection and returns it, as
    ## `UnixListener.accept` does. Several threads may wait at once; each
    ## connection wakes one of them (or, on some systems, several, and the
    ## rest keep waiting).
    ##
    ## @returns the connected stream, owned by the calling thread; an error
    ##   when the waiting task is cancelled, or another platform error
    accept(): IoResult<UnixStream> {
        return UnixStream._accepted(_io_listener_accept(_handle as SocketHandle, true));
    }
}

# ── UnixStream ───────────────────────────────────────────────────────────────

## A Unix domain stream connection: a reliable, ordered stream of bytes in
## both directions between two processes (or threads) on this machine.
##
## Get one from `UnixStream.connect` or `UnixListener.accept`. Reading and
## writing work exactly as on a `TcpStream`: `read` appends what has arrived
## and returns 0 once the peer has closed its side, `write` may send part of
## the data, and `read_exact` and `write_all` loop until done. Sending never
## raises `SIGPIPE`; writing to a connection the peer has closed fails with
## `is_connection_reset()` (or a broken-pipe error no predicate matches, on
## some systems).
##
## Closing: the destructor closes the socket when the last reference goes;
## `close()` closes it earlier and reports errors. Every operation on a
## closed stream fails with an error no `IoError` predicate identifies.
##
## @example
##     import io;
##
##     var stream = io.UnixStream.connect(io.Path("/tmp/server.sock")).value();
##     stream.write_all("ping");
##     var reply = Array<u8>();
##     stream.read_exact(reply, 4).value();
## @see UnixListener
[NotCopyable("owns an operating-system socket and cannot be copied")]
export struct UnixStream {
    ## The socket: a descriptor on POSIX (-1 when closed), a `SOCKET` on
    ## Windows (`INVALID_SOCKET` when closed).
    SocketHandle _handle;

    ## Creates a closed stream: `is_open()` is false and every operation
    ## fails. Use `UnixStream.connect` or `UnixListener.accept` to get an
    ## open one.
    construct() {
        _handle = _io_sys_socket_invalid();
    }

    ## Closes the socket if it is still open when the last reference goes.
    ## Errors are ignored; call `close()` to see them.
    destruct {
        _io_socket_close_taken(_handle);
    }

    ## Connects to the listener at `path`.
    ##
    ## @param path the socket file a `UnixListener` is bound to
    ## @returns the connected stream; an error with `is_not_found()` when no
    ##   file exists at `path`, `is_connection_refused()` when the file is
    ##   there but nothing listens on it, `is_invalid_input()` when the path
    ##   is empty or too long, or another platform error
    static connect(path: Path): IoResult<UnixStream> {
        var opened = _io_sys_socket_open_unix();
        if (opened.is_err()) {
            return IoResult<UnixStream>.err(opened.error());
        }
        var stream = UnixStream();
        stream._handle = opened.value();
        var connected = _io_unix_connect(stream._handle, path);
        if (connected.is_err()) {
            return IoResult<UnixStream>.err(connected.error());
        }
        return IoResult<UnixStream>.ok(stream);
    }

    ## Returns whether the stream is open.
    ##
    ## @returns false after `close()` and for a `UnixStream()` never connected
    is_open(): bool {
        return _io_sys_socket_valid(_handle);
    }

    ## Waits until data arrives, then appends up to `max` bytes of it to
    ## `buffer` with a single system call, like `TcpStream.read`.
    ##
    ## @param buffer the array the bytes are appended to
    ## @param max the most bytes to read; 0 reads nothing and returns 0
    ## @returns the number of bytes appended, 0 once the peer has closed its
    ##   side of the connection; an error when the stream is closed, or
    ##   another platform error
    read(buffer: u8[], max: ulong): IoResult<ulong> {
        return _io_stream_read(_handle, buffer, max);
    }

    ## Reads until exactly `count` more bytes are appended to `buffer`.
    ##
    ## @param buffer the array the bytes are appended to
    ## @param count the number of bytes to read
    ## @returns an Ok result once `count` bytes are appended; an error when
    ##   the peer closes the connection first ("connection closed after n of
    ##   count bytes"), or an error as for `read`. The bytes read before an
    ##   error stay in `buffer`.
    read_exact(buffer: u8[], count: ulong): IoResult<void> {
        return _io_stream_read_exact(_handle, buffer, count);
    }

    ## Sends bytes from `data` with a single system call, waiting until the
    ## system can take at least some of them. The send may be partial; use
    ## `write_all` to send everything.
    ##
    ## @param data the bytes to send
    ## @returns the number of bytes sent, which may be less than
    ##   `data.count`; an error when the peer has closed the connection,
    ##   when the stream is closed, or another platform error
    write(data: u8[]): IoResult<ulong> {
        return _io_stream_write(_handle, data);
    }

    ## Sends all of `data`, repeating the send until every byte is sent.
    ## If an error occurs part of `data` may already have been sent.
    ##
    ## @param data the bytes to send
    ## @returns an Ok result once every byte is sent; an error as for `write`
    write_all(data: u8[]): IoResult<void> {
        return _io_stream_write_all(_handle, data);
    }

    ## Sends all of the UTF-8 bytes of `text`, as `write_all(u8[])` does.
    ## No newline or terminator is added.
    ##
    ## @param text the text to send
    ## @returns an Ok result once every byte is sent; an error as for `write`
    ## @example
    ##     stream.write_all("ping");
    write_all(text: String): IoResult<void> {
        return _io_stream_write_string(_handle, text);
    }

    ## Deprecated: use `write_all` instead. Sends all of the UTF-8 bytes of
    ## `text`, exactly like `write_all(text)`.
    ##
    ## @param text the text to send
    ## @returns an Ok result once every byte is sent; an error as for `write_all`
    ## @see write_all
    [Deprecated("use 'write_all' instead", "write_all")]
    write_string(text: String): IoResult<void> {
        return write_all(text);
    }

    ## Closes the sending side of the connection: the peer's reads return 0
    ## once it has read everything sent before. This side can still read.
    ##
    ## @returns an Ok result on success; an error when the stream is closed,
    ##   or another platform error
    shutdown_write(): IoResult<void> {
        return _io_stream_shutdown_write(_handle);
    }

    ## Limits how long a read waits: when no data arrives for
    ## `milliseconds`, the read fails with `is_timed_out()` and the stream
    ## stays open for another try. Each wait counts on its own, so a
    ## `read_exact` may take longer in all. 0, the default, waits as long as
    ## it takes. It works outside a task and in one, where the task's
    ## `async.timeout` can end the wait sooner.
    ##
    ## @param milliseconds the longest wait, at most 4294967295 (about 49
    ##   days); 0 for none
    ## @returns an Ok result; an error with `is_invalid_input()` when
    ##   `milliseconds` is too large, or an error when the stream is closed
    ## @example
    ##     stream.set_read_timeout(5000);   # give up after 5 seconds of silence
    set_read_timeout(milliseconds: ulong): IoResult<void> {
        return _io_socket_timeout_setter(_handle, _IO_READABLE, milliseconds);
    }

    ## Returns the read timeout `set_read_timeout` set.
    ##
    ## @returns the timeout in milliseconds, 0 for none
    read_timeout(): ulong {
        return _io_socket_timeout(_handle, _IO_READABLE);
    }

    ## Limits how long a write waits for the system to take more data: when
    ## it can take none for `milliseconds` (the peer is not reading), the
    ## write fails with `is_timed_out()`, possibly after sending part of the
    ## data. Each wait counts on its own. 0, the default, waits as long as
    ## it takes.
    ##
    ## @param milliseconds the longest wait, at most 4294967295 (about 49
    ##   days); 0 for none
    ## @returns an Ok result; an error with `is_invalid_input()` when
    ##   `milliseconds` is too large, or an error when the stream is closed
    set_write_timeout(milliseconds: ulong): IoResult<void> {
        return _io_socket_timeout_setter(_handle, _IO_WRITABLE, milliseconds);
    }

    ## Returns the write timeout `set_write_timeout` set.
    ##
    ## @returns the timeout in milliseconds, 0 for none
    write_timeout(): ulong {
        return _io_socket_timeout(_handle, _IO_WRITABLE);
    }

    ## Moves the connection out of this stream, into a token another thread
    ## can take it from with `UnixStream.adopt`, as
    ## `TcpStream.into_transfer` does. The stream is closed afterwards.
    ##
    ## @returns the token; for a closed stream, one that `adopt` fails on
    into_transfer(): SocketTransfer {
        var h = _handle;
        _handle = _io_sys_socket_invalid();
        return _io_socket_transfer(h);
    }

    ## Takes the connection out of `transfer` (see `into_transfer`) into a
    ## new stream on the calling thread. Only the first `adopt` of a token
    ## gets the connection.
    ##
    ## @param transfer the token from `into_transfer`
    ## @returns the stream; an error when the token is empty (already
    ##   adopted, or made from a closed stream)
    static adopt(transfer: SocketTransfer): IoResult<UnixStream> {
        var h = _io_socket_adopt(transfer);
        if (h.is_err()) {
            return IoResult<UnixStream>.err(h.error());
        }
        return IoResult<UnixStream>.ok(_of(h.value()));
    }

    # A stream owning the open socket `h`.
    static _of(h: SocketHandle): UnixStream {
        var stream = UnixStream();
        stream._handle = h;
        return stream;
    }

    # What a listener's `accept` returns, for the socket it accepted.
    static _accepted(accepted: IoResult<(SocketHandle, SocketAddress)>): IoResult<UnixStream> {
        if (accepted.is_err()) {
            return IoResult<UnixStream>.err(accepted.error());
        }
        return IoResult<UnixStream>.ok(_of(accepted.value().0));
    }

    ## Closes the connection now. Closing a closed stream does nothing.
    ##
    ## @returns an Ok result on success or when already closed; the platform
    ##   error when closing fails
    close(): IoResult<void> {
        var h = _handle;
        _handle = _io_sys_socket_invalid();
        return _io_socket_close_taken(h);
    }
}

# The path in a sockaddr_un the system wrote, or an empty path for an
# unnamed (unbound) socket or a Linux abstract address.
[Target(OS(Linux) || OS(Mac))]
_io_sockaddr_unix_read(sockaddr: _SockAddr): Path {
    var buffer = sockaddr._bytes;
    ulong end = 2;
    var limit = sockaddr._length as ulong;
    while (end < limit && buffer[end] != 0) {
        end = end + 1;
    }
    if (end == 2) {
        return Path();
    }
    return Path(_io_string_from(unsafe_cast<__ptr<char>>(buffer + 2), end - 2));
}

# ── UnixDatagram ─────────────────────────────────────────────────────────────

## A Unix domain datagram socket (`SOCK_DGRAM` on `AF_UNIX`): like a
## `UdpSocket` for processes on the same machine, with a path in place of
## an address. Linux and macOS only; Windows has no Unix datagram sockets.
##
## Each `send_to` delivers one whole datagram, in order, and the system
## never drops one silently. While the receiver's queue is full, a send
## waits on Linux; on macOS it fails at once with the platform's "No buffer
## space available" (`ENOBUFS`) and sends nothing, so try again later.
## `UnixDatagram.bind` creates a socket file at a path, which closing
## does not remove (as for `UnixListener`); `UnixDatagram.unbound` makes a
## socket that can send but has no path for replies; `UnixDatagram.pair`
## makes two connected sockets.
##
## Closing: the destructor closes the socket when the last reference goes;
## `close()` closes it earlier and reports errors. Every operation on a
## closed socket fails with an error no `IoError` predicate identifies
## (`EBADF`).
##
## @example
##     import io;
##
##     var path = io.Directory.temp().join("events.sock");
##     io.File.remove(path);   # left over from an earlier run
##     var server = io.UnixDatagram.bind(path).value();
##     var client = io.UnixDatagram.unbound().value();
##     client.send_to("ping".bytes(), path);
##     var buffer = Array<u8>();
##     var (n, from) = server.receive_from(buffer, 1024).value();   # 4, an empty path
## @see UdpSocket
## @see UnixStream
[Target(OS(Linux) || OS(Mac))]
[NotCopyable("owns an operating-system socket and cannot be copied")]
export struct UnixDatagram {
    ## The socket's descriptor, -1 when closed.
    SocketHandle _handle;
    ## The path the socket was bound to; empty when it is unbound.
    Path _path;

    ## Creates a closed socket: `is_open()` is false and every operation
    ## fails. Use `UnixDatagram.bind`, `unbound` or `pair` to get an open
    ## one.
    construct() {
        _handle = _io_sys_socket_invalid();
        _path = Path();
    }

    ## Closes the socket if it is still open when the last reference goes.
    ## Errors are ignored; call `close()` to see them. The socket file stays.
    destruct {
        _io_socket_close_taken(_handle);
    }

    ## Creates a datagram socket at `path`, to receive datagrams sent there.
    ##
    ## @param path where to create the socket file: at most 107 bytes (103
    ##   on macOS)
    ## @returns the bound socket; an error with `is_address_in_use()` when a
    ##   file already exists at `path`, `is_invalid_input()` when the path is
    ##   empty or too long, `is_not_found()` when its directory does not
    ##   exist, `is_permission_denied()` when the directory cannot be
    ##   written, or another platform error
    static bind(path: Path): IoResult<UnixDatagram> {
        var opened = unbound();
        if (opened.is_err()) {
            return opened;
        }
        var socket = opened.value();
        var bound = _io_unix_bind(socket._handle, path);
        if (bound.is_err()) {
            return IoResult<UnixDatagram>.err(bound.error());
        }
        socket._path = path;
        return IoResult<UnixDatagram>.ok(socket);
    }

    ## Creates a datagram socket with no path. It can send, but a receiver
    ## sees an empty path as the sender and cannot reply.
    ##
    ## @returns the socket; an error when the system is out of descriptors,
    ##   or another platform error
    static unbound(): IoResult<UnixDatagram> {
        var opened = _io_sys_socket_open_unix_datagram();
        if (opened.is_err()) {
            return IoResult<UnixDatagram>.err(opened.error());
        }
        var socket = UnixDatagram();
        socket._handle = opened.value();
        return IoResult<UnixDatagram>.ok(socket);
    }

    ## Creates two datagram sockets connected to each other, with no path
    ## (`socketpair(2)`): what one sends with `send`, the other receives. A
    ## common way to talk to a child thread or process.
    ##
    ## @returns the two sockets; an error when the system is out of
    ##   descriptors, or another platform error
    ## @example
    ##     var (a, b) = io.UnixDatagram.pair().value();
    ##     a.send("hi".bytes());
    ##     var buffer = Array<u8>();
    ##     b.receive(buffer, 16);   # buffer holds "hi"
    static pair(): IoResult<(UnixDatagram, UnixDatagram)> {
        var opened = _io_sys_socket_pair_unix_datagram();
        if (opened.is_err()) {
            return IoResult<(UnixDatagram, UnixDatagram)>.err(opened.error());
        }
        var first = UnixDatagram();
        first._handle = opened.value().0;
        var second = UnixDatagram();
        second._handle = opened.value().1;
        return IoResult<(UnixDatagram, UnixDatagram)>.ok((first, second));
    }

    ## Returns whether the socket is open.
    ##
    ## @returns false after `close()` and for a `UnixDatagram()` never opened
    is_open(): bool {
        return _io_sys_socket_valid(_handle);
    }

    ## Returns the path the socket was bound to.
    ##
    ## @returns the path given to `bind`; an empty path for an unbound or
    ##   paired socket
    path(): Path {
        return _path;
    }

    ## Sends `data` as one datagram to the socket bound at `path`.
    ##
    ## @param data the datagram's bytes
    ## @param path the socket file a `UnixDatagram` is bound to
    ## @returns the number of bytes sent (all of `data`); an error with
    ##   `is_not_found()` when no socket file exists at `path`,
    ##   `is_connection_refused()` when nothing is bound to it any more,
    ##   `is_invalid_input()` when the path is empty or too long, or another
    ##   platform error (such as a datagram larger than the system allows)
    send_to(data: u8[], path: Path): IoResult<ulong> {
        var c = _io_socket_require_open(_handle);
        if (c.is_err()) {
            return IoResult<ulong>.err(c.error());
        }
        var sockaddr = _io_sockaddr_unix_write(path);
        if (sockaddr.is_err()) {
            return IoResult<ulong>.err(sockaddr.error());
        }
        return _io_sys_socket_send_to_raw(_handle, data._data, data._size, sockaddr.value());
    }

    ## Waits for the next datagram and appends up to `max` of its bytes to
    ## `buffer`.
    ##
    ## @param buffer the array the bytes are appended to
    ## @param max the most bytes to keep; the rest of a longer datagram is
    ##   lost. 0 reads nothing and returns at once.
    ## @returns the number of bytes appended and the sender's path (empty
    ##   when the sender is unbound); an error when the socket is closed, or
    ##   another platform error
    receive_from(buffer: u8[], max: ulong): IoResult<(ulong, Path)> {
        var c = _io_socket_require_open(_handle);
        if (c.is_err()) {
            return IoResult<(ulong, Path)>.err(c.error());
        }
        if (max == 0) {
            return IoResult<(ulong, Path)>.ok((0 as ulong, Path()));
        }
        buffer.reserve(buffer._size + max);
        var from = _SockAddr();
        var r = _io_sys_socket_receive_from_raw(_handle, buffer._data + buffer._size, max, from);
        if (r.is_err()) {
            return IoResult<(ulong, Path)>.err(r.error());
        }
        buffer._size = buffer._size + r.value();
        return IoResult<(ulong, Path)>.ok((r.value(), _io_sockaddr_unix_read(from)));
    }

    ## Sets the socket's default peer: `send` goes to the socket at `path`,
    ## and `receive` and `receive_from` only take datagrams from it. No
    ## datagram is sent.
    ##
    ## @param path the socket file a `UnixDatagram` is bound to
    ## @returns an Ok result on success; an error with `is_not_found()` when
    ##   no socket file exists at `path`, `is_connection_refused()` when
    ##   nothing is bound to it, or another platform error
    connect(path: Path): IoResult<void> {
        var c = _io_socket_require_open(_handle);
        if (c.is_err()) {
            return c;
        }
        return _io_unix_connect(_handle, path);
    }

    ## Sends `data` as one datagram to the connected peer (see `connect` and
    ## `pair`).
    ##
    ## @param data the datagram's bytes
    ## @returns the number of bytes sent; an error when the socket is not
    ##   connected or is closed, or another platform error
    send(data: u8[]): IoResult<ulong> {
        return _io_stream_write(_handle, data);
    }

    ## Waits for the next datagram from the connected peer and appends up to
    ## `max` of its bytes to `buffer`.
    ##
    ## @param buffer the array the bytes are appended to
    ## @param max the most bytes to keep; the rest of a longer datagram is
    ##   lost. 0 reads nothing and returns at once.
    ## @returns the number of bytes appended; an error when the socket is
    ##   closed, or another platform error
    receive(buffer: u8[], max: ulong): IoResult<ulong> {
        var r = receive_from(buffer, max);
        if (r.is_err()) {
            return IoResult<ulong>.err(r.error());
        }
        return IoResult<ulong>.ok(r.value().0);
    }

    ## Limits how long a receive waits: when no datagram arrives for
    ## `milliseconds`, `receive` or `receive_from` fails with
    ## `is_timed_out()` and the socket stays open for another try. 0, the
    ## default, waits as long as it takes. It works outside a task and in
    ## one, where the task's `async.timeout` can end the wait sooner.
    ##
