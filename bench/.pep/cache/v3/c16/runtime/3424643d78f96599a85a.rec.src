## Talking to a debugger: `output()` writes to the platform's debugger
## channel, `is_debugger_attached()` asks whether a debugger is watching,
## and `breakpoint()` stops in it.

import "sys_posix";
import "sys_wasi";
import "sys_windows";

## Writes `text` to the platform's debugger channel, followed by a newline
## when it does not end in one.
##
## - **Windows:** `OutputDebugStringW`, which Visual Studio's Output window
##   and WinDbg show (and DebugView, with no debugger attached). Nothing is
##   written anywhere else.
## - **Linux, macOS and WASI:** standard error, which debuggers show; these
##   systems have no separate channel.
##
## @param text the text to write
## @example
##     import debug;
##
##     main(): int {
##         debug.output("starting");
##         return 0;
##     }
export output(text: String) {
    _debug_sys_output(text);
}

## Returns whether a debugger is attached to the program: the `TracerPid`
## of `/proc/self/status` on Linux, `P_TRACED` on macOS, and
## `IsDebuggerPresent` on Windows. Always false on WASI.
##
## @returns true while a debugger is attached
## @example
##     import debug;
##
##     main(): int {
##         if (debug.is_debugger_attached()) {
##             debug.output("hello, debugger");
##         }
##         return 0;
##     }
export is_debugger_attached(): bool {
    return _debug_sys_debugger_attached();
}

## Stops in the debugger, as a breakpoint set on this line would: the
## processor's debug trap (`int3` on x64, `brk` on AArch64), through
## `llvm.debugtrap`. The debugger can then continue the program.
##
## With no debugger attached the trap ends the program: SIGTRAP on Linux
## and macOS, a breakpoint exception on Windows. Guard it with
## `is_debugger_attached()` to stop only under a debugger. Does nothing on
## WASI.
##
## @example
##     import debug;
##
##     main(): int {
##         if (debug.is_debugger_attached()) {
##             debug.breakpoint();
##         }
##         return 0;
##     }
export breakpoint() {
    _debug_sys_breakpoint();
}
debug/dwarf
33840
# Reading DWARF, shared by the ELF (Linux) and Mach-O (macOS) symbolizers:
# the line table (`.debug_line`) gives each address its source position,
# and the debug info (`.debug_info`) the inlined calls it is inside.

import "backtrace";

# The little-endian unsigned integer of `size` (1-8) bytes at `data + offset`.
_debug_read(data: __ptr<u8>, offset: ulong, size: ulong): ulong {
    ulong value = 0;
    ulong index = 0;
    while (index < size) {
        value = value | ((data[offset + index] as ulong) << (index * 8));
        index = index + 1;
    }
    return value;
}

# A bounds-checked reader over `data[position..end]`. A read past `end`
# returns 0 and sets `failed`, so a damaged table ends the walk instead of
# reading outside the section.
struct _DwarfCursor {
    var _data: __ptr<u8>;
    var position: ulong;
    var end: ulong;
    var failed: bool;

    construct(data: __ptr<u8>, position: ulong, end: ulong) {
        _data = data;
        this.position = position;
        this.end = end;
        failed = false;
    }

    # The next `size` bytes as a little-endian unsigned integer.
    read_fixed(size: ulong): ulong {
        if (failed || size > end - position || position > end) {
            failed = true;
            return 0;
        }
        var value = _debug_read(_data, position, size);
        position = position + size;
        return value;
    }

    # An unsigned LEB128 number.
    read_uleb(): ulong {
        ulong value = 0;
        ulong shift = 0;
        while (true) {
            var b = read_fixed(1);
            if (failed) {
                return 0;
            }
            if (shift < 64) {
                value = value | ((b & 0x7f) << shift);
            }
            shift = shift + 7;
            if ((b & 0x80) == 0) {
                return value;
            }
        }
        return value;
    }

    # A signed LEB128 number.
    read_sleb(): long {
        ulong value = 0;
        ulong shift = 0;
        ulong b = 0;
        while (true) {
            b = read_fixed(1);
            if (failed) {
                return 0;
            }
            if (shift < 64) {
                value = value | ((b & 0x7f) << shift);
            }
            shift = shift + 7;
            if ((b & 0x80) == 0) {
                break;
            }
        }
        if (shift < 64 && (b & 0x40) != 0) {
            value = value | (0xffffffffffffffff << shift);
        }
        return value as long;
    }

    # A NUL-terminated string.
    read_string(): String {
        var start = position;
        while (position < end && _data[position] != 0) {
            position = position + 1;
        }
        if (position >= end) {
            failed = true;
            return String();
        }
        var text = String(unsafe_cast<__ptr<char>>(_data + start), position - start);
        position = position + 1;
        return text;
    }

    # Moves `size` bytes on.
    skip(size: ulong) {
        if (failed || size > end - position) {
            failed = true;
            return;
        }
        position = position + size;
    }
}

# A line-table row: the source position of the code from `address` on.
struct _DwarfRow {
    var address: ulong;
    var file: ulong;
    var line: ulong;
    var column: ulong;

    construct() {
        address = 0;
        file = 1;
        line = 1;
        column = 0;
    }
}

# The header of one unit of a `.debug_line` section: where its line-number
# program is, how to run it, and the files its rows name.
struct _DwarfLineHeader {
    var valid: bool;
    # Where the program starts and the unit ends, as section offsets.
    var program: ulong;
    var unit_end: ulong;
    var minimum_length: ulong;
    var line_base: long;
    var line_range: ulong;
    var opcode_base: ulong;
    # The operand count of each standard opcode, from opcode 1.
    var lengths: Array<ulong>;
    # Each file's path, for file number 1 on.
    var files: Array<String>;

    construct() {
        valid = false;
        program = 0;
        unit_end = 0;
        minimum_length = 1;
        line_base = 0;
        line_range = 0;
        opcode_base = 0;
        lengths = Array<ulong>();
        files = Array<String>();
    }

    # Reads the header of the unit at `offset` in `data[0..size]`. Sets
    # `unit_end` (0 when even the length is damaged) and, for a unit of
    # DWARF version 2 to 4 it could read, `valid`.
    read(data: __ptr<u8>, size: ulong, offset: ulong) {
        var cursor = _DwarfCursor(data, offset, size);
        ulong length = cursor.read_fixed(4);
        ulong offset_size = 4;
        if (length == 0xffffffff) {
            length = cursor.read_fixed(8);
            offset_size = 8;
        }
        if (cursor.failed || length > size - cursor.position) {
            return;
        }
        unit_end = cursor.position + length;
        cursor.end = unit_end;
        var version = cursor.read_fixed(2);
        if (version < 2 || version > 4) {
            return;
        }
        var header_length = cursor.read_fixed(offset_size);
        program = cursor.position + header_length;
        minimum_length = cursor.read_fixed(1);
        if (version >= 4) {
            cursor.read_fixed(1);
        }
        cursor.read_fixed(1);
        var base = cursor.read_fixed(1);
        line_base = base >= 128 ? (base as long) - 256 : base as long;
        line_range = cursor.read_fixed(1);
        opcode_base = cursor.read_fixed(1);
        ulong index = 1;
        while (index < opcode_base) {
            lengths.append(cursor.read_fixed(1));
            index = index + 1;
        }
        var directories = Array<String>();
        while (!cursor.failed) {
            var directory = cursor.read_string();
            if (directory.is_empty) {
                break;
            }
            directories.append(directory);
        }
        while (!cursor.failed) {
            var name = cursor.read_string();
            if (name.is_empty) {
                break;
            }
            var directory = cursor.read_uleb();
            cursor.read_uleb();
            cursor.read_uleb();
            files.append(_debug_join_path(directories, directory, name));
        }
        valid = !cursor.failed && line_range != 0 && program <= unit_end;
    }
}

# Fills the file, line and column of each frame whose lookup address,
# `targets[i]` (an address as the line table writes it; 0 to skip the
# frame), the `.debug_line` section `data[0..size]` covers. Reads DWARF
# versions 2 to 4, which the compiler emits.
_debug_dwarf_lines(data: __ptr<u8>, size: ulong, targets: Array<ulong>, frames: Array<StackFrame>) {
    # The row each target falls in, by the closest row start found so far.
    var best = Array<ulong>();
    for (var target in targets) {
        best.append(0);
    }
    ulong unit = 0;
    while (unit + 4 <= size) {
        var header = _DwarfLineHeader();
        header.read(data, size, unit);
        if (header.unit_end == 0) {
            return;
        }
        unit = header.unit_end;
        if (!header.valid) {
            continue;
        }
        var cursor = _DwarfCursor(data, header.program, header.unit_end);
        _debug_run_line_program(cursor, header, targets, best, frames);
    }
}

# The path of file `name` in directory `directory` (1-based; 0 is the
# compilation directory, which leaves `name` as given).
_debug_join_path(directories: Array<String>, directory: ulong, name: String): String {
    if (directory == 0 || directory > directories.count || name.starts_with("/")) {
        return name;
    }
    var folder = directories[directory - 1];
    if (folder.ends_with("/")) {
        return $"{folder}{name}";
    }
    return $"{folder}/{name}";
}

# Runs one unit's line-number program, matching each row range against the
# targets.
_debug_run_line_program(
    cursor: _DwarfCursor, header: _DwarfLineHeader, targets: Array<ulong>, best: Array<ulong>, frames: Array<StackFrame>
) {
    var minimum_length = header.minimum_length;
    var line_base = header.line_base;
    var line_range = header.line_range;
    var opcode_base = header.opcode_base;
    var lengths = header.lengths;
    var files = header.files;
    var row = _DwarfRow();
    # The previous row of this sequence; `started` is false at a sequence's
    # start, when there is none.
    var previous = _DwarfRow();
    var started = false;
    while (!cursor.failed && cursor.position < cursor.end) {
        var opcode = cursor.read_fixed(1);
        var emit = false;
        var end_sequence = false;
        if (opcode >= opcode_base) {
            var adjusted = opcode - opcode_base;
            row.address = row.address + (adjusted / line_range) * minimum_length;
            row.line = ((row.line as long) + line_base + ((adjusted % line_range) as long)) as ulong;
            emit = true;
        } else if (opcode == 0) {
            var length = cursor.read_uleb();
            if (length == 0) {
                continue;
            }
            var extended = cursor.read_fixed(1);
            if (extended == 1) {
                emit = true;
                end_sequence = true;
            } else if (extended == 2) {
                row.address = cursor.read_fixed(length - 1);
            } else {
                cursor.skip(length - 1);
            }
        } else if (opcode == 1) {
            emit = true;
        } else if (opcode == 2) {
            row.address = row.address + cursor.read_uleb() * minimum_length;
        } else if (opcode == 3) {
            row.line = ((row.line as long) + cursor.read_sleb()) as ulong;
        } else if (opcode == 4) {
            row.file = cursor.read_uleb();
        } else if (opcode == 5) {
            row.column = cursor.read_uleb();
        } else if (opcode == 8) {
            row.address = row.address + ((255 - opcode_base) / line_range) * minimum_length;
        } else if (opcode == 9) {
            row.address = row.address + cursor.read_fixed(2);
        } else if (opcode == 6 || opcode == 7 || opcode == 10 || opcode == 11) {
            # is_stmt, basic_block, prologue_end, epilogue_begin: no operands
        } else {
            ulong operand = 0;
            while (operand < lengths[opcode - 1]) {
                cursor.read_uleb();
                operand = operand + 1;
            }
        }
        if (!emit) {
            continue;
        }
        if (started) {
            _debug_match_rows(previous, row.address, files, targets, best, frames);
        }
        if (end_sequence) {
            row = _DwarfRow();
            started = false;
        } else {
            previous.address = row.address;
            previous.file = row.file;
            previous.line = row.line;
            previous.column = row.column;
            started = true;
        }
    }
}

# Gives each target in `[row.address, end)` the row's position, unless a
# closer row (a later start) already matched it.
_debug_match_rows(
    row: _DwarfRow,
    end: ulong,
    files: Array<String>,
    targets: Array<ulong>,
    best: Array<ulong>,
    frames: Array<StackFrame>
) {
    if (row.line == 0) {
        return;
    }
    ulong index = 0;
    while (index < targets.count) {
        var target = targets[index];
        if (target != 0 && target >= row.address && target < end && row.address >= best[index]) {
            best[index] = row.address;
            var frame = frames[index];
            frame.file = row.file >= 1 && row.file <= files.count ? files[row.file - 1] : "";
            frame.line = row.line as int;
            frame.column = row.column as int;
        }
        index = index + 1;
    }
}

# The DWARF sections a backtrace reads, as the program maps them; a section
# the program lacks has size 0.
struct _DwarfSections {
    var info: __ptr<u8>;
    var info_size: ulong;
    var abbrev: __ptr<u8>;
    var abbrev_size: ulong;
    var strings: __ptr<u8>;
    var strings_size: ulong;
    var ranges: __ptr<u8>;
    var ranges_size: ulong;
    var line: __ptr<u8>;
    var line_size: ulong;

    construct() {
        info = __null;
        info_size = 0;
        abbrev = __null;
        abbrev_size = 0;
        strings = __null;
        strings_size = 0;
        ranges = __null;
        ranges_size = 0;
        line = __null;
        line_size = 0;
    }

    # Records section `name` (spelled as ELF does, `.debug_info`) at
    # `data[0..size]`; other names are ignored.
    set(name: String, data: __ptr<u8>, size: ulong) {
        if (name == ".debug_info") {
            info = data;
            info_size = size;
        } else if (name == ".debug_abbrev") {
            abbrev = data;
            abbrev_size = size;
        } else if (name == ".debug_str") {
            strings = data;
            strings_size = size;
        } else if (name == ".debug_ranges") {
            ranges = data;
            ranges_size = size;
        } else if (name == ".debug_line") {
            line = data;
            line_size = size;
        }
    }
}

# Resolves frames from DWARF: fills each frame's source position from the
# line table, then expands each frame whose address is inside inlined code
# into one frame per inlined call, innermost first, as `addr2line -i` does.
# `targets[i]` is frame i's lookup address as the debug info writes it, or
# 0 to leave the frame as it is.
#
# @returns the frames, with the inlined ones added
_debug_dwarf_frames(sections: _DwarfSections, targets: Array<ulong>, frames: Array<StackFrame>): Array<StackFrame> {
    if (sections.line_size > 0) {
        _debug_dwarf_lines(sections.line, sections.line_size, targets, frames);
    }
    if (sections.info_size == 0 || sections.abbrev_size == 0) {
        return frames;
    }
    var chains = _debug_dwarf_inline_chains(sections, targets);
    var all = Array<StackFrame>();
    ulong index = 0;
    while (index < frames.count) {
        var frame = frames[index];
        var chain = chains[index];
        if (!chain.is_empty) {
            # The innermost inlined function is at the line table's
            # position; each caller is at the call site of the function it
            # inlined, and the real frame at the outermost call site.
            var level = chain.count;
            var position = frame;
            while (level > 0) {
                var call = chain[level - 1];
                var inner = StackFrame(frame.address);
                inner.function = call.function;
                inner.file = position.file;
                inner.line = position.line;
                inner.column = position.column;
                inner.inlined = true;
                all.append(inner);
                position = StackFrame(frame.address);
                position.file = call.file;
                position.line = call.line;
                position.column = call.column;
                level = level - 1;
            }
            frame.file = position.file;
            frame.line = position.line;
            frame.column = position.column;
        }
        all.append(frame);
        index = index + 1;
    }
    return all;
}

# One inlined call: the function inlined, and where its caller called it.
struct _DwarfInline {
    var function: String;
    var file: String;
    var line: int;
    var column: int;

    construct(function: String, file: String, line: int, column: int) {
        this.function = function;
        this.file = file;
        this.line = line;
        this.column = column;
    }
}

# An abbreviation: a DIE's tag, whether it has children, and its
# attributes as (name, form) pairs.
struct _DwarfAbbrev {
    var tag: ulong;
    var children: bool;
    var attributes: Array<ulong>;

    construct() {
        tag = 0;
        children = false;
        attributes = Array<ulong>();
    }
}

# A `.debug_info` unit's header and what its DIEs are read with.
struct _DwarfUnit {
    # The section offsets of the unit's header and of its end.
    var offset: ulong;
    var end: ulong;
    # Where its first DIE starts.
    var first: ulong;
    var version: ulong;
    var address_size: ulong;
    var offset_size: ulong;
    var abbrev_offset: ulong;
    # Abbreviations by code; code 0, and codes the table skips, have tag 0.
    var abbrevs: Array<_DwarfAbbrev>;
    # The unit's base address (its DIE's `DW_AT_low_pc`), for its ranges.
    var base: ulong;
    # Its line table's offset (`DW_AT_stmt_list`), and that table's files
    # once `files_read`.
    var line_offset: ulong;
    var has_lines: bool;
    var files: Array<String>;
    var files_read: bool;

    construct() {
        offset = 0;
        end = 0;
        first = 0;
        version = 0;
        address_size = 8;
        offset_size = 4;
        abbrev_offset = 0;
        abbrevs = Array<_DwarfAbbrev>();
        base = 0;
        line_offset = 0;
        has_lines = false;
        files = Array<String>();
        files_read = false;
    }

    # Reads the header of the unit at section offset `at`. Sets `end` (0
    # when even the length is damaged) and returns whether the unit is one
    # of DWARF version 2 to 4 whose abbreviations it read.
    read(sections: _DwarfSections, at: ulong): bool {
        offset = at;
        end = 0;
        var cursor = _DwarfCursor(sections.info, at, sections.info_size);
        ulong length = cursor.read_fixed(4);
        offset_size = 4;
        if (length == 0xffffffff) {
            length = cursor.read_fixed(8);
            offset_size = 8;
        }
        if (cursor.failed || length > sections.info_size - cursor.position) {
            return false;
        }
        end = cursor.position + length;
        cursor.end = end;
        version = cursor.read_fixed(2);
        if (version < 2 || version > 4) {
            return false;
        }
        var table = cursor.read_fixed(offset_size);
        address_size = cursor.read_fixed(1);
        first = cursor.position;
        base = 0;
        has_lines = false;
        files_read = false;
        if (cursor.failed || (address_size != 4 && address_size != 8)) {
            return false;
        }
        if (abbrevs.is_empty || table != abbrev_offset) {
            abbrev_offset = table;
            return _read_abbrevs(sections);
        }
        return true;
    }

    _read_abbrevs(sections: _DwarfSections): bool {
        abbrevs = Array<_DwarfAbbrev>();
        abbrevs.append(_DwarfAbbrev());
        var cursor = _DwarfCursor(sections.abbrev, abbrev_offset, sections.abbrev_size);
        while (!cursor.failed) {
            var code = cursor.read_uleb();
            if (code == 0) {
                break;
            }
            var abbrev = _DwarfAbbrev();
            abbrev.tag = cursor.read_uleb();
            abbrev.children = cursor.read_fixed(1) != 0;
            while (!cursor.failed) {
                var name = cursor.read_uleb();
                var form = cursor.read_uleb();
                if (name == 0 && form == 0) {
                    break;
                }
                abbrev.attributes.append(name);
                abbrev.attributes.append(form);
            }
            # A code far beyond the table's size is damage.
            if (code > 0x100000) {
                abbrevs = Array<_DwarfAbbrev>();
                return false;
            }
            while (abbrevs.count <= code) {
                abbrevs.append(_DwarfAbbrev());
            }
            abbrevs[code] = abbrev;
        }
        if (cursor.failed) {
            abbrevs = Array<_DwarfAbbrev>();
            return false;
        }
        return true;
    }

    # The path of file number `file` of the unit's line table, or an empty
    # String.
    file_name(sections: _DwarfSections, file: ulong): String {
        if (!files_read) {
            files_read = true;
            if (has_lines && sections.line_size > 0) {
                var header = _DwarfLineHeader();
                header.read(sections.line, sections.line_size, line_offset);
                if (header.valid) {
                    files = header.files;
                }
            }
        }
        return file >= 1 && file <= files.count ? files[file - 1] : "";
    }
}

# The attributes of one DIE that backtraces read.
struct _DwarfDie {
    var tag: ulong;
    var children: bool;
    var name: String;
    var low: ulong;
    var has_low: bool;
    var high: ulong;
    var has_high: bool;
    # `DW_AT_high_pc` is an offset from `low` (any form but an address).
    var high_is_size: bool;
    var ranges: ulong;
    var has_ranges: bool;
    # The section offset of the DIE that names this one
    # (`DW_AT_abstract_origin` or `DW_AT_specification`).
    var origin: ulong;
    var has_origin: bool;
    var line_offset: ulong;
    var has_lines: bool;
    var call_file: ulong;
    var call_line: ulong;
    var call_column: ulong;

    construct() {
        name = String();
        clear();
    }

    clear() {
        tag = 0;
        children = false;
        if (!name.is_empty) {
            name = String();
        }
        low = 0;
        has_low = false;
        high = 0;
        has_high = false;
        high_is_size = false;
        ranges = 0;
        has_ranges = false;
        origin = 0;
        has_origin = false;
        line_offset = 0;
        has_lines = false;
        call_file = 0;
        call_line = 0;
        call_column = 0;
    }

    # Reads the DIE at the cursor. Returns false at a null entry (the end of
    # a list of siblings) or on damage, which sets `cursor.failed`.
    read(cursor: _DwarfCursor, unit: _DwarfUnit, sections: _DwarfSections): bool {
        clear();
        var code = cursor.read_uleb();
        if (code == 0 || cursor.failed) {
            return false;
        }
        if (code >= unit.abbrevs.count || unit.abbrevs[code].tag == 0) {
            cursor.failed = true;
            return false;
        }
        var abbrev = unit.abbrevs[code];
        tag = abbrev.tag;
        children = abbrev.children;
        var attributes = abbrev.attributes;
        ulong index = 0;
        while (index + 1 < attributes.count && !cursor.failed) {
            var attribute = attributes[index];
            var form = attributes[index + 1];
            index = index + 2;
            # DW_FORM_indirect
            while (form == 0x16 && !cursor.failed) {
                form = cursor.read_uleb();
            }
            # DW_FORM_string
            if (form == 0x08) {
                var text = cursor.read_string();
                if (attribute == 0x03) {
                    name = text;
                }
                continue;
            }
            var value = _debug_dwarf_form(cursor, form, unit);
            if (attribute == 0x03 && form == 0x0e) {
                # DW_AT_name as DW_FORM_strp
                name = _debug_dwarf_string(sections, value);
            } else if (attribute == 0x11) {
                low = value;
                has_low = true;
            } else if (attribute == 0x12) {
                high = value;
                has_high = true;
                high_is_size = form != 0x01;
            } else if (attribute == 0x55) {
                ranges = value;
                has_ranges = true;
            } else if (attribute == 0x31 || attribute == 0x47) {
                # A reference within the unit (ref1 to ref_udata) counts
                # from the unit's start; ref_addr from the section's.
                origin = form >= 0x11 && form <= 0x15 ? unit.offset + value : value;
                has_origin = true;
            } else if (attribute == 0x10) {
                line_offset = value;
                has_lines = true;
            } else if (attribute == 0x58) {
                call_file = value;
            } else if (attribute == 0x59) {
                call_line = value;
            } else if (attribute == 0x57) {
                call_column = value;
            }
        }
        return !cursor.failed;
    }

    # Sets `hits[i]` for each target the DIE's code covers, and returns
    # whether it covers any.
    covers(unit: _DwarfUnit, sections: _DwarfSections, targets: Array<ulong>, hits: Array<bool>): bool {
        var any = false;
        ulong index = 0;
        while (index < targets.count) {
            hits[index] = false;
            index = index + 1;
        }
        if (has_low && has_high) {
            var end = high_is_size ? low + high : high;
            return _debug_dwarf_hit(low, end, targets, hits);
        }
        if (!has_ranges || ranges >= sections.ranges_size) {
            return false;
        }
        # A `.debug_ranges` list: (start, end) pairs, relative to a base
        # address that a pair starting with all ones changes, up to (0, 0).
        var cursor = _DwarfCursor(sections.ranges, ranges, sections.ranges_size);
        var size = unit.address_size;
        ulong all_ones = size == 8 ? 0xffffffffffffffff : 0xffffffff;
        var base = unit.base;
        while (!cursor.failed) {
            var start = cursor.read_fixed(size);
            var end = cursor.read_fixed(size);
            if (cursor.failed || (start == 0 && end == 0)) {
                break;
            }
            if (start == all_ones) {
                base = end;
            } else if (_debug_dwarf_hit(base + start, base + end, targets, hits)) {
                any = true;
            }
        }
        return any;
    }
}

# Sets `hits[i]` for each nonzero target in `[start, end)`; returns whether
# there was one.
_debug_dwarf_hit(start: ulong, end: ulong, targets: Array<ulong>, hits: Array<bool>): bool {
    var any = false;
    ulong index = 0;
    while (index < targets.count) {
        var target = targets[index];
        if (target != 0 && target >= start && target < end) {
            hits[index] = true;
            any = true;
        }
        index = index + 1;
    }
    return any;
}

# Reads an attribute value of `form` (any but DW_FORM_string and
# DW_FORM_indirect): a number, an address, a reference or an offset. Blocks
# and expressions are skipped and read as 0, and so is an unknown form,
# which sets `cursor.failed` since its size is unknown.
_debug_dwarf_form(cursor: _DwarfCursor, form: ulong, unit: _DwarfUnit): ulong {
    if (form == 0x01) {
        return cursor.read_fixed(unit.address_size);
    } else if (form == 0x0b || form == 0x0c || form == 0x11) {
        return cursor.read_fixed(1);
    } else if (form == 0x05 || form == 0x12) {
        return cursor.read_fixed(2);
    } else if (form == 0x06 || form == 0x13) {
        return cursor.read_fixed(4);
    } else if (form == 0x07 || form == 0x14 || form == 0x20) {
        return cursor.read_fixed(8);
    } else if (form == 0x0f || form == 0x15) {
        return cursor.read_uleb();
    } else if (form == 0x0d) {
        return cursor.read_sleb() as ulong;
    } else if (form == 0x0e || form == 0x17) {
        return cursor.read_fixed(unit.offset_size);
    } else if (form == 0x10) {
        # DW_FORM_ref_addr: an address's size in DWARF 2, an offset's after.
        return cursor.read_fixed(unit.version == 2 ? unit.address_size : unit.offset_size);
    } else if (form == 0x19) {
        return 1;
    } else if (form == 0x0a) {
        cursor.skip(cursor.read_fixed(1));
    } else if (form == 0x03) {
        cursor.skip(cursor.read_fixed(2));
    } else if (form == 0x04) {
        cursor.skip(cursor.read_fixed(4));
    } else if (form == 0x09 || form == 0x18) {
        cursor.skip(cursor.read_uleb());
    } else {
        cursor.failed = true;
    }
    return 0;
}

# The NUL-terminated string at `offset` in `.debug_str`, or an empty String.
_debug_dwarf_string(sections: _DwarfSections, offset: ulong): String {
    if (offset >= sections.strings_size) {
        return String();
    }
    var cursor = _DwarfCursor(sections.strings, offset, sections.strings_size);
    var text = cursor.read_string();
    return cursor.failed ? String() : text;
}

# For each target, the inlined calls whose code covers it, outermost first:
# the `DW_TAG_inlined_subroutine` entries nested in the function
# (`DW_TAG_subprogram`) the address is in. Empty for an address outside
# inlined code.
_debug_dwarf_inline_chains(sections: _DwarfSections, targets: Array<ulong>): Array<Array<_DwarfInline>> {
    var chains = Array<Array<_DwarfInline>>();
    var hits = Array<bool>();
    for (var target in targets) {
        chains.append(Array<_DwarfInline>());
        hits.append(false);
    }
    var unit = _DwarfUnit();
    var die = _DwarfDie();
    # Names by DIE offset, as they are looked up.
    var names = _DwarfNames();
    ulong at = 0;
    while (at + 11 <= sections.info_size) {
        var readable = unit.read(sections, at);
        if (unit.end == 0) {
            break;
        }
        at = unit.end;
        if (!readable) {
            continue;
        }
        var cursor = _DwarfCursor(sections.info, unit.first, unit.end);
        ulong depth = 0;
        while (!cursor.failed && cursor.position < unit.end) {
            if (!die.read(cursor, unit, sections)) {
                if (cursor.failed || depth <= 1) {
                    break;
                }
                depth = depth - 1;
                continue;
            }
            if (die.children) {
                depth = depth + 1;
            }
            # DW_TAG_compile_unit, DW_TAG_partial_unit
            if (die.tag == 0x11 || die.tag == 0x3c) {
                unit.base = die.has_low ? die.low : 0;
                unit.line_offset = die.line_offset;
                unit.has_lines = die.has_lines;
            } else if (die.tag == 0x2e || die.tag == 0x1d) {
                # DW_TAG_subprogram, DW_TAG_inlined_subroutine
                if (!die.covers(unit, sections, targets, hits)) {
                    continue;
                }
                ulong index = 0;
                while (index < targets.count) {
                    if (hits[index]) {
                        if (die.tag == 0x2e) {
                            chains[index] = Array<_DwarfInline>();
                        } else {
                            var function = die.has_origin ? names.lookup(sections, die.origin) : die.name;
                            var file = unit.file_name(sections, die.call_file);
                            chains[index].append(
                                _DwarfInline(function, file, die.call_line as int, die.call_column as int)
                            );
                        }
                    }
                    index = index + 1;
                }
            }
        }
    }
    return chains;
}

# The names of DIEs looked up by offset, remembered: a backtrace names the
# same inlined functions over and over.
struct _DwarfNames {
    var _offsets: Array<ulong>;
    var _names: Array<String>;
    var _unit: _DwarfUnit;

    construct() {
        _offsets = Array<ulong>();
        _names = Array<String>();
        _unit = _DwarfUnit();
    }

    # The name of the DIE at section offset `offset`, following its
    # `DW_AT_abstract_origin` and `DW_AT_specification` to the DIE that
    # carries one; an empty String when none does.
    lookup(sections: _DwarfSections, offset: ulong): String {
        ulong index = 0;
        while (index < _offsets.count) {
            if (_offsets[index] == offset) {
                return _names[index];
            }
            index = index + 1;
        }
        var name = String();
        var die = _DwarfDie();
        var at = offset;
        # A chain of origins is short; the limit guards against a cycle.
        var steps = 0;
        while (steps < 8) {
            if (!_find_unit(sections, at)) {
                break;
            }
            var cursor = _DwarfCursor(sections.info, at, _unit.end);
            if (!die.read(cursor, _unit, sections)) {
                break;
            }
            if (!die.name.is_empty || !die.has_origin) {
                name = die.name;
                break;
            }
            at = die.origin;
            steps = steps + 1;
        }
        _offsets.append(offset);
        _names.append(name);
        return name;
    }

    # Points `_unit` at the unit containing section offset `at`.
    _find_unit(sections: _DwarfSections, at: ulong): bool {
        if (_unit.end != 0 && at >= _unit.first && at < _unit.end) {
            return true;
        }
        ulong offset = 0;
        while (offset + 11 <= sections.info_size) {
            var readable = _unit.read(sections, offset);
            if (_unit.end == 0) {
                return false;
            }
            if (at < _unit.end) {
                return readable && at >= _unit.first;
            }
            offset = _unit.end;
        }
        return false;
    }
}
debug/module
1507
## Stack walking, panic backtraces, and talking to a debugger.
##
## `debug` is a module: bring it in with `import debug` (and write
## `debug.capture()`).
##
## - [Backtraces](debug-backtrace.md): `capture()` records the calls that
##   led to the current point, cheaply; `Backtrace.frames()` resolves each
##   return address to its function and, in a `-g` build, its source line.
##   `print_backtrace()` writes the current stack to standard error.
## - [The debugger](debug-debugger.md): `output()` writes to the platform's
##   debugger channel, `is_debugger_attached()` asks whether a debugger is
##   watching, and `breakpoint()` stops in it.
##
## A panic prints a backtrace after its message in a build without `-O`;
## the `PEPPER_BACKTRACE` environment variable turns that on (`1`) or off
## (`0`) in any build (see `print_backtrace`).
##
## @example
##     import debug;
##
##     main(): int {
##         var trace = debug.capture();
##         var frames = trace.frames();
##         assert(frames.count > 0, "main is on the stack");
##         debug.output("captured a backtrace");
##         return 0;
##     }

# This file only gathers the module's public API from its other files.

import "backtrace";
import "debugger";

export StackFrame;
export Backtrace;
export capture;
export print_backtrace;

export output;
export is_debugger_attached;
export breakpoint;

# For the prelude's `panic` only (internals.pep).
export _debug_panic_backtrace;
debug/symbols_elf
9527
# Resolving return addresses on Linux: the executable's ELF symbol table
# names the function, its DWARF (in a `-g` build) the source position and
# the inlined calls, and `dladdr` the frames in shared libraries.

import "backtrace";
import "dwarf";

[Target(OS(Linux))]
extern int dladdr(void* address, void* info);
[Target(OS(Linux))]
extern ulong getauxval(ulong entry);
[Target(OS(Linux))]
extern int open(char* path, int flags, ...);
[Target(OS(Linux))]
extern int close(int fd);
[Target(OS(Linux))]
extern long lseek(int fd, long offset, int whence);
[Target(OS(Linux))]
extern void* mmap(void* address, ulong length, int protection, int flags, int descriptor, long offset);
[Target(OS(Linux))]
extern int munmap(void* address, ulong length);

# AT_ENTRY: the executable's entry point, an address inside it.
const _DEBUG_AT_ENTRY: ulong = 9;

[Target(OS(Linux))]
_debug_sys_symbolize(frames: Array<StackFrame>): Array<StackFrame> {
    # Dl_info { dli_fname, dli_fbase, dli_sname, dli_saddr }
    __ptr<ulong> info = _pep_malloc(32);
    ulong main_base = 0;
    if (dladdr(unsafe_cast<__ptr<void>>(getauxval(_DEBUG_AT_ENTRY)), info) != 0) {
        main_base = info[1];
    }
    var image = _DebugElf("/proc/self/exe");
    var targets = Array<ulong>();
    for (var frame in frames) {
        ulong target = 0;
        # A return address is the instruction after the call; the call
        # itself is one byte back.
        var lookup = frame.address > 0 ? frame.address - 1 : 0;
        if (lookup != 0 && dladdr(unsafe_cast<__ptr<void>>(lookup), info) != 0) {
            if (info[1] == main_base && image.valid) {
                target = lookup - main_base + image.first_address;
                frame.function = image.function_at(target);
            } else if (info[2] != 0) {
                frame.function = String(unsafe_cast<__ptr<char>>(info[2]));
            }
        }
        targets.append(target);
    }
    _pep_free(info);
    var all = image.valid ? _debug_dwarf_frames(image.debug, targets, frames) : frames;
    image.close();
    return all;
}

# An ELF64 file mapped read-only, with the parts the symbolizer reads.
[Target(OS(Linux))]
struct _DebugElf {
    var data: __ptr<u8>;
    var size: ulong;
    var valid: bool;
    # The lowest loaded address: where the image's load bias is measured from.
    var first_address: ulong;
    var symbols_offset: ulong;
    var symbols_size: ulong;
    var names_offset: ulong;
    var names_size: ulong;
    # The DWARF sections, inside `data`.
    var debug: _DwarfSections;

    construct(path: String) {
        data = __null;
        size = 0;
        valid = false;
        first_address = 0;
        symbols_offset = 0;
        symbols_size = 0;
        names_offset = 0;
        names_size = 0;
        debug = _DwarfSections();
        _open(path);
    }

    _open(path: String) {
        var fd = open(path.c_str(), 0);
        if (fd < 0) {
            return;
        }
        var length = lseek(fd, 0, 2);
        if (length >= 64) {
            var mapped = mmap(__null, length as ulong, 1, 2, fd, 0);
            if (unsafe_cast<ulong>(mapped) != 0xffffffffffffffff) {
                data = mapped as __ptr<u8>;
                size = length as ulong;
            }
        }
        close(fd);
        if (data != __null) {
            _parse();
        }
    }

    _parse() {
        if (data[0] != 0x7f || data[1] != 'E' || data[2] != 'L' || data[3] != 'F' || data[4] != 2) {
            return;
        }
        var program_headers = _debug_read(data, 0x20, 8);
        var section_headers = _debug_read(data, 0x28, 8);
        var program_count = _debug_read(data, 0x38, 2);
        var section_count = _debug_read(data, 0x3c, 2);
        var names_index = _debug_read(data, 0x3e, 2);
        if (program_headers + program_count * 56 > size || section_headers + section_count * 64 > size) {
            return;
        }
        var first = true;
        ulong index = 0;
        while (index < program_count) {
            var header = program_headers + index * 56;
            # PT_LOAD
            if (_debug_read(data, header, 4) == 1) {
                var address = _debug_read(data, header + 16, 8);
                if (first || address < first_address) {
                    first_address = address;
                    first = false;
                }
            }
            index = index + 1;
        }
        first_address = first_address & ~0xfff;
        if (names_index >= section_count) {
            return;
        }
        var section_names = _debug_read(data, section_headers + names_index * 64 + 24, 8);
        ulong dynamic_symbols = 0;
        ulong dynamic_size = 0;
        ulong dynamic_link = 0;
        index = 0;
        while (index < section_count) {
            var header = section_headers + index * 64;
            var section_type = _debug_read(data, header + 4, 4);
            var offset = _debug_read(data, header + 24, 8);
            var length = _debug_read(data, header + 32, 8);
            var link = _debug_read(data, header + 40, 4);
            if (offset + length <= size) {
                # SHT_SYMTAB, then SHT_DYNSYM as the fallback of a stripped file.
                if (section_type == 2) {
                    symbols_offset = offset;
                    symbols_size = length;
                    _set_names(section_headers, section_count, link);
                } else if (section_type == 11) {
                    dynamic_symbols = offset;
                    dynamic_size = length;
                    dynamic_link = link;
                } else if (section_type == 1 && (_debug_read(data, header + 8, 8) & 0x800) == 0) {
                    # A DWARF section, unless SHF_COMPRESSED, which is not
                    # read.
                    var name = section_names + _debug_read(data, header, 4);
                    if (_name_is(name, ".debug_info")) {
                        debug.set(".debug_info", data + offset, length);
                    } else if (_name_is(name, ".debug_abbrev")) {
                        debug.set(".debug_abbrev", data + offset, length);
                    } else if (_name_is(name, ".debug_str")) {
                        debug.set(".debug_str", data + offset, length);
                    } else if (_name_is(name, ".debug_ranges")) {
                        debug.set(".debug_ranges", data + offset, length);
                    } else if (_name_is(name, ".debug_line")) {
                        debug.set(".debug_line", data + offset, length);
                    }
                }
            }
            index = index + 1;
        }
        if (symbols_size == 0 && dynamic_size > 0) {
            symbols_offset = dynamic_symbols;
            symbols_size = dynamic_size;
            _set_names(section_headers, section_count, dynamic_link);
        }
        valid = true;
    }

    # Points the symbol names at section `link`, the symbol table's strings.
    _set_names(section_headers: ulong, section_count: ulong, link: ulong) {
        if (link >= section_count) {
            return;
        }
        var header = section_headers + link * 64;
        names_offset = _debug_read(data, header + 24, 8);
        names_size = _debug_read(data, header + 32, 8);
        if (names_offset + names_size > size) {
            names_size = 0;
        }
    }

    # Whether the NUL-terminated name at `offset` is `name`.
    _name_is(offset: ulong, name: String): bool {
        if (offset + name.size >= size) {
            return false;
        }
        var bytes = name.c_str();
        ulong index = 0;
        while (index < name.size) {
            if (data[offset + index] != bytes[index] as u8) {
                return false;
            }
            index = index + 1;
        }
        return data[offset + name.size] == 0;
    }

    # The readable name of the function containing `address` (an address as
    # the file lays it out), or an empty String.
    function_at(address: ulong): String {
        ulong best = 0;
        ulong best_name = 0;
        var found = false;
        ulong symbol = symbols_offset;
        while (symbol + 24 <= symbols_offset + symbols_size) {
            # Elf64_Sym { st_name, st_info, st_other, st_shndx, st_value, st_size }
            var symbol_type = data[symbol + 4] & 0xf;
            var section = _debug_read(data, symbol + 6, 2);
            var start = _debug_read(data, symbol + 8, 8);
            var length = _debug_read(data, symbol + 16, 8);
            # STT_FUNC, defined
            if (symbol_type == 2 && section != 0 && start <= address && (length == 0 || address < start + length)) {
                if (!found || start > best) {
                    best = start;
                    best_name = _debug_read(data, symbol, 4);
                    found = true;
                }
            }
            symbol = symbol + 24;
        }
        if (!found || best_name >= names_size) {
            return "";
        }
        var name = String(unsafe_cast<__ptr<char>>(data + names_offset + best_name));
        return _debug_demangle(name);
    }

    close() {
        if (data != __null) {
            munmap(data, size);
            data = __null;
        }
        valid = false;
    }
}
debug/symbols_macho
11463
# Resolving return addresses on macOS: the executable's Mach-O symbol
# table (mapped in memory) names the function, the DWARF in the `.dSYM`
# bundle a `-g` build writes beside it gives the source position and the
# inlined calls, and `dladdr` names the frames in system libraries.

import "backtrace";
import "dwarf";

[Target(OS(Mac))]
extern int dladdr(void* address, void* info);
[Target(OS(Mac))]
extern void* _dyld_get_image_header(uint index);
[Target(OS(Mac))]
extern uint _dyld_image_count();
[Target(OS(Mac))]
extern int _NSGetExecutablePath(char* buffer, uint* size);
[Target(OS(Mac))]
extern int open(char* path, int flags, ...);
[Target(OS(Mac))]
extern int close(int fd);
[Target(OS(Mac))]
extern long lseek(int fd, long offset, int whence);
[Target(OS(Mac))]
extern void* mmap(void* address, ulong length, int protection, int flags, int descriptor, long offset);
[Target(OS(Mac))]
extern int munmap(void* address, ulong length);

[Target(OS(Mac))]
_debug_sys_symbolize(frames: Array<StackFrame>): Array<StackFrame> {
    __ptr<u8> header = _debug_executable_header();
    # Dl_info { dli_fname, dli_fbase, dli_sname, dli_saddr }
    __ptr<ulong> info = _pep_malloc(32);
    var symbols = _DebugMachSymbols(header);
    var targets = Array<ulong>();
    for (var frame in frames) {
        ulong target = 0;
        # The call is one byte before the return address.
        var lookup = frame.address > 0 ? frame.address - 1 : 0;
        if (lookup != 0 && dladdr(unsafe_cast<__ptr<void>>(lookup), info) != 0) {
            if (info[1] == unsafe_cast<ulong>(header)) {
                target = lookup - symbols.slide;
                frame.function = symbols.function_at(target);
            } else if (info[2] != 0) {
                frame.function = String(unsafe_cast<__ptr<char>>(info[2]));
            }
        }
        targets.append(target);
    }
    _pep_free(info);
    return _debug_dsym_frames(targets, frames);
}

# The executable's Mach-O header: the loaded image whose file type is
# MH_EXECUTE.
[Target(OS(Mac))]
_debug_executable_header(): __ptr<u8> {
    var count = _dyld_image_count();
    uint index = 0;
    while (index < count) {
        __ptr<u8> header = _dyld_get_image_header(index);
        if (header != __null && _debug_read(header, 12, 4) == 2) {
            return header;
        }
        index = index + 1;
    }
    return __null;
}

# The symbol table of the main executable, read where dyld mapped its
# __LINKEDIT segment, and its slide: how far from its linked address dyld
# loaded it.
[Target(OS(Mac))]
struct _DebugMachSymbols {
    var slide: ulong;
    # The 1-based section number of __TEXT,__text, where functions are.
    var _text_section: ulong;
    var _symbols: __ptr<u8>;
    var _count: ulong;
    var _names: __ptr<u8>;
    var _names_size: ulong;

    construct(header: __ptr<u8>) {
        slide = 0;
        _text_section = 0;
        _symbols = __null;
        _count = 0;
        _names = __null;
        _names_size = 0;
        _read(header);
    }

    _read(header: __ptr<u8>) {
        # MH_MAGIC_64
        if (header == __null || _debug_read(header, 0, 4) != 0xfeedfacf) {
            return;
        }
        var commands = _debug_read(header, 16, 4);
        ulong command = 32;
        ulong linkedit_address = 0;
        ulong linkedit_offset = 0;
        var linkedit = false;
        ulong symbol_offset = 0;
        ulong names_offset = 0;
        var symtab = false;
        var text = false;
        ulong sections = 0;
        ulong index = 0;
        while (index < commands) {
            var kind = _debug_read(header, command, 4);
            var size = _debug_read(header, command + 4, 4);
            if (kind == 0x19) {
                # LC_SEGMENT_64: its section_64 headers (80 bytes each)
                # follow it, numbered from 1 across the whole file.
                var count = _debug_read(header, command + 64, 4);
                if (_debug_name_is(header + command + 8, "__TEXT")) {
                    slide = unsafe_cast<ulong>(header) - _debug_read(header, command + 24, 8);
                    text = true;
                    ulong section = 0;
                    while (section < count) {
                        if (_debug_name_is(header + command + 72 + section * 80, "__text")) {
                            _text_section = sections + section + 1;
                        }
                        section = section + 1;
                    }
                }
                sections = sections + count;
            }
            # LC_SEGMENT_64 named __LINKEDIT
            if (kind == 0x19 && _debug_name_is(header + command + 8, "__LINKEDIT")) {
                linkedit_address = _debug_read(header, command + 24, 8);
                linkedit_offset = _debug_read(header, command + 40, 8);
                linkedit = true;
            } else if (kind == 0x2) {
                # LC_SYMTAB { symoff, nsyms, stroff, strsize }
                symbol_offset = _debug_read(header, command + 8, 4);
                _count = _debug_read(header, command + 12, 4);
                names_offset = _debug_read(header, command + 16, 4);
                _names_size = _debug_read(header, command + 20, 4);
                symtab = true;
            }
            if (size == 0) {
                break;
            }
            command = command + size;
            index = index + 1;
        }
        if (!linkedit || !symtab || !text) {
            _count = 0;
            return;
        }
        var base = linkedit_address + slide - linkedit_offset;
        _symbols = unsafe_cast<__ptr<u8>>(base + symbol_offset);
        _names = unsafe_cast<__ptr<u8>>(base + names_offset);
    }

    # The readable name of the function containing `address` (an address
    # before the slide), or an empty String: the nearest symbol at or
    # below it, since Mach-O symbols carry no size.
    function_at(address: ulong): String {
        ulong best = 0;
        ulong best_name = 0;
        var found = false;
        ulong index = 0;
        while (index < _count) {
            # nlist_64 { n_strx, n_type, n_sect, n_desc, n_value }
            var entry = index * 16;
            var symbol_type = _symbols[entry + 4];
            var section = _symbols[entry + 5] as ulong;
            var value = _debug_read(_symbols, entry + 8, 8);
            # Not a debugging (stab) entry, and defined in a section (N_SECT).
            if ((symbol_type & 0xe0) == 0
                && (symbol_type & 0x0e) == 0x0e
                && value <= address
                && (!found || value > best)) {
                best = value;
                best_name = _debug_read(_symbols, entry, 4);
                found = true;
            }
            index = index + 1;
        }
        if (!found || best_name >= _names_size) {
            return "";
        }
        var name = String(unsafe_cast<__ptr<char>>(_names + best_name));
        # C symbols carry a leading underscore on Mach-O.
        if (name.starts_with("_")) {
            name = name.substr_bytes(1, name.size - 1);
        }
        return _debug_demangle(name);
    }
}

# Whether the 16-byte, NUL-padded Mach-O name at `field` is `name`.
[Target(OS(Mac))]
_debug_name_is(field: __ptr<u8>, name: String): bool {
    var bytes = name.c_str();
    ulong index = 0;
    while (index < 16) {
        var expected = index < name.size ? bytes[index] as u8 : 0 as u8;
        if (field[index] != expected) {
            return false;
        }
        if (expected == 0) {
            return true;
        }
        index = index + 1;
    }
    return true;
}

# Fills source positions and adds inlined calls from `<executable>.dSYM/
# Contents/Resources/DWARF/<name>`, when a `-g` build left one beside the
# executable; returns the frames.
[Target(OS(Mac))]
_debug_dsym_frames(targets: Array<ulong>, frames: Array<StackFrame>): Array<StackFrame> {
    __ptr<char> buffer = _pep_malloc(4096);
    __ptr<uint> size = _pep_malloc(4);
    size[0] = 4096;
    var executable = _NSGetExecutablePath(buffer, size) == 0 ? String(buffer) : String();
    _pep_free(size);
    _pep_free(buffer);
    if (executable.is_empty) {
        return frames;
    }
    var slash = executable.rfind("/");
    var name = slash >= 0 ?
        executable.substr_bytes((slash + 1) as ulong, executable.size - (slash + 1) as ulong) :
        executable;
    var path = $"{executable}.dSYM/Contents/Resources/DWARF/{name}";
    var fd = open(path.c_str(), 0);
    if (fd < 0) {
        return frames;
    }
    var length = lseek(fd, 0, 2);
    __ptr<u8> data = __null;
    if (length >= 32) {
        var mapped = mmap(__null, length as ulong, 1, 2, fd, 0);
        if (unsafe_cast<ulong>(mapped) != 0xffffffffffffffff) {
            data = mapped as __ptr<u8>;
        }
    }
    close(fd);
    if (data == __null) {
        return frames;
    }
    var file_size = length as ulong;
    var dwarf = _DwarfSections();
    if (_debug_read(data, 0, 4) == 0xfeedfacf) {
        var commands = _debug_read(data, 16, 4);
        ulong command = 32;
        ulong index = 0;
        while (index < commands && command + 72 <= file_size) {
            var kind = _debug_read(data, command, 4);
            var command_size = _debug_read(data, command + 4, 4);
            # LC_SEGMENT_64 named __DWARF: its section_64 headers follow it.
            if (kind == 0x19 && _debug_name_is(data + command + 8, "__DWARF")) {
                var sections = _debug_read(data, command + 64, 4);
                ulong section = 0;
                while (section < sections && command + 72 + (section + 1) * 80 <= file_size) {
                    var header = command + 72 + section * 80;
                    var bytes = _debug_read(data, header + 40, 8);
                    var offset = _debug_read(data, header + 48, 4);
                    if (offset + bytes <= file_size) {
                        # Mach-O spells `.debug_line` `__debug_line`.
                        if (_debug_name_is(data + header, "__debug_info")) {
                            dwarf.set(".debug_info", data + offset, bytes);
                        } else if (_debug_name_is(data + header, "__debug_abbrev")) {
                            dwarf.set(".debug_abbrev", data + offset, bytes);
                        } else if (_debug_name_is(data + header, "__debug_str")) {
                            dwarf.set(".debug_str", data + offset, bytes);
                        } else if (_debug_name_is(data + header, "__debug_ranges")) {
                            dwarf.set(".debug_ranges", data + offset, bytes);
                        } else if (_debug_name_is(data + header, "__debug_line")) {
                            dwarf.set(".debug_line", data + offset, bytes);
                        }
                    }
                    section = section + 1;
                }
            }
            if (command_size == 0) {
                break;
            }
            command = command + command_size;
            index = index + 1;
        }
    }
    var all = _debug_dwarf_frames(dwarf, targets, frames);
    munmap(data, file_size);
    return all;
}
debug/sys_posix
4769
# POSIX (Linux, macOS) platform layer for debug. Every declaration carries
# [Target(OS(Linux) || OS(Mac))] or a narrower target; sys_windows.pep and
# sys_wasi.pep declare the same `_debug_sys_*` functions with the same
# signatures.

[Target((OS(Linux) && !OS(Android)) || OS(Mac))]
extern int backtrace(void* buffer, int size);
[Target(OS(Android))]
extern int _Unwind_Backtrace(extern (__ptr<void>, __ptr<void>) => int trace, void* state);
[Target(OS(Android))]
extern ulong _Unwind_GetIP(void* context);
[Target(OS(Linux) || OS(Mac))]
extern int open(char* path, int flags, ...);
[Target(OS(Linux) || OS(Mac))]
extern long read(int fd, void* buf, ulong n);
[Target(OS(Linux) || OS(Mac))]
extern int close(int fd);
[Target(OS(Mac))]
extern int getpid();
[Target(OS(Mac))]
extern int sysctl(int* name, uint count, void* value, ulong* size, void* new_value, ulong new_size);

# Appends up to `limit` return addresses, innermost first: glibc's and
# libSystem's `backtrace`, which unwinds through the tables every function
# carries (`uwtable`).
[Target((OS(Linux) && !OS(Android)) || OS(Mac))]
_debug_sys_capture(addresses: Array<ulong>, limit: int) {
    __ptr<ulong> buffer = _pep_malloc((limit as ulong) * 8);
    var count = backtrace(buffer, limit);
    ulong index = 0;
    while (index < count as ulong) {
        addresses.append(buffer[index]);
        index = index + 1;
    }
    _pep_free(buffer);
}

# Android: bionic has `backtrace` only from API level 33, so unwind with the
# unwinder every Android program links (the NDK's libunwind), as `backtrace`
# does. `state` holds the count so far, the limit, then the addresses.
[Target(OS(Android))]
_debug_sys_capture(addresses: Array<ulong>, limit: int) {
    __ptr<ulong> state = _pep_malloc(((limit as ulong) + 2) * 8);
    state[0] = 0;
    state[1] = limit as ulong;
    var trace: extern (__ptr<void>, __ptr<void>) => int = _debug_unwind_step;
    _Unwind_Backtrace(trace, state);
    ulong index = 0;
    while (index < state[0]) {
        addresses.append(state[index + 2]);
        index = index + 1;
    }
    _pep_free(state);
}

# One frame of `_Unwind_Backtrace`: records its address, and stops the walk
# (`_URC_END_OF_STACK`, 5) once `state` is full.
[Target(OS(Android))]
_debug_unwind_step(context: __ptr<void>, data: __ptr<void>): int {
    __ptr<ulong> state = data;
    if (state[0] >= state[1]) {
        return 5;
    }
    state[state[0] + 2] = _Unwind_GetIP(context);
    state[0] = state[0] + 1;
    return 0;
}

# Linux and macOS have no debugger channel apart from the program's own
# streams: debuggers show standard error.
[Target(OS(Linux) || OS(Mac))]
_debug_sys_output(text: String) {
    var line = text.ends_with("\n") ? text : $"{text}\n";
    _pep_write_error(line.c_str());
}

# Linux: the `TracerPid:` line of /proc/self/status names the tracing
# process, 0 when there is none.
[Target(OS(Linux))]
_debug_sys_debugger_attached(): bool {
    var fd = open("/proc/self/status".c_str(), 0);
    if (fd < 0) {
        return false;
    }
    var text = StringBuilder();
    __ptr<char> buffer = _pep_malloc(4096);
    while (true) {
        var count = read(fd, buffer, 4096);
        if (count <= 0) {
            break;
        }
        text.append(String(buffer, count as ulong));
    }
    _pep_free(buffer);
    close(fd);
    var status = text.to_string();
    var at = status.find("TracerPid:");
    if (at < 0) {
        return false;
    }
    var index = (at as ulong) + 10;
    var bytes = status.c_str();
    while (index < status.size && (bytes[index] == ' ' || bytes[index] == '\t')) {
        index = index + 1;
    }
    return index < status.size && bytes[index] != '0';
}

# macOS: `P_TRACED` in the process's `kinfo_proc` (Apple's technical Q&A
# QA1361): `kp_proc.p_flag` is the int at offset 32.
[Target(OS(Mac))]
_debug_sys_debugger_attached(): bool {
    # CTL_KERN, KERN_PROC, KERN_PROC_PID, pid
    __ptr<int> name = _pep_malloc(16);
    name[0] = 1;
    name[1] = 14;
    name[2] = 1;
    name[3] = getpid();
    ulong info_size = 648;
    __ptr<u8> info = _pep_malloc(info_size);
    __ptr<ulong> size = _pep_malloc(8);
    size[0] = info_size;
    var traced = false;
    if (sysctl(name, 4, info, size, __null, 0) == 0) {
        var flags = unsafe_cast<__ptr<int>>(info + 32);
        # P_TRACED
        traced = (flags[0] & 0x800) != 0;
    }
    _pep_free(size);
    _pep_free(info);
    _pep_free(name);
    return traced;
}

[Target(OS(Linux) || OS(Mac))]
[Link(name = "llvm.debugtrap")]
extern void _debug_trap();

[Target(OS(Linux) || OS(Mac))]
_debug_sys_breakpoint() {
    _debug_trap();
}
debug/sys_wasi
679
# WASI platform layer for debug: a WebAssembly program cannot walk its own
# stack or be attached to, so capture records nothing and output goes to
# standard error.

import "backtrace";

[Target(OS(Wasi))]
_debug_sys_capture(addresses: Array<ulong>, limit: int) {}

[Target(OS(Wasi))]
_debug_sys_symbolize(frames: Array<StackFrame>): Array<StackFrame> {
    return frames;
}

[Target(OS(Wasi))]
_debug_sys_output(text: String) {
    var line = text.ends_with("\n") ? text : $"{text}\n";
    _pep_write_error(line.c_str());
}

[Target(OS(Wasi))]
_debug_sys_debugger_attached(): bool {
    return false;
}

[Target(OS(Wasi))]
_debug_sys_breakpoint() {}
debug/sys_windows
9099
# Windows platform layer for debug: RtlCaptureStackBackTrace captures,
# DbgHelp resolves (from the `.pdb` every build writes beside the
# executable: public symbols only without `-g`), and OutputDebugStringW is the debugger channel. Every
# declaration carries [Target(OS(Windows))].

import "backtrace";

[Target(OS(Windows))]
extern ushort RtlCaptureStackBackTrace(uint skip, uint count, void* trace, uint* hash);
[Target(OS(Windows))]
extern void* GetCurrentProcess();
[Target(OS(Windows))]
extern uint GetModuleFileNameA(void* module, char* name, uint size);
[Target(OS(Windows))]
extern void OutputDebugStringW(ushort* text);
[Target(OS(Windows))]
extern int IsDebuggerPresent();
[Target(OS(Windows))]
extern int MultiByteToWideChar(uint code_page, uint flags, char* text, int size, ushort* wide, int wide_size);
[Target(OS(Windows))]
extern void Sleep(uint milliseconds);
[Target(OS(Windows))]
extern void memset(void* p, int c, ulong n);
[Target(OS(Windows))]
extern void* calloc(ulong count, ulong size);
[Target(OS(Windows))]
[Link("dbghelp")]
extern uint SymSetOptions(uint options);
[Target(OS(Windows))]
[Link("dbghelp")]
extern int SymInitialize(void* process, char* search_path, int invade);
[Target(OS(Windows))]
[Link("dbghelp")]
extern int SymFromAddr(void* process, ulong address, ulong* displacement, void* symbol);
[Target(OS(Windows))]
[Link("dbghelp")]
extern int SymGetLineFromAddr64(void* process, ulong address, uint* displacement, void* line);
[Target(OS(Windows))]
[Link("dbghelp")]
extern int SymRefreshModuleList(void* process);
[Target(OS(Windows))]
[Link("dbghelp")]
extern uint SymAddrIncludeInlineTrace(void* process, ulong address);
[Target(OS(Windows))]
[Link("dbghelp")]
extern int SymQueryInlineTrace(
    void* process,
    ulong start_address,
    uint start_context,
    ulong start_return_address,
    ulong current_address,
    uint* current_context,
    uint* current_frame_index
);
[Target(OS(Windows))]
[Link("dbghelp")]
extern int SymFromInlineContext(void* process, ulong address, uint context, ulong* displacement, void* symbol);
[Target(OS(Windows))]
[Link("dbghelp")]
extern int SymGetLineFromInlineContext(
    void* process, ulong address, uint context, ulong module_base, uint* displacement, void* line
);

[Target(OS(Windows))]
_debug_sys_capture(addresses: Array<ulong>, limit: int) {
    __ptr<ulong> buffer = _pep_malloc((limit as ulong) * 8);
    var count = RtlCaptureStackBackTrace(0, limit as uint, buffer, __null) as ulong;
    ulong index = 0;
    while (index < count) {
        addresses.append(buffer[index]);
        index = index + 1;
    }
    _pep_free(buffer);
}

# DbgHelp is single-threaded: [0] is a spin lock around every call into
# it, [1] is 1 once SymInitialize has run (it stays initialized).
[Target(OS(Windows))]
const _debug_dbghelp_state: __ptr<int> = _debug_new_dbghelp_state();

# C's calloc, not _pep_malloc: the prelude imports this module, so this
# initializer runs before the prelude's own, which _pep_malloc needs. The
# memory lives as long as the process.
[Target(OS(Windows))]
_debug_new_dbghelp_state(): __ptr<int> {
    return calloc(2, 4);
}

# SYMBOL_INFO: SizeOfStruct (88 with its one-byte Name) at 0, MaxNameLen at
# 80, Name at 84.
const _DEBUG_SYMBOL_INFO_SIZE: ulong = 88;
const _DEBUG_SYMBOL_NAME_MAX: ulong = 512;
# IMAGEHLP_LINE64: SizeOfStruct at 0, LineNumber at 16, FileName at 24.
const _DEBUG_LINE_INFO_SIZE: ulong = 40;

# Each address expands into its inlined calls, innermost first: DbgHelp
# numbers them with consecutive inline contexts from the one
# SymQueryInlineTrace returns, and the real frame takes the context after
# the last.
[Target(OS(Windows))]
_debug_sys_symbolize(frames: Array<StackFrame>): Array<StackFrame> {
    var all = Array<StackFrame>();
    var process = GetCurrentProcess();
    while (!__atomic_cmpxchg<int>(_debug_dbghelp_state, 0, 1)) {
        Sleep(0);
    }
    if (_debug_dbghelp_state[1] == 0) {
        # SYMOPT_DEFERRED_LOADS | SYMOPT_LOAD_LINES. Not SYMOPT_UNDNAME: it
        # strips the leading '_' of a public symbol (all a build without -g
        # has), and `_debug_demangle` needs it to recognize a `_P` name.
        SymSetOptions(0x14);
        __ptr<char> path = _pep_malloc(1024);
        var length = GetModuleFileNameA(__null, path, 1024) as ulong;
        # Search the executable's folder, where the linker writes the .pdb.
        while (length > 0 && path[length - 1] != '\\' && path[length - 1] != '/') {
            length = length - 1;
        }
        path[length] = 0;
        if (SymInitialize(process, length > 0 ? path : __null, 1) != 0) {
            _debug_dbghelp_state[1] = 1;
        }
        _pep_free(path);
    } else {
        # Modules loaded since the last call.
        SymRefreshModuleList(process);
    }
    if (_debug_dbghelp_state[1] == 1) {
        __ptr<u8> symbol = _pep_malloc(_DEBUG_SYMBOL_INFO_SIZE + _DEBUG_SYMBOL_NAME_MAX);
        __ptr<u8> line = _pep_malloc(_DEBUG_LINE_INFO_SIZE);
        __ptr<ulong> displacement = _pep_malloc(8);
        # [0] the inline context, [1] the frame index SymQueryInlineTrace
        # also returns.
        __ptr<uint> context = _pep_malloc(8);
        for (var frame in frames) {
            # The call is one byte before the return address.
            var lookup = frame.address > 0 ? frame.address - 1 : 0;
            var inlined = lookup != 0 ? SymAddrIncludeInlineTrace(process, lookup) : 0;
            context[0] = 0;
            if (inlined > 0 && SymQueryInlineTrace(process, lookup, 0, lookup, lookup, context, context + 1) == 0) {
                inlined = 0;
            }
            uint level = 0;
            while (level < inlined) {
                var inner = StackFrame(frame.address);
                inner.inlined = true;
                _debug_symbol_and_line(process, lookup, context[0], true, symbol, line, displacement, inner);
                all.append(inner);
                context[0] = context[0] + 1;
                level = level + 1;
            }
            _debug_symbol_and_line(process, lookup, context[0], inlined > 0, symbol, line, displacement, frame);
            all.append(frame);
        }
        _pep_free(context);
        _pep_free(displacement);
        _pep_free(line);
        _pep_free(symbol);
    } else {
        all = frames;
    }
    __atomic_store<int>(_debug_dbghelp_state, 0);
    return all;
}

# Fills `frame`'s function and source line at `lookup`: for inline context
# `context` when `by_context` (an address inside inlined code), or by
# address alone. `symbol`, `line` and `displacement` are scratch buffers.
[Target(OS(Windows))]
_debug_symbol_and_line(
    process: __ptr<void>,
    lookup: ulong,
    context: uint,
    by_context: bool,
    symbol: __ptr<u8>,
    line: __ptr<u8>,
    displacement: __ptr<ulong>,
    frame: StackFrame
) {
    memset(symbol, 0, _DEBUG_SYMBOL_INFO_SIZE + _DEBUG_SYMBOL_NAME_MAX);
    __ptr<uint> symbol_size = unsafe_cast<__ptr<uint>>(symbol);
    symbol_size[0] = _DEBUG_SYMBOL_INFO_SIZE as uint;
    symbol_size[20] = _DEBUG_SYMBOL_NAME_MAX as uint;
    var named = by_context && frame.inlined ?
        SymFromInlineContext(process, lookup, context, displacement, symbol) :
        SymFromAddr(process, lookup, displacement, symbol);
    if (named != 0) {
        frame.function = _debug_demangle(String(unsafe_cast<__ptr<char>>(symbol + 84)));
    }
    memset(line, 0, _DEBUG_LINE_INFO_SIZE);
    __ptr<uint> line_size = unsafe_cast<__ptr<uint>>(line);
    line_size[0] = _DEBUG_LINE_INFO_SIZE as uint;
    var found = by_context ?
        SymGetLineFromInlineContext(process, lookup, context, 0, unsafe_cast<__ptr<uint>>(displacement), line) :
        SymGetLineFromAddr64(process, lookup, unsafe_cast<__ptr<uint>>(displacement), line);
    if (found != 0) {
        __ptr<int> line_number = unsafe_cast<__ptr<int>>(line + 16);
        frame.line = line_number[0];
        __ptr<__ptr<char>> file_name = unsafe_cast<__ptr<__ptr<char>>>(line + 24);
        __ptr<char> file = file_name[0];
        if (file != __null) {
            frame.file = String(file);
        }
    }
}

[Target(OS(Windows))]
_debug_sys_output(text: String) {
    var line = text.ends_with("\n") ? text : $"{text}\n";
    # CP_UTF8; a size of -1 converts through the terminating NUL.
    var count = MultiByteToWideChar(65001, 0, line.c_str(), -1, __null, 0);
    if (count <= 0) {
        return;
    }
    __ptr<ushort> wide = _pep_malloc((count as ulong) * 2);
    MultiByteToWideChar(65001, 0, line.c_str(), -1, wide, count);
    OutputDebugStringW(wide);
    _pep_free(wide);
}

[Target(OS(Windows))]
_debug_sys_debugger_attached(): bool {
    return IsDebuggerPresent() != 0;
}

[Target(OS(Windows))]
[Link(name = "llvm.debugtrap")]
extern void _debug_trap();

[Target(OS(Windows))]
_debug_sys_breakpoint() {
    _debug_trap();
}
deque
10983
## `Deque`: a double-ended queue over a growable ring buffer.

import "array";
import "iterator";
import "optional";

# The ring is an `Array<T?>` whose count is the capacity: element `i` lives
# in slot `(_head + i) % capacity`, and every slot outside the live range is
# Empty, so a removed element is released at once and nothing is read
# uninitialized. Growing copies the elements, in order, into a ring twice
# the size starting at slot 0.

## A double-ended queue: a sequence that grows and shrinks at both ends in
## amortized O(1).
##
## Elements live in a ring buffer that doubles when full (starting at 4
## slots), so `push_front`, `push_back`, `pop_front` and `pop_back` are
## amortized O(1), and indexing is O(1) with index 0 at the front. Use it for
## first-in first-out queues, breadth-first search, sliding windows and undo
## history; an `Array` takes O(count) to remove its first element.
##
## For a struct `T` the deque holds a counted reference to each element, as
## an `Array` does: pushing acquires it, and popping hands the deque's
## reference to the caller. `Deque` is itself a struct, so assigning it
## shares the same deque. A `Deque` is not `[Shared]`: keep each one on one
## thread.
##
## A `Deque` is `Iterable<T>`: `for (var x in d)` visits the elements from
## front to back. Every change (a push, a pop, an element store, `clear`)
## invalidates running iterators, and the next step of such a loop panics
## with "Deque modified during iteration". An array converts to a deque, so
## an array literal can initialize one.
##
## @typeParam T the element type
## @example
##     Deque<int> queue = [1, 2];
##     queue.push_back(3);
##     queue.push_front(0);
##     assert(queue.pop_front() == 0, "front first");
##     assert(queue.pop_back() == 3, "then the back");
##     assert(queue[0] == 1 and queue.count == 2, "1 and 2 remain");
export struct Deque<T> {
    ## The ring: `capacity` slots, the elements in `_count` of them from
    ## `_head` on, wrapping around, and every other slot Empty. Internal.
    Array<T?> _slots;
    ## The slot holding the front element. Internal.
    ulong _head;
    ## The number of elements. Read it through `count`.
    ulong _count;
    ## Incremented by every change, so an iterator can detect one. Internal.
    ulong _version;

    ## Creates an empty deque with room for `capacity` elements before it
    ## grows.
    ##
    ## @param capacity the number of slots to allocate up front
    construct(capacity: ulong = 0) {
        _resize(capacity);
    }

    ## Creates a deque holding the elements of `items`, front to back in
    ## index order. The array is copied, not shared.
    ##
    ## The constructor is `[Implicit]`: an array converts to a deque
    ## wherever a deque is expected, so an array literal can initialize one.
    ##
    ## @param items the elements, the first at the front
    ## @example
    ##     Deque<String> names = ["ada", "grace"];
    ##     assert(names.front() == "ada", "the first element is the front");
    [Implicit]
    construct(items: T[]) {
        _resize(items.count);
        for (var item in items) {
            push_back(item);
        }
    }

    # The slot of element `index`, which must be less than `capacity`.
    _slot(index: ulong): ulong {
        return (_head + index) % _slots.count;
    }

    # Moves the elements into a new ring of `capacity` slots, at least
    # `_count`, starting at slot 0.
    _resize(capacity: ulong) {
        var slots = Array<T?>(capacity);
        ulong i = 0;
        while (i < capacity) {
            slots.append(i < _count ? _slots[_slot(i)] : Optional<T>.Empty);
            i = i + 1;
        }
        _slots = slots;
        _head = 0;
    }

    # Makes room for one more element.
    _grow() {
        if (_count < _slots.count) {
            return;
        }
        _resize(_slots.count < 4 ? 4 : _slots.count * 2);
    }

    ## The number of elements.
    var count: ulong {
        get {
            return _count;
        }
    }

    ## Whether the deque has no elements.
    var is_empty: bool {
        get {
            return _count == 0;
        }
    }

    ## The number of elements the deque holds without growing.
    var capacity: ulong {
        get {
            return _slots.count;
        }
    }

    ## Makes room for `capacity` elements in all, so pushing up to that
    ## many does not grow the deque. Never shrinks it.
    ##
    ## @param capacity the number of elements to make room for
    reserve(capacity: ulong) {
        if (capacity <= _slots.count) {
            return;
        }
        _resize(capacity);
    }

    ## Adds `item` at the back. Amortized O(1). Invalidates running
    ## iterators.
    ##
    ## @param item the element to add
    push_back(item: T) {
        _grow();
        _version = _version + 1;
        _slots[_slot(_count)] = Optional<T>.Value(item);
        _count = _count + 1;
    }

    ## Adds `item` at the front, so it becomes element 0. Amortized O(1).
    ## Invalidates running iterators.
    ##
    ## @param item the element to add
    push_front(item: T) {
        _grow();
        _version = _version + 1;
        _head = _slot(_slots.count - 1);
        _slots[_head] = Optional<T>.Value(item);
        _count = _count + 1;
    }

    ## Removes and returns the front element. O(1). Invalidates running
    ## iterators.
    ##
    ## @returns the element that was at the front
    ## @panics if the deque is empty ("Deque pop_front on empty Deque")
    pop_front(location: __ptr<char> = __caller_location()): T {
        assert(_count > 0, "Deque pop_front on empty Deque", location);
        var item = _take(_head);
        _head = _slot(1);
        return item;
    }

    ## Removes and returns the back element. O(1). Invalidates running
    ## iterators.
    ##
    ## @returns the element that was at the back
    ## @panics if the deque is empty ("Deque pop_back on empty Deque")
    pop_back(location: __ptr<char> = __caller_location()): T {
        assert(_count > 0, "Deque pop_back on empty Deque", location);
        return _take(_slot(_count - 1));
    }

    # Empties slot `slot`, an end of the live range, and returns its element.
    _take(slot: ulong): T {
        _version = _version + 1;
        var item = _slots[slot].value();
        _slots[slot] = Optional<T>.Empty;
        _count = _count - 1;
        return item;
    }

    ## Returns the front element without removing it; the same as `d[0]`.
    ##
    ## @returns the element at index 0
    ## @panics if the deque is empty ("Deque front on empty Deque")
    front(location: __ptr<char> = __caller_location()): T {
        assert(_count > 0, "Deque front on empty Deque", location);
        return _slots[_head].value();
    }

    ## Returns the back element without removing it; the same as
    ## `d[d.count - 1]`.
    ##
    ## @returns the element at index `count - 1`
    ## @panics if the deque is empty ("Deque back on empty Deque")
    back(location: __ptr<char> = __caller_location()): T {
        assert(_count > 0, "Deque back on empty Deque", location);
        return _slots[_slot(_count - 1)].value();
    }

    ## Returns the element at `index`, counting from 0 at the front; this is
    ## the indexer read `d[index]`. O(1).
    ##
    ## @param index the position to read
    ## @returns the element at `index`
    ## @panics if `index < count` does not hold ("Deque index read out of
    ##   bounds")
    [](index: ulong, location: __ptr<char> = __caller_location()): T {
        _pep_check_bounds(index < _count, "Deque index read out of bounds", location);
        return _slots[_slot(index)].value();
    }

    ## Replaces the element at `index`; this is the indexer write
    ## `d[index] = value`. Invalidates running iterators.
    ##
    ## @param index the position to overwrite
    ## @param value the new element
    ## @returns the element now stored at `index` (that is, `value`)
    ## @panics if `index < count` does not hold ("Deque index write out of
    ##   bounds")
    [](index: ulong, value: T, location: __ptr<char> = __caller_location()): T {
        _pep_check_bounds(index < _count, "Deque index write out of bounds", location);
        _version = _version + 1;
        _slots[_slot(index)] = Optional<T>.Value(value);
        return value;
    }

    ## Removes every element, releasing each one. The deque keeps its
    ## capacity. Invalidates running iterators.
    clear() {
        _version = _version + 1;
        while (_count > 0) {
            _take(_slot(_count - 1));
        }
        _head = 0;
    }

    ## Returns an iterator over the elements from front to back;
    ## `for (var x in d)` drives it.
    ##
    ## @returns an iterator positioned before the front element
    iterate(): DequeIterator<T> {
        return DequeIterator<T>(this);
    }
}

## An `Iterator<T>` over the elements of a `Deque` from front to back;
## returned by `Deque.iterate()` and driven by `for (var x in d)`.
##
## @typeParam T the element type of the deque
## @see Deque.iterate
[Value]
export struct DequeIterator<T> {
    ## The deque being iterated.
    Deque<T> _source;
    ## The index of the next element `next()` moves to.
    ulong _next;
    ## The deque's `_version` when iteration began.
    ulong _version;

    ## Creates an iterator positioned before the front element of `source`.
    ##
    ## @param source the deque to iterate
    construct(source: Deque<T>) {
        _source = source;
        _version = source._version;
    }

    ## Advances to the next element.
    ##
    ## @returns true when there is a current element, false once past the
    ##   back
    ## @panics if the deque changed since the iterator was created ("Deque
    ##   modified during iteration")
    next(): bool {
        assert(_source._version == _version, "Deque modified during iteration");
        if (_next > _source._count) {
            return false;
        }
        _next = _next + 1;
        return _next <= _source._count;
    }

    ## Returns the element the last successful `next()` moved to.
    ##
    ## @returns the current element
    ## @panics if the deque changed since the iterator was created ("Deque
    ##   modified during iteration")
    ## @panics if `next()` was never called or already returned false
    ##   ("DequeIterator.current() without an element")
    current(): T {
        assert(_source._version == _version, "Deque modified during iteration");
        assert(_next > 0 and _next <= _source._count, "DequeIterator.current() without an element");
        return _source[_next - 1];
    }
}

extend DequeIterator<T> with Iterator<T>;
expect
2791
## Checks for tests: `expect_equal`, `expect_not_equal`, `expect_true` and
## `expect_false`, which every program can call without an import. Each
## panics when its check fails, as `assert` does, but reports the values it
## compared, at the line of the call:
##
##     math_test.pep:12:5: panic: expect_equal failed
##       actual:   3
##       expected: 4
##
## A `[Test]` function fails on that panic (see the testing chapter).

## Panics unless `actual == expected`, reporting both values.
##
## @typeParam T the type of the values; it needs `==` and a text form
##   (see `to_string`)
## @param actual the value the code under test produced
## @param expected the value it should have produced
## @panics if the values differ: prints the location of the call and both
##   values, and aborts (see `panic`)
## @example
##     var numbers = Array<int>();
##     numbers.append(1);
##     expect_equal(numbers.count, 1);
export expect_equal<T>(actual: T, expected: T, location: __ptr<char> = __caller_location()) {
    if (!(actual == expected)) {
        panic($"expect_equal failed\n  actual:   {actual}\n  expected: {expected}", location);
    }
}

## Panics if `actual == unexpected`, reporting the value.
##
## @typeParam T the type of the values; it needs `==` and a text form
##   (see `to_string`)
## @param actual the value the code under test produced
## @param unexpected the value it must not be
## @panics if the values are equal: prints the location of the call and the
##   value, and aborts (see `panic`)
## @example
##     expect_not_equal("a".repeat(2), "a");
export expect_not_equal<T>(actual: T, unexpected: T, location: __ptr<char> = __caller_location()) {
    if (actual == unexpected) {
        panic($"expect_not_equal failed\n  both: {actual}", location);
    }
}

## Panics unless `condition` holds. Unlike `assert`, it needs no message:
## the location names the check.
##
## @param condition the condition that must hold
## @panics if `condition` is false: prints the location of the call, and
##   aborts (see `panic`)
## @example
##     expect_true("pepper".starts_with("pep"));
export expect_true(condition: bool, location: __ptr<char> = __caller_location()) {
    if (!condition) {
        panic("expect_true failed: the condition is false", location);
    }
}

## Panics if `condition` holds.
##
## @param condition the condition that must not hold
## @panics if `condition` is true: prints the location of the call, and
##   aborts (see `panic`)
## @example
##     expect_false("pepper".is_empty);
export expect_false(condition: bool, location: __ptr<char> = __caller_location()) {
    if (condition) {
        panic("expect_false failed: the condition is true", location);
    }
}
float_parse
8236
# Corrects a decimal-to-double conversion to the nearest double, ties to
# even. The Windows C runtime's `strtod` is off by one unit in the last
# place for some inputs (`3.089261223363795e+16`, subnormals such as
# `2.205052981414646e-308`), so `double.parse` there checks its result:
# it compares the exact decimal value with the midpoints between the
# approximation and its neighbors, in big integers, and steps to the
# neighbor the decimal is closer to.

import "array";

# A non-negative big integer: 32-bit limbs, least significant first.
_float_big_from(value: ulong): ulong[] {
    var limbs = Array<ulong>();
    limbs.append(value & 0xffffffff);
    limbs.append(value >> 32);
    return limbs;
}

# Multiplies `limbs` by `factor`, which is below 2^32.
_float_big_multiply(limbs: ulong[], factor: ulong) {
    ulong carry = 0;
    ulong index = 0;
    var count = limbs.count;
    while (index < count) {
        var product = limbs[index] * factor + carry;
        limbs[index] = product & 0xffffffff;
        carry = product >> 32;
        index = index + 1;
    }
    if (carry != 0) {
        limbs.append(carry);
    }
}

# Adds `value`, which is below 2^32, to `limbs`.
_float_big_add(limbs: ulong[], value: ulong) {
    ulong carry = value;
    ulong index = 0;
    while (carry != 0 && index < limbs.count) {
        var sum = limbs[index] + carry;
        limbs[index] = sum & 0xffffffff;
        carry = sum >> 32;
        index = index + 1;
    }
    if (carry != 0) {
        limbs.append(carry);
    }
}

# Multiplies `limbs` by 10^`power`.
_float_big_multiply_pow10(limbs: ulong[], power: long) {
    while (power >= 9) {
        _float_big_multiply(limbs, 1000000000);
        power = power - 9;
    }
    while (power > 0) {
        _float_big_multiply(limbs, 10);
        power = power - 1;
    }
}

# Multiplies `limbs` by 2^`power`.
_float_big_shift(limbs: ulong[], power: long) {
    while (power >= 31) {
        _float_big_multiply(limbs, 0x80000000);
        power = power - 31;
    }
    if (power > 0) {
        _float_big_multiply(limbs, (1 as ulong) << power as ulong);
    }
}

# -1, 0 or 1 as `a` is less than, equal to or greater than `b`.
_float_big_compare(a: ulong[], b: ulong[]): int {
    var a_count = a.count;
    while (a_count > 0 && a[a_count - 1] == 0) {
        a_count = a_count - 1;
    }
    var b_count = b.count;
    while (b_count > 0 && b[b_count - 1] == 0) {
        b_count = b_count - 1;
    }
    if (a_count != b_count) {
        if (a_count < b_count) {
            return -1;
        }
        return 1;
    }
    var index = a_count;
    while (index > 0) {
        index = index - 1;
        if (a[index] != b[index]) {
            if (a[index] < b[index]) {
                return -1;
            }
            return 1;
        }
    }
    return 0;
}

# Compares `digits` * 10^`power10` with the midpoint between the finite,
# non-negative double whose bits are `bits` and the next double up.
_float_compare_midpoint(digits: ulong[], power10: long, bits: ulong): int {
    var field = (bits >> 52) as long;
    var mantissa = bits & 0xfffffffffffff;
    long exponent = -1074;
    if (field != 0) {
        mantissa = mantissa | ((1 as ulong) << 52);
        exponent = field - 1075;
    }
    # The midpoint is (2 * mantissa + 1) * 2^(exponent - 1).
    var power2 = exponent - 1;
    var left = _float_big_from(0);
    ulong index = 0;
    while (index < digits.count) {
        _float_big_multiply(left, 10);
        _float_big_add(left, digits[index]);
        index = index + 1;
    }
    var right = _float_big_from(2 * mantissa + 1);
    if (power10 >= 0) {
        _float_big_multiply_pow10(left, power10);
    } else {
        _float_big_multiply_pow10(right, 0 - power10);
    }
    if (power2 >= 0) {
        _float_big_shift(right, power2);
    } else {
        _float_big_shift(left, 0 - power2);
    }
    return _float_big_compare(left, right);
}

# The nearest double to `text`, which `_is_decimal` accepted, given
# `approximation`, a conversion that is at most a few units in the last
# place off.
export _float_correct(text: String, approximation: double): double {
    # The significant digits, without leading or trailing zeros, and the
    # power of 10 that scales them.
    var digits = Array<ulong>();
    long power10 = 0;
    var negative = false;
    var seen_point = false;
    var seen_digit = false;
    ulong index = 0;
    var size = text.size;
    ulong zeros = 0;
    while (index < size) {
        var c = text.byte_at(index);
        if (c == '-') {
            negative = true;
        } else if (c == '.') {
            seen_point = true;
        } else if (c == 'e' || c == 'E') {
            break;
        } else if (c >= '0' && c <= '9') {
            if (seen_point) {
                power10 = power10 - 1;
            }
            if (c == '0') {
                if (seen_digit) {
                    zeros = zeros + 1;
                }
            } else {
                while (zeros > 0) {
                    digits.append(0);
                    zeros = zeros - 1;
                }
                digits.append((c - '0') as ulong);
                seen_digit = true;
            }
        }
        index = index + 1;
    }
    power10 = power10 + zeros as long;
    if (index < size) {
        index = index + 1;
        var exponent_negative = false;
        if (text.byte_at(index) == '-' || text.byte_at(index) == '+') {
            exponent_negative = text.byte_at(index) == '-';
            index = index + 1;
        }
        long exponent = 0;
        while (index < size) {
            if (exponent < 100000) {
                exponent = exponent * 10 + (text.byte_at(index) - '0') as long;
            }
            index = index + 1;
        }
        if (exponent_negative) {
            exponent = 0 - exponent;
        }
        power10 = power10 + exponent;
    }
    var count = digits.count as long;
    # Zero, and values far outside the double range, convert exactly.
    if (count == 0 || count + power10 > 310 || count + power10 < -330) {
        return approximation;
    }
    # Up to 15 digits and a power of 10 up to 10^22 are both exact doubles,
    # so one correctly rounded multiply or divide gives the answer (Clinger's
    # fast path). The Windows C runtime misses even some of these
    # (`1.25865078068979e+17`), so compute it here.
    if (count <= 15 && power10 >= -22 && power10 <= 22) {
        ulong whole = 0;
        for (var digit in digits) {
            whole = whole * 10 + digit;
        }
        var scale = 1.0;
        var steps = power10;
        if (steps < 0) {
            steps = 0 - steps;
        }
        while (steps > 0) {
            scale = scale * 10.0;
            steps = steps - 1;
        }
        var value = whole as double;
        if (power10 < 0) {
            value = value / scale;
        } else {
            value = value * scale;
        }
        if (negative) {
            return -value;
        }
        return value;
    }
    var bits = unsafe_cast<ulong>(approximation) & 0x7fffffffffffffff;
    if (bits > 0x7ff0000000000000) {
        return approximation;
    }
    if (bits == 0x7ff0000000000000) {
        bits = bits - 1;
    }
    # Step up while the value is past the midpoint above, then down while
    # it is below the midpoint below; a tie goes to the even mantissa.
    while (bits < 0x7ff0000000000000) {
        var order = _float_compare_midpoint(digits, power10, bits);
        if (order < 0 || (order == 0 && (bits & 1) == 0)) {
            break;
        }
        bits = bits + 1;
    }
    while (bits > 0 && bits < 0x7ff0000000000000) {
        var order = _float_compare_midpoint(digits, power10, bits - 1);
        if (order > 0 || (order == 0 && (bits & 1) == 0)) {
            break;
        }
        bits = bits - 1;
    }
    if (negative) {
        bits = bits | 0x8000000000000000;
    }
    return unsafe_cast<double>(bits);
}
float_text
20304
# Formats a double or a float as the shortest decimal text that reads back
# as exactly that value, with Ulf Adams' Ryu algorithm ("Ryu: fast
# float-to-string conversion", PLDI 2018). This is a port of the reference
# implementation's d2s.c with its small tables (d2s_small_table.h), from
# github.com/ulfjack/ryu (Apache 2.0 or Boost 1.0). A float runs through
# the same steps with its own mantissa width and bias: the 125-bit powers of
# 5 are more than precise enough for its 24-bit significand.
#
# The algorithm finds the shortest digits inside the interval of reals that
# round to the value, and of those the closest to it, with 128-bit
# fixed-point powers of 5; `_float_text` lays the digits out as Swift does.

import "internals";

extern void* malloc(ulong size);

# Ryu's tables, one block: 5^0 to 5^25 (`_FLOAT_POW5`), every 26th power of
# 5 as 128 bits (`_FLOAT_POW5_SPLIT`, low word first), the error corrections
# for the powers between them (`_FLOAT_POW5_OFFSETS`, 2 bits each), and the
# same for the inverse powers (`_FLOAT_POW5_INV_SPLIT`,
# `_FLOAT_POW5_INV_OFFSETS`). Plain `malloc`, not `_pep_malloc`: module
# constants may initialize before the allocation counter, and the block
# lives as long as the program.
const _float_tables: __ptr<ulong> = _float_make_tables();

const _FLOAT_POW5: ulong = 0;
const _FLOAT_POW5_SPLIT: ulong = 26;
const _FLOAT_POW5_OFFSETS: ulong = 52;
const _FLOAT_POW5_INV_SPLIT: ulong = 73;
const _FLOAT_POW5_INV_OFFSETS: ulong = 103;
const _FLOAT_TABLE_SIZE: ulong = 125;
const _FLOAT_POW5_BITS: long = 125;

# Stores four words at `index`. The table is written word by word, not
# from an array literal: it is built while module constants initialize,
# before the runtime's allocation counter is ready.
_float_store(tables: __ptr<ulong>, index: ulong, a: ulong, b: ulong, c: ulong, d: ulong) {
    tables[index] = a;
    tables[index + 1] = b;
    tables[index + 2] = c;
    tables[index + 3] = d;
}

_float_make_tables(): __ptr<ulong> {
    # One spare word: the last store writes four.
    __ptr<ulong> tables = malloc((_FLOAT_TABLE_SIZE + 3) * 8);
    # format: off
    _float_store(tables, 0, 0x0000000000000001, 0x0000000000000005, 0x0000000000000019, 0x000000000000007d);
    _float_store(tables, 4, 0x0000000000000271, 0x0000000000000c35, 0x0000000000003d09, 0x000000000001312d);
    _float_store(tables, 8, 0x000000000005f5e1, 0x00000000001dcd65, 0x00000000009502f9, 0x0000000002e90edd);
    _float_store(tables, 12, 0x000000000e8d4a51, 0x0000000048c27395, 0x000000016bcc41e9, 0x000000071afd498d);
    _float_store(tables, 16, 0x0000002386f26fc1, 0x000000b1a2bc2ec5, 0x000003782dace9d9, 0x00001158e460913d);
    _float_store(tables, 20, 0x000056bc75e2d631, 0x0001b1ae4d6e2ef5, 0x000878678326eac9, 0x002a5a058fc295ed);
    _float_store(tables, 24, 0x00d3c21bcecceda1, 0x0422ca8b0a00a425, 0x0000000000000000, 0x1000000000000000);
    _float_store(tables, 28, 0x0000000000000000, 0x14adf4b7320334b9, 0x0e549208b31adb10, 0x1aba4714957d300d);
    _float_store(tables, 32, 0x6dc6ad264d8f0866, 0x1145b7e285bf98f5, 0xeb1dbd923d8596ca, 0x1652efdc6018a1fc);
    _float_store(tables, 36, 0xb4c1b80b22ae923c, 0x1cda62055b2d9d83, 0x5bb28b4e8f7e4c30, 0x12a5568b9f52f416);
    _float_store(tables, 40, 0xf08aed437682d4fb, 0x1819651531f9e78f, 0xb4ee134ad99bf150, 0x1f25c186a6f04c28);
    _float_store(tables, 44, 0x16499ecb70c25f03, 0x1420eb449c8842e6, 0x85a56ead360865b0, 0x1a03fde214caf085);
