## `assert` and `panic`, which every program can call without an import.

# A panic prints its backtrace through the debug module.
import debug;

# ── C ABI externs (identical signatures on MSVC CRT and libc) ───────────────
extern void* malloc(ulong size);
extern void* calloc(ulong count, ulong size);
extern void free(void* p);
extern void* realloc(void* p, ulong size);
extern void memcpy(void* dest, void* src, ulong n);
extern void memset(void* p, int c, ulong n);
extern int memcmp(void* a, void* b, ulong n);
extern char* getenv(char* name);
extern int puts(char* s);
extern void abort();
extern int fflush(void* stream);

## Panics with `message` when `condition` is false; otherwise does nothing.
##
## The check always runs; there is no release mode that removes it. A
## string literal message picks the `__ptr<char>` overload instead, which
## builds no `String`. Any other message is evaluated before the call.
##
## @param condition the condition that must hold
## @param message the text to print on failure; a null `String` prints a
##   generic message
## @panics if `condition` is false: prints the location and `message`, and
##   aborts (see `panic`)
## @example
##     assert(count > 0, "count must be positive");
export assert(condition: bool, message: String, location: __ptr<char> = __caller_location()) {
    if (!condition) {
        panic(message, location);
    }
}

## Checks that `condition` holds; if not, panics with `message`, a
## NUL-terminated C string. A string literal message picks this overload,
## so an assertion that holds builds no `String`.
##
## @param condition the condition that must hold
## @param message the text to print on failure, or `__null` for a generic
##   message
## @panics if `condition` is false: prints the location and `message`, and
##   aborts (see `panic`)
## @example
##     assert(count > 0, "count must be positive");
export assert(condition: bool, message: __ptr<char>, location: __ptr<char> = __caller_location()) {
    if (!condition) {
        _pep_panic(message, location);
    }
}

# The allocation-free form of `assert` that compiler-generated null checks
# (function and trait values, `match` subjects) lower to: `message` is a
# NUL-terminated C string, or `__null`. A build with
# `--no-runtime-checks=null` drops them.
export _pep_assert(condition: bool, message: __ptr<char>, location: __ptr<char> = __caller_location()) {
    if (!condition) {
        _pep_panic(message, location);
    }
}

# The index check of `Array` and `String` indexing: `_pep_assert`, except
# that the compiler drops each call, condition and all, from a build with
# `--no-runtime-checks=bounds`, and that it passes when `location` starts
# with byte 1: the mark of a location passed from a function marked
# `[Unsafe("bounds")]` (`UNCHECKED_BOUNDS_MARK` in the compiler).
export _pep_check_bounds(condition: bool, message: __ptr<char>, location: __ptr<char> = __caller_location()) {
    if (!condition && (location == __null || location[0] != 1)) {
        _pep_panic(message, location);
    }
}

# ── Small block allocator ───────────────────────────────────────────────────
# The small block allocator behind `_pep_malloc`.
#
# A block of up to `_pep_small_limit` bytes comes from a size class instead
# of from C's calloc. The limit is 128 bytes unless the environment variable
# PEPPER_SMALL_BLOCK_LIMIT, read once at start, sets it: 0 turns the
# allocator off, and values above 4096 count as 4096. A block's size is
# rounded up to its class: multiples of 16 up to 128, then four classes per
# power of two (160, 192, 224, 256, 320, ... 4096).
#
# The blocks live in one reserved stretch of address space (`_SMALL_REGION`
# bytes), so `_pep_free` tells a small block from a C one with one range
# check. The region is cut into 64 KiB spans, each holding blocks of one
# class, named in the span's first word; pages are committed a span at a
# time, and spans are never returned to the operating system.
#
# Each span has one owner, a thread's cache (a `[ThreadLocal]` pointer), and
# its own free list. A thread allocates a class's blocks from one
# current span, from its free list and then from its never-used end, so
# blocks handed out one after another lie close together, and a free on the
# owner's thread pushes the block onto its span's list: neither takes a lock
# or an atomic read-modify-write. A block freed on any other thread goes onto
# the span's second list, an atomic stack, which the owner takes over when
# the span's own list runs dry. Per class the cache keeps its current span,
# a stack of spans with free blocks, and a ring of all its full spans. The
# first block another thread frees into a full span also puts the span on
# its owner's stack of spans to look at again (as mimalloc's delayed free
# does), so an owner never searches its full spans. When the current span
# runs dry the owner tries, in order, the blocks other threads freed into
# it, a span from the stack, a full span from the stack of spans to look at
# again, a span an exited thread left, and a new span. Caches are never
# freed, only handed to a new thread, so another thread can always reach a
# span's owner. A thread that `async.Thread.spawn` started gives its spans up when
# its body ends (`_pep_small_thread_exit`): they go to their class's pool,
# for any thread to adopt.
#
# Each cache counts its live blocks for `_pep_live_allocs`; a block freed on
# another thread makes that thread's count go down, so only the sum means
# anything. A cache's count moves to `_SMALL_RETIRED` when its thread exits.
#
# Recycled blocks are zeroed when they are handed out; fresh spans are
# already zero. WebAssembly has no way to reserve address space, so there
# the limit is always 0 and every block comes from calloc.
#
# This runs before the prelude's other globals exist, so it uses raw memory
# and C calls only: no `String`, `Array` or struct.

# Bytes per span.
const _SMALL_SPAN: ulong = 65536;
# Bytes at the start of a span before its first block: its header.
const _SMALL_SPAN_HEADER: ulong = 96;
# Bytes of address space reserved for small blocks (4 GiB). Only spans in
# use are committed; past the end, small requests fall back to calloc.
const _SMALL_REGION: ulong = 4294967296;
# The largest limit, and the default.
const _SMALL_MAX_LIMIT: ulong = 4096;
const _SMALL_DEFAULT_LIMIT: ulong = 128;
# Size classes: 8 multiples of 16, then 4 per power of two up to 4096.
const _SMALL_CLASSES: ulong = 28;
# The bit of a span's remote list that asks the next thread that frees into
# it to put the span on its owner's stack of spans to look at again: set
# while the span is full. Blocks are 16-byte aligned, so it is free.
const _SMALL_NOTIFY: ulong = 1;

# The state block, in ulong words.
# The region's base and size (0 when the allocator is off).
const _SMALL_BASE: ulong = 0;
const _SMALL_SIZE: ulong = 1;
# The next unused span (atomic).
const _SMALL_NEXT_SPAN: ulong = 2;
const _SMALL_LIMIT: ulong = 3;
# The caches of exited threads, for new threads to take (under the lock of
# the list of caches).
const _SMALL_SPARE_CACHES: ulong = 4;
# The lock of the list of caches, and its head.
const _SMALL_CACHES_LOCK: ulong = 5;
const _SMALL_CACHES: ulong = 6;
# The live blocks of the caches of threads that have exited (atomic).
const _SMALL_RETIRED: ulong = 7;
# Each class's block size.
const _SMALL_CLASS_SIZES: ulong = 8;
# A byte table from `(size + 15) >> 4` to the class.
const _SMALL_CLASS_TABLE: ulong = 40;
# Per class, a cache line: the lock and the pool of spans exited threads
# left.
const _SMALL_CENTRAL: ulong = 80;
const _SMALL_CENTRAL_WORDS: ulong = 8;
const _SMALL_STATE_WORDS: ulong = 304;

# A thread's cache, in ulong words: the next cache, the live count, then per
# class its current span, its stack of spans with free blocks, and the head
# and tail of its ring of full spans; on a cache line of its own, the stack
# of full spans other threads have freed into (atomic).
const _SMALL_CACHE_NEXT: ulong = 0;
const _SMALL_CACHE_LIVE: ulong = 1;
const _SMALL_CACHE_LISTS: ulong = 4;
const _SMALL_CACHE_FREED_INTO: ulong = 120;
const _SMALL_CACHE_WORDS: ulong = 128;
const _SMALL_CURRENT: ulong = 0;
const _SMALL_PARTIAL: ulong = 1;
const _SMALL_FULL_HEAD: ulong = 2;
const _SMALL_FULL_TAIL: ulong = 3;

# A span's header, in ulong words. The words its owner uses come first; the
# list other threads free into sits on the next cache line.
const _SMALL_HEADER_CLASS: ulong = 0;
const _SMALL_HEADER_FREE: ulong = 1;
# The never-used end of the span: its next block and its end.
const _SMALL_HEADER_BUMP: ulong = 2;
const _SMALL_HEADER_END: ulong = 3;
# The next span in the list or ring it is on, and the previous one in the
# ring of full spans.
const _SMALL_HEADER_NEXT: ulong = 4;
const _SMALL_HEADER_PREVIOUS: ulong = 5;
const _SMALL_HEADER_STATE: ulong = 6;
# The owner's cache, or 0 while the span is in its class's pool (atomic).
const _SMALL_HEADER_OWNER: ulong = 7;
# The blocks other threads freed (an atomic stack, with `_SMALL_NOTIFY`).
const _SMALL_HEADER_REMOTE: ulong = 8;
# The next span on its owner's stack of spans to look at again, and whether
# the span is on it (atomic), so it is never there twice.
const _SMALL_HEADER_FREED_INTO: ulong = 9;
const _SMALL_HEADER_QUEUED: ulong = 10;

# A span's state: its owner's current span, on its stack of spans with free
# blocks, on its ring of full spans, or in its class's pool.
const _SMALL_STATE_CURRENT: ulong = 0;
const _SMALL_STATE_PARTIAL: ulong = 1;
const _SMALL_STATE_FULL: ulong = 2;
const _SMALL_STATE_POOLED: ulong = 3;

[Target(!OS(Windows) && !OS(Wasi))]
extern void* mmap(void* address, ulong length, int protection, int flags, int descriptor, long offset);
[Target(!OS(Windows) && !OS(Wasi))]
extern int mprotect(void* address, ulong length, int protection);
[Target(!OS(Windows) && !OS(Wasi))]
extern int sched_yield();
[Target(OS(Windows))]
extern void* VirtualAlloc(void* address, ulong size, uint allocation_type, uint protect);
[Target(OS(Windows))]
extern int SwitchToThread();

# MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE.
[Target(OS(Linux))]
const _SMALL_MAP_FLAGS = 16418;
# MAP_PRIVATE | MAP_ANON.
[Target(OS(Mac))]
const _SMALL_MAP_FLAGS = 4098;

# Reserves `size` bytes of address space with no access, or returns null.
[Target(!OS(Windows) && !OS(Wasi))]
[Unsafe("overflow")]
_pep_small_reserve(size: ulong): __ptr<u8> {
    var p = mmap(__null, size, 0, _SMALL_MAP_FLAGS, -1, 0);
    # MAP_FAILED is -1.
    if (unsafe_cast<long>(p) == -1) {
        return __null;
    }
    return p;
}

[Target(OS(Windows))]
[Unsafe("overflow")]
_pep_small_reserve(size: ulong): __ptr<u8> {
    # MEM_RESERVE, PAGE_NOACCESS.
    return VirtualAlloc(__null, size, 0x2000, 1);
}

[Target(OS(Wasi))]
[Unsafe("overflow")]
_pep_small_reserve(size: ulong): __ptr<u8> {
    return __null;
}

# Makes a reserved span readable and writable; false if the system refuses.
[Target(!OS(Windows) && !OS(Wasi))]
[Unsafe("overflow")]
_pep_small_commit(span: __ptr<u8>): bool {
    # PROT_READ | PROT_WRITE.
    return mprotect(span, _SMALL_SPAN, 3) == 0;
}

[Target(OS(Windows))]
[Unsafe("overflow")]
_pep_small_commit(span: __ptr<u8>): bool {
    # MEM_COMMIT, PAGE_READWRITE.
    return VirtualAlloc(span, _SMALL_SPAN, 0x1000, 4) != __null;
}

[Target(OS(Wasi))]
[Unsafe("overflow")]
_pep_small_commit(span: __ptr<u8>): bool {
    return false;
}

# Lets another thread run while a lock is contended.
[Target(!OS(Windows) && !OS(Wasi))]
[Unsafe("overflow")]
_pep_small_yield() {
    sched_yield();
}

[Target(OS(Windows))]
[Unsafe("overflow")]
_pep_small_yield() {
    SwitchToThread();
}

[Target(OS(Wasi))]
[Unsafe("overflow")]
_pep_small_yield() {}

# The calling thread's cache, or null if it has none yet. It is a native
# thread-local with no exit hook: a JIT engine's code is gone by the time the
# thread that ran it exits, so a thread Pepper spawned hands its cache back
# itself (`_pep_small_thread_exit`), and any other thread keeps its cache. On
# Windows it is a thread (not fiber) local, so fibers that run on one thread
# share its cache.
[ThreadLocal]
var _pep_small_cache: __ptr<ulong>;

# The limit PEPPER_SMALL_BLOCK_LIMIT sets: a decimal number of bytes, or the
# default when it is unset or not a number. No `String` exists yet, so this
# reads the C string itself.
[Target(!OS(Wasi))]
_pep_small_read_limit(): ulong {
    __ptr<u8> text = getenv("PEPPER_SMALL_BLOCK_LIMIT");
    if (text == __null || text[0] == 0) {
        return _SMALL_DEFAULT_LIMIT;
    }
    ulong limit = 0;
    ulong index = 0;
    while (text[index] != 0) {
        var digit = text[index];
        if (digit < 48 || digit > 57) {
            return _SMALL_DEFAULT_LIMIT;
        }
        if (limit < _SMALL_MAX_LIMIT) {
            limit = limit * 10 + ((digit - 48) as ulong);
        }
        index = index + 1;
    }
    return limit < _SMALL_MAX_LIMIT ? limit : _SMALL_MAX_LIMIT;
}

[Target(OS(Wasi))]
_pep_small_read_limit(): ulong {
    return 0;
}

# The bytes a block of class `index` takes.
_pep_small_class_size(index: ulong): ulong {
    if (index < 8) {
        return (index + 1) * 16;
    }
    # Class 8 + 4 * group + step is 128 << group, plus (step + 1) quarters
    # of that.
    var group = (index - 8) / 4;
    var step = (index - 8) % 4;
    var base: ulong = 128 << group;
    return base + (step + 1) * (base / 4);
}

# Builds the state block: the limit, the class tables and the reserved
# region. When the limit is 0, or the reservation cannot be had, the region's size stays 0 and every block
# comes from calloc.
_pep_small_new_state(): __ptr<ulong> {
    var bytes = _SMALL_STATE_WORDS * 8 + 64;
    __ptr<u8> block = malloc(bytes);
    memset(block, 0, bytes);
    # Start at a cache line boundary, so each class's pool has a line of its
    # own.
    __ptr<ulong> state = block + (64 - unsafe_cast<ulong>(block) % 64) % 64;
    var limit = _pep_small_read_limit();
    if (limit == 0) {
        return state;
    }
    ulong index = 0;
    while (index < _SMALL_CLASSES) {
        var size = _pep_small_class_size(index);
        state[_SMALL_CLASS_SIZES + index] = size;
        index = index + 1;
    }
    # Sizes 0 to 4096 in steps of 16, each mapped to the smallest class that
    # holds it.
    __ptr<u8> table = state + _SMALL_CLASS_TABLE;
    ulong class_index = 0;
    ulong slot = 0;
    while (slot <= _SMALL_MAX_LIMIT / 16) {
        while (state[_SMALL_CLASS_SIZES + class_index] < slot * 16) {
            class_index = class_index + 1;
        }
        table[slot] = class_index as u8;
        slot = slot + 1;
    }
    __ptr<u8> reserved = _pep_small_reserve(_SMALL_REGION + _SMALL_SPAN);
    if (reserved == __null) {
        return state;
    }
    # Spans are aligned, so a block's span is its address rounded down.
    var base = unsafe_cast<ulong>(reserved);
    base = base + (_SMALL_SPAN - base % _SMALL_SPAN) % _SMALL_SPAN;
    state[_SMALL_BASE] = base;
    state[_SMALL_NEXT_SPAN] = base;
    state[_SMALL_SIZE] = _SMALL_REGION;
    state[_SMALL_LIMIT] = limit;
    return state;
}

[Unsafe("overflow")]
_pep_small_lock(lock: __ptr<ulong>) {
    while (!__atomic_cmpxchg<ulong>(lock, 0, 1)) {
        ulong spins = 0;
        while (__atomic_load<ulong>(lock) != 0) {
            spins = spins + 1;
            if (spins % 64 == 0) {
                _pep_small_yield();
            }
        }
    }
}

[Unsafe("overflow")]
_pep_small_unlock(lock: __ptr<ulong>) {
    __atomic_store<ulong>(lock, 0);
}

# Adds `delta` to a count only its own thread changes: a plain load and
# store, atomic only so `_pep_small_live` can read it from another thread.
[Unsafe("overflow")]
_pep_small_count(count: __ptr<ulong>, delta: long) {
    __ptr<long> value = count;
    __atomic_store<long>(value, __atomic_load<long>(value) + delta);
}

# A new, empty cache for the calling thread, on the list of caches: an exited
# thread's, or a new one; null when the C allocator has no room for it.
[Unsafe("overflow")]
_pep_small_new_cache(): __ptr<ulong> {
    _pep_small_lock(_pep_small_state + _SMALL_CACHES_LOCK);
    __ptr<ulong> cache = unsafe_cast<__ptr<ulong>>(_pep_small_state[_SMALL_SPARE_CACHES]);
    if (cache != __null) {
        _pep_small_state[_SMALL_SPARE_CACHES] = cache[_SMALL_CACHE_NEXT];
        # Its stack of spans to look at again may still gain a span, which
        # this thread does not own and passes over.
        memset(cache, 0, _SMALL_CACHE_FREED_INTO * 8);
    } else {
        cache = malloc(_SMALL_CACHE_WORDS * 8);
        if (cache == __null) {
            _pep_small_unlock(_pep_small_state + _SMALL_CACHES_LOCK);
            return __null;
        }
        memset(cache, 0, _SMALL_CACHE_WORDS * 8);
    }
    cache[_SMALL_CACHE_NEXT] = _pep_small_state[_SMALL_CACHES];
    _pep_small_state[_SMALL_CACHES] = unsafe_cast<ulong>(cache);
    _pep_small_unlock(_pep_small_state + _SMALL_CACHES_LOCK);
    _pep_small_cache = cache;
    return cache;
}

# Takes the blocks other threads freed into `header`'s span as its free
# list, which must be empty, and clears its `_SMALL_NOTIFY`; false if there
# are none.
[Unsafe("overflow")]
_pep_small_take_remote(header: __ptr<ulong>): bool {
    __ptr<ulong> remote = header + _SMALL_HEADER_REMOTE;
    while (true) {
        var head = __atomic_load<ulong>(remote);
        if ((head & ~_SMALL_NOTIFY) == 0) {
            return false;
        }
        if (__atomic_cmpxchg<ulong>(remote, head, 0)) {
            header[_SMALL_HEADER_FREE] = head & ~_SMALL_NOTIFY;
            return true;
        }
    }
    return false;
}

# Sets `header`'s span's `_SMALL_NOTIFY`, as it goes on the ring of full
# spans; false when other threads have freed into it meanwhile.
[Unsafe("overflow")]
_pep_small_ask_to_notify(header: __ptr<ulong>): bool {
    __ptr<ulong> remote = header + _SMALL_HEADER_REMOTE;
    while (true) {
        var head = __atomic_load<ulong>(remote);
        if (head == _SMALL_NOTIFY) {
            return true;
        }
        if (head != 0) {
            return false;
        }
        if (__atomic_cmpxchg<ulong>(remote, 0, _SMALL_NOTIFY)) {
            return true;
        }
    }
    return false;
}

# Appends `span` to the ring of full spans in `lists`.
[Unsafe("overflow")]
_pep_small_push_full(lists: __ptr<ulong>, span: ulong) {
    __ptr<ulong> header = unsafe_cast<__ptr<ulong>>(span);
    header[_SMALL_HEADER_STATE] = _SMALL_STATE_FULL;
    header[_SMALL_HEADER_NEXT] = 0;
    var tail = lists[_SMALL_FULL_TAIL];
    header[_SMALL_HEADER_PREVIOUS] = tail;
    if (tail == 0) {
        lists[_SMALL_FULL_HEAD] = span;
    } else {
        unsafe_cast<__ptr<ulong>>(tail)[_SMALL_HEADER_NEXT] = span;
    }
    lists[_SMALL_FULL_TAIL] = span;
}

# Takes `span` off the ring of full spans in `lists`.
[Unsafe("overflow")]
_pep_small_unlink_full(lists: __ptr<ulong>, span: ulong) {
    __ptr<ulong> header = unsafe_cast<__ptr<ulong>>(span);
    var next = header[_SMALL_HEADER_NEXT];
    var previous = header[_SMALL_HEADER_PREVIOUS];
    if (previous == 0) {
        lists[_SMALL_FULL_HEAD] = next;
    } else {
        unsafe_cast<__ptr<ulong>>(previous)[_SMALL_HEADER_NEXT] = next;
    }
    if (next == 0) {
        lists[_SMALL_FULL_TAIL] = previous;
    } else {
        unsafe_cast<__ptr<ulong>>(next)[_SMALL_HEADER_PREVIOUS] = previous;
    }
}

# Makes `span` the current span of `lists`.
[Unsafe("overflow")]
_pep_small_make_current(lists: __ptr<ulong>, span: ulong) {
    __ptr<ulong> header = unsafe_cast<__ptr<ulong>>(span);
    header[_SMALL_HEADER_STATE] = _SMALL_STATE_CURRENT;
    lists[_SMALL_CURRENT] = span;
}

# Takes the stack of full spans other threads have freed into: spans this
# cache still owns and that are still full go back to their stacks of spans
# with free blocks, and those of class `class_index` become `lists`'s
# current span (the first) or join its stack. False if none of that class
# was there.
[Unsafe("overflow")]
_pep_small_freed_into(cache: __ptr<ulong>, lists: __ptr<ulong>, class_index: ulong): bool {
    __ptr<ulong> stack = cache + _SMALL_CACHE_FREED_INTO;
    if (__atomic_load<ulong>(stack) == 0) {
        return false;
    }
    var span = 0 as ulong;
    while (true) {
        span = __atomic_load<ulong>(stack);
        ulong empty = 0;
        if (__atomic_cmpxchg<ulong>(stack, span, empty)) {
            break;
        }
    }
    var found = false;
    while (span != 0) {
        __ptr<ulong> header = unsafe_cast<__ptr<ulong>>(span);
        var next = header[_SMALL_HEADER_FREED_INTO];
        ulong idle = 0;
        __atomic_store<ulong>(header + _SMALL_HEADER_QUEUED, idle);
        if (__atomic_load<ulong>(header + _SMALL_HEADER_OWNER) == unsafe_cast<ulong>(cache)
            && header[_SMALL_HEADER_STATE] == _SMALL_STATE_FULL) {
            var class_of_span = header[_SMALL_HEADER_CLASS];
            __ptr<ulong> span_lists = cache + _SMALL_CACHE_LISTS + class_of_span * 4;
            _pep_small_unlink_full(span_lists, span);
            if (class_of_span == class_index && !found) {
                _pep_small_make_current(lists, span);
                found = true;
            } else {
                header[_SMALL_HEADER_STATE] = _SMALL_STATE_PARTIAL;
                header[_SMALL_HEADER_NEXT] = span_lists[_SMALL_PARTIAL];
                span_lists[_SMALL_PARTIAL] = span;
            }
        }
        span = next;
    }
    return found;
}

# Finds class `class_index` a new current span for `cache` once the current
# one (if any) has no block left: a span with free blocks, a full span other
# threads have freed into, a span an exited thread left, or a new span. The
# current span, set aside, goes on the ring of full spans. False
# when the region is used up or the system will not commit more memory.
[Unsafe("overflow")]
_pep_small_refill(cache: __ptr<ulong>, lists: __ptr<ulong>, class_index: ulong): bool {
    var current = lists[_SMALL_CURRENT];
    if (current != 0) {
        __ptr<ulong> header = unsafe_cast<__ptr<ulong>>(current);
        if (!_pep_small_ask_to_notify(header)) {
            # Blocks came back while it was being set aside.
            return _pep_small_take_remote(header);
        }
        lists[_SMALL_CURRENT] = 0;
        _pep_small_push_full(lists, current);
    }
    var partial = lists[_SMALL_PARTIAL];
    if (partial != 0) {
        lists[_SMALL_PARTIAL] = unsafe_cast<__ptr<ulong>>(partial)[_SMALL_HEADER_NEXT];
        _pep_small_make_current(lists, partial);
        return true;
    }
    if (_pep_small_freed_into(cache, lists, class_index)) {
        return true;
    }
    __ptr<ulong> central = _pep_small_state + _SMALL_CENTRAL + class_index * _SMALL_CENTRAL_WORDS;
    _pep_small_lock(central);
    var pooled = central[1];
    if (pooled != 0) {
        __ptr<ulong> header = unsafe_cast<__ptr<ulong>>(pooled);
        central[1] = header[_SMALL_HEADER_NEXT];
        _pep_small_unlock(central);
        __atomic_store<ulong>(header + _SMALL_HEADER_OWNER, unsafe_cast<ulong>(cache));
        _pep_small_make_current(lists, pooled);
        return true;
    }
    _pep_small_unlock(central);
    var span = __atomic_fetch_add<ulong>(_pep_small_state + _SMALL_NEXT_SPAN, _SMALL_SPAN);
    if (span + _SMALL_SPAN > _pep_small_end || !_pep_small_commit(unsafe_cast<__ptr<u8>>(span))) {
        return false;
    }
    __ptr<ulong> header = unsafe_cast<__ptr<ulong>>(span);
    var size = _pep_small_state[_SMALL_CLASS_SIZES + class_index];
    var count = (_SMALL_SPAN - _SMALL_SPAN_HEADER) / size;
    header[_SMALL_HEADER_CLASS] = class_index;
    header[_SMALL_HEADER_BUMP] = span + _SMALL_SPAN_HEADER;
    header[_SMALL_HEADER_END] = span + _SMALL_SPAN_HEADER + count * size;
    __atomic_store<ulong>(header + _SMALL_HEADER_OWNER, unsafe_cast<ulong>(cache));
    _pep_small_make_current(lists, span);
    return true;
}

# A block of at least `size` bytes, 1 to the limit, or null when no span is
# left (the caller then uses calloc). Its first `size` bytes are zero when
# `zero` is true. The fast path pops the current span's free list or bumps
# into its untouched tail; the rest is out of line.
[Unsafe("overflow")]
_pep_small_alloc(size: ulong, zero: bool): __ptr<void> {
    var cache = _pep_small_cache;
    if (cache != __null) {
        __ptr<u8> table = _pep_small_state + _SMALL_CLASS_TABLE;
        var class_index = table[(size + 15) >> 4] as ulong;
        __ptr<ulong> lists = cache + _SMALL_CACHE_LISTS + class_index * 4;
        var span = lists[_SMALL_CURRENT];
        if (span != 0) {
            __ptr<ulong> header = unsafe_cast<__ptr<ulong>>(span);
            var head = header[_SMALL_HEADER_FREE];
            if (head != 0) {
                __ptr<ulong> block = unsafe_cast<__ptr<ulong>>(head);
                header[_SMALL_HEADER_FREE] = block[0];
                _pep_small_count(cache + _SMALL_CACHE_LIVE, 1);
                if (zero) {
                    memset(block, 0, size);
                }
                return block;
            }
            var fresh = header[_SMALL_HEADER_BUMP];
            if (fresh != header[_SMALL_HEADER_END]) {
                # Never used, so still zero.
                header[_SMALL_HEADER_BUMP] = fresh + _pep_small_state[_SMALL_CLASS_SIZES + class_index];
                _pep_small_count(cache + _SMALL_CACHE_LIVE, 1);
                return unsafe_cast<__ptr<void>>(fresh);
            }
        }
    }
    return _pep_small_alloc_slow(size, zero);
}

# `_pep_small_alloc` when the current span has nothing at hand: makes the
# cache, takes the blocks other threads freed or moves to another span, then
# tries again.
[Cold]
[Unsafe("overflow")]
_pep_small_alloc_slow(size: ulong, zero: bool): __ptr<void> {
    var cache = _pep_small_cache;
    if (cache == __null) {
        cache = _pep_small_new_cache();
        if (cache == __null) {
            return __null;
        }
        return _pep_small_alloc(size, zero);
    }
    __ptr<u8> table = _pep_small_state + _SMALL_CLASS_TABLE;
    var class_index = table[(size + 15) >> 4] as ulong;
    __ptr<ulong> lists = cache + _SMALL_CACHE_LISTS + class_index * 4;
    var span = lists[_SMALL_CURRENT];
    if (span != 0 && _pep_small_take_remote(unsafe_cast<__ptr<ulong>>(span))) {
        return _pep_small_alloc(size, zero);
    }
    if (!_pep_small_refill(cache, lists, class_index)) {
        return __null;
    }
    return _pep_small_alloc(size, zero);
}

# Whether `p` is a small block.
[Unsafe("overflow")]
_pep_small_owns(p: __ptr<void>): bool {
    var address = unsafe_cast<ulong>(p);
    return address >= _pep_small_base && address < _pep_small_end;
}

# The class of small block `p`, from its span's first word.
[Unsafe("overflow")]
_pep_small_class(p: __ptr<void>): ulong {
    var address = unsafe_cast<ulong>(p);
    __ptr<ulong> header = unsafe_cast<__ptr<ulong>>(address - address % _SMALL_SPAN);
    return header[0];
}

# The bytes small block `p` can hold.
[Unsafe("overflow")]
_pep_small_capacity(p: __ptr<void>): ulong {
    return _pep_small_state[_SMALL_CLASS_SIZES + _pep_small_class(p)];
}

# Returns small block `p` to its span: onto the span's own list on the
# owner's thread, else onto the list other threads free into.
[Unsafe("overflow")]
_pep_small_free(p: __ptr<void>) {
    var address = unsafe_cast<ulong>(p);
    __ptr<ulong> header = unsafe_cast<__ptr<ulong>>(address - address % _SMALL_SPAN);
    var cache = _pep_small_cache;
    if (cache != __null
        && __atomic_load<ulong>(header + _SMALL_HEADER_OWNER) == unsafe_cast<ulong>(cache)
        && header[_SMALL_HEADER_STATE] != _SMALL_STATE_FULL) {
        __ptr<ulong> block = p;
        block[0] = header[_SMALL_HEADER_FREE];
        header[_SMALL_HEADER_FREE] = address;
        _pep_small_count(cache + _SMALL_CACHE_LIVE, -1);
        return;
    }
    _pep_small_free_slow(p);
}

# `_pep_small_free` for a full span of the calling thread's, which goes back
# among its partial spans, or a span another thread owns or none does.
[Cold]
[Unsafe("overflow")]
_pep_small_free_slow(p: __ptr<void>) {
    var address = unsafe_cast<ulong>(p);
    var span = address - address % _SMALL_SPAN;
    __ptr<ulong> header = unsafe_cast<__ptr<ulong>>(span);
    __ptr<ulong> block = p;
    var cache = _pep_small_cache;
    if (cache != __null && __atomic_load<ulong>(header + _SMALL_HEADER_OWNER) == unsafe_cast<ulong>(cache)) {
        block[0] = header[_SMALL_HEADER_FREE];
        header[_SMALL_HEADER_FREE] = address;
        _pep_small_count(cache + _SMALL_CACHE_LIVE, -1);
        # It has room again.
        __ptr<ulong> lists = cache + _SMALL_CACHE_LISTS + header[_SMALL_HEADER_CLASS] * 4;
        _pep_small_unlink_full(lists, span);
        header[_SMALL_HEADER_STATE] = _SMALL_STATE_PARTIAL;
        header[_SMALL_HEADER_NEXT] = lists[_SMALL_PARTIAL];
        lists[_SMALL_PARTIAL] = span;
        return;
    }
    __ptr<ulong> remote = header + _SMALL_HEADER_REMOTE;
    while (true) {
        var head = __atomic_load<ulong>(remote);
        block[0] = head & ~_SMALL_NOTIFY;
        if (!__atomic_cmpxchg<ulong>(remote, head, address)) {
            continue;
        }
        if ((head & _SMALL_NOTIFY) != 0) {
            # The span was full: tell its owner, if it has one.
            __ptr<ulong> owner = unsafe_cast<__ptr<ulong>>(__atomic_load<ulong>(header + _SMALL_HEADER_OWNER));
            ulong idle = 0;
            ulong queued = 1;
            if (owner != __null && __atomic_cmpxchg<ulong>(header + _SMALL_HEADER_QUEUED, idle, queued)) {
                __ptr<ulong> stack = owner + _SMALL_CACHE_FREED_INTO;
                while (true) {
                    var top = __atomic_load<ulong>(stack);
                    header[_SMALL_HEADER_FREED_INTO] = top;
                    if (__atomic_cmpxchg<ulong>(stack, top, span)) {
                        break;
                    }
                }
            }
        }
        break;
    }
    if (cache == __null) {
        # A thread whose cache is gone (its exit has begun) or never made.
        __atomic_fetch_sub<long>(unsafe_cast<__ptr<long>>(_pep_small_state + _SMALL_RETIRED), 1);
    } else {
        _pep_small_count(cache + _SMALL_CACHE_LIVE, -1);
    }
}

# Puts `span` in its class's pool, ownerless.
[Unsafe("overflow")]
_pep_small_pool(span: ulong) {
    __ptr<ulong> header = unsafe_cast<__ptr<ulong>>(span);
    __ptr<ulong> central = _pep_small_state + _SMALL_CENTRAL + header[_SMALL_HEADER_CLASS] * _SMALL_CENTRAL_WORDS;
    header[_SMALL_HEADER_STATE] = _SMALL_STATE_POOLED;
    __atomic_store<ulong>(header + _SMALL_HEADER_OWNER, 0);
    _pep_small_lock(central);
    header[_SMALL_HEADER_NEXT] = central[1];
    central[1] = span;
    _pep_small_unlock(central);
}

# Hands the calling thread's cache back, as its last act (a thread that
# `async.Thread.spawn` started calls it): puts each of its spans in its
# class's pool, folds its live count into the retired count, and keeps the
# cache for the next new thread.
# A block the thread frees after this goes onto its span's list for other
# threads.
[Unsafe("overflow")]
export _pep_small_thread_exit() {
    if (_pep_small_end == 0) {
        return;
    }
    __ptr<ulong> cache = _pep_small_cache;
    if (cache == __null) {
        return;
    }
    _pep_small_cache = __null;
    ulong class_index = 0;
    while (class_index < _SMALL_CLASSES) {
        __ptr<ulong> lists = cache + _SMALL_CACHE_LISTS + class_index * 4;
        if (lists[_SMALL_CURRENT] != 0) {
            _pep_small_pool(lists[_SMALL_CURRENT]);
        }
        var span = lists[_SMALL_PARTIAL];
        while (span != 0) {
            var next = unsafe_cast<__ptr<ulong>>(span)[_SMALL_HEADER_NEXT];
            _pep_small_pool(span);
            span = next;
        }
        span = lists[_SMALL_FULL_HEAD];
        while (span != 0) {
            var next = unsafe_cast<__ptr<ulong>>(span)[_SMALL_HEADER_NEXT];
            _pep_small_pool(span);
            span = next;
        }
        class_index = class_index + 1;
    }
    _pep_small_lock(_pep_small_state + _SMALL_CACHES_LOCK);
    __ptr<ulong> link = _pep_small_state + _SMALL_CACHES;
    while (link[0] != unsafe_cast<ulong>(cache)) {
        link = unsafe_cast<__ptr<ulong>>(link[0]) + _SMALL_CACHE_NEXT;
    }
    link[0] = cache[_SMALL_CACHE_NEXT];
    __ptr<long> live = cache + _SMALL_CACHE_LIVE;
    __atomic_fetch_add<long>(unsafe_cast<__ptr<long>>(_pep_small_state + _SMALL_RETIRED), live[0]);
    cache[_SMALL_CACHE_NEXT] = _pep_small_state[_SMALL_SPARE_CACHES];
    _pep_small_state[_SMALL_SPARE_CACHES] = unsafe_cast<ulong>(cache);
    _pep_small_unlock(_pep_small_state + _SMALL_CACHES_LOCK);
}

# Whether `p` came from the small block allocator, and the limit in force:
# for the runtime's own tests.
export _pep_is_small_block(p: __ptr<void>): bool {
    return _pep_small_owns(p);
}

export _pep_small_block_limit(): ulong {
    return _pep_small_limit;
}

# The small blocks live now: every cache's count plus the retired count.
[Unsafe("overflow")]
_pep_small_live(): long {
    _pep_small_lock(_pep_small_state + _SMALL_CACHES_LOCK);
    var total = __atomic_load<long>(unsafe_cast<__ptr<long>>(_pep_small_state + _SMALL_RETIRED));
    var cache = _pep_small_state[_SMALL_CACHES];
    while (cache != 0) {
        __ptr<long> words = unsafe_cast<__ptr<long>>(cache);
        total = total + __atomic_load<long>(words + _SMALL_CACHE_LIVE);
        cache = unsafe_cast<ulong>(words[_SMALL_CACHE_NEXT]);
    }
    _pep_small_unlock(_pep_small_state + _SMALL_CACHES_LOCK);
    return total;
}

# ── Live-allocation counter (leak tests) and trace gate ─────────────────────
# The live-allocation count, updated atomically because threads allocate
# concurrently. It is split into `_PEP_ALLOC_SHARDS` counters, each on its
# own 64-byte cache line, and a thread steps the one its thread id picks
# (`_pep_live_allocs_shard`). With a single counter, every allocation on
# every thread fought over one cache line: removing that cut the user CPU
# of the 4-worker echo benchmark by 18%. A block freed on another thread
# steps that thread's shard, so one shard can go negative; only the sum
# means anything. The shards live in a raw malloc'd block: an Atomic<long>
# would allocate through _pep_malloc itself. The prelude's globals are
# initialized before any other file's, and this is the first of them, so
# the block exists before anything allocates. Every JIT engine carries its
# own copy of this global, so tests that count allocations can run in
# parallel.
# Prime, so that thread ids a fixed stride apart spread over every shard.
const _PEP_ALLOC_SHARDS: ulong = 61;
# Longs per shard: one 64-byte cache line.
const _PEP_ALLOC_SHARD_STRIDE: ulong = 8;

[Target(!OS(Windows))]
extern ulong pthread_self();
[Target(OS(Windows))]
extern uint GetCurrentThreadId();

_pep_new_live_allocs_slot(): __ptr<long> {
    var size = _PEP_ALLOC_SHARDS * _PEP_ALLOC_SHARD_STRIDE * 8;
    __ptr<u8> block = malloc(size + 64);
    memset(block, 0, size + 64);
    # Start at a cache line boundary.
    __ptr<long> shards = block + (64 - unsafe_cast<ulong>(block) % 64) % 64;
    return shards;
}

const _pep_live_allocs_slot: __ptr<long> = _pep_new_live_allocs_slot();

# The calling thread's counter. glibc and macOS place each thread's
# pthread_t in its own stack mapping, so the page number tells threads
# apart (consecutive threads' stacks lie one stack size apart); Windows
# thread ids are multiples of 4.
[Target(!OS(Windows))]
_pep_live_allocs_shard(): __ptr<long> {
    var index = (pthread_self() >> 12) % _PEP_ALLOC_SHARDS;
    return _pep_live_allocs_slot + index * _PEP_ALLOC_SHARD_STRIDE;
}

[Target(OS(Windows))]
_pep_live_allocs_shard(): __ptr<long> {
    var index = ((GetCurrentThreadId() as ulong) >> 2) % _PEP_ALLOC_SHARDS;
    return _pep_live_allocs_slot + index * _PEP_ALLOC_SHARD_STRIDE;
}

# The small block allocator's state, and copies of the words every
# allocation and free reads (see the small block allocator above). Like the counter, it
# must exist before anything allocates.
const _pep_small_state: __ptr<ulong> = _pep_small_new_state();
const _pep_small_base: ulong = _pep_small_state[_SMALL_BASE];
const _pep_small_end: ulong = _pep_small_base + _pep_small_state[_SMALL_SIZE];
const _pep_small_limit: ulong = _pep_small_state[_SMALL_LIMIT];

# `PEP_CHECK_SYNC`, a debug switch read once at start: when it is set, a
# Mutex checks at each unlock that nothing outside the locked value refers
# into it (`_pep_check_sync` in copy.pep). It lives here because module
# constants initialize file by file, and this file's allocation counter must
# exist before any String is built.
_pep_check_sync_enabled(): bool {
    var name = "PEP_CHECK_SYNC";
    return getenv(name.c_str()) != __null;
}

export const _PEP_CHECK_SYNC_ON = _pep_check_sync_enabled();

[Unsafe("overflow")]
export _pep_malloc(size: ulong): __ptr<void> {
    # A small block, unless the limit is 0. A 0-byte request goes to calloc.
    if (size <= _pep_small_limit && size != 0) {
        var block = _pep_small_alloc(size, true);
        if (block != __null) {
            return block;
        }
    }
    # Zero the payload: refcount machinery reads old slot values from fresh
    # buffers (index_refcount_ops), so uninitialized bytes are wild pointers.
    # calloc skips the clearing for fresh pages the OS already zeroed.
    var p = calloc(1, size);
    __atomic_fetch_add<long>(_pep_live_allocs_shard(), 1);
    return p;
}

# `_pep_malloc` without the zeroing: the block's bytes are whatever they
# were. Codegen calls it for an allocation of a constant size and zeroes the
# block itself with an inline `memset`, which LLVM shortens or deletes where
# the stores after it overwrite it.
[Unsafe("overflow")]
export _pep_malloc_uninit(size: ulong): __ptr<void> {
    if (size <= _pep_small_limit && size != 0) {
        var block = _pep_small_alloc(size, false);
        if (block != __null) {
            return block;
        }
    }
    var p = malloc(size);
    __atomic_fetch_add<long>(_pep_live_allocs_shard(), 1);
    return p;
}

[Unsafe("overflow")]
export _pep_free(p: __ptr<void>) {
    if (_pep_small_owns(p)) {
        _pep_small_free(p);
    } else if (p != __null) {
        free(p);
        __atomic_fetch_sub<long>(_pep_live_allocs_shard(), 1);
    }
}

# Destroying an object releases its fields, and a field's last release
# destroys that object in turn, so a long chain (a linked list, a deeply
# nested document) would recurse once per link and overflow the stack
# (#65). A chain of structs that hold each other directly is destroyed in
# a loop by the compiler's chain last release (`codegen/chains.pep`), whose
# list grows with `_pep_release_list_grow`; so is one through a trait
# value, an `Array`'s elements or a closure's captures. A cycle of types
# that also runs through anything else (a tuple, another container's
# buffer) cannot be steered from the destructor: the last release of such a struct calls
# `_pep_release_last` with the struct's `__last_release`, which runs the
# destructor and frees the memory. The outermost one on a thread sets a
# floor `_RELEASE_STACK` bytes below its frame. Nested ones above the floor run as nested calls;
# one below it is pushed on this thread's pending list, which the outermost
# drains once its own object is destroyed: in the order they were
# released, each one's own pushes before the next. A stack budget rather
# than a depth count keeps the common case to one thread-local read.
const _RELEASE_STACK: ulong = 16384;

# Moves a full chain list's entries (each an object and the function that
# releases it) to a heap buffer of twice the `count` entries, freeing
# `data` unless it is the caller's stack buffer `inline_data`.
[Cold]
[Unsafe("overflow")]
export _pep_release_list_grow(
    data: __ptr<__ptr<void>>, count: ulong, inline_data: __ptr<__ptr<void>>
): __ptr<__ptr<void>> {
    var entry = sizeof<__ptr<void>>() * 2;
    __ptr<__ptr<void>> moved = _pep_malloc_uninit(entry * count * 2);
    memcpy(moved, data, entry * count);
    if (data != inline_data) {
        _pep_free(data);
    }
    return moved;
}

# LLVM intrinsics; see "LLVM intrinsics" in
# docs/src/language/c-interop.md.
[Link(name = "llvm.frameaddress")]
extern void* _release_frame_address(int level);

# The lowest frame address a nested destruction runs at, or 0 when no
# destruction is running on this thread.
[ThreadLocal]
var _release_floor: ulong;

[ThreadLocal]
var _release_objects: __ptr<__ptr<void>>;

[ThreadLocal]
var _release_destroys: __ptr<extern (__ptr<void>) => void>;

[ThreadLocal]
var _release_count: ulong;

[ThreadLocal]
var _release_capacity: ulong;

# Runs `destroy(object)` for an object whose strong count reached 0: at
# once, or later from the pending list when this thread's destructions are
# nested `_RELEASE_STACK` bytes deep.
[Cold]
[Unsafe("overflow, null")]
export _pep_release_last(object: __ptr<void>, destroy: extern (__ptr<void>) => void) {
    var here = unsafe_cast<ulong>(_release_frame_address(0));
    var floor = _release_floor;
    if (floor == 0) {
        _release_floor = here > _RELEASE_STACK ? here - _RELEASE_STACK : 1;
        destroy(object);
        if (_release_count != 0) {
            _release_drain();
        }
        _release_floor = 0;
    } else if (here < floor) {
        _release_push(object, destroy);
    } else {
        destroy(object);
    }
}

# A task that suspends inside a destruction (a destructor that waits)
# takes the thread's floor with it, so the tasks that run meanwhile start
# their own, and it may resume on another thread (`async`'s
# `_async_suspend`). Objects it left pending are drained by the next
# outermost release on this thread.
export _pep_release_suspend(): ulong {
    var floor = _release_floor;
    _release_floor = 0;
    return floor;
}

# Gives a resumed task back the floor `_pep_release_suspend` took.
export _pep_release_resume(floor: ulong) {
    _release_floor = floor;
}

[Cold]
[Unsafe("overflow")]
_release_push(object: __ptr<void>, destroy: extern (__ptr<void>) => void) {
    if (_release_count == _release_capacity) {
        var capacity = _release_capacity == 0 ? 64 : _release_capacity * 2;
        _release_objects = _pep_realloc_uninit(_release_objects, _release_capacity * 8, capacity * 8);
        _release_destroys = _pep_realloc_uninit(_release_destroys, _release_capacity * 8, capacity * 8);
        _release_capacity = capacity;
    }
    _release_objects[_release_count] = object;
    _release_destroys[_release_count] = destroy;
    _release_count = _release_count + 1;
}

# Reverses the pending entries from `start` on: one destruction pushes its
# objects in release order, and the list is drained from its end.
[Unsafe("overflow")]
_release_reverse(start: ulong) {
    var low = start;
    var high = _release_count;
    while (low + 1 < high) {
        high = high - 1;
        var object = _release_objects[low];
        _release_objects[low] = _release_objects[high];
        _release_objects[high] = object;
        var destroy = _release_destroys[low];
        _release_destroys[low] = _release_destroys[high];
        _release_destroys[high] = destroy;
        low = low + 1;
    }
}

# Destroys every pending object, and those their destruction pushes, then
# frees the list: a deep release is rare, and a thread that exits keeps no
# buffer.
[Cold]
[Unsafe("overflow, null")]
_release_drain() {
    _release_reverse(0);
    while (_release_count != 0) {
        _release_count = _release_count - 1;
        var mark = _release_count;
        _release_destroys[mark](_release_objects[mark]);
        _release_reverse(mark);
    }
    _pep_free(_release_objects);
    _pep_free(_release_destroys);
    _release_objects = __null;
    _release_destroys = __null;
    _release_capacity = 0;
}

[Unsafe("overflow")]
export _pep_realloc(p: __ptr<void>, prev_size: ulong, new_size: ulong): __ptr<void> {
    return _pep_resize(p, prev_size, new_size, true);
}

# `_pep_realloc` without zeroing the bytes past `prev_size`, for a buffer
# whose unused capacity is never read and holds no references.
[Unsafe("overflow")]
export _pep_realloc_uninit(p: __ptr<void>, prev_size: ulong, new_size: ulong): __ptr<void> {
    return _pep_resize(p, prev_size, new_size, false);
}

# Moves or extends `p` to `new_size` bytes, keeping its first `prev_size`;
# `zero` clears the bytes past them.
[Unsafe("overflow")]
_pep_resize(p: __ptr<void>, prev_size: ulong, new_size: ulong, zero: bool): __ptr<void> {
    if (_pep_small_owns(p) || (p == __null && new_size <= _pep_small_limit && new_size != 0)) {
        if (p != __null && new_size <= _pep_small_capacity(p)) {
            # It still fits its class.
            if (zero && new_size > prev_size) {
                memset(p + prev_size, 0, new_size - prev_size);
            }
            return p;
        }
        # Move it: to another class, or to calloc past the limit.
        var moved = zero ? _pep_malloc(new_size) : _pep_malloc_uninit(new_size);
        if (p != __null) {
            memcpy(moved, p, prev_size < new_size ? prev_size : new_size);
            _pep_free(p);
        }
        return moved;
    }
    # C realloc preserves contents up to min(prev,new); net-zero on the
    # counter. The extension region is uninitialized: zero it when asked.
    # Never ask for 0 bytes (an Array of a zero-size type): realloc(p, 0)
    # may free `p` and return null, which the counter would not see.
    var np = realloc(p, new_size > 0 ? new_size : 1);
    if (np != __null) {
        # realloc(null, n) is a fresh allocation; the counter must see it.
        if (p == __null) {
            __atomic_fetch_add<long>(_pep_live_allocs_shard(), 1);
        }
        if (zero && new_size > prev_size) {
            memset(np + prev_size, 0, new_size - prev_size);
        }
    }
    return np;
}

export _pep_live_allocs(): long {
    long total = 0;
    ulong index = 0;
    while (index < _PEP_ALLOC_SHARDS) {
        total = total + __atomic_load<long>(_pep_live_allocs_slot + index * _PEP_ALLOC_SHARD_STRIDE);
        index = index + 1;
    }
    return total + _pep_small_live();
}

## Prints `message` and aborts the program. It never returns.
##
## Flushes every C output stream, so output printed so far is not lost,
## then writes `location: panic: message` and a newline to standard error
## ("Assertion failed with no additional information" when `message` is
## null), followed in a build without `-O` by a backtrace of the calls
## that led there (`PEPPER_BACKTRACE` overrides the build; see the `debug`
## module's `print_backtrace`), and calls C `abort()`. No destructors or
## releases run, and the process ends abnormally (SIGABRT on POSIX).
##
## The location is the call's `file:line:col`, which the compiler passes
## in a hidden parameter, the way a C++ `std::source_location` default
## argument works. A function that panics on its caller's behalf, as the
## runtime's indexers do, declares that parameter itself and passes it on,
## so the panic names its caller's line:
##
##     check_positive(value: int, location: __ptr<char> = __caller_location()) {
##         if (value <= 0) {
##             panic("expected a positive value", location);
##         }
##     }
##
## @param message the text to print
## @panics always
## @example
##     panic("unreachable");
export panic(message: String, location: __ptr<char> = __caller_location()) {
    if (message === __null) {
        _pep_panic(__null, location);
    }
    _pep_panic(message.c_str(), location);
}

## Reports `message`, a NUL-terminated C string (a generic message when it
## is `__null`), as a panic and aborts, as `panic(String)` does. A string
## literal message picks this overload, so it allocates nothing.
##
## @param message the text to print, or `__null`
## @panics always
## @example
##     panic("unreachable");
export panic(message: __ptr<char>, location: __ptr<char> = __caller_location()) {
    _pep_panic(message, location);
}

[Target(!OS(Windows))]
extern long write(int fd, void* buf, ulong n);
[Target(OS(Windows))]
extern int _write(int fd, void* buf, uint n);
extern ulong strlen(char* s);

# Write the C string `text` to standard error, unbuffered.
[Target(!OS(Windows))]
export _pep_write_error(text: __ptr<char>) {
    write(2, text, strlen(text));
}

[Target(OS(Windows))]
export _pep_write_error(text: __ptr<char>) {
    _write(2, text, strlen(text) as uint);
}

## The function a panic runs before it prints its message: see
## `set_panic_hook`. It receives the panic's message and its location
## (`file:line:col`, or an empty string when the panic has none).
export type PanicHook = shared (String, String) => void;

# The installed hook, boxed so that its slot holds one counted reference,
# which `__atomic_store` swaps and `__atomic_load` reads atomically, as
# `async.Atomic` does (this file cannot import async).
[Shared]
struct _PanicHookBox {
    const hook: PanicHook;

    construct(hook: PanicHook) {
        this.hook = hook;
    }
}

# The process's panic hook: null until `set_panic_hook`.
const _pep_panic_hook: __ptr<_PanicHookBox> = calloc(1, 8);

# The message and location of the panic whose hook this thread is running
# (the message is null while it runs none), so that a panic inside the
# hook reports both and does not run the hook again.
[ThreadLocal]
var _pep_panic_hook_message: __ptr<char>;
[ThreadLocal]
var _pep_panic_hook_location: __ptr<char>;

## Installs `hook` as the process's panic hook, replacing the one installed
## before (take that one with `take_panic_hook` first to chain them).
##
## Every panic, on any thread, calls the hook on the panicking thread
## before it prints its message and backtrace, then prints and aborts as
## always: the hook cannot stop the panic. A full-screen terminal program
## uses it to leave the alternate screen, so the message lands where the
## user can read it. That covers `panic`, a failed `assert`, an index out
## of range, an overflowing operator and every other check the compiler or
## the runtime adds. A stack overflow skips the hook: the thread has no
## stack left to run it on.
##
## A panic inside the hook does not run the hook again: it prints the
## first panic's message, then its own, and aborts. Two threads that
## panic at once each run the hook, at the same time. Keep the hook
## short, and keep it from taking a lock the panicking code may hold: it
## would wait forever instead of letting the program end.
##
## @param hook runs with the panic's message and location
## @example
##     var previous = take_panic_hook();
##     set_panic_hook((message, location) => {
##         leave_alternate_screen();
##         previous(message, location);
##     });
export set_panic_hook(hook: PanicHook) {
    __atomic_store<_PanicHookBox>(_pep_panic_hook, _PanicHookBox(hook));
}

## Removes the process's panic hook and returns it, so that a panic again
## only prints its message.
##
## @returns the hook `set_panic_hook` installed last, or one that does
##   nothing when there is none
## @example
##     var hook = take_panic_hook();   # panics no longer run it
##     set_panic_hook(hook);           # and now they do again
export take_panic_hook(): PanicHook {
    var current = __atomic_load<_PanicHookBox>(_pep_panic_hook);
    while (!__atomic_cmpxchg<_PanicHookBox>(_pep_panic_hook, current, __default<_PanicHookBox>())) {
        current = __atomic_load<_PanicHookBox>(_pep_panic_hook);
    }
    if (current === __null) {
        return _pep_no_panic_hook;
    }
    return current.hook;
}

# What `take_panic_hook` returns when no hook is installed.
_pep_no_panic_hook(message: String, location: String) {}

# `panic` on NUL-terminated C strings: `message` (`__null` prints a generic
# message) and `location` (`__null` for none). Compiler-generated checks
# lower to this, so a panic never has to allocate (its hook may).
export _pep_panic(message: __ptr<char>, location: __ptr<char>) {
    # stdout is fully buffered when it is a pipe: flush it, or abort() drops
    # what the program printed before the panic. Before the hook, so the
    # output lands where the program meant it to (on a full-screen
    # program's alternate screen, which the hook may leave).
    fflush(__null);
    # Without the mark of an `[Unsafe("bounds")]` caller.
    var shown = location != __null && location[0] == 1 ? location + 1 : location;
    __ptr<char> text = message == __null ? "Assertion failed with no additional information" : message;
    if (_pep_panic_hook_message != __null) {
        _pep_write_panic(_pep_panic_hook_location, _pep_panic_hook_message, "panic: ");
        _pep_write_panic(shown, text, "panic in the panic hook: ");
    } else {
        _pep_run_panic_hook(text, shown);
        # What the hook printed.
        fflush(__null);
        _pep_write_panic(shown, text, "panic: ");
    }
    debug._debug_panic_backtrace();
    abort();
}

# Calls the process's panic hook, if there is one, for this thread's panic.
_pep_run_panic_hook(message: __ptr<char>, location: __ptr<char>) {
    # Null when a module-scope initializer panics before this one ran.
    if (_pep_panic_hook == __null) {
        return;
    }
    var installed = __atomic_load<_PanicHookBox>(_pep_panic_hook);
    if (installed === __null) {
        return;
    }
    _pep_panic_hook_message = message;
    _pep_panic_hook_location = location;
    installed.hook(String(message), location == __null ? String() : String(location));
    _pep_panic_hook_message = __null;
}

# Writes `location: <kind><message>` and a newline to standard error.
_pep_write_panic(location: __ptr<char>, message: __ptr<char>, kind: __ptr<char>) {
    if (location != __null) {
        _pep_write_error(location);
        _pep_write_error(": ");
    }
    _pep_write_error(kind);
    _pep_write_error(message);
    _pep_write_error("\n");
}

# The panic backtrace's state: [0] is 1 when the build asks for a backtrace
# on panic (a build without `-O`: the compiler calls
# `_pep_set_backtrace_default` first thing in `main`), [1] is 1 once a
# panic has started printing one.
const _pep_backtrace_state: __ptr<int> = _pep_new_backtrace_state();

_pep_new_backtrace_state(): __ptr<int> {
    __ptr<int> state = _pep_malloc(8);
    state[0] = 0;
    state[1] = 0;
    return state;
}

# Called by the compiler at the start of `main` in a build without `-O`.
export _pep_set_backtrace_default() {
    if (_pep_backtrace_state == __null) {
        return;
    }
    __atomic_store<int>(_pep_backtrace_state, 1);
}

# Whether the build asks for a backtrace on panic when PEPPER_BACKTRACE is
# not set.
export _pep_backtrace_default(): bool {
    # Null when a module-scope initializer panics before this one ran.
    if (_pep_backtrace_state == __null) {
        return false;
    }
    return __atomic_load<int>(_pep_backtrace_state) == 1;
}

# Claims the one panic backtrace a process prints: false when another
# panic (a second thread, or a panic inside the symbolizer) already has.
export _pep_enter_backtrace(): bool {
    if (_pep_backtrace_state == __null) {
        return false;
    }
    return __atomic_cmpxchg<int>(_pep_backtrace_state + 1, 0, 1);
}

# ── Byte hash: 8 bytes per step, then a final avalanche ──────────────────────
# Each 8-byte word is xored in and multiplied by an odd constant, with the
# high half folded down so later words reach the low bits; the tail's 1-7
# bytes form one more word. The finish is MurmurHash3's fmix64, so every
# input bit reaches the low bits a power-of-two table masks with. Words are
# assembled from single bytes (LLVM merges them into one unaligned load), so
# `data` needs no alignment. An empty or null buffer hashes to the FNV-1a
# offset basis, the seed `hash<T>` also uses.
export _pep_hash_bytes(data: __ptr<void>, length: ulong): u64 {
    if (data == __null || length == 0) { return -3750763034362895579; }
    __ptr<u8> bytes = data as __ptr<u8>;
    ulong h = 0xcbf29ce484222325 ^ length;
    ulong i = 0;
    while (i + 8 <= length) {
        h = _pep_hash_step(h, _pep_hash_word(bytes, i, 8));
        i = i + 8;
    }
    if (i < length) {
        h = _pep_hash_step(h, _pep_hash_word(bytes, i, length - i));
    }
    h = __wrapping_mul(h ^ (h >> 33), 0xff51afd7ed558ccd);
    h = __wrapping_mul(h ^ (h >> 33), 0xc4ceb9fe1a85ec53);
    return h ^ (h >> 33);
}

# The `count` (1-8) bytes at `bytes[start]` as a little-endian word.
_pep_hash_word(bytes: __ptr<u8>, start: ulong, count: ulong): ulong {
    ulong word = 0;
    ulong k = 0;
    while (k < count) {
        word = word | ((bytes[start + k] as ulong) << (k * 8));
        k = k + 1;
    }
    return word;
}

# One step of `_pep_hash_bytes`: mixes `word` into `h`.
_pep_hash_step(h: ulong, word: ulong): ulong {
    var mixed = __wrapping_mul(h ^ word, 0x9e3779b97f4a7c15);
    return mixed ^ (mixed >> 32);
}

# ── UTF-8 helpers (length-based; no NUL assumptions on language data) ───────
# C strings from getenv are NUL-terminated by the C standard; a byte walk is
# the only way to measure them (never used for language string data).
# The value of the hexadecimal digit `c` (`0`-`9`, `a`-`f` or `A`-`F`), or
# -1 when `c` is not one. Shared by the URI, HTTP and address parsers.
export _pep_hex_digit(c: int): int {
    if (c >= '0' && c <= '9') {
        return c - '0';
    }
    if (c >= 'a' && c <= 'f') {
        return c - 'a' + 10;
    }
    if (c >= 'A' && c <= 'F') {
        return c - 'A' + 10;
    }
    return -1;
}

export _pep_c_strlen(s: __ptr<char>): ulong {
    var i = 0;
    while (s[i] != 0) {
        i = i + 1;
    }
    return i;
}

export _pep_utf8_length(s: __ptr<char>, size: ulong): ulong {
    if (s == __null || size == 0) { return 0; }
    var (end, count) = _pep_utf8_scan(s, size, size);
    if (end != size) {
        return 0;
    }
    return count;
}

export _pep_utf8_size(s: __ptr<char>, size: ulong, chars: ulong): ulong {
    if (s == __null) { return 0; }
    if (chars == 0) { return size; }
    if (!_pep_utf8_valid(s, size)) { return 0; }
    return _pep_utf8_char_offset(s, size, chars);
}

export _pep_utf8_compare(a: __ptr<char>, a_size: ulong, b: __ptr<char>, b_size: ulong, size: ulong): bool {
    if (size == 0) {
        return a_size == b_size && memcmp(a, b, a_size) == 0;
    }
    return a_size >= size && b_size >= size && memcmp(a, b, size) == 0;
}

# The offset of the first byte from `i` up to (not including) `end` at `data`
# that is not ASCII (has its high bit set), or `end` when there is none.
# It tests sixteen bytes per step with a vector compare, whose bit mask's
# `trailing_zeros` is the first such byte. It calls the intrinsics
# under `simd.Vector` directly: at `-O0` the vector's methods, even inlined,
# leave the loop several times slower than these few instructions.
_pep_ascii_end(data: __ptr<void>, i: ulong, end: ulong): ulong {
    __ptr<byte> bytes = unsafe_cast<__ptr<byte>>(data);
    var high_bit = __simd_splat<__simd<byte, 16>>(0x80 as byte);
    while (i + 16 <= end) {
        var chunk = __simd_load<__simd<byte, 16>>(bytes + i);
        var high = __simd_to_bits<__simd<bool, 16>>(__simd_greater_equal<__simd<byte, 16>>(chunk, high_bit));
        if (high != 0) {
            return i + high.trailing_zeros();
        }
        i = i + 16;
    }
    while (i < end) {
        if ((data[i] & 0x80) != 0) {
            return i;
        }
        i = i + 1;
    }
    return end;
}

# Reads UTF-8 from the start of the `size` bytes at `data` until it has
# counted `chars` code points, reached `size`, or met bytes that are not a
# whole valid sequence, and returns the byte offset it stopped at and the
# code points before it. So the bytes are valid UTF-8 exactly when the offset
# is `size` (with `chars` at least `size`). Every UTF-8 count and check goes
# through this one loop, with the decoding written out in it: a call per
# code point made CJK text about half again slower. A run of eight
# ASCII bytes or more is handed to `_pep_ascii_end`, which skips it sixteen
# bytes at a time; shorter runs stay in the loop.
export _pep_utf8_scan(data: __ptr<void>, size: ulong, chars: ulong): (ulong, ulong) {
    ulong i = 0;
    ulong count = 0;
    ulong ascii_run = 0;
    while (i < size && count < chars) {
        # Byte reads are signed; mask to the unsigned value.
        var b = data[i] & 0xFF;
        if (b < 128) {
            i = i + 1;
            count = count + 1;
            ascii_run = ascii_run + 1;
            if (ascii_run == 8) {
                var end = size;
                if (chars - count < size - i) {
                    end = i + (chars - count);
                }
                var stop = _pep_ascii_end(data, i, end);
                count = count + (stop - i);
                i = stop;
                ascii_run = 0;
            }
            continue;
        }
        ascii_run = 0;
        # Each read is guarded by its own `if`, so none reads past `size`.
        if (b < 192) {
            break;
        }
        if (b < 224) {
            if (i + 2 > size) { break; }
            if ((data[i + 1] & 0xC0) != 0x80) { break; }
            i = i + 2;
        } else if (b < 240) {
            if (i + 3 > size) { break; }
            if ((data[i + 1] & 0xC0) != 0x80) { break; }
            if ((data[i + 2] & 0xC0) != 0x80) { break; }
            i = i + 3;
        } else if (b < 248) {
            if (i + 4 > size) { break; }
            if ((data[i + 1] & 0xC0) != 0x80) { break; }
            if ((data[i + 2] & 0xC0) != 0x80) { break; }
            if ((data[i + 3] & 0xC0) != 0x80) { break; }
            i = i + 4;
        } else {
            break;
        }
        count = count + 1;
    }
    return (i, count);
}

export _pep_utf8_valid(data: __ptr<void>, size: ulong): bool {
    if (data == __null || size == 0) { return true; }
    var (end, count) = _pep_utf8_scan(data, size, size);
    return end == size;
}

[Target(!OS(Windows))]
extern void* memmem(void* haystack, ulong haystack_size, void* needle, ulong needle_size);

# The first `needle` in the haystack, or `__null`. libc's `memmem` scans
# many bytes per step where it can.
[Target(!OS(Windows))]
_pep_memmem(haystack: __ptr<void>, haystack_size: ulong, needle: __ptr<void>, needle_size: ulong): __ptr<void> {
    return memmem(haystack, haystack_size, needle, needle_size);
}

extern void* memchr(void* p, int c, ulong n);

# The first `needle` in the haystack, or `__null`. The Windows C runtime has
# no `memmem`, so this jumps to candidates with `memchr`. When `memchr`'s hit
# comes within a few bytes, the first byte is common here, so it checks the
# next 32 bytes itself rather than pay a call per byte; when hits are sparse
# it stays with `memchr`. It compares the needle's last byte before calling
# `memcmp`.
[Target(OS(Windows))]
_pep_memmem(haystack: __ptr<void>, haystack_size: ulong, needle: __ptr<void>, needle_size: ulong): __ptr<void> {
    if (needle_size > haystack_size) {
        return __null;
    }
    # Byte reads are signed; mask to the unsigned value.
    var first = (needle[0] & 0xFF) as int;
    var tail = needle_size - 1;
    var final = (needle[tail] & 0xFF) as int;
    var last = haystack_size - needle_size;
    ulong i = 0;
    while (i <= last) {
        __ptr<void> found = memchr(haystack + i, first, last + 1 - i);
        if (found == __null) {
            return __null;
        }
        var at = unsafe_cast<ulong>(found) - unsafe_cast<ulong>(haystack);
        var window = at + 1;
        if (at - i < 8) {
            window = at + 32;
            if (window > last + 1) {
                window = last + 1;
            }
        }
        i = at;
        while (i < window) {
            if (((haystack[i] & 0xFF) as int) == first) {
                if (((haystack[i + tail] & 0xFF) as int) == final) {
                    if (memcmp(haystack + i, needle, needle_size) == 0) {
                        return haystack + i;
                    }
                }
            }
            i = i + 1;
        }
    }
    return __null;
}

# The byte offset of the first `needle` in the haystack, or -1, checking no
# UTF-8: callers that need the bytes before it checked check them themselves,
# as `_pep_utf8_find` does and as split and replace do while counting each
# piece's code points.
export _pep_utf8_search(haystack: __ptr<void>, haystack_size: ulong, needle: __ptr<void>, needle_size: ulong): long {
    if (haystack == __null || haystack_size == 0) { return -1; }
    if (needle_size == 0) { return 0; }
    if (needle == __null) { return -1; }
    __ptr<void> found = _pep_memmem(haystack, haystack_size, needle, needle_size);
    if (found == __null) {
        return -1;
    }
    return (unsafe_cast<ulong>(found) - unsafe_cast<ulong>(haystack)) as long;
}

# The byte offset of the first `needle` in the haystack, or -1. The needle
# must be valid UTF-8, and so must the haystack before the match. Only the
# bytes before the match are checked, once each, so repeated searches from
# successive offsets stay linear; and a valid prefix ends on a code
# point boundary, so a match is only ever found at one.
export _pep_utf8_find(haystack: __ptr<void>, haystack_size: ulong, needle: __ptr<void>, needle_size: ulong): long {
    if (needle_size > 0 && !_pep_utf8_valid(needle, needle_size)) { return -1; }
    var at = _pep_utf8_search(haystack, haystack_size, needle, needle_size);
    if (at <= 0) {
        return at;
    }
    if (!_pep_utf8_valid(haystack, at as ulong)) {
        return -1;
    }
    return at;
}

export _pep_utf8_char_offset(data: __ptr<void>, size: ulong, chars: ulong): ulong {
    if (data == __null || size == 0) { return 0; }
    var (end, count) = _pep_utf8_scan(data, size, chars);
    if (end < size && count < chars) {
        # Stopped at bytes that are not valid UTF-8.
        return size;
    }
    return end;
}
io/address
26697
## Network addresses: `IpAddress` (IPv4 or IPv6), `SocketAddress` (an IP
## address and a port), and `resolve`, which turns a host name into socket
## addresses.

# IpAddress keeps its 16 bytes in two ulongs, most significant byte first,
# so an address needs no allocation beyond the struct. Parsing and
# formatting are pure Pepper, so every platform accepts and prints exactly
# the same text.

import "socket_posix";
import "socket_wasi";
import "socket_windows";
import "sys_posix";
import "sys_windows";
import "types";

## An IPv4 or IPv6 address.
##
## Make one with `IpAddress.v4`, `IpAddress.v6`, `IpAddress.parse`, or one
## of the well-known addresses (`loopback_v4()`, `unspecified_v6()`, ...).
## `IpAddress()` is the IPv4 unspecified address `0.0.0.0`.
##
## `to_string()` prints IPv4 in dotted decimal (`127.0.0.1`) and IPv6 in the
## RFC 5952 form (`::1`, `2001:db8::8a2e:370:7334`); an IPv4-mapped IPv6
## address prints as `::ffff:1.2.3.4`. An IPv4 address and the IPv6 address
## that maps it are different values.
##
## An IPv6 address can carry a scope id, the network interface a link-local
## address such as `fe80::1` belongs to. Its text form is `fe80::1%eth0`
## (RFC 4007), and a socket address carries it to the system as
## `sin6_scope_id`.
##
## @example
##     import io;
##
##     var a = io.IpAddress.parse("192.168.1.10").value();
##     var b = io.IpAddress.v6(8193, 3512, 0, 0, 0, 0, 0, 1);   # 2001:db8::1
##     print(a.is_v4());         # true
##     print(b.to_string());     # 2001:db8::1
## @see SocketAddress
export struct IpAddress {
    ## Whether this is an IPv6 address.
    bool _is_v6;
    ## Bytes 0 to 7 of an IPv6 address, the first byte most significant; 0 for IPv4.
    ulong _high;
    ## Bytes 8 to 15 of an IPv6 address, or the IPv4 address in the low 32 bits.
    ulong _low;
    ## The IPv6 scope id (an interface index); 0 for none and for IPv4.
    uint _scope_id;

    ## Creates the IPv4 unspecified address, `0.0.0.0`.
    construct() {}

    ## Creates an IPv4 address from its four bytes, `a.b.c.d`.
    ##
    ## @param a the first byte
    ## @param b the second byte
    ## @param c the third byte
    ## @param d the fourth byte
    ## @returns the address `a.b.c.d`
    ## @example
    ##     var home = IpAddress.v4(127, 0, 0, 1);
    static v4(a: u8, b: u8, c: u8, d: u8): IpAddress {
        var address = IpAddress();
        address._low = ((a as ulong) << 24) | ((b as ulong) << 16) | ((c as ulong) << 8) | (d as ulong);
        return address;
    }

    ## Creates an IPv6 address from its eight 16-bit groups, `a:b:c:d:e:f:g:h`.
    ##
    ## @param a the first group
    ## @param b the second group
    ## @param c the third group
    ## @param d the fourth group
    ## @param e the fifth group
    ## @param f the sixth group
    ## @param g the seventh group
    ## @param h the eighth group
    ## @returns the address
    ## @example
    ##     var loopback = IpAddress.v6(0, 0, 0, 0, 0, 0, 0, 1);   # ::1
    static v6(a: u16, b: u16, c: u16, d: u16, e: u16, f: u16, g: u16, h: u16): IpAddress {
        var address = IpAddress();
        address._is_v6 = true;
        address._high = ((a as ulong) << 48) | ((b as ulong) << 32) | ((c as ulong) << 16) | (d as ulong);
        address._low = ((e as ulong) << 48) | ((f as ulong) << 32) | ((g as ulong) << 16) | (h as ulong);
        return address;
    }

    ## Returns the IPv4 loopback address, `127.0.0.1`.
    ##
    ## @returns `127.0.0.1`
    static loopback_v4(): IpAddress {
        return v4(127, 0, 0, 1);
    }

    ## Returns the IPv6 loopback address, `::1`.
    ##
    ## @returns `::1`
    static loopback_v6(): IpAddress {
        return v6(0, 0, 0, 0, 0, 0, 0, 1);
    }

    ## Returns the IPv4 unspecified address, `0.0.0.0`. Binding to it listens
    ## on every IPv4 interface.
    ##
    ## @returns `0.0.0.0`
    static unspecified_v4(): IpAddress {
        return IpAddress();
    }

    ## Returns the IPv6 unspecified address, `::`. Binding to it listens on
    ## every IPv6 interface (and, where the system allows dual-stack sockets
    ## by default, such as Linux, on every IPv4 interface too).
    ##
    ## @returns `::`
    static unspecified_v6(): IpAddress {
        return v6(0, 0, 0, 0, 0, 0, 0, 0);
    }

    ## Parses an IPv4 address in dotted decimal (`192.168.0.1`) or an IPv6
    ## address in the RFC 4291 text form (`::1`, `fe80::1:2`,
    ## `::ffff:10.0.0.1`), with an optional scope (`fe80::1%eth0`).
    ##
    ## IPv4 needs exactly four decimal parts from 0 to 255 without leading
    ## zeros. IPv6 takes up to eight groups of one to four hex digits (either
    ## case), at most one `::`, and an optional IPv4 address as the last 32
    ## bits. Brackets and surrounding spaces are not accepted.
    ##
    ## An IPv6 address may end in `%` and a scope: a decimal scope id
    ## (`%3`), or the name of a network interface (`%eth0`), which is looked
    ## up on this machine (so it fails where there is no such interface).
    ##
    ## @param text the address to parse
    ## @returns the address; an error with `is_invalid_input()` when `text` is
    ##   not a valid IPv4 or IPv6 address or names an unknown interface
    ## @example
    ##     var r = IpAddress.parse("10.0.0.300");
    ##     print(r.is_err());   # true: 300 is out of range
    ##     var scoped = IpAddress.parse("fe80::1%7").value();
    ##     print(scoped.scope_id());   # 7
    static parse(text: String): IoResult<IpAddress> {
        var p = unsafe_cast<__ptr<u8>>(text.c_str());
        var n = text.size;
        var v4 = _io_parse_v4(p, n, 0, n);
        if (v4.is_value()) {
            var address = IpAddress();
            address._low = v4.value();
            return IoResult<IpAddress>.ok(address);
        }
        return _io_parse_v6_scoped(text, 0, n, "invalid IP address syntax");
    }

    ## Returns whether this is an IPv4 address.
    ##
    ## @returns true for IPv4, false for IPv6
    is_v4(): bool {
        return !_is_v6;
    }

    ## Returns whether this is an IPv6 address (including an IPv4-mapped one,
    ## `::ffff:a.b.c.d`).
    ##
    ## @returns true for IPv6, false for IPv4
    is_v6(): bool {
        return _is_v6;
    }

    ## Returns the scope id of an IPv6 address: the index of the network
    ## interface it belongs to (the `3` or `eth0` of `fe80::1%3` or
    ## `fe80::1%eth0`), or 0 when it has none. Always 0 for IPv4.
    ##
    ## @returns the scope id, 0 for none
    scope_id(): uint {
        return _scope_id;
    }

    ## Returns this address with scope id `id`, such as the index of the
    ## interface a link-local address is reached through; 0 removes the
    ## scope.
    ##
    ## @param id the scope id, 0 for none
    ## @returns a copy of this address with that scope id
    ## @panics if this is an IPv4 address and `id` is not 0
    ## @example
    ##     var a = IpAddress.parse("fe80::1").value().with_scope_id(2);
    ##     print(a.to_string());   # fe80::1%eth0 where interface 2 is eth0
    with_scope_id(id: uint): IpAddress {
        assert(_is_v6 || id == 0, "an IPv4 address has no scope id");
        var address = IpAddress();
        address._is_v6 = _is_v6;
        address._high = _high;
        address._low = _low;
        address._scope_id = id;
        return address;
    }

    ## Returns whether this is a loopback address: `127.0.0.0/8` for IPv4,
    ## `::1` for IPv6.
    ##
    ## @returns true for a loopback address
    is_loopback(): bool {
        if (_is_v6) {
            return _high == 0 && _low == 1;
        }
        return (_low >> 24) == 127;
    }

    ## Returns whether this is the unspecified address, `0.0.0.0` or `::`.
    ##
    ## @returns true for the unspecified address
    is_unspecified(): bool {
        return _high == 0 && _low == 0;
    }

    ## Returns the address's bytes in network order: 4 for IPv4, 16 for
    ## IPv6.
    ##
    ## @returns a new array of the address bytes
    ## @example
    ##     var bytes = IpAddress.v4(10, 0, 0, 1).to_bytes();   # [10, 0, 0, 1]
    to_bytes(): u8[] {
        var out = Array<u8>();
        ulong first = 0;
        if (!_is_v6) {
            first = 12;
        }
        var i = first;
        while (i < 16) {
            out.append(_byte(i) as u8);
            i = i + 1;
        }
        return out;
    }

    # Byte `i` (0 to 15) of the 16-byte form, IPv4 in bytes 12 to 15.
    _byte(i: ulong): ulong {
        if (i < 8) {
            return (_high >> (56 - 8 * i)) & 255;
        }
        return (_low >> (56 - 8 * (i - 8))) & 255;
    }

    # 16-bit group `i` (0 to 7) of an IPv6 address.
    _group(i: ulong): ulong {
        if (i < 4) {
            return (_high >> (48 - 16 * i)) & 65535;
        }
        return (_low >> (48 - 16 * (i - 4))) & 65535;
    }

    ## Returns the address as text: dotted decimal for IPv4, the RFC 5952
    ## form for IPv6 (lowercase hex, leading zeros dropped, the longest run of
    ## two or more zero groups written `::`, `::ffff:a.b.c.d` for an
    ## IPv4-mapped address). A scope id follows as `%` and the name of its
    ## interface (`fe80::1%eth0`), or the number when no interface on this
    ## machine has that index (`fe80::1%9`).
    ##
    ## @returns the text form, which `IpAddress.parse` reads back
    to_string(): String {
        if (!_is_v6) {
            return _io_v4_text(_low);
        }
        if (_scope_id != 0) {
            var name = _io_sys_interface_name(_scope_id);
            if (name.size == 0) {
                name = $"{_scope_id}";
            }
            return _unscoped_text() + "%" + name;
        }
        return _unscoped_text();
    }

    # The IPv6 text form without the scope.
    _unscoped_text(): String {
        if (_high == 0 && (_low >> 32) == 65535) {
            return "::ffff:" + _io_v4_text(_low & 4294967295);
        }
        # The longest run of zero groups, at least two long; the first wins a tie.
        ulong best_start = 8;
        ulong best_length = 1;
        ulong i = 0;
        while (i < 8) {
            if (_group(i) == 0) {
                var j = i;
                while (j < 8) {
                    if (_group(j) != 0) {
                        break;
                    }
                    j = j + 1;
                }
                if (j - i > best_length) {
                    best_start = i;
                    best_length = j - i;
                }
                i = j;
            } else {
                i = i + 1;
            }
        }
        var out = StringBuilder();
        i = 0;
        while (i < 8) {
            if (i == best_start) {
                out.append("::");
                i = i + best_length;
                continue;
            }
            if (i > 0 && i != best_start + best_length) {
                out.append(":");
            }
            out.append($"{_group(i):x}");
            i = i + 1;
        }
        return out.to_string();
    }

    ## Returns whether two addresses are the same: same family, same bytes
    ## and same scope id. An IPv4 address never equals an IPv6 one, not even
    ## the IPv6 address that maps it.
    ##
    ## @param other the address to compare with
    ## @returns true when both are equal
    ==(other: IpAddress): bool {
        return _is_v6 == other._is_v6 && _high == other._high && _low == other._low && _scope_id == other._scope_id;
    }

    ## Returns whether two addresses differ.
    ##
    ## @param other the address to compare with
    ## @returns true when the family, any byte or the scope id differs
    !=(other: IpAddress): bool {
        return !(this == other);
    }
}

## An IP address and a port: where a socket is bound, or where it connects
## or sends.
##
## Make one with `SocketAddress(address, port)` or `SocketAddress.parse`,
## or get a list from `resolve`. `SocketAddress()` is `0.0.0.0:0`. The text
## form is `address:port` for IPv4 and `[address]:port` for IPv6.
##
## @example
##     import io;
##
##     var any = io.SocketAddress(io.IpAddress.unspecified_v4(), 8080);
##     var local = io.SocketAddress.parse("[::1]:443").value();
##     print(local.port());   # 443
## @see IpAddress
## @see resolve
export struct SocketAddress {
    ## The IP address.
    IpAddress _address;
    ## The port, 0 to 65535.
    u16 _port;

    ## Creates `0.0.0.0:0`, the IPv4 unspecified address with port 0.
    construct() {
        _address = IpAddress();
    }

    ## Creates a socket address from an IP address and a port.
    ##
    ## Port 0 asks the system to choose a free port when binding; read the
    ## one it chose with the socket's `local_address()`.
    ##
    ## @param address the IP address
    ## @param port the port
    construct(address: IpAddress, port: u16) {
        _address = address;
        _port = port;
    }

    ## Parses `a.b.c.d:port` (IPv4) or `[ipv6]:port` (IPv6), with the address
    ## syntax of `IpAddress.parse` (a scope goes inside the brackets,
    ## `[fe80::1%eth0]:80`) and a decimal port from 0 to 65535.
    ##
    ## @param text the socket address to parse
    ## @returns the socket address; an error with `is_invalid_input()` when
    ##   the text is malformed
    ## @example
    ##     var a = SocketAddress.parse("127.0.0.1:8080").value();
    ##     var b = SocketAddress.parse("[::1]:8080").value();
    static parse(text: String): IoResult<SocketAddress> {
        var p = unsafe_cast<__ptr<u8>>(text.c_str());
        var n = text.size;
        var bad = IoResult<SocketAddress>.err(IoError(_io_sys_code_invalid_input(), "invalid socket address syntax"));
        if (n == 0) {
            return bad;
        }
        # Split at the colon before the port: after `]` for IPv6, the only
        # colon for IPv4.
        ulong colon = n;
        var v6 = _io_byte(p, n, 0) == '[';
        if (v6) {
            var close = text.find("]");
            if (close < 0 || (close as ulong) + 1 >= n || _io_byte(p, n, (close as ulong) + 1) != ':') {
                return bad;
            }
            colon = (close as ulong) + 1;
        } else {
            var first = text.find(":");
            if (first < 0) {
                return bad;
            }
            colon = first as ulong;
            if (text.find(":", colon + 1) >= 0) {
                return bad;  # a second colon: IPv6 needs brackets
            }
        }
        var port = _io_parse_port(p, n, colon + 1, n);
        if (port.is_empty()) {
            return bad;
        }
        var address = IpAddress();
        if (v6) {
            var scoped = _io_parse_v6_scoped(text, 1, colon - 1, "invalid socket address syntax");
            if (scoped.is_err()) {
                return IoResult<SocketAddress>.err(scoped.error());
            }
            address = scoped.value();
        } else {
            var value = _io_parse_v4(p, n, 0, colon);
            if (value.is_empty()) {
                return bad;
            }
            address._low = value.value();
        }
        return IoResult<SocketAddress>.ok(SocketAddress(address, port.value() as u16));
    }

    ## Returns the IP address.
    ##
    ## @returns the IP address part
    address(): IpAddress {
        return _address;
    }

    ## Returns the port.
    ##
    ## @returns the port, 0 to 65535
    port(): u16 {
        return _port;
    }

    ## Returns whether the IP address is IPv4.
    ##
    ## @returns true for an IPv4 socket address
    is_v4(): bool {
        return _address.is_v4();
    }

    ## Returns whether the IP address is IPv6.
    ##
    ## @returns true for an IPv6 socket address
    is_v6(): bool {
        return _address.is_v6();
    }

    ## Returns the text form: `a.b.c.d:port` for IPv4, `[ipv6]:port` for
    ## IPv6.
    ##
    ## @returns the text form, which `SocketAddress.parse` reads back
    to_string(): String {
        var address = _address.to_string();
        if (_address.is_v6()) {
            return $"[{address}]:{_port}";
        }
        return $"{address}:{_port}";
    }

    ## Returns whether two socket addresses have equal IP addresses and the
    ## same port.
    ##
    ## @param other the socket address to compare with
    ## @returns true when both are equal
    ==(other: SocketAddress): bool {
        return _address == other._address && _port == other._port;
    }

    ## Returns whether two socket addresses differ.
    ##
    ## @param other the socket address to compare with
    ## @returns true when the address or the port differs
    !=(other: SocketAddress): bool {
        return !(this == other);
    }
}

## Looks up the socket addresses of a host, with `port` attached to each.
##
## A `host` that is already an IP address (as `IpAddress.parse` reads it) is
## returned as is, without a lookup. Anything else goes to the system
## resolver (`getaddrinfo` on POSIX, `GetAddrInfoW` on Windows), which
## consults the hosts file and DNS and blocks until it answers. The addresses
## come in the resolver's order of preference, IPv4 and IPv6 mixed, each at
## most once.
##
## @param host a host name such as `"example.com"` or `"localhost"`, or an IP address
## @param port the port to put in every result
## @returns at least one address; an error with `is_not_found()` when the
##   name has no address, `is_invalid_input()` when `host` is empty, or
##   another resolver error
## @example
##     import io;
##
##     var r = io.resolve("localhost", 8080);
##     if (r.is_ok()) {
##         for (var address in r.value()) {
##             print(address.to_string());   # 127.0.0.1:8080, [::1]:8080, ...
##         }
##     }
export resolve(host: String, port: u16): IoResult<SocketAddress[]> {
    if (host.size == 0) {
        return IoResult<SocketAddress[]>.err(IoError(_io_sys_code_invalid_input(), "empty host name"));
    }
    var literal = IpAddress.parse(host);
    if (literal.is_ok()) {
        var one = Array<SocketAddress>();
        one.append(SocketAddress(literal.value(), port));
        return IoResult<SocketAddress[]>.ok(one);
    }
    var found = _io_sys_resolve(host, port);
    if (found.is_err()) {
        return found;
    }
    # The resolver lists an address once per socket type and protocol it
    # supports even with a type hint on some systems; keep the first of each.
    var unique = Array<SocketAddress>();
    for (var address in found.value()) {
        if (!unique.contains(address)) {
            unique.append(address);
        }
    }
    if (unique.count == 0) {
        return IoResult<SocketAddress[]>.err(IoError(_io_sys_code_not_found(), "no address found for '" + host + "'"));
    }
    return IoResult<SocketAddress[]>.ok(unique);
}

# ── Text helpers ─────────────────────────────────────────────────────────────

# The IPv6 address in text[start, end), with an optional `%` and scope (a
# decimal id or an interface name); `syntax` is the message for malformed
# text.
_io_parse_v6_scoped(text: String, start: ulong, end: ulong, syntax: String): IoResult<IpAddress> {
    var p = unsafe_cast<__ptr<u8>>(text.c_str());
    var n = text.size;
    var bad = IoResult<IpAddress>.err(IoError(_io_sys_code_invalid_input(), syntax));
    var address_end = end;
    var percent = text.find("%", start);
    if (percent >= 0 && (percent as ulong) < end) {
        address_end = percent as ulong;
    }
    var v6 = _io_parse_v6(p, n, start, address_end);
    if (v6.is_empty()) {
        return bad;
    }
    var bits: (high: ulong, low: ulong) = v6.value();
    var address = IpAddress();
    address._is_v6 = true;
    address._high = bits.high;
    address._low = bits.low;
    if (address_end == end) {
        return IoResult<IpAddress>.ok(address);
    }
    var zone = text.substr_bytes(address_end + 1, end - address_end - 1);
    if (zone.size == 0) {
        return bad;
    }
    var id = _io_parse_decimal_u32(zone);
    if (id.is_value()) {
        address._scope_id = id.value();
        return IoResult<IpAddress>.ok(address);
    }
    var index = _io_sys_interface_index(zone);
    if (index == 0) {
        return IoResult<IpAddress>.err(IoError(_io_sys_code_invalid_input(), $"no network interface named '{zone}'"));
    }
    address._scope_id = index;
    return IoResult<IpAddress>.ok(address);
}

# `text` as a decimal number from 0 to 4294967295; none when it is not one.
_io_parse_decimal_u32(text: String): uint? {
    if (text.size == 0 || text.size > 10) {
        return Optional<uint>.Empty;
    }
    ulong value = 0;
    for (var c in text.bytes()) {
        if (!(c as byte).is_digit()) {
            return Optional<uint>.Empty;
        }
        value = value * 10 + (c - '0') as ulong;
    }
    if (value > 4294967295) {
        return Optional<uint>.Empty;
    }
    return Optional<uint>.Value(value as uint);
}

# The dotted-decimal text of the IPv4 address in the low 32 bits of `value`.
_io_v4_text(value: ulong): String {
    return $"{(value >> 24) & 255}.{(value >> 16) & 255}.{(value >> 8) & 255}.{value & 255}";
}

# ── Parsing helpers: each reads p[start, end) of the n bytes at p ───────────

# Dotted decimal: exactly four parts of 0 to 255, no leading zeros. Returns
# the 32-bit value, or none when the text is not an IPv4 address.
_io_parse_v4(p: __ptr<u8>, n: ulong, start: ulong, end: ulong): ulong? {
    ulong value = 0;
    ulong parts = 0;
    var i = start;
    while (parts < 4) {
        var first = _io_byte(p, n, i);
        ulong part = 0;
        ulong digits = 0;
        while (i < end) {
            var c = _io_byte(p, n, i);
            if (!(c as byte).is_digit()) {
                break;
            }
            part = part * 10 + (c - '0') as ulong;
            digits = digits + 1;
            i = i + 1;
            if (digits > 3) {
                return Optional<ulong>.Empty;
            }
        }
        if (digits == 0 || part > 255) {
            return Optional<ulong>.Empty;
        }
        if (digits > 1 && first == '0') {
            return Optional<ulong>.Empty;
        }
        value = (value << 8) | part;
        parts = parts + 1;
        if (parts < 4) {
            if (i >= end) {
                return Optional<ulong>.Empty;
            }
            if (_io_byte(p, n, i) != '.') {
                return Optional<ulong>.Empty;
            }
            i = i + 1;
        }
    }
    if (i != end) {
        return Optional<ulong>.Empty;
    }
    return Optional<ulong>.Value(value);
}

# RFC 4291 text: up to eight hex groups, at most one `::`, an optional
# dotted IPv4 tail. Returns the high and low 64 bits, or none when the text
# is not an IPv6 address.
_io_parse_v6(p: __ptr<u8>, n: ulong, start: ulong, end: ulong): Optional<(high: ulong, low: ulong)> {
    var fail = Optional<(high: ulong, low: ulong)>.Empty;
    if (start >= end) {
        return fail;
    }
    var head = Array<ulong>();  # groups before `::`
    var tail = Array<ulong>();  # groups after it
    var gap = false;
    var i = start;
    if (_io_byte(p, n, i) == ':') {
        if (i + 1 >= end) {
            return fail;
        }
        if (_io_byte(p, n, i + 1) != ':') {
            return fail;
        }
        gap = true;
        i = i + 2;
    }
    while (i < end) {
        var groups = head;
        if (gap) {
            groups = tail;
        }
        var j = i;
        while (j < end) {
            if (_pep_hex_digit(_io_byte(p, n, j)) < 0) {
                break;
            }
            j = j + 1;
        }
        if (j < end && _io_byte(p, n, j) == '.') {
            # The last 32 bits as an IPv4 address.
            var v4 = _io_parse_v4(p, n, i, end);
            if (v4.is_empty()) {
                return fail;
            }
            groups.append(v4.value() >> 16);
            groups.append(v4.value() & 65535);
            i = end;
            break;
        }
        if (j == i || j - i > 4) {
            return fail;
        }
        ulong group = 0;
        while (i < j) {
            group = group * 16 + _pep_hex_digit(_io_byte(p, n, i)) as ulong;
            i = i + 1;
        }
        groups.append(group);
        if (i == end) {
            break;
        }
        if (_io_byte(p, n, i) != ':') {
            return fail;
        }
        i = i + 1;
        if (i < end && _io_byte(p, n, i) == ':') {
            if (gap) {
                return fail;  # a second `::`
            }
            gap = true;
            i = i + 1;
            continue;
        }
        if (i == end) {
            return fail;  # a trailing single colon
        }
    }
    var count = head.count + tail.count;
    if (gap && count > 7) {
        return fail;
    }
    if (!gap && count != 8) {
        return fail;
    }
    var all = Array<ulong>();
    for (var g in head) {
        all.append(g);
    }
    while (all.count + tail.count < 8) {
        all.append(0);
    }
    for (var g in tail) {
        all.append(g);
    }
    var high = (all[0] << 48) | (all[1] << 32) | (all[2] << 16) | all[3];
    var low = (all[4] << 48) | (all[5] << 32) | (all[6] << 16) | all[7];
    return Optional<(high: ulong, low: ulong)>.Value((high: high, low: low));
}

# A decimal port, 0 to 65535, one to five digits; none when the text is not
# one.
_io_parse_port(p: __ptr<u8>, n: ulong, start: ulong, end: ulong): ulong? {
    if (start >= end || end - start > 5) {
        return Optional<ulong>.Empty;
    }
    ulong value = 0;
    var i = start;
    while (i < end) {
        var c = _io_byte(p, n, i);
        if (!(c as byte).is_digit()) {
            return Optional<ulong>.Empty;
        }
        value = value * 10 + (c - '0') as ulong;
        i = i + 1;
    }
    if (value > 65535) {
        return Optional<ulong>.Empty;
    }
    return Optional<ulong>.Value(value);
}
io/directory
20380
# Directory, DirEntry.

import "file";
import "path";
import "sys_posix";
import "sys_windows";
import "types";

## One entry of a directory listing, as `Directory.entries()` returns it.
##
## The kind flags come from the listing itself and describe the entry
## without following symlinks. On POSIX a symlink has `is_symlink` set and
## `is_file` and `is_directory` clear; on Windows a symlink or junction to a
## directory has both `is_directory` and `is_symlink` set. Entries that are none of
## these (a FIFO, socket or device on POSIX) have all three flags clear. Call
## `metadata()` for the details of what the entry points to.
##
## @example
##     import io;
##
##     var list = io.Directory.open(io.Path("src")).value().entries().value();
##     ulong i = 0;
##     while (i < list.count) {
##         if (list[i].is_file) {
##             print(list[i].Name);
##         }
##         i = i + 1;
##     }
export struct DirEntry {
    ## The entry's full path: the listed directory's path joined with
    ## `name` (relative when the directory's path was relative).
    Path path;
    ## The entry's own file name, without any directory part.
    String name;
    ## The kind of the entry, without following symlinks: `Symlink` for a
    ## symlink (on Windows, any reparse point, even one to a directory),
    ## `Other` for anything that is not a file, directory or symlink.
    FileType file_type;
    ## Whether the entry is a regular file (never true for a symlink).
    bool is_file;
    ## Whether the entry is a directory. On POSIX never true for a symlink;
    ## on Windows also true for a symlink or junction to a directory.
    bool is_directory;
    ## Whether the entry is a symlink (on Windows, any reparse point,
    ## junctions included), which is not followed.
    bool is_symlink;

    ## Creates an empty entry: empty `path` and `name`, all kind flags
    ## false and `file_type` `Other`. Entries are normally obtained from
    ## `Directory.entries()`.
    construct() {
        file_type = FileType.Other;
    }

    ## Returns the metadata of the entry, following symlinks, exactly like
    ## `Path.metadata()` on the entry's `path`. The file system is queried
    ## again now, so the result reflects any change since the listing was
    ## read.
    ##
    ## @returns the entry's `Metadata` (of the target, for a symlink); an
    ## error when it cannot be stat'ed, with `is_not_found()` when the entry
    ## was removed since the listing or is a dangling symlink
    ## @see Path.metadata
    metadata(): IoResult<Metadata> {
        return _io_sys_stat(path, true);
    }
}

## A directory on the file system, identified by its path, together with
## static functions that create, remove and inspect directories and the
## process's current and temporary directories.
##
## A `Directory` holds no operating-system handle: `open` only checks that
## the path is a directory, and each call to `entries()` reads the listing
## afresh.
##
## @example
##     import io;
##
##     var dir = io.Directory.temp().join("scratch").join("logs");
##     if (io.Directory.create_all(dir).is_ok()) {
##         var d = io.Directory.open(dir).value();
##         var count = d.entries().value().count;
##         io.Directory.remove_all(io.Directory.temp().join("scratch"));
##     }
export struct Directory {
    ## The directory's path, as given to `open`.
    Path path;

    ## Creates a `Directory` with an empty `path`, which names no directory.
    ## Use `Directory.open` to get one for an existing directory.
    construct() {}

    ## Checks that `path` exists and is a directory (following symlinks) and
    ## returns a `Directory` for it. Nothing is kept open, so the directory
    ## can still be renamed or removed afterwards.
    ##
    ## @param path the directory's path; a relative path is resolved against
    ## the current directory whenever the `Directory` is used
    ## @returns the `Directory`; an error when `path` cannot be stat'ed
    ## (`is_not_found()` for a missing or empty path,
    ## `is_permission_denied()`) or is not a directory (`is_not_a_directory()`,
    ## message `"not a directory"`)
    ## @example
    ##     import io;
    ##
    ##     var d = io.Directory.open(io.Path("src"));
    ##     if (d.is_err() && d.error().is_not_a_directory()) {
    ##         print("src is a file");
    ##     }
    static open(path: Path): IoResult<Directory> {
        var m = _io_sys_stat(path, true);
        if (m.is_err()) {
            return IoResult<Directory>.err(m.error());
        }
        if (!m.value().is_directory) {
            return IoResult<Directory>.err(IoError(_io_sys_code_not_a_directory(), "not a directory"));
        }
        var d = Directory();
        d.path = path;
        return IoResult<Directory>.ok(d);
    }

    ## Reads the directory's listing now, all at once: every entry except
    ## `.` and `..`, in the order the operating system returns them (not
    ## sorted). Uses `opendir`/`readdir` on POSIX and
    ## `FindFirstFileW`/`FindNextFileW` on Windows. To read the entries one
    ## at a time instead, loop over the `Directory` itself (see `iterate`).
    ##
    ## @returns the entries, possibly none; an error when the directory
    ## cannot be read: `is_not_found()` when it no longer exists (or, on
    ## POSIX, `path` is empty), `is_permission_denied()`, or on POSIX
    ## `is_not_a_directory()` when `path` now names a file
    ## @example
    ##     import io;
    ##
    ##     var list = io.Directory.open(io.Path(".")).value().entries();
    ##     if (list.is_ok()) {
    ##         var n = list.value().count;
    ##     }
    entries(): IoResult<DirEntry[]> {
        return _io_list(path);
    }

    ## Returns an iterator that reads the directory's listing one entry at a
    ## time, as `for (var entry in dir)` does, without building an array.
    ##
    ## Each element is an `IoResult<DirEntry>`. The listing is opened by the
    ## first `next()`, so a directory that cannot be read yields one error
    ## (the same errors as `entries()`) and then ends; an error while
    ## reading also ends it. The entries come in the order the operating
    ## system returns them, without `.` and `..`. The listing is closed
    ## when it ends, or when the iterator is released, so leaving the loop
    ## early with `break` or `return` closes it too.
    ##
    ## @returns a new `DirectoryIterator` positioned before the first entry
    ## @example
    ##     import io;
    ##
    ##     var dir = io.Directory.open(io.Path(".")).value();
    ##     for (var entry in dir) {
    ##         if (entry.is_err()) {
    ##             print(entry.error().message);
    ##             break;
    ##         }
    ##         print(entry.value().name);
    ##     }
    iterate(): DirectoryIterator {
        return DirectoryIterator(path);
    }

    ## Creates one directory (`mkdir` on POSIX, with `mode` less the
    ## umask; `CreateDirectoryW` on Windows). Its parent must already exist.
    ##
    ## Giving the mode here means the directory never exists with another
    ## one. `mode` is the POSIX `mode_t` permission bits (448, octal 700,
    ## for a directory only its owner may use); it is ignored on Windows
    ## and WASI.
    ##
    ## @param path the directory to create
    ## @param mode the permission bits on POSIX, less the umask; 511 (octal
    ## 777) by default
    ## @returns an Ok result on success; an error when the directory cannot be
    ## created: `is_already_exists()` when anything (a file too) is already
    ## at `path`, `is_not_found()` when the parent is missing or the path is
    ## empty, `is_permission_denied()` when the parent is not writable
    ## @example
    ##     import io;
    ##
    ##     var keys = io.Directory.create(io.Path("keys"), mode = 448);   # octal 700
    ## @see create_all
    static create(path: Path, mode: Mode = 511): IoResult<void> {
        return _io_sys_mkdir(path, mode);
    }

    ## Creates a directory and any missing parents, like `mkdir -p`.
    ## Succeeds without doing anything when `path` is empty or already a
    ## directory (or a symlink to one). Parents are found lexically with
    ## `Path.parent()`; a relative path is created under the current
    ## directory. It is safe against another process creating the same
    ## directories at the same time.
    ##
    ## `mode` applies to `path` itself when it is created, as `mkdir -p -m`
    ## does: missing parents get the default, 511 (octal 777) less the
    ## umask, so the new directory can always be made inside them. An
    ## existing directory keeps its mode. Ignored on Windows and WASI.
    ##
    ## @param path the directory to create, with its parents
    ## @param mode the permission bits of `path` on POSIX, less the umask;
    ## 511 (octal 777) by default
    ## @returns an Ok result on success; an error when a directory cannot be
    ## created: `is_already_exists()` when a file (not a directory) is at
    ## `path` or at one of its parents, `is_permission_denied()`, and so on.
    ## Parents created before the failure are left in place
    ## @example
    ##     import io;
    ##
    ##     var r = io.Directory.create_all(io.Path("build").join("out").join("logs"));
    static create_all(path: Path, mode: Mode = 511): IoResult<void> {
        if (path._value.size == 0) {
            return _io_ok_void();
        }
        if (path.is_directory()) {
            return _io_ok_void();
        }
        var parent = path.parent();
        if (parent) {
            var p = create_all(parent.value());
            if (p.is_err()) {
                return p;
            }
        }
        var r = _io_sys_mkdir(path, mode);
        # Lost a race with another creator, or `path` ends in "." / "..":
        # fine as long as a directory is there now.
        if (r.is_err()) {
            if (path.is_directory()) {
                return _io_ok_void();
            }
        }
        return r;
    }

    ## Creates a symbolic link at `link` that points to the directory
    ## `target` (`symlink` on POSIX; `CreateSymbolicLinkW` with
    ## `SYMBOLIC_LINK_FLAG_DIRECTORY` on Windows). Use `File.symlink` for a
    ## link to a file: Windows makes the two kinds differently. POSIX makes
    ## the same link either way.
    ##
    ## `target` is stored as given and need not exist; a relative target is
    ## resolved against the directory that holds the link, not the current
    ## directory. On Windows, making a symlink needs Developer Mode or an
    ## administrator, and fails with `is_permission_denied()` otherwise.
    ##
    ## @param target the directory the link points to
    ## @param link where to create the link
    ## @returns an Ok result once the link exists; an error with
    ##   `is_already_exists()` when something is already at `link`,
    ##   `is_not_found()` when its parent is missing or a path is empty,
    ##   `is_permission_denied()`, or another platform error
    ## @example
    ##     import io;
    ##
    ##     io.Directory.symlink(io.Path("releases/1.2"), io.Path("current"));
    ## @see Path.read_link
    static symlink(target: Path, link: Path): IoResult<void> {
        return _io_sys_symlink(target, link, true);
    }

    ## Removes an empty directory (`rmdir` on POSIX, `RemoveDirectoryW` on
    ## Windows).
    ##
    ## @param path the directory to remove; it must be empty
    ## @returns an Ok result on success; an error when it cannot be removed:
    ## `is_directory_not_empty()` when it still has entries, `is_not_found()`
    ## when it is missing or the path is empty, `is_not_a_directory()` when
    ## `path` is a file, `is_permission_denied()`
    ## @see remove_all
    static remove(path: Path): IoResult<void> {
        return _io_sys_rmdir(path);
    }

    ## Removes `path` and, if it is a directory, everything inside it,
    ## recursively. Symlinks are removed, never followed, so nothing outside
    ## the tree is touched. A file or symlink at `path` itself is simply
    ## removed.
    ##
    ## Stops at the first failure, leaving whatever was not yet removed; on
    ## Windows a read-only file inside the tree is such a failure
    ## (`is_permission_denied()`).
    ##
    ## @param path the file, symlink or directory tree to remove
    ## @returns an Ok result on success; an error when something cannot be
    ## removed: `is_not_found()` when `path` does not exist (unlike
    ## `rm -rf`, a missing path is an error) or is empty,
    ## `is_permission_denied()`, and so on
    ## @example
    ##     import io;
    ##
    ##     var tree = io.Directory.temp().join("my-scratch");
    ##     var r = io.Directory.remove_all(tree);
    ##     if (r.is_err() && !r.error().is_not_found()) {
    ##         print(r.error().message);
    ##     }
    ## @see remove
    static remove_all(path: Path): IoResult<void> {
        var m = _io_sys_stat(path, false);
        if (m.is_err()) {
            return IoResult<void>.err(m.error());
        }
        if (m.value().is_symlink || !m.value().is_directory) {
            return _io_sys_remove_link(path, m.value().is_directory);
        }
        var list = _io_list(path);
        if (list.is_err()) {
            return IoResult<void>.err(list.error());
        }
        var entries = list.value();
        ulong i = 0;
        while (i < entries.count) {
            var entry = entries[i];
            i = i + 1;
            if (entry.is_directory && !entry.is_symlink) {
                var r = remove_all(entry.path);
                if (r.is_err()) {
                    return r;
                }
            } else {
                var r = _io_sys_remove_link(entry.path, entry.is_directory);
                if (r.is_err()) {
                    return r;
                }
            }
        }
        return _io_sys_rmdir(path);
    }

    ## Returns the process's current directory, against which relative paths
    ## are resolved (`getcwd` on POSIX, `GetCurrentDirectoryW` on Windows).
    ##
    ## @returns the current directory as an absolute path; an error when it
    ## cannot be determined, such as `is_not_found()` on POSIX when the
    ## directory has been removed
    ## @see set_current
    static current(): IoResult<Path> {
        return _io_sys_getcwd();
    }

    ## Changes the process's current directory (`chdir` on POSIX,
    ## `SetCurrentDirectoryW` on Windows). This affects the whole process,
    ## every thread included: relative paths used anywhere afterwards
    ## resolve against the new directory.
    ##
    ## @param path the new current directory; a relative path is resolved
    ## against the old one
    ## @returns an Ok result on success; an error when the directory cannot be
    ## entered: `is_not_found()` when it is missing or the path is empty,
    ## `is_not_a_directory()` when it is a file, `is_permission_denied()`
    ## @see current
    static set_current(path: Path): IoResult<void> {
        return _io_sys_chdir(path);
    }

    ## Returns the directory for temporary files. It is not created or
    ## checked, so it may not exist.
    ##
    ## On POSIX it is `$TMPDIR` with any trailing `/` removed, or `/tmp`
    ## when `TMPDIR` is unset or empty (`/data/local/tmp` on Android, which
    ## has no `/tmp`; an app should use its cache directory instead). On Windows it is what
    ## `GetTempPathW` reports (from `TMP`, `TEMP`, `USERPROFILE`, or the
    ## Windows directory) with its trailing separator removed unless it is
    ## a root, or `.` if that call fails.
    ##
    ## @returns the temporary directory's path, never an error
    ## @example
    ##     import io;
    ##
    ##     var scratch = io.Directory.temp().join("my-tool");
    static temp(): Path {
        return _io_sys_temp_dir();
    }
}

## The iterator `Directory.iterate()` returns, and a `for` loop over a
## `Directory` drives: the directory's entries, read one at a time, each
## as an `IoResult<DirEntry>`.
##
## It holds the open listing (a `DIR*` on POSIX, a find handle on Windows)
## from the first `next()` until the listing ends, an error ends it, or the
## iterator is released.
##
## @example
##     import io;
##
##     var it = io.Directory.open(io.Path(".")).value().iterate();
##     while (it.next()) {
##         var entry = it.current();
##     }
## @see Directory.iterate
export struct DirectoryIterator {
    ## The directory being listed.
    Path _path;
    ## The open listing: a `DIR*` on POSIX, a find `HANDLE` on Windows; null
    ## before the first `next()` and once the listing is closed.
    __ptr<void> _handle;
    ## Windows only: the `WIN32_FIND_DATAW` the find functions fill; null on
    ## POSIX.
    __ptr<u8> _data;
    ## Windows only: whether `_data` holds an entry `FindFirstFileW` read that
    ## `next()` has not returned yet.
    bool _pending;
    ## Whether `next()` has been called.
    bool _started;
    ## Whether the listing has ended (or failed); `next()` then returns false.
    bool _finished;
    ## The entry the platform layer read last.
    DirEntry _entry;
    ## Whether `_value` holds the element the last `next()` moved to.
    bool _has_value;
    ## The current element.
    IoResult<DirEntry> _value;

    ## Makes an iterator over the entries of the directory at `path`. Nothing
    ## is opened until the first `next()`.
    ##
    ## @param path the directory to list
    construct(path: Path) {
        _path = path;
        _value = IoResult<DirEntry>.ok(DirEntry());
    }

    # Not through a call taking `this`: the destructor runs at refcount zero.
    destruct {
        _close();
    }

    # Closes the listing and frees the find data, if open.
    _close() {
        if (_handle != __null) {
            _io_sys_directory_close(_handle);
            _handle = __null;
        }
        if (_data != __null) {
            _pep_free(_data);
            _data = __null;
        }
    }

    ## Reads the next entry, opening the listing on the first call.
    ##
    ## Once it returns false it keeps returning false.
    ##
    ## @returns true if there is a current element (an entry, or the error
    ## that ends the listing), false once the listing has ended
    next(): bool {
        if (_finished) {
            _has_value = false;
            return false;
        }
        IoResult<bool> read;
        if (_started) {
            read = _io_sys_directory_next(this);
        } else {
            _started = true;
            read = _io_sys_directory_first(this);
        }
        if (read.is_err()) {
            _finished = true;
            _close();
            _value = IoResult<DirEntry>.err(read.error());
            _has_value = true;
            return true;
        }
        if (!read.value()) {
            _finished = true;
            _close();
            _has_value = false;
            return false;
        }
        _value = IoResult<DirEntry>.ok(_entry);
        _has_value = true;
        return true;
    }

    ## Returns the element the last successful `next()` moved to.
    ##
    ## @returns the current entry, or the error that ended the listing
    ## @panics if `next()` was never called, or already returned false ("DirectoryIterator.current() without an entry")
    current(): IoResult<DirEntry> {
        assert(_has_value, "DirectoryIterator.current() without an entry");
        return _value;
    }
}

extend DirectoryIterator with Iterator<IoResult<DirEntry>>;

# Every entry of the directory at `path`, all at once (`Directory.entries()`).
_io_list(path: Path): IoResult<DirEntry[]> {
    var out = Array<DirEntry>();
    for (var entry in DirectoryIterator(path)) {
        if (entry.is_err()) {
            return IoResult<DirEntry[]>.err(entry.error());
        }
        out.append(entry.value());
    }
    return IoResult<DirEntry[]>.ok(out);
}
