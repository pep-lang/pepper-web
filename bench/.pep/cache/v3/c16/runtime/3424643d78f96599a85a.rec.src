[Target(OS(Android))]
extern void SSL_get0_alpn_selected();
[Target(OS(Android))]
extern void SSL_get0_param();
[Target(OS(Android))]
extern void SSL_get_error();
[Target(OS(Android))]
extern void SSL_get_verify_result();
[Target(OS(Android))]
extern void SSL_load_client_CA_file();
