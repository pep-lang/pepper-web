io/print
2274
## `Print`, deprecated: `Writer` gives `print` and `print_line` to every
## stream.

import "file";
import "socket";
import "types";
import "unix";

## Deprecated: use `Writer` instead.
##
## A byte stream that values can be printed to, as the global `print` prints
## to standard output.
##
## A type has the trait by providing `write_all(data: u8[])`; it then gets
## `print` and `print_line`, which write the text `to_string` makes of a
## value (the text `$"{value}"` would hold).
##
## @example
##     import io;
##
##     main(): int {
##         var path = io.Directory.temp().join("report.txt");
##         var file = io.File.create(path).value();
##         file.print("total: ");
##         file.print_line(42);
##         file.close();
##         assert(io.File.read_to_string(path).value() == "total: 42\n", "printed");
##         io.File.remove(path);
##         return 0;
##     }
[Deprecated("use 'Writer' instead", "Writer")]
export trait Print {
    ## Writes all of `data`.
    ##
    ## @param data the bytes to write
    ## @returns an Ok result once every byte is written; an error when the
    ##   stream fails
    write_all(data: u8[]): IoResult<void>;

    ## Writes the text of `value`, with no line break after it: a String as
    ## it is, anything else through `to_string`.
    ##
    ## @typeParam T the type of `value`
    ## @param value the value to print
    ## @returns an Ok result once the text is written; an error as for
    ##   `write_all`
    ## @example
    ##     file.print("n = ");
    ##     file.print(3);   # the file now holds "n = 3"
    print<T>(value: T): IoResult<void> {
        return write_all(to_string(value).bytes());
    }

    ## Writes the text of `value` and a line break (`\n`), as the global
    ## `print` does on standard output.
    ##
    ## @typeParam T the type of `value`
    ## @param value the value to print
    ## @returns an Ok result once the line is written; an error as for
    ##   `write_all`
    ## @example
    ##     file.print_line($"total: {total}");
    ##     file.print_line((1, "two"));   # (1, two)
    print_line<T>(value: T): IoResult<void> {
        return write_all((to_string(value) + "\n").bytes());
    }
}
io/socket
50088
## TCP and UDP sockets: `TcpListener` accepts connections, `TcpStream` is
## one connection, `UdpSocket` sends and receives datagrams.
##
## Every call blocks the calling thread until it completes (in a task, it
## parks only the task), or until the socket's read or write timeout
## expires. Addresses are `SocketAddress` values; `resolve` turns a host
## name into them.

# The sockets call a private `_io_sys_socket_*` layer declared once per
# platform (socket_posix.pep, socket_windows.pep), as File does with
# `_io_sys_*`. The sockaddr encoding below is shared; only its header (the
# family field) differs per platform.

import async;
import "address";
import "socket_posix";
import "socket_wasi";
import "socket_windows";
import "sys_posix";
import "sys_windows";
import "types";
import "wait";

# The listen backlog: how many connections the system queues before
# `accept` takes them (the system may cap it lower).
_io_listen_backlog(): int {
    return 1024;
}

_io_socket_closed_error(): IoError {
    return IoError(_io_sys_code_bad_handle(), "socket is closed");
}

# ── sockaddr ─────────────────────────────────────────────────────────────────
# sockaddr_in: header @0, port (big-endian) @2, address @4; 16 bytes.
# sockaddr_in6: header @0, port @2, flow info @4, address @8, scope id @24;
# 28 bytes. The header is platform-specific (_io_sys_sockaddr_header).

# Bytes to allocate for any sockaddr (sizeof(struct sockaddr_storage)).
_io_sockaddr_capacity(): ulong {
    return 128;
}

# A sockaddr of any family in a buffer of its own, freed with the value:
# `_io_sockaddr_capacity()` zeroed bytes, then a 4-byte slot for the length
# a call writes back (a socklen_t, or an int on Windows).
struct _SockAddr {
    # The sockaddr's bytes, then the length slot.
    __ptr<u8> _bytes;
    # The sockaddr's length in bytes.
    int _length;

    construct() {
        _bytes = _pep_malloc(_io_sockaddr_capacity() + 4);
        _length = _io_sockaddr_capacity() as int;
    }

    destruct {
        _pep_free(_bytes);
    }

    # The length slot to pass to accept, recvfrom, getsockname or
    # getpeername, set to the capacity.
    _length_slot(): __ptr<uint> {
        var slot = unsafe_cast<__ptr<uint>>(_bytes + _io_sockaddr_capacity());
        slot[0] = _io_sockaddr_capacity() as uint;
        return slot;
    }

    # The address the system wrote (see `_io_sockaddr_read`).
    _read(): SocketAddress {
        return _io_sockaddr_read(_bytes);
    }
}

# `address` as a sockaddr.
_io_sockaddr_write(address: SocketAddress): _SockAddr {
    var sockaddr = _SockAddr();
    var buffer = sockaddr._bytes;
    var ip = address._address;
    var port = address._port as ulong;
    buffer[2] = ((port >> 8) & 255) as u8;
    buffer[3] = (port & 255) as u8;
    if (!ip._is_v6) {
        _io_sys_sockaddr_header(buffer, false, 16);
        ulong i = 0;
        while (i < 4) {
            buffer[4 + i] = ip._byte(12 + i) as u8;
            i = i + 1;
        }
        sockaddr._length = 16;
        return sockaddr;
    }
    _io_sys_sockaddr_header(buffer, true, 28);
    ulong j = 0;
    while (j < 16) {
        buffer[8 + j] = ip._byte(j) as u8;
        j = j + 1;
    }
    unsafe_cast<__ptr<uint>>(buffer + 24)[0] = ip._scope_id;
    sockaddr._length = 28;
    return sockaddr;
}

# The address in a sockaddr the system wrote; `0.0.0.0:0` for a family
# other than IPv4 and IPv6.
_io_sockaddr_read(buffer: __ptr<u8>): SocketAddress {
    var family = _io_sys_sockaddr_family(buffer);
    var port = ((buffer[2] as ulong) << 8) | (buffer[3] as ulong);
    var ip = IpAddress();
    if (family == 4) {
        ip._low = _io_big_endian(buffer + 4, 4);
    } else {
        if (family != 6) {
            return SocketAddress();
        }
        ip._is_v6 = true;
        ip._high = _io_big_endian(buffer + 8, 8);
        ip._low = _io_big_endian(buffer + 16, 8);
        ip._scope_id = unsafe_cast<__ptr<uint>>(buffer + 24)[0];
    }
    return SocketAddress(ip, port as u16);
}

# The `count` bytes at `p` as a big-endian number.
_io_big_endian(p: __ptr<u8>, count: ulong): ulong {
    ulong value = 0;
    ulong i = 0;
    while (i < count) {
        value = (value << 8) | (p[i] as ulong);
        i = i + 1;
    }
    return value;
}

# ── TcpListener ──────────────────────────────────────────────────────────────

## A TCP socket that listens for connections.
##
## `TcpListener.bind` opens one on a local address; each `accept()` waits for
## the next connection and returns it as a `TcpStream` together with the
## peer's address. Binding to port 0 lets the system choose a free port;
## `local_address()` tells which.
##
## On POSIX the listener sets `SO_REUSEADDR`, so a server can restart while
## connections from its previous run linger in `TIME_WAIT`. An IPv6 listener
## keeps the system's default for accepting IPv4 too (on Linux and macOS it
## does, on Windows it does not).
##
## Closing: the destructor closes the socket when the last reference goes;
## `close()` closes it earlier and reports errors. Every operation on a
## closed listener fails with an error no `IoError` predicate identifies
## (`EBADF` on POSIX, `ERROR_INVALID_HANDLE` on Windows).
##
## @example
##     import io;
##
##     var listener = io.TcpListener.bind(io.SocketAddress.parse("127.0.0.1:0").value()).value();
##     print(listener.local_address().value().to_string());   # 127.0.0.1:<port>
##     while (true) {
##         var (stream, peer) = listener.accept().value();
##         stream.write_all("hello " + peer.to_string());
##     }
## @see TcpStream
[NotCopyable("owns an operating-system socket and cannot be copied")]
export struct TcpListener {
    ## The socket: a descriptor on POSIX (-1 when closed), a `SOCKET` on
    ## Windows (`INVALID_SOCKET` when closed).
    SocketHandle _handle;

    ## Creates a closed listener: `is_open()` is false and every operation
    ## fails. Use `TcpListener.bind` to get an open one.
    construct() {
        _handle = _io_sys_socket_invalid();
    }

    ## Closes the socket if it is still open when the last reference goes.
    ## Errors are ignored; call `close()` to see them.
    destruct {
        _io_socket_close_taken(_handle);
    }

    ## Opens a TCP socket bound to `address` and starts listening on it.
    ##
    ## @param address the local address to listen on: a specific interface
    ##   (`127.0.0.1:8080`), every interface (`0.0.0.0:8080`, `[::]:8080`),
    ##   or port 0 for any free port
    ## @returns the listening socket; an error with `is_address_in_use()`
    ##   when another socket has the port, `is_address_not_available()` when
    ##   the address is not one of this machine's, `is_permission_denied()`
    ##   for a privileged port, or another platform error
    static bind(address: SocketAddress): IoResult<TcpListener> {
        var opened = _io_sys_socket_open(address.is_v6(), true);
        if (opened.is_err()) {
            return IoResult<TcpListener>.err(opened.error());
        }
        var listener = TcpListener();
        listener._handle = opened.value();
        var reuse = _io_sys_socket_set_reuse_address(listener._handle);
        if (reuse.is_err()) {
            return IoResult<TcpListener>.err(reuse.error());
        }
        var bound = _io_sys_socket_bind(listener._handle, address);
        if (bound.is_err()) {
            return IoResult<TcpListener>.err(bound.error());
        }
        var listening = _io_sys_socket_listen(listener._handle, _io_listen_backlog());
        if (listening.is_err()) {
            return IoResult<TcpListener>.err(listening.error());
        }
        return IoResult<TcpListener>.ok(listener);
    }

    ## Returns whether the listener is open.
    ##
    ## @returns false after `close()` and for a `TcpListener()` never bound
    is_open(): bool {
        return _io_sys_socket_valid(_handle);
    }

    ## Waits for the next incoming connection and returns it.
    ##
    ## @returns the connected stream and the peer's address; an error when
    ##   the listener is closed, or another platform error
    accept(): IoResult<(TcpStream, SocketAddress)> {
        return TcpStream._accepted(_io_listener_accept(_handle, false));
    }

    ## Returns an iterator that accepts connections one at a time, for a
    ## `for` loop over incoming streams.
    ##
    ## Each step waits in `accept()` and yields the connected stream, or the
    ## error `accept()` returned; an error does not end the iteration, so a
    ## server can log it and keep going, or `break`. The iteration ends once
    ## the listener is closed. Use `accept()` instead when the peer's address
    ## is needed.
    ##
    ## @returns a new `Incoming` positioned before the first connection
    ## @example
    ##     import io;
    ##
    ##     var listener = io.TcpListener.bind(io.SocketAddress.parse("127.0.0.1:8080").value()).value();
    ##     for (var connection in listener.incoming()) {
    ##         if (connection.is_err()) {
    ##             print(connection.error().message);
    ##             continue;
    ##         }
    ##         connection.value().write_all("hello");
    ##     }
    incoming(): Incoming {
        return Incoming(this);
    }

    ## Returns the address the listener is bound to, with the port the
    ## system chose when it was bound to port 0.
    ##
    ## @returns the local address; an error when the listener is closed, or
    ##   another platform error
    local_address(): IoResult<SocketAddress> {
        return _io_socket_local_address(_handle);
    }

    ## Closes the listener now. Closing a closed listener does nothing.
    ## Connections already accepted stay open.
    ##
    ## @returns an Ok result on success or when already closed; the platform
    ##   error when closing fails
    close(): IoResult<void> {
        var h = _handle;
        _handle = _io_sys_socket_invalid();
        return _io_socket_close_taken(h);
    }
}

## The iterator `TcpListener.incoming()` returns: each connection the
## listener accepts, as an `IoResult<TcpStream>`.
##
## `next()` waits for the next connection; an accept error is yielded as an
## item rather than ending the iteration. The iteration ends once the
## listener is closed. The iterator holds a reference to the listener, so
## the listener stays open while the iterator lives.
export struct Incoming {
    ## The listener to accept on.
    TcpListener _listener;
    ## Whether `_value` holds the item the last `next()` moved to.
    bool _has_value;
    ## The item the last `next()` moved to.
    IoResult<TcpStream> _value;

    ## Makes an iterator over the connections `listener` accepts.
    ##
    ## @param listener the listener to accept on
    construct(listener: TcpListener) {
        _listener = listener;
        _value = IoResult<TcpStream>.ok(TcpStream());
    }

    ## Waits for the next connection.
    ##
    ## @returns true with the connection or the accept error as the current
    ##   item; false once the listener is closed
    next(): bool {
        if (!_listener.is_open()) {
            _has_value = false;
            return false;
        }
        var accepted = _listener.accept();
        if (accepted.is_err()) {
            _value = IoResult<TcpStream>.err(accepted.error());
        } else {
            var (stream, peer) = accepted.value();
            _value = IoResult<TcpStream>.ok(stream);
        }
        _has_value = true;
        return true;
    }

    ## Returns the item the last successful `next()` moved to.
    ##
    ## @returns the accepted stream, or the error accepting it
    ## @panics if `next()` was never called or returned false ("Incoming.current() without a connection")
    current(): IoResult<TcpStream> {
        assert(_has_value, "Incoming.current() without a connection");
        return _value;
    }
}

extend Incoming with Iterator<IoResult<TcpStream>>;

## A TCP listening socket that any thread can accept connections on: the
## thread-safe counterpart of `TcpListener`, for servers that accept on every
## worker of `async.run` at once (see `async.spawn_on_each_worker`). Each
## connection goes to one of the threads waiting in `accept`, and the stream
## it returns belongs to that thread.
##
## A `shared` function may capture it. There is no `close()`, since another
## thread may be waiting on it: the socket closes when the last reference
## goes, which, for accept loops in tasks, is once `async.run` has cancelled
## them (`accept` then fails and the loop returns).
##
## @example
##     import async;
##     import io;
##
##     main(): int {
##         async.run(() => {
##             var listener = io.SharedTcpListener.bind(io.SocketAddress.parse("0.0.0.0:7000").value()).value();
##             async.spawn_on_each_worker(() => {
##                 while (true) {
##                     var accepted = listener.accept();
##                     if (accepted.is_err()) {
##                         return;
##                     }
##                     var (stream, peer) = accepted.value();
##                     stream.write_all("hello");
##                 }
##             });
##         });
##         return 0;
##     }
## @see TcpListener
[Shared]
export struct SharedTcpListener {
    # The socket (`SocketHandle` widened to `long`; -1 for none).
    const _handle: long;

    ## Wraps a listening socket. Use `SharedTcpListener.bind`.
    ##
    ## @param handle the listening socket, or an invalid handle for none
    construct(handle: SocketHandle) {
        _handle = handle as long;
    }

    ## Closes the socket when the last reference goes.
    destruct {
        _io_socket_close_taken(_handle as SocketHandle);
    }

    ## Opens a TCP socket bound to `address` and starts listening on it, as
    ## `TcpListener.bind` does.
    ##
    ## @param address the local address to listen on (port 0 for any free
    ##   port)
    ## @returns the listening socket, or the errors `TcpListener.bind`
    ##   returns
    static bind(address: SocketAddress): IoResult<SharedTcpListener> {
        var bound = TcpListener.bind(address);
        if (bound.is_err()) {
            return IoResult<SharedTcpListener>.err(bound.error());
        }
        var listener = bound.value();
        var h = listener._handle;
        listener._handle = _io_sys_socket_invalid();
        return IoResult<SharedTcpListener>.ok(SharedTcpListener(h));
    }

    ## Waits for the next incoming connection and returns it, as
    ## `TcpListener.accept` does. Several threads may wait at once; each
    ## connection wakes one of them (or, on some systems, several, and the
    ## rest keep waiting).
    ##
    ## @returns the connected stream, owned by the calling thread, and the
    ##   peer's address; an error when the waiting task is cancelled, or
    ##   another platform error
    accept(): IoResult<(TcpStream, SocketAddress)> {
        return TcpStream._accepted(_io_listener_accept(_handle as SocketHandle, true));
    }

    ## Returns the address the listener is bound to, with the port the
    ## system chose when it was bound to port 0.
    ##
    ## @returns the local address, or a platform error
    local_address(): IoResult<SocketAddress> {
        return _io_socket_local_address(_handle as SocketHandle);
    }
}

# ── TcpStream ────────────────────────────────────────────────────────────────

## A TCP connection: a reliable, ordered stream of bytes in both directions.
##
## Get one from `TcpStream.connect` (to an address), `TcpStream.connect_host`
## (to a host name) or `TcpListener.accept`. `read` appends what has arrived
## to a byte array and returns 0 once the peer has closed its side; `write`
## sends bytes.
##
## Each call is one system call and blocks until it can make progress: a
## `read` returns as soon as some bytes are there, not when `max` bytes are,
## and a `write` may send fewer bytes than given. `read_exact` and
## `write_all` loop until done. Sending never raises `SIGPIPE`; writing to a
## connection the peer has closed fails with `is_connection_reset()`.
##
## Closing: the destructor closes the socket when the last reference goes;
## `close()` closes it earlier and reports errors. Every operation on a
## closed stream fails with an error no `IoError` predicate identifies
## (`EBADF` on POSIX, `ERROR_INVALID_HANDLE` on Windows).
##
## @example
##     import io;
##
##     var stream = io.TcpStream.connect_host("example.com", 80).value();
##     stream.write_all("HEAD / HTTP/1.0\r\n\r\n");
##     var reply = Array<u8>();
##     while (stream.read(reply, 4096).value() > 0) {
##     }
## @see TcpListener
[NotCopyable("owns an operating-system socket and cannot be copied")]
export struct TcpStream {
    ## The socket: a descriptor on POSIX (-1 when closed), a `SOCKET` on
    ## Windows (`INVALID_SOCKET` when closed).
    SocketHandle _handle;

    ## Creates a closed stream: `is_open()` is false and every operation
    ## fails. Use `TcpStream.connect` or `TcpListener.accept` to get an open
    ## one.
    construct() {
        _handle = _io_sys_socket_invalid();
    }

    ## Closes the socket if it is still open when the last reference goes.
    ## Errors are ignored; call `close()` to see them.
    destruct {
        _io_socket_close_taken(_handle);
    }

    ## Opens a connection to `address`, waiting until it is established.
    ##
    ## @param address the address to connect to
    ## @returns the connected stream; an error with `is_connection_refused()`
    ##   when nothing listens there, `is_timed_out()` when the peer does not
    ##   answer, or another platform error
    static connect(address: SocketAddress): IoResult<TcpStream> {
        var opened = _io_sys_socket_open(address.is_v6(), true);
        if (opened.is_err()) {
            return IoResult<TcpStream>.err(opened.error());
        }
        var stream = TcpStream();
        stream._handle = opened.value();
        var connected = _io_sys_socket_connect(stream._handle, address);
        if (connected.is_err()) {
            return IoResult<TcpStream>.err(connected.error());
        }
        return IoResult<TcpStream>.ok(stream);
    }

    ## Opens a connection to `address` like `connect`, but gives up with
    ## `is_timed_out()` when it is not established within `milliseconds`,
    ## instead of after the system's own limit (often minutes).
    ##
    ## @param address the address to connect to
    ## @param milliseconds the longest wait, at most 4294967295 (about 49
    ##   days); 0 waits as long as `connect` does
    ## @returns the connected stream, with no read or write timeout; an error
    ##   with `is_timed_out()` when the time runs out, `is_invalid_input()`
    ##   when `milliseconds` is too large, or an error as for `connect`
    ## @example
    ##     var r = TcpStream.connect_timeout(SocketAddress.parse("192.0.2.1:80").value(), 2000);
    ##     if (r.is_err() && r.error().is_timed_out()) {
    ##         print("no answer within 2 seconds");
    ##     }
    static connect_timeout(address: SocketAddress, milliseconds: ulong): IoResult<TcpStream> {
        if (milliseconds > _IO_MAX_TIMEOUT) {
            var message = $"a socket timeout must be at most {_IO_MAX_TIMEOUT} milliseconds";
            return IoResult<TcpStream>.err(IoError(_io_sys_code_invalid_input(), message));
        }
        var opened = _io_sys_socket_open(address.is_v6(), true);
        if (opened.is_err()) {
            return IoResult<TcpStream>.err(opened.error());
        }
        var stream = TcpStream();
        stream._handle = opened.value();
        # A non-blocking connect waits until the socket is writable.
        _io_socket_set_timeout(stream._handle, _IO_WRITABLE, milliseconds);
        var connected = _io_sys_socket_connect(stream._handle, address);
        _io_socket_set_timeout(stream._handle, _IO_WRITABLE, 0);
        if (connected.is_err()) {
            return IoResult<TcpStream>.err(connected.error());
        }
        return IoResult<TcpStream>.ok(stream);
    }

    ## Resolves `host` with `resolve` and connects to the first of its
    ## addresses that accepts, trying them in order.
    ##
    ## @param host a host name or an IP address
    ## @param port the port to connect to
    ## @returns the connected stream; the error from `resolve` when the name
    ##   has no address, or the error from the last address tried
    ## @example
    ##     var r = TcpStream.connect_host("localhost", 8080);
    ##     if (r.is_err() && r.error().is_connection_refused()) {
    ##         print("nothing is listening on 8080");
    ##     }
    static connect_host(host: String, port: u16): IoResult<TcpStream> {
        var addresses = resolve(host, port);
        if (addresses.is_err()) {
            return IoResult<TcpStream>.err(addresses.error());
        }
        var last = IoResult<TcpStream>.err(IoError(_io_sys_code_not_found(), "no address found for '" + host + "'"));
        for (var address in addresses.value()) {
            var attempt = connect(address);
            if (attempt.is_ok()) {
                return attempt;
            }
            last = attempt;
        }
        return last;
    }

    ## Returns whether the stream is open.
    ##
    ## @returns false after `close()` and for a `TcpStream()` never connected
    is_open(): bool {
        return _io_sys_socket_valid(_handle);
    }

    ## Waits until data arrives, then appends up to `max` bytes of it to
    ## `buffer` with a single system call, like `File.read`.
    ##
    ## @param buffer the array the bytes are appended to
    ## @param max the most bytes to read; 0 reads nothing and returns 0
    ## @returns the number of bytes appended, 0 once the peer has closed its
    ##   side of the connection; an error with `is_connection_reset()` when
    ##   the connection was reset, an error when the stream is closed, or
    ##   another platform error
    ## @example
    ##     var buffer = Array<u8>();
    ##     var n = stream.read(buffer, 4096).value();   # buffer.count == n
    read(buffer: u8[], max: ulong): IoResult<ulong> {
        return _io_stream_read(_handle, buffer, max);
    }

    ## Reads until exactly `count` more bytes are appended to `buffer`.
    ##
    ## @param buffer the array the bytes are appended to
    ## @param count the number of bytes to read
    ## @returns an Ok result once `count` bytes are appended; an error when
    ##   the peer closes the connection first ("connection closed after n of
    ##   count bytes", code `EIO` on POSIX, `ERROR_HANDLE_EOF` on Windows,
    ##   which no predicate matches), or an error as for `read`. The bytes
    ##   read before an error stay in `buffer`.
    read_exact(buffer: u8[], count: ulong): IoResult<void> {
        return _io_stream_read_exact(_handle, buffer, count);
    }

    ## Sends bytes from `data` with a single system call, waiting until the
    ## system can take at least some of them.
    ##
    ## The send may be partial: it can send fewer than `data.count` bytes.
    ## Use `write_all` to send everything.
    ##
    ## @param data the bytes to send
    ## @returns the number of bytes sent, which may be less than
    ##   `data.count`; an error with `is_connection_reset()` when the peer
    ##   has closed or reset the connection, an error when the stream is
    ##   closed, or another platform error
    write(data: u8[]): IoResult<ulong> {
        return _io_stream_write(_handle, data);
    }

    ## Sends all of `data`, repeating the send until every byte is sent.
    ##
    ## If an error occurs part of `data` may already have been sent.
    ##
    ## @param data the bytes to send
    ## @returns an Ok result once every byte is sent; an error as for `write`
    write_all(data: u8[]): IoResult<void> {
        return _io_stream_write_all(_handle, data);
    }

    ## Sends all of the UTF-8 bytes of `text`, as `write_all(u8[])` does.
    ## No newline or terminator is added.
    ##
    ## @param text the text to send
    ## @returns an Ok result once every byte is sent; an error as for `write`
    ## @example
    ##     stream.write_all("ping");
    write_all(text: String): IoResult<void> {
        return _io_stream_write_string(_handle, text);
    }

    ## Deprecated: use `write_all` instead. Sends all of the UTF-8 bytes of
    ## `text`, exactly like `write_all(text)`.
    ##
    ## @param text the text to send
    ## @returns an Ok result once every byte is sent; an error as for `write_all`
    ## @see write_all
    [Deprecated("use 'write_all' instead", "write_all")]
    write_string(text: String): IoResult<void> {
        return write_all(text);
    }

    ## Closes the sending side of the connection: the peer's reads return 0
    ## once it has read everything sent before. This side can still read.
    ##
    ## @returns an Ok result on success; an error when the stream is closed,
    ##   or another platform error
    shutdown_write(): IoResult<void> {
        return _io_stream_shutdown_write(_handle);
    }

    ## Turns Nagle's algorithm off (`true`) or on (`false`) with
    ## `TCP_NODELAY`. With it off, small writes go out at once instead of
    ## being held back to combine with later ones: lower latency for
    ## request/response traffic, more packets.
    ##
    ## @param enabled true to send small writes immediately
    ## @returns an Ok result on success; an error when the stream is closed,
    ##   or another platform error
    set_no_delay(enabled: bool): IoResult<void> {
        var c = _io_socket_require_open(_handle);
        if (c.is_err()) {
            return c;
        }
        return _io_sys_socket_set_no_delay(_handle, enabled);
    }

    ## Limits how long a read waits: when no data arrives for
    ## `milliseconds`, the read fails with `is_timed_out()` and the stream
    ## stays open for another try. Each wait counts on its own, so a
    ## `read_exact` may take longer in all. 0, the default, waits as long as
    ## it takes. It works outside a task and in one, where the task's
    ## `async.timeout` can end the wait sooner.
    ##
    ## @param milliseconds the longest wait, at most 4294967295 (about 49
    ##   days); 0 for none
    ## @returns an Ok result; an error with `is_invalid_input()` when
    ##   `milliseconds` is too large, or an error when the stream is closed
    ## @example
    ##     stream.set_read_timeout(5000);   # give up after 5 seconds of silence
    set_read_timeout(milliseconds: ulong): IoResult<void> {
        return _io_socket_timeout_setter(_handle, _IO_READABLE, milliseconds);
    }

    ## Returns the read timeout `set_read_timeout` set.
    ##
    ## @returns the timeout in milliseconds, 0 for none
    read_timeout(): ulong {
        return _io_socket_timeout(_handle, _IO_READABLE);
    }

    ## Limits how long a write waits for the system to take more data: when
    ## it can take none for `milliseconds` (the peer is not reading), the
    ## write fails with `is_timed_out()`, possibly after sending part of the
    ## data. Each wait counts on its own. 0, the default, waits as long as
    ## it takes.
    ##
    ## @param milliseconds the longest wait, at most 4294967295 (about 49
    ##   days); 0 for none
    ## @returns an Ok result; an error with `is_invalid_input()` when
    ##   `milliseconds` is too large, or an error when the stream is closed
    set_write_timeout(milliseconds: ulong): IoResult<void> {
        return _io_socket_timeout_setter(_handle, _IO_WRITABLE, milliseconds);
    }

    ## Returns the write timeout `set_write_timeout` set.
    ##
    ## @returns the timeout in milliseconds, 0 for none
    write_timeout(): ulong {
        return _io_socket_timeout(_handle, _IO_WRITABLE);
    }

    ## Returns this side's address of the connection.
    ##
    ## @returns the local address; an error when the stream is closed, or
    ##   another platform error
    local_address(): IoResult<SocketAddress> {
        return _io_socket_local_address(_handle);
    }

    ## Returns the peer's address.
    ##
    ## @returns the peer's address; an error when the stream is closed, or
    ##   another platform error
    peer_address(): IoResult<SocketAddress> {
        return _io_socket_peer_address(_handle);
    }

    ## Moves the connection out of this stream, into a token another thread
    ## can take it from with `TcpStream.adopt`. The stream is closed
    ## afterwards (`is_open()` is false), and a task waiting on it on this
    ## worker wakes with an error.
    ##
    ## Inside `async.run` a socket belongs to the worker that uses it; this
    ## is how a task hands a connection to a task on another worker, such as
    ## one started with `async.spawn`.
    ##
    ## @returns the token; for a closed stream, one that `adopt` fails on
    ## @example
    ##     import async;
    ##     import io;
    ##
    ##     serve(listener: io.TcpListener) {
    ##         var (stream, peer) = listener.accept().value();
    ##         var transfer = stream.into_transfer();
    ##         async.spawn<void>(() => {
    ##             var mine = io.TcpStream.adopt(transfer).value();
    ##             mine.write_all("hello from another worker");
    ##         });
    ##     }
    into_transfer(): SocketTransfer {
        var h = _handle;
        _handle = _io_sys_socket_invalid();
        return _io_socket_transfer(h);
    }

    ## Takes the connection out of `transfer` (see `into_transfer`) into a
    ## new stream on the calling thread. Only the first `adopt` of a token
    ## gets the connection.
    ##
    ## @param transfer the token from `into_transfer`
    ## @returns the stream; an error when the token is empty (already
    ##   adopted, or made from a closed stream)
    static adopt(transfer: SocketTransfer): IoResult<TcpStream> {
        var h = _io_socket_adopt(transfer);
        if (h.is_err()) {
            return IoResult<TcpStream>.err(h.error());
        }
        return IoResult<TcpStream>.ok(_of(h.value()));
    }

    # A stream owning the open socket `h`.
    static _of(h: SocketHandle): TcpStream {
        var stream = TcpStream();
        stream._handle = h;
        return stream;
    }

    # What a listener's `accept` returns, for the socket it accepted.
    static _accepted(accepted: IoResult<(SocketHandle, SocketAddress)>): IoResult<(TcpStream, SocketAddress)> {
        if (accepted.is_err()) {
            return IoResult<(TcpStream, SocketAddress)>.err(accepted.error());
        }
        var (handle, peer) = accepted.value();
        return IoResult<(TcpStream, SocketAddress)>.ok((_of(handle), peer));
    }

    ## Closes the connection now. Closing a closed stream does nothing.
    ##
    ## @returns an Ok result on success or when already closed; the platform
    ##   error when closing fails
    close(): IoResult<void> {
        var h = _handle;
        _handle = _io_sys_socket_invalid();
        return _io_socket_close_taken(h);
    }
}

## A connection on its way from one thread to another: made by
## `TcpStream.into_transfer` (or `UnixStream.into_transfer`), taken by
## `TcpStream.adopt` (or `UnixStream.adopt`, for a Unix domain connection).
## Unlike a stream, it is thread-safe, so a `shared` function (a body for
## `async.spawn` or `Thread.spawn`) can capture it and a `Channel` can carry
## it. If no one adopts it, the connection is closed when the last
## reference goes.
[Shared]
export struct SocketTransfer {
    # The socket as a number (`SocketHandle` widened to `long`), or -1 once
    # taken; `INVALID_SOCKET` on Windows is -1 too.
    const _handle: async.Atomic<long>;

    ## Wraps a socket handle. `TcpStream.into_transfer` makes these; use it.
    ##
    ## @param handle the socket, or an invalid handle for an empty token
    construct(handle: SocketHandle) {
        _handle = async.Atomic<long>(handle as long);
    }

    ## Closes the connection if no one adopted it.
    destruct {
        var h = _take();
        if (_io_sys_socket_valid(h)) {
            _io_sys_socket_close(h);
        }
    }

    # Takes the handle out, leaving the token empty.
    _take(): SocketHandle {
        return _handle.exchange(-1) as SocketHandle;
    }
}

# ── Socket operations ────────────────────────────────────────────────────────
# The stream and listener types (here and in unix.pep) keep their socket in a
# `_handle` field and call these for the work, so each of their methods is a
# line. Each fails with `_io_socket_closed_error()` on a closed (invalid)
# handle.

# Ok for an open socket, the closed-socket error otherwise.
_io_socket_require_open(h: SocketHandle): IoResult<void> {
    if (!_io_sys_socket_valid(h)) {
        return IoResult<void>.err(_io_socket_closed_error());
    }
    return _io_ok_void();
}

# A stream's `read`.
_io_stream_read(h: SocketHandle, buffer: u8[], max: ulong): IoResult<ulong> {
    if (!_io_sys_socket_valid(h)) {
        return IoResult<ulong>.err(_io_socket_closed_error());
    }
    return _io_socket_read(h, buffer, max);
}

# A stream's `read_exact`.
_io_stream_read_exact(h: SocketHandle, buffer: u8[], count: ulong): IoResult<void> {
    var c = _io_socket_require_open(h);
    if (c.is_err()) {
        return c;
    }
    return _io_socket_read_exact(h, buffer, count);
}

# A stream's `write` (and a UDP socket's `send`): one send.
_io_stream_write(h: SocketHandle, data: u8[]): IoResult<ulong> {
    if (!_io_sys_socket_valid(h)) {
        return IoResult<ulong>.err(_io_socket_closed_error());
    }
    # Pinned: a send in a task may wait, and the kernel may be reading the
    # bytes meanwhile.
    data._pins = data._pins + 1;
    var r = _io_sys_socket_send(h, data._data, data._size);
    data._pins = data._pins - 1;
    return r;
}

# A stream's `write_all`.
_io_stream_write_all(h: SocketHandle, data: u8[]): IoResult<void> {
    var c = _io_socket_require_open(h);
    if (c.is_err()) {
        return c;
    }
    return _io_socket_send_bytes(h, data);
}

# A stream's `write_all(text)`.
_io_stream_write_string(h: SocketHandle, text: String): IoResult<void> {
    var c = _io_socket_require_open(h);
    if (c.is_err()) {
        return c;
    }
    return _io_socket_send_text(h, text);
}

# A stream's `shutdown_write`.
_io_stream_shutdown_write(h: SocketHandle): IoResult<void> {
    var c = _io_socket_require_open(h);
    if (c.is_err()) {
        return c;
    }
    return _io_sys_socket_shutdown(h, 1);
}

# A socket's `local_address`.
_io_socket_local_address(h: SocketHandle): IoResult<SocketAddress> {
    if (!_io_sys_socket_valid(h)) {
        return IoResult<SocketAddress>.err(_io_socket_closed_error());
    }
    return _io_sys_socket_local_address(h);
}

# A socket's `peer_address`.
_io_socket_peer_address(h: SocketHandle): IoResult<SocketAddress> {
    if (!_io_sys_socket_valid(h)) {
        return IoResult<SocketAddress>.err(_io_socket_closed_error());
    }
    return _io_sys_socket_peer_address(h);
}

# Closes `h`, which its owner no longer holds (a `close()`, or a
# destructor); Ok for an invalid handle.
_io_socket_close_taken(h: SocketHandle): IoResult<void> {
    if (!_io_sys_socket_valid(h)) {
        return _io_ok_void();
    }
    return _io_sys_socket_close(h);
}

# A stream's `into_transfer`, for `h`, which the stream no longer holds.
_io_socket_transfer(h: SocketHandle): SocketTransfer {
    if (_io_sys_socket_valid(h)) {
        _io_socket_release(h);
    }
    return SocketTransfer(h);
}

# The socket a stream's `adopt` takes out of `transfer`.
_io_socket_adopt(transfer: SocketTransfer): IoResult<SocketHandle> {
    var h = transfer._take();
    if (!_io_sys_socket_valid(h)) {
        return IoResult<SocketHandle>.err(_io_socket_closed_error());
    }
    return IoResult<SocketHandle>.ok(h);
}

# A listener's `accept`: the accepted socket and the peer's address.
# `shared` for a listener other threads may close once this one stops
# using it (`SharedTcpListener`, `SharedUnixListener`).
_io_listener_accept(h: SocketHandle, shared: bool): IoResult<(SocketHandle, SocketAddress)> {
    if (!_io_sys_socket_valid(h)) {
        return IoResult<(SocketHandle, SocketAddress)>.err(_io_socket_closed_error());
    }
    var accepted = _io_sys_socket_accept(h);
    if (shared) {
        _io_socket_release_idle(h);
    }
    return accepted;
}

# Appends up to `max` bytes received on `h` to `buffer` (a stream socket's
# `read`).
_io_socket_read(h: SocketHandle, buffer: u8[], max: ulong): IoResult<ulong> {
    if (max == 0) {
        return IoResult<ulong>.ok(0);
    }
    buffer.reserve(buffer._size + max);
    # Pinned: a receive in a task may wait, and the kernel may be writing
    # into the array meanwhile.
    buffer._pins = buffer._pins + 1;
    var r = _io_sys_socket_receive(h, buffer._data + buffer._size, max);
    buffer._pins = buffer._pins - 1;
    if (r.is_ok()) {
        buffer._size = buffer._size + r.value();
    }
    return r;
}

# Reads from `h` until `count` more bytes are appended to `buffer` (a stream
# socket's `read_exact`).
_io_socket_read_exact(h: SocketHandle, buffer: u8[], count: ulong): IoResult<void> {
    ulong done = 0;
    while (done < count) {
        var r = _io_socket_read(h, buffer, count - done);
        if (r.is_err()) {
            return IoResult<void>.err(r.error());
        }
        if (r.value() == 0) {
            var message = $"connection closed after {done} of {count} bytes";
            return IoResult<void>.err(IoError(_io_sys_code_unexpected_end(), message));
        }
        done = done + r.value();
    }
    return _io_ok_void();
}

# Sends all of `data`, pinned so no other task can grow it while a send
# waits.
_io_socket_send_bytes(h: SocketHandle, data: u8[]): IoResult<void> {
    data._pins = data._pins + 1;
    var r = _io_socket_send_all(h, data._data, data._size);
    data._pins = data._pins - 1;
    return r;
}

# Sends all of `text`'s bytes. Inside a task a send can wait, and another
# task could change `text` meanwhile, so a copy is sent, as
# `File.write_all` does.
_io_socket_send_text(h: SocketHandle, text: String): IoResult<void> {
    if (!_io_in_task()) {
        return _io_socket_send_all(h, unsafe_cast<__ptr<u8>>(text.c_str()), text.size);
    }
    var bytes = _io_text_copy(text);
    var r = _io_socket_send_all(h, bytes, text.size);
    _pep_free(bytes);
    return r;
}

# Sends all `n` bytes at `p`, looping over partial sends.
export _io_socket_send_all(h: SocketHandle, p: __ptr<u8>, n: ulong): IoResult<void> {
    ulong done = 0;
    while (done < n) {
        var r = _io_sys_socket_send(h, p + done, n - done);
        if (r.is_err()) {
            return IoResult<void>.err(r.error());
        }
        if (r.value() == 0) {
            return IoResult<void>.err(IoError(_io_sys_code_write_zero(), "failed to write the whole buffer"));
        }
        done = done + r.value();
    }
    return _io_ok_void();
}

# ── UdpSocket ────────────────────────────────────────────────────────────────

## A UDP socket: sends and receives datagrams, each delivered whole or not at
## all, in no guaranteed order.
##
## `UdpSocket.bind` opens one on a local address (port 0 for any free port).
## `send_to` and `receive_from` name the peer on each call; after `connect`,
## `send` and `receive` use the connected peer and ignore datagrams from
## anyone else.
##
## Each receive takes one datagram. A datagram longer than `max` is
## truncated to `max` bytes and the rest is lost, so size `max` for the
## largest datagram expected (at most 65507 bytes over IPv4).
##
## Closing: the destructor closes the socket when the last reference goes;
## `close()` closes it earlier and reports errors.
##
## @example
##     import io;
##
##     var socket = io.UdpSocket.bind(io.SocketAddress.parse("0.0.0.0:9000").value()).value();
##     var buffer = Array<u8>();
##     var (n, from) = socket.receive_from(buffer, 65507).value();
##     socket.send_to(buffer, from);   # echo it back
[NotCopyable("owns an operating-system socket and cannot be copied")]
export struct UdpSocket {
    ## The socket: a descriptor on POSIX (-1 when closed), a `SOCKET` on
    ## Windows (`INVALID_SOCKET` when closed).
    SocketHandle _handle;

    ## Creates a closed socket: `is_open()` is false and every operation
    ## fails. Use `UdpSocket.bind` to get an open one.
    construct() {
        _handle = _io_sys_socket_invalid();
    }

    ## Closes the socket if it is still open when the last reference goes.
    ## Errors are ignored; call `close()` to see them.
    destruct {
        _io_socket_close_taken(_handle);
    }

    ## Opens a UDP socket bound to `address`.
    ##
    ## @param address the local address to receive on; port 0 for any free
    ##   port
    ## @returns the bound socket; an error with `is_address_in_use()` when
    ##   another socket has the port, `is_address_not_available()` when the
    ##   address is not one of this machine's, or another platform error
    static bind(address: SocketAddress): IoResult<UdpSocket> {
        var opened = _io_sys_socket_open(address.is_v6(), false);
        if (opened.is_err()) {
            return IoResult<UdpSocket>.err(opened.error());
        }
        var socket = UdpSocket();
        socket._handle = opened.value();
        var bound = _io_sys_socket_bind(socket._handle, address);
        if (bound.is_err()) {
            return IoResult<UdpSocket>.err(bound.error());
        }
        return IoResult<UdpSocket>.ok(socket);
    }

    ## Returns whether the socket is open.
    ##
    ## @returns false after `close()` and for a `UdpSocket()` never bound
    is_open(): bool {
        return _io_sys_socket_valid(_handle);
    }

    ## Sends `data` as one datagram to `address`.
    ##
    ## @param data the datagram's bytes
    ## @param address where to send it
    ## @returns the number of bytes sent (all of `data`); an error when the
    ##   datagram is too large, when the socket is closed, or another
    ##   platform error
    send_to(data: u8[], address: SocketAddress): IoResult<ulong> {
        var c = _io_socket_require_open(_handle);
        if (c.is_err()) {
            return IoResult<ulong>.err(c.error());
        }
        return _io_sys_socket_send_to(_handle, data._data, data._size, address);
    }

    ## Waits for the next datagram and appends up to `max` of its bytes to
    ## `buffer`.
    ##
    ## @param buffer the array the bytes are appended to
    ## @param max the most bytes to keep; the rest of a longer datagram is
    ##   lost. 0 reads nothing and returns at once.
    ## @returns the number of bytes appended and the sender's address; an
    ##   error when the socket is closed, or another platform error
    receive_from(buffer: u8[], max: ulong): IoResult<(ulong, SocketAddress)> {
        var c = _io_socket_require_open(_handle);
        if (c.is_err()) {
            return IoResult<(ulong, SocketAddress)>.err(c.error());
        }
        if (max == 0) {
            return IoResult<(ulong, SocketAddress)>.ok((0 as ulong, SocketAddress()));
        }
        buffer.reserve(buffer._size + max);
        var r = _io_sys_socket_receive_from(_handle, buffer._data + buffer._size, max);
        if (r.is_ok()) {
            buffer._size = buffer._size + r.value().0;
        }
        return r;
    }

    ## Sets the socket's default peer: `send` goes to `address`, and
    ## `receive` and `receive_from` only take datagrams from it. No packet is
    ## sent.
    ##
    ## @param address the peer
    ## @returns an Ok result on success; an error when the socket is closed,
    ##   or another platform error
    connect(address: SocketAddress): IoResult<void> {
        var c = _io_socket_require_open(_handle);
        if (c.is_err()) {
            return c;
        }
        return _io_sys_socket_connect(_handle, address);
    }

    ## Sends `data` as one datagram to the connected peer.
    ##
    ## @param data the datagram's bytes
    ## @returns the number of bytes sent; an error when the socket is not
    ##   connected or is closed, or another platform error
    send(data: u8[]): IoResult<ulong> {
        return _io_stream_write(_handle, data);
    }

    ## Waits for the next datagram from the connected peer and appends up to
    ## `max` of its bytes to `buffer`.
    ##
    ## @param buffer the array the bytes are appended to
    ## @param max the most bytes to keep; the rest of a longer datagram is
    ##   lost. 0 reads nothing and returns at once.
    ## @returns the number of bytes appended; an error when the socket is
    ##   closed, or another platform error
    receive(buffer: u8[], max: ulong): IoResult<ulong> {
        var r = receive_from(buffer, max);
        if (r.is_err()) {
            return IoResult<ulong>.err(r.error());
        }
        return IoResult<ulong>.ok(r.value().0);
    }

    ## Allows (`true`) or forbids (`false`) sending to a broadcast address
    ## such as `255.255.255.255` (`SO_BROADCAST`).
    ##
    ## @param enabled true to allow broadcasts
    ## @returns an Ok result on success; an error when the socket is closed,
    ##   or another platform error
    set_broadcast(enabled: bool): IoResult<void> {
        var c = _io_socket_require_open(_handle);
        if (c.is_err()) {
            return c;
        }
        return _io_sys_socket_set_broadcast(_handle, enabled);
    }

    ## Limits how long a receive waits: when no datagram arrives for
    ## `milliseconds`, `receive` or `receive_from` fails with
    ## `is_timed_out()` and the socket stays open for another try. 0, the
    ## default, waits as long as it takes. It works outside a task and in
    ## one, where the task's `async.timeout` can end the wait sooner.
    ##
    ## @param milliseconds the longest wait, at most 4294967295 (about 49
    ##   days); 0 for none
    ## @returns an Ok result; an error with `is_invalid_input()` when
    ##   `milliseconds` is too large, or an error when the socket is closed
    ## @example
    ##     socket.set_read_timeout(5000);   # give up after 5 seconds of silence
    set_read_timeout(milliseconds: ulong): IoResult<void> {
        return _io_socket_timeout_setter(_handle, _IO_READABLE, milliseconds);
    }

    ## Returns the read timeout `set_read_timeout` set.
    ##
    ## @returns the timeout in milliseconds, 0 for none
    read_timeout(): ulong {
        return _io_socket_timeout(_handle, _IO_READABLE);
    }

    ## Limits how long a send waits for room in the system's buffer: when
    ## there is none for `milliseconds`, the send fails with
    ## `is_timed_out()`. 0, the default, waits as long as it takes.
    ##
    ## @param milliseconds the longest wait, at most 4294967295 (about 49
    ##   days); 0 for none
    ## @returns an Ok result; an error with `is_invalid_input()` when
    ##   `milliseconds` is too large, or an error when the socket is closed
    set_write_timeout(milliseconds: ulong): IoResult<void> {
        return _io_socket_timeout_setter(_handle, _IO_WRITABLE, milliseconds);
    }

    ## Returns the write timeout `set_write_timeout` set.
    ##
    ## @returns the timeout in milliseconds, 0 for none
    write_timeout(): ulong {
        return _io_socket_timeout(_handle, _IO_WRITABLE);
    }

    ## Returns the address the socket is bound to, with the port the system
    ## chose when it was bound to port 0.
    ##
    ## @returns the local address; an error when the socket is closed, or
    ##   another platform error
    local_address(): IoResult<SocketAddress> {
        return _io_socket_local_address(_handle);
    }

    ## Returns the connected peer's address.
    ##
    ## @returns the peer's address; an error when the socket is not
    ##   connected or is closed, or another platform error
    peer_address(): IoResult<SocketAddress> {
        return _io_socket_peer_address(_handle);
    }

    ## Closes the socket now. Closing a closed socket does nothing.
    ##
    ## @returns an Ok result on success or when already closed; the platform
    ##   error when closing fails
    close(): IoResult<void> {
        var h = _handle;
        _handle = _io_sys_socket_invalid();
        return _io_socket_close_taken(h);
    }
}
io/socket_posix
25259
# POSIX (Linux, macOS) socket layer for io. Every declaration carries
# [Target(OS(Linux) || OS(Mac))] or a narrower target; socket_windows.pep
# and socket_wasi.pep declare the same `_io_sys_*` socket functions with the
# same signatures for Windows and WASI. Like sys_posix.pep, these are
# exported to the other io files only.
#
# Linux and macOS differ in the socket option numbers, the AF_INET6 value,
# the sockaddr header (a 16-bit family on Linux, a length byte and a family
# byte on macOS), the addrinfo field order, and how close-on-exec and
# SIGPIPE are handled: Linux passes SOCK_CLOEXEC and MSG_NOSIGNAL, macOS sets
# FD_CLOEXEC and SO_NOSIGPIPE on each new socket.

import "address";
import "socket";
import "sys_posix";
import "types";
import "wait";

# ── C functions ──────────────────────────────────────────────────────────────

[Target(OS(Linux) || OS(Mac))]
extern int socket(int domain, int kind, int protocol);
[Target(OS(Linux) || OS(Mac))]
extern int bind(int fd, void* address, uint length);
[Target(OS(Linux) || OS(Mac))]
extern int listen(int fd, int backlog);
[Target(OS(Linux) || OS(Mac))]
extern int connect(int fd, void* address, uint length);
[Target(OS(Linux) || OS(Mac))]
extern long recv(int fd, void* buffer, ulong length, int flags);
[Target(OS(Linux) || OS(Mac))]
extern long send(int fd, void* buffer, ulong length, int flags);
[Target(OS(Linux) || OS(Mac))]
extern long recvfrom(int fd, void* buffer, ulong length, int flags, void* address, uint* address_length);
[Target(OS(Linux) || OS(Mac))]
extern long sendto(int fd, void* buffer, ulong length, int flags, void* address, uint address_length);
[Target(OS(Linux) || OS(Mac))]
extern int shutdown(int fd, int how);
[Target(OS(Linux) || OS(Mac))]
extern int socketpair(int domain, int kind, int protocol, int* descriptors);
[Target(OS(Linux) || OS(Mac))]
extern int getsockopt(int fd, int level, int name, void* value, uint* length);
[Target(OS(Linux) || OS(Mac))]
extern int poll(void* descriptors, ulong count, int timeout);
[Target(OS(Linux) || OS(Mac))]
extern int setsockopt(int fd, int level, int name, void* value, uint length);
[Target(OS(Linux) || OS(Mac))]
extern int getsockname(int fd, void* address, uint* length);
[Target(OS(Linux) || OS(Mac))]
extern int getpeername(int fd, void* address, uint* length);
[Target(OS(Linux) || OS(Mac))]
extern int getaddrinfo(char* node, char* service, void* hints, void* result);
[Target(OS(Linux) || OS(Mac))]
extern void freeaddrinfo(void* list);
[Target(OS(Linux) || OS(Mac))]
extern char* gai_strerror(int code);
[Target(OS(Linux))]
extern int accept4(int fd, void* address, uint* length, int flags);
[Target(OS(Mac))]
extern int accept(int fd, void* address, uint* length);
[Target(OS(Mac))]
extern int fcntl(int fd, int command, ...);
[Target(OS(Linux) || OS(Mac))]
extern uint if_nametoindex(char* name);
[Target(OS(Linux) || OS(Mac))]
extern char* if_indextoname(uint index, void* name);

# ── Constants ────────────────────────────────────────────────────────────────

[Target(OS(Linux) || OS(Mac))]
_io_af_inet(): int { return 2; }

[Target(OS(Linux))]
_io_af_inet6(): int { return 10; }

[Target(OS(Mac))]
_io_af_inet6(): int { return 30; }

[Target(OS(Linux))]
_io_sol_socket(): int { return 1; }

[Target(OS(Mac))]
_io_sol_socket(): int {
    return 65535;
}  # 0xffff

[Target(OS(Linux))]
_io_so_reuseaddr(): int { return 2; }

[Target(OS(Mac))]
_io_so_reuseaddr(): int { return 4; }

[Target(OS(Linux))]
_io_so_broadcast(): int { return 6; }

[Target(OS(Mac))]
_io_so_broadcast(): int {
    return 32;
}  # 0x20

[Target(OS(Linux))]
_io_sock_cloexec(): int {
    return 526336;
}  # SOCK_CLOEXEC | SOCK_NONBLOCK, or'ed into the type

[Target(OS(Mac))]
_io_sock_cloexec(): int {
    return 0;
}  # none: fcntl instead

[Target(OS(Linux))]
_io_so_error(): int { return 4; }

[Target(OS(Mac))]
_io_so_error(): int {
    return 4103;
}  # 0x1007

[Target(OS(Linux))]
_io_msg_nosignal(): int {
    return 16384;
}  # 0x4000

[Target(OS(Mac))]
_io_msg_nosignal(): int {
    return 0;
}  # none: SO_NOSIGPIPE instead

# ── Errors ───────────────────────────────────────────────────────────────────

[Target(OS(Linux))]
_io_sys_code_timed_out(): ErrorCode {
    return 110;
}  # ETIMEDOUT

[Target(OS(Mac))]
_io_sys_code_timed_out(): ErrorCode { return 60; }

# EAGAIN (the same value as EWOULDBLOCK): a non-blocking call would block.
[Target(OS(Linux))]
_io_posix_would_block(code: ErrorCode): bool { return code == 11; }

[Target(OS(Mac))]
_io_posix_would_block(code: ErrorCode): bool { return code == 35; }

# EINPROGRESS: a non-blocking connect has started.
[Target(OS(Linux))]
_io_posix_in_progress(code: ErrorCode): bool { return code == 115; }

[Target(OS(Mac))]
_io_posix_in_progress(code: ErrorCode): bool { return code == 36; }

# Code for a stream that ended before the bytes asked for: EIO.
[Target(OS(Linux) || OS(Mac))]
_io_sys_code_unexpected_end(): ErrorCode { return 5; }

# getaddrinfo's EAI_NONAME and EAI_NODATA: the name has no address. Bionic
# numbers them as macOS does.
[Target(OS(Linux) && !OS(Android))]
_io_eai_no_address(code: int): bool { return code == -2 || code == -5; }

[Target(OS(Mac) || OS(Android))]
_io_eai_no_address(code: int): bool { return code == 8 || code == 7; }

# EAI_SYSTEM: the reason is in errno.
[Target(OS(Linux) && !OS(Android))]
_io_eai_system(code: int): bool { return code == -11; }

[Target(OS(Mac) || OS(Android))]
_io_eai_system(code: int): bool { return code == 11; }

# The socket call's result: -1 means failure with the reason in errno.
[Target(OS(Linux) || OS(Mac))]
_io_socket_check(rc: int): IoResult<void> {
    return _io_posix_check(rc);
}

# ── Handles ──────────────────────────────────────────────────────────────────

[Target(OS(Linux) || OS(Mac))]
_io_sys_socket_invalid(): SocketHandle {
    return -1;
}

[Target(OS(Linux) || OS(Mac))]
_io_sys_socket_valid(h: SocketHandle): bool {
    return h >= 0;
}

[Target(OS(Linux) || OS(Mac))]
_io_sys_socket_close(h: SocketHandle): IoResult<void> {
    _io_socket_forget(h);
    return _io_sys_close(h);
}

# ── sockaddr ─────────────────────────────────────────────────────────────────

# The header of a sockaddr_in / sockaddr_in6: Linux has a 16-bit family at 0;
# macOS a length byte at 0 and a family byte at 1.
[Target(OS(Linux))]
_io_sys_sockaddr_header(buffer: __ptr<u8>, v6: bool, length: int) {
    var family = _io_af_inet();
    if (v6) {
        family = _io_af_inet6();
    }
    unsafe_cast<__ptr<u16>>(buffer)[0] = family as u16;
}

[Target(OS(Mac))]
_io_sys_sockaddr_header(buffer: __ptr<u8>, v6: bool, length: int) {
    var family = _io_af_inet();
    if (v6) {
        family = _io_af_inet6();
    }
    buffer[0] = length as u8;
    buffer[1] = family as u8;
}

# 4 for IPv4, 6 for IPv6, 0 for any other family.
[Target(OS(Linux))]
_io_sys_sockaddr_family(buffer: __ptr<u8>): int {
    var family = unsafe_cast<__ptr<u16>>(buffer)[0] as int;
    if (family == _io_af_inet()) {
        return 4;
    }
    if (family == _io_af_inet6()) {
        return 6;
    }
    return 0;
}

[Target(OS(Mac))]
_io_sys_sockaddr_family(buffer: __ptr<u8>): int {
    var family = buffer[1] as int;
    if (family == _io_af_inet()) {
        return 4;
    }
    if (family == _io_af_inet6()) {
        return 6;
    }
    return 0;
}

# sockaddr_un: the header as for sockaddr_in (family AF_UNIX, 1), then the
# path, NUL-terminated, at 2: at most 108 bytes on Linux, 104 on macOS.
[Target(OS(Linux))]
_io_sys_sockaddr_unix_header(buffer: __ptr<u8>, length: int) {
    unsafe_cast<__ptr<u16>>(buffer)[0] = 1;
}

[Target(OS(Mac))]
_io_sys_sockaddr_unix_header(buffer: __ptr<u8>, length: int) {
    buffer[0] = length as u8;
    buffer[1] = 1;
}

[Target(OS(Linux))]
_io_sys_unix_path_capacity(): ulong { return 108; }

[Target(OS(Mac))]
_io_sys_unix_path_capacity(): ulong { return 104; }

# ── Socket calls ─────────────────────────────────────────────────────────────

# A new non-blocking, close-on-exec socket (SOCK_STREAM 1 or SOCK_DGRAM 2)
# that never raises SIGPIPE. Every socket is non-blocking: a call that would
# block waits in `_io_socket_wait` and tries again.
[Target(OS(Linux) || OS(Mac))]
_io_sys_socket_open(v6: bool, stream: bool): IoResult<SocketHandle> {
    var family = _io_af_inet();
    if (v6) {
        family = _io_af_inet6();
    }
    var kind = 2;
    if (stream) {
        kind = 1;
    }
    var fd = socket(family, kind | _io_sock_cloexec(), 0);
    if (fd < 0) {
        return IoResult<SocketHandle>.err(IoError.last());
    }
    _io_posix_socket_setup(fd);
    return IoResult<SocketHandle>.ok(fd);
}

# A new non-blocking, close-on-exec Unix domain stream socket (AF_UNIX 1,
# SOCK_STREAM 1) that never raises SIGPIPE.
[Target(OS(Linux) || OS(Mac))]
_io_sys_socket_open_unix(): IoResult<SocketHandle> {
    var fd = socket(1, 1 | _io_sock_cloexec(), 0);
    if (fd < 0) {
        return IoResult<SocketHandle>.err(IoError.last());
    }
    _io_posix_socket_setup(fd);
    return IoResult<SocketHandle>.ok(fd);
}

# A new non-blocking, close-on-exec Unix domain datagram socket (AF_UNIX 1,
# SOCK_DGRAM 2).
[Target(OS(Linux) || OS(Mac))]
_io_sys_socket_open_unix_datagram(): IoResult<SocketHandle> {
    var fd = socket(1, 2 | _io_sock_cloexec(), 0);
    if (fd < 0) {
        return IoResult<SocketHandle>.err(IoError.last());
    }
    _io_posix_socket_setup(fd);
    return IoResult<SocketHandle>.ok(fd);
}

# Two connected Unix domain datagram sockets (socketpair(2)), each set up
# like `_io_sys_socket_open_unix_datagram`'s.
[Target(OS(Linux) || OS(Mac))]
_io_sys_socket_pair_unix_datagram(): IoResult<(SocketHandle, SocketHandle)> {
    var buffer = _IoBuffer(8);
    var descriptors = unsafe_cast<__ptr<int>>(buffer._bytes);
    if (socketpair(1, 2 | _io_sock_cloexec(), 0, descriptors) != 0) {
        return IoResult<(SocketHandle, SocketHandle)>.err(IoError.last());
    }
    _io_posix_socket_setup(descriptors[0]);
    _io_posix_socket_setup(descriptors[1]);
    return IoResult<(SocketHandle, SocketHandle)>.ok((descriptors[0], descriptors[1]));
}

# macOS: close-on-exec, non-blocking and SO_NOSIGPIPE, which Linux gets
# from the type and send flags.
[Target(OS(Linux))]
_io_posix_socket_setup(fd: int) {}

[Target(OS(Mac))]
_io_posix_socket_setup(fd: int) {
    fcntl(fd, 2, 1);                               # F_SETFD, FD_CLOEXEC
    fcntl(fd, 4, 4);                               # F_SETFL, O_NONBLOCK
    _io_posix_set_int_option(fd, 65535, 4130, 1);  # SOL_SOCKET, SO_NOSIGPIPE (0x1022)
}

[Target(OS(Linux) || OS(Mac))]
_io_posix_set_int_option(fd: int, level: int, name: int, value: int): IoResult<void> {
    var slot = _pep_malloc(4) as __ptr<int>;
    slot[0] = value;
    var rc = setsockopt(fd, level, name, slot, 4);
    var result = _io_socket_check(rc);
    _pep_free(slot);
    return result;
}

[Target(OS(Linux) || OS(Mac))]
_io_sys_socket_set_reuse_address(h: SocketHandle): IoResult<void> {
    return _io_posix_set_int_option(h, _io_sol_socket(), _io_so_reuseaddr(), 1);
}

[Target(OS(Linux) || OS(Mac))]
_io_sys_socket_set_no_delay(h: SocketHandle, enabled: bool): IoResult<void> {
    return _io_posix_set_int_option(h, 6, 1, enabled ? 1 : 0);  # IPPROTO_TCP, TCP_NODELAY
}

[Target(OS(Linux) || OS(Mac))]
_io_sys_socket_set_broadcast(h: SocketHandle, enabled: bool): IoResult<void> {
    return _io_posix_set_int_option(h, _io_sol_socket(), _io_so_broadcast(), enabled ? 1 : 0);
}

[Target(OS(Linux) || OS(Mac))]
_io_sys_socket_bind(h: SocketHandle, address: SocketAddress): IoResult<void> {
    var sockaddr = _io_sockaddr_write(address);
    return _io_sys_socket_bind_raw(h, sockaddr._bytes, sockaddr._length);
}

# Binds `h` to the `length`-byte sockaddr at `buffer`, of any family.
[Target(OS(Linux) || OS(Mac))]
_io_sys_socket_bind_raw(h: SocketHandle, buffer: __ptr<u8>, length: int): IoResult<void> {
    return _io_socket_check(bind(h, buffer, length as uint));
}

[Target(OS(Linux) || OS(Mac))]
_io_sys_socket_listen(h: SocketHandle, backlog: int): IoResult<void> {
    return _io_socket_check(listen(h, backlog));
}

# A non-blocking connect returns EINPROGRESS (or EINTR, after which the
# connection carries on too); it has finished when the socket is writable,
# and SO_ERROR says how.
[Target(OS(Linux) || OS(Mac))]
_io_sys_socket_connect(h: SocketHandle, address: SocketAddress): IoResult<void> {
    var sockaddr = _io_sockaddr_write(address);
    return _io_sys_socket_connect_raw(h, sockaddr._bytes, sockaddr._length);
}

# Connects `h` to the `length`-byte sockaddr at `buffer`, of any family.
[Target(OS(Linux) || OS(Mac))]
_io_sys_socket_connect_raw(h: SocketHandle, buffer: __ptr<u8>, length: int): IoResult<void> {
    var rc = connect(h, buffer, length as uint);
    if (rc == 0) {
        return _io_ok_void();
    }
    var e = IoError.last();
    if (!_io_posix_in_progress(e.code) && !e.is_interrupted()) {
        return IoResult<void>.err(e);
    }
    var waited = _io_socket_wait(h, _IO_WRITABLE);
    if (waited.is_err()) {
        return waited;
    }
    var slot = _pep_malloc(8) as __ptr<int>;
    var size = unsafe_cast<__ptr<uint>>(slot + 1);
    slot[0] = 0;
    size[0] = 4;
    var got = getsockopt(h, _io_sol_socket(), _io_so_error(), slot, size);
    var code = slot[0];
    _pep_free(slot);
    if (got != 0) {
        return _io_posix_err_none();
    }
    if (code != 0) {
        return IoResult<void>.err(IoError(code, _io_sys_error_message(code)));
    }
    return _io_ok_void();
}

# Blocks the thread until `h` is ready for `interest` (poll(2)), or fails
# when `timeout` milliseconds (0 for none) pass first.
[Target(OS(Linux) || OS(Mac))]
_io_sys_socket_poll(h: SocketHandle, interest: int, timeout: ulong): IoResult<void> {
    var buffer = _IoBuffer(8);
    var descriptor = unsafe_cast<__ptr<int>>(buffer._bytes);
    var events = unsafe_cast<__ptr<u16>>(buffer._bytes);
    descriptor[0] = h;
    events[2] = 1;  # POLLIN
    if (interest == _IO_WRITABLE) {
        events[2] = 4;  # POLLOUT
    }
    events[3] = 0;
    var wait = _io_poll_timeout(timeout);
    while (true) {
        var rc = poll(descriptor, 1, wait);
        if (rc > 0) {
            return _io_ok_void();
        }
        if (rc == 0) {
            # A signal ends the wait early; this starts it over.
            if (wait >= 0) {
                return IoResult<void>.err(_io_timed_out_error());
            }
            continue;
        }
        var e = IoError.last();
        if (!e.is_interrupted()) {
            return IoResult<void>.err(e);
        }
    }
    return _io_ok_void();
}

# After a failed call with error `code`: waits for `interest` when the call
# would block, and succeeds when the call should be tried again (it would
# have blocked, or a signal interrupted it); otherwise fails with the error
# to return. The error's message is looked up only then, since would-block
# is the common case.
[Target(OS(Linux) || OS(Mac))]
_io_posix_retry(h: SocketHandle, code: ErrorCode, interest: int): IoResult<void> {
    if (_io_posix_would_block(code)) {
        return _io_socket_wait(h, interest);
    }
    if (_io_sys_error_kind(code) == ErrorKind.Interrupted) {
        return _io_ok_void();
    }
    return IoResult<void>.err(IoError(code, _io_sys_error_message(code)));
}

# The accepted socket is non-blocking and close-on-exec like the others.
[Target(OS(Linux))]
_io_posix_accept(fd: int, address: __ptr<u8>, length: __ptr<uint>): int {
    return accept4(fd, address, length, _io_sock_cloexec());
}

[Target(OS(Mac))]
_io_posix_accept(fd: int, address: __ptr<u8>, length: __ptr<uint>): int {
    var accepted = accept(fd, address, length);
    if (accepted >= 0) {
        _io_posix_socket_setup(accepted);
    }
    return accepted;
}

[Target(OS(Linux) || OS(Mac))]
_io_sys_socket_accept(h: SocketHandle): IoResult<(SocketHandle, SocketAddress)> {
    var peer = _SockAddr();
    while (true) {
        var fd = _io_posix_accept(h, peer._bytes, peer._length_slot());
        if (fd >= 0) {
            return IoResult<(SocketHandle, SocketAddress)>.ok((fd, peer._read()));
        }
        var retry = _io_posix_retry(h, _io_sys_last_error(), _IO_READABLE);
        if (retry.is_err()) {
            return IoResult<(SocketHandle, SocketAddress)>.err(retry.error());
        }
    }
    return IoResult<(SocketHandle, SocketAddress)>.err(IoError(4, "interrupted"));
}

[Target(OS(Linux) || OS(Mac))]
export _io_sys_socket_receive(h: SocketHandle, destination: __ptr<u8>, n: ulong): IoResult<ulong> {
    # In a task on io_uring, the kernel receives when data arrives.
    var transferred = _io_task_socket_transfer(h, destination, _io_posix_max_rw(n), false);
    if (transferred.is_value()) {
        return transferred.value();
    }
    while (true) {
        var r = recv(h, destination, _io_posix_max_rw(n), 0);
        if (r >= 0) {
            return IoResult<ulong>.ok(r as ulong);
        }
        var retry = _io_posix_retry(h, _io_sys_last_error(), _IO_READABLE);
        if (retry.is_err()) {
            return IoResult<ulong>.err(retry.error());
        }
    }
    return IoResult<ulong>.ok(0);
}

[Target(OS(Linux) || OS(Mac))]
export _io_sys_socket_send(h: SocketHandle, source: __ptr<u8>, n: ulong): IoResult<ulong> {
    var transferred = _io_task_socket_transfer(h, source, _io_posix_max_rw(n), true);
    if (transferred.is_value()) {
        return transferred.value();
    }
    while (true) {
        var r = send(h, source, _io_posix_max_rw(n), _io_msg_nosignal());
        if (r >= 0) {
            return IoResult<ulong>.ok(r as ulong);
        }
        var retry = _io_posix_retry(h, _io_sys_last_error(), _IO_WRITABLE);
        if (retry.is_err()) {
            return IoResult<ulong>.err(retry.error());
        }
    }
    return IoResult<ulong>.ok(0);
}

[Target(OS(Linux) || OS(Mac))]
_io_sys_socket_send_to(h: SocketHandle, source: __ptr<u8>, n: ulong, address: SocketAddress): IoResult<ulong> {
    var sockaddr = _io_sockaddr_write(address);
    return _io_sys_socket_send_to_raw(h, source, n, sockaddr);
}

# Sends to the sockaddr in `sockaddr`, of any family.
[Target(OS(Linux) || OS(Mac))]
_io_sys_socket_send_to_raw(h: SocketHandle, source: __ptr<u8>, n: ulong, sockaddr: _SockAddr): IoResult<ulong> {
    while (true) {
        var r = sendto(h, source, _io_posix_max_rw(n), _io_msg_nosignal(), sockaddr._bytes, sockaddr._length as uint);
        if (r >= 0) {
            return IoResult<ulong>.ok(r as ulong);
        }
        var retry = _io_posix_retry(h, _io_sys_last_error(), _IO_WRITABLE);
        if (retry.is_err()) {
            return IoResult<ulong>.err(retry.error());
        }
    }
    return IoResult<ulong>.ok(0);
}

# A datagram longer than `n` is truncated to `n` bytes; the rest is lost.
[Target(OS(Linux) || OS(Mac))]
_io_sys_socket_receive_from(h: SocketHandle, destination: __ptr<u8>, n: ulong): IoResult<(ulong, SocketAddress)> {
    var from = _SockAddr();
    var r = _io_sys_socket_receive_from_raw(h, destination, n, from);
    if (r.is_err()) {
        return IoResult<(ulong, SocketAddress)>.err(r.error());
    }
    return IoResult<(ulong, SocketAddress)>.ok((r.value(), from._read()));
}

# Receives into `destination` as `_io_sys_socket_receive_from` does, and
# leaves the sender's sockaddr, of any family, in `from`, with its length
# in `from._length`.
[Target(OS(Linux) || OS(Mac))]
_io_sys_socket_receive_from_raw(h: SocketHandle, destination: __ptr<u8>, n: ulong, from: _SockAddr): IoResult<ulong> {
    while (true) {
        var slot = from._length_slot();
        var r = recvfrom(h, destination, _io_posix_max_rw(n), 0, from._bytes, slot);
        if (r >= 0) {
            from._length = slot[0] as int;
            return IoResult<ulong>.ok(r as ulong);
        }
        var retry = _io_posix_retry(h, _io_sys_last_error(), _IO_READABLE);
        if (retry.is_err()) {
            return IoResult<ulong>.err(retry.error());
        }
    }
    return IoResult<ulong>.err(IoError(4, "interrupted"));
}

# how: 0 reading, 1 writing, 2 both (SHUT_RD, SHUT_WR, SHUT_RDWR).
[Target(OS(Linux) || OS(Mac))]
_io_sys_socket_shutdown(h: SocketHandle, how: int): IoResult<void> {
    return _io_socket_check(shutdown(h, how));
}

[Target(OS(Linux) || OS(Mac))]
_io_sys_socket_local_address(h: SocketHandle): IoResult<SocketAddress> {
    var address = _SockAddr();
    return _io_posix_address_result(getsockname(h, address._bytes, address._length_slot()), address);
}

[Target(OS(Linux) || OS(Mac))]
_io_sys_socket_peer_address(h: SocketHandle): IoResult<SocketAddress> {
    var address = _SockAddr();
    return _io_posix_address_result(getpeername(h, address._bytes, address._length_slot()), address);
}

# The address getsockname/getpeername wrote into `address`, or errno.
[Target(OS(Linux) || OS(Mac))]
_io_posix_address_result(rc: int, address: _SockAddr): IoResult<SocketAddress> {
    if (rc != 0) {
        return IoResult<SocketAddress>.err(IoError.last());
    }
    return IoResult<SocketAddress>.ok(address._read());
}

# ── Name resolution ──────────────────────────────────────────────────────────
# struct addrinfo: ai_flags @0, ai_family @4, ai_socktype @8, ai_protocol @12,
# ai_addrlen @16, then glibc has ai_addr @24 and ai_canonname @32, macOS and
# Android's bionic (both BSD-derived) the two the other way round; ai_next
# @40; 48 bytes in all.

[Target(OS(Linux) && !OS(Android))]
_io_addrinfo_address_offset(): ulong { return 24; }

[Target(OS(Mac) || OS(Android))]
_io_addrinfo_address_offset(): ulong { return 32; }

[Target(OS(Linux) || OS(Mac))]
_io_sys_resolve(host: String, port: u16): IoResult<SocketAddress[]> {
    var hints = _IoBuffer(48);
    unsafe_cast<__ptr<int>>(hints._bytes)[2] = 1;  # ai_socktype = SOCK_STREAM: one entry per address
    var result = _IoBuffer(8);
    var list = unsafe_cast<__ptr<__ptr<u8>>>(result._bytes);
    var rc = getaddrinfo(host.c_str(), __null, hints._bytes, list);
    if (rc != 0) {
        if (_io_eai_system(rc)) {
            return IoResult<SocketAddress[]>.err(IoError.last());
        }
        var message = "failed to resolve '" + host + "': " + String(gai_strerror(rc));
        if (_io_eai_no_address(rc)) {
            return IoResult<SocketAddress[]>.err(IoError(_io_sys_code_not_found(), message));
        }
        return IoResult<SocketAddress[]>.err(IoError(5, message));  # EIO
    }
    var out = Array<SocketAddress>();
    var entry = list[0];
    while (entry != __null) {
        var address = unsafe_cast<__ptr<__ptr<u8>>>(entry + _io_addrinfo_address_offset())[0];
        if (address != __null) {
            if (_io_sys_sockaddr_family(address) != 0) {
                var found = _io_sockaddr_read(address);
                out.append(SocketAddress(found.address(), port));
            }
        }
        entry = unsafe_cast<__ptr<__ptr<u8>>>(entry + 40)[0];
    }
    freeaddrinfo(list[0]);
    return IoResult<SocketAddress[]>.ok(out);
}

# ── Network interfaces ───────────────────────────────────────────────────────

# The index of the network interface called `name`, or 0 when there is none.
[Target(OS(Linux) || OS(Mac))]
_io_sys_interface_index(name: String): uint {
    return if_nametoindex(name.c_str());
}

# The name of network interface `index`, or "" when there is none.
[Target(OS(Linux) || OS(Mac))]
_io_sys_interface_name(index: uint): String {
    var buffer = _IoBuffer(64);  # IF_NAMESIZE is 16
    var name = if_indextoname(index, buffer._bytes);
    if (name == __null) {
        return "";
    }
    return String(name);
}
io/socket_wasi
6357
# WASI (WebAssembly) socket layer for io: the same `_io_sys_*` socket
# functions as socket_posix.pep and socket_windows.pep, each with
# [Target(OS(Wasi))]. WASI preview 1 cannot open, bind or connect a
# socket, or resolve a name, so every call that would make or use one fails
# with ENOTSUP; the address helpers write the Linux layout, which nothing
# reads back.

import "address";
import "socket";
import "sys_posix";
import "types";
import "wait";

[Target(OS(Wasi))]
_io_sys_code_timed_out(): ErrorCode {
    return 73;
}  # ETIMEDOUT

[Target(OS(Wasi))]
_io_sys_code_unexpected_end(): ErrorCode {
    return 29;
}  # EIO

# What every socket call returns: sockets are not part of WASI preview 1.
[Target(OS(Wasi))]
_io_wasi_no_sockets(): IoError {
    return IoError(58, "sockets are not supported on WASI");  # ENOTSUP
}

# ── Handles ──────────────────────────────────────────────────────────────────

[Target(OS(Wasi))]
_io_sys_socket_invalid(): SocketHandle {
    return -1;
}

[Target(OS(Wasi))]
_io_sys_socket_valid(h: SocketHandle): bool {
    return h >= 0;
}

[Target(OS(Wasi))]
_io_sys_socket_close(h: SocketHandle): IoResult<void> {
    _io_socket_forget(h);
    return _io_sys_close(h);
}

# ── sockaddr ─────────────────────────────────────────────────────────────────

[Target(OS(Wasi))]
_io_sys_sockaddr_header(buffer: __ptr<u8>, v6: bool, length: int) {
    unsafe_cast<__ptr<u16>>(buffer)[0] = v6 ? 10 : 2;
}

[Target(OS(Wasi))]
_io_sys_sockaddr_family(buffer: __ptr<u8>): int {
    var family = unsafe_cast<__ptr<u16>>(buffer)[0] as int;
    if (family == 2) {
        return 4;
    }
    if (family == 10) {
        return 6;
    }
    return 0;
}

[Target(OS(Wasi))]
_io_sys_sockaddr_unix_header(buffer: __ptr<u8>, length: int) {
    unsafe_cast<__ptr<u16>>(buffer)[0] = 1;
}

[Target(OS(Wasi))]
_io_sys_unix_path_capacity(): ulong {
    return 108;
}

# ── Socket calls ─────────────────────────────────────────────────────────────

[Target(OS(Wasi))]
_io_sys_socket_open(v6: bool, stream: bool): IoResult<SocketHandle> {
    return IoResult<SocketHandle>.err(_io_wasi_no_sockets());
}

[Target(OS(Wasi))]
_io_sys_socket_open_unix(): IoResult<SocketHandle> {
    return IoResult<SocketHandle>.err(_io_wasi_no_sockets());
}

[Target(OS(Wasi))]
_io_sys_socket_set_reuse_address(h: SocketHandle): IoResult<void> {
    return IoResult<void>.err(_io_wasi_no_sockets());
}

[Target(OS(Wasi))]
_io_sys_socket_set_no_delay(h: SocketHandle, enabled: bool): IoResult<void> {
    return IoResult<void>.err(_io_wasi_no_sockets());
}

[Target(OS(Wasi))]
_io_sys_socket_set_broadcast(h: SocketHandle, enabled: bool): IoResult<void> {
    return IoResult<void>.err(_io_wasi_no_sockets());
}

[Target(OS(Wasi))]
_io_sys_socket_bind(h: SocketHandle, address: SocketAddress): IoResult<void> {
    return IoResult<void>.err(_io_wasi_no_sockets());
}

[Target(OS(Wasi))]
_io_sys_socket_bind_raw(h: SocketHandle, buffer: __ptr<u8>, length: int): IoResult<void> {
    return IoResult<void>.err(_io_wasi_no_sockets());
}

[Target(OS(Wasi))]
_io_sys_socket_listen(h: SocketHandle, backlog: int): IoResult<void> {
    return IoResult<void>.err(_io_wasi_no_sockets());
}

[Target(OS(Wasi))]
_io_sys_socket_connect(h: SocketHandle, address: SocketAddress): IoResult<void> {
    return IoResult<void>.err(_io_wasi_no_sockets());
}

[Target(OS(Wasi))]
_io_sys_socket_connect_raw(h: SocketHandle, buffer: __ptr<u8>, length: int): IoResult<void> {
    return IoResult<void>.err(_io_wasi_no_sockets());
}

[Target(OS(Wasi))]
_io_sys_socket_poll(h: SocketHandle, interest: int, timeout: ulong): IoResult<void> {
    return IoResult<void>.err(_io_wasi_no_sockets());
}

[Target(OS(Wasi))]
_io_sys_socket_accept(h: SocketHandle): IoResult<(SocketHandle, SocketAddress)> {
    return IoResult<(SocketHandle, SocketAddress)>.err(_io_wasi_no_sockets());
}

[Target(OS(Wasi))]
export _io_sys_socket_receive(h: SocketHandle, destination: __ptr<u8>, n: ulong): IoResult<ulong> {
    return IoResult<ulong>.err(_io_wasi_no_sockets());
}

[Target(OS(Wasi))]
export _io_sys_socket_send(h: SocketHandle, source: __ptr<u8>, n: ulong): IoResult<ulong> {
