[Target(OS(Windows))]
extern uint GetCurrentProcessId();

# ── Constants ────────────────────────────────────────────────────────────────

const _TLS_CONTEXT_SIZE: ulong = 64;
const _TLS_SESSION_SIZE: ulong = 104;
# The receive and plaintext buffers: room for any TLS record and most
# handshake flights.
const _TLS_BUFFER_SIZE: ulong = 65536;

# SECURITY_STATUS values.
const _TLS_SEC_E_OK: int = 0;
const _TLS_SEC_I_CONTINUE_NEEDED: int = 590610;          # 0x00090312
const _TLS_SEC_I_CONTEXT_EXPIRED: int = 590615;          # 0x00090317
const _TLS_SEC_I_INCOMPLETE_CREDENTIALS: int = 590624;   # 0x00090320
const _TLS_SEC_I_RENEGOTIATE: int = 590625;              # 0x00090321
const _TLS_SEC_E_INCOMPLETE_MESSAGE: int = -2146893032;  # 0x80090318

# SecBuffer types.
const _TLS_BUFFER_EMPTY: uint = 0;
const _TLS_BUFFER_DATA: uint = 1;
const _TLS_BUFFER_TOKEN: uint = 2;
const _TLS_BUFFER_EXTRA: uint = 5;
const _TLS_BUFFER_TRAILER: uint = 6;
const _TLS_BUFFER_HEADER: uint = 7;
const _TLS_BUFFER_APPLICATION_PROTOCOLS: uint = 18;

# ISC_REQ_SEQUENCE_DETECT | REPLAY_DETECT | CONFIDENTIALITY |
# USE_SUPPLIED_CREDS | ALLOCATE_MEMORY | EXTENDED_ERROR | STREAM |
# MANUAL_CRED_VALIDATION. USE_SUPPLIED_CREDS: when a server asks for a
# certificate, send the one `set_identity` gave, or none, instead of
# returning SEC_I_INCOMPLETE_CREDENTIALS to ask for one.
const _TLS_CLIENT_REQUEST: uint = 573852;
# ASC_REQ_SEQUENCE_DETECT | REPLAY_DETECT | CONFIDENTIALITY | ALLOCATE_MEMORY
# | EXTENDED_ERROR | STREAM.
const _TLS_SERVER_REQUEST: uint = 98588;
# ASC_REQ_MUTUAL_AUTH: ask the client for a certificate.
const _TLS_SERVER_MUTUAL: uint = 2;

# SCH_CRED_MANUAL_CRED_VALIDATION | SCH_CRED_NO_DEFAULT_CREDS |
# SCH_USE_STRONG_CRYPTO, and SCH_CRED_NO_SYSTEM_MAPPER (a client
# certificate is not mapped to a Windows account) | SCH_USE_STRONG_CRYPTO.
const _TLS_CLIENT_CREDENTIAL_FLAGS: uint = 4194328;
const _TLS_SERVER_CREDENTIAL_FLAGS: uint = 4194306;
# SSL 2 and 3, TLS 1.0 and 1.1, client and server.
const _TLS_DISABLED_PROTOCOLS: uint = 1020;

# X509_ASN_ENCODING | PKCS_7_ASN_ENCODING.
const _TLS_ENCODING: uint = 65537;

# ── Errors ───────────────────────────────────────────────────────────────────

# ERROR_INVALID_DATA: the code of every TLS error.
[Target(OS(Windows))]
_tls_sys_code_protocol(): io.ErrorCode { return 13; }

[Target(OS(Windows))]
_tls_error(message: String): io.IoError {
    return io.IoError(_tls_sys_code_protocol(), message);
}

# `what` and the status in hexadecimal.
[Target(OS(Windows))]
_tls_status_error(what: String, status: int): io.IoError {
    return _tls_error($"{what} ({_tls_hex(status as uint)})");
}

[Target(OS(Windows))]
_tls_hex(value: uint): String {
    return $"0x{value:08x}";
}

# Why the certificate check failed, from CERT_CHAIN_POLICY_STATUS.dwError.
[Target(OS(Windows))]
_tls_certificate_reason(error: uint): String {
    return match (error) {
        2148204809 => "self-signed certificate or untrusted root",  # CERT_E_UNTRUSTEDROOT
        2148204815 => "the certificate is not for this host",       # CERT_E_CN_NO_MATCH
        2148204801 => "certificate has expired",                    # CERT_E_EXPIRED
        2148204810 => "unable to get local issuer certificate",     # CERT_E_CHAINING
        2148204812 => "certificate revoked",                        # CERT_E_REVOKED
        2148204814 => "unsupported certificate purpose",            # CERT_E_WRONG_USAGE
        else => $"error {_tls_hex(error)}",
    };
}

# ── Memory helpers ───────────────────────────────────────────────────────────

[Target(OS(Windows))]
_tls_u32(block: __ptr<u8>, offset: ulong): uint {
    return unsafe_cast<__ptr<uint>>(block + offset)[0];
}

[Target(OS(Windows))]
_tls_set_u32(block: __ptr<u8>, offset: ulong, value: uint) {
    unsafe_cast<__ptr<uint>>(block + offset)[0] = value;
}

[Target(OS(Windows))]
_tls_word(block: __ptr<u8>, offset: ulong): ulong {
    return unsafe_cast<__ptr<ulong>>(block + offset)[0];
}

[Target(OS(Windows))]
_tls_set_word(block: __ptr<u8>, offset: ulong, value: ulong) {
    unsafe_cast<__ptr<ulong>>(block + offset)[0] = value;
}

[Target(OS(Windows))]
_tls_pointer(block: __ptr<u8>, offset: ulong): __ptr<u8> {
    return unsafe_cast<__ptr<__ptr<u8>>>(block + offset)[0];
}

[Target(OS(Windows))]
_tls_set_pointer(block: __ptr<u8>, offset: ulong, value: __ptr<u8>) {
    unsafe_cast<__ptr<__ptr<u8>>>(block + offset)[0] = value;
}

# Copies `n` bytes from `source` to `destination`, front to back (so it may
# move bytes toward the start of the same buffer).
[Target(OS(Windows))]
_tls_copy(destination: __ptr<u8>, source: __ptr<u8>, n: ulong) {
    ulong i = 0;
    while (i < n) {
        destination[i] = source[i];
        i = i + 1;
    }
}

# Sets SecBuffer `index` of the array at `buffers`.
[Target(OS(Windows))]
_tls_set_buffer(buffers: __ptr<u8>, index: ulong, kind: uint, data: __ptr<u8>, size: ulong) {
    var buffer = buffers + index * 16;
    _tls_set_u32(buffer, 0, size as uint);
    _tls_set_u32(buffer, 4, kind);
    _tls_set_pointer(buffer, 8, data);
}

# A SecBufferDesc (16 bytes) followed by `count` SecBuffers, all empty.
[Target(OS(Windows))]
_tls_buffers(count: ulong): __ptr<u8> {
    __ptr<u8> desc = _pep_malloc(16 + count * 16);
    _tls_set_u32(desc, 0, 0);  # SECBUFFER_VERSION
    _tls_set_u32(desc, 4, count as uint);
    _tls_set_pointer(desc, 8, desc + 16);
    return desc;
}

[Target(OS(Windows))]
_tls_buffer_at(desc: __ptr<u8>, index: ulong): __ptr<u8> {
    return desc + 16 + index * 16;
}

# ── Certificates and keys ────────────────────────────────────────────────────

# The DER bytes of every PEM block labeled `label` in `text`. securetransport.pep
# uses it on iOS too.
[Target(OS(Windows) || OS(IOS))]
_tls_pem_blocks(text: String, label: String): Array<u8[]> {
    var blocks = Array<u8[]>();
    var begin = $"-----BEGIN {label}-----";
    var end = $"-----END {label}-----";
    ulong from = 0;
    while (true) {
        var start = text.find(begin, from);
        if (start < 0) {
            return blocks;
        }
        var stop = text.find(end, start as ulong);
        if (stop < 0) {
            return blocks;
        }
        var block_end = stop as ulong + end.size;
        var body_start = start as ulong + begin.size;
        var body = text.substr_bytes(body_start, stop as ulong - body_start);
        var der = base64.decode(body.replace("\r", "").replace("\n", "").replace(" ", "").replace("\t", ""));
        if (der.is_ok()) {
            blocks.append(der.value());
        }
        from = block_end;
    }
    return blocks;
}

[Target(OS(Windows))]
_tls_read_text(path: io.Path, what: String): io.IoResult<String> {
    var text = io.File.read_to_string(path);
    if (text.is_err()) {
        return io.IoResult<String>.err(_tls_error($"cannot read {what} '{path}': {text.error().message}"));
    }
    return text;
}

# Adds the DER certificate to `store`; the added context through `added`
# when it is not null.
[Target(OS(Windows))]
_tls_add_certificate(store: __ptr<void>, der: u8[], added: __ptr<__ptr<void>>): bool {
    # CERT_STORE_ADD_ALWAYS
    return CertAddEncodedCertificateToStore(store, _TLS_ENCODING, der._data, der._size as uint, 4, added) != 0;
}

# A new in-memory certificate store (CERT_STORE_PROV_MEMORY).
[Target(OS(Windows))]
_tls_memory_store(): __ptr<void> {
    return CertOpenStore(2, 0, __null, 0, __null);
}

# ── Credentials ──────────────────────────────────────────────────────────────

# Acquires a credential handle into the 16 bytes at `context` with
# SChannel's SCH_CREDENTIALS; `certificate` is the one to present (null for
# a client with no identity).
[Target(OS(Windows))]
_tls_acquire(context: __ptr<u8>, server: bool, certificate: __ptr<void>): int {
    __ptr<u8> credentials = _pep_malloc(72);
    __ptr<u8> parameters = _pep_malloc(40);
    __ptr<__ptr<void>> certificates = _pep_malloc(8);
    certificates[0] = certificate;
    _tls_set_u32(credentials, 0, 5);  # SCH_CREDENTIALS_VERSION
    _tls_set_u32(parameters, 16, _TLS_DISABLED_PROTOCOLS);
    _tls_set_u32(credentials, 56, 1);
    _tls_set_pointer(credentials, 64, parameters);
    if (certificate != __null) {
        _tls_set_u32(credentials, 8, 1);
        _tls_set_pointer(credentials, 16, unsafe_cast<__ptr<u8>>(certificates));
    }
    uint use = 2;  # SECPKG_CRED_OUTBOUND
    if (server) {
        use = 1;  # SECPKG_CRED_INBOUND
        _tls_set_u32(credentials, 52, _TLS_SERVER_CREDENTIAL_FLAGS);
    } else {
        _tls_set_u32(credentials, 52, _TLS_CLIENT_CREDENTIAL_FLAGS);
    }
    var package = io._io_win_wide("Microsoft Unified Security Protocol Provider");
    __ptr<u8> expiry = _pep_malloc(8);
    var status = AcquireCredentialsHandleW(__null, package, use, __null, credentials, __null, __null, context, expiry);
    _pep_free(expiry);
    _pep_free(package);
    _pep_free(certificates);
    _pep_free(parameters);
    _pep_free(credentials);
    return status;
}

# A client context that checks the server's certificate against the
# system's trusted roots (and any added with `_tls_sys_add_root`).
[Target(OS(Windows))]
_tls_sys_client_context(): io.IoResult<__ptr<void>> {
    __ptr<u8> context = _pep_malloc(_TLS_CONTEXT_SIZE);
    var status = _tls_acquire(context, false, __null);
    if (status != _TLS_SEC_E_OK) {
        _pep_free(context);
        return io.IoResult<__ptr<void>>.err(_tls_status_error("cannot create a TLS context", status));
    }
    _tls_set_word(context, 16, 0);
    _tls_set_pointer(context, 24, _tls_memory_store() as __ptr<u8>);
    return io.IoResult<__ptr<void>>.ok(context);
}

# The key storage provider (MS_KEY_STORAGE_PROVIDER), or 0.
[Target(OS(Windows))]
_tls_key_provider(): ulong {
    __ptr<ulong> provider = _pep_malloc(8);
    provider[0] = 0;
    var name = io._io_win_wide("Microsoft Software Key Storage Provider");
    NCryptOpenStorageProvider(provider, name, 0);
    _pep_free(name);
    var result = provider[0];
    _pep_free(provider);
    return result;
}

# Numbers the server keys this process imports.
const _tls_key_count = async.Atomic<ulong>(0);

# Imports the PKCS #8 key under a new name; the name, or an error.
[Target(OS(Windows))]
_tls_import_key(der: u8[]): io.IoResult<__ptr<u16>> {
    var provider = _tls_key_provider();
    if (provider == 0) {
        return io.IoResult<__ptr<u16>>.err(_tls_error("cannot open the key storage provider"));
    }
    var number = _tls_key_count.fetch_add(1);
    var name = io._io_win_wide($"pepper-tls-{GetCurrentProcessId() as ulong}-{number}");
    # NCryptBufferDesc { version, count, buffers } with one NCryptBuffer
    # { cbBuffer, BufferType = NCRYPTBUFFER_PKCS_KEY_NAME, pvBuffer }: the
    # same layout as SecBufferDesc and SecBuffer.
    var desc = _tls_buffers(1);
    _tls_set_buffer(desc + 16, 0, 45, unsafe_cast<__ptr<u8>>(name), ((io._io_win_wide_len(name) as ulong) + 1) * 2);
    var blob_type = io._io_win_wide("PKCS8_PRIVATEKEY");
    __ptr<ulong> key = _pep_malloc(8);
    key[0] = 0;
    # NCRYPT_OVERWRITE_KEY_FLAG | NCRYPT_DO_NOT_FINALIZE_FLAG
    var status = NCryptImportKey(provider, 0, blob_type, desc, key, der._data, der._size as uint, 1152);
    if (status == 0) {
        status = NCryptFinalizeKey(key[0], 0);
    }
    if (key[0] != 0) {
        NCryptFreeObject(key[0]);
    }
    _pep_free(key);
    _pep_free(blob_type);
    _pep_free(desc);
    NCryptFreeObject(provider);
    if (status != 0) {
        _pep_free(name);
        return io.IoResult<__ptr<u16>>.err(_tls_status_error("cannot import the private key", status));
    }
    return io.IoResult<__ptr<u16>>.ok(name);
}

# Deletes the imported key `name`.
[Target(OS(Windows))]
_tls_delete_key(name: __ptr<u16>) {
    var provider = _tls_key_provider();
    if (provider == 0) {
        return;
    }
    __ptr<ulong> key = _pep_malloc(8);
    key[0] = 0;
    if (NCryptOpenKey(provider, key, name, 0, 0) == 0) {
        NCryptDeleteKey(key[0], 0);  # frees the handle too
    }
    _pep_free(key);
    NCryptFreeObject(provider);
}

# The public key of `certificate` (a CERT_CONTEXT) as a BCRYPT public key
# blob, or an empty array when it cannot be read.
[Target(OS(Windows))]
_tls_certificate_public_key(certificate: __ptr<void>): u8[] {
    var blob = Array<u8>();
    # CERT_CONTEXT.pCertInfo at 24; CERT_INFO.SubjectPublicKeyInfo at 96.
    var info = _tls_pointer(certificate as __ptr<u8>, 24) + 96;
    __ptr<__ptr<void>> key = _pep_malloc(8);
    key[0] = __null;
    if (CryptImportPublicKeyInfoEx2(_TLS_ENCODING, info, 0, __null, key) != 0) {
        var kind = io._io_win_wide("PUBLICBLOB");
        __ptr<uint> size = _pep_malloc(4);
        size[0] = 0;
        if (BCryptExportKey(key[0], __null, kind, __null, 0, size, 0) == 0) {
            blob.reserve(size[0] as ulong);
            if (BCryptExportKey(key[0], __null, kind, blob._data, size[0], size, 0) == 0) {
                blob._size = size[0] as ulong;
            }
        }
        _pep_free(size);
        _pep_free(kind);
        BCryptDestroyKey(key[0]);
    }
    _pep_free(key);
    return blob;
}

# Whether the imported key `name` is the private key of `certificate`: the
# public halves match. The blobs' first four bytes name the algorithm,
# which can differ (ECDSA or ECDH) for the same key.
[Target(OS(Windows))]
_tls_key_matches(certificate: __ptr<void>, name: __ptr<u16>): bool {
    var expected = _tls_certificate_public_key(certificate);
    var provider = _tls_key_provider();
    if (expected.count < 8 || provider == 0) {
        if (provider != 0) {
            NCryptFreeObject(provider);
        }
        return false;
    }
    var actual = Array<u8>();
    __ptr<ulong> key = _pep_malloc(8);
    key[0] = 0;
    if (NCryptOpenKey(provider, key, name, 0, 0) == 0) {
        var kind = io._io_win_wide("PUBLICBLOB");
        __ptr<uint> size = _pep_malloc(4);
        size[0] = 0;
        if (NCryptExportKey(key[0], 0, kind, __null, __null, 0, size, 0) == 0) {
            actual.reserve(size[0] as ulong);
            if (NCryptExportKey(key[0], 0, kind, __null, actual._data, size[0], size, 0) == 0) {
                actual._size = size[0] as ulong;
            }
        }
        _pep_free(size);
        _pep_free(kind);
        NCryptFreeObject(key[0]);
    }
    _pep_free(key);
    NCryptFreeObject(provider);
    if (actual.count != expected.count) {
        return false;
    }
    ulong i = 4;
    while (i < expected.count) {
        if (actual[i] != expected[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

# The certificate chain and private key in PEM files, loaded for SChannel:
# a store holding the chain, the first certificate's context, with its key
# imported under the returned name and linked to it.
[Target(OS(Windows))]
_tls_load_identity(chain: io.Path, key: io.Path): io.IoResult<(__ptr<void>, __ptr<void>, __ptr<u16>)> {
    var chain_text = _tls_read_text(chain, "the certificate chain");
    if (chain_text.is_err()) {
        return io.IoResult<(__ptr<void>, __ptr<void>, __ptr<u16>)>.err(chain_text.error());
    }
    var certificates = _tls_pem_blocks(chain_text.value(), "CERTIFICATE");
    if (certificates.count == 0) {
        return io.IoResult<(__ptr<void>, __ptr<void>, __ptr<u16>)>.err(
            _tls_error($"cannot load the certificate chain '{chain}': no certificate in it")
        );
    }
    var key_text = _tls_read_text(key, "the private key");
    if (key_text.is_err()) {
        return io.IoResult<(__ptr<void>, __ptr<void>, __ptr<u16>)>.err(key_text.error());
    }
    var keys = _tls_pem_blocks(key_text.value(), "PRIVATE KEY");
    if (keys.count == 0) {
        return io.IoResult<(__ptr<void>, __ptr<void>, __ptr<u16>)>.err(
            _tls_error($"cannot load the private key '{key}': no PKCS #8 PRIVATE KEY block in it")
        );
    }
    var store = _tls_memory_store();
    __ptr<__ptr<void>> leaf = _pep_malloc(8);
    leaf[0] = __null;
    var loaded = _tls_add_certificate(store, certificates[0], leaf);
    ulong i = 1;
    while (loaded && i < certificates.count) {
        loaded = _tls_add_certificate(store, certificates[i], __null);
        i = i + 1;
    }
    var certificate = leaf[0];
    _pep_free(leaf);
    if (!loaded) {
        if (certificate != __null) {
            CertFreeCertificateContext(certificate);
        }
        CertCloseStore(store, 0);
        return io.IoResult<(__ptr<void>, __ptr<void>, __ptr<u16>)>.err(
            _tls_error($"cannot load the certificate chain '{chain}'")
        );
    }
    var imported = _tls_import_key(keys[0]);
    if (imported.is_err()) {
        CertFreeCertificateContext(certificate);
        CertCloseStore(store, 0);
        return io.IoResult<(__ptr<void>, __ptr<void>, __ptr<u16>)>.err(imported.error());
    }
    var name = imported.value();
    if (!_tls_key_matches(certificate, name)) {
        _tls_free_identity(store, certificate, name);
        return io.IoResult<(__ptr<void>, __ptr<void>, __ptr<u16>)>.err(
            _tls_error($"cannot load the private key '{key}': it is not the key of the certificate in '{chain}'")
        );
    }
    # CRYPT_KEY_PROV_INFO { container, provider, type, flags, cProvParam,
    # rgProvParam, dwKeySpec }: 48 bytes.
    __ptr<u8> info = _pep_malloc(48);
    var provider_name = io._io_win_wide("Microsoft Software Key Storage Provider");
    _tls_set_pointer(info, 0, unsafe_cast<__ptr<u8>>(name));
    _tls_set_pointer(info, 8, unsafe_cast<__ptr<u8>>(provider_name));
    CertSetCertificateContextProperty(certificate, 2, 0, info);  # CERT_KEY_PROV_INFO_PROP_ID
    _pep_free(provider_name);
    _pep_free(info);
    return io.IoResult<(__ptr<void>, __ptr<void>, __ptr<u16>)>.ok((store, certificate, name));
}

# Frees what `_tls_load_identity` returned: deletes the key, frees the
# certificate and closes the store (null when already closed).
[Target(OS(Windows))]
_tls_free_identity(store: __ptr<void>, certificate: __ptr<void>, name: __ptr<u16>) {
    _tls_delete_key(name);
    _pep_free(name);
    CertFreeCertificateContext(certificate);
    if (store != __null) {
        CertCloseStore(store, 0);
    }
}

# A server context presenting the PEM certificate chain and private key.
[Target(OS(Windows))]
_tls_sys_server_context(chain: io.Path, key: io.Path): io.IoResult<__ptr<void>> {
    var loaded = _tls_load_identity(chain, key);
    if (loaded.is_err()) {
        return io.IoResult<__ptr<void>>.err(loaded.error());
    }
    var (store, certificate, name) = loaded.value();
    __ptr<u8> context = _pep_malloc(_TLS_CONTEXT_SIZE);
    var status = _tls_acquire(context, true, certificate);
    if (status != _TLS_SEC_E_OK) {
        _pep_free(context);
        _tls_free_identity(store, certificate, name);
        return io.IoResult<__ptr<void>>.err(_tls_status_error("cannot use the certificate and key", status));
    }
    _tls_set_word(context, 16, 1);
    _tls_set_pointer(context, 24, store as __ptr<u8>);
    _tls_set_pointer(context, 32, certificate as __ptr<u8>);
    _tls_set_pointer(context, 40, unsafe_cast<__ptr<u8>>(name));
    return io.IoResult<__ptr<void>>.ok(context);
}

# Makes a client context present the PEM certificate chain and private key
# to servers that ask for one: acquires a new credential with the
# certificate and frees the old one, and any identity it had.
[Target(OS(Windows))]
_tls_sys_set_identity(context: __ptr<void>, chain: io.Path, key: io.Path): io.IoResult<void> {
    var loaded = _tls_load_identity(chain, key);
    if (loaded.is_err()) {
        return io.IoResult<void>.err(loaded.error());
    }
    var (store, certificate, name) = loaded.value();
    __ptr<u8> credential = _pep_malloc(16);
    var status = _tls_acquire(credential, false, certificate);
    if (status != _TLS_SEC_E_OK) {
        _pep_free(credential);
        _tls_free_identity(store, certificate, name);
        return io.IoResult<void>.err(_tls_status_error("cannot use the certificate and key", status));
    }
    # The certificate keeps its store, with the intermediates SChannel
    # sends, until it is freed.
    CertCloseStore(store, 0);
    __ptr<u8> block = context;
    FreeCredentialsHandle(block);
    _tls_copy(block, credential, 16);
    _pep_free(credential);
    var old_certificate = _tls_pointer(block, 32);
    if (old_certificate != __null) {
        _tls_free_identity(__null, old_certificate as __ptr<void>, unsafe_cast<__ptr<u16>>(_tls_pointer(block, 40)));
    }
    _tls_set_pointer(block, 32, certificate as __ptr<u8>);
    _tls_set_pointer(block, 40, unsafe_cast<__ptr<u8>>(name));
    return io.IoResult<void>.ok();
}

# The certificates in the PEM file at `path`, added to `store`.
[Target(OS(Windows))]
_tls_add_certificates(store: __ptr<void>, path: io.Path): io.IoResult<void> {
    var text = _tls_read_text(path, "the certificates");
    if (text.is_err()) {
        return io.IoResult<void>.err(text.error());
    }
    var certificates = _tls_pem_blocks(text.value(), "CERTIFICATE");
    if (certificates.count == 0) {
        return io.IoResult<void>.err(_tls_error($"cannot load the certificates in '{path}': none found"));
    }
    for (var der in certificates) {
        if (!_tls_add_certificate(store, der, __null)) {
            return io.IoResult<void>.err(_tls_error($"cannot load the certificates in '{path}'"));
        }
    }
    return io.IoResult<void>.ok();
}

# Makes a server context ask every client for a certificate issued by one in
# the PEM file `roots`, and fail the handshake without one.
[Target(OS(Windows))]
_tls_sys_require_client_certificate(context: __ptr<void>, roots: io.Path): io.IoResult<void> {
    __ptr<u8> block = context;
    var store = _tls_pointer(block, 48) as __ptr<void>;
    var created = store == __null;
    if (created) {
        store = _tls_memory_store();
    }
    var added = _tls_add_certificates(store, roots);
    if (added.is_err()) {
        if (created) {
            CertCloseStore(store, 0);
        }
        return added;
    }
    _tls_set_pointer(block, 48, store as __ptr<u8>);
    return io.IoResult<void>.ok();
}

# Also trusts the PEM certificates in `path`.
[Target(OS(Windows))]
_tls_sys_add_root(context: __ptr<void>, path: io.Path): io.IoResult<void> {
    return _tls_add_certificates(_tls_pointer(context as __ptr<u8>, 24) as __ptr<void>, path);
}

[Target(OS(Windows))]
_tls_sys_context_free(context: __ptr<void>) {
    __ptr<u8> block = context;
    FreeCredentialsHandle(block);
    var store = _tls_pointer(block, 24);
    var certificate = _tls_pointer(block, 32);
    if (certificate != __null) {
        _tls_free_identity(__null, certificate as __ptr<void>, unsafe_cast<__ptr<u16>>(_tls_pointer(block, 40)));
    }
    if (store != __null) {
        CertCloseStore(store, 0);
    }
    var client_roots = _tls_pointer(block, 48);
    if (client_roots != __null) {
        CertCloseStore(client_roots, 0);
    }
    var protocols = _tls_pointer(block, 56);
    if (protocols != __null) {
        _pep_free(protocols);
    }
    _pep_free(block);
}

# Sets the protocols a context offers (a client) or accepts (a server)
# through ALPN: `list` is in the wire format, each name after its length. It
# is kept as a SEC_APPLICATION_PROTOCOLS: the size of what follows (u32),
# SecApplicationProtocolNegotiationExt_ALPN (u32 2), the list's size (u16)
# and the list.
[Target(OS(Windows))]
_tls_sys_set_protocols(context: __ptr<void>, list: u8[], server: bool): io.IoResult<void> {
    __ptr<u8> block = context;
    var old = _tls_pointer(block, 56);
    if (old != __null) {
        _pep_free(old);
    }
    __ptr<u8> protocols = _pep_malloc(10 + list.count);
    _tls_set_u32(protocols, 0, (6 + list.count) as uint);
    _tls_set_u32(protocols, 4, 2);
    protocols[8] = (list.count & 0xff) as u8;
    protocols[9] = (list.count >> 8) as u8;
    _tls_copy(protocols + 10, list._data, list.count);
    _tls_set_pointer(block, 56, protocols);
    return io.IoResult<void>.ok();
}

# Sets SecBuffer `index` of the array at `buffers` to the context's ALPN
# protocols.
[Target(OS(Windows))]
_tls_set_protocols_buffer(buffers: __ptr<u8>, index: ulong, protocols: __ptr<u8>) {
    var size = _tls_u32(protocols, 0) as ulong + 4;
    _tls_set_buffer(buffers, index, _TLS_BUFFER_APPLICATION_PROTOCOLS, protocols, size);
}

# The protocol the handshake chose through ALPN, or "" for none.
[Target(OS(Windows))]
_tls_sys_protocol(session: __ptr<void>): String {
    # SecPkgContext_ApplicationProtocol: the status (u32, 1 for success),
    # the extension (u32), the name's size (u8) and up to 255 bytes of it.
    __ptr<u8> answer = _pep_malloc(264);
    var status = QueryContextAttributesW(session, 35, answer);  # SECPKG_ATTR_APPLICATION_PROTOCOL
    var name = "";
    if (status == _TLS_SEC_E_OK && _tls_u32(answer, 0) == 1 && answer[8] > 0) {
        name = String(unsafe_cast<__ptr<char>>(answer + 9), answer[8] as ulong);
    }
    _pep_free(answer);
    return name;
}

# ── Sessions ─────────────────────────────────────────────────────────────────

[Target(OS(Windows))]
_tls_session_new(context: __ptr<void>, h: io.SocketHandle, host: String): __ptr<u8> {
    __ptr<u8> session = _pep_malloc(_TLS_SESSION_SIZE);
    _tls_set_word(session, 16, h as ulong);
    _tls_set_pointer(session, 24, context as __ptr<u8>);
    _tls_set_pointer(session, 32, _pep_malloc(_TLS_BUFFER_SIZE));
    _tls_set_pointer(session, 48, _pep_malloc(_TLS_BUFFER_SIZE));
    if (host.size > 0) {
        _tls_set_pointer(session, 96, unsafe_cast<__ptr<u8>>(io._io_win_wide(host)));
    }
    return session;
}

[Target(OS(Windows))]
_tls_session_server(session: __ptr<u8>): bool {
    return _tls_word(_tls_pointer(session, 24), 16) == 1;
}

[Target(OS(Windows))]
_tls_session_socket(session: __ptr<u8>): io.SocketHandle {
    return _tls_word(session, 16) as io.SocketHandle;
}

# Whether a security context exists (the handle is not all zero).
[Target(OS(Windows))]
_tls_session_started(session: __ptr<u8>): bool {
    if (_tls_word(session, 0) != 0) {
        return true;
    }
    return _tls_word(session, 8) != 0;
}

# Sends all `n` bytes at `data`, failing when a send makes no progress.
[Target(OS(Windows))]
_tls_send_all(session: __ptr<u8>, data: __ptr<u8>, n: ulong): io.IoResult<void> {
    return io._io_socket_send_all(_tls_session_socket(session), data, n);
}

# Receives more bytes after the ones waiting to be decrypted; how many (0 at
# the end of the stream).
[Target(OS(Windows))]
_tls_receive(session: __ptr<u8>): io.IoResult<ulong> {
    var count = _tls_word(session, 40);
    if (count >= _TLS_BUFFER_SIZE) {
        return io.IoResult<ulong>.err(_tls_error("a TLS message is larger than the receive buffer"));
    }
    var got = io._io_sys_socket_receive(
        _tls_session_socket(session), _tls_pointer(session, 32) + count, _TLS_BUFFER_SIZE - count
    );
    if (got.is_ok()) {
        _tls_set_word(session, 40, count + got.value());
    }
    return got;
}

# Keeps only the last `extra` of the waiting bytes (a SECBUFFER_EXTRA).
[Target(OS(Windows))]
_tls_keep_extra(session: __ptr<u8>, extra: ulong) {
    var buffer = _tls_pointer(session, 32);
    var count = _tls_word(session, 40);
    if (extra > 0 && extra < count) {
        _tls_copy(buffer, buffer + (count - extra), extra);
    }
    _tls_set_word(session, 40, extra);
}

# Sends and frees an output token SChannel allocated.
[Target(OS(Windows))]
_tls_send_token(session: __ptr<u8>, output: __ptr<u8>): io.IoResult<void> {
    var token = _tls_buffer_at(output, 0);
    var data = _tls_pointer(token, 8);
    if (data == __null) {
        return io.IoResult<void>.ok();
    }
    var size = _tls_u32(token, 0) as ulong;
    var sent = io.IoResult<void>.ok();
    if (size > 0) {
        sent = _tls_send_all(session, data, size);
    }
    FreeContextBuffer(data);
    _tls_set_pointer(token, 8, __null);
    return sent;
}

# One InitializeSecurityContext or AcceptSecurityContext call on the waiting
# bytes; its status. Sends any token it produces and keeps any extra bytes.
[Target(OS(Windows))]
_tls_step(session: __ptr<u8>): io.IoResult<int> {
    var context = _tls_pointer(session, 24);
    var server = _tls_session_server(session);
    var protocols = _tls_pointer(context, 56);
    var started = _tls_session_started(session);
    var input = _tls_buffers(protocols != __null && server && !started ? 3 : 2);
    var output = _tls_buffers(1);
    _tls_set_buffer(input + 16, 0, _TLS_BUFFER_TOKEN, _tls_pointer(session, 32), _tls_word(session, 40));
    _tls_set_buffer(input + 16, 1, _TLS_BUFFER_EMPTY, __null, 0);
    # A server lists its protocols only with the ClientHello: on a later
    # step SChannel finds no client list to match and fails the handshake
    # (SEC_E_APPLICATION_PROTOCOL_MISMATCH).
    if (protocols != __null && server && !started) {
        _tls_set_protocols_buffer(input + 16, 2, protocols);
    }
    _tls_set_buffer(output + 16, 0, _TLS_BUFFER_TOKEN, __null, 0);
    __ptr<uint> attributes = _pep_malloc(4);
    __ptr<u8> expiry = _pep_malloc(8);
    __ptr<u8> existing = __null;
    if (started) {
        existing = session;
    }
    # A client's first call has no input: it produces the ClientHello,
    # with the ALPN protocols when there are any.
    var consumed = started || server;
    __ptr<u8> offered = __null;
    __ptr<u8> hello = __null;
    if (consumed) {
        offered = input;
    } else if (protocols != __null) {
        hello = _tls_buffers(1);
        _tls_set_protocols_buffer(hello + 16, 0, protocols);
        offered = hello;
    }
    int status = 0;
    if (server) {
        var request = _TLS_SERVER_REQUEST;
        if (_tls_pointer(context, 48) != __null) {
            request = request | _TLS_SERVER_MUTUAL;
        }
        status = AcceptSecurityContext(context, existing, offered, request, 0, session, output, attributes, expiry);
    } else {
        status = InitializeSecurityContextW(
            context,
            existing,
            _tls_pointer(session, 96),
            _TLS_CLIENT_REQUEST,
            0,
            0,
            offered,
            0,
            session,
            output,
            attributes,
            expiry
        );
    }
    _pep_free(expiry);
    _pep_free(attributes);
    var sent = _tls_send_token(session, output);
    var result = io.IoResult<int>.ok(status);
    if (sent.is_err()) {
        result = io.IoResult<int>.err(sent.error());
    }
    # INCOMPLETE_MESSAGE needs more bytes, and INCOMPLETE_CREDENTIALS the same
    # bytes again: both leave the waiting bytes as they are.
    if (consumed && status != _TLS_SEC_E_INCOMPLETE_MESSAGE && status != _TLS_SEC_I_INCOMPLETE_CREDENTIALS) {
        var extra = _tls_buffer_at(input, 1);
        if (_tls_u32(extra, 4) == _TLS_BUFFER_EXTRA) {
            _tls_keep_extra(session, _tls_u32(extra, 0) as ulong);
        } else {
            _tls_set_word(session, 40, 0);
        }
    }
    if (hello != __null) {
        _pep_free(hello);
    }
    _pep_free(output);
    _pep_free(input);
    return result;
}

# Runs handshake steps until SChannel reports the connection is set up.
[Target(OS(Windows))]
_tls_handshake(session: __ptr<u8>): io.IoResult<void> {
    # A server, and a client continuing (after SEC_I_RENEGOTIATE), start
    # from received bytes; a client's first step sends its hello.
    var need = _tls_session_server(session) && _tls_word(session, 40) == 0;
    var retried = false;
    while (true) {
        if (need) {
            var got = _tls_receive(session);
            if (got.is_err()) {
                return io.IoResult<void>.err(got.error());
            }
            if (got.value() == 0) {
                return io.IoResult<void>.err(_tls_error("TLS handshake failed: the connection closed"));
            }
        }
        var step = _tls_step(session);
        if (step.is_err()) {
            return io.IoResult<void>.err(step.error());
        }
        var status = step.value();
        if (status == _TLS_SEC_E_OK) {
            return io.IoResult<void>.ok();
        }
        if (status == _TLS_SEC_E_INCOMPLETE_MESSAGE) {
            need = true;
        } else if (status == _TLS_SEC_I_CONTINUE_NEEDED) {
            need = _tls_word(session, 40) == 0;
        } else if (status == _TLS_SEC_I_INCOMPLETE_CREDENTIALS && !retried) {
            # The server asked for a certificate. USE_SUPPLIED_CREDS should
            # keep SChannel from asking; if it does, run the same bytes once
            # more rather than wait for bytes the server will not send.
            retried = true;
            need = false;
        } else {
            return io.IoResult<void>.err(_tls_status_error("TLS handshake failed", status));
        }
    }
    return io.IoResult<void>.ok();
}

# Records the stream sizes after the handshake.
[Target(OS(Windows))]
_tls_query_sizes(session: __ptr<u8>): io.IoResult<void> {
    __ptr<u8> sizes = _pep_malloc(20);
    var status = QueryContextAttributesW(session, 4, sizes);  # SECPKG_ATTR_STREAM_SIZES
    _tls_set_u32(session, 72, _tls_u32(sizes, 0));
    _tls_set_u32(session, 76, _tls_u32(sizes, 4));
    _tls_set_u32(session, 80, _tls_u32(sizes, 8));
    _pep_free(sizes);
    if (status != _TLS_SEC_E_OK) {
        return io.IoResult<void>.err(_tls_status_error("cannot read the TLS stream sizes", status));
    }
    return io.IoResult<void>.ok();
}

# Builds `certificate`'s chain with `engine` (null for the system's) and
# checks it as a server's for `host` or, when `host` is null and `client`,
# as a client's; the policy error, 0 when it passes.
[Target(OS(Windows))]
_tls_check_chain(engine: __ptr<void>, certificate: __ptr<u8>, host: __ptr<u8>, client: bool): uint {
    __ptr<u8> parameters = _pep_malloc(24);  # CERT_CHAIN_PARA
    _tls_set_u32(parameters, 0, 24);
    __ptr<__ptr<void>> chain = _pep_malloc(8);
    chain[0] = __null;
    var additional = _tls_pointer(certificate, 32);  # CERT_CONTEXT.hCertStore
    uint error = 2148204810;                         # CERT_E_CHAINING
    if (CertGetCertificateChain(engine, certificate, __null, additional, parameters, 0, __null, chain) != 0) {
        __ptr<u8> ssl = _pep_malloc(24);  # SSL_EXTRA_CERT_CHAIN_POLICY_PARA
        _tls_set_u32(ssl, 0, 24);
        uint authentication = 2;  # AUTHTYPE_SERVER
        if (client) {
            authentication = 1;  # AUTHTYPE_CLIENT
        }
        _tls_set_u32(ssl, 4, authentication);
        _tls_set_pointer(ssl, 16, host);
        __ptr<u8> policy = _pep_malloc(16);  # CERT_CHAIN_POLICY_PARA
        _tls_set_u32(policy, 0, 16);
        _tls_set_pointer(policy, 8, ssl);
        __ptr<u8> status = _pep_malloc(24);  # CERT_CHAIN_POLICY_STATUS
        _tls_set_u32(status, 0, 24);
        if (CertVerifyCertificateChainPolicy(4, chain[0], policy, status) != 0) {  # CERT_CHAIN_POLICY_SSL
            error = _tls_u32(status, 4);
        }
        _pep_free(status);
        _pep_free(policy);
        _pep_free(ssl);
        CertFreeCertificateChain(chain[0]);
    }
    _pep_free(chain);
    _pep_free(parameters);
    return error;
}

# Checks the server's certificate for the session's host: against the
# system's roots, then against only the added ones.
[Target(OS(Windows))]
_tls_verify(session: __ptr<u8>): io.IoResult<void> {
    __ptr<__ptr<u8>> remote = _pep_malloc(8);
    remote[0] = __null;
    var status = QueryContextAttributesW(session, 83, remote);  # SECPKG_ATTR_REMOTE_CERT_CONTEXT
    var certificate = remote[0];
    _pep_free(remote);
    if (status != _TLS_SEC_E_OK || certificate == __null) {
        return io.IoResult<void>.err(
            _tls_status_error("certificate verify failed: the server sent no certificate", status)
        );
    }
    var host = _tls_pointer(session, 96);
    var error = _tls_check_chain(__null, certificate, host, false);
    var roots = _tls_pointer(_tls_pointer(session, 24), 24);
    if (error != 0 && roots != __null) {
        # CERT_CHAIN_ENGINE_CONFIG (Windows 8 and later): 88 bytes,
        # hExclusiveRoot at 64.
        __ptr<u8> config = _pep_malloc(88);
        _tls_set_u32(config, 0, 88);
        _tls_set_pointer(config, 64, roots);
        __ptr<__ptr<void>> engine = _pep_malloc(8);
        engine[0] = __null;
        if (CertCreateCertificateChainEngine(config, engine) != 0) {
            var added_error = _tls_check_chain(engine[0], certificate, host, false);
            # A name mismatch found with the added roots says more than the
            # system's "untrusted root".
            if (added_error == 0 || error == 2148204809) {
                error = added_error;
            }
            CertFreeCertificateChainEngine(engine[0]);
        }
        _pep_free(engine);
        _pep_free(config);
    }
    CertFreeCertificateContext(certificate);
    if (error != 0) {
        return io.IoResult<void>.err(_tls_error($"certificate verify failed: {_tls_certificate_reason(error)}"));
    }
    return io.IoResult<void>.ok();
}

# Runs the client handshake on socket `h`, checking that the certificate is
# for `host` (a name, or an IP address).
[Target(OS(Windows))]
_tls_sys_connect(context: __ptr<void>, h: io.SocketHandle, host: String): io.IoResult<__ptr<void>> {
    var session = _tls_session_new(context, h, host);
    # SNI carries names only: an IP address goes to the certificate check.
    var target = _tls_pointer(session, 96);
    var by_address = io.IpAddress.parse(host).is_ok();
    if (by_address) {
        _tls_set_pointer(session, 96, __null);
    }
    var done = _tls_handshake(session);
    if (by_address) {
        _tls_set_pointer(session, 96, target);
    }
    if (done.is_ok()) {
        done = _tls_verify(session);
    }
    if (done.is_ok()) {
        done = _tls_query_sizes(session);
    }
    if (done.is_err()) {
        _tls_sys_session_free(session);
        return io.IoResult<__ptr<void>>.err(done.error());
    }
    return io.IoResult<__ptr<void>>.ok(session);
}

# Checks the client's certificate against only the context's roots for
# client certificates.
[Target(OS(Windows))]
_tls_verify_client(session: __ptr<u8>): io.IoResult<void> {
    var roots = _tls_pointer(_tls_pointer(session, 24), 48);
    __ptr<__ptr<u8>> remote = _pep_malloc(8);
    remote[0] = __null;
    var status = QueryContextAttributesW(session, 83, remote);  # SECPKG_ATTR_REMOTE_CERT_CONTEXT
    var certificate = remote[0];
    _pep_free(remote);
    if (status != _TLS_SEC_E_OK || certificate == __null) {
        return io.IoResult<void>.err(_tls_error("TLS handshake failed: the client sent no certificate"));
    }
    uint error = 2148204810;  # CERT_E_CHAINING
    # CERT_CHAIN_ENGINE_CONFIG (Windows 8 and later): 88 bytes,
    # hExclusiveRoot at 64.
    __ptr<u8> config = _pep_malloc(88);
    _tls_set_u32(config, 0, 88);
    _tls_set_pointer(config, 64, roots);
    __ptr<__ptr<void>> engine = _pep_malloc(8);
    engine[0] = __null;
    if (CertCreateCertificateChainEngine(config, engine) != 0) {
        error = _tls_check_chain(engine[0], certificate, __null, true);
        CertFreeCertificateChainEngine(engine[0]);
    }
    _pep_free(engine);
    _pep_free(config);
    CertFreeCertificateContext(certificate);
    if (error != 0) {
        return io.IoResult<void>.err(_tls_error($"certificate verify failed: {_tls_certificate_reason(error)}"));
    }
    return io.IoResult<void>.ok();
}

# Runs the server handshake on socket `h`, checking the client's certificate
# when the context asks for one.
[Target(OS(Windows))]
_tls_sys_accept(context: __ptr<void>, h: io.SocketHandle): io.IoResult<__ptr<void>> {
    var session = _tls_session_new(context, h, "");
    var done = _tls_handshake(session);
    if (done.is_ok() && _tls_pointer(context as __ptr<u8>, 48) != __null) {
        done = _tls_verify_client(session);
    }
    if (done.is_ok()) {
        done = _tls_query_sizes(session);
    }
    if (done.is_err()) {
        _tls_sys_session_free(session);
        return io.IoResult<__ptr<void>>.err(done.error());
    }
    return io.IoResult<__ptr<void>>.ok(session);
}

# Copies up to `n` decrypted bytes waiting in the session to `destination`.
[Target(OS(Windows))]
_tls_take_plain(session: __ptr<u8>, destination: __ptr<u8>, n: ulong): ulong {
    var start = _tls_word(session, 56);
    var end = _tls_word(session, 64);
    var take = end - start;
    if (take > n) {
        take = n;
    }
    _tls_copy(destination, _tls_pointer(session, 48) + start, take);
    _tls_set_word(session, 56, start + take);
    return take;
}

# Decrypts the waiting bytes; the status. Decrypted bytes go to the
# plaintext buffer and bytes after the record stay waiting.
[Target(OS(Windows))]
_tls_decrypt(session: __ptr<u8>): int {
    var desc = _tls_buffers(4);
    _tls_set_buffer(desc + 16, 0, _TLS_BUFFER_DATA, _tls_pointer(session, 32), _tls_word(session, 40));
    var status = DecryptMessage(session, desc, 0, __null);
    if (status == _TLS_SEC_E_OK || status == _TLS_SEC_I_RENEGOTIATE || status == _TLS_SEC_I_CONTEXT_EXPIRED) {
        ulong extra = 0;
        ulong i = 1;
        while (i < 4) {
            var buffer = _tls_buffer_at(desc, i);
            var kind = _tls_u32(buffer, 4);
            if (kind == _TLS_BUFFER_DATA) {
                var size = _tls_u32(buffer, 0) as ulong;
                _tls_copy(_tls_pointer(session, 48), _tls_pointer(buffer, 8), size);
                _tls_set_word(session, 56, 0);
                _tls_set_word(session, 64, size);
            } else if (kind == _TLS_BUFFER_EXTRA) {
                extra = _tls_u32(buffer, 0) as ulong;
            }
            i = i + 1;
        }
        _tls_keep_extra(session, extra);
    }
    _pep_free(desc);
    return status;
}

# Reads up to `n` decrypted bytes into `destination`; 0 at the end of the
# stream.
[Target(OS(Windows))]
_tls_sys_read(session: __ptr<void>, destination: __ptr<u8>, n: ulong): io.IoResult<ulong> {
    __ptr<u8> block = session;
    while (true) {
        if (_tls_word(block, 64) > _tls_word(block, 56)) {
            return io.IoResult<ulong>.ok(_tls_take_plain(block, destination, n));
        }
        if (_tls_word(block, 88) != 0) {
            return io.IoResult<ulong>.ok(0);
        }
        var status = _TLS_SEC_E_INCOMPLETE_MESSAGE;
        if (_tls_word(block, 40) > 0) {
            status = _tls_decrypt(block);
        }
        if (status == _TLS_SEC_I_CONTEXT_EXPIRED) {
            # close_notify
            _tls_set_word(block, 88, 1);
        } else if (status == _TLS_SEC_I_RENEGOTIATE) {
            # TLS 1.3 post-handshake messages (a session ticket, a key
            # update): the waiting bytes go back through the handshake.
            var again = _tls_handshake(block);
            if (again.is_err()) {
                return io.IoResult<ulong>.err(again.error());
            }
        } else if (status == _TLS_SEC_E_INCOMPLETE_MESSAGE) {
            var got = _tls_receive(block);
            if (got.is_err()) {
                return io.IoResult<ulong>.err(got.error());
            }
            if (got.value() == 0) {
                # The peer closed the socket without close_notify: the end
                # of the stream, as with OpenSSL's SSL_OP_IGNORE_UNEXPECTED_EOF.
                _tls_set_word(block, 88, 1);
            }
        } else if (status != _TLS_SEC_E_OK) {
            return io.IoResult<ulong>.err(_tls_status_error("TLS read failed", status));
        }
    }
    return io.IoResult<ulong>.ok(0);
}

# Encrypts and sends up to `n` bytes from `source`: at most one TLS record.
[Target(OS(Windows))]
_tls_sys_write(session: __ptr<void>, source: __ptr<u8>, n: ulong): io.IoResult<ulong> {
    if (n == 0) {
        return io.IoResult<ulong>.ok(0);
    }
    __ptr<u8> block = session;
    var header = _tls_u32(block, 72) as ulong;
    var trailer = _tls_u32(block, 76) as ulong;
    var chunk = _tls_u32(block, 80) as ulong;
    if (chunk > n) {
        chunk = n;
    }
    __ptr<u8> record = _pep_malloc(header + chunk + trailer);
    _tls_copy(record + header, source, chunk);
    var desc = _tls_buffers(4);
    _tls_set_buffer(desc + 16, 0, _TLS_BUFFER_HEADER, record, header);
    _tls_set_buffer(desc + 16, 1, _TLS_BUFFER_DATA, record + header, chunk);
    _tls_set_buffer(desc + 16, 2, _TLS_BUFFER_TRAILER, record + header + chunk, trailer);
    _tls_set_buffer(desc + 16, 3, _TLS_BUFFER_EMPTY, __null, 0);
    var status = EncryptMessage(block, 0, desc, 0);
    var result = io.IoResult<ulong>.ok(chunk);
    if (status != _TLS_SEC_E_OK) {
        result = io.IoResult<ulong>.err(_tls_status_error("TLS write failed", status));
    } else {
        var size = _tls_u32(_tls_buffer_at(desc, 0), 0) as ulong;
        size = size + _tls_u32(_tls_buffer_at(desc, 1), 0) as ulong;
        size = size + _tls_u32(_tls_buffer_at(desc, 2), 0) as ulong;
        var sent = _tls_send_all(block, record, size);
        if (sent.is_err()) {
            result = io.IoResult<ulong>.err(sent.error());
        }
    }
    _pep_free(desc);
    _pep_free(record);
    return result;
}

# Sends close_notify.
[Target(OS(Windows))]
_tls_sys_shutdown(session: __ptr<void>): io.IoResult<void> {
    __ptr<u8> block = session;
    __ptr<uint> kind = _pep_malloc(4);
    kind[0] = 1;  # SCHANNEL_SHUTDOWN
    var desc = _tls_buffers(1);
    _tls_set_buffer(desc + 16, 0, _TLS_BUFFER_TOKEN, unsafe_cast<__ptr<u8>>(kind), 4);
    var status = ApplyControlToken(block, desc);
    _pep_free(desc);
    _pep_free(kind);
    if (status != _TLS_SEC_E_OK) {
        return io.IoResult<void>.err(_tls_status_error("TLS shutdown failed", status));
    }
    # The next call produces the close_notify alert.
    var output = _tls_buffers(1);
    _tls_set_buffer(output + 16, 0, _TLS_BUFFER_TOKEN, __null, 0);
    __ptr<uint> attributes = _pep_malloc(4);
    __ptr<u8> expiry = _pep_malloc(8);
    var context = _tls_pointer(block, 24);
    if (_tls_session_server(block)) {
        status = AcceptSecurityContext(
            context, block, __null, _TLS_SERVER_REQUEST, 0, block, output, attributes, expiry
        );
    } else {
        status = InitializeSecurityContextW(
            context,
            block,
            _tls_pointer(block, 96),
            _TLS_CLIENT_REQUEST,
            0,
            0,
            __null,
            0,
            block,
            output,
            attributes,
            expiry
        );
    }
    _pep_free(expiry);
    _pep_free(attributes);
    var sent = _tls_send_token(block, output);
    _pep_free(output);
    if (status != _TLS_SEC_E_OK && status != _TLS_SEC_I_CONTEXT_EXPIRED) {
        return io.IoResult<void>.err(_tls_status_error("TLS shutdown failed", status));
    }
    return sent;
}

# Deletes the security context and frees the block.
[Target(OS(Windows))]
_tls_sys_session_free(session: __ptr<void>) {
    __ptr<u8> block = session;
    if (_tls_session_started(block)) {
        DeleteSecurityContext(block);
    }
    _pep_free(_tls_pointer(block, 32));
    _pep_free(_tls_pointer(block, 48));
    var host = _tls_pointer(block, 96);
    if (host != __null) {
        _pep_free(host);
    }
    _pep_free(block);
}
tls/securetransport
25558
# The Security.framework layer for tls on iOS. Every declaration carries
# [Target(OS(IOS))]; openssl.pep, schannel.pep and wasi.pep declare the same
# `_tls_sys_*` functions for the other systems. It shares openssl.pep's
# session block (`_tls_session_ssl`, `_tls_session_error`), `_tls_error` and
# `_tls_symbol`, and schannel.pep's `_tls_pem_blocks`.
#
# iOS ships no OpenSSL. Secure Transport (SSLContext) is the platform's one
# TLS engine that runs over a socket the program already has, through I/O
# callbacks, as OpenSSL's BIO does: Network.framework opens its own
# connections, so it cannot take a `TcpStream`. Secure Transport is
# deprecated and speaks TLS 1.2 at most, but it is in every iOS SDK.
# Security.framework and CoreFoundation are opened at run time (dlopen), as
# libssl is elsewhere, so linking needs no `-framework`.
#
# The read and write callbacks call the io socket layer, which parks a task
# when the socket would block, so they never return errSSLWouldBlock. The
# handshake stops after the server's certificate arrives
# (kSSLSessionOptionBreakOnServerAuth) so that this layer checks it with
# SecTrust: the system's roots and those added with `add_root_certificate`,
# under the SSL policy for the host name or IP address.
#
# Only the client side is here: a server, or a client presenting a
# certificate, needs a SecIdentity, which iOS makes only from the keychain or
# a PKCS #12 file, so those return an error for now.
#
# A context is a malloc'd block of two words: the added roots (a
# CFMutableArray of SecCertificates, or null) and the ALPN protocols (a
# CFMutableArray of CFStrings, or null). A session is openssl.pep's block:
# the SSLContext, the socket, and the io error a callback met.

import async;
import io;
import "openssl";
import "schannel";
import "wasi";

# OSStatus values (SecureTransport.h).
const _TLS_ST_CLOSED_GRACEFUL: int = -9805;
const _TLS_ST_CLOSED_ABORT: int = -9806;
const _TLS_ST_CLOSED_NO_NOTIFY: int = -9816;
const _TLS_ST_PEER_AUTH_COMPLETED: int = -9841;
# kCFStringEncodingUTF8.
const _TLS_ST_UTF8: uint = 134217984;

# The Security.framework and CoreFoundation functions tls calls, or none when
# they could not be opened.
[Target(OS(IOS))]
[Shared]
struct _SecureTransport {
    # Whether both frameworks were opened; every other field is null
    # otherwise.
    const _loaded: bool;
    const _create_context: extern (__ptr<void>, int, int) => __ptr<void>;
    const _set_io: extern (__ptr<void>, __ptr<void>, __ptr<void>) => int;
    const _set_connection: extern (__ptr<void>, __ptr<void>) => int;
    const _set_peer_name: extern (__ptr<void>, __ptr<void>, ulong) => int;
    const _set_min_version: extern (__ptr<void>, int) => int;
    const _set_option: extern (__ptr<void>, int, u8) => int;
    const _set_alpn: extern (__ptr<void>, __ptr<void>) => int;
    const _copy_alpn: extern (__ptr<void>, __ptr<void>) => int;
    const _handshake: extern (__ptr<void>) => int;
    const _read: extern (__ptr<void>, __ptr<void>, ulong, __ptr<void>) => int;
    const _buffered: extern (__ptr<void>, __ptr<void>) => int;
    const _write: extern (__ptr<void>, __ptr<void>, ulong, __ptr<void>) => int;
    const _close: extern (__ptr<void>) => int;
    const _copy_peer_trust: extern (__ptr<void>, __ptr<void>) => int;
    const _trust_set_policies: extern (__ptr<void>, __ptr<void>) => int;
    const _trust_set_anchors: extern (__ptr<void>, __ptr<void>) => int;
    const _trust_set_anchors_only: extern (__ptr<void>, u8) => int;
    const _trust_evaluate: extern (__ptr<void>, __ptr<void>) => u8;
    const _policy_ssl: extern (u8, __ptr<void>) => __ptr<void>;
    const _certificate_create: extern (__ptr<void>, __ptr<void>) => __ptr<void>;
    const _status_message: extern (int, __ptr<void>) => __ptr<void>;
    const _release: extern (__ptr<void>) => void;
    const _array_create: extern (__ptr<void>, long, __ptr<void>) => __ptr<void>;
    const _array_append: extern (__ptr<void>, __ptr<void>) => void;
    const _array_count: extern (__ptr<void>) => long;
    const _array_at: extern (__ptr<void>, long) => __ptr<void>;
    const _string_create: extern (__ptr<void>, __ptr<void>, long, uint, u8) => __ptr<void>;
    const _string_bytes: extern (__ptr<void>, __ptr<void>, long, uint) => u8;
    const _data_create: extern (__ptr<void>, __ptr<void>, long) => __ptr<void>;
    const _error_description: extern (__ptr<void>) => __ptr<void>;
    # kCFTypeArrayCallBacks, the callbacks of an array of CF objects.
    const _array_callbacks: __ptr<void>;

    construct() {
        var security = dlopen("/System/Library/Frameworks/Security.framework/Security".c_str(), 2);  # RTLD_NOW
        var foundation = dlopen("/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation".c_str(), 2);
        _loaded = security != __null && foundation != __null;
        if (_loaded) {
            _create_context = _tls_symbol(
                security, "SSLCreateContext"
            ) as extern (__ptr<void>, int, int) => __ptr<void>;
            _set_io = _tls_symbol(security, "SSLSetIOFuncs") as extern (__ptr<void>, __ptr<void>, __ptr<void>) => int;
            _set_connection = _tls_symbol(security, "SSLSetConnection") as extern (__ptr<void>, __ptr<void>) => int;
            _set_peer_name = _tls_symbol(
                security, "SSLSetPeerDomainName"
            ) as extern (__ptr<void>, __ptr<void>, ulong) => int;
            _set_min_version = _tls_symbol(security, "SSLSetProtocolVersionMin") as extern (__ptr<void>, int) => int;
            _set_option = _tls_symbol(security, "SSLSetSessionOption") as extern (__ptr<void>, int, u8) => int;
            _set_alpn = _tls_symbol(security, "SSLSetALPNProtocols") as extern (__ptr<void>, __ptr<void>) => int;
            _copy_alpn = _tls_symbol(security, "SSLCopyALPNProtocols") as extern (__ptr<void>, __ptr<void>) => int;
            _handshake = _tls_symbol(security, "SSLHandshake") as extern (__ptr<void>) => int;
            _read = _tls_symbol(security, "SSLRead") as extern (__ptr<void>, __ptr<void>, ulong, __ptr<void>) => int;
            _buffered = _tls_symbol(security, "SSLGetBufferedReadSize") as extern (__ptr<void>, __ptr<void>) => int;
            _write = _tls_symbol(security, "SSLWrite") as extern (__ptr<void>, __ptr<void>, ulong, __ptr<void>) => int;
            _close = _tls_symbol(security, "SSLClose") as extern (__ptr<void>) => int;
            _copy_peer_trust = _tls_symbol(security, "SSLCopyPeerTrust") as extern (__ptr<void>, __ptr<void>) => int;
            _trust_set_policies = _tls_symbol(
                security, "SecTrustSetPolicies"
            ) as extern (__ptr<void>, __ptr<void>) => int;
            _trust_set_anchors = _tls_symbol(
                security, "SecTrustSetAnchorCertificates"
            ) as extern (__ptr<void>, __ptr<void>) => int;
            _trust_set_anchors_only = _tls_symbol(
                security, "SecTrustSetAnchorCertificatesOnly"
            ) as extern (__ptr<void>, u8) => int;
            _trust_evaluate = _tls_symbol(
                security, "SecTrustEvaluateWithError"
            ) as extern (__ptr<void>, __ptr<void>) => u8;
            _policy_ssl = _tls_symbol(security, "SecPolicyCreateSSL") as extern (u8, __ptr<void>) => __ptr<void>;
            _certificate_create = _tls_symbol(
                security, "SecCertificateCreateWithData"
            ) as extern (__ptr<void>, __ptr<void>) => __ptr<void>;
            _status_message = _tls_symbol(
                security, "SecCopyErrorMessageString"
            ) as extern (int, __ptr<void>) => __ptr<void>;
            _release = _tls_symbol(foundation, "CFRelease") as extern (__ptr<void>) => void;
            _array_create = _tls_symbol(
                foundation, "CFArrayCreateMutable"
            ) as extern (__ptr<void>, long, __ptr<void>) => __ptr<void>;
            _array_append = _tls_symbol(foundation, "CFArrayAppendValue") as extern (__ptr<void>, __ptr<void>) => void;
            _array_count = _tls_symbol(foundation, "CFArrayGetCount") as extern (__ptr<void>) => long;
            _array_at = _tls_symbol(foundation, "CFArrayGetValueAtIndex") as extern (__ptr<void>, long) => __ptr<void>;
            _string_create = _tls_symbol(
                foundation, "CFStringCreateWithBytes"
            ) as extern (__ptr<void>, __ptr<void>, long, uint, u8) => __ptr<void>;
            _string_bytes = _tls_symbol(
                foundation, "CFStringGetCString"
            ) as extern (__ptr<void>, __ptr<void>, long, uint) => u8;
            _data_create = _tls_symbol(
                foundation, "CFDataCreate"
            ) as extern (__ptr<void>, __ptr<void>, long) => __ptr<void>;
            _error_description = _tls_symbol(
                foundation, "CFErrorCopyDescription"
            ) as extern (__ptr<void>) => __ptr<void>;
            _array_callbacks = _tls_symbol(foundation, "kCFTypeArrayCallBacks");
        }
    }
}

[Target(OS(IOS))]
const _tls_secure_transport = async.Lazy<_SecureTransport>(() => {
    return _SecureTransport();
});

# ── CoreFoundation values ────────────────────────────────────────────────────

# `text` as a CFString (to release), or null.
[Target(OS(IOS))]
_tls_st_string(st: _SecureTransport, text: __ptr<u8>, size: ulong): __ptr<void> {
    var create = st._string_create;
    return create(__null, text, size as long, _TLS_ST_UTF8, 0);
}

# The text of a CFString (not released here); "" for null.
[Target(OS(IOS))]
_tls_st_text(st: _SecureTransport, value: __ptr<void>): String {
    if (value == __null) {
        return "";
    }
    var bytes = st._string_bytes;
    __ptr<char> buffer = _pep_malloc(4096);
    var text = "";
    if (bytes(value, buffer, 4096, _TLS_ST_UTF8) != 0) {
        text = String(buffer);
    }
    _pep_free(buffer);
    return text;
}

# Releases a CF object that may be null.
[Target(OS(IOS))]
_tls_st_release(st: _SecureTransport, value: __ptr<void>) {
    if (value != __null) {
        var release = st._release;
        release(value);
    }
}

# ── Errors ───────────────────────────────────────────────────────────────────

# `what`, then the system's words for `status`.
[Target(OS(IOS))]
_tls_st_status_error(what: String, status: int): io.IoError {
    var st = _tls_secure_transport.get();
    var message = st._status_message;
    var words = message(status, __null);
    var text = _tls_st_text(st, words);
    _tls_st_release(st, words);
    if (text.size == 0) {
        return _tls_error($"{what} (OSStatus {status})");
    }
    return _tls_error($"{what}: {text} (OSStatus {status})");
}

# Why a Secure Transport call on `session` that returned `status` failed: the
# io error a callback met, or the status.
[Target(OS(IOS))]
_tls_st_failure(session: __ptr<void>, status: int, what: String): io.IoError {
    var slot = _tls_session_error(session);
    if (slot[0] != __null) {
        var e = slot[0];
        slot[0] = __default<io.IoError>();
        return e;
    }
    return _tls_st_status_error(what, status);
}

# The error of what iOS does not do yet. ENOTSUP.
[Target(OS(IOS))]
_tls_st_unsupported(what: String): io.IoError {
    return io.IoError(45, $"{what} is not supported on iOS yet");
}

# ── Contexts ─────────────────────────────────────────────────────────────────

[Target(OS(IOS))]
_tls_sys_client_context(): io.IoResult<__ptr<void>> {
    if (!_tls_secure_transport.get()._loaded) {
        return io.IoResult<__ptr<void>>.err(_tls_error("cannot open Security.framework"));
    }
    __ptr<__ptr<void>> block = _pep_malloc(2 * sizeof<ulong>());
    block[0] = __null;
    block[1] = __null;
    return io.IoResult<__ptr<void>>.ok(block);
}

[Target(OS(IOS))]
_tls_sys_server_context(chain: io.Path, key: io.Path): io.IoResult<__ptr<void>> {
    return io.IoResult<__ptr<void>>.err(_tls_st_unsupported("a TLS server"));
}

[Target(OS(IOS))]
_tls_sys_set_identity(context: __ptr<void>, chain: io.Path, key: io.Path): io.IoResult<void> {
    return io.IoResult<void>.err(_tls_st_unsupported("a TLS client certificate"));
}

# No server context exists on iOS, so nothing calls it.
[Target(OS(IOS))]
_tls_sys_require_client_certificate(context: __ptr<void>, roots: io.Path): io.IoResult<void> {
    return io.IoResult<void>.err(_tls_st_unsupported("a TLS server"));
}

# Also trusts the PEM certificates in `path`.
[Target(OS(IOS))]
_tls_sys_add_root(context: __ptr<void>, path: io.Path): io.IoResult<void> {
    var text = io.File.read_to_string(path);
    if (text.is_err()) {
        return io.IoResult<void>.err(_tls_error($"cannot read the certificates '{path}': {text.error().message}"));
    }
    var certificates = _tls_pem_blocks(text.value(), "CERTIFICATE");
    if (certificates.count == 0) {
        return io.IoResult<void>.err(_tls_error($"cannot load the certificates in '{path}': none found"));
    }
    var st = _tls_secure_transport.get();
    __ptr<__ptr<void>> block = context;
    if (block[0] == __null) {
        var create = st._array_create;
        block[0] = create(__null, 0, st._array_callbacks);
    }
    for (var der in certificates) {
        var data_create = st._data_create;
        var data = data_create(__null, der._data, der._size as long);
        var certificate_create = st._certificate_create;
        var certificate = certificate_create(__null, data);
        _tls_st_release(st, data);
        if (certificate == __null) {
            return io.IoResult<void>.err(_tls_error($"cannot load the certificates in '{path}'"));
        }
        var append = st._array_append;
        append(block[0], certificate);
        _tls_st_release(st, certificate);
    }
    return io.IoResult<void>.ok();
}

# Sets the protocols a client offers through ALPN: `list` is in the wire
# format, each name after its length. A server context does not exist here.
[Target(OS(IOS))]
_tls_sys_set_protocols(context: __ptr<void>, list: u8[], server: bool): io.IoResult<void> {
    var st = _tls_secure_transport.get();
    __ptr<__ptr<void>> block = context;
    _tls_st_release(st, block[1]);
    var create = st._array_create;
    var protocols = create(__null, 0, st._array_callbacks);
    ulong index = 0;
    while (index < list.count) {
        var size = list[index] as ulong;
        var name = _tls_st_string(st, list._data + index + 1, size);
        var append = st._array_append;
        append(protocols, name);
        _tls_st_release(st, name);
        index += 1 + size;
    }
    block[1] = protocols;
    return io.IoResult<void>.ok();
}

# The protocol the handshake chose through ALPN, or "" for none.
[Target(OS(IOS))]
_tls_sys_protocol(session: __ptr<void>): String {
    var st = _tls_secure_transport.get();
    var copy = st._copy_alpn;
    __ptr<__ptr<void>> out = _pep_malloc(sizeof<ulong>());
    out[0] = __null;
    var name = "";
    if (copy(_tls_session_ssl(session), out) == 0 && out[0] != __null) {
        var count = st._array_count;
        if (count(out[0]) > 0) {
            var at = st._array_at;
            name = _tls_st_text(st, at(out[0], 0));
        }
    }
    _tls_st_release(st, out[0]);
    _pep_free(out);
    return name;
}

[Target(OS(IOS))]
_tls_sys_context_free(context: __ptr<void>) {
    var st = _tls_secure_transport.get();
    __ptr<__ptr<void>> block = context;
    _tls_st_release(st, block[0]);
    _tls_st_release(st, block[1]);
    _pep_free(context);
}

# ── Connections ──────────────────────────────────────────────────────────────

# SSLReadFunc: reads exactly `length[0]` bytes, or reports how many arrived
# before the end of the stream or an io error.
[Target(OS(IOS))]
_tls_st_read(connection: __ptr<void>, data: __ptr<void>, length: __ptr<ulong>): int {
    __ptr<ulong> block = connection;
    __ptr<u8> destination = data;
    var wanted = length[0];
    ulong done = 0;
    while (done < wanted) {
        var r = io._io_sys_socket_receive(block[1] as io.SocketHandle, destination + done, wanted - done);
        if (r.is_err()) {
            _tls_session_error(connection)[0] = r.error();
            length[0] = done;
            return _TLS_ST_CLOSED_ABORT;
        }
        if (r.value() == 0) {
            length[0] = done;
            return _TLS_ST_CLOSED_NO_NOTIFY;
        }
        done += r.value();
    }
    return 0;
}

# SSLWriteFunc: sends all `length[0]` bytes, or reports how many went before
# an io error.
[Target(OS(IOS))]
_tls_st_write(connection: __ptr<void>, data: __ptr<void>, length: __ptr<ulong>): int {
    __ptr<ulong> block = connection;
    __ptr<u8> source = data;
    var wanted = length[0];
    ulong done = 0;
    while (done < wanted) {
        var r = io._io_sys_socket_send(block[1] as io.SocketHandle, source + done, wanted - done);
        if (r.is_err() || r.value() == 0) {
            _tls_session_error(connection)[0] = r.is_err() ?
                r.error() :
                io.IoError(io._io_sys_code_write_zero(), "failed to write the whole buffer");
            length[0] = done;
            return _TLS_ST_CLOSED_ABORT;
        }
        done += r.value();
    }
    return 0;
}

# Checks the server's certificate, which the handshake stopped for, against
# the system's roots and `context`'s, for `host`.
[Target(OS(IOS))]
_tls_st_check_server(
    st: _SecureTransport, context: __ptr<void>, connection: __ptr<void>, host: String
): io.IoResult<void> {
    __ptr<__ptr<void>> out = _pep_malloc(sizeof<ulong>());
    out[0] = __null;
    var copy_trust = st._copy_peer_trust;
    if (copy_trust(connection, out) != 0 || out[0] == __null) {
        _pep_free(out);
        return io.IoResult<void>.err(_tls_error("certificate verify failed: the server sent no certificate"));
    }
    var trust = out[0];
    var name = _tls_st_string(st, unsafe_cast<__ptr<u8>>(host.c_str()), host.size);
    var policy_ssl = st._policy_ssl;
    var policy = policy_ssl(1, name);  # a server's certificate, for `host`
    var set_policies = st._trust_set_policies;
    set_policies(trust, policy);
    __ptr<__ptr<void>> block = context;
    if (block[0] != __null) {
        var set_anchors = st._trust_set_anchors;
        var set_anchors_only = st._trust_set_anchors_only;
        set_anchors(trust, block[0]);
        set_anchors_only(trust, 0);  # the system's roots as well
    }
    out[0] = __null;
    var evaluate = st._trust_evaluate;
    var trusted = evaluate(trust, out) != 0;
    var reason = "";
    if (!trusted && out[0] != __null) {
        var describe = st._error_description;
        var words = describe(out[0]);
        reason = _tls_st_text(st, words);
        _tls_st_release(st, words);
    }
    _tls_st_release(st, out[0]);
    _pep_free(out);
    _tls_st_release(st, policy);
    _tls_st_release(st, name);
    _tls_st_release(st, trust);
    if (!trusted) {
        return io.IoResult<void>.err(_tls_error($"certificate verify failed: {reason}"));
    }
    return io.IoResult<void>.ok();
}

# Runs the client handshake on socket `h`, checking that the certificate is
# for `host` (a name, or an IP address).
[Target(OS(IOS))]
_tls_sys_connect(context: __ptr<void>, h: io.SocketHandle, host: String): io.IoResult<__ptr<void>> {
    var st = _tls_secure_transport.get();
    var create = st._create_context;
    var connection = create(__null, 1, 0);  # kSSLClientSide, kSSLStreamType
    if (connection == __null) {
        return io.IoResult<__ptr<void>>.err(_tls_error("cannot create a TLS connection"));
    }
    __ptr<void> session = _pep_malloc(3 * sizeof<ulong>());
    __ptr<__ptr<void>> words = session;
    words[0] = connection;
    words[2] = __null;
    __ptr<ulong> numbers = session;
    numbers[1] = h as ulong;
    var set_io = st._set_io;
    var set_connection = st._set_connection;
    var set_min_version = st._set_min_version;
    var set_option = st._set_option;
    set_io(connection, __function_pointer(_tls_st_read), __function_pointer(_tls_st_write));
    set_connection(connection, session);
    set_min_version(connection, 8);  # kTLSProtocol12
    set_option(connection, 0, 1);    # kSSLSessionOptionBreakOnServerAuth
    if (io.IpAddress.parse(host).is_err()) {
        var set_peer_name = st._set_peer_name;
        set_peer_name(connection, host.c_str(), host.size);  # SNI
    }
    __ptr<__ptr<void>> block = context;
    if (block[1] != __null) {
        var set_alpn = st._set_alpn;
        set_alpn(connection, block[1]);
    }
    var handshake = st._handshake;
    var status = handshake(connection);
    var verified = false;
    if (status == _TLS_ST_PEER_AUTH_COMPLETED) {
        var checked = _tls_st_check_server(st, context, connection, host);
        if (checked.is_err()) {
            _tls_sys_session_free(session);
            return io.IoResult<__ptr<void>>.err(checked.error());
        }
        verified = true;
        status = handshake(connection);
    }
    if (status != 0) {
        var e = _tls_st_failure(session, status, "TLS handshake failed");
        _tls_sys_session_free(session);
        return io.IoResult<__ptr<void>>.err(e);
    }
    # Secure Transport checks nothing itself here, so a handshake that never
    # stopped for the server's certificate is refused, not trusted.
    if (!verified) {
        _tls_sys_session_free(session);
        return io.IoResult<__ptr<void>>.err(
            _tls_error("certificate verify failed: the server's certificate was not checked")
        );
    }
    return io.IoResult<__ptr<void>>.ok(session);
}

# No server context exists on iOS, so nothing calls it.
[Target(OS(IOS))]
_tls_sys_accept(context: __ptr<void>, h: io.SocketHandle): io.IoResult<__ptr<void>> {
    return io.IoResult<__ptr<void>>.err(_tls_st_unsupported("a TLS server"));
}

# Reads up to `n` decrypted bytes into `destination`; 0 at the end of the
# stream.
[Target(OS(IOS))]
_tls_sys_read(session: __ptr<void>, destination: __ptr<u8>, n: ulong): io.IoResult<ulong> {
    var st = _tls_secure_transport.get();
    var connection = _tls_session_ssl(session);
    __ptr<ulong> processed = _pep_malloc(sizeof<ulong>());
    # SSLRead reads another record after copying what it holds when that
    # falls short of `n`, and a read callback here waits for it: ask for no
    # more than it holds, so that a read never waits with data at hand.
    processed[0] = 0;
    var buffered = st._buffered;
    var limit = n;
    if (buffered(connection, processed) == 0 && processed[0] > 0 && processed[0] < n) {
        limit = processed[0];
    }
    var read = st._read;
    var status = 0;
    # A record with no application data (a TLS 1.2 renegotiation's) reads
    # nothing and succeeds; that is not the end of the stream.
    processed[0] = 0;
    while (status == 0 && processed[0] == 0) {
        status = read(connection, destination, limit, processed);
    }
    var count = processed[0];
    _pep_free(processed);
    if (count > 0) {
        return io.IoResult<ulong>.ok(count);
    }
    if (_tls_session_error(session)[0] == __null) {
        if (status == _TLS_ST_CLOSED_GRACEFUL || status == _TLS_ST_CLOSED_NO_NOTIFY) {
            return io.IoResult<ulong>.ok(0);
        }
    }
    return io.IoResult<ulong>.err(_tls_st_failure(session, status, "TLS read failed"));
}

# Encrypts and sends up to `n` bytes from `source`.
[Target(OS(IOS))]
_tls_sys_write(session: __ptr<void>, source: __ptr<u8>, n: ulong): io.IoResult<ulong> {
    if (n == 0) {
        return io.IoResult<ulong>.ok(0);
    }
    var write = _tls_secure_transport.get()._write;
    __ptr<ulong> processed = _pep_malloc(sizeof<ulong>());
    processed[0] = 0;
    var status = write(_tls_session_ssl(session), source, n, processed);
    var count = processed[0];
    _pep_free(processed);
    if (status == 0 || count > 0) {
        return io.IoResult<ulong>.ok(count);
    }
    return io.IoResult<ulong>.err(_tls_st_failure(session, status, "TLS write failed"));
}

# Sends close_notify.
[Target(OS(IOS))]
_tls_sys_shutdown(session: __ptr<void>): io.IoResult<void> {
    var close = _tls_secure_transport.get()._close;
    var status = close(_tls_session_ssl(session));
    if (status != 0) {
        return io.IoResult<void>.err(_tls_st_failure(session, status, "TLS shutdown failed"));
    }
    return io.IoResult<void>.ok();
}

# Releases the SSLContext and frees the block.
[Target(OS(IOS))]
_tls_sys_session_free(session: __ptr<void>) {
    _tls_st_release(_tls_secure_transport.get(), _tls_session_ssl(session));
    _tls_session_error(session)[0] = __default<io.IoError>();
    _pep_free(session);
}
