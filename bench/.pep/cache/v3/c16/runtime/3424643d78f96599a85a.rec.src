## The running program's arguments and exit, kept for the deprecated
## prelude `arguments()` and `exit()`; the `process` module has them now.

# Imported so the allocator's globals exist before `_pep_forked`'s.
import "internals";

[Target(OS(Linux))]
extern void* fopen(char* path, char* mode);
[Target(OS(Linux))]
extern ulong fread(void* buffer, ulong size, ulong count, void* stream);
[Target(OS(Linux))]
extern int fclose(void* stream);
[Target(OS(Mac))]
extern int* _NSGetArgc();
[Target(OS(Mac))]
extern void* _NSGetArgv();
[Target(OS(Windows))]
extern int* __p___argc();
[Target(OS(Windows))]
extern void* __p___argv();
[Target(OS(Windows))]
extern void* __p___wargv();
# The Universal CRT fills `__wargv` only for a `wmain`, or when asked here.
[Target(OS(Windows))]
extern int _configure_wide_argv(int mode);
[Target(OS(Windows))]
extern ulong wcslen(ushort* text);
[Target(OS(Windows))]
extern void* malloc(ulong size);
[Target(OS(Windows))]
extern void free(void* pointer);
[Target(OS(Windows))]
extern void memcpy(void* dest, void* src, ulong n);
[Target(OS(Windows))]
extern int WideCharToMultiByte(
    uint codepage, uint flags, ushort* src, int src_len, char* dst, int dst_len, void* default_char, int* used_default
);
[Target(OS(Wasi))]
extern ushort __wasi_args_sizes_get(void* count, void* buffer_size);
[Target(OS(Wasi))]
extern ushort __wasi_args_get(void* values, void* buffer);
extern void _Exit(int status);
extern int fflush(void* stream);
# C's `exit`.
[Link(name = "exit")]
extern void _c_exit(int status);

# Nonzero in the copy `process.fork()` starts: its exit skips the parent's
# `atexit` handlers. Process-wide, so a thread the copy starts skips them too.
const _pep_forked: __ptr<int> = _pep_new_forked_flag();

_pep_new_forked_flag(): __ptr<int> {
    __ptr<int> flag = _pep_malloc(4);
    flag[0] = 0;
    return flag;
}

## Deprecated: use `process.arguments` instead.
##
## Returns the program's command-line arguments, as `process.arguments()`
## does.
##
## @returns the program name followed by its arguments
[Deprecated("use 'process.arguments' instead (import process)")]
export arguments(): Array<String> {
    return _arguments();
}

# The arguments a `main(args: String[])` receives: the compiler's
# synthesized `main()` calls this (sema's `lower_main_arguments`), under a
# name a program's own `arguments` cannot shadow. `process.arguments()`
# calls it too.
export _pep_arguments(): Array<String> {
    return _arguments();
}

## Deprecated: use `process.exit` instead.
##
## Ends the program at once with status `code`, as `process.exit(code)`
## does: C's `atexit` handlers run and the C output streams are flushed.
##
## @param code the exit status: 0 for success, anything else for failure
[Deprecated("use 'process.exit' instead (import process)")]
export exit(code: int) {
    _pep_exit(code);
}

# Ends the program: `process.exit` and the deprecated `exit`. C's `exit`
# runs the `atexit` handlers and flushes C stdio; a forked copy ends as
# `_pep_exit_now` does.
export _pep_exit(code: int) {
    if (__atomic_load<int>(_pep_forked) != 0) {
        _pep_exit_now(code);
    }
    _c_exit(code);
}

# Ends the program without running `atexit` handlers, after flushing C
# stdio: a forked copy, whose handlers are the parent's, Windows' `exec`,
# which stands in for replacing the process, and a test's watchdog.
export _pep_exit_now(code: int) {
    fflush(__null);
    _Exit(code);
}

# Marks this process as a forked copy, for `_pep_exit`.
export _pep_mark_forked() {
    __atomic_store<int>(_pep_forked, 1);
}

# The arguments from the C runtime's `argc`/`argv`.
_arguments_from(count: int, values: __ptr<__ptr<char>>): Array<String> {
    var result = Array<String>();
    var index = 0;
    while (index < count) {
        result.append(String(values[index]));
        index = index + 1;
    }
    return result;
}

[Target(OS(Mac))]
_arguments(): Array<String> {
    __ptr<void> raw = _NSGetArgv();
    __ptr<__ptr<__ptr<char>>> values = raw;
    return _arguments_from(_NSGetArgc()[0], values[0]);
}

# Windows' `argv` is in the ANSI code page, which cannot hold every
# character and is not UTF-8: read the UTF-16 one, split by the same rules.
[Target(OS(Windows))]
_arguments(): Array<String> {
    return _arguments_from(__p___argc()[0], _utf8_argv());
}

# The UTF-8 `argv` `_arguments` reads, converted on the first call and kept
# for the program's life, so a later call costs what the C `argv` does.
[Target(OS(Windows))]
const _pep_utf8_argv: __ptr<ulong> = _pep_new_utf8_argv_slot();

[Target(OS(Windows))]
_pep_new_utf8_argv_slot(): __ptr<ulong> {
    __ptr<ulong> slot = _pep_malloc(8);
    slot[0] = 0;
    return slot;
}

[Target(OS(Windows))]
_utf8_argv(): __ptr<__ptr<char>> {
    var kept = __atomic_load<ulong>(_pep_utf8_argv);
    if (kept != 0) {
        return unsafe_cast<__ptr<__ptr<char>>>(kept);
    }
    __ptr<void> raw = __p___wargv();
    __ptr<__ptr<__ptr<u16>>> wide = raw;
    if (wide[0] == __null) {
        _configure_wide_argv(1);  # _crt_argv_unexpanded_arguments
    }
    if (wide[0] == __null) {
        # Out of memory: the ANSI arguments are better than none.
        __ptr<void> narrow = __p___argv();
        __ptr<__ptr<__ptr<char>>> values = narrow;
        return values[0];
    }
    # C's `malloc`, not `_pep_malloc`: kept for good, it is no test's leak.
    var count = __p___argc()[0] as ulong;
    __ptr<__ptr<char>> values = malloc(count * sizeof<__ptr<char>>() + 1);
    ulong index = 0;
    while (index < count) {
        var value = wide[0][index];
        var text = _pep_win_narrow(value, wcslen(value) as int);
        __ptr<char> copy = malloc(text.size + 1);
        memcpy(copy, text.c_str(), text.size + 1);
        values[index] = copy;
        index = index + 1;
    }
    var made = unsafe_cast<ulong>(values);
    if (!__atomic_cmpxchg<ulong>(_pep_utf8_argv, 0, made)) {
        # Another thread kept its copy first.
        index = 0;
        while (index < count) {
            free(values[index]);
            index = index + 1;
        }
        free(values);
        return unsafe_cast<__ptr<__ptr<char>>>(__atomic_load<ulong>(_pep_utf8_argv));
    }
    return values;
}

# `n` UTF-16 units at `w` as a UTF-8 String, each unpaired surrogate
# becoming U+FFFD: `io`'s `_io_win_narrow`, here so `_arguments` can use it.
[Target(OS(Windows))]
export _pep_win_narrow(w: __ptr<u16>, n: int): String {
    if (n <= 0) {
        return String();
    }
    # A unit takes at most 3 bytes (a pair 4), so one call fills the buffer.
    var capacity = n * 3;
    __ptr<char> buffer = _pep_malloc(capacity as ulong);
    # ASCII, the usual case, is copied without the call.
    var ascii = 0;
    while (ascii < n) {
        if (w[ascii] >= 128) {
            break;
        }
        buffer[ascii] = w[ascii] as char;
        ascii = ascii + 1;
    }
    if (ascii == n) {
        var copied = String(buffer, n as ulong, n as ulong);
        _pep_free(buffer);
        return copied;
    }
    var size = WideCharToMultiByte(65001, 0, w, n, buffer, capacity, __null, __null);  # CP_UTF8
    if (size <= 0) {
        _pep_free(buffer);
        return String();
    }
    var result = String(buffer, size as ulong);
    _pep_free(buffer);
    return result;
}

# WASI hands the arguments to the program through `args_get`, into memory
# the program provides: a pointer per argument, into a buffer holding them
# all, each followed by a NUL byte.
[Target(OS(Wasi))]
_arguments(): Array<String> {
    # Two 32-bit `size_t`s: the count and the buffer's size.
    __ptr<uint> sizes = _pep_malloc(8);
    if (__wasi_args_sizes_get(sizes, sizes + 1) != 0) {
        _pep_free(sizes);
        return Array<String>();
    }
    var count = sizes[0];
    __ptr<__ptr<char>> values = _pep_malloc((count as ulong) * sizeof<__ptr<char>>() + 1);
    __ptr<char> buffer = _pep_malloc((sizes[1] as ulong) + 1);
    _pep_free(sizes);
    var result = Array<String>();
    if (__wasi_args_get(values, buffer) == 0) {
        result = _arguments_from(count as int, values);
    }
    _pep_free(values);
    _pep_free(buffer);
    return result;
}

# glibc keeps `argv` to itself, so Linux reads the arguments back from
# /proc/self/cmdline: each one followed by a NUL byte.
[Target(OS(Linux))]
_arguments(): Array<String> {
    var result = Array<String>();
    var stream = fopen("/proc/self/cmdline", "rb");
    if (stream == __null) {
        return result;
    }
    ulong capacity = 4096;
    ulong size = 0;
    __ptr<char> buffer = _pep_malloc(capacity);
    while (true) {
        if (size == capacity) {
            buffer = _pep_realloc(buffer, capacity, capacity * 2);
            capacity = capacity * 2;
        }
        var read = fread(buffer + size, 1, capacity - size, stream);
        if (read == 0) {
            break;
        }
        size = size + read;
    }
    fclose(stream);
    ulong start = 0;
    ulong index = 0;
    while (index < size) {
        if (buffer[index] == 0) {
            result.append(String(buffer + start, index - start));
            start = index + 1;
        }
        index = index + 1;
    }
    _pep_free(buffer);
    return result;
}
range
4401
## Ranges of numbers: `a..b` and `a..>b`.
##
## `a..b` (half-open) holds `a` up to but not including `b`; `a..>b`
## (closed) includes `b`. Both make a `Range<T>`, a value that a `for` loop
## steps through without allocating:
##
##     for (var i in 0..count) { ... }   # 0, 1, ..., count - 1
##     for (var i in 1..>10) { ... }     # 1, 2, ..., 10

## A run of consecutive numbers, from `start` up to `end`, as `a..b` and
## `a..>b` make it.
##
## A range is an iterator: `next()` steps from `start` up by one, and a
## `for` loop over a range is a counting loop. A range whose `start` is past
## its end yields nothing. A closed range ending at the largest value of its
## type (`0..>255` as `byte`) stops there without overflowing.
##
## Ranges are [value structs](../language/value-structs.md): copying one
## copies its position, and looping over a range stored in a variable
## advances that variable.
##
## @typeParam T the number type, inferred from the bounds (`0..n` with a `ulong` `n` is a `Range<ulong>`)
## @example
##     var total = 0;
##     for (var i in 1..>4) {
##         total += i;   # 1 + 2 + 3 + 4
##     }
##     var r = 0..10;
##     assert(r.contains(9) && !r.contains(10), "half-open");
[Value]
export struct Range<T> {
    ## The first number of the range.
    T start;
    ## The bound the range stops at: the last number when `inclusive`, else one past it.
    T end;
    ## Whether `end` is part of the range: true for `a..>b`, false for `a..b`.
    bool inclusive;
    ## The current number, once `next()` has moved to one.
    T _value;
    ## 0 before the first `next()`, 1 while there is a current number, 2 once past the end.
    int _state;

    ## Makes the range from `start` to `end`, as `start..end` (or
    ## `start..>end` when `inclusive`).
    ##
    ## @param start the first number
    ## @param end the bound: one past the last number, or the last number when `inclusive`
    ## @param inclusive whether `end` is part of the range
    construct(start: T, end: T, inclusive: bool = false) {
        this.start = start;
        this.end = end;
        this.inclusive = inclusive;
        _value = start;
    }

    ## Advances to the next number: `start` on the first call, then one
    ## more each time.
    ##
    ## Once it returns false it keeps returning false.
    ##
    ## @returns true if there is a current number, false once past the end
    next(): bool {
        if (_state == 2) {
            return false;
        }
        if (_state == 0) {
            _state = 1;
            _value = start;
        } else if (_value == end) {
            # Only a closed range reaches its end; stepping past it could overflow.
            _state = 2;
            return false;
        } else {
            _value = _value + 1;
        }
        if (_value < end || (inclusive && _value == end)) {
            return true;
        }
        _state = 2;
        return false;
    }

    ## Returns the number the last successful `next()` moved to.
    ##
    ## @returns the current number
    ## @panics if `next()` was never called ("Range.current() before next()")
    ## @panics if `next()` already returned false ("Range.current() past the end")
    current(): T {
        assert(_state != 0, "Range.current() before next()");
        assert(_state != 2, "Range.current() past the end");
        return _value;
    }

    ## Returns whether `value` lies in the range, whatever the iteration has
    ## reached.
    ##
    ## @param value the number to test
    ## @returns true if `start <= value` and `value` is before `end` (or equal to it, for a closed range)
    contains(value: T): bool {
        if (value < start) {
            return false;
        }
        if (inclusive) {
            return value <= end;
        }
        return value < end;
    }

    ## Whether the range holds no numbers, whatever the iteration has
    ## reached.
    var is_empty: bool {
        get {
            return !contains(start);
        }
    }
}

extend Range<T> with Iterator<T>;

# `a..b` is `_range(a, b, false)` and `a..>b` is `_range(a, b, true)` (the
# sema builder writes the call), so the bounds infer `T`.
export _range<T>(start: T, end: T, inclusive: bool): Range<T> {
    return Range<T>(start, end, inclusive);
}
reflect
11299
## `reflect` exists only inside a [`static` block](../language/reflection.md),
## which runs while compiling. It needs no import. Everything here is
## evaluated by the compiler: the values are compile-time numbers, `bool`s,
## strings, lists, and the members, cases, functions and attributes below.
## The [Reflection and attributes](../language/reflection.md) chapter
## explains how a block mixes them with the code it emits.
##
## The compiler provides `reflect` itself; this file only declares it, with
## `[__BuiltIn]`, for this reference and the editor.

## The name of type `T` as it is written in source, with its type arguments
## (`"Box<int>"`, `"Array<String>"`).
##
## @typeParam T the type to name
## @returns the type's name
[__BuiltIn("reflect.name")]
export name<T>(): String;

## The public fields and [properties](../language/properties.md) of struct
## `T`, in declaration order, as members.
##
## @typeParam T a struct
## @returns one member per public field or property
[__BuiltIn("reflect.properties")]
export properties<T>(): List<Member>;

## Every field of struct `T`, private ones and a property's storage included,
## in declaration order, as members. It is meant for code a struct's author
## writes, such as a field-by-field `==`, so it is available only in the
## file that declares `T`; anywhere else it is an error that points at
## `properties`.
##
## @typeParam T a struct declared in this file
## @returns one member per field
[__BuiltIn("reflect.fields")]
export fields<T>(): List<Member>;

## The cases of enum `E`, in declaration order.
##
## @typeParam E an enum
## @returns one case per enum case
[__BuiltIn("reflect.cases")]
export cases<E>(): List<Case>;

## Every free function in the program that carries attribute `A`.
##
## @typeParam A an [attribute struct](../language/reflection.md#attributes)
## @returns one function per function marked `[A]`
[__BuiltIn("reflect.functions_with")]
export functions_with<A>(): List<Function>;

## Whether `T` is a struct. A number, `bool` or `char` is not, nor is an
## enum or a trait.
##
## @typeParam T the type to test
## @returns whether `T` is a struct
[__BuiltIn("reflect.is_struct")]
export is_struct<T>(): bool;

## Whether `T` is an enum.
##
## @typeParam T the type to test
## @returns whether `T` is an enum
[__BuiltIn("reflect.is_enum")]
export is_enum<T>(): bool;

## Whether `T` is a trait.
##
## @typeParam T the type to test
## @returns whether `T` is a trait
[__BuiltIn("reflect.is_trait")]
export is_trait<T>(): bool;

## Whether `T` is a reference type, whose slots can be null: a struct, or an
## enum whose cases carry values, unless it is `[Value]`.
##
## @typeParam T the type to test
## @returns whether `T` is a reference type
[__BuiltIn("reflect.is_reference")]
export is_reference<T>(): bool;

## Whether `A` and `B` are the same type, after aliases (`int` and `i32`
## are). A member's `Type` can be either argument:
## `reflect.is_same<field.Type, String>()`.
##
## @typeParam A the first type
## @typeParam B the second type
## @returns whether they are the same type
[__BuiltIn("reflect.is_same")]
export is_same<A, B>(): bool;

## Whether struct or enum `T` carries attribute `A`. A member, case or
## function has the same test as a method with one type argument
## (`field.has_attribute<A>()`).
##
## @typeParam T the struct or enum
## @typeParam A the attribute struct
## @returns whether `T` carries `A`
[__BuiltIn("reflect.has_attribute")]
export has_attribute<T, A>(): bool;

## The value of attribute `A` on struct or enum `T`: each field of attribute
## struct `A` by name (`reflect.attribute<T, Deprecated>().message`). It is
## an error when `T` does not carry `A`. A member, case or function has the
## same as a method with one type argument (`field.attribute<A>()`).
##
## @typeParam T the struct or enum
## @typeParam A the attribute struct
## @returns the attribute's value
[__BuiltIn("reflect.attribute")]
export attribute<T, A>(): A;

## Whether the build defines [build option](../language/build-options.md)
## `name` (`-D NAME` or `-D NAME=value`).
##
## @param name the option's name: a letter or `_`, then letters, digits and
##   `_`
## @returns whether it is defined
[__BuiltIn("reflect.has_build_option")]
export has_build_option(name: String): bool;

## The value of [build option](../language/build-options.md) `name`, as a
## string (`-D NAME` alone is `"1"`). It is an error when the build does not
## define the option.
##
## @param name the option's name
## @returns the option's value
[__BuiltIn("reflect.build_option")]
export build_option(name: String): String;

## The value of [build option](../language/build-options.md) `name`, as a
## string, or `default` when the build does not define it.
##
## @param name the option's name
## @param default the value when the build does not define it
## @returns the option's value, else `default`
[__BuiltIn("reflect.build_option")]
export build_option(name: String, default: String): String;

## Writes `value` as a note each time the compiler runs the call, on every
## compile, including one that succeeds; in an unrolled loop the note says
## which pass printed it. See
## [Seeing what a block does](../language/reflection.md#seeing-what-a-block-does).
##
## @typeParam T the value's compile-time kind
## @param value any compile-time value
[__BuiltIn("reflect.print")]
export print<T>(value: T);

## Stops the compile with an error at the call.
##
## @param message the error's text; an interpolated string can show the
##   values that matter
[__BuiltIn("reflect.error")]
export error(message: String);

## Stops the compile with an error at `condition` when it is false.
##
## @param condition a compile-time condition
## @param message the error's text
[__BuiltIn("reflect.assert")]
export assert(condition: bool, message: String);

## A field or property, from `properties` or `fields`. A compile-time value:
## no program can name its type.
[__BuiltIn("reflect.Member")]
export struct Member {
    ## Its name.
    const name: String;
    ## Its position in the list, from 0.
    const index: int;
    ## Whether it is the last in the list.
    const is_last: bool;
    ## Its type, as a string.
    const type_name: String;
    ## Its type, usable wherever a type is written
    ## (`var copy: field.Type = ...`).
    const Type: Type;
    ## Whether it is a `const` field.
    const is_const: bool;
    ## Whether it is a property rather than a field.
    const is_property: bool;

    ## Whether it carries attribute `A`.
    ##
    ## @typeParam A the attribute struct
    ## @returns whether it carries `A`
    has_attribute<A>(): bool;

    ## The value of attribute `A` on it; an error when it does not carry `A`.
    ##
    ## @typeParam A the attribute struct
    ## @returns the attribute's value
    attribute<A>(): A;

    ## Emits `value.name`, a read of this member of `value`.
    ##
    ## @typeParam T the struct
    ## @param value the struct to read from
    ## @returns the member's value
    get<T>(value: T): Type;

    ## Emits `value.name = x`, a store to this member of `value`.
    ##
    ## @typeParam T the struct
    ## @param value the struct to store into
    ## @param x the value to store
    set<T>(value: T, x: Type);
}

## An enum case, from `cases`. A compile-time value: no program can name its
## type.
[__BuiltIn("reflect.Case")]
export struct Case {
    ## Its name.
    const name: String;
    ## Its integer value, or the tag of a case that carries values.
    const value: int;
    ## Its position, from 0.
    const index: int;
    ## Whether it is the last case.
    const is_last: bool;
    ## The values it carries, as members, in order; empty when it carries
    ## none. A value's `get(v)` reads it from `v`, which must hold this case.
    const values: List<Member>;

    ## Whether it carries attribute `A`.
    ##
    ## @typeParam A the attribute struct
    ## @returns whether it carries `A`
    has_attribute<A>(): bool;

    ## The value of attribute `A` on it; an error when it does not carry `A`.
    ##
    ## @typeParam A the attribute struct
    ## @returns the attribute's value
    attribute<A>(): A;

    ## Emits a test of whether `v` holds this case.
    ##
    ## @typeParam E the enum
    ## @param v the enum value to test
    ## @returns whether `v` holds this case
    matches<E>(v: E): bool;

    ## Emits the case made with `values` (`case.get()` for one that carries
    ## none); at module scope, the case itself.
    ##
    ## @typeParam E the enum
    ## @typeParam TValues the types of the values
    ## @param values the values the case carries, one argument each
    ## @returns the enum value
    get<E, TValues>(values: TValues): E;
}

## A function, from `functions_with`. A compile-time value: no program can
## name its type.
[__BuiltIn("reflect.Function")]
export struct Function {
    ## Its name.
    const name: String;

    ## Whether it carries attribute `A`.
    ##
    ## @typeParam A the attribute struct
    ## @returns whether it carries `A`
    has_attribute<A>(): bool;

    ## The value of attribute `A` on it; an error when it does not carry `A`.
    ##
    ## @typeParam A the attribute struct
    ## @returns the attribute's value
    attribute<A>(): A;

    ## Emits a direct call of the function with `arguments`.
    ##
    ## @typeParam R what the function returns
    ## @typeParam TArguments the types of the arguments
    ## @param arguments the call's arguments, one argument each
    ## @returns what the call returns
    call<R, TArguments>(arguments: TArguments): R;
}

## What `properties`, `fields`, `cases`, `functions_with` and a case's
## `values` return. A compile-time `for` unrolls over it.
##
## @typeParam T a member, case or function
[__BuiltIn("reflect.List")]
export struct List<T> {
    ## How many items it holds.
    const count: int;
    ## Whether it holds none.
    const is_empty: bool;

    ## The item at index `i`.
    ##
    ## @param i its position, from 0
    ## @returns the item
    [](i: int): T;
}

## A compile-time string: a literal, a member's `name`, or the result of
## `name`, `+` or interpolation. It joins with `+` and interpolation.
[__BuiltIn("reflect.String")]
export struct String {
    ## How many characters it holds.
    const length: int;
    ## Whether it holds none.
    const is_empty: bool;

    ## Whether it starts with `s`.
    ##
    ## @param s the prefix
    ## @returns whether it starts with `s`
    starts_with(s: String): bool;

    ## Whether it ends with `s`.
    ##
    ## @param s the suffix
    ## @returns whether it ends with `s`
    ends_with(s: String): bool;

    ## Whether `s` occurs in it.
    ##
    ## @param s the text to find
    ## @returns whether it contains `s`
    contains(s: String): bool;

    ## A new compile-time string: this one followed by `rhs`.
    ##
    ## @param rhs the string to append
    ## @returns the joined string
    +(rhs: String): String;
}
result
6246
## `Result<T, E>`: the value of an operation that can fail, either `Ok`
## holding its value or `Err` holding its error, like Rust's `Result`.

import "internals";

## The default error type of `Result`: a human-readable message.
##
## @example
##     var r = Result<int>.err(Error("boom"));
##     var n = r.error().message.length;   # 4
export struct Error {
    ## The description of what went wrong; empty when none was given.
    String message;

    ## Creates an Error carrying `message`.
    ##
    ## The constructor is `[Implicit]`: a `String` converts to an `Error`
    ## wherever an `Error` is expected, as in `Result<int>.err("bad input")`.
    ##
    ## @param message the description of the failure; defaults to the empty string
    [Implicit]
    construct(message: String = "") {
        this.message = message;
    }
}

## The outcome of an operation that can fail: either Ok, holding a `TValue`,
## or Err, holding a `TError`, like Rust's `Result<T, E>`.
##
## An enum with the cases `Ok(value)` and `Err(error)`. Build one with a
## case (`Result<int>.Ok(42)`) or the static `ok` or `err` functions, and
## read it with `match` or `is` (`if (r is Err(e)) { ... }`), or with
## `is_ok()`, `is_err()`, `value()` and `error()`; `value()` and `error()`
## panic on the wrong kind of result. `TError` defaults to `Error`, so
## `Result<int>` is `Result<int, Error>`.
##
## `Result<void>` is the result of an operation that returns nothing on
## success, like Rust's `Result<(), E>`. A `void` type argument erases what
## it types: that instance's `Ok` carries nothing (`Result<void>.Ok`, and
## the pattern `Ok`), `ok()` takes no argument, and `value()` returns
## nothing, so it only checks that the result is Ok.
##
## @typeParam TValue the type of the value an Ok result carries; `void` when there is none
## @typeParam TError the type of the error an Err result carries; defaults to `Error`
## @example
##     main(): int {
##         var a = Result<int>.ok(42);
##         if (a.value() != 42) { return 1; }
##         var b = Result<int>.err(Error("boom"));
##         if (!b.is_err()) { return 2; }
##         var n = match (b) { Ok(v) => v, Err(e) => e.message.length };   # 4
##         return b.ok_or(0);   # 0
##     }
[Value]
export enum Result<TValue, TError=Error> {
    ## The operation succeeded with `value`.
    ##
    ## @param value the success value
    Ok(value: TValue),
    ## The operation failed with `error`.
    ##
    ## @param error the failure value
    Err(error: TError),

    ## Returns an Ok result holding `v`; the same as `Result.Ok(v)`.
    ##
    ## For a struct `TValue` the result acquires a reference to `v`.
    ##
    ## For `Result<void>`, `ok()` takes no argument.
    ##
    ## @param v the success value
    ## @returns an Ok result whose `value()` is `v`
    ## @example
    ##     var r = Result<int>.ok(42);
    ##     var done = Result<void>.ok();
    static ok(v: TValue): Result<TValue, TError> {
        return Result<TValue, TError>.Ok(v);
    }

    ## Returns an Err result holding `e`; the same as `Result.Err(e)`.
    ##
    ## For a struct `TError` the result acquires a reference to `e`.
    ##
    ## @param e the failure value
    ## @returns an Err result whose `error()` is `e`
    ## @example
    ##     var r = Result<int>.err(Error("boom"));
    static err(e: TError): Result<TValue, TError> {
        return Result<TValue, TError>.Err(e);
    }

    ## Reports whether this result is Ok.
    ##
    ## @returns true when the result holds a value
    is_ok(): bool {
        return this is Ok;
    }

    ## Reports whether this result is Err.
    ##
    ## @returns true when the result holds an error
    is_err(): bool {
        return this is Err;
    }

    ## Returns the success value, panicking if this result is Err.
    ##
    ## For a struct `TValue` the caller gets its own reference; the result
    ## keeps its reference too.
    ##
    ## For `Result<void>` it returns nothing: calling it only checks that the
    ## result is Ok.
    ##
    ## @returns the value of an Ok result
    ## @panics if the result is Err ("Result.value on an Err value")
    ## @example
    ##     var n = Result<int>.ok(42).value();   # 42
    value(location: __ptr<char> = __caller_location()): TValue {
        if (this is Ok(value)) {
            return value;
        }
        panic("Result.value on an Err value", location);
    }

    ## Returns the failure value, panicking if this result is Ok.
    ##
    ## For a struct `TError` the caller gets its own reference; the result
    ## keeps its reference too.
    ##
    ## @returns the error of an Err result
    ## @panics if the result is Ok ("Result.error on an Ok value")
    ## @example
    ##     var e = Result<int>.err(Error("boom")).error();   # e.message == "boom"
    error(location: __ptr<char> = __caller_location()): TError {
        if (this is Err(error)) {
            return error;
        }
        panic("Result.error on an Ok value", location);
    }

    # What `e?` lowers to (the builder's `lift_tries`): it returns early when
    # `_propagates()`, with the enclosing function's
    # `_from_residual(e._residual())`. An error of another type converts to
    # this `TError` as the argument, through an `[Implicit]` constructor.
    _propagates(): bool {
        return this is Err;
    }

    _residual(): TError {
        return this.error();
    }

    static _from_residual(error: TError): Result<TValue, TError> {
        return Result<TValue, TError>.Err(error);
    }

    ## Returns the success value, or `fallback` if this result is Err.
    ##
    ## Never panics. `fallback` is evaluated by the caller whether or not it
    ## is used.
    ##
    ## @param fallback the value to return when the result is Err
    ## @returns the value when the result is Ok, otherwise `fallback`
    ## @example
    ##     var n = Result<int>.err(Error("e")).ok_or(-1);   # -1
    ok_or(fallback: TValue): TValue {
        if (this is Ok(value)) {
            return value;
        }
        return fallback;
    }
}
scoped
2561
## The scope protocol behind `with (var x = scope) { ... } else { ... }`.
##
## A `with` block holds `scope` in a hidden local, binds `x` to
## `scope.enter()`, and runs the body. When `enter()` returns a struct
## reference that is null, the body is skipped and the optional `else` block
## runs instead. Both locals are released on every path out of the block
## (falling off the end, `return`, `break`, `continue`), the binding first.
## Cleanup is the scope object's destructor, which calls `exit()`.

# The block lowers to
#
#     {
#         var scope = <expression>;
#         var x = scope.enter();
#         if (x != __null) { body } else { other }   # null test only for a struct result
#     }
#
# `with` goes by the methods a type has, so declaring the trait is optional;
# declaring it (`extend Foo with Scoped<Bar>`) checks the methods.

## Something a `with` block can enter.
##
## `enter()` runs once when the block is entered, and its result is what the
## header binds. `exit()` is the cleanup: implementations call it from their
## destructor (`destruct { this.exit(); }`), so it runs when the scope
## object's last reference is released. For a scope object created in the
## `with` header that is the end of the block; for one that is also held
## elsewhere, it is when that last owner lets go.
##
## A `with` block with no binding (`with (scope) { ... }`) still holds the
## result of `enter()` until the block ends. An `enter()` that returns `void`
## has nothing to bind.
##
## @typeParam T the type `enter()` returns
## @example
##     var open = 0;
##
##     struct Session {
##         construct() {
##             open = open + 1;
##         }
##
##         destruct {
##             this.exit();
##         }
##
##         Session enter() {
##             return this;
##         }
##
##         exit() {
##             open = open - 1;
##         }
##     }
##
##     extend Session with Scoped<Session>;
##
##     main(): int {
##         with (var session = Session()) {
##             # open == 1 here
##         }
##         return open;   # 0: the session was destroyed at the end of the block
##     }
export trait Scoped<T> {
    ## Enters the scope.
    ##
    ## A null struct reference means there is nothing to use: the `with`
    ## body is skipped and its `else` block runs instead.
    ##
    ## @returns the value the `with` header binds
    enter(): T;

    ## Leaves the scope. Implementations call it from their destructor.
    exit();
}
serialize/module
2807
## Serialization attributes: how a struct's properties are written to and
## read from text formats.
##
## `json` reads these attributes when it converts a struct (`json.encode`,
## `json.decode`), and other formats will share them, so one set of
## attributes describes a type for every format. Write them above a
## property (or an enum or one of its cases: `Tag`, `Untagged`, `Name`);
## `import serialize` brings them in, and `import json` alone is
## enough too, since `json` exports them.
##
## @example
##     import json;
##
##     struct ServerConfig {
##         var host: String;
##         [Name("max-connections")]
##         var max_connections: int;
##         [Required]
##         var port: int;
##         [Ignore]
##         var started_at: long;
##     }

## Writes a property, or an enum case, under `value` rather than under its
## own name.
##
## @example
##     import json;
##
##     struct Limits {
##         [Name("max-connections")]
##         var max_connections: int;
##     }
[Attribute]
export struct Name {
    ## The key the property is written under, or the name the case is
    ## written as.
    const value: String;
}

## Leaves a property out: it is not written, and reading leaves it as it
## was.
[Attribute]
export struct Ignore {}

## Makes a missing key an error when reading. Without it, a missing key
## leaves the property at its default.
[Attribute]
export struct Required {}

## Writes an enum's cases as objects that name their case under `key`,
## rather than as `{"Case": {...}}`.
##
## Without `content`, a case's values sit beside the tag:
## `{"kind": "Circle", "radius": 2}`. With `content`, they go in an object
## under that key: `{"kind": "Circle", "data": {"radius": 2}}`. A case that
## carries no values is `{"kind": "Point"}` either way. Write it above an
## enum.
##
## @example
##     import json;
##
##     [Tag("kind")]
##     enum Shape {
##         Circle(radius: int),
##         Point,
##     }
[Attribute]
export struct Tag {
    ## The key that holds the case's name.
    const key: String;
    ## The key that holds the case's values, or empty to put them beside
    ## the tag.
    const content: String = "";
}

## Writes an enum's cases with no tag at all: a case that carries values as
## the object of its values (`{"radius": 2}`), and one that carries none as
## its name (`"Point"`).
##
## Reading tries each case in order and takes the first that reads without
## an error, so list a case whose values are a superset of another's first.
## Write it above an enum.
##
## @example
##     import json;
##
##     [Untagged]
##     enum Size {
##         Fixed(px: int),
##         Auto,
##     }
[Attribute]
export struct Untagged {}
stack_guard
13504
# Stack overflow reports: a thread that runs past the end of its stack hits
# a guard page, and instead of the silent crash that follows, the program
# writes `panic: stack overflow` to standard error and aborts, as a panic
# does. There is too little stack left to format anything, or to print a
# backtrace, so the message is a fixed string written with one system call,
# and the panic hook (`set_panic_hook`) does not run.
#
# The compiler calls `_pep_stack_guard_start` first thing in `main`, which
# installs the process's handler and sets up the main thread; every `Thread`
# calls `_pep_stack_guard_thread_start` and `_pep_stack_guard_thread_end`
# around its body (async/thread.pep).
#
# Windows: a vectored exception handler, added last so that handlers added
# before it run first, takes EXCEPTION_STACK_OVERFLOW and passes every other
# exception on. A debugger sees each exception before it. The system raises
# the exception with only the guard page left, so `SetThreadStackGuarantee`
# keeps more in reserve on each thread, and on each fiber (fiber_windows.pep),
# since a fiber carries its own guarantee.
#
# Linux and macOS: a SIGSEGV and SIGBUS handler runs on an alternate signal
# stack (`sigaltstack`, one per thread, from the C heap), since the faulting
# stack has no room left. It reports an overflow only when the fault address
# lies next to the stack pointer the signal's context saved, so it needs no
# record of which stack (a thread's or a task fiber's) was running, and
# switching fibers costs nothing extra. Any other fault goes to the handler
# that was there before, or, when there was none, restores the default
# action and returns, so the fault happens again and ends the program as it
# always did.
#
# Nothing here runs on a hot path: once per program, once per `Thread`
# start and end, and on Windows once per fiber stack (fibers are reused).

extern void* malloc(ulong size);
extern void* calloc(ulong count, ulong size);
extern void free(void* p);
extern ulong strlen(char* s);
extern void abort();

[Target(OS(Windows))]
extern void* AddVectoredExceptionHandler(uint first, extern (__ptr<void>) => int handler);
[Target(OS(Windows))]
extern int SetThreadStackGuarantee(uint* size);
[Target(OS(Windows))]
extern void* GetStdHandle(uint which);
[Target(OS(Windows))]
extern int WriteFile(void* file, void* buffer, uint size, uint* written, void* overlapped);

# What a stack overflow writes to standard error.
const _STACK_OVERFLOW_MESSAGE = "panic: stack overflow\n";

# 1 once `_pep_stack_guard_start` has installed the handler.
const _pep_stack_installed: __ptr<int> = calloc(1, 4);

# Whether `main` installed the stack overflow handler: false in a program
# built by a compiler older than the call (or on WASI). The overflow tests
# check it first, so a missing call fails with that reason, not a crash.
export _pep_stack_guard_installed(): bool {
    return _pep_stack_installed[0] == 1;
}

# The stack each thread keeps for the handler: 20 KiB, as Rust keeps.
[Target(OS(Windows))]
const _STACK_GUARANTEE: uint = 20480;

# EXCEPTION_STACK_OVERFLOW, and EXCEPTION_CONTINUE_SEARCH.
[Target(OS(Windows))]
const _STACK_OVERFLOW_CODE: uint = 3221225725;
[Target(OS(Windows))]
const _STACK_CONTINUE_SEARCH = 0;

# Where WriteFile puts the count it wrote: the handler has no stack to
# spare, and must not allocate.
[Target(OS(Windows))]
const _pep_stack_written: __ptr<uint> = calloc(1, 4);

# Installs the handler and sets up the main thread. The compiler calls it
# at the start of `main`.
[Target(OS(Windows))]
export _pep_stack_guard_start() {
    var handler: extern (__ptr<void>) => int = _pep_stack_overflow_filter;
    AddVectoredExceptionHandler(0, handler);
    _pep_stack_guard_thread_start();
    _pep_stack_installed[0] = 1;
}

# Sets up the calling thread or fiber: keeps stack in reserve for the handler.
[Target(OS(Windows))]
export _pep_stack_guard_thread_start() {
    __ptr<uint> size = calloc(1, 4);
    size[0] = _STACK_GUARANTEE;
    SetThreadStackGuarantee(size);
    free(size);
}

# Undoes `_pep_stack_guard_thread_start` as a thread ends: nothing to undo.
[Target(OS(Windows))]
export _pep_stack_guard_thread_end() {}

# The vectored exception handler: `info` is an EXCEPTION_POINTERS, whose
# first field points at the EXCEPTION_RECORD, whose first field is the code.
[Target(OS(Windows))]
[Unsafe("overflow")]
_pep_stack_overflow_filter(info: __ptr<void>): int {
    __ptr<__ptr<uint>> pointers = info;
    if (pointers[0][0] != _STACK_OVERFLOW_CODE) {
        return _STACK_CONTINUE_SEARCH;
    }
    # STD_ERROR_HANDLE is (DWORD)-12.
    var error = GetStdHandle(4294967284);
    __ptr<char> message = _STACK_OVERFLOW_MESSAGE;
    WriteFile(error, message, strlen(message) as uint, _pep_stack_written, __null);
    abort();
    return _STACK_CONTINUE_SEARCH;
}

[Target(OS(Linux) || OS(Mac))]
extern int sigaction(int number, void* action, void* old);
[Target(OS(Linux) || OS(Mac))]
extern int sigaltstack(void* stack, void* old);
[Target(OS(Linux) || OS(Mac))]
extern void* signal(int number, void* handler);
[Target(OS(Linux) || OS(Mac))]
extern void memset(void* p, int c, ulong n);

# How far from the faulting stack pointer a fault still counts as an
# overflow: a call or push faults just below it, and a frame that moves the
# stack pointer past the guard page faults above it, as far as the frame
# reaches.
[Target(OS(Linux) || OS(Mac))]
const _STACK_GUARD_BELOW: ulong = 65536;
[Target(OS(Linux) || OS(Mac))]
const _STACK_GUARD_ABOVE: ulong = 1048576;

# The handler's own stack.
[Target(OS(Linux) || OS(Mac))]
const _STACK_SIGNAL_STACK_SIZE: ulong = 65536;

# The struct sigaction layout: its size, and where sa_flags and the handler
# sit. glibc puts the handler first and a 128-byte sigset_t before the flags;
# bionic on 64-bit Android uses the kernel's layout, flags first; Apple's has
# a 4-byte sigset_t. Then SA_SIGINFO | SA_ONSTACK, SA_SIGINFO, SIGBUS,
# SS_DISABLE, si_addr's offset in siginfo_t, and the offsets of ss_size and
# ss_flags in stack_t.
[Target(OS(Linux) && !OS(Android))]
const _STACK_ACTION_SIZE: ulong = 152;
[Target(OS(Linux) && !OS(Android))]
const _STACK_ACTION_HANDLER: ulong = 0;
[Target(OS(Linux) && !OS(Android))]
const _STACK_ACTION_FLAGS: ulong = 136;
[Target(OS(Android))]
const _STACK_ACTION_SIZE: ulong = 32;
[Target(OS(Android))]
const _STACK_ACTION_HANDLER: ulong = 8;
[Target(OS(Android))]
const _STACK_ACTION_FLAGS: ulong = 0;
[Target(OS(Linux))]
const _STACK_SA_FLAGS = 134217732;
[Target(OS(Linux))]
const _STACK_SA_SIGINFO = 4;
[Target(OS(Linux))]
const _STACK_SIGBUS = 7;
[Target(OS(Linux))]
const _STACK_SS_DISABLE = 2;
[Target(OS(Linux))]
const _STACK_SI_ADDR: ulong = 16;
[Target(OS(Linux))]
const _STACK_SS_SIZE: ulong = 16;
[Target(OS(Linux))]
const _STACK_SS_FLAGS: ulong = 8;

[Target(OS(Mac))]
const _STACK_ACTION_SIZE: ulong = 16;
[Target(OS(Mac))]
const _STACK_ACTION_HANDLER: ulong = 0;
[Target(OS(Mac))]
const _STACK_ACTION_FLAGS: ulong = 12;
[Target(OS(Mac))]
const _STACK_SA_FLAGS = 65;
[Target(OS(Mac))]
const _STACK_SA_SIGINFO = 64;
[Target(OS(Mac))]
const _STACK_SIGBUS = 10;
[Target(OS(Mac))]
const _STACK_SS_DISABLE = 4;
[Target(OS(Mac))]
const _STACK_SI_ADDR: ulong = 24;
[Target(OS(Mac))]
const _STACK_SS_SIZE: ulong = 8;
[Target(OS(Mac))]
const _STACK_SS_FLAGS: ulong = 16;

# SIGSEGV.
[Target(OS(Linux) || OS(Mac))]
const _STACK_SIGSEGV = 11;

# The actions SIGSEGV and SIGBUS had before `_pep_stack_guard_start`, one
# after the other: what a fault that is not an overflow goes to.
[Target(OS(Linux) || OS(Mac))]
const _pep_stack_old_actions: __ptr<u8> = calloc(2, _STACK_ACTION_SIZE);

# The calling thread's alternate signal stack block (see
# `_pep_stack_guard_thread_start`), or null.
[Target(OS(Linux) || OS(Mac))]
[ThreadLocal]
var _pep_stack_signal_stack: __ptr<void>;

# Installs the handler and sets up the main thread. The compiler calls it
# at the start of `main`.
[Target(OS(Linux) || OS(Mac))]
export _pep_stack_guard_start() {
    _pep_stack_guard_thread_start();
    __ptr<u8> action = calloc(1, _STACK_ACTION_SIZE);
    __ptr<extern (int, __ptr<void>, __ptr<void>) => void> handler = action + _STACK_ACTION_HANDLER;
    handler[0] = _pep_stack_overflow_handler;
    __ptr<int> flags = action + _STACK_ACTION_FLAGS;
    flags[0] = _STACK_SA_FLAGS;
    sigaction(_STACK_SIGSEGV, action, _pep_stack_old_actions);
    sigaction(_STACK_SIGBUS, action, _pep_stack_old_actions + _STACK_ACTION_SIZE);
    free(action);
    _pep_stack_installed[0] = 1;
}

# Sends the faults on SIGSEGV or SIGBUS (`number`) that are not a stack
# overflow to `handler`, in place of the action the signal had before the
# program started, as `signal(number, handler)` would without the stack
# guard. In a program whose `main` did not install the guard (a compiler
# older than it), it calls `signal` itself. The test runner ends a test's
# processes this way (testing/runner.pep).
[Target(OS(Linux) || OS(Mac))]
export _pep_stack_guard_set_fallback(number: int, handler: extern (int) => void) {
    if (_pep_stack_installed[0] == 0) {
        signal(number, handler);
        return;
    }
    __ptr<u8> old = _pep_stack_old_actions + (number == _STACK_SIGSEGV ? 0 : _STACK_ACTION_SIZE);
    memset(old, 0, _STACK_ACTION_SIZE);
    __ptr<extern (int) => void> slot = old + _STACK_ACTION_HANDLER;
    slot[0] = handler;
}

# Gives the calling thread an alternate signal stack: one block from the C
# heap (not zeroed) holding the stack_t that describes it, then the stack,
# so a thread start costs one `malloc` and one `sigaltstack`. A thread the
# system cannot give one runs without.
[Target(OS(Linux) || OS(Mac))]
export _pep_stack_guard_thread_start() {
    __ptr<u8> block = malloc(32 + _STACK_SIGNAL_STACK_SIZE);
    if (block == __null) {
        return;
    }
    __ptr<__ptr<u8>> sp = block;
    sp[0] = block + 32;
    __ptr<ulong> size = block + _STACK_SS_SIZE;
    size[0] = _STACK_SIGNAL_STACK_SIZE;
    __ptr<int> flags = block + _STACK_SS_FLAGS;
    flags[0] = 0;
    if (sigaltstack(block, __null) == 0) {
        _pep_stack_signal_stack = block;
    } else {
        free(block);
    }
}

# Undoes `_pep_stack_guard_thread_start` as a thread ends: turns its
# alternate signal stack off and frees it.
[Target(OS(Linux) || OS(Mac))]
export _pep_stack_guard_thread_end() {
    __ptr<u8> block = _pep_stack_signal_stack;
    if (block == __null) {
        return;
    }
    __ptr<int> flags = block + _STACK_SS_FLAGS;
    flags[0] = _STACK_SS_DISABLE;
    sigaltstack(block, __null);
    free(block);
    _pep_stack_signal_stack = __null;
}

# The stack pointer when the fault happened, from the handler's `context`
# (a ucontext_t): Linux keeps it in uc_mcontext (x86-64 gregs[REG_RSP], or
# AArch64's sigcontext.sp), macOS in the mcontext uc_mcontext points at
# (after its 16-byte exception state: x86-64 __rsp, or AArch64 __sp).
[Target(OS(Linux) && Arch(x64))]
_pep_stack_pointer(context: __ptr<u8>): ulong {
    __ptr<ulong> sp = context + 160;
    return sp[0];
}

[Target(OS(Linux) && Arch(aarch64))]
_pep_stack_pointer(context: __ptr<u8>): ulong {
    __ptr<ulong> sp = context + 432;
    return sp[0];
}

[Target(OS(Mac) && Arch(x64))]
_pep_stack_pointer(context: __ptr<u8>): ulong {
    __ptr<__ptr<u8>> machine = context + 48;
    __ptr<ulong> sp = machine[0] + 72;
    return sp[0];
}

[Target(OS(Mac) && Arch(aarch64))]
_pep_stack_pointer(context: __ptr<u8>): ulong {
    __ptr<__ptr<u8>> machine = context + 48;
    __ptr<ulong> sp = machine[0] + 264;
    return sp[0];
}

# The SIGSEGV and SIGBUS handler, on the thread's alternate signal stack.
# A fault next to the stack pointer is an overflow, whichever stack it is
# (a thread's or a task fiber's), so nothing has to track which one runs.
[Target(OS(Linux) || OS(Mac))]
[Unsafe("overflow")]
_pep_stack_overflow_handler(number: int, info: __ptr<void>, context: __ptr<void>) {
    __ptr<u8> bytes = info;
    __ptr<ulong> fault = bytes + _STACK_SI_ADDR;
    var address = fault[0];
    var sp = _pep_stack_pointer(context);
    if (address + _STACK_GUARD_BELOW >= sp && address < sp + _STACK_GUARD_ABOVE) {
        _pep_write_error(_STACK_OVERFLOW_MESSAGE);
        abort();
    }
    __ptr<u8> old = _pep_stack_old_actions + (number == _STACK_SIGSEGV ? 0 : _STACK_ACTION_SIZE);
    __ptr<ulong> old_handler = old + _STACK_ACTION_HANDLER;
    __ptr<int> old_flags = old + _STACK_ACTION_FLAGS;
    var previous = old_handler[0];
    # SIG_DFL is 0 and SIG_IGN 1: put the old action back, and the fault,
    # happening again, takes it.
    if (previous <= 1) {
        sigaction(number, old, __null);
        return;
    }
    if ((old_flags[0] & _STACK_SA_SIGINFO) != 0) {
        var chained = unsafe_cast<__ptr<void>>(previous) as extern (int, __ptr<void>, __ptr<void>) => void;
        chained(number, info, context);
    } else {
        var chained = unsafe_cast<__ptr<void>>(previous) as extern (int) => void;
        chained(number);
    }
}

[Target(OS(Wasi))]
export _pep_stack_guard_start() {}

[Target(OS(Wasi))]
export _pep_stack_guard_thread_start() {}

[Target(OS(Wasi))]
export _pep_stack_guard_thread_end() {}
