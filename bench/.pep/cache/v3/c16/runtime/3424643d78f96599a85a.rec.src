## UTF-8, the encoding a `String` holds.

## Encodes a `String` to UTF-8 bytes and decodes them back. A String already
## holds UTF-8, so encoding copies its bytes; decoding checks them.
##
## @example
##     import text;
##
##     var bytes = text.Utf8.encode("hi");
##     assert(text.Utf8.decode(bytes).value() == "hi", "round trip");
export struct Utf8 {
    ## Returns the UTF-8 bytes of `value`, without a terminating NUL.
    ##
    ## @param value the text to encode
    ## @returns a new array of `value.size` bytes
    static encode(value: String): u8[] {
        return value.bytes();
    }

    ## Returns whether `bytes` is valid UTF-8: no stray continuation bytes,
    ## no truncated, overlong or surrogate sequences, and nothing past
    ## U+10FFFF.
    ##
    ## @param bytes the bytes to check
    ## @returns true when every byte is part of a valid sequence
    static is_valid(bytes: u8[]): bool {
        var size = bytes.count;
        ulong index = 0;
        while (index < size) {
            var run = String._utf8_sequence(bytes._data, index, size);
            if (run == 0) {
                return false;
            }
            index = index + run;
        }
        return true;
    }

    ## Decodes `bytes` as UTF-8, or gives none when they are not valid UTF-8
    ## (see `is_valid`). A byte-order mark is kept as part of the text.
    ##
    ## @param bytes the bytes to decode
    ## @returns the text, or none when `bytes` is not valid UTF-8
    ## @example
    ##     import text;
    ##
    ##     var bad = Array<u8>();
    ##     bad.append(255);
    ##     assert(text.Utf8.decode(bad).is_empty(), "0xFF is never UTF-8");
    static decode(bytes: u8[]): String? {
        if (!Utf8.is_valid(bytes)) {
            return Optional<String>.Empty;
        }
        return Optional<String>.Value(Utf8.decode_lossy(bytes));
    }

    ## Decodes `bytes` as UTF-8, replacing each byte that does not start a
    ## valid sequence with U+FFFD, so it always succeeds. Valid input gives
    ## the same text as `decode`.
    ##
    ## @param bytes the bytes to decode
    ## @returns the text
    ## @example
    ##     import text;
    ##
    ##     var data = Array<u8>();
    ##     data.append(104);
    ##     data.append(255);
    ##     data.append(105);
    ##     assert(text.Utf8.decode_lossy(data) == "h\u{FFFD}i", "255 is replaced");
    static decode_lossy(bytes: u8[]): String {
        return String._from_bytes(bytes);
    }

    ## Returns the byte offset of the first byte of `value` that does not
    ## start a valid UTF-8 sequence (see `is_valid`), or none when all of it
    ## is valid. A `String` made from checked bytes is always valid; one made
    ## from C memory may not be.
    ##
    ## @param value the text to check
    ## @returns the offset of the first invalid byte, or none
    ## @example
    ##     import text;
    ##
    ##     assert(text.Utf8.find_invalid("héllo").is_empty(), "valid");
    static find_invalid(value: String): ulong? {
        __ptr<u8> data = unsafe_cast<__ptr<u8>>(value._data);
        var size = value.size;
        ulong index = 0;
        while (index < size) {
            var run = String._utf8_sequence(data, index, size);
            if (run == 0) {
                return Optional<ulong>.Value(index);
            }
            index = index + run;
        }
        return Optional<ulong>.Empty;
    }

    ## Decodes the code point whose UTF-8 sequence starts at byte `offset`
    ## of `value`.
    ##
    ## @param value the text to read
    ## @param offset the byte offset where the sequence starts
    ## @returns the code point and the number of bytes its sequence takes,
    ##   from 1 to 4, so `offset` plus that is where the next one starts
    ## @panics if `offset` is not less than `value.size`
    ##   ("Utf8.code_point_at offset out of bounds")
    ## @panics if no valid sequence starts at `offset`
    ##   ("Utf8.code_point_at found invalid UTF-8")
    ## @example
    ##     import text;
    ##
    ##     var (point, run) = text.Utf8.code_point_at("é!", 0);
    ##     assert(point == 233 and run == 2, "U+00E9 takes two bytes");
    static code_point_at(value: String, offset: ulong): (uint, ulong) {
        var size = value.size;
        assert(offset < size, "Utf8.code_point_at offset out of bounds");
        __ptr<u8> data = unsafe_cast<__ptr<u8>>(value._data);
        var run = String._utf8_sequence(data, offset, size);
        assert(run != 0, "Utf8.code_point_at found invalid UTF-8");
        return (_text_code_point(data, offset, run), run);
    }

    ## Appends the UTF-8 encoding of `code_point`, from 1 to 4 bytes, to
    ## `out`.
    ##
    ## @param out the bytes to append to
    ## @param code_point the code point to encode
    ## @panics if `code_point` is a surrogate (U+D800 to U+DFFF) or above
    ##   U+10FFFF ("Utf8.append_code_point needs a Unicode scalar value")
    ## @example
    ##     import text;
    ##
    ##     var out = Array<u8>();
    ##     text.Utf8.append_code_point(out, 8364);
    ##     assert(text.Utf8.decode(out).value() == "€", "U+20AC");
    static append_code_point(out: u8[], code_point: uint) {
        assert(
            code_point <= 1114111 and (code_point < 55296 or code_point > 57343),
            "Utf8.append_code_point needs a Unicode scalar value"
        );
        _text_append_utf8(out, code_point);
    }
}

# The code point of the valid UTF-8 sequence of `run` bytes at `index` of
# `data`.
_text_code_point(data: __ptr<u8>, index: ulong, run: ulong): uint {
    var first = data[index] as uint;
    if (run == 1) {
        return first;
    }
    uint value = 0;
    if (run == 2) {
        value = first & 31;
    } else if (run == 3) {
        value = first & 15;
    } else {
        value = first & 7;
    }
    ulong k = 1;
    while (k < run) {
        value = (value << 6) | ((data[index + k] as uint) & 63);
        k = k + 1;
    }
    return value;
}

# Appends the UTF-8 bytes of the code point `value` to `out`.
_text_append_utf8(out: u8[], value: uint) {
    if (value < 128) {
        out.append(value as u8);
    } else if (value < 2048) {
        out.append((192 | (value >> 6)) as u8);
        out.append((128 | (value & 63)) as u8);
    } else if (value < 65536) {
        out.append((224 | (value >> 12)) as u8);
        out.append((128 | ((value >> 6) & 63)) as u8);
        out.append((128 | (value & 63)) as u8);
    } else {
        out.append((240 | (value >> 18)) as u8);
        out.append((128 | ((value >> 12) & 63)) as u8);
        out.append((128 | ((value >> 6) & 63)) as u8);
        out.append((128 | (value & 63)) as u8);
    }
}
time/civil
29585
## Calendar dates and times of day with no time zone: `Date`, `Time`,
## `DateTime` and `Weekday`, on the proleptic Gregorian calendar, plus
## `is_leap_year` and `days_in_month`.

import os;
import "format";

const SECONDS_PER_DAY: long = 86400;
const NANOSECONDS_PER_SECOND: long = 1000000000;
const MINIMUM_YEAR: int = -999999;
const MAXIMUM_YEAR: int = 999999;

## Returns whether `year` is a leap year on the Gregorian calendar: divisible
## by 4, except centuries not divisible by 400. Year 0 (1 BC) is one.
##
## @param year the year
## @returns true when February of `year` has 29 days
## @example
##     assert(time.is_leap_year(2024) && !time.is_leap_year(1900), "leap years");
export is_leap_year(year: int): bool {
    return _time_is_leap_year(year);
}

## Returns the number of days in `month` of `year`: 28 to 31.
##
## @param year the year, for February
## @param month the month, 1 (January) to 12 (December)
## @returns the number of days in that month
## @panics if `month` is not from 1 to 12
export days_in_month(year: int, month: int): int {
    assert(month >= 1 && month <= 12, $"time.days_in_month: {month} is not a month");
    return _time_days_in_month(year, month);
}

## A day of the week. Each case's value is its ISO 8601 number, Monday 1 to
## Sunday 7, so `day as int` gives that number, and `day.name()` its English
## name.
export enum Weekday {
    ## The first day of the ISO week.
    Monday = 1,
    ## The second day.
    Tuesday,
    ## The third day.
    Wednesday,
    ## The fourth day.
    Thursday,
    ## The fifth day.
    Friday,
    ## The sixth day.
    Saturday,
    ## The seventh and last day of the ISO week.
    Sunday,

    ## Returns the weekday's English name, as `name()` does: `Monday`.
    ##
    ## @returns the name
    to_string(): String {
        return name();
    }
}

## A date on the proleptic Gregorian calendar, which extends the calendar's
## rules to years before it was adopted: a year, a month (1 to 12) and a
## day of the month (1 to 31), with no time of day or time zone.
##
## A value struct: copied, compared with `==`, `<` and the other
## comparisons, and never allocated. Years run from -999999 to 999999; year
## 0 is 1 BC. Its text is ISO 8601's `2024-02-29`.
##
## @example
##     import time;
##
##     main(): int {
##         var day = time.Date(2024, 2, 28).add_days(1);
##         print(day);               # 2024-02-29
##         print(day.weekday());     # Thursday
##         return 0;
##     }
[Value]
export struct Date {
    ## The year: 2024, or 0 for 1 BC and -1 for 2 BC.
    var year: int { get; }
    ## The month, 1 (January) to 12 (December).
    var month: int { get; }
    ## The day of the month, 1 to 31.
    var day: int { get; }

    ## Makes the date `year`-`month`-`day`; with no arguments, the Unix
    ## epoch's 1970-01-01.
    ##
    ## @param year the year, from -999999 to 999999
    ## @param month the month, 1 to 12
    ## @param day the day of the month, 1 to the month's last day
    ## @panics if the parts do not name a date: use `checked` for parts that
    ##   come from outside the program
    construct(year: int = 1970, month: int = 1, day: int = 1) {
        assert(_time_is_date(year, month, day), $"time.Date: {year}-{month}-{day} is not a date");
        this.year = year;
        this.month = month;
        this.day = day;
    }

    ## Returns the date `year`-`month`-`day`, or none when the parts do not
    ## name one, such as February 30.
    ##
    ## @param year the year, from -999999 to 999999
    ## @param month the month, 1 to 12
    ## @param day the day of the month
    ## @returns the date, or none
    static checked(year: int, month: int, day: int): Date? {
        if (!_time_is_date(year, month, day)) {
            return Optional<Date>.Empty;
        }
        return Optional<Date>.Value(Date(year, month, day));
    }

    ## Returns the date `days` days after 1970-01-01.
    ##
    ## @param days days since the Unix epoch; negative for earlier dates
    ## @returns the date
    ## @panics if the date is outside the years -999999 to 999999
    static from_days(days: long): Date {
        var (year, month, day) = _time_civil_from_days(days);
        assert(year >= MINIMUM_YEAR && year <= MAXIMUM_YEAR, "time.Date: the date is out of range");
        return Date(year as int, month, day);
    }

    ## Returns the date in the ISO 8601 form `2024-02-29`, or none when
    ## `text` is not a date. Years outside 0 to 9999 take a sign and more
    ## digits (`+10000-01-01`, `-0001-12-31`).
    ##
    ## @param text the text to read
    ## @returns the date, or an error saying what is wrong with `text`
    static parse(text: String): Result<Date> {
        var scanner = _TimeScanner(text);
        var date = scanner.date();
        if (date.is_err() || !scanner.at_end()) {
            return Result<Date>.err(Error($"invalid date '{text}'"));
        }
        return date;
    }

    ## Returns the number of days from 1970-01-01 to this date.
    ##
    ## @returns days since the Unix epoch; negative for earlier dates
    days(): long {
        return _time_days_from_civil(year, month, day);
    }

    ## Returns the day of the week.
    ##
    ## @returns the weekday
    weekday(): Weekday {
        var days = days() % 7;
        if (days < 0) {
            days = days + 7;
        }
        # 1970-01-01 was a Thursday, ISO day 4.
        return Weekday.from_value(((days + 3) % 7 + 1) as int).value();
    }

    ## Returns the day of the year, 1 for January 1 to 366 for December 31
    ## of a leap year.
    ##
    ## @returns the ordinal day
    day_of_year(): int {
        return (days() - _time_days_from_civil(year, 1, 1) + 1) as int;
    }

    ## Returns whether this date's year is a leap year.
    ##
    ## @returns true when the year has a February 29
    is_leap_year(): bool {
        return _time_is_leap_year(year);
    }

    ## Returns the number of days in this date's month.
    ##
    ## @returns 28 to 31
    days_in_month(): int {
        return _time_days_in_month(year, month);
    }

    ## Returns the date `days` days later, or earlier when `days` is
    ## negative.
    ##
    ## @param days the number of days to move
    ## @returns the date
    ## @panics if the date is outside the years -999999 to 999999
    add_days(days: long): Date {
        return Date.from_days(days() + days);
    }

    ## Returns the date `months` months later, or earlier when `months` is
    ## negative. A day past the end of the new month becomes its last day:
    ## a month after January 31 is February 28 or 29.
    ##
    ## @param months the number of months to move
    ## @returns the date
    ## @panics if the date is outside the years -999999 to 999999
    add_months(months: long): Date {
        var index = (year as long) * 12 + (month - 1) + months;
        var new_year = index / 12;
        var new_month = index % 12;
        if (new_month < 0) {
            new_month = new_month + 12;
            new_year = new_year - 1;
        }
        assert(new_year >= MINIMUM_YEAR && new_year <= MAXIMUM_YEAR, "time.Date: the date is out of range");
        var last = _time_days_in_month(new_year as int, (new_month + 1) as int);
        return Date(new_year as int, (new_month + 1) as int, day < last ? day : last);
    }

    ## Returns the date `years` years later, or earlier when `years` is
    ## negative. February 29 becomes February 28 in a year that is not a
    ## leap year.
    ##
    ## @param years the number of years to move
    ## @returns the date
    ## @panics if the date is outside the years -999999 to 999999
    add_years(years: long): Date {
        return add_months(years * 12);
    }

    ## Returns the number of days from `earlier` to this date: negative when
    ## `earlier` is later.
    ##
    ## @param earlier the date to count from
    ## @returns the number of days between them
    days_since(earlier: Date): long {
        return days() - earlier.days();
    }

    ## Returns the start of this date, midnight, as a `DateTime`.
    ##
    ## @param time the time of day; midnight by default
    ## @returns the date and time
    at(time: Time = Time()): DateTime {
        return DateTime.combine(this, time);
    }

    ## Returns whether this date is earlier than `other`.
    ##
    ## @param other the date to compare with
    ## @returns true when this one is earlier
    <(other: Date): bool {
        return _compare(other) < 0;
    }

    ## Returns whether this date is earlier than or the same as `other`.
    ##
    ## @param other the date to compare with
    ## @returns true when this one is not later
    <=(other: Date): bool {
        return _compare(other) <= 0;
    }

    ## Returns whether this date is later than `other`.
    ##
    ## @param other the date to compare with
    ## @returns true when this one is later
    >(other: Date): bool {
        return _compare(other) > 0;
    }

    ## Returns whether this date is later than or the same as `other`.
    ##
    ## @param other the date to compare with
    ## @returns true when this one is not earlier
    >=(other: Date): bool {
        return _compare(other) >= 0;
    }

    _compare(other: Date): int {
        if (year != other.year) {
            return year < other.year ? -1 : 1;
        }
        if (month != other.month) {
            return month < other.month ? -1 : 1;
        }
        if (day != other.day) {
            return day < other.day ? -1 : 1;
        }
        return 0;
    }

    ## Returns the date as text laid out by `pattern`, whose `%` codes are
    ## those of C's `strftime` (see the [time module](time-module.md)). The
    ## time of day is midnight, and an offset code (`%z`) panics.
    ##
    ## @param pattern the layout, such as `"%d %B %Y"`
    ## @returns the formatted date
    ## @panics if `pattern` has an unknown code, or an offset code
    format(pattern: String): String {
        return _time_format(pattern, this, Time(), Optional<int>.Empty);
    }

    ## Returns the date in ISO 8601 form: `2024-02-29`.
    ##
    ## @returns the date as text
    to_string(): String {
        var out = StringBuilder();
        _time_write_date(out, this);
        return out.to_string();
    }
}

extend Date with ToString;

## A time of day with no date or time zone: an hour (0 to 23), a minute,
## a second and a nanosecond. Leap seconds are not represented, as in Unix
## time.
##
## A value struct: copied, compared with `==`, `<` and the other
## comparisons, and never allocated. Its text is ISO 8601's `08:30:00`,
## with a fraction of a second when there is one (`08:30:00.25`).
##
## @example
##     import time;
##
##     main(): int {
##         var lunch = time.Time(12, 30);
##         print(lunch);   # 12:30:00
##         return 0;
##     }
[Value]
export struct Time {
    ## The hour, 0 to 23.
    var hour: int { get; }
    ## The minute, 0 to 59.
    var minute: int { get; }
    ## The second, 0 to 59.
    var second: int { get; }
    ## The nanosecond within the second, 0 to 999999999.
    var nanosecond: int { get; }

    ## Makes the time `hour`:`minute`:`second`; with no arguments,
    ## midnight.
    ##
    ## @param hour the hour, 0 to 23
    ## @param minute the minute, 0 to 59
    ## @param second the second, 0 to 59
    ## @param nanosecond the nanosecond within the second, 0 to 999999999
    ## @panics if a part is out of range: use `checked` for parts that come
    ##   from outside the program
    construct(hour: int = 0, minute: int = 0, second: int = 0, nanosecond: int = 0) {
        assert(
            _time_is_time(hour, minute, second, nanosecond),
            $"time.Time: {hour}:{minute}:{second}.{nanosecond} is not a time of day"
        );
        this.hour = hour;
        this.minute = minute;
        this.second = second;
        this.nanosecond = nanosecond;
    }

    ## Returns the time `hour`:`minute`:`second`, or none when a part is out
    ## of range.
    ##
    ## @param hour the hour, 0 to 23
    ## @param minute the minute, 0 to 59
    ## @param second the second, 0 to 59
    ## @param nanosecond the nanosecond within the second
    ## @returns the time, or none
    static checked(hour: int, minute: int, second: int = 0, nanosecond: int = 0): Time? {
        if (!_time_is_time(hour, minute, second, nanosecond)) {
            return Optional<Time>.Empty;
        }
        return Optional<Time>.Value(Time(hour, minute, second, nanosecond));
    }

    ## Returns the time `nanoseconds` nanoseconds after midnight.
    ##
    ## @param nanoseconds nanoseconds since midnight, less than a day's
    ## @returns the time
    ## @panics if `nanoseconds` is negative or a day or more
    static from_nanoseconds(nanoseconds: long): Time {
        assert(
            nanoseconds >= 0 && nanoseconds < SECONDS_PER_DAY * NANOSECONDS_PER_SECOND,
            "time.Time: the time is not within a day"
        );
        var seconds = nanoseconds / NANOSECONDS_PER_SECOND;
        return Time(
            (seconds / 3600) as int,
            (seconds / 60 % 60) as int,
            (seconds % 60) as int,
            (nanoseconds % NANOSECONDS_PER_SECOND) as int
        );
    }

    ## Returns the time in the ISO 8601 form `08:30:00`, with an optional
    ## fraction of a second (`08:30:00.25`), or an error when `text` is not
    ## a time. The seconds may be left out (`08:30`), as TOML 1.1 allows.
    ##
    ## @param text the text to read
    ## @returns the time, or an error saying what is wrong with `text`
    static parse(text: String): Result<Time> {
        var scanner = _TimeScanner(text);
        var time = scanner.time();
        if (time.is_err() || !scanner.at_end()) {
            return Result<Time>.err(Error($"invalid time '{text}'"));
        }
        return time;
    }

    ## Returns the number of nanoseconds since midnight.
    ##
    ## @returns nanoseconds since midnight
    nanoseconds(): long {
        return seconds() * NANOSECONDS_PER_SECOND + nanosecond;
    }

    ## Returns the number of whole seconds since midnight.
    ##
    ## @returns seconds since midnight
    seconds(): long {
        return (hour as long) * 3600 + minute * 60 + second;
    }

    ## Returns whether this time is earlier in the day than `other`.
    ##
    ## @param other the time to compare with
    ## @returns true when this one is earlier
    <(other: Time): bool {
        return nanoseconds() < other.nanoseconds();
    }

    ## Returns whether this time is earlier than or the same as `other`.
    ##
    ## @param other the time to compare with
    ## @returns true when this one is not later
    <=(other: Time): bool {
        return nanoseconds() <= other.nanoseconds();
    }

    ## Returns whether this time is later in the day than `other`.
    ##
    ## @param other the time to compare with
    ## @returns true when this one is later
    >(other: Time): bool {
        return nanoseconds() > other.nanoseconds();
    }

    ## Returns whether this time is later than or the same as `other`.
    ##
    ## @param other the time to compare with
    ## @returns true when this one is not earlier
    >=(other: Time): bool {
        return nanoseconds() >= other.nanoseconds();
    }

    ## Returns the time as text laid out by `pattern`, whose `%` codes are
    ## those of C's `strftime` (see the [time module](time-module.md)). The
    ## date is 1970-01-01, and an offset code (`%z`) panics.
    ##
    ## @param pattern the layout, such as `"%H:%M"`
    ## @returns the formatted time
    ## @panics if `pattern` has an unknown code, or an offset code
    format(pattern: String): String {
        return _time_format(pattern, Date(), this, Optional<int>.Empty);
    }

    ## Returns the time in ISO 8601 form: `08:30:00`, with the fraction of a
    ## second when it is not zero, without trailing zeros (`08:30:00.25`).
    ##
    ## @returns the time as text
    to_string(): String {
        var out = StringBuilder();
        _time_write_time(out, this);
        return out.to_string();
    }
}

extend Time with ToString;

## A date and a time of day with no time zone, such as a meeting's
## `2024-03-01 09:00` written down without saying where. TOML calls it a
## local date-time. Attach an offset with `OffsetDateTime`, or a zone's
## rules with `TimeZone.at_local`, to name an instant.
##
## A value struct: copied, compared with `==`, `<` and the other
## comparisons, and never allocated. Its text is ISO 8601's
## `2024-03-01T09:00:00`.
##
## @example
##     import time;
##
##     main(): int {
##         var start = time.DateTime(2024, 3, 1, 9, 0);
##         var end = start + os.Duration.from_seconds(90 * 60);
##         print(end);   # 2024-03-01T10:30:00
##         return 0;
##     }
[Value]
export struct DateTime {
    ## The date.
    var date: Date { get; }
    ## The time of day.
    var time: Time { get; }

    ## Makes the date and time from its parts; with no arguments, the Unix
    ## epoch's 1970-01-01T00:00:00.
    ##
    ## @param year the year, from -999999 to 999999
    ## @param month the month, 1 to 12
    ## @param day the day of the month
    ## @param hour the hour, 0 to 23
    ## @param minute the minute, 0 to 59
    ## @param second the second, 0 to 59
    ## @param nanosecond the nanosecond within the second
    ## @panics if the parts do not name a date and time
    construct(
        year: int = 1970,
        month: int = 1,
        day: int = 1,
        hour: int = 0,
        minute: int = 0,
        second: int = 0,
        nanosecond: int = 0
    ) {
        this.date = Date(year, month, day);
        this.time = Time(hour, minute, second, nanosecond);
    }

    ## Returns `date` at `time`.
    ##
    ## @param date the date
    ## @param time the time of day
    ## @returns the date and time
    static combine(date: Date, time: Time): DateTime {
        var result = DateTime();
        result.date = date;
        result.time = time;
        return result;
    }

    ## Returns the date and time `nanoseconds` nanoseconds after
    ## 1970-01-01T00:00:00, counting every day as 86400 seconds.
    ##
    ## @param nanoseconds nanoseconds since the epoch; negative for earlier
    ## @returns the date and time
    static from_unix_nanoseconds(nanoseconds: long): DateTime {
        var per_day = SECONDS_PER_DAY * NANOSECONDS_PER_SECOND;
        var days = nanoseconds / per_day;
        var rest = nanoseconds % per_day;
        if (rest < 0) {
            rest = rest + per_day;
            days = days - 1;
        }
        return DateTime.combine(Date.from_days(days), Time.from_nanoseconds(rest));
    }

    ## Returns the date and time `seconds` seconds after
    ## 1970-01-01T00:00:00, counting every day as 86400 seconds, as Unix
    ## time does. Reaches further than a `SystemTime`.
    ##
    ## @param seconds seconds since the epoch; negative for earlier
    ## @param nanosecond the nanosecond within the second
    ## @returns the date and time
    ## @panics if `nanosecond` is not from 0 to 999999999, or the date is
    ##   outside the years -999999 to 999999
    static from_unix_seconds(seconds: long, nanosecond: int = 0): DateTime {
        var days = seconds / SECONDS_PER_DAY;
        var rest = seconds % SECONDS_PER_DAY;
        if (rest < 0) {
            rest = rest + SECONDS_PER_DAY;
            days = days - 1;
        }
        return DateTime.combine(
            Date.from_days(days), Time((rest / 3600) as int, (rest / 60 % 60) as int, (rest % 60) as int, nanosecond)
        );
    }

    ## Returns the date and time in UTC of a wall-clock reading.
    ##
    ## @param time the instant
    ## @returns its date and time in UTC
    static from_system_time(time: os.SystemTime): DateTime {
        return DateTime.from_unix_nanoseconds(time.unix_nanoseconds());
    }

    ## Returns the date and time in the ISO 8601 form
    ## `2024-03-01T09:00:00`, or an error when `text` is not one. A space or
    ## a lowercase `t` may stand for the `T`, as TOML allows, and the
    ## seconds may be left out.
    ##
    ## @param text the text to read
    ## @returns the date and time, or an error saying what is wrong with
    ##   `text`
    static parse(text: String): Result<DateTime> {
        var scanner = _TimeScanner(text);
        var date_time = scanner.date_time();
        if (date_time.is_err() || !scanner.at_end()) {
            return Result<DateTime>.err(Error($"invalid date and time '{text}'"));
        }
        return date_time;
    }

    ## Returns the number of seconds from 1970-01-01T00:00:00 to this date
    ## and time, rounded down, counting every day as 86400 seconds.
    ##
    ## @returns seconds since the epoch; negative for earlier
    unix_seconds(): long {
        return date.days() * SECONDS_PER_DAY + time.seconds();
    }

    ## Returns this date and time as a `SystemTime`, reading it as UTC.
    ##
    ## @returns the instant
    ## @panics if the date is outside what a `SystemTime` reaches, the
    ##   years 1677 to 2262
    to_system_time(): os.SystemTime {
        return _time_system_time(unix_seconds(), time.nanosecond);
    }

    ## The year, as `date.year`.
    var year: int {
        get {
            return date.year;
        }
    }
    ## The month, 1 to 12, as `date.month`.
    var month: int {
        get {
            return date.month;
        }
    }
    ## The day of the month, as `date.day`.
    var day: int {
        get {
            return date.day;
        }
    }
    ## The hour, 0 to 23, as `time.hour`.
    var hour: int {
        get {
            return time.hour;
        }
    }
    ## The minute, as `time.minute`.
    var minute: int {
        get {
            return time.minute;
        }
    }
    ## The second, as `time.second`.
    var second: int {
        get {
            return time.second;
        }
    }
    ## The nanosecond within the second, as `time.nanosecond`.
    var nanosecond: int {
        get {
            return time.nanosecond;
        }
    }

    ## Returns the day of the week.
    ##
    ## @returns the weekday
    weekday(): Weekday {
        return date.weekday();
    }

    ## Returns the date and time `duration` later.
    ##
    ## @param duration how far to move forward
    ## @returns the later date and time
    ## @panics if the result is past the year 999999
    +(duration: os.Duration): DateTime {
        return _moved(duration, 1);
    }

    ## Returns the date and time `duration` earlier.
    ##
    ## @param duration how far to move back
    ## @returns the earlier date and time
    ## @panics if the result is before the year -999999
    -(duration: os.Duration): DateTime {
        return _moved(duration, -1);
    }

    _moved(duration: os.Duration, sign: long): DateTime {
        var total = duration.nanoseconds();
        var per_second = NANOSECONDS_PER_SECOND as ulong;
        var seconds = (total / per_second) as long;
        var nanoseconds = (total % per_second) as long;
        var new_nanosecond = time.nanosecond + sign * nanoseconds;
        var new_seconds = unix_seconds() + sign * seconds;
        if (new_nanosecond < 0) {
            new_nanosecond = new_nanosecond + NANOSECONDS_PER_SECOND;
            new_seconds = new_seconds - 1;
        } else if (new_nanosecond >= NANOSECONDS_PER_SECOND) {
            new_nanosecond = new_nanosecond - NANOSECONDS_PER_SECOND;
            new_seconds = new_seconds + 1;
        }
        return DateTime.from_unix_seconds(new_seconds, new_nanosecond as int);
    }

    ## Returns whether this date and time is earlier than `other`.
    ##
    ## @param other the date and time to compare with
    ## @returns true when this one is earlier
    <(other: DateTime): bool {
        return _compare(other) < 0;
    }

    ## Returns whether this date and time is earlier than or the same as
    ## `other`.
    ##
    ## @param other the date and time to compare with
    ## @returns true when this one is not later
    <=(other: DateTime): bool {
        return _compare(other) <= 0;
    }

    ## Returns whether this date and time is later than `other`.
    ##
    ## @param other the date and time to compare with
    ## @returns true when this one is later
    >(other: DateTime): bool {
        return _compare(other) > 0;
    }

    ## Returns whether this date and time is later than or the same as
    ## `other`.
    ##
    ## @param other the date and time to compare with
    ## @returns true when this one is not earlier
    >=(other: DateTime): bool {
        return _compare(other) >= 0;
    }

    _compare(other: DateTime): int {
        if (date != other.date) {
            return date < other.date ? -1 : 1;
        }
        if (time != other.time) {
            return time < other.time ? -1 : 1;
        }
        return 0;
    }

    ## Returns the date and time as text laid out by `pattern`, whose `%`
    ## codes are those of C's `strftime` (see the
    ## [time module](time-module.md)). An offset code (`%z`) panics.
    ##
    ## @param pattern the layout, such as `"%Y-%m-%d %H:%M"`
    ## @returns the formatted date and time
    ## @panics if `pattern` has an unknown code, or an offset code
    format(pattern: String): String {
        return _time_format(pattern, date, time, Optional<int>.Empty);
    }

    ## Returns the date and time in ISO 8601 form: `2024-03-01T09:00:00`,
    ## with the fraction of a second when it is not zero.
    ##
    ## @returns the date and time as text
    to_string(): String {
        var out = StringBuilder();
        _time_write_date(out, date);
        out.append("T");
        _time_write_time(out, time);
        return out.to_string();
    }
}

extend DateTime with ToString;

# ── Calendar arithmetic ──────────────────────────────────────────────────────

_time_is_date(year: int, month: int, day: int): bool {
    if (year < MINIMUM_YEAR || year > MAXIMUM_YEAR || month < 1 || month > 12) {
        return false;
    }
    return day >= 1 && day <= _time_days_in_month(year, month);
}

_time_is_leap_year(year: int): bool {
    return year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
}

# The length of a month from 1 to 12.
_time_days_in_month(year: int, month: int): int {
    if (month == 2) {
        return _time_is_leap_year(year) ? 29 : 28;
    }
    if (month == 4 || month == 6 || month == 9 || month == 11) {
        return 30;
    }
    return 31;
}

_time_is_time(hour: int, minute: int, second: int, nanosecond: int): bool {
    return hour >= 0
        && hour < 24
        && minute >= 0
        && minute < 60
        && second >= 0
        && second < 60
        && nanosecond >= 0
        && nanosecond < 1000000000;
}

# Days from 1970-01-01 to a date: Howard Hinnant's days_from_civil, which
# counts in 400-year eras of 146097 days, with years starting in March so
# the leap day comes last.
_time_days_from_civil(year: int, month: int, day: int): long {
    var y = year as long;
    if (month <= 2) {
        y = y - 1;
    }
    var era = (y >= 0 ? y : y - 399) / 400;
    var year_of_era = y - era * 400;
    var shifted_month = month > 2 ? month - 3 : month + 9;
    var day_of_year = (153 * (shifted_month as long) + 2) / 5 + day - 1;
    var day_of_era = year_of_era * 365 + year_of_era / 4 - year_of_era / 100 + day_of_year;
    return era * 146097 + day_of_era - 719468;
}

# The inverse of _time_days_from_civil: (year, month, day).
_time_civil_from_days(days: long): (long, int, int) {
    var z = days + 719468;
    var era = (z >= 0 ? z : z - 146096) / 146097;
    var day_of_era = z - era * 146097;
    var year_of_era = (day_of_era - day_of_era / 1460 + day_of_era / 36524 - day_of_era / 146096) / 365;
    var day_of_year = day_of_era - (365 * year_of_era + year_of_era / 4 - year_of_era / 100);
    var shifted_month = (5 * day_of_year + 2) / 153;
    var day = (day_of_year - (153 * shifted_month + 2) / 5 + 1) as int;
    var month = (shifted_month < 10 ? shifted_month + 3 : shifted_month - 9) as int;
    var year = year_of_era + era * 400;
    if (month <= 2) {
        year = year + 1;
    }
    return (year, month, day);
}

# A SystemTime from Unix seconds and a nanosecond, checking its range.
_time_system_time(seconds: long, nanosecond: int): os.SystemTime {
    # SystemTime holds a long of nanoseconds: about ±9223372036 seconds.
    var limit = 9223372035 as long;
    assert(seconds <= limit && seconds >= 0 - limit, "time: the date is outside what os.SystemTime reaches");
    return os.SystemTime.from_unix_nanoseconds(seconds * NANOSECONDS_PER_SECOND + nanosecond);
}
time/format
17932
# Reading and writing dates and times as text: ISO 8601 and RFC 3339
# (_TimeScanner, _time_write_*), strftime patterns (_time_format) and HTTP
# dates (_time_parse_http_date).

import "civil";
import "offset";

const MONTH_ABBREVIATIONS: StringConstant = "JanFebMarAprMayJunJulAugSepOctNovDec";
const MONTH_NAMES: StringConstant = "January,February,March,April,May,June,July,August,September,October,November,December";

# Reads ISO 8601 / RFC 3339 pieces from the front of a text, one call after
# another; each returns an Err (and leaves `index` wherever it stopped) when
# the text does not continue with that piece.
struct _TimeScanner {
    var _text: String;
    var _data: u8[];
    var index: ulong;

    construct(text: String) {
        _text = text;
        _data = text.bytes();
        index = 0;
    }

    at_end(): bool {
        return index >= _data.count;
    }

    # The next byte, or -1 at the end.
    peek(): int {
        return at_end() ? -1 : _data[index] as int;
    }

    # Consumes `c` when it comes next.
    take(c: int): bool {
        if (peek() != c) {
            return false;
        }
        index = index + 1;
        return true;
    }

    # Exactly `count` decimal digits as a number, or -1.
    digits(count: int): long {
        long value = 0;
        for (var i in 0..count) {
            var c = peek();
            if (c < '0' || c > '9') {
                return -1;
            }
            value = value * 10 + (c - '0');
            index = index + 1;
        }
        return value;
    }

    # A run of ASCII letters, possibly empty.
    word(): String {
        var start = index;
        while (true) {
            var c = peek();
            if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'))) {
                break;
            }
            index = index + 1;
        }
        return _text.substr_bytes(start, index - start);
    }

    # `YYYY-MM-DD`, or a signed year of four or more digits: `+10000-01-01`.
    date(): Result<Date> {
        var invalid = Result<Date>.err(Error("invalid date"));
        long year = 0;
        var c = peek();
        if (c == '+' || c == '-') {
            index = index + 1;
            var count = 0;
            while (peek() >= '0' && peek() <= '9' && count < 7) {
                year = year * 10 + (peek() - '0');
                index = index + 1;
                count = count + 1;
            }
            if (count < 4) {
                return invalid;
            }
            if (c == '-') {
                year = 0 - year;
            }
        } else {
            year = digits(4);
            if (year < 0) {
                return invalid;
            }
        }
        if (!take('-')) {
            return invalid;
        }
        var month = digits(2);
        if (month < 0 || !take('-')) {
            return invalid;
        }
        var day = digits(2);
        if (day < 0 || year > 999999 || year < -999999) {
            return invalid;
        }
        var date = Date.checked(year as int, month as int, day as int);
        if (date.is_empty()) {
            return invalid;
        }
        return Result<Date>.ok(date.value());
    }

    # `HH:MM`, `HH:MM:SS` or `HH:MM:SS.fraction`; digits past nanoseconds
    # are dropped.
    time(): Result<Time> {
        var invalid = Result<Time>.err(Error("invalid time"));
        var hour = digits(2);
        if (hour < 0 || !take(':')) {
            return invalid;
        }
        var minute = digits(2);
        if (minute < 0) {
            return invalid;
        }
        long second = 0;
        long nanosecond = 0;
        if (take(':')) {
            second = digits(2);
            if (second < 0) {
                return invalid;
            }
            if (take('.')) {
                long scale = 100000000;
                var count = 0;
                while (peek() >= '0' && peek() <= '9') {
                    nanosecond = nanosecond + (peek() - '0') * scale;
                    scale = scale / 10;
                    index = index + 1;
                    count = count + 1;
                }
                if (count == 0) {
                    return invalid;
                }
            }
        }
        var time = Time.checked(hour as int, minute as int, second as int, nanosecond as int);
        if (time.is_empty()) {
            return invalid;
        }
        return Result<Time>.ok(time.value());
    }

    # A date, `T` (or `t`, or a space), and a time.
    date_time(): Result<DateTime> {
        var invalid = Result<DateTime>.err(Error("invalid date and time"));
        var date = date();
        if (date.is_err()) {
            return invalid;
        }
        if (!take('T') && !take('t') && !take(' ')) {
            return invalid;
        }
        var time = time();
        if (time.is_err()) {
            return invalid;
        }
        return Result<DateTime>.ok(DateTime.combine(date.value(), time.value()));
    }

    # `Z` (or `z`), or `+HH:MM`, optionally with `:SS`. When `loose`, also
    # `+HH` and `+HHMM`.
    offset(loose: bool): Result<Offset> {
        var invalid = Result<Offset>.err(Error("invalid UTC offset"));
        if (take('Z') || take('z')) {
            return Result<Offset>.ok(Offset());
        }
        var sign = peek();
        if (sign != '+' && sign != '-') {
            return invalid;
        }
        index = index + 1;
        var hours = digits(2);
        if (hours < 0) {
            return invalid;
        }
        long minutes = 0;
        long seconds = 0;
        var colon = take(':');
        if (colon || (loose && !at_end())) {
            minutes = digits(2);
            if (minutes < 0) {
                return invalid;
            }
            if (colon && take(':')) {
                seconds = digits(2);
                if (seconds < 0) {
                    return invalid;
                }
            }
        } else if (!loose) {
            return invalid;
        }
        if (hours > 23 || minutes > 59 || seconds > 59) {
            return invalid;
        }
        var total = (hours * 3600 + minutes * 60 + seconds) as int;
        return Result<Offset>.ok(Offset(sign == '-' ? 0 - total : total));
    }
}

# ── Writing ──────────────────────────────────────────────────────────────────

# The year with at least four digits, signed outside 0 to 9999.
_time_write_year(out: StringBuilder, year: int) {
    if (year < 0) {
        out.append($"-{0 - year:04}");
    } else if (year > 9999) {
        out.append($"+{year}");
    } else {
        out.append($"{year:04}");
    }
}

_time_write_date(out: StringBuilder, date: Date) {
    _time_write_year(out, date.year);
    out.append($"-{date.month:02}-{date.day:02}");
}

# HH:MM:SS, then the fraction of a second without trailing zeros.
_time_write_time(out: StringBuilder, time: Time) {
    out.append($"{time.hour:02}:{time.minute:02}:{time.second:02}");
    if (time.nanosecond != 0) {
        var fraction = $"{time.nanosecond:09}";
        var size = fraction.size;
        while (fraction.byte_at(size - 1) == '0') {
            size = size - 1;
        }
        out.append(".");
        out.append(fraction.substr_bytes(0, size));
    }
}

# +HH:MM (or +HHMM without `colon`), with :SS when there are seconds, or Z
# for zero when `z_for_utc`.
_time_write_offset(out: StringBuilder, seconds: int, colon: bool, z_for_utc: bool) {
    if (seconds == 0 && z_for_utc) {
        out.append("Z");
        return;
    }
    var magnitude = seconds < 0 ? 0 - seconds : seconds;
    out.append(seconds < 0 ? "-" : "+");
    var separator = colon ? ":" : "";
    out.append($"{magnitude / 3600:02}{separator}{magnitude / 60 % 60:02}");
    if (magnitude % 60 != 0) {
        out.append($"{separator}{magnitude % 60:02}");
    }
}

_time_month_abbreviation(month: int): String {
    return MONTH_ABBREVIATIONS.substr_bytes(((month - 1) * 3) as ulong, 3);
}

_time_month_name(month: int): String {
    return MONTH_NAMES.split(",")[(month - 1) as ulong];
}

# The ISO 8601 week-numbering year and week (1 to 53) of a date. Weeks start
# on Monday, and week 1 is the one holding the year's first Thursday.
_time_iso_week(date: Date): (int, int) {
    var weekday = date.weekday() as int;
    var week = (date.day_of_year() - weekday + 10) / 7;
    if (week < 1) {
        return (date.year - 1, _time_iso_weeks_in(date.year - 1));
    }
    if (week > _time_iso_weeks_in(date.year)) {
        return (date.year + 1, 1);
    }
    return (date.year, week);
}

# 53 when the year starts on a Thursday, or is a leap year that starts on a
# Wednesday; 52 otherwise.
_time_iso_weeks_in(year: int): int {
    var first = Date(year, 1, 1).weekday();
    if (first == Weekday.Thursday || (is_leap_year(year) && first == Weekday.Wednesday)) {
        return 53;
    }
    return 52;
}

# strftime: `%` codes in `pattern` replaced by parts of the date, time and,
# when there is one, offset (seconds east of UTC).
_time_format(pattern: String, date: Date, time: Time, offset: int?): String {
    var out = StringBuilder();
    var data = pattern.bytes();
    var size = data.count;
    ulong index = 0;
    ulong start = 0;
    while (index < size) {
        if (data[index] != '%') {
            index = index + 1;
            continue;
        }
        if (index > start) {
            out.append(pattern.substr_bytes(start, index - start));
        }
        index = index + 1;
        assert(index < size, "time.format: the pattern ends with '%'");
        var code = data[index] as int;
        # %:z, and a digit count before N (%3N).
        var colon = false;
        var width = 9;
        if (code == ':' && index + 1 < size) {
            colon = true;
            index = index + 1;
            code = data[index] as int;
            assert(code == 'z', "time.format: '%:' is only used in '%:z'");
        } else if (code >= '1' && code <= '9' && index + 1 < size && data[index + 1] == 'N') {
            width = code - '0';
            index = index + 1;
            code = 'N';
        }
        index = index + 1;
        start = index;
        if (code == 'Y') {
            _time_write_year(out, date.year);
        } else if (code == 'C') {
            out.append($"{_time_floor_div(date.year, 100):02}");
        } else if (code == 'y') {
            out.append($"{_time_floor_mod(date.year, 100):02}");
        } else if (code == 'm') {
            out.append($"{date.month:02}");
        } else if (code == 'd') {
            out.append($"{date.day:02}");
        } else if (code == 'e') {
            out.append($"{date.day:2}");
        } else if (code == 'j') {
            out.append($"{date.day_of_year():03}");
        } else if (code == 'F') {
            _time_write_date(out, date);
        } else if (code == 'a') {
            out.append(date.weekday().name().substr_bytes(0, 3));
        } else if (code == 'A') {
            out.append(date.weekday().name());
        } else if (code == 'b' || code == 'h') {
            out.append(_time_month_abbreviation(date.month));
        } else if (code == 'B') {
            out.append(_time_month_name(date.month));
        } else if (code == 'u') {
            out.append($"{date.weekday() as int}");
        } else if (code == 'w') {
            out.append($"{(date.weekday() as int) % 7}");
        } else if (code == 'G') {
            var (year, week) = _time_iso_week(date);
            _time_write_year(out, year);
        } else if (code == 'V') {
            var (year, week) = _time_iso_week(date);
            out.append($"{week:02}");
        } else if (code == 'H') {
            out.append($"{time.hour:02}");
        } else if (code == 'I') {
            var hour = time.hour % 12;
            out.append($"{hour == 0 ? 12 : hour:02}");
        } else if (code == 'p') {
            out.append(time.hour < 12 ? "AM" : "PM");
        } else if (code == 'M') {
            out.append($"{time.minute:02}");
        } else if (code == 'S') {
            out.append($"{time.second:02}");
        } else if (code == 'N') {
            out.append($"{time.nanosecond:09}".substr_bytes(0, width as ulong));
        } else if (code == 'T') {
            out.append($"{time.hour:02}:{time.minute:02}:{time.second:02}");
        } else if (code == 'R') {
            out.append($"{time.hour:02}:{time.minute:02}");
        } else if (code == 'z') {
            assert(offset.is_value(), "time.format: '%z' needs an offset; format an OffsetDateTime");
            _time_write_offset(out, offset.value(), colon, false);
        } else if (code == 's') {
            assert(offset.is_value(), "time.format: '%s' needs an offset; format an OffsetDateTime");
            var seconds = date.days() * 86400 + time.seconds() - offset.value();
            out.append($"{seconds}");
        } else if (code == 'n') {
            out.append("\n");
        } else if (code == 't') {
            out.append("\t");
        } else if (code == '%') {
            out.append("%");
        } else {
            panic($"time.format: unknown code '%{pattern.substr_bytes(index - 1, 1)}'");
        }
    }
    if (size > start) {
        out.append(pattern.substr_bytes(start, size - start));
    }
    return out.to_string();
}

_time_floor_div(value: int, unit: int): int {
    var quotient = value / unit;
    if (value % unit < 0) {
        quotient = quotient - 1;
    }
    return quotient;
}

_time_floor_mod(value: int, unit: int): int {
    var rest = value % unit;
    return rest < 0 ? rest + unit : rest;
}

# ── HTTP dates ───────────────────────────────────────────────────────────────

# The month (1 to 12) a three-letter abbreviation names, or 0.
_time_month_from_abbreviation(name: String): int {
    if (name.size != 3) {
        return 0;
    }
    var at = MONTH_ABBREVIATIONS.find(name);
    return at < 0 || at % 3 != 0 ? 0 : (at / 3 + 1) as int;
}

# HH:MM:SS, exactly.
_time_scan_clock(scanner: _TimeScanner): Time? {
    var hour = scanner.digits(2);
    if (hour < 0 || !scanner.take(':')) {
        return Optional<Time>.Empty;
    }
    var minute = scanner.digits(2);
    if (minute < 0 || !scanner.take(':')) {
        return Optional<Time>.Empty;
    }
    var second = scanner.digits(2);
    if (second < 0) {
        return Optional<Time>.Empty;
    }
    return Time.checked(hour as int, minute as int, second as int);
}

# An IMF-fixdate, RFC 850 date or asctime date (RFC 9110 section 5.6.7), in
# UTC.
_time_parse_http_date(text: String): DateTime? {
    var none = Optional<DateTime>.Empty;
    var scanner = _TimeScanner(text);
    var weekday = scanner.word();
    long year = 0;
    long day = 0;
    var month = 0;
    Time? clock = Optional<Time>.Empty;
    if (scanner.take(',')) {
        if (!scanner.take(' ')) {
            return none;
        }
        day = scanner.digits(2);
        if (day < 0) {
            return none;
        }
        if (scanner.take(' ')) {
            # IMF-fixdate: Sun, 06 Nov 1994 08:49:37 GMT
            if (weekday.size != 3) {
                return none;
            }
            month = _time_month_from_abbreviation(scanner.word());
            if (!scanner.take(' ')) {
                return none;
            }
            year = scanner.digits(4);
        } else if (scanner.take('-')) {
            # RFC 850: Sunday, 06-Nov-94 08:49:37 GMT
            if (weekday.size <= 3) {
                return none;
            }
            month = _time_month_from_abbreviation(scanner.word());
            if (!scanner.take('-')) {
                return none;
            }
            year = scanner.digits(2);
            if (year >= 0) {
                year = year + (year >= 70 ? 1900 : 2000);
            }
        } else {
            return none;
        }
        if (year < 0 || !scanner.take(' ')) {
            return none;
        }
        clock = _time_scan_clock(scanner);
        if (!scanner.take(' ') || scanner.word() != "GMT") {
            return none;
        }
    } else {
        # asctime: Sun Nov  6 08:49:37 1994
        if (weekday.size != 3 || !scanner.take(' ')) {
            return none;
        }
        month = _time_month_from_abbreviation(scanner.word());
        if (!scanner.take(' ')) {
            return none;
        }
        if (scanner.take(' ')) {
            day = scanner.digits(1);
        } else {
            day = scanner.digits(2);
        }
        if (day < 0 || !scanner.take(' ')) {
            return none;
        }
        clock = _time_scan_clock(scanner);
        if (!scanner.take(' ')) {
            return none;
        }
        year = scanner.digits(4);
        if (year < 0) {
            return none;
        }
    }
    if (!scanner.at_end() || clock.is_empty()) {
        return none;
    }
    var date = Date.checked(year as int, month, day as int);
    if (date.is_empty()) {
        return none;
    }
    var name = date.value().weekday().name();
    if (weekday != name && weekday != name.substr_bytes(0, 3)) {
        return none;
    }
    return Optional<DateTime>.Value(DateTime.combine(date.value(), clock.value()));
}
time/module
3019
## Calendar time: dates, times of day, offsets from UTC, time zones, and
## formatting and parsing them, on the proleptic Gregorian calendar. Leap
## seconds are ignored, as in Unix time. `os.SystemTime` is the instant
## this module turns into dates and back.
##
## `time` is a module: bring it in with `import time` (and write
## `time.Date(2024, 2, 29)`) or import names directly with
## `import [Date, TimeZone] from time`.
##
## - [Dates and times](time-civil.md): `Date`, `Time`, `DateTime`,
##   `Weekday`, `is_leap_year` and `days_in_month`, with no time zone
## - [Offsets](time-offset.md): `Offset`, a fixed offset from UTC, and
##   `OffsetDateTime`, an RFC 3339 timestamp, with HTTP dates
## - [Time zones](time-zone.md): `TimeZone` (UTC, fixed, local, or named
##   from the system's database), `now()` and `now_utc()`
##
## Every type's `format(pattern)` lays it out with C `strftime` codes:
##
## | Code | Gives | Code | Gives |
## |---|---|---|---|
## | `%Y` | year, at least four digits (`2024`) | `%H` | hour, `00` to `23` |
## | `%C` | century (`20`) | `%I` | hour, `01` to `12` |
## | `%y` | year in the century, `00` to `99` | `%p` | `AM` or `PM` |
## | `%m` | month, `01` to `12` | `%M` | minute, `00` to `59` |
## | `%d` | day, `01` to `31` | `%S` | second, `00` to `59` |
## | `%e` | day, space-padded (` 1`) | `%N` | nanoseconds, nine digits; `%3N` milliseconds |
## | `%j` | day of the year, `001` to `366` | `%T` | `%H:%M:%S` |
## | `%F` | `%Y-%m-%d` | `%R` | `%H:%M` |
## | `%a` | weekday, `Mon` | `%z` | offset, `+0100` |
## | `%A` | weekday, `Monday` | `%:z` | offset, `+01:00` |
## | `%b`, `%h` | month, `Jan` | `%s` | Unix seconds |
## | `%B` | month, `January` | `%u` | ISO weekday, `1` (Monday) to `7` |
## | `%G` | ISO 8601 week-numbering year | `%w` | weekday, `0` (Sunday) to `6` |
## | `%V` | ISO 8601 week, `01` to `53` | `%n`, `%t`, `%%` | newline, tab, `%` |
##
## Names are English, whatever the locale. `%z`, `%:z` and `%s` need an
## offset, so only `OffsetDateTime.format` takes them.
##
## @example
##     import os;
##     import time;
##
##     main(): int {
##         var now = time.now();
##         print(now);                                  # 2024-03-01T09:00:00.25+01:00
##         print(now.format("%A %e %B %Y, %H:%M"));     # Friday  1 March 2024, 09:00
##         print(now.to_http_date());                   # Fri, 01 Mar 2024 08:00:00 GMT
##         var date = time.Date.parse("2024-02-29").value();
##         print(date.add_years(1));                    # 2025-02-28
##         return 0;
##     }

# This file only gathers the module's public API from its other files.

import "civil";
import "format";
import "offset";
import "sys_posix";
import "sys_wasi";
import "sys_windows";
import "zone";

export is_leap_year;
export days_in_month;
export Weekday;
export Date;
export Time;
export DateTime;
export Offset;
export OffsetDateTime;
export TimeZone;
export now;
export now_utc;
