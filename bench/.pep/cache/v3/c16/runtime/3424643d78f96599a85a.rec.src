async/driver_kqueue
7074
# The kqueue I/O driver (macOS) for the task runtime; see driver.pep.
#
# A socket is registered once, edge-triggered (EV_CLEAR), with a read filter
# and a write filter, the first time a task waits on it. Closing the socket
# removes both. An event's ident is the socket.
#
# struct kevent is 32 bytes: ident (u64) at 0, filter (i16) at 8, flags
# (u16) at 10, fflags (u32) at 12, data (i64) at 16, udata at 24. The system
# calls are [Target(OS(Mac))]; elsewhere `_async_kqueue_create` fails, so
# the driver is unavailable.
#
# The doorbell is an EVFILT_USER event (ident 0, EV_CLEAR) added when the
# queue is made; a ring triggers it (NOTE_TRIGGER) from any thread.

import io;
import "driver";
import "task";

[Target(OS(Mac))]
extern int kqueue();
[Target(OS(Mac))]
extern int kevent(int queue, void* changes, int change_count, void* events, int event_count, void* timeout);
[Target(OS(Mac))]
extern int close(int descriptor);

# The most events one poll returns.
const _KQUEUE_CAPACITY = 256;
# EVFILT_READ and EVFILT_WRITE.
const _KQUEUE_FILTER_READ = -1;
const _KQUEUE_FILTER_WRITE = -2;
# EVFILT_USER, the doorbell's filter.
const _KQUEUE_FILTER_USER = -10;
# EV_EOF | EV_ERROR: the peer closed, or the socket failed; wake both sides.
const _KQUEUE_END_FLAGS = 49152;

# A worker's kqueue.
struct _KqueueDriver {
    var _queue: long;
    # Room for `_KQUEUE_CAPACITY` events of 32 bytes.
    var _events: __ptr<u8>;

    construct(queue: long) {
        this._queue = queue;
        this._events = _pep_malloc((_KQUEUE_CAPACITY * 32) as ulong);
    }

    # A new driver, or none when the system has no kqueue.
    static open(): _KqueueDriver? {
        var queue = _async_kqueue_create();
        if (queue < 0) {
            return Optional<_KqueueDriver>.Empty;
        }
        __ptr<u8> bell = _pep_malloc(32);
        _async_kqueue_change(bell, 0, 0, _KQUEUE_FILTER_USER);
        var added = _async_kqueue_call(queue, bell, 1, __null, 0, -1) == 0;
        _pep_free(bell);
        if (!added) {
            _async_kqueue_close(queue);
            return Optional<_KqueueDriver>.Empty;
        }
        return Optional<_KqueueDriver>.Value(_KqueueDriver(queue));
    }
}

extend _KqueueDriver with _Driver {
    _watch(handle: io.SocketHandle): bool {
        __ptr<u8> change = _pep_malloc(32);
        _async_kqueue_change(change, 0, handle, _KQUEUE_FILTER_READ);
        var added = _async_kqueue_call(this._queue, change, 1, __null, 0, -1) == 0;
        if (added) {
            # A descriptor that is never writable, such as a Watcher's
            # kqueue, refuses the write filter; it only waits for reading.
            _async_kqueue_change(change, 0, handle, _KQUEUE_FILTER_WRITE);
            _async_kqueue_call(this._queue, change, 1, __null, 0, -1);
        }
        _pep_free(change);
        return added;
    }

    _poll(waits: HashMap<ulong, _SocketWaits>, timeout: long, ready_sockets: Array<(handle: ulong, interest: int)>) {
        var count = _async_kqueue_call(this._queue, __null, 0, this._events, _KQUEUE_CAPACITY, timeout);
        var i = 0;
        while (i < count) {
            var event = this._events + (i as ulong) * 32;
            var filter = unsafe_cast<__ptr<i16>>(event + 8)[0] as int;
            if (filter == _KQUEUE_FILTER_USER) {
                i = i + 1;
                continue;
            }
            var flags = unsafe_cast<__ptr<u16>>(event + 10)[0] as int;
            var interest = io._IO_WRITABLE;
            if ((flags & _KQUEUE_END_FLAGS) != 0) {
                interest = io._IO_READABLE | io._IO_WRITABLE;
            } else if (filter == _KQUEUE_FILTER_READ) {
                interest = io._IO_READABLE;
            }
            ready_sockets.append((unsafe_cast<__ptr<ulong>>(event)[0], interest));
            i = i + 1;
        }
    }

    _want(handle: io.SocketHandle, interest: int): bool {
        return true;
    }

    _forget(handle: io.SocketHandle) {}

    _release(handle: io.SocketHandle) {
        __ptr<u8> changes = _pep_malloc(64);
        _async_kqueue_change(changes, 0, handle, _KQUEUE_FILTER_READ);
        _async_kqueue_change(changes, 1, handle, _KQUEUE_FILTER_WRITE);
        unsafe_cast<__ptr<u16>>(changes + 10)[0] = 2;  # EV_DELETE
        unsafe_cast<__ptr<u16>>(changes + 42)[0] = 2;
        _async_kqueue_call(this._queue, changes, 2, __null, 0, -1);
        _pep_free(changes);
    }

    _doorbell(): _Doorbell {
        return _Doorbell(_DoorbellKind.Kqueue, this._queue);
    }

    _close() {
        _async_kqueue_close(this._queue);
        _pep_free(this._events);
    }
}

# Fills the `index`th kevent in `changes`: EV_ADD | EV_CLEAR on `filter`,
# with no fflags, data or udata.
_async_kqueue_change(changes: __ptr<u8>, index: ulong, handle: io.SocketHandle, filter: int) {
    var change = changes + index * 32;
    __ptr<ulong> words = change;
    words[1] = 0;
    words[2] = 0;
    words[3] = 0;
    words[0] = handle as ulong;
    unsafe_cast<__ptr<i16>>(change + 8)[0] = filter as i16;
    unsafe_cast<__ptr<u16>>(change + 10)[0] = 33;  # EV_ADD | EV_CLEAR
}

# A new kqueue, or -1.
[Target(OS(Mac))]
_async_kqueue_create(): long {
    return kqueue() as long;
}

[Target(OS(Mac))]
_async_kqueue_close(queue: long) {
    close(queue as int);
}

# kevent(2), waiting up to `timeout` milliseconds (forever when negative):
# the number of events stored, 0 on a timeout or a signal, or -1 when the
# changes failed.
[Target(OS(Mac))]
_async_kqueue_call(
    queue: long, changes: __ptr<u8>, change_count: int, events: __ptr<u8>, capacity: int, timeout: long
): int {
    var count = 0;
    if (timeout < 0) {
        count = kevent(queue as int, changes, change_count, events, capacity, __null);
    } else {
        __ptr<long> span = _pep_malloc(16);  # struct timespec
        span[0] = timeout / 1000;
        span[1] = timeout % 1000 * 1000000;
        count = kevent(queue as int, changes, change_count, events, capacity, span);
        _pep_free(span);
    }
    if (count < 0 && change_count == 0) {
        return 0;
    }
    return count;
}

# Triggers the doorbell event of `queue`.
[Target(OS(Mac))]
_async_kqueue_ring(queue: long) {
    __ptr<u8> change = _pep_malloc(32);
    _async_kqueue_change(change, 0, 0, _KQUEUE_FILTER_USER);
    unsafe_cast<__ptr<u16>>(change + 10)[0] = 0;
    unsafe_cast<__ptr<uint>>(change + 12)[0] = 16777216;  # NOTE_TRIGGER
    _async_kqueue_call(queue, change, 1, __null, 0, -1);
    _pep_free(change);
}

# Elsewhere there is no kqueue.

[Target(!OS(Mac))]
_async_kqueue_create(): long {
    return -1;
}

[Target(!OS(Mac))]
_async_kqueue_close(queue: long) {}

[Target(!OS(Mac))]
_async_kqueue_ring(queue: long) {}

[Target(!OS(Mac))]
_async_kqueue_call(
    queue: long, changes: __ptr<u8>, change_count: int, events: __ptr<u8>, capacity: int, timeout: long
): int {
    return -1;
}
async/driver_poll
17346
# The poll() I/O driver for the task runtime (WSAPoll on Windows); see
# driver.pep. It runs everywhere and is the reference the other drivers are
# tested against.
#
# poll() is level-triggered and keeps no registrations, so each wait passes
# every socket a task is waiting on, with what it waits for. That costs a
# pass over the waiting sockets per wait, which is fine for a few and slow
# for thousands.
#
# struct pollfd is { int fd; short events; short revents; } (8 bytes) on
# POSIX; WSAPOLLFD is { SOCKET fd; short events; short revents; } (16 bytes)
# on Windows, with different flag values.
#
# The doorbell is a readable handle every wait also watches: a self-pipe on
# POSIX (a ring writes a byte to the write end), and on Windows, where
# WSAPoll takes only sockets, a UDP socket bound to a loopback port that a
# ring sends one byte to. The wait that sees it readable reads it empty.
#
# On Windows a Watcher's ReadDirectoryChangesW request
# (`_start_directory_changes`) completes on an event of its own, which
# WSAPoll cannot wait for: while one is in flight a wait lasts at most
# `_POLL_DIRECTORY_INTERVAL` milliseconds, and each wait looks for finished
# requests. The request block is the IOCP driver's (see driver_iocp.pep)
# with the event's handle at 48.
#
# WASI has no pipe, and no task can run there (see fiber_wasi.pep): making
# the doorbell panics.

import io;
import "driver";
import "driver_iocp";
import "sys_posix";
import "sys_wasi";
import "sys_windows";
import "task";

[Target(!OS(Windows))]
extern int poll(void* descriptors, ulong count, int timeout);
[Target(OS(Windows))]
[Link("ws2_32")]
extern int WSAPoll(void* descriptors, uint count, int timeout);

[Target(OS(Linux) || OS(Mac))]
extern int pipe(int* descriptors);
[Target(!OS(Windows))]
extern long read(int fd, void* buf, ulong n);
[Target(!OS(Windows))]
extern long write(int fd, void* buf, ulong n);
[Target(!OS(Windows))]
extern int close(int fd);
[Target(!OS(Windows))]
extern int fcntl(int fd, int command, ...);

[Target(OS(Windows))]
[Link("ws2_32")]
extern int WSAStartup(ushort version, void* data);
[Target(OS(Windows))]
[Link("ws2_32")]
extern ulong WSASocketW(int family, int kind, int protocol, void* info, uint group, uint flags);
[Target(OS(Windows))]
[Link("ws2_32")]
extern int closesocket(ulong s);
[Target(OS(Windows))]
[Link("ws2_32")]
extern int bind(ulong s, void* address, int length);
[Target(OS(Windows))]
[Link("ws2_32")]
extern int getsockname(ulong s, void* address, int* length);
[Target(OS(Windows))]
[Link("ws2_32")]
extern int recv(ulong s, void* buffer, int length, int flags);
[Target(OS(Windows))]
[Link("ws2_32")]
extern int sendto(ulong s, void* buffer, int length, int flags, void* address, int address_length);
[Target(OS(Windows))]
[Link("ws2_32")]
extern int ioctlsocket(ulong s, int command, uint* argument);

[Target(OS(Windows))]
extern void* CreateEventW(void* attributes, int manual_reset, int initial_state, ushort* name);
[Target(OS(Windows))]
extern int GetOverlappedResult(void* file, void* overlapped, uint* transferred, int wait);
[Target(OS(Windows))]
extern int CloseHandle(void* handle);

# The longest wait, in milliseconds, while a directory request is in flight.
const _POLL_DIRECTORY_INTERVAL: long = 10;
# STATUS_PENDING: a request's status until it finishes.
const _POLL_PENDING = 259;

# The portable driver.
struct _PollDriver {
    # The handle the doorbell makes readable: the pipe's read end, or the
    # UDP socket.
    var _bell: ulong;
    # The doorbell: the pipe's write end, or a second UDP socket and the
    # address of `_bell`.
    var _ring_descriptor: long;
    var _ring_address: __ptr<u8>;
    # Each directory request in flight: its block's address, and the
    # directory.
    var _directory_requests: HashMap<ulong, ulong>;
    # The directory requests finished since `_finished_files` last ran.
    var _finished: Array<(task: ulong, result: long)>;

    construct() {
        this._directory_requests = HashMap<ulong, ulong>();
        this._finished = Array<(task: ulong, result: long)>();
        __ptr<long> made = _pep_malloc(16);
        made[0] = -1;
        made[1] = -1;
        this._ring_address = _async_poll_create_bell(made);
        assert(made[0] >= 0, "async.run: cannot create the poll backend's doorbell");
        this._bell = made[0] as ulong;
        this._ring_descriptor = made[1];
        _pep_free(made);
    }

    # Moves the directory requests that finished to `_finished`; with
    # `wait`, waits for each first.
    _collect_directories(wait: bool) {
        var done = Array<ulong>();
        for (var (request, handle) in this._directory_requests) {
            var block = unsafe_cast<__ptr<u8>>(_async_iocp_block(request));
            if (wait) {
                _async_poll_wait_directory(_async_iocp_block(handle) as __ptr<void>, block);
            }
            if (unsafe_cast<__ptr<int>>(block)[0] != _POLL_PENDING) {
                done.append(request);
            }
        }
        for (var request in done) {
            this._directory_requests.remove(request);
            var block = unsafe_cast<__ptr<u8>>(_async_iocp_block(request));
            __ptr<ulong> words = block;
            this._finished.append((words[4], _async_directory_result(block, words[1])));
            _async_poll_close_event(words[6]);
            _pep_free(block);
        }
    }
}

extend _PollDriver with _Driver {
    _watch(handle: io.SocketHandle): bool {
        return true;
    }

    _poll(waits: HashMap<ulong, _SocketWaits>, timeout: long, ready_sockets: Array<(handle: ulong, interest: int)>) {
        var watched = Array<(handle: ulong, interest: int)>();
        for (var entry in waits) {
            var (key, waiting) = entry;
            var interest = 0;
            if (waiting._readers.count > 0) {
                interest = interest | io._IO_READABLE;
            }
            if (waiting._writers.count > 0) {
                interest = interest | io._IO_WRITABLE;
            }
            if (interest != 0) {
                watched.append((key, interest));
            }
        }
        watched.append((this._bell as ulong, io._IO_READABLE));
        var count = watched.count;
        var size = _async_poll_entry_size();
        __ptr<u8> descriptors = _pep_malloc(count * size);
        var i: ulong = 0;
        while (i < count) {
            var (handle, interest) = watched[i];
            _async_poll_set(descriptors + i * size, handle, interest);
            i = i + 1;
        }
        var limit = timeout;
        if (this._directory_requests.count > 0 && (limit < 0 || limit > _POLL_DIRECTORY_INTERVAL)) {
            limit = _POLL_DIRECTORY_INTERVAL;
        }
        if (_async_poll_call(descriptors, count, limit) > 0) {
            i = 0;
            while (i < count) {
                var ready = _async_poll_ready(descriptors + i * size);
                if (ready != 0 && i + 1 == count) {
                    _async_poll_drain(this._bell);
                } else if (ready != 0) {
                    var (handle, _) = watched[i];
                    ready_sockets.append((handle, ready));
                }
                i = i + 1;
            }
        }
        _pep_free(descriptors);
        this._collect_directories(false);
    }

    _start_directory_changes(handle: ulong, buffer: ulong, count: ulong, task: ulong): ulong {
        var event = _async_poll_create_event();
        if (event == 0) {
            return 0;
        }
        __ptr<u8> block = _pep_malloc(56);
        __ptr<ulong> words = block;
        words[0] = 0;
        words[1] = 0;
        words[2] = 0;
        # The low bit keeps the completion off any port the directory is
        # tied to.
        words[3] = event | 1;
        words[4] = task;
        words[5] = handle;
        words[6] = event;
        var directory = _async_iocp_block(handle) as __ptr<void>;
        if (!_async_iocp_read_directory(directory, unsafe_cast<__ptr<u8>>(_async_iocp_block(buffer)), count, block)) {
            _async_poll_close_event(event);
            _pep_free(block);
            return 0;
        }
        var request = unsafe_cast<ulong>(block);
        this._directory_requests.insert(request, handle);
        return request;
    }

    _cancel_transfer(request: ulong) {
        if (!this._directory_requests.contains(request)) {
            return;
        }
        var directory = _async_iocp_block(this._directory_requests.get(request)) as __ptr<void>;
        _async_iocp_cancel_directory(directory, unsafe_cast<__ptr<u8>>(_async_iocp_block(request)));
    }

    _finished_files(finished: Array<(task: ulong, result: long)>) {
        for (var item in this._finished) {
            finished.append(item);
        }
        this._finished.clear();
    }

    _want(handle: io.SocketHandle, interest: int): bool {
        return true;
    }

    _forget(handle: io.SocketHandle) {}

    _release(handle: io.SocketHandle) {}

    _doorbell(): _Doorbell {
        return _Doorbell(this._ring_descriptor, this._ring_address);
    }

    _close() {
        # The system writes into a block until its request finishes.
        for (var (request, handle) in this._directory_requests) {
            this._cancel_transfer(request);
        }
        this._collect_directories(true);
        _async_poll_close_bell(this._bell, this._ring_descriptor, this._ring_address);
    }
}

# A new manual-reset event's handle, as a number; 0 where there are none.
[Target(OS(Windows))]
_async_poll_create_event(): ulong {
    return unsafe_cast<ulong>(CreateEventW(__null, 1, 0, __null));
}

[Target(OS(Windows))]
_async_poll_close_event(event: ulong) {
    CloseHandle(_async_iocp_block(event) as __ptr<void>);
}

# Waits for the request whose OVERLAPPED is at `block` on `directory` to
# finish.
[Target(OS(Windows))]
_async_poll_wait_directory(directory: __ptr<void>, block: __ptr<u8>) {
    __ptr<uint> transferred = _pep_malloc(4);
    GetOverlappedResult(directory, block, transferred, 1);
    _pep_free(transferred);
}

[Target(!OS(Windows))]
_async_poll_create_event(): ulong {
    return 0;
}

[Target(!OS(Windows))]
_async_poll_close_event(event: ulong) {}

[Target(!OS(Windows))]
_async_poll_wait_directory(directory: __ptr<void>, block: __ptr<u8>) {}

# Makes a non-blocking self-pipe: stores the read end in `made[0]` and the
# write end in `made[1]` (both stay -1 on failure). Returns the address a
# ring sends to: none on POSIX.
[Target(OS(Linux) || OS(Mac))]
_async_poll_create_bell(made: __ptr<long>): __ptr<u8> {
    __ptr<int> ends = _pep_malloc(8);
    if (pipe(ends) == 0) {
        _async_poll_set_nonblocking(ends[0]);
        _async_poll_set_nonblocking(ends[1]);
        made[0] = ends[0] as long;
        made[1] = ends[1] as long;
    }
    _pep_free(ends);
    return __null;
}

# The first thing `async.run` makes, so where WASI reports it cannot run
# tasks.
[Target(OS(Wasi))]
_async_poll_create_bell(made: __ptr<long>): __ptr<u8> {
    panic("async.run: tasks are not supported on WASI, which cannot switch stacks");
    return __null;
}

# O_NONBLOCK and FD_CLOEXEC on `fd` (F_SETFL 4, F_SETFD 2).
[Target(OS(Linux))]
_async_poll_set_nonblocking(fd: int) {
    fcntl(fd, 4, 2048);
    fcntl(fd, 2, 1);
}

[Target(OS(Mac))]
_async_poll_set_nonblocking(fd: int) {
    fcntl(fd, 4, 4);
    fcntl(fd, 2, 1);
}

# Writes a byte to the pipe's write end `descriptor`.
[Target(!OS(Windows))]
_async_poll_ring(descriptor: long, address: __ptr<u8>) {
    __ptr<u8> byte = _pep_malloc(1);
    byte[0] = 1;
    write(descriptor as int, byte, 1);
    _pep_free(byte);
}

# Reads the pipe's read end `bell` empty.
[Target(!OS(Windows))]
_async_poll_drain(bell: ulong) {
    __ptr<u8> bytes = _pep_malloc(64);
    while (read(bell as int, bytes, 64) > 0) {}
    _pep_free(bytes);
}

[Target(!OS(Windows))]
_async_poll_close_bell(bell: ulong, descriptor: long, address: __ptr<u8>) {
    close(bell as int);
    close(descriptor as int);
}

[Target(!OS(Windows))]
_async_poll_entry_size(): ulong {
    return 8;
}

# Fills a pollfd: POLLIN 1, POLLOUT 4.
[Target(!OS(Windows))]
_async_poll_set(descriptor: __ptr<u8>, handle: ulong, interest: int) {
    unsafe_cast<__ptr<int>>(descriptor)[0] = handle as int;
    var events = 0;
    if ((interest & io._IO_READABLE) != 0) {
        events = events | 1;
    }
    if ((interest & io._IO_WRITABLE) != 0) {
        events = events | 4;
    }
    unsafe_cast<__ptr<u16>>(descriptor + 4)[0] = events as u16;
    unsafe_cast<__ptr<u16>>(descriptor + 6)[0] = 0;
}

# What a pollfd's revents allow. POLLERR 8, POLLHUP 16 and POLLNVAL 32 wake
# both sides, so their waiters retry and see the error.
[Target(!OS(Windows))]
_async_poll_ready(descriptor: __ptr<u8>): int {
    var returned = unsafe_cast<__ptr<u16>>(descriptor + 6)[0] as int;
    if ((returned & 56) != 0) {
        return io._IO_READABLE | io._IO_WRITABLE;
    }
    return _async_ready_mask(returned, 1, 4);  # POLLIN, POLLOUT
}

[Target(!OS(Windows))]
_async_poll_call(descriptors: __ptr<u8>, count: ulong, timeout: long): int {
    return poll(descriptors, count, timeout as int);
}

# Makes a non-blocking UDP socket bound to a free loopback port, stored in
# `made[0]`, and a second UDP socket that rings it, stored in `made[1]` (both
# -1 on failure); returns the first one's address, which a ring sends to.
#
# A ring never uses the socket the worker is polling: a socket made without
# WSA_FLAG_OVERLAPPED serializes its I/O, so a `sendto` on it from another
# worker waits for that worker's `WSAPoll` to return, which it never does.
# Both sockets are overlapped as well.
[Target(OS(Windows))]
_async_poll_create_bell(made: __ptr<long>): __ptr<u8> {
    __ptr<u8> data = _pep_malloc(512);  # WSADATA
    WSAStartup(514, data);              # version 2.2
    _pep_free(data);
    # AF_INET, SOCK_DGRAM, IPPROTO_UDP, WSA_FLAG_OVERLAPPED | WSA_FLAG_NO_HANDLE_INHERIT
    var socket = WSASocketW(2, 2, 17, __null, 0, 129);
    if (socket == ~(0 as ulong)) {
        return __null;
    }
    var sender = WSASocketW(2, 2, 17, __null, 0, 129);
    if (sender == ~(0 as ulong)) {
        closesocket(socket);
        return __null;
    }
    __ptr<u8> address = _pep_malloc(16);  # sockaddr_in: 127.0.0.1, any port
    __ptr<ulong> words = address;
    words[0] = 0;
    words[1] = 0;
    unsafe_cast<__ptr<u16>>(address)[0] = 2;
    address[4] = 127;
    address[7] = 1;
    __ptr<int> length = _pep_malloc(4);
    length[0] = 16;
    __ptr<uint> on = _pep_malloc(4);
    on[0] = 1;
    var made_ok = bind(socket, address, 16) == 0 && getsockname(socket, address, length) == 0;
    if (made_ok) {
        made_ok = ioctlsocket(socket, -2147195266, on) == 0;  # FIONBIO (0x8004667E)
    }
    _pep_free(on);
    _pep_free(length);
    if (!made_ok) {
        closesocket(sender);
        closesocket(socket);
        _pep_free(address);
        return __null;
    }
    made[0] = socket as long;
    made[1] = sender as long;
    return address;
}

# Sends a byte from the UDP socket `descriptor` to the bell at `address`.
[Target(OS(Windows))]
_async_poll_ring(descriptor: long, address: __ptr<u8>) {
    __ptr<u8> byte = _pep_malloc(1);
    byte[0] = 1;
    sendto(descriptor as ulong, byte, 1, 0, address, 16);
    _pep_free(byte);
}

# Receives every datagram waiting on the UDP socket `bell`.
[Target(OS(Windows))]
_async_poll_drain(bell: ulong) {
    __ptr<u8> bytes = _pep_malloc(64);
    while (recv(bell, bytes, 64, 0) >= 0) {}
    _pep_free(bytes);
}

[Target(OS(Windows))]
_async_poll_close_bell(bell: ulong, descriptor: long, address: __ptr<u8>) {
    closesocket(descriptor as ulong);
    closesocket(bell);
    _pep_free(address);
}

[Target(OS(Windows))]
_async_poll_entry_size(): ulong {
    return 16;
}

# Fills a WSAPOLLFD: POLLRDNORM 256, POLLWRNORM 16.
[Target(OS(Windows))]
_async_poll_set(descriptor: __ptr<u8>, handle: ulong, interest: int) {
    unsafe_cast<__ptr<ulong>>(descriptor)[0] = handle;
    var events = 0;
    if ((interest & io._IO_READABLE) != 0) {
        events = events | 256;
    }
    if ((interest & io._IO_WRITABLE) != 0) {
        events = events | 16;
    }
    unsafe_cast<__ptr<u16>>(descriptor + 8)[0] = events as u16;
    unsafe_cast<__ptr<u16>>(descriptor + 10)[0] = 0;
}

# What a WSAPOLLFD's revents allow. POLLERR 1, POLLHUP 2 and POLLNVAL 4 wake
# both sides.
[Target(OS(Windows))]
_async_poll_ready(descriptor: __ptr<u8>): int {
    var returned = unsafe_cast<__ptr<u16>>(descriptor + 10)[0] as int;
    if ((returned & 7) != 0) {
        return io._IO_READABLE | io._IO_WRITABLE;
    }
    return _async_ready_mask(returned, 256, 16);  # POLLRDNORM, POLLWRNORM
}

[Target(OS(Windows))]
_async_poll_call(descriptors: __ptr<u8>, count: ulong, timeout: long): int {
    return WSAPoll(descriptors, count as uint, timeout as int);
}
async/fiber_posix
6560
# POSIX (Linux, macOS) fibers for the task runtime in task.pep. Every
# declaration carries [Target(OS(Linux) || OS(Mac))] or a narrower target;
# fiber_windows.pep declares the same `_async_fiber_*` functions with the
# same signatures over the Windows Fibers API, and fiber_wasi.pep for WASI,
# which has none.
#
# A context is a malloc'd block of three words: the saved stack pointer, the
# base of the fiber's mapping, and the mapping's length (both zero for the
# thread's own context, which runs on the thread's stack, but see Android
# below). A fiber's stack is
# an anonymous private mapping whose lowest page is a guard (PROT_NONE), so an
# overflow faults instead of writing over other memory. Pages are committed
# on first touch; Linux maps with MAP_NORESERVE so a large reserve costs
# address space only.
#
# The switch itself is the `__switch_context` intrinsic, which the code
# generator defines as a few instructions of assembly (see
# tools/compiler/codegen/globals.pep); `__prepare_context` lays out a new
# stack so that the first switch into it calls `entry(null)`.
#
# Android: bionic's frame-pointer unwinder, which GWP-ASan runs on a sampled
# malloc or free, follows saved frame pointers while they stay below the
# thread's stack top (`pthread_internal_t::stack_top`). On a fiber that bound
# is the thread's stack, not the fiber's, so a frame pointer register that
# code without frame pointers left holding data (bionic's own on x86-64,
# OpenSSL's) passes the check, and the walk reads unmapped memory (#253). So
# there a thread's context keeps that stack top in its length word, and a
# switch points the field at the top of the stack it resumes, as a thread's
# own would be.

import "sys_posix";

[Target(OS(Linux) || OS(Mac))]
extern void __switch_context(void* save, void* resume);
[Target(OS(Linux) || OS(Mac))]
extern void* __prepare_context(void* stack_top, void* entry);
[Target(OS(Linux) || OS(Mac))]
extern void* mmap(void* address, ulong length, int protection, int flags, int descriptor, long offset);
[Target(OS(Linux) || OS(Mac))]
extern int munmap(void* address, ulong length);
[Target(OS(Linux) || OS(Mac))]
extern int mprotect(void* address, ulong length, int protection);
[Target(OS(Linux) || OS(Mac))]
extern long sysconf(int name);

# PROT_READ | PROT_WRITE; PROT_NONE is 0 and MAP_PRIVATE is 2 everywhere.
[Target(OS(Linux) || OS(Mac))]
const _FIBER_READ_WRITE = 3;

# MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, and _SC_PAGESIZE.
[Target(OS(Linux))]
const _FIBER_MAP_FLAGS = 16418;
[Target(OS(Linux) && !OS(Android))]
const _FIBER_PAGE_SIZE_NAME = 30;
# Bionic numbers sysconf's names its own way.
[Target(OS(Android))]
const _FIBER_PAGE_SIZE_NAME = 39;

# MAP_PRIVATE | MAP_ANON (macOS has no MAP_NORESERVE; it commits lazily
# anyway), and _SC_PAGESIZE.
[Target(OS(Mac))]
const _FIBER_MAP_FLAGS = 4098;
[Target(OS(Mac))]
const _FIBER_PAGE_SIZE_NAME = 29;

# The calling thread as a context: what a fiber switches back to.
[Target((OS(Linux) && !OS(Android)) || OS(Mac))]
_async_fiber_thread_context(): __ptr<void> {
    return _pep_malloc(24);
}

# The calling thread as a context, holding the thread's stack top in its
# length word, or 0 when bionic's field does not look like one.
[Target(OS(Android))]
_async_fiber_thread_context(): __ptr<void> {
    var context = _pep_malloc(24);
    var top = _async_fiber_stack_top()[0];
    var here = unsafe_cast<ulong>(_fiber_frame_address(0));
    # shortcut: the field's offset is bionic's private layout (the same from
    # Android 11, where the field came in, to 14 at least); a value that is
    # not just above this frame leaves the field alone. Recheck on a new
    # Android.
    if (top > here && top - here < 0x40000000 && top % 8 == 0) {
        __ptr<ulong> words = context;
        words[2] = top;
    }
    return context;
}

# Where bionic keeps the calling thread's stack top: `stack_top` in its
# `pthread_internal_t`, which `pthread_self()` points at (64-bit ABIs).
[Target(OS(Android))]
_async_fiber_stack_top(): __ptr<ulong> {
    return unsafe_cast<__ptr<ulong>>(pthread_self() + 144);
}

[Target(OS(Android))]
[Link(name = "llvm.frameaddress")]
extern void* _fiber_frame_address(int level);

# Frees what `_async_fiber_thread_context` made.
[Target(OS(Linux) || OS(Mac))]
_async_fiber_release_thread_context(context: __ptr<void>) {
    _pep_free(context);
}

# A new fiber with a stack of `stack_size` bytes (rounded up to whole pages,
# plus a guard page) whose first switch calls `entry(null)`; null if the
# system has no memory for the stack. `entry` must never return.
[Target(OS(Linux) || OS(Mac))]
_async_fiber_create(stack_size: ulong, entry: __ptr<void>): __ptr<void> {
    var page = sysconf(_FIBER_PAGE_SIZE_NAME) as ulong;
    var length = (stack_size + page - 1) / page * page + page;
    var base = mmap(__null, length, _FIBER_READ_WRITE, _FIBER_MAP_FLAGS, -1, 0);
    if (unsafe_cast<ulong>(base) == ~(0 as ulong)) {
        return __null;
    }
    mprotect(base, page, 0);
    var context = _pep_malloc(24);
    __ptr<u8> top = base;
    __ptr<__ptr<void>> pointers = context;
    __ptr<ulong> words = context;
    pointers[0] = __prepare_context(top + length, entry);
    pointers[1] = base;
    words[2] = length;
    return context;
}

# Unmaps a fiber's stack and frees its context. The fiber must not be the
# one running.
[Target(OS(Linux) || OS(Mac))]
_async_fiber_destroy(context: __ptr<void>) {
    __ptr<__ptr<void>> pointers = context;
    __ptr<ulong> words = context;
    munmap(pointers[1], words[2]);
    _pep_free(context);
}

# Saves the running context into `from` and resumes `to`. Returns when
# something switches back to `from`.
[Target((OS(Linux) && !OS(Android)) || OS(Mac))]
_async_fiber_switch(from: __ptr<void>, to: __ptr<void>) {
    __ptr<__ptr<void>> resume = to;
    __switch_context(from, resume[0]);
}

# As above, and points bionic's stack top at `to`'s when the thread's
# context has one (a switch is always between a thread and a fiber, so
# `from` or `to` is the thread's).
[Target(OS(Android))]
_async_fiber_switch(from: __ptr<void>, to: __ptr<void>) {
    __ptr<__ptr<void>> resume = to;
    __ptr<ulong> from_words = from;
    __ptr<ulong> to_words = to;
    if (from_words[2] != 0 && to_words[2] != 0) {
        _async_fiber_stack_top()[0] = to_words[1] + to_words[2];
    }
    __switch_context(from, resume[0]);
}
async/fiber_wasi
1062
# WASI (WebAssembly) fibers for the task runtime in task.pep: the same
# `_async_fiber_*` functions as fiber_posix.pep and fiber_windows.pep, each
# with [Target(OS(Wasi))]. WebAssembly cannot switch stacks (that needs the
# stack-switching proposal), so a task cannot run: creating its fiber
# panics. The thread's own context and the keys work as elsewhere.

import "sys_wasi";

[Target(OS(Wasi))]
_async_fiber_thread_context(): __ptr<void> {
    return _pep_malloc(24);
}

[Target(OS(Wasi))]
_async_fiber_release_thread_context(context: __ptr<void>) {
    _pep_free(context);
}

[Target(OS(Wasi))]
_async_fiber_create(stack_size: ulong, entry: __ptr<void>): __ptr<void> {
    panic("async: tasks are not supported on WASI, which cannot switch stacks");
    return __null;
}

[Target(OS(Wasi))]
_async_fiber_destroy(context: __ptr<void>) {
    _pep_free(context);
}

[Target(OS(Wasi))]
_async_fiber_switch(from: __ptr<void>, to: __ptr<void>) {
    panic("async: tasks are not supported on WASI, which cannot switch stacks");
}
async/fiber_windows
2842
# Windows fibers for the task runtime in task.pep, over the Fibers API
# (kernel32). Every declaration carries [Target(OS(Windows))];
# fiber_posix.pep declares the same `_async_fiber_*` functions with the same
# signatures for Linux and macOS.
#
# A context is a fiber handle. The thread running the scheduler becomes a
# fiber with ConvertThreadToFiber for the length of `async.run` and back
# with ConvertFiberToThread afterwards. The Fibers API, rather than hand-written
# assembly, keeps the stack limits in the thread information block and the
# exception chain correct for each fiber. FIBER_FLAG_FLOAT_SWITCH makes a
# switch save the floating-point state too, as the POSIX switch does.

[Target(OS(Windows))]
extern void* ConvertThreadToFiber(void* parameter);
[Target(OS(Windows))]
extern int ConvertFiberToThread();
[Target(OS(Windows))]
extern void* CreateFiberEx(ulong commit, ulong reserve, uint flags, void* start, void* parameter);
[Target(OS(Windows))]
extern void DeleteFiber(void* fiber);
[Target(OS(Windows))]
extern void SwitchToFiber(void* fiber);

# FIBER_FLAG_FLOAT_SWITCH.
[Target(OS(Windows))]
const _FIBER_FLOAT_SWITCH = 1;

# The calling thread as a context: what a fiber switches back to.
[Target(OS(Windows))]
_async_fiber_thread_context(): __ptr<void> {
    var fiber = ConvertThreadToFiber(__null);
    assert(fiber != __null, "async.run: this thread is already a fiber");
    return fiber;
}

# Turns the thread back from a fiber (`_async_fiber_thread_context`).
[Target(OS(Windows))]
_async_fiber_release_thread_context(context: __ptr<void>) {
    ConvertFiberToThread();
}

# A new fiber with `stack_size` bytes of reserved stack whose first switch
# calls `entry(null)`; null if the system has no memory for it. `entry`
# must never return.
[Target(OS(Windows))]
_async_fiber_create(stack_size: ulong, entry: __ptr<void>): __ptr<void> {
    return CreateFiberEx(0, stack_size, _FIBER_FLOAT_SWITCH, __function_pointer(_async_fiber_start), entry);
}

# Every fiber's first function: keeps stack in reserve for the stack
# overflow handler (stack_guard.pep), since each fiber has a guarantee of
# its own, then calls `entry`, the one `_async_fiber_create` was given.
[Target(OS(Windows))]
_async_fiber_start(entry: __ptr<void>) {
    _pep_stack_guard_thread_start();
    var start = entry as extern (__ptr<void>) => void;
    start(__null);
}

# Deletes a fiber and its stack. The fiber must not be the one running.
[Target(OS(Windows))]
_async_fiber_destroy(context: __ptr<void>) {
    DeleteFiber(context);
}

# Resumes `to`; returns when something switches back to the running fiber
# (`from`, which the Fibers API tracks itself).
[Target(OS(Windows))]
_async_fiber_switch(from: __ptr<void>, to: __ptr<void>) {
    SwitchToFiber(to);
}
async/lock
5861
# Futex-based mutexes and condition variables for Linux, macOS and Windows,
# as Rust's std has had since 1.62: the `_async_sys_mutex_*` and
# `_async_sys_condition_*` functions (sys_wasi.pep declares the same ones for
# WASI), written once over the platform's wait-on-address calls
# (`_async_sys_futex_*` in sys_posix.pep and sys_windows.pep).
#
# A mutex or a condition variable is a 4-byte word at the start of an 8-byte
# block, and a zeroed block is a free mutex or a fresh condition variable,
# so `_pep_malloc` creates one and nothing needs destroying. The word may sit
# in a block that holds something else too (`Mutex<T>` keeps its value slot
# right after it), and unlike a pthread mutex it could move while unused.
#
# A mutex word is one of three states: free, held, or held with threads
# (possibly) sleeping on it. Locking a free word is one compare-exchange;
# a thread that finds it held spins briefly, then marks it contended and
# sleeps until the word changes. Unlocking stores free and, only when the
# word was contended, wakes one sleeper, which marks the word contended
# again as it takes it, so a later unlock wakes the next one.
#
# A condition variable's word is a sequence number that every notify
# increments: a waiter reads it before unlocking the mutex and sleeps only
# while it is unchanged, so a notify between the unlock and the sleep is
# never lost.

import "sys_posix";
import "sys_windows";

# The mutex word's states.
const _LOCK_FREE: uint = 0;
const _LOCK_HELD: uint = 1;
const _LOCK_CONTENDED: uint = 2;

# How many times a thread looks at a held mutex before it sleeps: a short
# critical section often ends within that, and sleeping costs two system
# calls.
const _LOCK_SPINS = 100;

# A new, free mutex.
[Target(!OS(Wasi))]
_async_sys_mutex_create(): __ptr<void> {
    return _pep_malloc(8);
}

# Frees a free mutex's block.
[Target(!OS(Wasi))]
_async_sys_mutex_destroy(mutex: __ptr<void>) {
    _pep_free(mutex);
}

[Target(!OS(Wasi))]
_async_sys_mutex_lock(mutex: __ptr<void>) {
    __ptr<uint> word = mutex;
    if (!__atomic_cmpxchg<uint>(word, _LOCK_FREE, _LOCK_HELD)) {
        _async_lock_contended(word);
    }
}

# Locks `mutex` only if it is free; true if it is now held.
[Target(!OS(Wasi))]
_async_sys_mutex_try_lock(mutex: __ptr<void>): bool {
    __ptr<uint> word = mutex;
    return __atomic_cmpxchg<uint>(word, _LOCK_FREE, _LOCK_HELD);
}

[Target(!OS(Wasi))]
_async_sys_mutex_unlock(mutex: __ptr<void>) {
    __ptr<uint> word = mutex;
    if (_async_lock_exchange(word, _LOCK_FREE) == _LOCK_CONTENDED) {
        _async_sys_futex_wake_one(word);
    }
}

# A new condition variable.
[Target(!OS(Wasi))]
_async_sys_condition_create(): __ptr<void> {
    return _pep_malloc(8);
}

# Frees a condition variable's block.
[Target(!OS(Wasi))]
_async_sys_condition_destroy(condition: __ptr<void>) {
    _pep_free(condition);
}

# Unlocks `mutex` (held by the caller), sleeps until notified (or woken
# spuriously), and locks it again.
[Target(!OS(Wasi))]
_async_sys_condition_wait(condition: __ptr<void>, mutex: __ptr<void>) {
    __ptr<uint> sequence = condition;
    var seen = __atomic_load<uint>(sequence);
    _async_sys_mutex_unlock(mutex);
    _async_sys_futex_wait(sequence, seen);
    _async_sys_mutex_lock(mutex);
}

# Like `_async_sys_condition_wait`, for at most `milliseconds`; false if the
# time ran out.
[Target(!OS(Wasi))]
_async_sys_condition_wait_for(condition: __ptr<void>, mutex: __ptr<void>, milliseconds: ulong): bool {
    __ptr<uint> sequence = condition;
    var seen = __atomic_load<uint>(sequence);
    _async_sys_mutex_unlock(mutex);
    var woken = _async_sys_futex_wait_for(sequence, seen, milliseconds);
    _async_sys_mutex_lock(mutex);
    return woken;
}

[Target(!OS(Wasi))]
_async_sys_condition_notify_one(condition: __ptr<void>) {
    __ptr<uint> sequence = condition;
    __atomic_fetch_add<uint>(sequence, 1);
    _async_sys_futex_wake_one(sequence);
}

[Target(!OS(Wasi))]
_async_sys_condition_notify_all(condition: __ptr<void>) {
    __ptr<uint> sequence = condition;
    __atomic_fetch_add<uint>(sequence, 1);
    _async_sys_futex_wake_all(sequence);
}

# The slow path of a lock: spins while the word is held, then sleeps on it
# until this thread is the one to take it.
[Target(!OS(Wasi))]
_async_lock_contended(word: __ptr<uint>) {
    var state = _async_lock_spin(word);
    if (state == _LOCK_FREE && __atomic_cmpxchg<uint>(word, _LOCK_FREE, _LOCK_HELD)) {
        return;
    }
    while (true) {
        # Marking the word contended takes it if it was free: this thread
        # then holds it, and its unlock wakes a sleeper that may not exist,
        # which costs only that wake.
        if (state != _LOCK_CONTENDED && _async_lock_exchange(word, _LOCK_CONTENDED) == _LOCK_FREE) {
            return;
        }
        _async_sys_futex_wait(word, _LOCK_CONTENDED);
        state = _async_lock_spin(word);
    }
}

# Reads the word until it is not plainly held, or the spins run out, and
# returns what it read last. A contended word means others already sleep,
# so spinning more would only jump the queue.
[Target(!OS(Wasi))]
_async_lock_spin(word: __ptr<uint>): uint {
    var spins = _LOCK_SPINS;
    while (true) {
        var state = __atomic_load<uint>(word);
        if (state != _LOCK_HELD || spins == 0) {
            return state;
        }
        spins = spins - 1;
    }
}

# Stores `value` in the word and returns what it held.
[Target(!OS(Wasi))]
_async_lock_exchange(word: __ptr<uint>, value: uint): uint {
    while (true) {
        var old = __atomic_load<uint>(word);
        if (__atomic_cmpxchg<uint>(word, old, value)) {
            return old;
        }
    }
}
async/module
4180
## Threads and concurrency, modeled on Rust's `std::thread` and C++
## `std::thread`, and tasks: green threads that take turns on a few worker
## threads.
##
## Like `io`, `async` is a module: bring it in with `import async` (and write
## `async.Thread`, `async.logical_cpus()`) or import names directly with
## `import [Thread, ThreadLocal] from async`.
##
## - [Atomic](async-atomic.md): `Atomic<T>`, a value threads read and update without a lock
## - [Thread](async-thread.md): starting, naming and joining threads, `ThreadId` and `ThreadBody`
## - [ThreadLocal](async-thread_local.md): a variable with a separate value on every thread, and its `ThreadLocalGuard<T>`
## - [Processor counts](async-cpus.md): `logical_cpus()` and `physical_cpus()`
## - [Channel](async-channel.md): `Channel<T>`, a queue that carries values between threads, and its `ChannelIterator<T>`
## - [Mutex](async-mutex.md): `Mutex<T>`, the `MutexGuard<T>` a `with` block holds, and `Condition<T>`
## - [Once](async-once.md): `Once`, which runs a function once, and `Lazy<T>`, a value built on first use
## - [Tasks](async-task.md): `run`, `Task<T>`, `spawn`, `spawn_on_each_worker`, `run_blocking`, `sleep`, `yield_now`, `timeout` and cancellation, for many tasks taking turns on a few worker threads and parking on sockets
## - [TaskLocal](async-task_local.md): a variable with a separate value in every task, and its `TaskLocalGuard<T>`
## - [I/O backends](async-driver.md): `Backend`, how a runtime waits for sockets
##
## Only thread-safe values can be shared between threads: numbers, `shared`
## function values (such as a thread's body), and `[Shared]` structs such as
## `Atomic<T>`, `Thread`, `ThreadLocal<T>`, `Channel<T>` and `Mutex<T>`. Any
## other value crosses threads only as a new value that nothing else
## references (`Channel.send(move(x))`, or `send(copy(x))`), or stays inside
## a `Mutex`, whose `with` blocks the compiler keeps apart from the rest of
## the program. `Lazy<T>` holds thread-safe
## values only. See the language guide's Threads chapter.
##
## @example
##     import async;
##
##     const hits = async.Atomic<long>(0);
##
##     work() {
##         hits.fetch_add(1);
##     }
##
##     main(): int {
##         var workers = Array<async.Thread>();
##         var n = async.logical_cpus();
##         var i: ulong = 0;
##         while (i < n) {
##             workers.append(async.Thread.spawn(work));
##             i = i + 1;
##         }
##         for (var worker in workers) {
##             worker.join();
##         }
##         assert(hits.load() == n as long, "every worker ran");
##         return 0;
##     }

# This file only gathers the module's public API from its other files. The
# platform layer (`_async_sys_*` in sys_posix.pep / sys_windows.pep) and the
# `_async_*` helpers are exported between the async files but not from the
# module, except the one the os module needs (at the end).

import "atomic";
import "channel";
import "coordination";
import "cpus";
import "driver";
import "mutex";
import "once";
import "rwlock";
import "select";
import "sys_posix";
import "task";
import "task_local";
import "thread";
import "thread_local";
import "workers";

export Atomic;
export ThreadId;
export ThreadBody;
export Thread;
export ThreadLocal;
export ThreadLocalGuard;
export logical_cpus;
export physical_cpus;
export Mutex;
export MutexGuard;
export Condition;
export RwLock;
export RwLockReadGuard;
export RwLockWriteGuard;
export Semaphore;
export SemaphorePermit;
export Barrier;
export Latch;
export Once;
export Lazy;
export Channel;
export ChannelIterator;
export Select;
export Task;
export TaskLocal;
export TaskLocalGuard;
export TaskError;
export RuntimeOptions;
export run;
export run_with;
export spawn;
export run_blocking;
export spawn_on_each_worker;
export yield_now;
export sleep;
export is_cancelled;
export Deadline;
export timeout;
export Backend;
export current_backend;

# For the os module only: the cgroup directories total_memory() reads.
[Target(OS(Linux))]
export _async_sys_cgroup_directories;
async/mutex
21969
## Mutual exclusion: `Mutex<T>` owns a value that one thread at a time can
## use, `MutexGuard<T>` is the lock a `with` block holds, and `Condition<T>`
## lets a thread holding a Mutex sleep until another thread changes its value.

# A Mutex is `[Shared]`: its fields are const, and the value lives in a raw
# heap slot (`const _value: __ptr<void>`, viewed as a `T` slot), so any `T`
# passes `check_shared_types`. A `T` that is not thread-safe counts its
# references plainly, so no two threads may touch its counts at once:
#
# - the value is reached only in a `with` block over `lock()`: `enter()`
#   takes its reference under the lock, and the binding is released before
#   the guard unlocks (see `lower_with_blocks`);
# - `MutexGuard` is `[Isolated]`, so `check_confinement` (sema/confinement.pep) keeps the
#   block from letting a reference into the value outlive the lock, or a
#   reference from outside into it;
# - the constructor and `replace` take `[Move]` values: the caller hands
#   its one reference over (it keeps none), and `replace` moves it into the
#   slot under the lock, so no count step on the value happens outside it.
#
# `_owner` holds the holder's id (`_async_holder_id`: the operating-system
# id of the thread, or a task's own id, since tasks on one worker share its
# thread; 0 when unlocked), so a second `lock()` by the holder panics
# instead of deadlocking, and `Condition.wait` can check that its caller
# holds the lock. Only the holder writes it while it holds the lock, so a
# caller reading its own id there knows it holds the lock.
#
# A task on a worker never blocks its thread on the platform lock: it tries
# it, and when it is busy parks in `_waiters` (see sync_wait.pep), trying
# again after each wake; every unlock wakes one waiting task. The platform
# lock is still what excludes, and a task locks and unlocks it on the one
# thread it runs on. `Condition` does the same with its own `_waiters`.

import "atomic";
import "lock";
import "sync_wait";
import "sys_posix";
import "sys_wasi";
import "sys_windows";
import "task";
import "thread";

## A value that one thread at a time can use, like Rust's `Mutex<T>` or a C++
## `std::mutex` paired with the data it protects.
##
## The Mutex owns its value, and the way to reach it is a `with` block:
## `with (var value = mutex.lock()) { ... }` waits until no other thread holds
## the lock, binds the value, and unlocks when the block ends by any path
## (falling off the end, `return`, `break`, `continue`). Everything a thread
## did while holding the lock is visible to the next thread that takes it.
##
## `T` is a struct type, such as `Array<String>` or a struct of your own. Inside
## the `with` block the compiler keeps the locked value and the rest of the
## program apart: a value that is not thread-safe (a `String`, an `Array`)
## cannot move from one to the other, and no part of the locked value can be
## returned from the block or stored outside it. Pass `copy(x)` to move a
## value either way; new values (a constructor call, a string literal, a call
## the compiler infers returns a fresh value) and thread-safe values such as
## numbers pass freely. `Mutex<int>` is a compile error: use `Atomic<int>`.
##
## A Mutex is `[Shared]`: keep it in a module-scope variable or pass it to
## threads. It is not re-entrant: locking it again on the thread that holds
## it panics instead of deadlocking. A panic while it is held ends the
## program, so a Mutex is never left "poisoned".
##
## In a task (see `run`), waiting for the lock parks the task, not its worker
## thread, so the other tasks there keep running, including one that holds
## the lock. Each task counts as its own holder, and a task may hold the
## lock across a wait of its own (a `sleep`, a socket call). A cancel does
## not end the wait for the lock.
##
## @typeParam T the protected value's type, a struct type
## @example
##     import async;
##
##     [Shared]
##     struct Account {
##         const checking: Atomic<long>;
##         const savings: Atomic<long>;
##         construct(long checking = 0, long savings = 0) {
##             this.checking = Atomic<long>(checking);
##             this.savings = Atomic<long>(savings);
##         }
##     }
##
##     const account = async.Mutex<Account>(Account(100, 0));
##
##     save(long amount) {
##         with (var a = account.lock()) {
##             # No other thread sees the money in neither account.
##             a.checking.fetch_sub(amount);
##             a.savings.fetch_add(amount);
##         }
##     }
[Shared]
export struct Mutex<T> {
    # The platform lock (see lock.pep): a 4-byte word at the start of one
    # heap block that also holds the value, 8 bytes in, so a Mutex makes one
    # allocation for both.
    const _lock: __ptr<void>;

    # The value's slot in `_lock`'s block: `sizeof<T>()` bytes, one
    # reference for a struct `T`. Read and written only while the lock is
    # held.
    const _value: __ptr<void>;

    # The holder's id (see `_async_holder_id`), or 0 when the Mutex is
    # unlocked.
    const _owner: Atomic<ulong>;

    # How many holders sleep in `Condition.wait`, each keeping its `with`
    # binding: references to the value that a `PEP_CHECK_SYNC` census allows.
    const _waiting: Atomic<ulong>;

    # The tasks waiting for the lock.
    const _waiters: _SyncQueue;

    ## Creates an unlocked Mutex that owns `value`.
    ##
    ## `value` must be a new value, such as a constructor call, `copy(x)` or
    ## `move(x)`: nothing outside the Mutex may reference it. The caller hands
    ## its reference over, so nothing is copied.
    ##
    ## @param value the value to protect; a new value, which the compiler checks
    ## @example
    ##     const names = async.Mutex<Array<String>>(Array<String>());
    construct([Move] value: T) {
        # A zeroed block is a free lock on every platform.
        __ptr<u8> block = _pep_malloc(8 + sizeof<T>());
        _lock = block;
        _value = block + 8;
        _owner = Atomic<ulong>(0);
        _waiting = Atomic<ulong>(0);
        _waiters = _SyncQueue();
        this._slot()[0] = move(value);
    }

    destruct {
        # No guard is alive (each holds a reference), so the lock is free.
        this._slot()[0] = __default<T>();
        _pep_free(_lock);
    }

    ## Waits until the calling thread holds the lock, and returns the guard
    ## that a `with` block enters to reach the value.
    ##
    ## Use it as the scope of a `with` header: `with (var v = mutex.lock())`.
    ## The lock is released when the guard is destroyed, which for a guard
    ## created in the header is the end of the block. A guard kept anywhere
    ## else holds the lock until its last reference is released.
    ##
    ## @returns the guard; its `enter()` returns the value, and destroying it unlocks
    ## @panics if the calling thread already holds the lock
    ## @example
    ##     with (var account = accounts.lock()) {
    ##         account.balance.fetch_add(10);
    ##     }
    lock(): MutexGuard<T> {
        return MutexGuard<T>(this);
    }

    ## Takes the lock only if no thread holds it right now, without waiting.
    ##
    ## In `with (var v = mutex.try_lock()) { ... } else { ... }`, the body runs
    ## when the lock was taken and the `else` block runs when it was not. The
    ## calling thread already holding the lock counts as busy.
    ##
    ## @returns the guard; its `enter()` returns the value, or null when the lock was busy
    ## @example
    ##     with (var account = accounts.try_lock()) {
    ##         account.balance.fetch_add(10);
    ##     } else {
    ##         print("busy; try later\n");
    ##     }
    try_lock(): MutexGuard<T> {
        return MutexGuard<T>(this, false);
    }

    ## Replaces the whole value and returns the one the Mutex held, which the
    ## caller then owns outright: nothing else references it any more.
    ##
    ## Waits for the lock like `lock()`. `value` must be a new value, as for
    ## the constructor, and is handed over without a copy.
    ##
    ## @param value the new value; a new value, which the compiler checks
    ## @returns the value the Mutex held
    ## @panics if the calling thread already holds the lock
    ## @example
    ##     var done = pending.replace(Array<Job>());   # take every job at once
    replace([Move] value: T): T {
        this._lock();
        __ptr<T> slot = this._slot();
        # Both references change hands under the lock, with no count step:
        # the slot's goes to the caller, the caller's to the slot.
        T old = move(slot[0]);
        slot[0] = move(value);
        this._unlock();
        return move(old);
    }

    ## Reports whether the caller holds the lock: the calling task, in a task,
    ## or else the calling thread.
    ##
    ## @returns true between a `lock()` (or a successful `try_lock()`) by the caller and the guard's destruction
    is_held(): bool {
        return _owner.load() == _async_holder_id();
    }

    ## Returns a new condition variable that waits on this Mutex.
    ##
    ## Create it once and share it, as the Mutex is shared: every thread that
    ## waits or notifies must use the same Condition.
    ##
    ## @returns a new Condition bound to this Mutex
    ## @example
    ##     const queue = async.Mutex<Jobs>(Jobs());
    ##     const not_empty = queue.condition();
    condition(): Condition<T> {
        return Condition<T>(this);
    }

    # The value's slot, as a `T` slot.
    _slot(): __ptr<T> {
        __ptr<void> raw = _value;
        return raw;
    }

    # Waits for the lock and records the caller as its holder.
    _lock() {
        var me = _async_holder_id();
        if (_owner.load() == me) {
            panic("Mutex.lock: the caller already holds this Mutex");
        }
        this._lock_platform();
        _owner.store(me);
    }

    # Waits for the platform lock: blocking the thread, or in a task,
    # parking the task.
    _lock_platform() {
        if (!_async_in_task()) {
            _async_sys_mutex_lock(_lock);
            return;
        }
        while (!_async_sys_mutex_try_lock(_lock)) {
            var waiter = _async_sync_waiter();
            _waiters._push(waiter);
            # An unlock between the first try and the push found no waiter,
            # so try again before parking.
            if (_async_sys_mutex_try_lock(_lock)) {
                # Not needed now; a wake it got is covered by this holder's
                # own unlock.
                if (waiter._state.compare_exchange(_WAITER_WAITING, _WAITER_ABANDONED)) {
                    _waiters._remove(waiter);
                }
                return;
            }
            _async_sync_park(_waiters, waiter, 0, false);
        }
    }

    # Takes the lock if it is free; true if the caller now holds it.
    _try_lock(): bool {
        var me = _async_holder_id();
        if (_owner.load() == me || !_async_sys_mutex_try_lock(_lock)) {
            return false;
        }
        _owner.store(me);
        return true;
    }

    _unlock() {
        _owner.store(0);
        _async_sys_mutex_unlock(_lock);
        # Always look: nothing orders a task's push with this unlock but the
        # queue's own lock (see sync_wait.pep).
        _waiters._wake_one_locked();
    }
}

## The lock on a `Mutex<T>` that a `with` block holds: `enter()` returns the
## Mutex's value, and destroying the guard unlocks.
##
## Get one from `Mutex.lock()` or `Mutex.try_lock()` in a `with` header. The
## block releases the guard on every path out, so the lock cannot be left
## held by mistake. A guard belongs to the thread that locked it; do not pass
## it to another thread.
##
## A guard is `[Isolated]`: it can only be the scope of a `with` header, so
## the lock cannot be kept past the block, and the compiler checks the block
## with the confinement rule (see `Mutex`).
##
## @typeParam T the protected value's type
## @example
##     with (var totals = stats.lock()) {
##         totals.requests.fetch_add(1);
##     }   # unlocked here
[Isolated]
export struct MutexGuard<T> {
    # The Mutex this guard locks.
    const _source: Mutex<T>;

    ## Whether the guard holds the lock: false once `exit()` has run, and for
    ## a `try_lock()` that found the lock busy.
    bool locked;

    ## Locks `source` and creates the guard that holds it; the same as
    ## `source.lock()` (or `source.try_lock()` when `wait` is false).
    ##
    ## @param source the Mutex to lock
    ## @param wait true to wait for the lock; false to take it only if it is free right now
    ## @panics if `wait` is true and the calling thread already holds the lock
    construct(source: Mutex<T>, wait: bool = true) {
        _source = source;
        if (wait) {
            source._lock();
            locked = true;
        } else {
            locked = source._try_lock();
        }
    }

    destruct {
        this.exit();
    }

    ## Returns the Mutex's value, for the `with` header to bind.
    ##
    ## For a struct `T` the caller gets its own reference.
    ##
    ## @returns the protected value, or the default of `T` (null for a struct) when the guard does not hold the lock
    enter(): T {
        if (!locked) {
            return __default<T>();
        }
        return _source._slot()[0];
    }

    ## Unlocks the Mutex if the guard holds it. The destructor calls it;
    ## calling it again does nothing.
    exit() {
        if (locked) {
            locked = false;
            # With `PEP_CHECK_SYNC` set, check that nothing outside the
            # locked value refers into it (`_pep_check_sync`).
            __census<T>(_source._slot(), _source._waiting.load());
            _source._unlock();
        }
    }
}

extend MutexGuard<T> with Scoped<T>;

## Lets threads that hold a Mutex sleep until another thread changes the
## Mutex's value, like C++ `std::condition_variable`. Get one from
## `Mutex.condition()`.
##
## `wait()` must run while the calling thread holds the Mutex, normally inside
## `with (var v = mutex.lock())`. It unlocks, sleeps until notified, and locks
## again before returning. A waiter can also wake without a notification (a
## spurious wakeup), so always wait in a loop that re-checks the value.
##
## A thread that changes the value calls `notify_one()` or `notify_all()`,
## usually while it still holds the lock.
##
## A Condition is `[Shared]`, like its Mutex.
##
## In a task (see `run`), `wait()` parks the task, not its worker thread. A
## cancel does not end it, since the caller's loop would only wait again;
## `wait_for()` still returns when its time runs out.
##
## @typeParam T the Mutex's value type
## @example
##     import async;
##
##     [Shared]
##     struct Jobs {
##         const waiting: Atomic<long>;
##         construct() { waiting = Atomic<long>(0); }
##     }
##
##     const jobs = async.Mutex<Jobs>(Jobs());
##     const has_work = jobs.condition();
##
##     take_job() {
##         with (var j = jobs.lock()) {
##             while (j.waiting.load() == 0) {
##                 has_work.wait();
##             }
##             j.waiting.fetch_sub(1);
##         }
##     }
##
##     add_job() {
##         with (var j = jobs.lock()) {
##             j.waiting.fetch_add(1);
##             has_work.notify_one();
##         }
##     }
[Shared]
export struct Condition<T> {
    # The Mutex this condition waits on.
    const _mutex: Mutex<T>;

    # The platform condition variable (see lock.pep): a heap block holding
    # its sequence word.
    const _handle: __ptr<void>;

    # The tasks waiting on this condition.
    const _waiters: _SyncQueue;

    ## Creates a condition variable that waits on `mutex`. `mutex.condition()`
    ## does the same.
    ##
    ## @param mutex the Mutex that waiters hold
    construct(mutex: Mutex<T>) {
        _mutex = mutex;
        _handle = _async_sys_condition_create();
        _waiters = _SyncQueue();
    }

    destruct {
        _async_sys_condition_destroy(_handle);
    }

    ## Unlocks the Mutex, sleeps until another thread calls `notify_one()` or
    ## `notify_all()`, and locks the Mutex again before returning.
    ##
    ## The thread may also wake without being notified, so call it in a loop
    ## that re-checks what it waits for.
    ##
    ## @panics if the calling thread does not hold the Mutex
    ## @example
    ##     with (var q = queue.lock()) {
    ##         while (q.waiting.load() == 0) {
    ##             not_empty.wait();
    ##         }
    ##     }
    wait() {
        var me = _async_holder_id();
        if (_mutex._owner.load() != me) {
            panic("Condition.wait: the caller does not hold the Mutex");
        }
        _mutex._waiting.fetch_add(1);
        if (_async_in_task()) {
            this._wait_task(me, 0);
        } else {
            _mutex._owner.store(0);
            _async_sys_condition_wait(_handle, _mutex._lock);
            _mutex._owner.store(me);
        }
        _mutex._waiting.fetch_sub(1);
    }

    ## Like `wait()`, but gives up after about `milliseconds` milliseconds.
    ## The Mutex is locked again before it returns either way.
    ##
    ## @param milliseconds the longest time to sleep
    ## @returns true if the thread was woken (by a notification or spuriously), false if the time ran out
    ## @panics if the calling thread does not hold the Mutex
    wait_for(milliseconds: ulong): bool {
        var me = _async_holder_id();
        if (_mutex._owner.load() != me) {
            panic("Condition.wait_for: the caller does not hold the Mutex");
        }
        _mutex._waiting.fetch_add(1);
        var woken = false;
        if (_async_in_task()) {
            woken = this._wait_task(me, _async_sys_monotonic_milliseconds() + milliseconds);
        } else {
            _mutex._owner.store(0);
            woken = _async_sys_condition_wait_for(_handle, _mutex._lock, milliseconds);
            _mutex._owner.store(me);
        }
        _mutex._waiting.fetch_sub(1);
        return woken;
    }

    ## Waits while `predicate` holds for the Mutex's value: calls it with the
    ## value, and while it returns true, waits as `wait()` does and asks
    ## again. Returns once it returns false, with the Mutex still locked.
    ##
    ## Wakeups without a notification are handled here: the predicate is
    ## asked again after every wake.
    ##
    ## `predicate` is written at the call, as a closure: the compiler checks
    ## its body as it checks a `with` block's, with its parameter as the
    ## locked value, so it cannot keep any part of the value or bring in a
    ## value from outside.
    ##
    ## @param predicate called with the locked value; true to keep waiting
    ## @panics if the caller does not hold the Mutex
    ## @example
    ##     with (var queue = jobs.lock()) {
    ##         not_empty.wait_while((queue: Array<Job>): bool => queue.count == 0);
    ##         var job = queue.remove_at(0);
    ##     }
    wait_while([Locked] predicate: (T) => bool) {
        this._check_holder("Condition.wait_while");
        while (predicate(_mutex._slot()[0])) {
            this.wait();
        }
    }

    ## Like `wait_while()`, but gives up after about `milliseconds`
    ## milliseconds. The Mutex is locked when it returns either way.
    ##
    ## @param milliseconds the longest time to wait
    ## @param predicate called with the locked value; true to keep waiting
    ## @returns true once `predicate` returned false, false if the time ran out first
    ## @panics if the caller does not hold the Mutex
    wait_while_for(milliseconds: ulong, [Locked] predicate: (T) => bool): bool {
        this._check_holder("Condition.wait_while_for");
        var deadline = _async_sys_monotonic_milliseconds() + milliseconds;
        while (predicate(_mutex._slot()[0])) {
            var now = _async_sys_monotonic_milliseconds();
            if (now >= deadline) {
                return false;
            }
            this.wait_for(deadline - now);
        }
        return true;
    }

    # Panics unless the caller holds the Mutex: the predicate reads its value.
    _check_holder(what: String) {
        if (_mutex._owner.load() != _async_holder_id()) {
            panic($"{what}: the caller does not hold the Mutex");
        }
    }

    ## Wakes one thread or task waiting on this condition, if any. The caller does
    ## not need to hold the Mutex, but usually does, having just changed the
    ## value.
    notify_one() {
        _async_sys_condition_notify_one(_handle);
        _waiters._wake_one();
    }

    ## Wakes every thread and task waiting on this condition. Each locks the Mutex in
    ## turn before its `wait()` returns.
    notify_all() {
        _async_sys_condition_notify_all(_handle);
        _waiters._wake_all();
    }

    # `wait` in a task: joins `_waiters` while still holding the Mutex (so a
    # notifier holding it cannot miss the task), unlocks, parks until woken
    # or `deadline` (0 for none) passes, and locks again. True if woken.
    _wait_task(me: ulong, deadline: ulong): bool {
        var waiter = _async_sync_waiter();
        _waiters._push(waiter);
        _mutex._unlock();
        var woken = _async_sync_park(_waiters, waiter, deadline, false);
        _mutex._lock_platform();
        _mutex._owner.store(me);
        return woken == _SyncWake.Woken;
    }
}
async/once
6764
## One-time initialization: `Once` runs a function exactly once however many
## threads ask, and `Lazy<T>` builds a value on first use.

# A Once moves through three states in an `Atomic<int>`: 0 (nothing has run),
# 1 (a thread is running the body) and 2 (done). The fast path, once done, is
# one acquire load. The first caller moves 0 -> 1 under a platform mutex,
# runs the body without holding it, then stores 2 and wakes the callers that
# arrived meanwhile, which sleep on a platform condition variable. The done
# store is a release, so a caller that sees 2 also sees what the body did.

import "atomic";
import "lock";
import "sys_posix";
import "sys_wasi";
import "sys_windows";
import "thread";

## Runs a function exactly once, however many threads ask, like C++
## `std::call_once` or Rust's `std::sync::Once`.
##
## The first `call` runs its body. Callers that arrive while it runs wait for
## it to finish, and later callers return right away. Every caller sees
## everything the body did once `call` returns.
##
## A Once is `[Shared]`: keep it in a module-scope variable or pass it to
## threads.
##
## @example
##     import async;
##
##     const setup = async.Once();
##     const setups = Atomic<long>(0);
##
##     initialize() {
##         setups.fetch_add(1);
##     }
##
##     work() {
##         setup.call(initialize);   # only the first caller runs it
##     }
[Shared]
export struct Once {
    # 0 before any call, 1 while a body runs, 2 once it has finished.
    const _state: Atomic<int>;

    # The operating-system id of the thread running the body, or 0.
    const _runner: Atomic<ulong>;

    # The platform mutex that guards the move from 0 to 1 and the wait.
    const _lock: __ptr<void>;

    # The platform condition variable that waiting callers sleep on.
    const _finished: __ptr<void>;

    ## Creates a Once whose body has not run.
    ##
    construct() {
        _state = Atomic<int>(0);
        _runner = Atomic<ulong>(0);
        _lock = _async_sys_mutex_create();
        _finished = _async_sys_condition_create();
    }

    destruct {
        _async_sys_condition_destroy(_finished);
        _async_sys_mutex_destroy(_lock);
    }

    ## Runs `body` if no call has run a body yet; otherwise waits until that
    ## run has finished. Everything the body did is visible to the caller
    ## when this returns.
    ##
    ## Only one body ever runs, even if later calls pass different ones.
    ##
    ## @param body the function to run once
    ## @panics if `body` itself calls `call` on the same Once (it would wait for itself forever)
    ## @example
    ##     config_once.call(load_config);
    call(body: ThreadBody) {
        if (this._start()) {
            body();
            this._finish();
        }
    }

    ## Reports whether a body has finished running.
    ##
    ## @returns true once a `call` has completed its body on some thread
    is_done(): bool {
        return _state.load() == 2;
    }

    # True if the caller must run the body (and then call `_finish`); false
    # once another thread's run has finished.
    _start(): bool {
        if (_state.load() == 2) {
            return false;
        }
        var me = _async_sys_os_thread();
        _async_sys_mutex_lock(_lock);
        if (_state.load() == 0) {
            _state.store(1);
            _runner.store(me);
            _async_sys_mutex_unlock(_lock);
            return true;
        }
        if (_runner.load() == me) {
            _async_sys_mutex_unlock(_lock);
            panic("Once.call: the body called 'call' on the Once that is running it");
        }
        while (_state.load() != 2) {
            _async_sys_condition_wait(_finished, _lock);
        }
        _async_sys_mutex_unlock(_lock);
        return false;
    }

    # Marks the body finished and wakes every waiting caller.
    _finish() {
        _async_sys_mutex_lock(_lock);
        _runner.store(0);
        _state.store(2);
        _async_sys_condition_notify_all(_finished);
        _async_sys_mutex_unlock(_lock);
    }
}

## A value built on first use by whichever thread asks first, like Rust's
## `LazyLock`. The usual way to give a module-scope variable a value that is
## expensive to build, or that cannot be built before `main` runs.
##
## The first `get()` runs the initializer; threads that call `get()` while it
## runs wait for it, and every later call returns the same value.
##
## `T` is constrained `Shared` (a thread-safe type such as a number, a
## `[Shared]` struct, or a `shared` function type), because every thread
## gets the same value; `Lazy<String>` is a compile error.
##
## @typeParam T the value's type, which must be thread-safe (`T: Shared`)
## @example
##     import async;
##
##     [Shared]
##     struct Settings {
##         const workers: long;
##         construct(this.workers = 1) {}
##     }
##
##     load_settings(): Settings {
##         return Settings(async.logical_cpus() as long);
##     }
##
##     const settings = async.Lazy<Settings>(load_settings);
##
##     main(): int {
##         var workers = settings.get().workers;   # built here, on first use
##         return 0;
##     }
[Shared]
export struct Lazy<T: Shared> {
    # The function that builds the value.
    const _initializer: shared () => T;

    # A heap slot holding the value once it is built: `sizeof<T>()` bytes,
    # one reference for a struct `T`.
    const _value: __ptr<T>;

    # Runs the initializer once.
    const _built: Once;

    ## Creates a Lazy whose value `initializer` builds on the first `get()`.
    ## Nothing runs yet.
    ##
    ## @param initializer builds the value; runs at most once, on the thread that first calls `get()`
    construct(initializer: shared () => T) {
        _initializer = initializer;
        _value = _pep_malloc(sizeof<T>());
        _built = Once();
    }

    destruct {
        _value[0] = __default<T>();
        _pep_free(_value);
    }

    ## Returns the value, building it with the initializer on the first call.
    ##
    ## For a struct `T` the caller gets its own reference.
    ##
    ## @returns the value the initializer built
    ## @panics if the initializer itself calls `get()` on the same Lazy
    get(): T {
        if (_built._start()) {
            _value[0] = _initializer();
            _built._finish();
        }
        return _value[0];
    }

    ## Reports whether the value has been built.
    ##
    ## @returns true once a `get()` has finished running the initializer
    is_built(): bool {
        return _built.is_done();
    }
}
async/rwlock
13836
## Reader/writer locking: `RwLock<T>` owns a thread-safe value that many
## threads may read at once or one thread may write, with
## `RwLockReadGuard<T>` and `RwLockWriteGuard<T>` as the locks a `with`
## block holds.

# `T` must be thread-safe (`T: Shared`), the rule `Atomic<T>` has. Several
# readers holding the value at once each copy a reference to it, and a value
# that is not thread-safe counts its references plainly, so two readers
# would race on its counts; exclusive locking alone is what makes
# `Mutex<T>` sound for such a `T`. Keeping readers from copying any
# reference instead would take a borrowed reference, which the reference
# model rules out.
#
# The lock is a `Mutex` over a struct of counts, with one `Condition` that
# readers sleep on and one that writers sleep on, so in a task every wait
# parks the task (see mutex.pep). Writers come first: once a writer waits,
# new readers wait behind it, so a stream of readers cannot starve writers.
#
# The value lives in a raw slot (`const _value: __ptr<T>`) so that `replace`
# can swap it under the write lock; readers copy their reference out of it
# only while no writer holds the lock.

import "atomic";
import "mutex";
import "task";

## A thread-safe value that many threads may read at once or one thread may
## write, like Rust's `RwLock<T>` or C++ `std::shared_mutex`.
##
## `with (var v = lock.read()) { ... }` waits until no writer holds or is
## waiting for the lock, then binds the value; any number of threads may be
## reading at once. `with (var v = lock.write()) { ... }` waits until no
## other thread holds the lock at all. Both unlock when the block ends by
## any path, and everything a writer did is visible to the threads that lock
## after it.
##
## `T` must be thread-safe, as for `Atomic<T>`: typically a `[Shared]` struct
## whose `Atomic` fields a writer changes together, so readers never see
## them half changed. A value that is not thread-safe, such as an
## `Array<String>`, is a compile error: readers holding it at once would
## race on its reference counts. Use a `Mutex<T>` for such a value.
##
## Writers come first: while a writer waits, new readers wait too, so
## readers cannot keep a writer out forever. A thread that already reads
## must not ask to read again, since a writer may be waiting between the two.
## Asking to write while holding the lock in either mode panics instead of
## deadlocking.
##
## In a task (see `run`), waiting for the lock parks the task, not its worker
## thread.
##
## @typeParam T the protected value's type, which must be thread-safe (`T: Shared`)
## @example
##     import async;
##
##     [Shared]
##     struct Range {
##         const low: Atomic<long>;
##         const high: Atomic<long>;
##         construct() {
##             low = Atomic<long>(0);
##             high = Atomic<long>(0);
##         }
##     }
##
##     const range = async.RwLock<Range>(Range());
##
##     widen(by: long) {
##         with (var r = range.write()) {
##             r.low.fetch_sub(by);
##             r.high.fetch_add(by);
##         }
##     }
##
##     width(): long {
##         with (var r = range.read()) {
##             return r.high.load() - r.low.load();   # never half widened
##         }
##         return 0;
##     }
[Shared]
export struct RwLock<T: Shared> {
    # The value's slot: one reference for a struct `T`, `sizeof<T>()` bytes
    # otherwise. Written only under the write lock.
    const _value: __ptr<T>;

    # Who holds the lock and who waits for it.
    const _state: Mutex<_RwLockState>;

    # Signalled when readers may go on: the last writer left with no writer
    # waiting.
    const _readers_go: Condition<_RwLockState>;

    # Signalled when a writer may go on: the lock became free.
    const _writer_go: Condition<_RwLockState>;

    # The holder's id (see `_async_holder_id`) while a writer holds the
    # lock, else 0.
    const _writer: Atomic<ulong>;

    ## Creates an unlocked RwLock holding `value`.
    ##
    ## @param value the value to protect
    construct(value: T) {
        ulong size = __is_pod<T>() ? sizeof<T>() : 8;
        _value = _pep_malloc(size);
        _value[0] = value;
        _state = Mutex<_RwLockState>(_RwLockState());
        _readers_go = _state.condition();
        _writer_go = _state.condition();
        _writer = Atomic<ulong>(0);
    }

    destruct {
        # No guard is alive (each holds a reference), so nothing reads.
        _value[0] = __default<T>();
        _pep_free(_value);
    }

    ## Waits until no writer holds or waits for the lock, takes it for
    ## reading, and returns the guard that a `with` block enters to reach the
    ## value. Other threads may read at the same time.
    ##
    ## @returns the guard; its `enter()` returns the value, and destroying it unlocks
    ## @panics if the calling thread holds the lock for writing
    ## @example
    ##     with (var config = settings.read()) {
    ##         print($"{config.port.load()}\n");
    ##     }
    read(): RwLockReadGuard<T> {
        return RwLockReadGuard<T>(this);
    }

    ## Takes the lock for reading only if that needs no wait: no writer holds
    ## it or waits for it.
    ##
    ## In `with (var v = lock.try_read()) { ... } else { ... }`, the body runs
    ## when the lock was taken and the `else` block runs when it was not.
    ##
    ## @returns the guard; its `enter()` returns the value, or null when the lock was not free for reading
    try_read(): RwLockReadGuard<T> {
        return RwLockReadGuard<T>(this, false);
    }

    ## Waits until no other thread holds the lock, takes it for writing, and
    ## returns the guard that a `with` block enters to reach the value.
    ##
    ## @returns the guard; its `enter()` returns the value, and destroying it unlocks
    ## @panics if the calling thread already holds the lock for writing
    ## @example
    ##     with (var config = settings.write()) {
    ##         config.port.store(8080);
    ##     }
    write(): RwLockWriteGuard<T> {
        return RwLockWriteGuard<T>(this);
    }

    ## Takes the lock for writing only if no thread holds it right now,
    ## without waiting.
    ##
    ## @returns the guard; its `enter()` returns the value, or null when the lock was busy
    try_write(): RwLockWriteGuard<T> {
        return RwLockWriteGuard<T>(this, false);
    }

    ## Replaces the whole value under the write lock and returns the one the
    ## RwLock held.
    ##
    ## @param value the new value
    ## @returns the value the RwLock held
    ## @panics if the calling thread already holds the lock for writing
    replace(value: T): T {
        this._lock_write();
        T old = _value[0];
        _value[0] = value;
        this._unlock_write();
        return old;
    }

    # Waits until readers may go on, and counts the caller as one.
    _lock_read() {
        if (_writer.load() == _async_holder_id()) {
            panic("RwLock.read: the caller holds this RwLock for writing");
        }
        with (var state = _state.lock()) {
            while (state.writing || state.writers_waiting != 0) {
                _readers_go.wait();
            }
            state.readers = state.readers + 1;
        }
    }

    # Counts the caller as a reader if no writer holds or waits; true if so.
    _try_lock_read(): bool {
        if (_writer.load() == _async_holder_id()) {
            return false;
        }
        with (var state = _state.lock()) {
            if (state.writing || state.writers_waiting != 0) {
                return false;
            }
            state.readers = state.readers + 1;
        }
        return true;
    }

    _unlock_read() {
        with (var state = _state.lock()) {
            state.readers = state.readers - 1;
            if (state.readers == 0 && state.writers_waiting != 0) {
                _writer_go.notify_one();
            }
        }
    }

    # Waits until no thread holds the lock, and takes it for writing.
    _lock_write() {
        var me = _async_holder_id();
        if (_writer.load() == me) {
            panic("RwLock.write: the caller already holds this RwLock for writing");
        }
        with (var state = _state.lock()) {
            state.writers_waiting = state.writers_waiting + 1;
            while (state.writing || state.readers != 0) {
                _writer_go.wait();
            }
            state.writers_waiting = state.writers_waiting - 1;
            state.writing = true;
        }
        _writer.store(me);
    }

    # Takes the lock for writing if no thread holds it; true if so.
    _try_lock_write(): bool {
        var me = _async_holder_id();
        if (_writer.load() == me) {
            return false;
        }
        with (var state = _state.lock()) {
            if (state.writing || state.readers != 0) {
                return false;
            }
            state.writing = true;
        }
        _writer.store(me);
        return true;
    }

    # Hands the lock to the next writer if one waits, else to every waiting
    # reader.
    _unlock_write() {
        _writer.store(0);
        with (var state = _state.lock()) {
            state.writing = false;
            if (state.writers_waiting != 0) {
                _writer_go.notify_one();
            } else {
                _readers_go.notify_all();
            }
        }
    }
}

## The read lock on an `RwLock<T>` that a `with` block holds: `enter()`
## returns the value, and destroying the guard unlocks. Get one from
## `RwLock.read()` or `RwLock.try_read()` in a `with` header.
##
## @typeParam T the protected value's type
## @example
##     with (var stats = counters.read()) {
##         total = stats.hits.load() + stats.misses.load();
##     }   # unlocked here
export struct RwLockReadGuard<T: Shared> {
    # The RwLock this guard locks.
    const _source: RwLock<T>;

    ## Whether the guard holds the lock: false once `exit()` has run, and for
    ## a `try_read()` that could not take it.
    bool locked;

    ## Takes `source` for reading and creates the guard that holds it; the
    ## same as `source.read()` (or `source.try_read()` when `wait` is false).
    ##
    ## @param source the RwLock to lock
    ## @param wait true to wait for the lock; false to take it only if that needs no wait
    ## @panics if `wait` is true and the calling thread holds the lock for writing
    construct(source: RwLock<T>, wait: bool = true) {
        _source = source;
        if (wait) {
            source._lock_read();
            locked = true;
        } else {
            locked = source._try_lock_read();
        }
    }

    destruct {
        this.exit();
    }

    ## Returns the RwLock's value, for the `with` header to bind.
    ##
    ## @returns the protected value, or the default of `T` (null for a struct) when the guard does not hold the lock
    enter(): T {
        if (!locked) {
            return __default<T>();
        }
        return _source._value[0];
    }

    ## Unlocks if the guard holds the lock. The destructor calls it; calling
    ## it again does nothing.
    exit() {
        if (locked) {
            locked = false;
            _source._unlock_read();
        }
    }
}

extend RwLockReadGuard<T> with Scoped<T>;

## The write lock on an `RwLock<T>` that a `with` block holds: `enter()`
## returns the value, and destroying the guard unlocks. Get one from
## `RwLock.write()` or `RwLock.try_write()` in a `with` header.
##
## @typeParam T the protected value's type
## @example
##     with (var stats = counters.write()) {
##         stats.hits.store(0);
##         stats.misses.store(0);
##     }   # unlocked here
export struct RwLockWriteGuard<T: Shared> {
    # The RwLock this guard locks.
    const _source: RwLock<T>;

    ## Whether the guard holds the lock: false once `exit()` has run, and for
    ## a `try_write()` that found the lock busy.
    bool locked;

    ## Takes `source` for writing and creates the guard that holds it; the
    ## same as `source.write()` (or `source.try_write()` when `wait` is
    ## false).
    ##
    ## @param source the RwLock to lock
    ## @param wait true to wait for the lock; false to take it only if it is free right now
    ## @panics if `wait` is true and the calling thread already holds the lock for writing
    construct(source: RwLock<T>, wait: bool = true) {
        _source = source;
        if (wait) {
            source._lock_write();
            locked = true;
        } else {
            locked = source._try_lock_write();
        }
    }

    destruct {
        this.exit();
    }

    ## Returns the RwLock's value, for the `with` header to bind.
    ##
    ## @returns the protected value, or the default of `T` (null for a struct) when the guard does not hold the lock
    enter(): T {
        if (!locked) {
            return __default<T>();
        }
        return _source._value[0];
    }

    ## Unlocks if the guard holds the lock. The destructor calls it; calling
    ## it again does nothing.
    exit() {
        if (locked) {
            locked = false;
            _source._unlock_write();
        }
    }
}

extend RwLockWriteGuard<T> with Scoped<T>;

# Who holds an RwLock and who waits for it.
struct _RwLockState {
    # How many threads hold it for reading.
    var readers: ulong;
    # Whether a thread holds it for writing.
    var writing: bool;
    # How many threads wait to write.
    var writers_waiting: ulong;
}
async/select
15419
## Waiting on several channels at once: `Select<E>` takes the first value
## any of them receives, or sends a value to the first that has room, and
## turns what happened into a case of your own enum, which a `match` then
## handles.

# A select tries each channel in turn (`_poll`), starting after the one that
# fired last so a busy channel cannot starve the others. When none has a
# value it makes one `_SyncWaiter` and joins every open channel's
# `_receivers` queue with it (`Channel._select_join`, which declines when a
# value is already there, so a value that arrives while joining is never
# missed). A send or close on any of them wakes the waiter once; the select
# then leaves every queue and looks again. A closed channel is not joined,
# since nothing will wake it: when every channel is closed, or one has a
# value, the select does not sleep at all (a task that slept on nothing
# would never wake, and one that looped without sleeping would starve the
# tasks it waits for). A task parks as it does for
# `receive`; a plain thread sleeps on the waiter's `_ThreadWake` instead of
# a channel's condition variable (see sync_wait.pep).
#
# A send arm (`_SendCase`) works the same way on the sending side: it keeps
# its value in a raw slot until a look finds room (`Channel._select_put`,
# which moves the value in under the channel's lock), joins the channel's
# `_senders` queue while it is full, and leaves the select once it fires.

import "channel";
import "sync_wait";
import "sys_posix";
import "sys_wasi";
import "sys_windows";
import "task";

# One arm of a `Select`, whatever its channel's value type: firing it
# (receiving or sending, and turning that into an `E`), and joining and
# leaving its channel's wait queue (`_join` returns what the channel
# found). `_finished` is true for an arm that has fired and leaves the
# select.
trait _SelectCase<E> {
    _take(): _Polled<E>;
    _join(waiter: _SyncWaiter): _Joined;
    _leave(waiter: _SyncWaiter);
    _finished(): bool;
}

# A channel of `T` values and how to turn one into an `E`.
struct _ReceiveCase<T, E> {
    const _channel: Channel<T>;
    const _wrap: (T) => E;

    construct(channel: Channel<T>, wrap: (T) => E) {
        _channel = channel;
        _wrap = wrap;
    }
}

extend _ReceiveCase<T, E> with _SelectCase<E> {
    # The value the channel had, turned into an `E`.
    _take(): _Polled<E> {
        match (_channel._select_take()) {
            Ready(value) => {
                return _Polled<E>.Ready(_wrap(value));
            }
            Empty => {
                return _Polled<E>.Empty;
            }
            Closed => {
                return _Polled<E>.Closed;
            }
        }
        return _Polled<E>.Empty;
    }

    _join(waiter: _SyncWaiter): _Joined {
        return _channel._select_join(waiter);
    }

    _leave(waiter: _SyncWaiter) {
        _channel._select_leave(waiter);
    }

    # A receive arm stays until the select is dropped.
    _finished(): bool {
        return false;
    }
}

# A value waiting to be sent to a channel of `T` values, and what to return
# once it is. The value is held in `_slot`, raw memory the compiler cannot
# follow: `send` took it as a `[Move]` value, so the slot holds the only
# reference, and `Channel._select_put` moves it out of the slot only when
# the channel has room.
struct _SendCase<T, E> {
    const _channel: Channel<T>;
    const _sent: () => E;
    # One `T` slot; it holds the value until the arm fires.
    const _slot: __ptr<T>;
    # True once the value is in the channel.
    var _done: bool;

    construct(channel: Channel<T>, [Move] value: T, sent: () => E) {
        _channel = channel;
        _sent = sent;
        _slot = _pep_malloc(sizeof<T>());
        _slot[0] = move(value);
        _done = false;
    }

    destruct {
        # A value never sent is dropped with the select.
        _slot[0] = __default<T>();
        _pep_free(_slot);
    }
}

extend _SendCase<T, E> with _SelectCase<E> {
    # Sends the value if the channel has room, and returns what `_sent`
    # makes of that.
    _take(): _Polled<E> {
        if (_done) {
            return _Polled<E>.Closed;
        }
        var found = _channel._select_put(_slot);
        if (found == _Joined.Ready) {
            _done = true;
            return _Polled<E>.Ready(_sent());
        }
        if (found == _Joined.Closed) {
            return _Polled<E>.Closed;
        }
        return _Polled<E>.Empty;
    }

    _join(waiter: _SyncWaiter): _Joined {
        if (_done) {
            return _Joined.Closed;
        }
        return _channel._select_join_send(waiter);
    }

    _leave(waiter: _SyncWaiter) {
        _channel._select_leave_send(waiter);
    }

    _finished(): bool {
        return _done;
    }
}

## Waits on several channels at once and takes the first value any of them
## receives, or sends to the first that has room, like Go's `select`.
##
## Each channel to receive from is added with `receive(channel, wrap)`,
## where `wrap` turns one of its values into an `E`, usually a case of an
## enum of your own that carries it. A value to send is added with
## `send(channel, value, sent)`, where `sent` returns the `E` that says it
## was sent. `wait()` then fires whichever arm is ready first and returns
## its `E`, for a `match` to handle. The channels may carry different types.
##
## - The value is taken under the channel's own lock, so no other receiver
##   can take it between "ready" and "take".
## - A send arm's value goes into its channel only when that arm fires;
##   until then the select holds it. Once sent, the arm leaves the select,
##   so the next `wait()` does not send it again. A value never sent is
##   dropped with the select.
## - When several channels have values, each wait starts after the channel
##   that fired last, so a busy channel cannot starve the others.
## - A channel that is closed and empty is skipped, and so is a send arm
##   whose channel is closed. Once every arm is, `wait()` returns an error.
## - In a task (see `run`), waiting parks the task and its worker runs other
##   tasks; a cancel or the task's `timeout` ends the wait.
##
## A Select is not `[Shared]`: use it from the thread (or task) that made it.
##
## @typeParam E the type every channel's values are turned into
## @example
##     enum Event {
##         Job(job: Job),
##         Tick(count: long),
##         Stop,
##     }
##
##     var select = async.Select<Event>();
##     select.receive(jobs, (job: Job): Event => Event.Job(job));
##     select.receive(ticks, (count: long): Event => Event.Tick(count));
##     select.receive(quit, (stop: bool): Event => Event.Stop);
##     var running = true;
##     while (running) {
##         match (select.wait()) {
##             Ok(event) => {
##                 match (event) {
##                     Job(job) => { run(job); }
##                     Tick(count) => { report(count); }
##                     Stop => { running = false; }
##                 }
##             }
##             Err(error) => { running = false; }   # every channel closed
##         }
##     }
export struct Select<E> {
    # The channels, in the order they were added.
    var _cases: Array<_SelectCase<E>>;
    # Where the next look starts: just after the case that fired last.
    var _next: ulong;
    # An empty queue for `_async_sync_park`, which takes a waiter out of one
    # queue when it gives up; a select leaves every channel's queue itself.
    const _no_queue: _SyncQueue;

    ## Creates a select with no channels yet.
    construct() {
        _cases = Array<_SelectCase<E>>();
        _next = 0;
        _no_queue = _SyncQueue();
    }

    ## Adds `channel`: its values, turned into an `E` by `wrap`, are among
    ## those `wait()` returns.
    ##
    ## @typeParam T the type of the channel's values
    ## @param channel the channel to receive from
    ## @param wrap turns a value received from `channel` into an `E`; it runs on the waiting thread
    ## @example
    ##     select.receive(lines, (line: String): Event => Event.Line(line));
    receive<T>(channel: Channel<T>, wrap: (T) => E) {
        _cases.append(_ReceiveCase<T, E>(channel, wrap));
    }

    ## Adds a send arm: `wait()` sends `value` to `channel` once the channel
    ## has room (a bounded channel that is full waits), and returns what
    ## `sent` returns.
    ##
    ## `value` must be a new value, as for `Channel.send`: the select holds
    ## it and moves it into the channel only when this arm fires, so it is
    ## never sent if another arm fires first. Once sent, the arm leaves the
    ## select. A send arm whose channel is closed never fires, and its value
    ## is dropped with the select.
    ##
    ## @typeParam T the type of the channel's values
    ## @param channel the channel to send to
    ## @param value the value to send; a new value, which the compiler checks
    ## @param sent returns the `E` that `wait()` returns once the value is sent; it runs on the waiting thread
    ## @example
    ##     select.send(results, copy(line), (): Event => Event.Sent);
    send<T>(channel: Channel<T>, [Move] value: T, sent: () => E) {
        _cases.append(_SendCase<T, E>(channel, move(value), sent));
    }

    ## Fires the first arm that is ready, waiting until one is: takes the
    ## next value any of the channels receives, or sends a send arm's value
    ## to a channel with room.
    ##
    ## @returns the arm's `E` (the value received, turned into an `E`, or what a send arm's `sent` returned); or an error once every channel is closed (and empty, for a receive arm), when the select has no arms, or when the task's wait was cancelled or timed out
    wait(): Result<E> {
        return this._wait(0);
    }

    ## Like `wait()`, but gives up after about `milliseconds` milliseconds.
    ##
    ## @param milliseconds the longest time to wait
    ## @returns the arm's `E`, as for `wait()`; or an error if the time ran out, once every channel is closed (and empty, for a receive arm), or when the task's wait was cancelled
    wait_for(milliseconds: ulong): Result<E> {
        return this._wait(_async_sys_monotonic_milliseconds() + milliseconds);
    }

    ## Fires an arm if one is ready now, without waiting: takes a value if a
    ## channel has one waiting, or sends a send arm's value if its channel
    ## has room.
    ##
    ## @returns the arm's `E`, as for `wait()`; or an error if no arm is ready, or once every channel is closed (and empty, for a receive arm)
    try_wait(): Result<E> {
        match (this._poll()) {
            Ready(event) => {
                return Result<E>.ok(event);
            }
            Empty => {
                return Result<E>.err(Error("no value is waiting"));
            }
            Closed => {
                return Result<E>.err(Error("every channel is closed"));
            }
        }
    }

    # Looks at each arm once, starting at `_next`: the first that fires
    # (Ready), else Empty if any channel is still open, else Closed. A send
    # arm that fires leaves the select.
    _poll(): _Polled<E> {
        var count = _cases.count;
        var closed: ulong = 0;
        var i: ulong = 0;
        while (i < count) {
            var index = (_next + i) % count;
            var entry: _SelectCase<E> = _cases[index];
            match (entry._take()) {
                Ready(event) => {
                    if (entry._finished()) {
                        _cases.remove_at(index);
                        _next = count > 1 ? index % (count - 1) : 0;
                    } else {
                        _next = (index + 1) % count;
                    }
                    return _Polled<E>.Ready(event);
                }
                Empty => {}
                Closed => {
                    closed = closed + 1;
                }
            }
            i = i + 1;
        }
        if (closed == count) {
            return _Polled<E>.Closed;
        }
        return _Polled<E>.Empty;
    }

    # `wait` until `deadline` (monotonic milliseconds, 0 for none).
    _wait(deadline: ulong): Result<E> {
        if (_cases.count == 0) {
            return Result<E>.err(Error("the select has no channels"));
        }
        while (true) {
            match (this._poll()) {
                Ready(event) => {
                    return Result<E>.ok(event);
                }
                Empty => {}
                Closed => {
                    return Result<E>.err(Error("every channel is closed"));
                }
            }
            if (deadline != 0 && _async_sys_monotonic_milliseconds() >= deadline) {
                return Result<E>.err(Error("the time ran out"));
            }
            var woken = this._sleep(deadline);
            if (woken == _SyncWake.Cancelled) {
                return Result<E>.err(Error("the task was cancelled"));
            }
            if (woken == _SyncWake.TimedOut) {
                # The task's `timeout`, or `deadline`: one last look.
                match (this._poll()) {
                    Ready(event) => {
                        return Result<E>.ok(event);
                    }
                    Empty => {}
                    Closed => {}
                }
                return Result<E>.err(Error("the time ran out"));
            }
        }
        return Result<E>.err(Error("the time ran out"));
    }

    # Joins every open channel's queue with one waiter and sleeps until a
    # channel wakes it, `deadline` passes, or (in a task) the wait is
    # cancelled; returns which, as `_async_sync_park` does. Returns at once,
    # as woken, when a channel already has a value or every channel is
    # closed: the next look finds which.
    _sleep(deadline: ulong): _SyncWake {
        var in_task = _async_in_task();
        var waiter = in_task ? _async_sync_waiter() : _SyncWaiter(_ThreadWake());
        var count = _cases.count;
        var joined: ulong = 0;
        var closed: ulong = 0;
        var ready = false;
        while (joined < count && !ready) {
            var entry: _SelectCase<E> = _cases[joined];
            var found = entry._join(waiter);
            if (found == _Joined.Ready) {
                ready = true;
            } else {
                if (found == _Joined.Closed) {
                    closed = closed + 1;
                }
                joined = joined + 1;
            }
        }
        var woken = _SyncWake.Woken;
        if (ready || closed == count) {
            # Nothing to sleep for: stop waiting before sleeping at all.
            waiter._state.compare_exchange(_WAITER_WAITING, _WAITER_ABANDONED);
        } else if (in_task) {
            woken = _async_sync_park(_no_queue, waiter, deadline, true);
        } else {
            woken = _async_thread_park(waiter, deadline);
        }
        var i: ulong = 0;
        while (i < joined) {
            _cases[i]._leave(waiter);
            i = i + 1;
        }
        return woken;
    }
}
async/sync_wait
10735
# How a task waits on a `Mutex`, `Condition` or `Channel` without blocking
# its worker thread.
#
# A thread that must wait for one of them blocks on the platform lock or
# condition variable, as before. A task on a worker cannot: every other task
# on that thread would stop too. Instead it adds a `_SyncWaiter` to the
# object's `_SyncQueue` and parks (`_async_sync_park` in task.pep). Whoever
# makes progress possible (an unlock, a notify, a send) calls `_wake_one` or
# `_wake_all` on the queue as well as notifying the platform condition, so
# both kinds of waiter hear it.
#
# A waiter is woken once: `_state` goes from `_WAITER_WAITING` to
# `_WAITER_WOKEN` by a waker, or to `_WAITER_ABANDONED` by the task when it
# stops waiting on its own (cancelled, or its time ran out), which also
# takes it out of the queue. The wake reaches the task through its worker:
# directly when the waker runs on that worker, otherwise as a
# `_Message.Wake` in the worker's inbox. The task re-checks what it waits
# for after every wake, as a condition-variable waiter does.
#
# A plain thread normally waits on the platform condition instead, but a
# `Select` must sleep on several channels at once, so it joins each one's
# `_SyncQueue` with a waiter that carries a `_ThreadWake`: `_async_sync_wake`
# signals that instead of a worker's inbox, and the thread sleeps in
# `_async_thread_park`.
#
# `_size` lets `_wake_one` and `_wake_all` return without locking when no
# task waits. That read is only safe when the waiter's `_push` and the
# waker's change are ordered by some other lock (a Channel's, or the
# Mutex a Condition waits on); `Mutex` unlocks outside any such lock, so it
# calls `_wake_one_locked`, which always looks.

import "atomic";
import "lock";
import "sys_posix";
import "sys_wasi";
import "sys_windows";
import "task";
import "workers";

const _WAITER_WAITING = 0;
const _WAITER_WOKEN = 1;
const _WAITER_ABANDONED = 2;

# Gives every waiter its own id.
const _async_waiter_ids = Atomic<ulong>(1);

# One task, or one plain thread in a `Select`, waiting on sync objects.
[Shared]
struct _SyncWaiter {
    # Unique among waiters, for `_SyncQueue._remove`.
    const _id: ulong;
    # The inbox of the task's worker, and the task's id there (null and 0
    # for a thread).
    const _inbox: _Inbox;
    const _task: ulong;
    # What a thread sleeps on (null for a task).
    const _thread: _ThreadWake;
    # `_WAITER_WAITING`, `_WAITER_WOKEN` or `_WAITER_ABANDONED`.
    const _state: Atomic<int>;

    construct(inbox: _Inbox, task: ulong) {
        _id = _async_waiter_ids.fetch_add(1);
        _inbox = inbox;
        _task = task;
        _thread = __default<_ThreadWake>();
        _state = Atomic<int>(_WAITER_WAITING);
    }

    construct(thread: _ThreadWake) {
        _id = _async_waiter_ids.fetch_add(1);
        _inbox = __default<_Inbox>();
        _task = 0;
        _thread = thread;
        _state = Atomic<int>(_WAITER_WAITING);
    }
}

# What a plain thread waiting in a `Select` sleeps on: a platform lock and
# condition variable. A waker sets the waiter's state first and signals
# under the lock, and the thread checks the state under it, so no wake is
# missed.
[Shared]
struct _ThreadWake {
    const _lock: __ptr<void>;
    const _condition: __ptr<void>;

    construct() {
        _lock = _async_sys_mutex_create();
        _condition = _async_sys_condition_create();
    }

    destruct {
        _async_sys_condition_destroy(_condition);
        _async_sys_mutex_destroy(_lock);
    }

    # Wakes the thread.
    _signal() {
        _async_sys_mutex_lock(_lock);
        _async_sys_condition_notify_all(_condition);
        _async_sys_mutex_unlock(_lock);
    }
}

# Sleeps the calling thread (outside a task) until `waiter`, made with a
# `_ThreadWake`, is woken, or until `deadline` (monotonic milliseconds, 0
# for none) passes; returns `_SyncWake.Woken` or `_SyncWake.TimedOut`. A wait that
# times out abandons the waiter; the caller takes it out of its queues.
_async_thread_park(waiter: _SyncWaiter, deadline: ulong): _SyncWake {
    var wake = waiter._thread;
    var result = _SyncWake.Woken;
    _async_sys_mutex_lock(wake._lock);
    while (waiter._state.load() == _WAITER_WAITING) {
        if (deadline == 0) {
            _async_sys_condition_wait(wake._condition, wake._lock);
            continue;
        }
        var now = _async_sys_monotonic_milliseconds();
        if (now >= deadline) {
            if (waiter._state.compare_exchange(_WAITER_WAITING, _WAITER_ABANDONED)) {
                result = _SyncWake.TimedOut;
            }
            break;
        }
        _async_sys_condition_wait_for(wake._condition, wake._lock, deadline - now);
    }
    _async_sys_mutex_unlock(wake._lock);
    return result;
}

# The tasks waiting on one sync object, first come first woken. The ring
# buffer exists only while some task waits.
[Shared]
struct _SyncQueue {
    # The platform mutex that guards `_state` and `_buffer`.
    const _lock: __ptr<void>;
    # The head index, the number of waiters, and the number of slots.
    const _state: __ptr<ulong>;
    # Holds the ring buffer of `_SyncWaiter` slots (null while no task
    # waits).
    const _buffer: __ptr<__ptr<void>>;
    # The number of waiters, readable without the lock.
    const _size: Atomic<ulong>;

    construct() {
        _lock = _async_sys_mutex_create();
        _state = _pep_malloc(3 * sizeof<ulong>());
        _state[0] = 0;
        _state[1] = 0;
        _state[2] = 0;
        _buffer = _pep_malloc(sizeof<__ptr<void>>());
        _buffer[0] = __null;
        _size = Atomic<ulong>(0);
    }

    destruct {
        __ptr<_SyncWaiter> slots = this._slots();
        var i: ulong = 0;
        while (i < _state[1]) {
            slots[(_state[0] + i) % _state[2]] = __default<_SyncWaiter>();
            i = i + 1;
        }
        if (_buffer[0] != __null) {
            _pep_free(slots);
        }
        _pep_free(_buffer);
        _pep_free(_state);
        _async_sys_mutex_destroy(_lock);
    }

    # Adds `waiter` at the tail.
    _push(waiter: _SyncWaiter) {
        _async_sys_mutex_lock(_lock);
        if (_state[1] == _state[2]) {
            this._grow();
        }
        __ptr<_SyncWaiter> slots = this._slots();
        slots[(_state[0] + _state[1]) % _state[2]] = waiter;
        _state[1] = _state[1] + 1;
        _size.store(_state[1]);
        _async_sys_mutex_unlock(_lock);
    }

    # Takes `waiter` out of the queue, if it is there.
    _remove(waiter: _SyncWaiter) {
        _async_sys_mutex_lock(_lock);
        __ptr<_SyncWaiter> slots = this._slots();
        var count = _state[1];
        var i: ulong = 0;
        while (i < count) {
            if (slots[(_state[0] + i) % _state[2]]._id == waiter._id) {
                # Close the gap by moving the later waiters forward.
                while (i + 1 < count) {
                    slots[(_state[0] + i) % _state[2]] = slots[(_state[0] + i + 1) % _state[2]];
                    i = i + 1;
                }
                slots[(_state[0] + count - 1) % _state[2]] = __default<_SyncWaiter>();
                _state[1] = count - 1;
                _size.store(count - 1);
                this._shrink();
                break;
            }
            i = i + 1;
        }
        _async_sys_mutex_unlock(_lock);
    }

    # Wakes the first waiter, if any task waits (see the notes on `_size`).
    _wake_one() {
        if (_size.load() != 0) {
            this._wake_one_locked();
        }
    }

    # Wakes the first waiter still waiting, if any.
    _wake_one_locked() {
        while (true) {
            var next = this._pop();
            if (!next.0) {
                return;
            }
            var waiter = next.1;
            if (waiter._state.compare_exchange(_WAITER_WAITING, _WAITER_WOKEN)) {
                _async_sync_wake(waiter);
                return;
            }
        }
    }

    # Wakes every waiter.
    _wake_all() {
        if (_size.load() == 0) {
            return;
        }
        while (true) {
            var next = this._pop();
            if (!next.0) {
                return;
            }
            var waiter = next.1;
            if (waiter._state.compare_exchange(_WAITER_WAITING, _WAITER_WOKEN)) {
                _async_sync_wake(waiter);
            }
        }
    }

    # Takes the waiter at the head: `(true, waiter)`, or `(false, null)` when
    # none waits. A tuple, not an Optional, so a wake allocates nothing.
    _pop(): (bool, _SyncWaiter) {
        _async_sys_mutex_lock(_lock);
        if (_state[1] == 0) {
            _async_sys_mutex_unlock(_lock);
            return (false, __default<_SyncWaiter>());
        }
        __ptr<_SyncWaiter> slots = this._slots();
        var head = _state[0];
        var waiter = slots[head];
        slots[head] = __default<_SyncWaiter>();
        _state[0] = (head + 1) % _state[2];
        _state[1] = _state[1] - 1;
        _size.store(_state[1]);
        this._shrink();
        _async_sys_mutex_unlock(_lock);
        return (true, waiter);
    }

    # Frees the buffer once no task waits, so an object that tasks waited on
    # once holds no memory for it. The caller holds the lock.
    _shrink() {
        if (_state[1] == 0 && _buffer[0] != __null) {
            _pep_free(_buffer[0]);
            _buffer[0] = __null;
            _state[0] = 0;
            _state[2] = 0;
        }
    }

    # The ring buffer, as `_SyncWaiter` slots.
    _slots(): __ptr<_SyncWaiter> {
        __ptr<void> raw = _buffer[0];
        return raw;
    }

    # Moves the waiters, in order, into a buffer twice the size (4 slots at
    # first). The caller holds the lock.
    _grow() {
        __ptr<_SyncWaiter> old = this._slots();
        var slots = _state[2];
        var size: ulong = slots * 2;
        if (size == 0) {
            size = 4;
        }
        __ptr<_SyncWaiter> grown = _pep_malloc(size * sizeof<_SyncWaiter>());
        _async_zero(grown, size * sizeof<_SyncWaiter>());
        var i: ulong = 0;
        while (i < _state[1]) {
            var from = (_state[0] + i) % slots;
            grown[i] = old[from];
            old[from] = __default<_SyncWaiter>();
            i = i + 1;
        }
        if (_buffer[0] != __null) {
            _pep_free(old);
        }
        _buffer[0] = grown;
        _state[0] = 0;
        _state[2] = size;
    }
}
async/sys_posix
16759
# POSIX (Linux, macOS) platform layer for async. Every declaration carries
# [Target(OS(Linux) || OS(Mac))] or a narrower target; sys_windows.pep and
# sys_wasi.pep declare the same `_async_sys_*` functions with the same
# signatures for Windows and WASI. These
# are exported to the other async files only: module.pep does not re-export
# them.
#
# `pthread_t` is an unsigned long on Linux and a pointer on macOS; it travels
# as `__ptr<void>` (the same register either way), like a Windows `HANDLE`.
# `pthread_key_t` is an unsigned int on Linux and an unsigned long on macOS;
# it travels as `ulong` (64-bit little-endian targets only: a key written into
# a zeroed 8-byte buffer reads back the same either way).

import io;

[Target(OS(Linux) || OS(Mac))]
extern int pthread_create(void* thread, void* attributes, void* start, void* argument);
[Target(OS(Linux) || OS(Mac))]
extern int pthread_attr_init(void* attributes);
[Target(OS(Linux) || OS(Mac))]
extern int pthread_attr_setstacksize(void* attributes, ulong size);
[Target(OS(Linux) || OS(Mac))]
extern int pthread_attr_destroy(void* attributes);
[Target(OS(Linux) || OS(Mac))]
extern int pthread_join(void* thread, void* result);
[Target(OS(Linux) || OS(Mac))]
extern int pthread_detach(void* thread);
[Target(OS(Linux) || OS(Mac))]
extern ulong pthread_self();
[Target(OS(Linux) || OS(Mac))]
extern int pthread_key_create(void* key, void* destructor);
[Target(OS(Linux) || OS(Mac))]
extern int pthread_key_delete(ulong key);
[Target(OS(Linux) || OS(Mac))]
extern void* pthread_getspecific(ulong key);
[Target(OS(Linux) || OS(Mac))]
extern int pthread_setspecific(ulong key, void* value);
[Target(OS(Linux) || OS(Mac))]
extern void* malloc(ulong size);
[Target(OS(Linux) || OS(Mac))]
extern void free(void* pointer);
[Target(OS(Linux) || OS(Mac))]
extern int nanosleep(void* request, void* remaining);
[Target(OS(Linux) || OS(Mac))]
extern long sysconf(int name);
# sysconf's names: glibc's, and bionic's, which numbers them its own way.
[Target(OS(Linux) && !OS(Android))]
const _SC_NPROCESSORS_CONF = 83;
[Target(OS(Linux) && !OS(Android))]
const _SC_NPROCESSORS_ONLN = 84;
[Target(OS(Android))]
const _SC_NPROCESSORS_CONF = 96;
[Target(OS(Android))]
const _SC_NPROCESSORS_ONLN = 97;
[Target(OS(Mac))]
extern int sysctlbyname(char* name, void* value, void* size, void* new_value, ulong new_size);
[Target(OS(Linux) || OS(Mac))]
extern int clock_gettime(int clock, void* time);
[Target(OS(Linux))]
extern long syscall(long number, ...);
[Target(OS(Linux) && !OS(Android))]
extern int* __errno_location();
[Target(OS(Android))]
extern int* __errno();
[Target(OS(Mac))]
extern int __ulock_wait(uint operation, void* address, ulong value, uint timeout);
[Target(OS(Mac))]
extern int __ulock_wake(uint operation, void* address, ulong wake_value);

# ── Threads ──────────────────────────────────────────────────────────────────

# Starts a thread running `start(argument)` with a stack of `stack_size`
# bytes, rounded up to 64 KiB (0: the system's default, usually 8 MiB on
# Linux and 512 KiB on macOS); its handle, or null on failure.
[Target(OS(Linux) || OS(Mac))]
_async_sys_spawn(start: __ptr<void>, argument: __ptr<void>, stack_size: ulong): __ptr<void> {
    # A pthread_attr_t: 56 or 64 bytes on the targets supported.
    __ptr<void> attributes = __null;
    if (stack_size > 0) {
        attributes = _pep_malloc(128);
        pthread_attr_init(attributes);
        # macOS takes only whole pages (16 KiB on arm64). A size refused
        # fails the spawn rather than leaving the thread the default stack.
        if (pthread_attr_setstacksize(attributes, (stack_size + 65535) / 65536 * 65536) != 0) {
            pthread_attr_destroy(attributes);
            _pep_free(attributes);
            return __null;
        }
    }
    __ptr<__ptr<void>> thread = _pep_malloc(8);
    var result = pthread_create(thread, attributes, start, argument);
    if (attributes != __null) {
        pthread_attr_destroy(attributes);
        _pep_free(attributes);
    }
    __ptr<void> handle = thread[0];
    _pep_free(thread);
    if (result != 0) {
        return __null;
    }
    return handle;
}

[Target(OS(Linux) || OS(Mac))]
_async_sys_join(handle: __ptr<void>) {
    pthread_join(handle, __null);
}

[Target(OS(Linux) || OS(Mac))]
_async_sys_detach(handle: __ptr<void>) {
    pthread_detach(handle);
}

# The operating system's identity of the calling thread.
[Target(OS(Linux) || OS(Mac))]
_async_sys_os_thread(): ulong {
    return pthread_self();
}

[Target(OS(Linux) || OS(Mac))]
_async_sys_sleep(milliseconds: ulong) {
    # struct timespec { time_t tv_sec; long tv_nsec; }. From C's malloc, so
    # a thread asleep does not hold a live allocation that a leak check
    # would count (a test's timeout watchdog sleeps through the test).
    __ptr<long> time = malloc(16);
    time[0] = (milliseconds / 1000) as long;
    time[1] = ((milliseconds % 1000) * 1000000) as long;
    # Interrupted by a signal: sleep again for the time that was left, which
    # nanosleep wrote back. The request is always valid, so no other error
    # can repeat.
    while (nanosleep(time, time) != 0) {}
    free(time);
}

# ── Thread-local keys ────────────────────────────────────────────────────────

# A new key whose `destructor(value)` runs on each exiting thread with a
# non-null value.
[Target(OS(Linux) || OS(Mac))]
_async_sys_key_create(destructor: __ptr<void>): ulong {
    __ptr<ulong> key = _pep_malloc(8);
    if (pthread_key_create(key, destructor) != 0) {
        panic("ThreadLocal: the operating system has no thread-local keys left");
    }
    ulong created = key[0];
    _pep_free(key);
    return created;
}

[Target(OS(Linux) || OS(Mac))]
_async_sys_key_delete(key: ulong) {
    pthread_key_delete(key);
}

[Target(OS(Linux) || OS(Mac))]
_async_sys_key_get(key: ulong): __ptr<void> {
    return pthread_getspecific(key);
}

[Target(OS(Linux) || OS(Mac))]
_async_sys_key_set(key: ulong, value: __ptr<void>) {
    pthread_setspecific(key, value);
}

# ── Waiting on an address ────────────────────────────────────────────────────
#
# The futex calls that lock.pep builds mutexes and condition variables on:
# a thread sleeps while a 4-byte word holds the value it expects, until
# another thread wakes it through the word's address. Linux has `futex`;
# macOS has `__ulock_wait` / `__ulock_wake`, which every macOS since 10.12
# has (libc++'s `std::atomic::wait` uses them; `os_sync_wait_on_address`,
# from 14.4, would need a weak import the compiler cannot declare).

# The `futex` system call's number: x86-64 and AArch64 differ.
[Target(OS(Linux) && Arch(x64))]
const _SYS_FUTEX = 202;
[Target(OS(Linux) && Arch(aarch64))]
const _SYS_FUTEX = 98;

# FUTEX_WAIT | FUTEX_PRIVATE_FLAG and FUTEX_WAKE | FUTEX_PRIVATE_FLAG: the
# word is never shared with another process.
const _FUTEX_WAIT_PRIVATE = 128;
const _FUTEX_WAKE_PRIVATE = 129;

# UL_COMPARE_AND_WAIT | ULF_NO_ERRNO (errors come back negated), and the
# same with ULF_WAKE_ALL.
const _ULOCK_COMPARE_AND_WAIT: uint = 16777217;
const _ULOCK_WAKE_ALL: uint = 16777473;

# Sleeps while `word` holds `expected`, until woken (or spuriously).
[Target(OS(Linux))]
_async_sys_futex_wait(word: __ptr<uint>, expected: uint) {
    syscall(_SYS_FUTEX, word, _FUTEX_WAIT_PRIVATE as long, expected as long, 0 as long, 0 as long, 0 as long);
}

# Like `_async_sys_futex_wait`, for at most `milliseconds`; false if the time
# ran out. Waits past ~31 years are capped.
[Target(OS(Linux))]
_async_sys_futex_wait_for(word: __ptr<uint>, expected: uint, milliseconds: ulong): bool {
    var wait = milliseconds > 1000000000000 ? 1000000000000 : milliseconds;
    # A relative timeout on the monotonic clock: struct timespec
    # { time_t tv_sec; long tv_nsec; }.
    __ptr<long> timeout = _pep_malloc(16);
    timeout[0] = (wait / 1000) as long;
    timeout[1] = ((wait % 1000) * 1000000) as long;
    var result = syscall(
        _SYS_FUTEX, word, _FUTEX_WAIT_PRIVATE as long, expected as long, timeout, 0 as long, 0 as long
    );
    _pep_free(timeout);
    return result == 0 || _async_errno() != 110;  # ETIMEDOUT
}

# Wakes one thread sleeping on `word`, if any.
[Target(OS(Linux))]
_async_sys_futex_wake_one(word: __ptr<uint>) {
    syscall(_SYS_FUTEX, word, _FUTEX_WAKE_PRIVATE as long, 1 as long);
}

# Wakes every thread sleeping on `word`.
[Target(OS(Linux))]
_async_sys_futex_wake_all(word: __ptr<uint>) {
    syscall(_SYS_FUTEX, word, _FUTEX_WAKE_PRIVATE as long, 2147483647 as long);
}

[Target(OS(Linux) && !OS(Android))]
_async_errno(): int {
    return __errno_location()[0];
}

[Target(OS(Android))]
_async_errno(): int {
    return __errno()[0];
}

[Target(OS(Mac))]
_async_sys_futex_wait(word: __ptr<uint>, expected: uint) {
    __ulock_wait(_ULOCK_COMPARE_AND_WAIT, word, expected as ulong, 0);  # 0: no timeout
}

# The timeout is in microseconds, a 32-bit count in which 0 means forever:
# a longer wait is cut to ~71 minutes and reports a wake when it ends.
[Target(OS(Mac))]
_async_sys_futex_wait_for(word: __ptr<uint>, expected: uint, milliseconds: ulong): bool {
    var capped = milliseconds > 4294967;
    var microseconds = capped ? 4294967000 : milliseconds * 1000;
    if (microseconds == 0) {
        microseconds = 1;
    }
    var result = __ulock_wait(_ULOCK_COMPARE_AND_WAIT, word, expected as ulong, microseconds as uint);
    return result != -60 || capped;  # -ETIMEDOUT
}

[Target(OS(Mac))]
_async_sys_futex_wake_one(word: __ptr<uint>) {
    __ulock_wake(_ULOCK_COMPARE_AND_WAIT, word, 0);
}

[Target(OS(Mac))]
_async_sys_futex_wake_all(word: __ptr<uint>) {
    __ulock_wake(_ULOCK_WAKE_ALL, word, 0);
}

# Milliseconds on a clock that only moves forward (CLOCK_MONOTONIC: 1 on
# Linux, 6 on macOS), for measuring timeouts.
[Target(OS(Linux))]
_async_sys_monotonic_milliseconds(): ulong {
    return _async_monotonic_milliseconds(1);
}

[Target(OS(Mac))]
_async_sys_monotonic_milliseconds(): ulong {
    return _async_monotonic_milliseconds(6);
}

[Target(OS(Linux) || OS(Mac))]
_async_monotonic_milliseconds(clock: int): ulong {
    __ptr<long> time = _pep_malloc(16);
    clock_gettime(clock, time);
    var milliseconds = (time[0] * 1000 + time[1] / 1000000) as ulong;
    _pep_free(time);
    return milliseconds;
}

# ── Processor counts (0 when unknown) ────────────────────────────────────────

# Online processors, capped by a cgroup CPU quota (`docker run --cpus`) the
# way Go and the JVM cap theirs: a quota of 1.5 processors counts as 2.
[Target(OS(Linux))]
_async_sys_logical_cpus(): ulong {
    var count = sysconf(_SC_NPROCESSORS_ONLN);
    if (count < 1) {
        return 0;
    }
    var online = count as ulong;
    var quota = _async_sys_cgroup_cpu_quota();
    return quota != 0 && quota < online ? quota : online;
}

# The smallest CPU quota on this process's cgroup or its ancestors, in whole
# processors rounded up, or 0 when none is set: cgroup v2's `cpu.max`
# ("max 100000" or "150000 100000"), or v1's `cpu.cfs_quota_us` (-1 when
# unlimited) over `cpu.cfs_period_us`.
[Target(OS(Linux))]
_async_sys_cgroup_cpu_quota(): ulong {
    ulong smallest = 0;
    for (var directory in _async_sys_cgroup_directories("cpu")) {
        long quota = -1;
        long period = 0;
        var v2 = io.File.read_to_string(io.Path(directory + "/cpu.max"));
        if (v2.is_ok()) {
            var fields = v2.value().trim().split(" ");
            if (fields.count == 2) {
                quota = long.parse(fields[0]).value_or(-1);
                period = long.parse(fields[1]).value_or(0);
            }
        } else {
            var v1 = io.File.read_to_string(io.Path(directory + "/cpu.cfs_quota_us"));
            var v1_period = io.File.read_to_string(io.Path(directory + "/cpu.cfs_period_us"));
            if (v1.is_ok() && v1_period.is_ok()) {
                quota = long.parse(v1.value().trim()).value_or(-1);
                period = long.parse(v1_period.value().trim()).value_or(0);
            }
        }
        if (quota > 0 && period > 0) {
            var processors = ((quota + period - 1) / period) as ulong;
            if (smallest == 0 || processors < smallest) {
                smallest = processors;
            }
        }
    }
    return smallest;
}

# The directories of this process's cgroup and each of its ancestors for
# `controller`, innermost first, read from /proc/self/cgroup: under
# /sys/fs/cgroup/<controller> when a cgroup v1 hierarchy has the controller,
# otherwise under the unified (v2) hierarchy at /sys/fs/cgroup. Empty
# outside any cgroup. Some may not exist: in a container without a cgroup
# namespace the path names the host's view, while the container sees its
# own cgroup at the root, which the walk reaches last. Callers skip the
# files they cannot read.
[Target(OS(Linux))]
export _async_sys_cgroup_directories(controller: String): String[] {
    var directories = Array<String>();
    var table = io.File.read_to_string(io.Path("/proc/self/cgroup"));
    if (!table.is_ok()) {
        return directories;
    }
    var root = String();
    var path = String();
    for (var line in table.value().lines()) {
        # hierarchy-ID:controller-list:cgroup-path
        var fields = line.split(":");
        if (fields.count < 3) {
            continue;
        }
        # The path may itself hold ':'.
        var rest = line.substr_bytes(
            fields[0].size + fields[1].size + 2, line.size - fields[0].size - fields[1].size - 2
        );
        if (fields[0] == "0" && fields[1].is_empty) {
            if (root.is_empty) {
                root = "/sys/fs/cgroup";
                path = rest;
            }
        } else {
            for (var name in fields[1].split(",")) {
                if (name == controller) {
                    root = "/sys/fs/cgroup/" + controller;
                    path = rest;
                }
            }
        }
    }
    if (root.is_empty) {
        return directories;
    }
    while (true) {
        while (path.ends_with("/")) {
            path = path.substr_bytes(0, path.size - 1);
        }
        directories.append(root + path);
        if (path.is_empty) {
            break;
        }
        var slash = path.rfind("/");
        path = slash < 0 ? String() : path.substr_bytes(0, slash as ulong);
    }
    return directories;
}

# One core per distinct list of hardware threads sharing it, read from the
# topology of every configured CPU (offline CPUs have none).
[Target(OS(Linux))]
_async_sys_physical_cpus(): ulong {
    var configured = sysconf(_SC_NPROCESSORS_CONF);
    var cores = HashSet<String>();
    var cpu: long = 0;
    while (cpu < configured) {
        var topology = $"/sys/devices/system/cpu/cpu{cpu}/topology/";
        # core_cpus_list since Linux 5.3; thread_siblings_list before.
        var siblings = io.File.read_to_string(io.Path(topology + "core_cpus_list"));
        if (!siblings.is_ok()) {
            siblings = io.File.read_to_string(io.Path(topology + "thread_siblings_list"));
        }
        if (siblings.is_ok()) {
            cores.insert(siblings.value());
        }
        cpu = cpu + 1;
    }
    return cores.count as ulong;
}

[Target(OS(Mac))]
_async_sys_logical_cpus(): ulong {
    __ptr<int> value = _pep_malloc(4);
    __ptr<ulong> size = _pep_malloc(8);
    size[0] = 4;
    var result = sysctlbyname("hw.logicalcpu", value, size, __null, 0);
    int count = value[0];
    _pep_free(value);
    _pep_free(size);
    return result != 0 || count < 1 ? 0 : count as ulong;
}

[Target(OS(Mac))]
_async_sys_physical_cpus(): ulong {
    __ptr<int> value = _pep_malloc(4);
    __ptr<ulong> size = _pep_malloc(8);
    size[0] = 4;
    var result = sysctlbyname("hw.physicalcpu", value, size, __null, 0);
    int count = value[0];
    _pep_free(value);
    _pep_free(size);
    return result != 0 || count < 1 ? 0 : count as ulong;
}
async/sys_wasi
6065
# WASI (WebAssembly) platform layer for async: the same `_async_sys_*`
# functions as sys_posix.pep and sys_windows.pep, each with
# [Target(OS(Wasi))]. A WASI preview 1 program has one thread: starting
# another fails, and a mutex or condition variable has no other thread to
# wait for. wasi-libc's single-threaded pthread functions keep the
# thread-local keys and the mutexes' bookkeeping.

import io;

[Target(OS(Wasi))]
extern int pthread_key_create(void* key, void* destructor);
[Target(OS(Wasi))]
extern int pthread_key_delete(ulong key);
[Target(OS(Wasi))]
extern void* pthread_getspecific(ulong key);
[Target(OS(Wasi))]
extern int pthread_setspecific(ulong key, void* value);
[Target(OS(Wasi))]
extern ushort __wasi_clock_time_get(uint id, u64 precision, void* time);
[Target(OS(Wasi))]
extern ushort __wasi_poll_oneoff(void* subscriptions, void* events, ulong count, void* returned);

# ── Threads ──────────────────────────────────────────────────────────────────

# WASI preview 1 has no threads.
[Target(OS(Wasi))]
_async_sys_spawn(start: __ptr<void>, argument: __ptr<void>, stack_size: ulong): __ptr<void> {
    panic("Thread.spawn: threads are not supported on WASI");
    return __null;
}

[Target(OS(Wasi))]
_async_sys_join(handle: __ptr<void>) {}

[Target(OS(Wasi))]
_async_sys_detach(handle: __ptr<void>) {}

# The one thread.
[Target(OS(Wasi))]
_async_sys_os_thread(): ulong {
    return 1;
}

# Sleeps with poll_oneoff on one relative clock subscription (struct
# subscription: userdata u64 @0, tag u8 @8, then the clock's id u32 @16,
# timeout u64 @24, precision u64 @32, flags u16 @40; 48 bytes), for which it
# writes one 32-byte event.
[Target(OS(Wasi))]
_async_sys_sleep(milliseconds: ulong) {
    __ptr<u8> subscription = _pep_malloc(48);
    __ptr<u8> event = _pep_malloc(32);
    __ptr<u32> returned = _pep_malloc(4);
    var index: ulong = 0;
    while (index < 48) {
        subscription[index] = 0;
        index = index + 1;
    }
    unsafe_cast<__ptr<u32>>(subscription + 16)[0] = 1;  # CLOCKID_MONOTONIC
    unsafe_cast<__ptr<u64>>(subscription + 24)[0] = milliseconds * 1000000;
    __wasi_poll_oneoff(subscription, event, 1, returned);
    _pep_free(returned);
    _pep_free(event);
    _pep_free(subscription);
}

# ── Thread-local keys ────────────────────────────────────────────────────────

[Target(OS(Wasi))]
_async_sys_key_create(destructor: __ptr<void>): ulong {
    __ptr<ulong> key = _pep_malloc(8);
    key[0] = 0;
    if (pthread_key_create(key, destructor) != 0) {
        panic("ThreadLocal: the operating system has no thread-local keys left");
    }
    ulong created = key[0];
    _pep_free(key);
    return created;
}

[Target(OS(Wasi))]
_async_sys_key_delete(key: ulong) {
    pthread_key_delete(key);
}

[Target(OS(Wasi))]
_async_sys_key_get(key: ulong): __ptr<void> {
    return pthread_getspecific(key);
}

[Target(OS(Wasi))]
_async_sys_key_set(key: ulong, value: __ptr<void>) {
    pthread_setspecific(key, value);
}

# ── Mutexes and condition variables ──────────────────────────────────────────
#
# A mutex is a flag in its own heap block: with one thread, a lock that is
# taken is the caller's own re-lock, which `Mutex<T>` reports before it
# gets here. A condition variable has no other thread to notify it, so a
# wait returns at once (a spurious wake-up, which every caller allows for)
# and a timed wait sleeps out its time.

[Target(OS(Wasi))]
_async_sys_mutex_create(): __ptr<void> {
    __ptr<u8> mutex = _pep_malloc(8);
    mutex[0] = 0;
    return mutex;
}

[Target(OS(Wasi))]
_async_sys_mutex_destroy(mutex: __ptr<void>) {
    _pep_free(mutex);
}

[Target(OS(Wasi))]
_async_sys_mutex_lock(mutex: __ptr<void>) {
    __ptr<u8> flag = mutex;
    assert(flag[0] == 0, "Mutex: locked again on the only thread, which would wait forever");
    flag[0] = 1;
}

[Target(OS(Wasi))]
_async_sys_mutex_try_lock(mutex: __ptr<void>): bool {
    __ptr<u8> flag = mutex;
    if (flag[0] != 0) {
        return false;
    }
    flag[0] = 1;
    return true;
}

[Target(OS(Wasi))]
_async_sys_mutex_unlock(mutex: __ptr<void>) {
    __ptr<u8> flag = mutex;
    flag[0] = 0;
}

[Target(OS(Wasi))]
_async_sys_condition_create(): __ptr<void> {
    return _pep_malloc(8);
}

[Target(OS(Wasi))]
_async_sys_condition_destroy(condition: __ptr<void>) {
    _pep_free(condition);
}

[Target(OS(Wasi))]
_async_sys_condition_wait(condition: __ptr<void>, mutex: __ptr<void>) {}

[Target(OS(Wasi))]
_async_sys_condition_wait_for(condition: __ptr<void>, mutex: __ptr<void>, milliseconds: ulong): bool {
    _async_sys_mutex_unlock(mutex);
    _async_sys_sleep(milliseconds > 1000000000000 ? 1000000000000 : milliseconds);
    _async_sys_mutex_lock(mutex);
    return false;
}

[Target(OS(Wasi))]
_async_sys_condition_notify_one(condition: __ptr<void>) {}

[Target(OS(Wasi))]
_async_sys_condition_notify_all(condition: __ptr<void>) {}

[Target(OS(Wasi))]
_async_sys_monotonic_milliseconds(): ulong {
    __ptr<u64> time = _pep_malloc(8);
    time[0] = 0;
    __wasi_clock_time_get(1, 1000000, time);  # CLOCKID_MONOTONIC, to the millisecond
    var milliseconds = time[0] / 1000000;
    _pep_free(time);
    return milliseconds;
}

# ── Processor counts (0 when unknown) ────────────────────────────────────────

# The one thread is the only processor a program can use.
[Target(OS(Wasi))]
_async_sys_logical_cpus(): ulong {
    return 1;
}

[Target(OS(Wasi))]
_async_sys_physical_cpus(): ulong {
    return 1;
}
async/sys_windows
7886
# Windows platform layer for async. Every declaration carries
# [Target(OS(Windows))]; sys_posix.pep declares the same `_async_sys_*`
# functions with the same signatures for Linux and macOS. These are exported
# to the other async files only: module.pep does not re-export them.
#
# Thread handles are `HANDLE`s, as `__ptr<void>`. Thread-local keys are fiber
# local storage indexes (`FlsAlloc`), the Windows keys that take a
# destructor callback. Everything here is in kernel32, which is linked by
# default, except the wait-on-address calls (synchronization.lib).

[Target(OS(Windows))]
extern void* CreateThread(
    void* attributes, ulong stack_size, void* start, void* parameter, uint flags, uint* thread_id
);
[Target(OS(Windows))]
extern uint WaitForSingleObject(void* handle, uint milliseconds);
[Target(OS(Windows))]
extern int CloseHandle(void* handle);
[Target(OS(Windows))]
extern uint GetCurrentThreadId();
[Target(OS(Windows))]
extern void Sleep(uint milliseconds);
[Target(OS(Windows))]
extern uint FlsAlloc(void* callback);
[Target(OS(Windows))]
extern int FlsFree(uint index);
[Target(OS(Windows))]
extern void* FlsGetValue(uint index);
[Target(OS(Windows))]
extern int FlsSetValue(uint index, void* value);
[Target(OS(Windows))]
extern uint GetActiveProcessorCount(ushort group);
[Target(OS(Windows))]
extern int GetLogicalProcessorInformationEx(int relationship, void* buffer, uint* length);
[Target(OS(Windows))]
extern uint GetLastError();
[Target(OS(Windows))]
[Link("synchronization")]
extern int WaitOnAddress(void* address, void* compare, ulong size, uint milliseconds);
[Target(OS(Windows))]
[Link("synchronization")]
extern void WakeByAddressSingle(void* address);
[Target(OS(Windows))]
[Link("synchronization")]
extern void WakeByAddressAll(void* address);
[Target(OS(Windows))]
extern ulong GetTickCount64();

# ── Threads ──────────────────────────────────────────────────────────────────

# Starts a thread running `start(argument)` with `stack_size` bytes of
# stack reserved (0: the executable's default, 1 MiB); its handle, or null
# on failure.
[Target(OS(Windows))]
_async_sys_spawn(start: __ptr<void>, argument: __ptr<void>, stack_size: ulong): __ptr<void> {
    # STACK_SIZE_PARAM_IS_A_RESERVATION: reserve the size, commit as used.
    uint flags = stack_size > 0 ? 65536 : 0;
    return CreateThread(__null, stack_size, start, argument, flags, __null);
}

[Target(OS(Windows))]
_async_sys_join(handle: __ptr<void>) {
    WaitForSingleObject(handle, 4294967295);  # INFINITE
    CloseHandle(handle);
}

[Target(OS(Windows))]
_async_sys_detach(handle: __ptr<void>) {
    CloseHandle(handle);
}

# The operating system's identity of the calling thread.
[Target(OS(Windows))]
_async_sys_os_thread(): ulong {
    return GetCurrentThreadId() as ulong;
}

[Target(OS(Windows))]
_async_sys_sleep(milliseconds: ulong) {
    # Sleep takes a 32-bit count, and 0xFFFFFFFF means forever: sleep in
    # steps below it.
    var left = milliseconds;
    while (left > 0) {
        var step = left > 4000000000 ? 4000000000 : left;
        Sleep(step as uint);
        left = left - step;
    }
}

# ── Thread-local keys ────────────────────────────────────────────────────────

# A new key whose `destructor(value)` runs on each exiting thread with a
# non-null value.
[Target(OS(Windows))]
_async_sys_key_create(destructor: __ptr<void>): ulong {
    var index = FlsAlloc(destructor);
    if (index == 4294967295) {  # FLS_OUT_OF_INDEXES
        panic("ThreadLocal: the operating system has no thread-local keys left");
    }
    return index as ulong;
}

[Target(OS(Windows))]
_async_sys_key_delete(key: ulong) {
    FlsFree(key as uint);
}

[Target(OS(Windows))]
_async_sys_key_get(key: ulong): __ptr<void> {
    return FlsGetValue(key as uint);
}

[Target(OS(Windows))]
_async_sys_key_set(key: ulong, value: __ptr<void>) {
    FlsSetValue(key as uint, value);
}

# ── Waiting on an address ────────────────────────────────────────────────────
#
# The calls that lock.pep builds mutexes and condition variables on: a
# thread sleeps while a 4-byte word holds the value it expects, until
# another thread wakes it through the word's address. `WaitOnAddress` and
# the `WakeByAddress*` calls (Windows 8 and later) live in
# API-MS-Win-Core-Synch-l1-2-0, whose import library is synchronization.lib.

# Sleeps while `word` holds `expected`, until woken (or spuriously).
[Target(OS(Windows))]
_async_sys_futex_wait(word: __ptr<uint>, expected: uint) {
    _async_wait_on_address(word, expected, 4294967295);  # INFINITE
}

# Like `_async_sys_futex_wait`, for at most `milliseconds`; false if the time
# ran out. The timeout is a 32-bit count in which 0xFFFFFFFF means forever,
# so a longer wait is cut below it and reports a wake when it ends.
[Target(OS(Windows))]
_async_sys_futex_wait_for(word: __ptr<uint>, expected: uint, milliseconds: ulong): bool {
    var capped = milliseconds > 4000000000;
    var wait = capped ? 4000000000 : milliseconds;
    return _async_wait_on_address(word, expected, wait as uint) || capped;
}

# Wakes one thread sleeping on `word`, if any.
[Target(OS(Windows))]
_async_sys_futex_wake_one(word: __ptr<uint>) {
    WakeByAddressSingle(word);
}

# Wakes every thread sleeping on `word`.
[Target(OS(Windows))]
_async_sys_futex_wake_all(word: __ptr<uint>) {
    WakeByAddressAll(word);
}

# `WaitOnAddress` compares the word with a value at another address; false
# if the time ran out.
[Target(OS(Windows))]
_async_wait_on_address(word: __ptr<uint>, expected: uint, milliseconds: uint): bool {
    __ptr<uint> compare = _pep_malloc(4);
    compare[0] = expected;
    var woken = WaitOnAddress(word, compare, 4, milliseconds) != 0 || GetLastError() != 1460;  # ERROR_TIMEOUT
    _pep_free(compare);
    return woken;
}

# Milliseconds on a clock that only moves forward, for measuring timeouts.
[Target(OS(Windows))]
_async_sys_monotonic_milliseconds(): ulong {
    return GetTickCount64();
}

# ── Processor counts (0 when unknown) ────────────────────────────────────────

[Target(OS(Windows))]
_async_sys_logical_cpus(): ulong {
    return GetActiveProcessorCount(65535) as ulong;  # ALL_PROCESSOR_GROUPS
}

# One SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX record per core
# (RelationProcessorCore); each record starts with its Relationship (4 bytes)
# and Size (4 bytes).
[Target(OS(Windows))]
_async_sys_physical_cpus(): ulong {
    __ptr<uint> length = _pep_malloc(4);
    # Asking with no buffer fails and reports the size needed.
    GetLogicalProcessorInformationEx(0, __null, length);
    uint size = length[0];
    var cores: ulong = 0;
    if (size > 0) {
        __ptr<u8> buffer = _pep_malloc(size as ulong);
        if (GetLogicalProcessorInformationEx(0, buffer, length) != 0) {
            ulong offset = 0;
            while (offset + 8 <= length[0] as ulong) {
                __ptr<uint> record = unsafe_cast<__ptr<uint>>(buffer + offset);
                var record_size = record[1] as ulong;
                if (record_size == 0) {
                    break;
                }
                cores = cores + 1;
                offset = offset + record_size;
            }
        }
        _pep_free(buffer);
    }
    _pep_free(length);
    return cores;
}
async/task
62949
## Tasks: functions that run concurrently on a few worker threads, each on
## its own small stack, switching only where they wait.
##
## `run(body)` turns the calling thread into the first worker, starts the
## others, and runs `body` as the first task. A task starts others with
## `Task<T>.spawn_local` (on its own worker) or `spawn` (on any worker), and
## gives its worker to the other tasks there whenever it waits: `sleep`,
## `yield_now`, and `Task.join`, whenever a socket call would block, and
## whenever it waits on a `Mutex`, `Condition` or `Channel`. Nothing
## preempts a task, so a task that computes for a long time without waiting
## keeps every other task on its worker waiting too.
##
## A task is a green thread (a fiber): an ordinary function with its own
## stack, so code that waits looks the same as code that does not, and a
## function called in a task can wait without being marked in any way.

# Implementation notes. (What the workers of one `run` share is described
# in workers.pep.)
#
# One `_Worker` per thread inside `run`: its ready queue, its timer heap,
# the task it is running, and a pool of idle fibers. The worker lives in
# `run`'s frame; `_async_worker_slot` (a `[ThreadLocal]` pointer to a
# malloc'd slot holding one reference to it) lets code in tasks find it.
#
# Every fiber runs `_async_fiber_main`, a loop that runs whichever task the
# worker assigned it (`_current`) and then switches back to the scheduler.
# A fiber therefore outlives its task and is reused for the next one, which
# also means no fiber's entry function ever returns (a Windows fiber whose
# start routine returns ends its thread). The loop body calls a function
# that returns, so every reference a task's frame held is released before
# the fiber switches away for the last time.
#
# A task is parked (`_parked`) while it waits on a timer, a join, a
# socket, or a sync object (sync_wait.pep). Waking puts a parked task back
# on the ready queue once, however many things try to wake it; a woken task
# re-checks what it waited for. A timer carries the sequence number of the
# wait that set it, so a timer that outlives its wait (the task was woken
# some other way) wakes nothing.
#
# Sockets: the worker is the thread's `io._IoWaiter` (see io/wait.pep). A
# socket call that would block parks its task in `_wait_ready` until the
# worker's `_Driver` (driver.pep: epoll, kqueue, IOCP or poll, chosen when
# `run` starts) reports the socket ready. The driver watches a socket from
# the first time a task waits on it, and `_waits` maps it to the tasks
# waiting on it. When no task is ready the loop blocks in the driver until
# the next timer; while tasks run it polls the driver without blocking every
# `_POLL_INTERVAL` tasks, so waiting sockets are not starved.
#
# A timeout (`Deadline`) sets the task's `_deadline`, and every wait inside
# it also sets a timer for the deadline.

import io;
import os;
import "atomic";
import "cpus";
import "driver";
import "fiber_posix";
import "fiber_wasi";
import "fiber_windows";
import "sync_wait";
import "sys_posix";
import "sys_wasi";
import "sys_windows";
import "thread";
import "workers";

# How many tasks run between two non-blocking polls of the driver.
const _POLL_INTERVAL = 61;

## Why `Task.join` did not return the task's value.
export struct TaskError {
    ## A description of what went wrong.
    const message: String;
    # A timeout ended the wait, rather than cancellation.
    var _timed_out: bool;

    ## Creates a task error.
    ##
    ## @param message a description of what went wrong
    construct(message: String) {
        this.message = message;
    }

    ## Returns whether the task was cancelled, or the task waiting for it was.
    ##
    ## @returns true when cancellation ended the wait
    is_cancelled(): bool {
        return !this._timed_out;
    }

    ## Returns whether a `timeout` around the `join` expired before the task
    ## finished. The task itself carries on.
    ##
    ## @returns true when a timeout ended the wait
    is_timed_out(): bool {
        return this._timed_out;
    }
}

# The error `join` returns when a timeout expires.
_async_timed_out_error(): TaskError {
    var error = TaskError("the wait for the task timed out");
    error._timed_out = true;
    return error;
}

## Settings for `run_with`, built by chaining: `RuntimeOptions().stack_size(65536)`.
export struct RuntimeOptions {
    # Bytes of stack reserved for each task.
    var _stack_size: ulong;
    # The I/O backend asked for.
    var _backend: Backend;
    # How many workers, or 0 for one per logical CPU.
    var _workers: ulong;
    # The most threads `run_blocking` may start.
    var _blocking_threads: ulong;

    ## Creates the default options: one worker per logical CPU, 256 KiB of
    ## stack per task, the system's best I/O backend, and up to 64 threads
    ## for `run_blocking`.
    construct() {
        this._stack_size = 262144;
        this._backend = Backend.Automatic;
        this._workers = 0;
        this._blocking_threads = 64;
    }

    ## Sets how many workers (threads that run tasks) the runtime has. The
    ## thread that calls `run_with` is the first; the rest are new threads.
    ## Tasks from `spawn_local` run on the worker that started them; tasks
    ## from `spawn` run on whichever worker is free. The default is
    ## `logical_cpus()`.
    ##
    ## @param count the number of workers
    ## @returns these options
    ## @panics if `count` is 0
    workers(count: ulong): RuntimeOptions {
        assert(count > 0, "RuntimeOptions.workers: 0 workers");
        this._workers = count;
        return this;
    }

    ## Sets how many threads `run_blocking` may start. The runtime starts
    ## them one at a time, when a blocking call finds none idle, and keeps
    ## them until `run_with` returns. Once there are `count`, further calls
    ## wait for one of them to be free. The default is 64.
    ##
    ## @param count the most threads for blocking calls
    ## @returns these options
    ## @panics if `count` is 0
    blocking_threads(count: ulong): RuntimeOptions {
        assert(count > 0, "RuntimeOptions.blocking_threads: 0 threads");
        this._blocking_threads = count;
        return this;
    }

    ## Sets which I/O backend the runtime waits on sockets with. The default,
    ## `Backend.Automatic`, picks the system's best (or the one the
    ## `PEPPER_IO_BACKEND` environment variable names).
    ##
    ## @param kind the backend
    ## @returns these options
    ## @note `run_with` panics if the system does not have the backend
    backend(kind: Backend): RuntimeOptions {
        this._backend = kind;
        return this;
    }

    ## Sets how much stack each task reserves. Only the pages a task touches
    ## use memory; the rest is address space. A task that uses more than this
    ## crashes the program, as a thread that overflows its stack does.
    ##
    ## @param bytes the stack size in bytes (rounded up to whole pages)
    ## @returns these options
    ## @panics if `bytes` is less than 16 KiB
    stack_size(bytes: ulong): RuntimeOptions {
        assert(bytes >= 16384, "RuntimeOptions.stack_size: less than 16 KiB");
        this._stack_size = bytes;
        return this;
    }
}

# What the scheduler knows about a task, whatever its result type.
struct _TaskCore {
    # A number unique within the worker, for identity checks.
    var _id: ulong;
    # Runs the task's body and stores its result; cleared once it has run.
    var _body: () => void;
    # The fiber the task runs on, once started.
    var _fiber: __ptr<void>;
    var _started: bool;
    var _finished: bool;
    var _cancelled: bool;
    # Waiting to be woken (sleeping or joining), and not on the ready queue.
    var _parked: bool;
    # The sequence number of the timer the task's wait set, or 0.
    var _wait_sequence: ulong;
    # When the innermost `timeout` around the running code expires (monotonic
    # milliseconds), or 0.
    var _deadline: ulong;
    # Tasks parked in `join` on this one.
    var _joiners: Array<_TaskCore>;
    # The task's position in the worker's `_tasks`.
    var _index: ulong;
    # For a task from `spawn`: what the workers share about it. The worker
    # that runs it has a core for it, and so does the worker that spawned
    # it: a stand-in (`_proxy`) that never runs, and finishes when the
    # other worker reports the task finished.
    var _shared: _SharedTask?;
    # The `_cancelled` flag of `_shared`, or null. `_is_cancelled` reads it
    # on every socket wait; reading it from `_shared` would copy the
    # `[Shared]` task out of the optional, two atomic count steps.
    var _shared_cancelled: Atomic<int>;
    var _proxy: bool;
    # A stand-in's step when its task finishes: takes the result.
    var _on_complete: () => void;
    # The id that marks the task as a `Mutex`'s holder, or 0 until it first
    # takes one (see `_async_holder_id`).
    var _token: ulong;
    # The task's `TaskLocal` values, released when its body returns.
    var _locals: Array<_TaskLocalValue>;

    construct(id: ulong, body: () => void) {
        this._id = id;
        this._body = body;
        this._joiners = Array<_TaskCore>();
        this._locals = Array<_TaskLocalValue>();
    }

    # Releases the task's `TaskLocal` values, newest first. A value's
    # destructor may store another, which is released in turn.
    _release_locals() {
        while (this._locals.count > 0) {
            var local = this._locals.pop();
            local._release();
        }
    }

    # Whether the task was cancelled, here or (for a task from `spawn`) on
    # another worker.
    _is_cancelled(): bool {
        if (!this._cancelled && this._shared_cancelled !== __null) {
            if (this._shared_cancelled.load() != 0) {
                this._cancelled = true;
            }
        }
        return this._cancelled;
    }
}

# One task's value of a `TaskLocal` (task_local.pep): the variable's id,
# the malloc'd slot holding the value, and how to release the slot.
struct _TaskLocalValue {
    var _id: ulong;
    var _slot: __ptr<void>;
    var _release: () => void;

    construct(id: ulong, slot: __ptr<void>, release: () => void) {
        this._id = id;
        this._slot = slot;
        this._release = release;
    }
}

# When to wake a waiting task.
struct _Timer {
    var _deadline: ulong;
    var _sequence: ulong;
    var _task: _TaskCore;

    construct(deadline: ulong, sequence: ulong, task: _TaskCore) {
        this._deadline = deadline;
        this._sequence = sequence;
        this._task = task;
    }
}

# The scheduler state of a thread inside `run`.
struct _Worker {
    # Which worker this is (0 for the thread that called `run`), what the
    # workers share, and this worker's inbox.
    var _index: ulong;
    var _runtime: _Runtime;
    var _inbox: _Inbox;
    # Stand-ins for tasks spawned here that run elsewhere, and tasks from
    # `spawn` that run here: the tasks messages can name, by id.
    var _remote: HashMap<ulong, _TaskCore>;
    # Set once this worker has seen the runtime stopping and cancelled its
    # tasks.
    var _stopping: bool;
    # The thread's own context, which runs the scheduler loop.
    var _scheduler: __ptr<void>;
    # Tasks ready to run, first at `_ready_head`.
    var _ready: Array<_TaskCore>;
    var _ready_head: ulong;
    # Sleeping tasks: a binary min-heap on `_deadline`.
    var _timers: Array<_Timer>;
    var _timer_sequence: ulong;
    # Every task that has not finished, in no order.
    var _tasks: Array<_TaskCore>;
    var _next_id: ulong;
    # The running task, while one runs.
    var _current: _TaskCore;
    var _running: bool;
    # Fibers whose tasks finished, for the next tasks.
    var _idle: Array<__ptr<void>>;
    var _stack_size: ulong;
    # The I/O driver and the backend it is.
    var _driver: _Driver;
    var _backend: Backend;
    # Sockets the driver found ready in the last poll, and for what.
    var _ready_sockets: Array<(handle: ulong, interest: int)>;
    # The tasks waiting on each registered socket.
    var _waits: HashMap<ulong, _SocketWaits>;
    # How many tasks are parked on sockets or file transfers.
    var _io_waiting: ulong;
    # Tasks parked on a file transfer the driver runs, by id, and the
    # results of finished transfers not yet taken.
    var _file_waits: HashMap<ulong, _TaskCore>;
    var _file_results: HashMap<ulong, long>;
    var _finished_files: Array<(task: ulong, result: long)>;
    # Tasks parked on a `Mutex`, `Condition` or `Channel`, by id (see
    # sync_wait.pep).
    var _sync_waits: HashMap<ulong, _TaskCore>;
    # Tasks run since the driver was last polled.
    var _since_poll: ulong;
    # The `run_blocking` threads this worker started, joined when the
    # runtime ends.
    var _pool: Array<Thread>;

    construct(runtime: _Runtime, index: ulong, stack_size: ulong, backend: Backend) {
        this._index = index;
        this._runtime = runtime;
        this._remote = HashMap<ulong, _TaskCore>();
        this._scheduler = _async_fiber_thread_context();
        var (driver, chosen) = _async_open_driver(backend);
        this._driver = driver;
        this._backend = chosen;
        this._inbox = _Inbox(driver._doorbell());
        this._ready_sockets = Array<(handle: ulong, interest: int)>();
        this._waits = HashMap<ulong, _SocketWaits>();
        this._sync_waits = HashMap<ulong, _TaskCore>();
        this._file_waits = HashMap<ulong, _TaskCore>();
        this._file_results = HashMap<ulong, long>();
        this._finished_files = Array<(task: ulong, result: long)>();
        this._ready = Array<_TaskCore>();
        this._timers = Array<_Timer>();
        this._tasks = Array<_TaskCore>();
        this._idle = Array<__ptr<void>>();
        this._pool = Array<Thread>();
        this._stack_size = stack_size;
        this._next_id = 1;
        this._timer_sequence = 1;
    }

    _spawn(body: () => void): _TaskCore {
        var core = _TaskCore(this._next_id, body);
        this._next_id = this._next_id + 1;
        core._index = this._tasks.count;
        this._tasks.append(core);
        this._ready.append(core);
        return core;
    }

    # A stand-in for a task spawned here that runs on any worker.
    _new_proxy(): _TaskCore {
        var core = _TaskCore(this._next_id, () => {});
        this._next_id = this._next_id + 1;
        core._proxy = true;
        core._finished = false;
        core._on_complete = () => {};
        this._remote.insert(core._id, core);
        return core;
    }

    # Hands a body from `run_blocking` to the pool, starting a pool thread
    # when none is idle.
    _start_blocking(job: _SharedTask) {
        var runtime = this._runtime;
        if (runtime._block(job)) {
            this._pool.append(Thread.spawn(() => {
                _async_blocking_main(runtime);
            }, "async blocking"));
        }
    }

    # Takes the next task pinned to this worker, or else the next task from
    # `spawn` off the shared queue, and makes it ready here; false if there
    # is none.
    _take_shared(): bool {
        var next = this._inbox._pinned._try_take();
        if (!next.0) {
            next = this._runtime._queue._try_take();
        }
        if (!next.0) {
            return false;
        }
        var shared = next.1;
        var core = this._spawn(() => {
            shared._body();
        });
        core._shared = Optional<_SharedTask>.Value(shared);
        core._shared_cancelled = shared._cancelled;
        this._remote.insert(core._id, core);
        shared._runner_id.store(core._id);
        shared._runner_worker.store(this._index + 1);
        if (this._stopping) {
            core._cancelled = true;
        }
        return true;
    }

    # A task from `spawn` that ran here has finished: tells the worker that
    # spawned it.
    _finish_shared(core: _TaskCore) {
        this._remote.remove(core._id);
        var shared = core._shared.value();
        this._runtime._inbox(shared._owner)._send(shared._proxy, _Message.Complete);
    }

    # Handles the messages other workers sent.
    _receive() {
        while (true) {
            var (found, message) = this._inbox._messages._try_take();
            if (!found) {
                return;
            }
            var (id, kind) = _async_unpack_message(message);
            match (kind) {
                Wake => {
                    if (this._sync_waits.contains(id)) {
                        this._wake(this._sync_waits.get(id));
                    }
                }
                Complete => {
                    if (this._remote.contains(id)) {
                        var core = this._remote.get(id);
                        this._remote.remove(id);
                        var complete = core._on_complete;
                        core._on_complete = () => {};
                        complete();
                        core._finished = true;
                        this._wake_all(core._joiners);
                    }
                }
                Cancel => {
                    if (this._remote.contains(id)) {
                        _async_cancel(this, this._remote.get(id));
                    }
                }
            }
        }
    }

    # Cancels every task here, once the runtime is stopping.
    _stop() {
        this._stopping = true;
        for (var core in this._tasks) {
            _async_cancel(this, core);
        }
    }

    # Waits in the driver up to `timeout` milliseconds (forever when
    # negative), unless something arrived meanwhile (see workers.pep).
    _sleep(timeout: long) {
        var wait = timeout;
        this._inbox._sleeping.store(1);
        this._inbox._notified.store(0);
        var pending = this._inbox._messages.count + this._inbox._pinned.count + this._runtime._queue.count;
        if (pending > 0) {
            wait = 0;
        }
        if (!this._stopping && this._runtime._stopping.load() != 0) {
            wait = 0;
        }
        this._poll(wait);
        this._inbox._sleeping.store(0);
    }

    # Puts a parked task back on the ready queue.
    _wake(core: _TaskCore) {
        if (core._parked) {
            core._parked = false;
            this._ready.append(core);
        }
    }

    _has_ready(): bool {
        return this._ready_head < this._ready.count;
    }

    _pop_ready(): _TaskCore {
        var core = this._ready[this._ready_head];
        this._ready_head = this._ready_head + 1;
        if (this._ready_head == this._ready.count) {
            this._ready.clear();
            this._ready_head = 0;
        }
        return core;
    }

    _add_timer(timer: _Timer) {
        this._timers.append(timer);
        var i = this._timers.count - 1;
        while (i > 0) {
            var parent = (i - 1) / 2;
            if (this._timers[parent]._deadline <= this._timers[i]._deadline) {
                return;
            }
            this._timers.swap(parent, i);
            i = parent;
        }
    }

    _remove_first_timer(): _Timer {
        var first = this._timers[0];
        var last = this._timers.pop();
        var count = this._timers.count;
        if (count == 0) {
            return first;
        }
        this._timers[0] = last;
        var i: ulong = 0;
        while (true) {
            var smallest = i;
            var left = 2 * i + 1;
            var right = left + 1;
            if (left < count) {
                if (this._timers[left]._deadline < this._timers[smallest]._deadline) {
                    smallest = left;
                }
            }
            if (right < count) {
                if (this._timers[right]._deadline < this._timers[smallest]._deadline) {
                    smallest = right;
                }
            }
            if (smallest == i) {
                return first;
            }
            this._timers.swap(i, smallest);
            i = smallest;
        }
        return first;
    }

    # Sets a timer that wakes `core` at `deadline` unless its current wait
    # ends first.
    _set_timer(core: _TaskCore, deadline: ulong) {
        var sequence = this._timer_sequence;
        this._timer_sequence = sequence + 1;
        core._wait_sequence = sequence;
        this._add_timer(_Timer(deadline, sequence, core));
    }

    # Parks the running task until something wakes it, or its deadline
    # passes.
    _park() {
        var me = this._current;
        if (me._deadline != 0) {
            this._set_timer(me, me._deadline);
        }
        me._parked = true;
        _async_suspend(this);
        me._wait_sequence = 0;
    }

    # Wakes every task whose timer has expired.
    _fire_timers() {
        # Every scheduler pass comes here; with no timers, skip the clock
        # read (a system call and an allocation on POSIX).
        if (this._timers.count == 0) {
            return;
        }
        var now = _async_sys_monotonic_milliseconds();
        while (this._timers.count > 0) {
            if (this._timers[0]._deadline > now) {
                return;
            }
            var timer = this._remove_first_timer();
            if (timer._task._wait_sequence == timer._sequence) {
                timer._task._wait_sequence = 0;
                this._wake(timer._task);
            }
        }
    }

    # Waits up to `timeout` milliseconds (forever when negative) for socket
    # events, and wakes the tasks they let continue.
    _poll(timeout: long) {
        this._since_poll = 0;
        this._driver._poll(this._waits, timeout, this._ready_sockets);
        var i: ulong = 0;
        while (i < this._ready_sockets.count) {
            var (key, interest) = this._ready_sockets[i];
            if (this._waits.contains(key)) {
                var waits = this._waits.get(key);
                if ((interest & io._IO_READABLE) != 0) {
                    this._wake_all(waits._readers);
                }
                if ((interest & io._IO_WRITABLE) != 0) {
                    this._wake_all(waits._writers);
                }
            }
            i = i + 1;
        }
        this._ready_sockets.clear();
        this._driver._finished_files(this._finished_files);
        i = 0;
        while (i < this._finished_files.count) {
            var (task, result) = this._finished_files[i];
            this._file_results.insert(task, result);
            if (this._file_waits.contains(task)) {
                this._wake(this._file_waits.get(task));
            }
            i = i + 1;
        }
        this._finished_files.clear();
    }

    # Wakes every task in `tasks` and empties it. An index loop: a `for`
    # would allocate an iterator on every call, and the list is usually
    # empty.
    _wake_all(tasks: Array<_TaskCore>) {
        ulong index = 0;
        while (index < tasks.count) {
            this._wake(tasks[index]);
            index = index + 1;
        }
        tasks.clear();
    }

    # Wakes the tasks waiting on `handle` and forgets them.
    _drop_waits(handle: io.SocketHandle) {
        var key = handle as ulong;
        if (this._waits.contains(key)) {
            var waits = this._waits.get(key);
            this._wake_all(waits._readers);
            this._wake_all(waits._writers);
            this._waits.remove(key);
        }
    }

    # Runs one ready task until it waits or finishes.
    _run_one() {
        var core = this._pop_ready();
        if (core._finished) {
            return;
        }
        if (!core._started) {
            core._started = true;
            if (this._idle.count > 0) {
                core._fiber = this._idle.pop();
            } else {
                core._fiber = _async_fiber_create(this._stack_size, __function_pointer(_async_fiber_main));
                assert(core._fiber != __null, "async: out of memory for a task's stack");
            }
        }
        this._current = core;
        this._running = true;
        _async_fiber_switch(this._scheduler, core._fiber);
        this._running = false;
        this._current = __default<_TaskCore>();
        if (core._finished) {
            this._idle.append(core._fiber);
            core._fiber = __null;
            this._retire(core);
            if (core._shared.is_value()) {
                this._finish_shared(core);
            }
        }
    }

    # Removes a finished task from `_tasks`.
    _retire(core: _TaskCore) {
        var last = this._tasks.pop();
        if (last._id != core._id) {
            this._tasks[core._index] = last;
            last._index = core._index;
        }
    }

    # Runs tasks until the runtime stops (see workers.pep) and none are
    # left here. On the first worker, `first` is the first task, whose end
    # stops the runtime.
    _run(first: _TaskCore?) {
        while (true) {
            if (!this._stopping) {
                if (first.is_value() && first.value()._finished) {
                    this._runtime._stop();
                }
                if (this._runtime._stopping.load() != 0) {
                    this._stop();
                }
            }
            if (this._stopping && this._tasks.count == 0 && this._remote.count == 0) {
                if (!this._take_shared()) {
                    return;
                }
            }
            this._fire_timers();
            if (this._has_ready()) {
                this._run_one();
                this._since_poll = this._since_poll + 1;
                if (this._since_poll >= _POLL_INTERVAL) {
                    this._receive();
                    this._take_shared();
                    this._poll(0);
                }
                continue;
            }
            this._receive();
            if (this._has_ready() || this._take_shared()) {
                continue;
            }
            if (this._stopping && this._tasks.count == 0 && this._remote.count == 0) {
                continue;
            }
            # With no tasks here, every timer left is stale.
            var timeout: long = -1;
            if (this._timers.count > 0 && this._tasks.count > 0) {
                var now = _async_sys_monotonic_milliseconds();
                var deadline = this._timers[0]._deadline;
                timeout = 0;
                if (deadline > now) {
                    timeout = (deadline - now) as long;
                }
            } else if (this._tasks.count > 0
                && this._io_waiting == 0
                && this._remote.count == 0
                && this._sync_waits.count == 0) {
                panic("async.run: every task is waiting for another task and none can continue");
            }
            this._sleep(timeout);
        }
    }

    # Frees the fibers, the driver and the thread context. Every worker has
    # stopped by now (see `_Runtime._leave`).
    _close() {
        for (var fiber in this._idle) {
            _async_fiber_destroy(fiber);
        }
        this._idle.clear();
        this._waits.clear();
        this._driver._close();
        _async_fiber_release_thread_context(this._scheduler);
    }
}

# The tasks waiting on one socket.
struct _SocketWaits {
    var _readers: Array<_TaskCore>;
    var _writers: Array<_TaskCore>;

    construct() {
        this._readers = Array<_TaskCore>();
        this._writers = Array<_TaskCore>();
    }
}

# Removes `core` from `tasks`, if it is there.
_async_remove_task(tasks: Array<_TaskCore>, core: _TaskCore) {
    var i: ulong = 0;
    while (i < tasks.count) {
        if (tasks[i]._id == core._id) {
            tasks.remove_at(i);
            return;
        }
        i = i + 1;
    }
}

# Parks the running task until `handle` may be ready for `interest`, or its
# cancel or deadline comes first (see `_IoWaiter._wait_ready`).
_async_wait_socket(worker: _Worker, handle: io.SocketHandle, interest: int): io._IoWait {
    var me = worker._current;
    if (me._is_cancelled()) {
        return io._IoWait.Cancelled;
    }
    if (me._deadline != 0 && _async_sys_monotonic_milliseconds() >= me._deadline) {
        return io._IoWait.TimedOut;
    }
    var key = handle as ulong;
    if (!worker._waits.contains(key)) {
        if (!worker._driver._watch(handle)) {
            return io._IoWait.Unwatched;
        }
        worker._waits.insert(key, _SocketWaits());
    }
    var waits = worker._waits.get(key);
    var queue = waits._readers;
    if (interest == io._IO_WRITABLE) {
        queue = waits._writers;
    }
    if (!worker._driver._want(handle, interest)) {
        return io._IoWait.Unwatched;
    }
    queue.append(me);
    worker._io_waiting = worker._io_waiting + 1;
    worker._park();
    worker._io_waiting = worker._io_waiting - 1;
    _async_remove_task(queue, me);
    if (me._is_cancelled()) {
        return io._IoWait.Cancelled;
    }
    if (me._deadline != 0 && _async_sys_monotonic_milliseconds() >= me._deadline) {
        return io._IoWait.TimedOut;
    }
    return io._IoWait.Ready;
}

# The deadline (monotonic milliseconds, 0 for none) of a wait that may take
# `timeout` milliseconds (0 for no limit) in a task whose deadline is
# `deadline`: the earlier of the two.
_async_wait_deadline(deadline: ulong, timeout: ulong): ulong {
    if (timeout == 0) {
        return deadline;
    }
    var until = _async_sys_monotonic_milliseconds() + timeout;
    if (deadline != 0 && deadline < until) {
        return deadline;
    }
    return until;
}

# How the sockets in io wait (see io/wait.pep).
extend _Worker with io._IoWaiter {
    _in_task(): bool {
        return this._running;
    }

    _wait_ready(handle: io.SocketHandle, interest: int, timeout: ulong): io._IoWait {
        # The socket's timeout lowers the task's deadline for this wait.
        var me = this._current;
        var saved = me._deadline;
        me._deadline = _async_wait_deadline(saved, timeout);
        var result = _async_wait_socket(this, handle, interest);
        me._deadline = saved;
        return result;
    }

    _forget(handle: io.SocketHandle) {
        this._driver._forget(handle);
        this._drop_waits(handle);
    }

    _release(handle: io.SocketHandle) {
        this._driver._release(handle);
        this._drop_waits(handle);
    }

    _release_idle(handle: io.SocketHandle) {
        var key = handle as ulong;
        if (this._waits.contains(key)) {
            var waits = this._waits.get(key);
            if (waits._readers.count == 0 && waits._writers.count == 0) {
                this._driver._release(handle);
                this._waits.remove(key);
            }
        }
    }

    _file_transfer(transfer: io._FileTransfer): long {
        var me = this._current;
        var descriptor = _async_file_descriptor(transfer._handle);
        if (!this._driver._start_file(descriptor, transfer._address(), transfer._count, transfer._write, me._id)) {
            return run_blocking<long>(() => {
                return transfer._run();
            });
        }
        # Neither a cancel nor a deadline ends the wait: the kernel is using
        # `buffer`.
        var deadline = me._deadline;
        me._deadline = 0;
        this._file_waits.insert(me._id, me);
        this._io_waiting = this._io_waiting + 1;
        while (!this._file_results.contains(me._id)) {
            this._park();
        }
        this._io_waiting = this._io_waiting - 1;
        this._file_waits.remove(me._id);
        var result = this._file_results.get(me._id);
        this._file_results.remove(me._id);
        me._deadline = deadline;
        return result;
    }

    _socket_transfer(handle: io.SocketHandle, buffer: ulong, count: ulong, write: bool, timeout: ulong): long {
        var me = this._current;
        if (me._is_cancelled()) {
            return io._IO_TRANSFER_CANCELLED;
        }
        # The socket's timeout lowers the task's deadline for this wait.
        var saved = me._deadline;
        var deadline = _async_wait_deadline(saved, timeout);
        if (deadline != 0 && _async_sys_monotonic_milliseconds() >= deadline) {
            return io._IO_TRANSFER_TIMED_OUT;
        }
        var request = this._driver._start_socket(handle, buffer, count, write, me._id);
        if (request == 0) {
            return io._IO_TRANSFER_DECLINED;
        }
        return _async_await_request(this, request, deadline);
    }

    _directory_changes(handle: ulong, buffer: ulong, count: ulong): long {
        var me = this._current;
        if (me._is_cancelled()) {
            return io._IO_TRANSFER_CANCELLED;
        }
        var deadline = me._deadline;
        if (deadline != 0 && _async_sys_monotonic_milliseconds() >= deadline) {
            return io._IO_TRANSFER_TIMED_OUT;
        }
        var request = this._driver._start_directory_changes(handle, buffer, count, me._id);
        if (request == 0) {
            return io._IO_TRANSFER_DECLINED;
        }
        return _async_await_request(this, request, deadline);
    }
}

# Parks the running task until the driver's request `request` finishes,
# with `deadline` (monotonic milliseconds, 0 for none) as the task's for the
# wait, and returns its result. A cancel or the deadline asks the kernel to
# stop, then still waits for the request to finish: the kernel is using the
# request's buffer until then. Cancelled before it moved any bytes, the
# result says why: the task, or the handle closing.
_async_await_request(worker: _Worker, request: ulong, deadline: ulong): long {
    var me = worker._current;
    var saved = me._deadline;
    me._deadline = deadline;
    worker._file_waits.insert(me._id, me);
    worker._io_waiting = worker._io_waiting + 1;
    long stopped = 0;
    while (!worker._file_results.contains(me._id)) {
        if (stopped == 0) {
            if (me._is_cancelled()) {
                stopped = io._IO_TRANSFER_CANCELLED;
            } else if (deadline != 0 && _async_sys_monotonic_milliseconds() >= deadline) {
                stopped = io._IO_TRANSFER_TIMED_OUT;
            }
            if (stopped != 0) {
                worker._driver._cancel_transfer(request);
                me._deadline = 0;
            }
        }
        worker._park();
    }
    worker._io_waiting = worker._io_waiting - 1;
    worker._file_waits.remove(me._id);
    var result = worker._file_results.get(me._id);
    worker._file_results.remove(me._id);
    me._deadline = saved;
    if (result == _ASYNC_CANCELLED_RESULT) {
        return stopped != 0 ? stopped : io._IO_TRANSFER_CLOSED;
    }
    return result;
}

# A transfer's result when the kernel cancelled it: -1 minus ECANCELED.
const _ASYNC_CANCELLED_RESULT: long = -126;

# A file handle as the drivers take it. Only io_uring (Linux) runs file
# transfers itself.
[Target(!OS(Windows))]
_async_file_descriptor(handle: io.FileHandle): long {
    return handle as long;
}

[Target(OS(Windows))]
_async_file_descriptor(handle: io.FileHandle): long {
    return -1;
}

# The current thread's worker: a malloc'd slot holding one reference to it,
# or null outside `run`. A thread (not fiber) local: a task never moves to
# another thread, and every fiber on a thread shares its worker.
[ThreadLocal]
var _async_worker_slot: __ptr<void>;

_async_on_worker(): bool {
    return _async_worker_slot != __null;
}

_async_worker(): _Worker {
    __ptr<_Worker> slot = _async_worker_slot;
    assert(slot != __null, "async: not inside async.run");
    return slot[0];
}

# Whether the calling code runs in a task (on a worker inside `run`).
_async_in_task(): bool {
    return _async_on_worker() && _async_worker()._running;
}

# The running task's slot for the `TaskLocal` numbered `id`, or null when
# it has no value. Only in a task.
_async_task_local_slot(id: ulong): __ptr<void> {
    # An index loop: `TaskLocal.get` calls this, and a `for` would allocate
    # an iterator every time.
    var locals = _async_worker()._current._locals;
    ulong index = 0;
    while (index < locals.count) {
        if (locals[index]._id == id) {
            return locals[index]._slot;
        }
        index = index + 1;
    }
    return __null;
}

# Records `slot` as the running task's value of the `TaskLocal` numbered
# `id`; `release` frees it when the task ends. Only in a task.
_async_task_local_add(id: ulong, slot: __ptr<void>, release: () => void) {
    _async_worker()._current._locals.append(_TaskLocalValue(id, slot, release));
}

# Removes and releases the running task's value of the `TaskLocal`
# numbered `id`, if it has one. Only in a task.
_async_task_local_clear(id: ulong) {
    var locals = _async_worker()._current._locals;
    var i: ulong = 0;
    while (i < locals.count) {
        if (locals[i]._id == id) {
            var local = locals.remove_at(i);
            local._release();
            return;
        }
        i = i + 1;
    }
}

# Gives every task that takes a `Mutex` its own holder id, above any
# operating-system thread id.
const _async_task_tokens = Atomic<ulong>((1 as ulong) << 62);

# The id that marks the caller as a `Mutex`'s holder: the running task's
# own, or the thread's outside a task, since tasks on one worker share its
# thread.
_async_holder_id(): ulong {
    if (!_async_in_task()) {
        return _async_sys_os_thread();
    }
    var me = _async_worker()._current;
    if (me._token == 0) {
        me._token = _async_task_tokens.fetch_add(1);
    }
    return me._token;
}

# A waiter for the running task to add to a `_SyncQueue`. The caller has
# checked `_async_in_task()`; no Optional is built, since every park takes
# this path.
_async_sync_waiter(): _SyncWaiter {
    assert(_async_in_task(), "_async_sync_waiter outside a task");
    var worker = _async_worker();
    return _SyncWaiter(worker._inbox, worker._current._id);
}

# What `_async_sync_park` reports: woken by a waker, or why the wait ended
# without one.
enum _SyncWake {
    Woken,
    Cancelled,
    TimedOut,
}

# Parks the running task until `waiter`, already in `queue`, is woken, or
# until `deadline` (monotonic milliseconds, 0 for none) passes. When
# `interruptible`, a cancel or the task's `timeout` also ends the wait.
#
# A wait that ends without a wake abandons the waiter and takes it out of
# `queue`, and the result says why; a waker that got there first wins, and
# the result is `_SyncWake.Woken`.
_async_sync_park(queue: _SyncQueue, waiter: _SyncWaiter, deadline: ulong, interruptible: bool): _SyncWake {
    var worker = _async_worker();
    var me = worker._current;
    var saved = me._deadline;
    var until = deadline;
    if (interruptible && saved != 0 && (until == 0 || saved < until)) {
        until = saved;
    }
    me._deadline = until;
    worker._sync_waits.insert(me._id, me);
    var result = _SyncWake.Woken;
    while (waiter._state.load() == _WAITER_WAITING) {
        var reason = _SyncWake.Woken;
        if (interruptible && me._is_cancelled()) {
            reason = _SyncWake.Cancelled;
        } else if (until != 0 && _async_sys_monotonic_milliseconds() >= until) {
            reason = _SyncWake.TimedOut;
        }
        if (reason != _SyncWake.Woken) {
            if (waiter._state.compare_exchange(_WAITER_WAITING, _WAITER_ABANDONED)) {
                queue._remove(waiter);
                result = reason;
            }
            break;
        }
        worker._park();
    }
    worker._sync_waits.remove(me._id);
    me._deadline = saved;
    return result;
}

# Wakes the task `waiter` stands for: directly when it waits on the calling
# thread's worker, otherwise through that worker's inbox. A plain thread's
# waiter (in a `Select`) is signalled through its `_ThreadWake`.
_async_sync_wake(waiter: _SyncWaiter) {
    if (waiter._thread !== __null) {
        waiter._thread._signal();
        return;
    }
    if (_async_on_worker()) {
        var worker = _async_worker();
        if (worker._inbox._id == waiter._inbox._id) {
            if (worker._sync_waits.contains(waiter._task)) {
                worker._wake(worker._sync_waits.get(waiter._task));
            }
            return;
        }
    }
    waiter._inbox._send(waiter._task, _Message.Wake);
}

# Marks `core` cancelled and wakes it if it waits.
_async_cancel(worker: _Worker, core: _TaskCore) {
    if (core._finished) {
        return;
    }
    core._cancelled = true;
    core._wait_sequence = 0;
    worker._wake(core);
}

# Switches from the running task to the scheduler; returns when the task
# is resumed. A destruction it is inside of stays its own
# (`_pep_release_suspend`).
_async_suspend(worker: _Worker) {
    var floor = _pep_release_suspend();
    _async_fiber_switch(worker._current._fiber, worker._scheduler);
    _pep_release_resume(floor);
}

# Runs the task the worker assigned to this fiber, and marks it finished.
_async_run_current() {
    var worker = _async_worker();
    var core = worker._current;
    var body = core._body;
    core._body = () => {};
    body();
    core._release_locals();
    core._finished = true;
    worker._wake_all(core._joiners);
}

# The entry point of every fiber (see the notes at the top of this file).
_async_fiber_main(unused: __ptr<void>) {
    while (true) {
        _async_run_current();
        _async_return_to_scheduler();
    }
}

# Switches to the scheduler for good, holding no reference in this frame.
_async_return_to_scheduler() {
    _async_fiber_switch(_async_current_fiber(), _async_scheduler_context());
}

_async_current_fiber(): __ptr<void> {
    return _async_worker()._current._fiber;
}

_async_scheduler_context(): __ptr<void> {
    return _async_worker()._scheduler;
}

## A task started with `spawn_local` or `spawn`, and the value its body
## returns.
##
## @typeParam T the type of the body's result; `void` when there is none
## @example
##     import async;
##
##     main(): int {
##         async.run(() => {
##             var a = async.Task<int>.spawn_local(() => { return 20; });
##             var b = async.Task<int>.spawn_local(() => { return 22; });
##             print(a.join().value() + b.join().value());   # 42
##         });
##         return 0;
##     }
export struct Task<T> {
    # What the scheduler knows about the task (set once, by `spawn_local`).
    var _core: _TaskCore;
    # The body's result, once it has finished.
    var _value: T;

    ## Wraps the scheduler's record of a task. Only `spawn_local` and `spawn`
    ## have one; start tasks with those.
    ##
    ## @param core the scheduler's record of the task
    construct(core: _TaskCore) {
        this._core = core;
    }

    ## Starts a task on the current worker that runs `body`. It runs the
    ## next time the running task waits, and may use anything the running
    ## task can, since it stays on this thread.
    ##
    ## @param body the task's code
    ## @returns the task
    ## @panics outside `run`
    static spawn_local(body: () => T): Task<T> {
        assert(_async_on_worker(), "Task.spawn_local: not inside async.run");
        var worker = _async_worker();
        var task = Task<T>(__default<_TaskCore>());
        var core = worker._spawn(() => {
            task._run(body);
        });
        task._core = core;
        return task;
    }

    _run(body: () => T) {
        this._value = body();
    }

    ## Waits for the task to finish and returns its value. Other tasks run
    ## meanwhile.
    ##
    ## @returns the body's result, or a `TaskError` if the task was cancelled
    ##   before it finished, the task calling `join` was cancelled while it
    ##   waited, or a `timeout` around the `join` expired first
    ## @panics if a task joins itself, or if called outside `run` on a task
    ##   that has not finished
    join(): Result<T, TaskError> {
        if (!this._core._finished) {
            assert(_async_on_worker(), "Task.join: not inside async.run");
            var worker = _async_worker();
            var me = worker._current;
            assert(worker._running, "Task.join: not called from a task");
            assert(me._id != this._core._id, "Task.join: a task cannot join itself");
            this._core._joiners.append(me);
            while (!this._core._finished) {
                if (me._is_cancelled()) {
                    _async_remove_task(this._core._joiners, me);
                    return Result<T, TaskError>.err(TaskError("the waiting task was cancelled"));
                }
                if (me._deadline != 0 && _async_sys_monotonic_milliseconds() >= me._deadline) {
                    _async_remove_task(this._core._joiners, me);
                    return Result<T, TaskError>.err(_async_timed_out_error());
                }
                worker._park();
            }
        }
        if (this._core._cancelled) {
            return Result<T, TaskError>.err(TaskError("the task was cancelled"));
        }
        return Result<T, TaskError>.ok(this._value);
    }

    ## Asks the task to stop: from now on `is_cancelled()` is true inside it,
    ## `sleep` returns at once, and its `join` calls fail. A task is never
    ## stopped by force; it finishes when its body returns.
    cancel() {
        if (this._core._proxy) {
            if (this._core._finished) {
                this._core._cancelled = true;
                return;
            }
            this._core._cancelled = true;
            if (_async_on_worker()) {
                this._core._shared.value()._cancel(_async_worker()._runtime);
            } else {
                this._core._shared.value()._cancelled.store(1);
            }
        } else if (_async_on_worker()) {
            _async_cancel(_async_worker(), this._core);
        } else {
            this._core._cancelled = true;
        }
    }

    ## Returns whether the task's body has returned.
    ##
    ## @returns true once the task has finished
    is_finished(): bool {
        return this._core._finished;
    }
}

## Runs `body` as the first task of a new runtime, and returns once `body`
## has returned and every task it started has finished. The calling thread
## is the first worker; the runtime starts one more thread per logical CPU
## after it (see `RuntimeOptions.workers`). When `body` returns, the tasks
## still running are cancelled (see `Task.cancel`), on every worker, and
## `run` waits for them to finish.
##
## @param body the first task
## @panics if called inside a task, or if every remaining task is waiting on
##   another and none can continue
## @example
##     import async;
##
##     main(): int {
##         async.run(() => {
##             var t = async.Task<void>.spawn_local(() => {
##                 async.sleep(10);
##                 print("second");
##             });
##             print("first");
##             t.join();
##         });
##         return 0;
##     }
export run(body: () => void) {
    run_with(RuntimeOptions(), body);
}

## Runs `body` like `run`, with the given settings.
##
## @param options the runtime's settings
## @param body the first task
## @panics if called inside a task, if every remaining task is waiting on
##   another and none can continue, or if the system does not have the
##   backend `options` asks for
export run_with(options: RuntimeOptions, body: () => void) {
    assert(!_async_on_worker(), "async.run: already inside async.run");
    var count = options._workers;
    if (count == 0) {
        count = logical_cpus();
    }
    var runtime = _Runtime(count, options._blocking_threads);
    var stack_size = options._stack_size;
    var backend = options._backend;
    var threads = Array<Thread>();
    var i: ulong = 1;
    while (i < count) {
        var index = i;
        threads.append(Thread.spawn(() => {
            _async_worker_main(runtime, index, stack_size, backend, () => {});
        }, "async worker"));
        i = i + 1;
    }
    _async_worker_main(runtime, 0, stack_size, backend, body);
    for (var thread in threads) {
        thread.join();
    }
}

# Runs worker `index` of `runtime` on this thread until the runtime stops.
# The first worker's first task is `body`.
_async_worker_main(runtime: _Runtime, index: ulong, stack_size: ulong, backend: Backend, body: () => void) {
    var worker = _Worker(runtime, index, stack_size, backend);
    __ptr<_Worker> slot = _pep_malloc(8);
    slot[0] = worker;
    _async_worker_slot = slot;
    io._io_set_waiter(worker);
    runtime._join(index, worker._inbox);
    var first = Optional<_TaskCore>.Empty;
    if (index == 0) {
        first = Optional<_TaskCore>.Value(worker._spawn(body));
    }
    worker._run(first);
    runtime._leave(worker._inbox);
    # Every blocking call has returned: no task is left to wait for one.
    runtime._blocking.close();
    for (var thread in worker._pool) {
        thread.join();
    }
    worker._pool.clear();
    io._io_clear_waiter();
    _async_worker_slot = __null;
    slot[0] = __default<_Worker>();
    _pep_free(slot);
    worker._close();
}

## Starts a task that runs `body` on whichever worker is free first, and
## returns it. Unlike `Task<T>.spawn_local`, the task may run on another
## thread, in parallel with the calling task, so the body must be a
## `shared` function (it may capture only thread-safe values) and its result
## crosses threads, so `T` is constrained `Shared`: a thread-safe type such
## as a number, a `[Shared]` struct, or a `shared` function type
## (`spawn<String>` is a compile error at `String`).
##
## A task, once started, stays on the worker that started it. Joining and
## cancelling work as for `spawn_local`.
##
## @typeParam T the type of the body's result, which must be thread-safe
##   (`T: Shared`); `void` when there is none
## @param body the task's code
## @returns the task
## @panics outside `run`
## @example
##     import async;
##
##     sum(from: long, to: long): long {
##         var total: long = 0;
##         var i = from;
##         while (i < to) {
##             total = total + i;
##             i = i + 1;
##         }
##         return total;
##     }
##
##     main(): int {
##         async.run(() => {
##             var low = async.spawn<long>(() => { return sum(0, 500000); });
##             var high = async.spawn<long>(() => { return sum(500000, 1000000); });
##             print(low.join().value() + high.join().value());   # 499999500000
##         });
##         return 0;
##     }
export spawn<T: Shared>(body: shared () => T): Task<T> {
    assert(_async_on_worker(), "async.spawn: not inside async.run");
    var worker = _async_worker();
    var result = _TaskResult<T>();
    var proxy = worker._new_proxy();
    var task = Task<T>(proxy);
    proxy._on_complete = () => {
        task._run(() => {
            return result._take();
        });
    };
    _async_push(worker, proxy, () => {
        result._run(body);
    }, 0);
    return task;
}

# Queues `run` as the task that `proxy`, a stand-in on `worker`, stands for:
# on the shared queue (`worker_plus_one` 0) or pinned to the worker whose
# index is `worker_plus_one - 1`.
_async_push(worker: _Worker, proxy: _TaskCore, run: shared () => void, worker_plus_one: ulong) {
    var shared = _SharedTask(run, worker._index, proxy._id);
    proxy._shared = Optional<_SharedTask>.Value(shared);
    proxy._shared_cancelled = shared._cancelled;
    if (worker_plus_one == 0) {
        worker._runtime._push(shared);
    } else {
        worker._runtime._push_to(worker_plus_one - 1, shared);
    }
}

## Starts one task on every worker, each running `body`, and returns them in
## worker order. Use it to give each worker its own copy of a loop, such as
## a server's accept loop on an `io.SharedTcpListener`, so that every worker
## takes part. Each task runs on its own worker, the calling task's worker
## included; they are otherwise like tasks from `spawn`, and `body` must be
## a `shared` function.
##
## @param body the code each worker runs
## @returns one task per worker, the first on the first worker
## @panics outside `run`
## @example
##     import async;
##     import io;
##
##     main(): int {
##         async.run(() => {
##             var listener = io.SharedTcpListener.bind(io.SocketAddress.parse("0.0.0.0:7000").value()).value();
##             var loops = async.spawn_on_each_worker(() => {
##                 while (true) {
##                     var accepted = listener.accept();
##                     if (accepted.is_err()) {
##                         return;
##                     }
##                     var (stream, peer) = accepted.value();
##                     async.Task<void>.spawn_local(() => {
##                         stream.write_all("hello");
##                     });
##                 }
##             });
##             for (var loop in loops) {
##                 loop.join();
##             }
##         });
##         return 0;
##     }
export spawn_on_each_worker(body: shared () => void): Array<Task<void>> {
    assert(_async_on_worker(), "async.spawn_on_each_worker: not inside async.run");
    var worker = _async_worker();
    var tasks = Array<Task<void>>();
    var i: ulong = 0;
    while (i < worker._runtime._count) {
        var proxy = worker._new_proxy();
        tasks.append(Task<void>(proxy));
        _async_push(worker, proxy, body, i + 1);
        i = i + 1;
    }
    return tasks;
}

## Runs `body` on a separate thread and returns what it returns, parking
## the calling task meanwhile so the worker keeps running other tasks. Use it
## for work that would otherwise hold the worker up: a call that blocks in
## the operating system (reading a file, resolving a host name, a C library
## that waits) or a long computation.
##
## The runtime keeps a pool of threads for these calls, started as needed up
## to `RuntimeOptions.blocking_threads`. `body` runs on one of them, so it
## must be a `shared` function and `T` is constrained `Shared`, as for
## `spawn`.
## On a pool thread, sockets block the thread, and `sleep` and the other task
## functions behave as outside `run`.
##
## `body` always runs to the end: cancelling the calling task, or a `timeout`
## around the call expiring, takes effect once `run_blocking` has returned.
## Outside a task, `run_blocking` just calls `body`.
##
## @typeParam T the type of the body's result, which must be thread-safe
##   (`T: Shared`); `void` when there is none
## @param body the blocking code
## @returns what `body` returns
## @example
##     import async;
##
##     main(): int {
##         async.run(() => {
##             var ticker = async.Task<void>.spawn_local(() => {
##                 async.sleep(10);
##                 print("the worker kept running");
##             });
##             var answer = async.run_blocking<int>(() => {
##                 async.Thread.sleep(50);   # blocks a pool thread, not the worker
##                 return 42;
##             });
##             print(answer);
##             ticker.join();
##         });
##         return 0;
##     }
export run_blocking<T: Shared>(body: shared () => T): T {
    var result = _TaskResult<T>();
    if (!_async_on_worker() || !_async_worker()._running) {
        result._run(body);
        return result._value[0];
    }
    var worker = _async_worker();
    var me = worker._current;
    var proxy = worker._new_proxy();
    worker._start_blocking(_SharedTask(() => {
        result._run(body);
    }, worker._index, proxy._id));
    # Neither a cancel nor a deadline ends the wait: the body is running and
    # holds `result`.
    var deadline = me._deadline;
    me._deadline = 0;
    proxy._joiners.append(me);
    while (!proxy._finished) {
        worker._park();
    }
    me._deadline = deadline;
    # Read the slot rather than call `_take()`: `return` of a call is
    # rejected for `T = void`. The slot keeps its reference until `result`
    # goes, as a copy would.
    return result._value[0];
}

## Lets every other ready task run before the calling task continues. Does
## nothing outside a task.
export yield_now() {
    if (!_async_on_worker()) {
        return;
    }
    var worker = _async_worker();
    if (!worker._running) {
        return;
    }
    worker._ready.append(worker._current);
    _async_suspend(worker);
}

## Waits at least `milliseconds`. In a task, other tasks run meanwhile, and
## a cancelled task returns at once, as does one whose `timeout` expires
## first; outside a task, the thread sleeps.
##
## @param milliseconds how long to wait
export sleep(milliseconds: ulong) {
    _async_task_sleep(milliseconds);
}

## Waits at least `duration`, the same as `sleep(milliseconds)`. A duration
## that is not a whole number of milliseconds rounds up, so the wait is never
## shorter than asked.
##
## @param duration how long to wait
## @example
##     async.sleep(os.Duration.from_seconds(1));
export sleep(duration: os.Duration) {
    var milliseconds = duration.milliseconds();
    if (os.Duration.from_milliseconds(milliseconds) < duration) {
        milliseconds = milliseconds + 1;
    }
    _async_task_sleep(milliseconds);
}

# `sleep`, which `Thread.sleep` also calls in a task.
_async_task_sleep(milliseconds: ulong) {
    if (!_async_on_worker()) {
        _async_sys_sleep(milliseconds);
        return;
    }
    var worker = _async_worker();
    if (!worker._running) {
        _async_sys_sleep(milliseconds);
        return;
    }
    var me = worker._current;
    if (me._is_cancelled()) {
        return;
    }
    var until = _async_sys_monotonic_milliseconds() + milliseconds;
    if (me._deadline != 0 && me._deadline < until) {
        until = me._deadline;
    }
    worker._set_timer(me, until);
    me._parked = true;
    _async_suspend(worker);
    me._wait_sequence = 0;
}

## Returns whether the running task has been cancelled (see `Task.cancel`),
## so a long computation can stop early. False outside a task.
##
## @returns true when the running task was asked to stop
export is_cancelled(): bool {
    if (!_async_on_worker()) {
        return false;
    }
    var worker = _async_worker();
    if (!worker._running) {
        return false;
    }
    return worker._current._is_cancelled();
}

## A time limit on the waits inside a `with` block, made by `timeout`.
##
## While the block runs, a socket call that has to wait fails with an
## `IoError` for which `is_timed_out()` holds once the limit passes,
## `Task.join` fails with a `TaskError` for which `is_timed_out()` holds,
## and `sleep` returns early. Code that does not wait is never interrupted.
## Timeouts nest: an inner one cannot extend an outer one.
export struct Deadline {
    # When the limit passes, in monotonic milliseconds.
    var _at: ulong;
    # The task the block runs in, and its deadline before the block.
    var _core: _TaskCore;
    var _previous: ulong;
    var _entered: bool;

    ## Creates a limit `milliseconds` from now. Use `timeout` instead.
    ##
    ## @param milliseconds how long from now the limit passes
    construct(milliseconds: ulong) {
        this._at = _async_sys_monotonic_milliseconds() + milliseconds;
    }

    destruct {
        this.exit();
    }

    ## Starts applying the limit to the running task; a `with` block calls
    ## it.
    ##
    ## @returns this deadline
    ## @panics outside a task
    enter(): Deadline {
        assert(_async_on_worker() && _async_worker()._running, "async.timeout: not called from a task");
        var core = _async_worker()._current;
        this._core = core;
        this._previous = core._deadline;
        if (core._deadline == 0 || this._at < core._deadline) {
            core._deadline = this._at;
        }
        this._entered = true;
        return this;
    }

    ## Stops applying the limit; the end of the `with` block calls it.
    exit() {
        if (this._entered) {
            this._entered = false;
            this._core._deadline = this._previous;
        }
    }

    ## Returns whether the limit has passed.
    ##
    ## @returns true once the time is up
    is_expired(): bool {
        return _async_sys_monotonic_milliseconds() >= this._at;
    }
}

extend Deadline with Scoped<Deadline>;

## Returns a time limit for a `with` block: the waits inside it give up
## `milliseconds` from now (see `Deadline`).
##
## @param milliseconds how long the block's waits may take in all
## @returns the limit, for a `with` header
## @example
##     import async;
##     import io;
##
##     main(): int {
##         async.run(() => {
##             var listener = io.TcpListener.bind(io.SocketAddress.parse("127.0.0.1:0").value()).value();
##             with (var deadline = async.timeout(50)) {
##                 var accepted = listener.accept();   # nobody connects
##                 assert(accepted.error().is_timed_out(), "timed out");
##             }
##         });
##         return 0;
##     }
export timeout(milliseconds: ulong): Deadline {
    return Deadline(milliseconds);
}

## Returns the I/O backend the running runtime waits on sockets with (see
## `RuntimeOptions.backend`).
##
## @returns the backend; never `Backend.Automatic`
## @panics outside `run`
export current_backend(): Backend {
    assert(_async_on_worker(), "async.current_backend: not inside async.run");
    return _async_worker()._backend;
}
async/task_local
7877
## Per-task values: `TaskLocal<T>` gives every task its own copy of a
## variable.

# A task's values live in its `_TaskCore._locals` (task.pep), one malloc'd
# slot per variable it has set, found by the variable's `_id` and released
# when the task's body returns. Code outside any task (before `async.run`,
# or on a plain `Thread`) uses `_outside`, a `ThreadLocal<T>`, so it gets
# one value per thread, as with a `ThreadLocal`.
#
# The confinement rules are ThreadLocal's (see thread_local.pep): for a `T`
# that is not thread-safe, `get()` is a compile error and the value is
# reached through `with (var value = local.enter())`.

import "atomic";
import "sys_posix";
import "sys_wasi";
import "sys_windows";
import "task";
import "thread_local";

# Gives every TaskLocal its own id.
const _async_task_local_ids = Atomic<ulong>(1);

## A variable with a separate value in every task, the task counterpart of
## `ThreadLocal<T>`.
##
## Each task that calls `set` stores its own value, which is released when
## the task finishes. A task starts with no value, including one started by
## a task that has one: values are not inherited. Tasks that take turns on
## one worker thread each see their own value, which a `ThreadLocal` cannot
## give them.
##
## Code that does not run in a task (before `async.run`, or on a plain
## `Thread`) has one value per thread, as with a `ThreadLocal`.
##
## For a thread-safe `T` (a number, a `[Shared]` struct), `get` returns the
## calling task's value (the default of `T`, zero or null, until it sets
## one). For any other `T`, such as a `String`, the value is reached through
## a `with` block, `with (var value = local.enter()) { ... }`, and `get` is a
## compile error; `set` then takes a new value (a constructor call, a string
## literal, `copy(x)`).
##
## A `TaskLocal` is `[Shared]`, so one object can be used from every task
## and thread; it is usually a module-scope variable. Destroying one
## releases only the caller's value, so destroy it only after the tasks that
## used it have finished.
##
## @typeParam T the type of the per-task value
## @example
##     import async;
##
##     const request_id = async.TaskLocal<long>();
##
##     handle(id: long) {
##         request_id.set(id);
##         async.yield_now();   # the other tasks run meanwhile
##         assert(request_id.get() == id, "still this task's id");
##     }
##
##     main(): int {
##         async.run(() => {
##             var tasks = Array<async.Task<void>>();
##             for (var id in [1, 2, 3]) {
##                 tasks.append(async.spawn<void>(() => {
##                     handle(id);
##                 }));
##             }
##             for (var task in tasks) {
##                 task.join();
##             }
##         });
##         return 0;
##     }
## @see ThreadLocal
[Shared]
export struct TaskLocal<T> {
    # Identifies the variable in each task's list of values.
    const _id: ulong;
    # The value of code that does not run in a task, one per thread.
    const _outside: ThreadLocal<T>;

    ## Creates a task-local variable. No task has a value yet.
    ##
    ## @panics if the operating system has no thread-local keys left
    construct() {
        _id = _async_task_local_ids.fetch_add(1);
        _outside = ThreadLocal<T>();
    }

    destruct {
        if (_async_in_task()) {
            _async_task_local_clear(_id);
        }
    }

    # Releases the value in `slot` and frees it.
    static _release_slot(slot: __ptr<void>) {
        __ptr<T> value = slot;
        value[0] = __default<T>();
        _pep_free(slot);
    }

    # The caller's slot: the running task's, or the thread's outside a task;
    # null when it has no value.
    _slot(): __ptr<void> {
        if (_async_in_task()) {
            return _async_task_local_slot(_id);
        }
        return _outside._slot();
    }

    ## Returns the calling task's value.
    ##
    ## For a struct `T` the caller gets its own reference. Only for a
    ## thread-safe `T`: for any other `T`, use `with (var value =
    ## local.enter())`.
    ##
    ## @returns the value this task last stored, or the default of `T` (zero or null) if it has not stored one
    get(): T {
        __ptr<T> slot = this._slot();
        if (slot == __null) {
            return __default<T>();
        }
        return slot[0];
    }

    ## Stores `value` as the calling task's value, replacing (and, for a
    ## struct `T`, releasing) the one it held. Other tasks' values are not
    ## affected.
    ##
    ## For a `T` that is not thread-safe, `value` must be a new value (a
    ## constructor call, a string literal, `copy(x)`), which the compiler
    ## checks.
    ##
    ## @param value the new value for this task
    set([Move] value: T) {
        __ptr<T> slot = this._slot();
        if (slot == __null) {
            if (_async_in_task()) {
                # One stored T: see ThreadLocal.set.
                slot = _pep_malloc(sizeof<T>());
                __ptr<void> raw = slot;
                _async_task_local_add(_id, raw, () => {
                    TaskLocal<T>._release_slot(raw);
                });
            } else {
                slot = _outside._add_slot();
            }
        }
        slot[0] = value;
    }

    ## Returns the guard that a `with` block enters to reach the calling
    ## task's value: `with (var value = local.enter()) { ... }`. The body
    ## runs with the value bound; the `else` block runs when this task has
    ## no value (for a struct `T`).
    ##
    ## @returns the guard; its `enter()` returns this task's value
    ## @example
    ##     const trail = async.TaskLocal<Array<String>>();
    ##
    ##     note(step: String) {
    ##         if (!trail.is_set()) {
    ##             trail.set(Array<String>());
    ##         }
    ##         with (var steps = trail.enter()) {
    ##             steps.append(step.copy());
    ##         }
    ##     }
    enter(): TaskLocalGuard<T> {
        return TaskLocalGuard<T>(this);
    }

    ## Reports whether the calling task has stored a value since it started
    ## or last called `clear()`.
    ##
    ## @returns true if this task has a value
    is_set(): bool {
        return this._slot() != __null;
    }

    ## Removes the calling task's value, releasing it for a struct `T`.
    ## `get()` returns the default of `T` afterwards.
    clear() {
        if (_async_in_task()) {
            _async_task_local_clear(_id);
        } else {
            _outside.clear();
        }
    }
}

## The access to a task's `TaskLocal<T>` value that a `with` block holds:
## `enter()` returns the value. Get one from `TaskLocal.enter()`.
##
## A guard is `[Isolated]`: it can only be the scope of a `with` header, and
## the compiler checks the block with the confinement rule (see `Mutex`).
##
## @typeParam T the type of the per-task value
[Isolated]
export struct TaskLocalGuard<T> {
    # The task-local variable.
    const _local: TaskLocal<T>;

    ## Creates the guard for the calling task's value of `local`; the same as
    ## `local.enter()`.
    ##
    ## @param local the task-local variable
    construct(local: TaskLocal<T>) {
        _local = local;
    }

    ## Returns the calling task's value, for the `with` header to bind.
    ##
    ## @returns this task's value, or the default of `T` (null for a struct) when it has none
    enter(): T {
        __ptr<T> slot = _local._slot();
        if (slot == __null) {
            return __default<T>();
        }
        return slot[0];
    }

    ## Does nothing: the value stays with the task.
    exit() {}
}

extend TaskLocalGuard<T> with Scoped<T>;
async/thread
12217
## Threads: starting, naming, identifying and joining operating-system
## threads.

# A `Thread` is shared between the thread that spawned it (its handle) and
# the thread itself (`Thread.current()`), so it is `[Shared]`: atomic counts
# and only const, thread-safe fields. Its name is kept as a raw UTF-8 copy
# because a `String` field would not be thread-safe; `name()` returns a new
# String each time.
#
# Spawning hands the new thread one reference to its `Thread` through a
# malloc'd slot. The entry point (`_async_thread_main`, a C-callable function
# passed with `__function_pointer`) takes that reference, records it as the
# thread's current Thread, runs the body, and marks the thread finished.

import "atomic";
import "sys_posix";
import "sys_wasi";
import "sys_windows";
import "task";
import "thread_local";

extern void memcpy(void* dest, void* src, ulong n);

# Releases the calling thread's `[ThreadLocal]` variables that hold
# references. The compiler defines it in every program.
extern void _pep_release_thread_locals();

## Identifies a thread for as long as the program runs: every thread,
## whether started with `Thread.spawn` or not, gets a distinct id the first
## time it is asked for one, and ids are never reused.
##
## Ids are assigned by the runtime in the order threads ask for them, starting
## at 1; they are not the operating system's thread ids. A `ThreadId` is a
## number, so it can be compared, hashed and used as a `HashMap` key.
##
## @see Thread.id
export type ThreadId = ulong;

## The type of a thread's body: a function that takes no arguments and
## returns nothing. `Thread.spawn` runs one on a new thread.
##
## It is a `shared` function type, because the body runs on another thread:
## a named function, or a closure that captures only thread-safe values
## (numbers, `Atomic<T>`, `[Shared]` structs, other `shared` function
## values). A closure capturing a `String`, say, is a compile error.
##
## @see Thread.spawn
export type ThreadBody = shared () => void;

# The next id to hand out.
const _async_next_id = Atomic<ulong>(1);

# The current thread's `Thread`, set by the entry point of spawned threads and
# on first use by `Thread.current()` everywhere else.
const _async_current = ThreadLocal<Thread>();

# The operating system's identity of the thread that ran the program's
# initializers (the main thread), to name it "main" in `Thread.current()`.
const _async_main_os_thread = _async_sys_os_thread();

## An operating-system thread.
##
## Start one with `Thread.spawn`, which runs a function on a new thread and
## returns its `Thread`, and wait for it to finish with `join()`. Every
## thread, including the main thread, can get its own `Thread` with
## `Thread.current()`.
##
## A `Thread` is `[Shared]`: the thread that started it and the thread itself
## can both hold it. Dropping every reference without joining detaches the
## thread: it keeps running, and its resources are freed when it finishes.
##
## The body runs until it returns; there is no way to stop a thread from the
## outside. A `panic` or failed `assert` on any thread ends the whole program.
##
## @example
##     import async;
##
##     const total = Atomic<long>(0);
##
##     add_ten() {
##         total.fetch_add(10);
##     }
##
##     main(): int {
##         var a = async.Thread.spawn(add_ten, "adder a");
##         var b = async.Thread.spawn(add_ten, "adder b");
##         a.join();
##         b.join();
##         assert(total.load() == 20, "both threads ran");
##         return 0;
##     }
[Shared]
export struct Thread {
    # The thread's id.
    const _id: ThreadId;

    # The name's UTF-8 bytes, NUL-terminated, or null for an unnamed thread.
    const _name_data: __ptr<char>;

    # The name's size in bytes.
    const _name_size: ulong;

    # The name's length in code points.
    const _name_length: ulong;

    # The function the thread runs (a no-op for a thread that was not
    # started by `spawn`, such as the main thread).
    const _body: ThreadBody;

    # The operating-system handle while the thread can still be joined or
    # detached (a `pthread_t` or a Windows `HANDLE`), else null.
    const _handle: Atomic<__ptr<void>>;

    # 1 once the body has returned, else 0.
    const _finished: Atomic<int>;

    ## Creates a `Thread` value for a thread that is already running. Programs
    ## get threads from `spawn` and `current()` instead; a `Thread` made
    ## directly is not attached to any thread and cannot be joined.
    ##
    ## @param name the thread's name; empty for an unnamed thread
    ## @param body the function the thread runs
    construct(name: String, body: ThreadBody) {
        _id = _async_next_id.fetch_add(1);
        _name_size = name.size;
        _name_length = name.length;
        if (_name_size > 0) {
            _name_data = _pep_malloc(_name_size + 1);
            memcpy(_name_data, name.c_str(), _name_size);
        }
        _body = body;
        _handle = Atomic<__ptr<void>>(__null);
        _finished = Atomic<int>(0);
    }

    destruct {
        # Dropped without join(): let the thread run on and free itself.
        var handle = _handle.exchange(__null);
        if (handle != __null) {
            _async_sys_detach(handle);
        }
        _pep_free(_name_data);
    }

    ## Starts a new thread that runs `body`.
    ##
    ## The new thread starts right away and runs until `body` returns. Its
    ## `Thread.current()` is the `Thread` returned here.
    ##
    ## The stack the operating system gives a thread by default differs:
    ## usually 8 MiB on Linux (`ulimit -s`), 1 MiB on Windows, and 512 KiB
    ## on macOS. A thread that recurses deeply, such as one walking a
    ## deeply nested tree, passes `stack_size` to get the same stack
    ## everywhere. The stack is reserved address space; memory is used
    ## only as the thread reaches it.
    ##
    ## @param body the function to run on the new thread
    ## @param name a name for the thread, returned by `name()`; empty by default
    ## @param stack_size the bytes of stack the thread gets, rounded up to 64 KiB; 0, the default, for the system's default
    ## @returns the new thread, to `join()` or query
    ## @panics if the operating system cannot create another thread, or refuses `stack_size`
    ## @example
    ##     var worker = Thread.spawn(do_work, "worker");
    ##     worker.join();
    ##     var deep = Thread.spawn(walk_tree, "walker", 8388608);   # 8 MiB
    ##     deep.join();
    static spawn(body: ThreadBody, name: String = "", stack_size: ulong = 0): Thread {
        var thread = Thread(name, body);
        # The new thread's own reference, which its entry point takes over.
        __ptr<Thread> start = _pep_malloc(8);
        start[0] = thread;
        var handle = _async_sys_spawn(__function_pointer(_async_thread_main), start, stack_size);
        if (handle == __null) {
            start[0] = __default<Thread>();
            _pep_free(start);
            panic("Thread.spawn: the operating system could not create a thread");
        }
        thread._handle.store(handle);
        return thread;
    }

    ## Returns the `Thread` of the thread that calls it.
    ##
    ## For a thread started with `spawn` this is the `Thread` that `spawn`
    ## returned. Any other thread (the main thread, or one started by C code)
    ## gets a `Thread` the first time it asks and the same one afterwards; the
    ## main thread's is named `main`, the others are unnamed. Such a `Thread`
    ## cannot be joined.
    ##
    ## @returns the calling thread
    ## @example
    ##     var me = Thread.current();
    ##     print(me.name(), "\n");   # "main" on the main thread
    static current(): Thread {
        var thread = _async_current.get();
        if (thread !== __null) {
            return thread;
        }
        var name = "";
        if (_async_sys_os_thread() == _async_main_os_thread) {
            name = "main";
        }
        # Never spawned: nothing to join, and the body is never run.
        var adopted = Thread(name, _async_no_body);
        _async_current.set(adopted);
        return adopted;
    }

    ## Pauses the calling thread for at least `milliseconds` milliseconds.
    ##
    ## The operating system may sleep longer, but never shorter. In a task
    ## (see `run`), it is `async.sleep`: the task waits and its worker thread
    ## runs other tasks, and a cancel or the task's `timeout` ends the wait
    ## early.
    ##
    ## @param milliseconds how long to sleep; 0 returns right away
    static sleep(milliseconds: ulong) {
        if (milliseconds == 0) {
            return;
        }
        if (_async_in_task()) {
            _async_task_sleep(milliseconds);
            return;
        }
        _async_sys_sleep(milliseconds);
    }

    ## Returns the thread's id, which no other thread in the program has.
    ##
    ## @returns the thread's id
    id(): ThreadId {
        return _id;
    }

    ## Returns the name the thread was given.
    ##
    ## @returns the name passed to `spawn`, `main` for the main thread, or an empty String for an unnamed thread
    name(): String {
        if (_name_size == 0) {
            return String();
        }
        return String(_name_data, _name_size, _name_length);
    }

    ## Reports whether the thread's body has returned.
    ##
    ## A thread that is not finished may finish at any moment, so a `false`
    ## result can be out of date by the time it is used. Always false for a
    ## `Thread` that was not started by `spawn`.
    ##
    ## @returns true once the body has returned
    is_finished(): bool {
        return _finished.load() == 1;
    }

    ## Reports whether `join()` can be called: the thread was started by
    ## `spawn` and has not been joined yet.
    ##
    ## @returns true if the thread can be joined
    is_joinable(): bool {
        return _handle.load() != __null;
    }

    ## Waits for the thread's body to return.
    ##
    ## Returns right away if it already has. A thread can be joined once; a
    ## `Thread` from `current()` for a thread not started by `spawn` cannot be
    ## joined at all. Everything the thread did before it finished is visible
    ## to the caller after `join()` returns.
    ##
    ## @panics if the thread cannot be joined (see `is_joinable()`), or if a thread tries to join itself
    join() {
        if (_id == Thread.current().id()) {
            panic("Thread.join: a thread cannot join itself");
        }
        var handle = _handle.exchange(__null);
        if (handle == __null) {
            panic("Thread.join: the thread was already joined, or was not started by Thread.spawn");
        }
        _async_sys_join(handle);
    }
}

# The body of a Thread that `current()` made for a thread it did not spawn.
_async_no_body() {}

# Runs a spawned thread: `start` is the slot holding the thread's own
# reference to its Thread (see `spawn`).
_async_thread_run(start: __ptr<void>) {
    __ptr<Thread> slot = start;
    Thread thread = slot[0];
    slot[0] = __default<Thread>();
    _pep_free(slot);
    _async_current.set(thread);
    _pep_stack_guard_thread_start();
    thread._body();
    thread._finished.store(1);
    _pep_stack_guard_thread_end();
    # The thread's free small blocks go back for other threads to use.
    _pep_small_thread_exit();
}

# The C entry point of a spawned thread: `void* (*)(void*)` for pthreads, and
# `DWORD (WINAPI *)(void*)` on Windows. After the body, and the references
# `_async_thread_run` held, it releases the thread's thread-locals.
[Target(!OS(Windows))]
_async_thread_main(start: __ptr<void>): __ptr<void> {
    _async_thread_run(start);
    _pep_release_thread_locals();
    return __null;
}

[Target(OS(Windows))]
_async_thread_main(start: __ptr<void>): uint {
    _async_thread_run(start);
    _pep_release_thread_locals();
    return 0;
}
async/thread_local
13190
## Per-thread values: `ThreadLocal<T>` gives every thread its own copy of a
## variable.

# Each ThreadLocal has an index, given out once from `_thread_local_indexes`
# and never reused. A thread's values live in a table of its own, held in
# native `[ThreadLocal]` variables: `_thread_local_slots[index]`
# points at a malloc'd slot, `sizeof<T>()` bytes for a POD `T`, one reference
# for a struct `T`, or is null where the thread has no value. So `get()` is a
# thread-local load, a bounds check and two loads, with no call into the
# operating system (it used to be a `pthread_getspecific` or `FlsGetValue`
# call per access), and there is no limit on how many exist.
#
# `_thread_local_releases[index]` is the function that releases the slot
# (`ThreadLocal<T>._release_slot`), stored with it, since the code that
# empties a thread's table at its exit does not know `T`. That code is the
# destructor of `_ThreadLocalTable`, a `[Shared]` struct that one
# reference-typed thread-local holds while the thread has any value: the
# compiler releases it when a thread started with `Thread.spawn` exits
# (`_pep_release_thread_locals`), and `clear()` releases it when the thread's
# last value goes, which frees the table.
#
# For a `T` that is not thread-safe, a thread's value is reached only through
# `with (var value = local.enter())`: `ThreadLocalGuard` is `[Isolated]`, so
# `check_confinement` (sema/confinement.pep) keeps references into the value inside the
# block, `get()` is a compile error, and `set` takes a new value (`[Move]`).
# Otherwise a function called under a lock could park part of the locked
# value in a thread-local, and a later `get()` would hand it out after the
# lock is released.

import "atomic";

# The tables come from the C allocator, not `_pep_malloc`: like the
# operating system's own key tables they are bookkeeping, not values, so a
# test's allocation count does not see the main thread's.
extern void* realloc(void* p, ulong size);
extern void free(void* p);
extern void memset(void* p, int c, ulong n);

# Releases the value in a thread's slot and frees the slot: a ThreadLocal's
# `_release_slot`.
type _SlotRelease = shared (__ptr<void>) => void;

# Gives every ThreadLocal its index.
const _thread_local_indexes = Atomic<ulong>(0);

# The calling thread's slots, by ThreadLocal index; null where it has no
# value.
[ThreadLocal]
var _thread_local_slots: __ptr<__ptr<void>>;

# The function that releases each of the calling thread's slots.
[ThreadLocal]
var _thread_local_releases: __ptr<_SlotRelease>;

# How many entries the calling thread's tables have room for.
[ThreadLocal]
var _thread_local_capacity: ulong = 0;

# How many of the calling thread's slots hold a value.
[ThreadLocal]
var _thread_local_count: ulong = 0;

# Held while the calling thread has a value: its release empties the table.
[ThreadLocal]
var _thread_local_table: _ThreadLocalTable;

# Owns the calling thread's table of ThreadLocal values: destroying it
# releases every value left in it and frees it. It runs on the thread whose
# table it is, at its exit or when its last value is cleared.
[Shared]
struct _ThreadLocalTable {
    construct() {}

    destruct {
        var slots = _thread_local_slots;
        var releases = _thread_local_releases;
        var capacity = _thread_local_capacity;
        # A release below may store a new value on this thread: it starts a
        # new table, which the thread's exit releases in turn.
        _thread_local_slots = __null;
        _thread_local_releases = __null;
        _thread_local_capacity = 0;
        _thread_local_count = 0;
        var index: ulong = 0;
        while (index < capacity) {
            var slot = slots[index];
            if (slot != __null) {
                var release = releases[index];
                release(slot);
            }
            releases[index] = __default<_SlotRelease>();
            index += 1;
        }
        free(slots);
        free(releases);
    }
}

# The calling thread's slot for the ThreadLocal at `index`, or null.
_thread_local_slot(index: ulong): __ptr<void> {
    if (index < _thread_local_capacity) {
        return _thread_local_slots[index];
    }
    return __null;
}

# A new zeroed slot of `size` bytes for the ThreadLocal at `index` on the
# calling thread, which `release` will release: grows the thread's table to
# hold `index` and starts one if the thread has none.
_thread_local_add(index: ulong, size: ulong, release: _SlotRelease): __ptr<void> {
    if (index >= _thread_local_capacity) {
        var capacity: ulong = _thread_local_capacity * 2;
        if (capacity < 8) {
            capacity = 8;
        }
        if (capacity <= index) {
            capacity = index + 1;
        }
        _thread_local_slots = _thread_local_grow(_thread_local_slots, _thread_local_capacity * 8, capacity * 8);
        _thread_local_releases = _thread_local_grow(
            _thread_local_releases, _thread_local_capacity * sizeof<_SlotRelease>(), capacity * sizeof<_SlotRelease>()
        );
        _thread_local_capacity = capacity;
    }
    if (_thread_local_count == 0 && _thread_local_table === __null) {
        _thread_local_table = _ThreadLocalTable();
    }
    var slot = _pep_malloc(size);
    _thread_local_slots[index] = slot;
    _thread_local_releases[index] = release;
    _thread_local_count += 1;
    return slot;
}

# `table`, of `size` bytes, grown to `new_size` bytes with the new part
# zeroed.
_thread_local_grow(table: __ptr<void>, size: ulong, new_size: ulong): __ptr<void> {
    var grown = realloc(table, new_size);
    if (grown == __null) {
        panic("ThreadLocal: out of memory");
    }
    memset(grown + size, 0, new_size - size);
    return grown;
}

# Takes the calling thread's slot for the ThreadLocal at `index` out of its
# table: null when it has none. The caller releases the slot, then calls
# `_thread_local_removed`.
_thread_local_take(index: ulong): __ptr<void> {
    var slot = _thread_local_slot(index);
    if (slot != __null) {
        _thread_local_slots[index] = __null;
        _thread_local_releases[index] = __default<_SlotRelease>();
        _thread_local_count -= 1;
    }
    return slot;
}

# After a slot taken from the table is released: frees the table when the
# thread has no value left.
_thread_local_removed() {
    if (_thread_local_count == 0) {
        _thread_local_table = __default<_ThreadLocalTable>();
    }
}

## A variable with a separate value on every thread, like C++
## `thread_local` or Rust's `thread_local!`.
##
## Each thread that calls `set` stores its own value. When a thread exits, its
## value is released.
##
## For a thread-safe `T` (a number, a `[Shared]` struct), `get` returns the
## calling thread's value (the default of `T`, zero or null, until that thread
## sets one). For any other `T`, such as a `String`, the value is reached
## through a `with` block, `with (var value = local.enter()) { ... }`, and
## `get` is a compile error; `set` then takes a new value (a constructor call,
## a string literal, `copy(x)`). Inside the block the value is kept apart
## from the rest of the program, as for a `Mutex`.
##
## A `ThreadLocal` is `[Shared]`, so one object can be used from every
## thread; it is usually a module-scope variable. `T` does not have to be
## thread-safe, because each value stays on the thread that stored it.
##
## Destroying a `ThreadLocal` releases the calling thread's value; values
## that other threads still hold are released when those threads exit.
##
## A thread's values are released when it exits if `Thread.spawn` started
## it (the `async` runtime's workers too). The main thread's are released
## only by `clear()`, and a thread started by C code leaks the values it did
## not clear.
##
## @typeParam T the type of the per-thread value
## @example
##     import async;
##
##     const calls = async.ThreadLocal<int>();
##
##     count_call() {
##         calls.set(calls.get() + 1);
##     }
##
##     main(): int {
##         count_call();
##         count_call();
##         assert(calls.get() == 2, "two calls on this thread");
##         return 0;
##     }
[Shared]
export struct ThreadLocal<T> {
    # The index of this variable's slot in every thread's table.
    const _index: ulong;

    ## Creates a thread-local variable. No thread has a value yet.
    construct() {
        _index = _thread_local_indexes.fetch_add(1);
    }

    destruct {
        this.clear();
    }

    # Releases the value in `slot` and frees it: the slot's release
    # function, which `_ThreadLocalTable` calls for each value a thread
    # still holds when it exits.
    static _release_slot(slot: __ptr<void>) {
        __ptr<T> value = slot;
        value[0] = __default<T>();
        _pep_free(slot);
    }

    ## Returns the calling thread's value.
    ##
    ## For a struct `T` the caller gets its own reference. Only for a
    ## thread-safe `T`: for any other `T`, use `with (var value =
    ## local.enter())`.
    ##
    ## @returns the value this thread last stored, or the default of `T` (zero or null) if it has not stored one
    get(): T {
        __ptr<T> slot = _thread_local_slot(_index);
        if (slot == __null) {
            return __default<T>();
        }
        return slot[0];
    }

    ## Stores `value` as the calling thread's value, replacing (and, for a
    ## struct `T`, releasing) the one it held. Other threads' values are not
    ## affected.
    ##
    ## For a `T` that is not thread-safe, `value` must be a new value (a
    ## constructor call, a string literal, `copy(x)`), which the compiler
    ## checks.
    ##
    ## @param value the new value for this thread
    set([Move] value: T) {
        __ptr<T> slot = _thread_local_slot(_index);
        if (slot == __null) {
            slot = this._add_slot();
        }
        slot[0] = value;
    }

    # A new, empty slot for the calling thread's value, in its table.
    _add_slot(): __ptr<void> {
        # sizeof<T>() is the size of a stored T: one pointer for a struct,
        # two for a trait value (object and vtable), the value itself for a
        # number.
        return _thread_local_add(_index, sizeof<T>(), _release_slot);
    }

    # The calling thread's slot, or null when it has no value.
    _slot(): __ptr<void> {
        return _thread_local_slot(_index);
    }

    ## Returns the guard that a `with` block enters to reach the calling
    ## thread's value: `with (var value = local.enter()) { ... }`. The body
    ## runs with the value bound; the `else` block runs when this thread has
    ## no value (for a struct `T`).
    ##
    ## @returns the guard; its `enter()` returns this thread's value
    ## @example
    ##     const names = async.ThreadLocal<Array<String>>();
    ##
    ##     remember(String name) {
    ##         if (!names.is_set()) {
    ##             names.set(Array<String>());
    ##         }
    ##         with (var list = names.enter()) {
    ##             list.append(name.copy());
    ##         }
    ##     }
    enter(): ThreadLocalGuard<T> {
        return ThreadLocalGuard<T>(this);
    }

    ## Reports whether the calling thread has stored a value since it started
    ## or last called `clear()`.
    ##
    ## @returns true if this thread has a value
    is_set(): bool {
        return _thread_local_slot(_index) != __null;
    }

    ## Removes the calling thread's value, releasing it for a struct `T`.
    ## `get()` returns the default of `T` afterwards.
    clear() {
        var slot = _thread_local_take(_index);
        if (slot != __null) {
            ThreadLocal<T>._release_slot(slot);
            _thread_local_removed();
        }
    }
}

## The access to a thread's `ThreadLocal<T>` value that a `with` block holds:
## `enter()` returns the value. Get one from `ThreadLocal.enter()`.
##
## A guard is `[Isolated]`: it can only be the scope of a `with` header, and
## the compiler checks the block with the confinement rule (see `Mutex`).
##
## @typeParam T the type of the per-thread value
[Isolated]
export struct ThreadLocalGuard<T> {
    # The thread-local variable.
    const _local: ThreadLocal<T>;

    ## Creates the guard for the calling thread's value of `local`; the same
    ## as `local.enter()`.
    ##
    ## @param local the thread-local variable
    construct(local: ThreadLocal<T>) {
        _local = local;
    }

    ## Returns the calling thread's value, for the `with` header to bind.
    ##
    ## @returns this thread's value, or the default of `T` (null for a struct) when it has none
    enter(): T {
        __ptr<T> slot = _local._slot();
        if (slot == __null) {
            return __default<T>();
        }
        return slot[0];
    }

    ## Does nothing: the value stays with the thread.
    exit() {}
}

extend ThreadLocalGuard<T> with Scoped<T>;
async/workers
11800
# Several workers: what the worker threads of one `run` share.
#
# `run` starts `RuntimeOptions.workers` workers: the calling thread and one
# `Thread` for each of the rest. Each worker is a `_Worker` (task.pep) on its
# own thread, with its own tasks, timers and driver. A started task never
# leaves its worker, so tasks on one worker still share values with plain
# reference counts. What crosses threads is only thread-safe:
#
# - `_Runtime`, shared by every worker: the inbox of each, the queue of
#   tasks from `spawn` that no worker has started yet, and the stop flag.
# - `_Inbox`, one per worker: messages from other workers (a
#   `Channel<ulong>` of `id * 4 + kind`: a task spawned here finished
#   elsewhere, a task running here was cancelled elsewhere, or a task
#   parked here on a sync object was woken elsewhere), tasks from
#   `spawn_on_each_worker` that must run on this worker, and the worker's
#   doorbell, which ends its wait in the driver.
# - `_SharedTask`, one per `spawn`: the body, where to report when it
#   finishes (the spawning worker and the stand-in task there that `join`
#   waits on), which worker runs it once one does, and its cancel flag.
# - `_TaskResult<T>`, the result of a spawned task, which the running worker
#   stores and the spawning worker takes. It is `[Shared]` so that `T` must
#   be thread-safe.
#
# Any idle worker takes the next task from the shared queue, so an idle
# worker takes on unstarted work from a busy one; a task, once started,
# stays where it started.
#
# Waking a sleeping worker: a worker about to block in its driver sets
# `_sleeping`, clears `_notified`, and looks at its inbox, the shared queue
# and the stop flag once more before it blocks. A sender puts the message in
# the inbox first and then rings the doorbell unless `_notified` was already
# set; a ring is remembered until the next wait. So a message is either seen
# by that last look or ends the wait.
#
# Blocking calls: `run_blocking` hands its body to a pool of plain threads
# that the runtime starts as needed, up to `RuntimeOptions.blocking_threads`,
# and parks the calling task. A pool thread runs the body and sends the
# calling worker a `_Message.Complete` for the task's stand-in, as a worker
# running a spawned task does. Pool threads wait for more work until the
# runtime ends.
#
# Stopping: when the first task returns, its worker sets `_stopping` and
# rings every worker. Each worker cancels its tasks, keeps running until
# none remain (tasks started from then on start cancelled), and then waits
# until every worker is done before it closes its driver, so no ring ever
# reaches a closed handle.

import "atomic";
import "channel";
import "driver";
import "sys_posix";
import "sys_wasi";
import "sys_windows";
import "task";

# What a message tells a worker about one of its tasks. `Wake`: a task
# parked on a `Mutex`, `Condition` or `Channel` here was woken (see
# sync_wait.pep). Messages travel packed in a `ulong` (`_Inbox._send`).
enum _Message: ulong {
    Complete,
    Cancel,
    Wake,
}

# The task id and kind packed in an inbox message.
_async_unpack_message(message: ulong): (id: ulong, kind: _Message) {
    var id = message / 4;
    match (message % 4) {
        0 => {
            return (id, _Message.Complete);
        }
        1 => {
            return (id, _Message.Cancel);
        }
        else => {
            return (id, _Message.Wake);
        }
    }
    return (id, _Message.Wake);
}

# Gives every inbox its own id.
const _async_inbox_ids = Atomic<ulong>(1);

# Messages to one worker, and its doorbell.
[Shared]
struct _Inbox {
    # Unique among inboxes, so a waker can tell whether a task waits on its
    # own worker.
    const _id: ulong;
    # `id * 4 + kind` (a `_Message`) for each message; a `ulong` rather
    # than a tuple keeps the channel's slots plain words.
    const _messages: Channel<ulong>;
    # Spawned tasks that must run on this worker.
    const _pinned: Channel<_SharedTask>;
    # 1 once the doorbell was rung since the worker last prepared to block.
    const _notified: Atomic<int>;
    # 1 while the worker is about to block or blocks in its driver.
    const _sleeping: Atomic<int>;
    const _doorbell: _Doorbell;

    construct(doorbell: _Doorbell) {
        _id = _async_inbox_ids.fetch_add(1);
        _messages = Channel<ulong>();
        _pinned = Channel<_SharedTask>();
        _notified = Atomic<int>(0);
        _sleeping = Atomic<int>(0);
        _doorbell = doorbell;
    }

    # Sends the worker `kind` about its task `id`.
    _send(id: ulong, kind: _Message) {
        _messages.send(id * 4 + (kind as ulong));
        _ring();
    }

    # Ends the worker's wait, unless a ring is already pending.
    _ring() {
        if (_notified.exchange(1) == 0) {
            _doorbell._ring();
        }
    }
}

# A task from `spawn`, which any worker may run.
[Shared]
struct _SharedTask {
    # Runs the body and stores its result.
    const _body: shared () => void;
    # The worker that spawned it, and the id there of the stand-in task that
    # finishes when this one does.
    const _owner: ulong;
    const _proxy: ulong;
    # The worker running it plus 1 (0 until one starts it), and the task's
    # id there. The id is stored first.
    const _runner_worker: Atomic<ulong>;
    const _runner_id: Atomic<ulong>;
    # 1 once cancelled.
    const _cancelled: Atomic<int>;

    construct(body: shared () => void, owner: ulong, proxy: ulong) {
        _body = body;
        _owner = owner;
        _proxy = proxy;
        _runner_worker = Atomic<ulong>(0);
        _runner_id = Atomic<ulong>(0);
        _cancelled = Atomic<int>(0);
    }

    # Asks the task to stop, telling the worker running it if one is.
    _cancel(runtime: _Runtime) {
        _cancelled.store(1);
        var worker = _runner_worker.load();
        if (worker != 0) {
            runtime._inbox(worker - 1)._send(_runner_id.load(), _Message.Cancel);
        }
    }
}

# The result of a spawned task: stored on the worker that runs it, taken on
# the worker that spawned it.
[Shared]
struct _TaskResult<T: Shared> {
    # A heap slot for the value (one reference for a struct `T`).
    const _value: __ptr<T>;

    construct() {
        _value = _pep_malloc(sizeof<T>() + 8);
        _async_zero(_value, sizeof<T>() + 8);
    }

    destruct {
        _value[0] = __default<T>();
        _pep_free(_value);
    }

    # Runs `body` and stores what it returns.
    _run(body: shared () => T) {
        _value[0] = body();
    }

    # Takes the stored value out.
    _take(): T {
        var value = _value[0];
        _value[0] = __default<T>();
        return value;
    }
}

# What the workers of one `run` share.
[Shared]
struct _Runtime {
    # How many workers.
    const _count: ulong;
    # Each worker's inbox, stored by the worker when it starts.
    const _inboxes: __ptr<_Inbox>;
    # How many workers have stored their inbox.
    const _started: Atomic<ulong>;
    # Tasks from `spawn` that no worker has started.
    const _queue: Channel<_SharedTask>;
    # 1 once the first task has returned.
    const _stopping: Atomic<int>;
    # How many workers are still running tasks.
    const _active: Atomic<ulong>;
    # Bodies from `run_blocking` for the pool threads.
    const _blocking: Channel<_SharedTask>;
    # How many pool threads are waiting for a body, and how many there are,
    # at most `_blocking_limit`.
    const _blocking_idle: Atomic<ulong>;
    const _blocking_threads: Atomic<ulong>;
    const _blocking_limit: ulong;

    construct(count: ulong, blocking_limit: ulong) {
        _count = count;
        _inboxes = _pep_malloc(count * 8);
        _async_zero(_inboxes, count * 8);
        _started = Atomic<ulong>(0);
        _queue = Channel<_SharedTask>();
        _stopping = Atomic<int>(0);
        _active = Atomic<ulong>(count);
        _blocking = Channel<_SharedTask>();
        _blocking_idle = Atomic<ulong>(0);
        _blocking_threads = Atomic<ulong>(0);
        _blocking_limit = blocking_limit;
    }

    destruct {
        var i: ulong = 0;
        while (i < _count) {
            _inboxes[i] = __default<_Inbox>();
            i = i + 1;
        }
        _pep_free(_inboxes);
    }

    # Worker `index` stores its inbox, then waits until every worker has.
    _join(index: ulong, inbox: _Inbox) {
        _inboxes[index] = inbox;
        _started.fetch_add(1);
        while (_started.load() < _count) {
            _async_sys_sleep(1);
        }
    }

    _inbox(index: ulong): _Inbox {
        return _inboxes[index];
    }

    # Queues a spawned task and wakes one sleeping worker to take it (one
    # not already woken).
    _push(task: _SharedTask) {
        _queue.send(task);
        var i: ulong = 0;
        while (i < _count) {
            var inbox = _inboxes[i];
            if (inbox._sleeping.load() != 0 && inbox._notified.load() == 0) {
                inbox._ring();
                return;
            }
            i = i + 1;
        }
    }

    # Queues a spawned task that must run on worker `index`, and wakes it.
    _push_to(index: ulong, task: _SharedTask) {
        var inbox = _inboxes[index];
        inbox._pinned.send(task);
        inbox._ring();
    }

    # Tells every worker to stop.
    _stop() {
        _stopping.store(1);
        var i: ulong = 0;
        while (i < _count) {
            _inboxes[i]._ring();
            i = i + 1;
        }
    }

    # Queues a body from `run_blocking` for the pool. Returns true when no
    # pool thread is idle and there is room for another, which the caller
    # then starts (see `_async_blocking_main`).
    _block(job: _SharedTask): bool {
        _blocking.send(job);
        while (true) {
            var idle = _blocking_idle.load();
            if (idle == 0) {
                break;
            }
            if (_blocking_idle.compare_exchange(idle, idle - 1)) {
                return false;
            }
        }
        while (true) {
            var started = _blocking_threads.load();
            if (started >= _blocking_limit) {
                return false;
            }
            if (_blocking_threads.compare_exchange(started, started + 1)) {
                return true;
            }
        }
        return false;
    }

    # A worker has run its last task: waits until every worker has. A task
    # pinned to it meanwhile (by a worker still running) goes to the shared
    # queue, where a running worker takes it.
    _leave(inbox: _Inbox) {
        _active.fetch_sub(1);
        while (_active.load() > 0) {
            var late = inbox._pinned._try_take();
            if (late.0) {
                _push(late.1);
            } else {
                _async_sys_sleep(1);
            }
        }
    }
}

# The loop of a pool thread: runs bodies from `run_blocking` and reports
# each to the worker that queued it, until the runtime closes the queue.
_async_blocking_main(runtime: _Runtime) {
    while (true) {
        var next = runtime._blocking.receive();
        if (next.is_err()) {
            return;
        }
        var job = next.value();
        job._body();
        runtime._inbox(job._owner)._send(job._proxy, _Message.Complete);
        runtime._blocking_idle.fetch_add(1);
    }
}

extern void memset(void* p, int c, ulong n);

# Zeroes `size` bytes at `memory`.
_async_zero(memory: __ptr<void>, size: ulong) {
    memset(memory, 0, size);
}
