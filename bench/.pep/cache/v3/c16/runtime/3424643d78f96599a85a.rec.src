# How a socket waits until it can make progress: the seam between the
# sockets here and the task runtime in the `async` module.
#
# Sockets are non-blocking. When a call would block, the socket waits for
# the handle to become ready and tries again (`_io_socket_wait`). Outside a
# task that wait is poll() / WSAPoll(), which blocks the thread. Inside a
# task it is the runtime's `_IoWaiter`, which parks the task and lets the
# others run until the handle is ready.
#
# A Watcher (watch.pep) waits the same way: on Linux and macOS its inotify
# or kqueue descriptor is waited on for readability like a socket; on
# Windows its ReadDirectoryChangesW request goes to the runtime whole
# (`_IoWaiter._directory_changes`), like a socket transfer.
#
# Files have no readiness to wait for, so a file read or write in a task
# goes to the runtime whole (`_IoWaiter._file_transfer`): it runs the
# system call where it cannot block the worker (on io_uring, or on a pool
# thread) and parks the task until it is done. The caller pins the array it
# reads into or writes from (`Array._pins`) for that time.
#
# With io_uring, a stream socket's reads and writes in a task go to the
# runtime whole too (`_IoWaiter._socket_transfer`): the kernel does the
# receive or send itself when the socket is ready, and the worker submits
# many of them in one system call, rather than learning readiness and then
# calling `recv` or `send`. The other backends decline, and the socket
# waits for readiness as above.
#
# A socket may have a read and a write timeout (`set_read_timeout`,
# `set_write_timeout`): each wait for readiness then ends after that many
# milliseconds with a timed-out error, in a task (by lowering the task's
# deadline for the wait) and outside one (poll's timeout). The timeouts are
# kept by handle in `_io_socket_timeouts`, so every layer that waits on a
# socket, TLS's included, sees them without passing them down.
#
# `async` imports `io` (its sockets and errors), so `io` cannot import
# `async`. Instead `async.run` registers its worker as this thread's
# `_IoWaiter`, and the sockets find it through a thread-local. These
# names are exported from the module for `async` only; they are not part of
# the public API.

import async;
import "socket";
import "socket_posix";
import "socket_wasi";
import "socket_windows";
import "sys_posix";
import "sys_windows";
import "types";

# What a socket waits for.
export const _IO_READABLE = 1;
export const _IO_WRITABLE = 2;

# What `_IoWaiter._wait_ready` returns.
export enum _IoWait {
    Ready,
    Cancelled,
    TimedOut,
    Unwatched,
}

# The task runtime running on this thread, as the sockets see it.
export trait _IoWaiter {
    # Whether the calling code runs in a task (rather than in the runtime's
    # own loop, where nothing can park).
    _in_task(): bool;

    # Parks the running task until `handle` may be ready for `interest`
    # (`_IO_READABLE` or `_IO_WRITABLE`), and returns `Ready`; or returns
    # `Cancelled` or `TimedOut` when the task is cancelled, or its timeout
    # or `timeout` milliseconds (0 for none) expire first, or `Unwatched`
    # when the runtime cannot watch `handle` (the caller then blocks the
    # thread instead). Readiness is a hint: the caller tries the call again
    # and waits again if it would still block.
    _wait_ready(handle: SocketHandle, interest: int, timeout: ulong): _IoWait;

    # `handle` is about to be closed: forget it, and wake any task waiting
    # on it.
    _forget(handle: SocketHandle);

    # `handle` stays open but is moving to another thread: stop watching
    # it, and wake any task waiting on it.
    _release(handle: SocketHandle);

    # Stops watching `handle` if no task on this thread waits on it. For a
    # socket several threads wait on, which may be closed on any of them
    # (see `SharedTcpListener`): a thread watches it only while it waits.
    _release_idle(handle: SocketHandle);

    # Runs `transfer` without blocking the worker and returns what
    # `transfer._run()` would. Neither a cancel nor a timeout ends it: the
    # system is using the buffer until it returns. (It takes a struct
    # because a `__ptr` parameter in a trait method does not compile yet.)
    _file_transfer(transfer: _FileTransfer): long;

    # Receives up to `count` bytes on the stream socket `handle` into the
    # memory at address `buffer`, or sends them from it when `write`,
    # parking the task until the kernel has done it. Returns the byte count,
    # -1 minus the error code, or one of the `_IO_TRANSFER_*` results; with
    # `_IO_TRANSFER_DECLINED` nothing was done, and the caller makes the
    # call itself. `timeout` milliseconds (0 for none) end the wait like the
    # task's timeout. The buffer stays in use until this returns, even when
    # the task is cancelled. (The address is a ulong: a `__ptr` parameter in
    # a trait method does not compile yet.)
    _socket_transfer(handle: SocketHandle, buffer: ulong, count: ulong, write: bool, timeout: ulong): long;

    # Windows: waits for changes in the tree under the directory `handle`
    # (a HANDLE opened for overlapped I/O) with one ReadDirectoryChangesW
    # request into the `count` bytes at address `buffer`, parking the task
    # until it completes (see watch_windows.pep). Returns the byte count, -1
    # minus the error code, or one of the `_IO_TRANSFER_*` results, as
    # `_socket_transfer` does; `_IO_TRANSFER_CLOSED` when the watcher closed
    # the handle.
    _directory_changes(handle: ulong, buffer: ulong, count: ulong): long;
}

# What `_IoWaiter._socket_transfer` returns besides a count or an error
# code: the runtime declined; the task was cancelled, or its timeout
# expired, before the kernel moved any bytes; or the socket was closed.
export const _IO_TRANSFER_DECLINED: long = -9223372036854775807;
export const _IO_TRANSFER_CANCELLED: long = -9223372036854775806;
export const _IO_TRANSFER_TIMED_OUT: long = -9223372036854775805;
export const _IO_TRANSFER_CLOSED: long = -9223372036854775804;

# This thread's waiter: a malloc'd slot holding one reference to it, or
# null. A thread (not fiber) local: `async.run` sets and clears it on the
# worker's own thread, and a task never moves to another thread. The slot is
# `__ptr<void>` because a thread-local's type must be thread-safe and
# `_IoWaiter` is not.
[ThreadLocal]
var _io_waiter: __ptr<void>;

# This thread's waiter slot, or null.
_io_waiter_slot(): __ptr<_IoWaiter> {
    return _io_waiter;
}

# Makes `waiter` this thread's waiter until `_io_clear_waiter`.
export _io_set_waiter(waiter: _IoWaiter) {
    __ptr<_IoWaiter> slot = _pep_malloc(16);
    __ptr<ulong> words = slot;
    words[0] = 0;
    words[1] = 0;
    slot[0] = waiter;
    _io_waiter = slot;
}

# Removes this thread's waiter.
export _io_clear_waiter() {
    var slot = _io_waiter_slot();
    if (slot == __null) {
        return;
    }
    _io_waiter = __null;
    slot[0] = __default<_IoWaiter>();
    _pep_free(slot);
}

# ── Timeouts ─────────────────────────────────────────────────────────────────

# The largest timeout, in milliseconds (about 49.7 days): each is kept in 32
# bits.
export const _IO_MAX_TIMEOUT: ulong = 4294967295;

# The timeouts of the sockets that have one, keyed by handle: the read
# timeout in the high 32 bits, the write timeout in the low 32.
const _io_socket_timeouts = async.Mutex<HashMap<long, ulong>>(HashMap<long, ulong>());

# How many sockets have a timeout, so that waits skip the lock when none
# has.
const _io_socket_timeout_count = async.Atomic<ulong>(0);

# The timeout in milliseconds (0 for none) of a wait on `h` for `interest`:
# its read timeout for `_IO_READABLE`, its write timeout for
# `_IO_WRITABLE`.
_io_socket_timeout(h: SocketHandle, interest: int): ulong {
    if (_io_socket_timeout_count.load() == 0) {
        return 0;
    }
    ulong packed = 0;
    with (var timeouts = _io_socket_timeouts.lock()) {
        var key = h as long;
        if (timeouts.contains(key)) {
            packed = timeouts.get(key);
        }
    }
    if (interest == _IO_READABLE) {
        return packed >> 32;
    }
    return packed & _IO_MAX_TIMEOUT;
}

# Sets the timeout of `h`'s waits for `interest` to `milliseconds` (0 for
# none, at most `_IO_MAX_TIMEOUT`).
_io_socket_set_timeout(h: SocketHandle, interest: int, milliseconds: ulong) {
    with (var timeouts = _io_socket_timeouts.lock()) {
        var key = h as long;
        ulong old = 0;
        var had = timeouts.contains(key);
        if (had) {
            old = timeouts.get(key);
        }
        var packed = (old & _IO_MAX_TIMEOUT) | (milliseconds << 32);
        if (interest == _IO_WRITABLE) {
            packed = (old & (_IO_MAX_TIMEOUT << 32)) | milliseconds;
        }
        if (packed != 0) {
            timeouts.insert(key, packed);
            if (!had) {
                _io_socket_timeout_count.fetch_add(1);
            }
        } else if (had) {
            timeouts.remove(key);
            _io_socket_timeout_count.fetch_sub(1);
        }
    }
}

# Sets one of `h`'s timeouts for a socket method: fails when the socket is
# closed or `milliseconds` is too large.
_io_socket_timeout_setter(h: SocketHandle, interest: int, milliseconds: ulong): IoResult<void> {
    var c = _io_socket_require_open(h);
    if (c.is_err()) {
        return c;
    }
    if (milliseconds > _IO_MAX_TIMEOUT) {
        var message = $"a socket timeout must be at most {_IO_MAX_TIMEOUT} milliseconds";
        return IoResult<void>.err(IoError(_io_sys_code_invalid_input(), message));
    }
    _io_socket_set_timeout(h, interest, milliseconds);
    return _io_ok_void();
}

# poll's timeout argument for `timeout` milliseconds: -1 (forever) for 0.
_io_poll_timeout(timeout: ulong): int {
    if (timeout == 0) {
        return -1;
    }
    if (timeout > 2147483647) {
        return 2147483647;
    }
    return timeout as int;
}

# The error of a wait that timed out.
_io_timed_out_error(): IoError {
    return IoError(_io_sys_code_timed_out(), "the operation timed out");
}

# ── Waiting ──────────────────────────────────────────────────────────────────

# Waits until `h` may be ready for `interest`: parks the task inside a task,
# blocks the thread outside one. Fails when the task is cancelled or times
# out, or the socket's timeout for `interest` expires, first.
_io_socket_wait(h: SocketHandle, interest: int): IoResult<void> {
    var timeout = _io_socket_timeout(h, interest);
    var slot = _io_waiter_slot();
    if (slot != __null) {
        var waiter = slot[0];
        if (waiter._in_task()) {
            match (waiter._wait_ready(h, interest, timeout)) {
                Ready => {
                    return _io_ok_void();
                }
                Cancelled => {
                    return IoResult<void>.err(IoError(_io_sys_code_cancelled(), "the task was cancelled"));
                }
                TimedOut => {
                    return IoResult<void>.err(_io_timed_out_error());
                }
                # The runtime cannot watch `h`: block the thread instead.
                Unwatched => {}
            }
        }
    }
    return _io_sys_socket_poll(h, interest, timeout);
}

# One file read or write that a task hands to the runtime: `count` bytes
# into `buffer` from `handle`, or from `buffer` to it when `write`, at the
# file's position. `[Shared]` so a pool thread may run it.
[Shared]
export struct _FileTransfer {
    const _handle: FileHandle;
    const _buffer: __ptr<u8>;
    const _count: ulong;
    const _write: bool;

    construct(handle: FileHandle, buffer: __ptr<u8>, count: ulong, write: bool) {
        _handle = handle;
        _buffer = buffer;
        _count = count;
        _write = write;
    }

    # Makes the system call, blocking the thread: the byte count, or -1
    # minus the error code (a number, since a pool thread must not make a
    # String for the runtime's thread).
    _run(): long {
        var r = _write ? _io_sys_write(_handle, _buffer, _count) : _io_sys_read(_handle, _buffer, _count);
        if (r.is_ok()) {
            return r.value() as long;
        }
        return -1 - (r.error().code as long);
    }

    # The buffer's address, for a driver that hands it to the kernel.
    _address(): ulong {
        return unsafe_cast<ulong>(_buffer);
    }
}

# Reads `count` bytes into `buffer` from `h` (or writes them from it, when
# `write`) with one system call: inside a task through the runtime, which
# keeps the worker running, and directly outside one.
_io_file_transfer(h: FileHandle, buffer: __ptr<u8>, count: ulong, write: bool): IoResult<ulong> {
    var slot = _io_waiter_slot();
    if (slot != __null) {
        var waiter = slot[0];
        if (waiter._in_task()) {
            var transfer = _FileTransfer(h, buffer, count, write);
            return _io_file_transfer_result(waiter._file_transfer(transfer));
        }
    }
    if (write) {
        return _io_sys_write(h, buffer, count);
    }
    return _io_sys_read(h, buffer, count);
}

# The result `_FileTransfer._run` encoded.
_io_file_transfer_result(raw: long): IoResult<ulong> {
    if (raw >= 0) {
        return IoResult<ulong>.ok(raw as ulong);
    }
    var code = (-1 - raw) as ErrorCode;
    return IoResult<ulong>.err(IoError(code, _io_sys_error_message(code)));
}

# Receives into, or sends from, the `n` bytes at `p` on the stream socket
# `h` through the task runtime (see `_IoWaiter._socket_transfer`): none
# when the caller is not in a task or the runtime declines, and the caller
# then makes the call itself.
_io_task_socket_transfer(h: SocketHandle, p: __ptr<u8>, n: ulong, write: bool): IoResult<ulong>? {
    var slot = _io_waiter_slot();
    if (slot == __null) {
        return Optional<IoResult<ulong>>.Empty;
    }
    var waiter = slot[0];
    if (!waiter._in_task()) {
        return Optional<IoResult<ulong>>.Empty;
    }
    var interest = _IO_READABLE;
    if (write) {
        interest = _IO_WRITABLE;
    }
    var raw = waiter._socket_transfer(h, unsafe_cast<ulong>(p), n, write, _io_socket_timeout(h, interest));
    if (raw == _IO_TRANSFER_DECLINED) {
        return Optional<IoResult<ulong>>.Empty;
    }
    if (raw == _IO_TRANSFER_CANCELLED) {
        return Optional<IoResult<ulong>>.Value(
            IoResult<ulong>.err(IoError(_io_sys_code_cancelled(), "the task was cancelled"))
        );
    }
    if (raw == _IO_TRANSFER_TIMED_OUT) {
        return Optional<IoResult<ulong>>.Value(IoResult<ulong>.err(_io_timed_out_error()));
    }
    if (raw == _IO_TRANSFER_CLOSED) {
        return Optional<IoResult<ulong>>.Value(IoResult<ulong>.err(_io_socket_closed_error()));
    }
    return Optional<IoResult<ulong>>.Value(_io_file_transfer_result(raw));
}

# Whether the calling code runs in a task.
export _io_in_task(): bool {
    var slot = _io_waiter_slot();
    return slot != __null && slot[0]._in_task();
}

# Tells this thread's waiter that `h` is moving to another thread.
_io_socket_release(h: SocketHandle) {
    var slot = _io_waiter_slot();
    if (slot != __null) {
        slot[0]._release(h);
    }
}

# Tells this thread's waiter to stop watching `h` unless a task waits on it.
_io_socket_release_idle(h: SocketHandle) {
    var slot = _io_waiter_slot();
    if (slot != __null) {
        slot[0]._release_idle(h);
    }
}

# Tells this thread's waiter that `h` is about to be closed, and drops its
# timeouts.
_io_socket_forget(h: SocketHandle) {
    if (_io_socket_timeout_count.load() != 0) {
        _io_socket_set_timeout(h, _IO_READABLE, 0);
        _io_socket_set_timeout(h, _IO_WRITABLE, 0);
    }
    var slot = _io_waiter_slot();
    if (slot != __null) {
        slot[0]._forget(h);
    }
}
io/watch
9504
# Watcher, FileChange, ChangeKind: notifications of changes in a directory
# tree.
#
# The platform layer is in watch_linux.pep (inotify), watch_mac.pep
# (kqueue) and watch_windows.pep (ReadDirectoryChangesW); each defines
# `_io_watch_open`, `_io_watch_read` and `_io_watch_close` for its OS, and
# the WASI ones below fail; `_io_watch_close` takes fields, not the
# Watcher, because the destructor calls it. `_io_watch_read` waits for the system to report
# something and appends what it found to `_pending`, possibly nothing (an
# event about a path no longer watched), so `wait` loops until a change
# comes. In a task the wait parks the task (see wait.pep): on Linux and
# macOS the inotify or kqueue descriptor is waited on like a socket; on
# Windows the read goes to the runtime whole (`_IoWaiter._directory_changes`).

import "path";
import "sys_posix";
import "sys_windows";
import "types";
import "watch_linux";
import "watch_mac";
import "watch_windows";

# The size of the buffer the system writes events into.
const _IO_WATCH_BUFFER_SIZE: ulong = 65536;

## What happened to a path, as a `FileChange` reports it.
export enum ChangeKind {
    ## The path was created, or moved into the tree.
    Created,
    ## The path was removed, or moved out of the tree.
    Removed,
    ## The file's contents or attributes changed.
    Modified,
    ## The system dropped changes because they came faster than they were
    ## read; the `path` is the watched directory. List it again to catch up.
    Overflow,
}

## One change `Watcher.wait` reports.
export struct FileChange {
    ## What happened.
    const kind: ChangeKind;
    ## The path that changed: the watched directory's path, as given to
    ## `Watcher.open`, joined with the path inside it.
    const path: Path;

    ## Creates a change.
    ##
    ## @param kind what happened
    ## @param path the path that changed
    construct(kind: ChangeKind, path: Path) {
        this.kind = kind;
        this.path = path;
    }
}

## Watches a directory and everything below it for changes: files and
## directories created, removed, renamed or written.
##
## `wait()` returns the next batch of changes, waiting until there is one.
## In a task (inside `async.run`) the wait parks only the task, and the
## task's cancel or timeout ends it; elsewhere it blocks the thread. A
## rename reports the old path `Removed` and the new one `Created`. One write
## may report `Modified` more than once, and consecutive repeats within a
## batch are dropped.
##
## Each system watches its own way: inotify on Linux, with a watch on every
## directory of the tree (new ones are added as they appear, and what they
## already hold is reported `Created`); kqueue on macOS, which holds a
## descriptor for every directory and file, so a large tree may need a
## higher `ulimit -n`; `ReadDirectoryChangesW` on Windows. Changes are
## recorded from `open` on, also while no `wait` is running. When the
## system drops changes, `wait` reports an `Overflow` change. A change made
## right as a new directory appears may be missed on Linux and macOS: look
## at the directory when its `Created` arrives if that matters. Watching is
## not supported on WASI.
##
## @example
##     import io;
##
##     var watcher = io.Watcher.open(io.Path("src")).value();
##     while (true) {
##         var changes = watcher.wait();
##         if (changes.is_err()) {
##             break;
##         }
##         for (var change in changes.value()) {
##             print($"{change.kind.name()}: {change.path}");
##         }
##     }
[NotCopyable("owns an operating-system handle and cannot be copied; open another Watcher on the receiving thread")]
export struct Watcher {
    ## The directory being watched, as given to `open`.
    Path directory;
    # The inotify or kqueue descriptor, or the directory's HANDLE as a
    # number on Windows; -1 once closed.
    long _handle;
    # The buffer the system writes events into.
    __ptr<u8> _buffer;
    # Linux: each inotify watch's directory. macOS: each descriptor's path.
    var _watches: HashMap<long, String>;
    # macOS: the names last seen in each watched directory.
    var _listings: HashMap<String, HashSet<String>>;
    # Changes found but not returned yet.
    var _pending: Array<FileChange>;

    ## Creates a closed Watcher; `wait()` on it fails. Use `Watcher.open`.
    construct() {
        _handle = -1;
        _buffer = _pep_malloc(_IO_WATCH_BUFFER_SIZE);
        _watches = HashMap<long, String>();
        _listings = HashMap<String, HashSet<String>>();
        _pending = Array<FileChange>();
    }

    ## Stops watching when the last reference goes, as `close()` does.
    destruct {
        close();
        # Only here: until a `wait` running in a task returns, the system
        # may still be writing into the buffer.
        _pep_free(_buffer);
    }

    ## Starts watching `directory` and everything below it.
    ##
    ## @param directory the directory to watch; a symlink to one is followed
    ## @returns the Watcher; an error when `directory` cannot be stat'ed
    ## (`is_not_found()`, `is_permission_denied()`), is not a directory
    ## (`is_not_a_directory()`), or the system cannot watch it (on Linux
    ## when the inotify watch limit is reached, on macOS when the process
    ## runs out of descriptors, and on WASI always)
    ## @example
    ##     import io;
    ##
    ##     var watcher = io.Watcher.open(io.Path("."));
    ##     if (watcher.is_err()) {
    ##         print(watcher.error().message);
    ##     }
    static open(directory: Path): IoResult<Watcher> {
        var m = _io_sys_stat(directory, true);
        if (m.is_err()) {
            return IoResult<Watcher>.err(m.error());
        }
        if (!m.value().is_directory) {
            return IoResult<Watcher>.err(IoError(_io_sys_code_not_a_directory(), "not a directory"));
        }
        var watcher = Watcher();
        watcher.directory = directory;
        var opened = _io_watch_open(watcher);
        if (opened.is_err()) {
            return IoResult<Watcher>.err(opened.error());
        }
        return IoResult<Watcher>.ok(watcher);
    }

    ## Waits for changes and returns them, oldest first: those recorded
    ## since the last call, or, when there are none, the next ones to come.
    ##
    ## @returns at least one change; an error when the Watcher is closed
    ## (also when another task closes it during the wait), when the task
    ## is cancelled or times out first (`is_cancelled()`, `is_timed_out()`),
    ## or when the system fails, as on Windows when the watched directory
    ## is removed
    wait(): IoResult<FileChange[]> {
        while (true) {
            if (_handle < 0) {
                return IoResult<FileChange[]>.err(_io_watcher_closed_error());
            }
            if (_pending.count > 0) {
                var changes = _io_watch_without_repeats(_pending);
                _pending = Array<FileChange>();
                return IoResult<FileChange[]>.ok(changes);
            }
            var read = _io_watch_read(this);
            if (read.is_err()) {
                return IoResult<FileChange[]>.err(read.error());
            }
        }
        return IoResult<FileChange[]>.ok(Array<FileChange>());
    }

    ## Stops watching and releases the system resources. A `wait` running in
    ## another task ends with an error. Closing again does nothing.
    close() {
        if (_handle < 0) {
            return;
        }
        # Fields, not `this`: the destructor calls this too, and passing
        # `this` there would count it back up and destroy it again.
        _io_watch_close(_handle, _watches);
        _handle = -1;
        _watches.clear();
        _listings.clear();
        _pending.clear();
    }

    ## Returns whether the Watcher is still watching (not closed).
    ##
    ## @returns true until `close()`
    is_open(): bool {
        return _handle >= 0;
    }

    # Records a change.
    _report(kind: ChangeKind, path: String) {
        _pending.append(FileChange(kind, Path(path)));
    }
}

# The error of a wait on a closed Watcher.
_io_watcher_closed_error(): IoError {
    return IoError(_io_sys_code_bad_handle(), "the watcher is closed");
}

# `changes` without a change that repeats the one before it.
_io_watch_without_repeats(changes: Array<FileChange>): FileChange[] {
    var kept = Array<FileChange>();
    for (var change in changes) {
        if (kept.count > 0) {
            var last = kept[kept.count - 1];
            if (last.kind == change.kind && last.path.to_string() == change.path.to_string()) {
                continue;
            }
        }
        kept.append(change);
    }
    return kept;
}

# The error of watching where the system cannot.
_io_watch_unsupported(): IoError {
    return IoError(_io_sys_code_invalid_input(), "watching files is not supported on this system");
}

[Target(OS(Wasi))]
_io_watch_open(watcher: Watcher): IoResult<void> {
    return IoResult<void>.err(_io_watch_unsupported());
}

[Target(OS(Wasi))]
_io_watch_read(watcher: Watcher): IoResult<void> {
    return IoResult<void>.err(_io_watch_unsupported());
}

[Target(OS(Wasi))]
_io_watch_close(handle: long, watches: HashMap<long, String>) {}
io/watch_linux
6524
# The Linux layer of Watcher (see watch.pep): inotify.
#
# inotify watches one directory per watch, so every directory of the tree
# gets one, and one that appears gets its own as its creation is read.
# The descriptor is non-blocking: a read that finds nothing waits for it to
# become readable, which parks the task like a socket wait (epoll, io_uring
# and poll all take an inotify descriptor).

import "directory";
import "path";
import "sys_posix";
import "types";
import "wait";
import "watch";

[Target(OS(Linux))]
extern int inotify_init1(int flags);
[Target(OS(Linux))]
extern int inotify_add_watch(int fd, char* path, uint mask);
[Target(OS(Linux))]
extern int inotify_rm_watch(int fd, int wd);

# The events: IN_MODIFY | IN_ATTRIB | IN_MOVED_FROM | IN_MOVED_TO |
# IN_CREATE | IN_DELETE, on directories only (IN_ONLYDIR).
const _IO_INOTIFY_MASK: uint = 16778182;

const _IO_IN_MODIFY: uint = 2;
const _IO_IN_ATTRIB: uint = 4;
const _IO_IN_MOVED_FROM: uint = 64;
const _IO_IN_MOVED_TO: uint = 128;
const _IO_IN_CREATE: uint = 256;
const _IO_IN_DELETE: uint = 512;
const _IO_IN_Q_OVERFLOW: uint = 16384;
const _IO_IN_IGNORED: uint = 32768;
const _IO_IN_ISDIR: uint = 1073741824;

[Target(OS(Linux))]
_io_watch_open(watcher: Watcher): IoResult<void> {
    var fd = inotify_init1(526336);  # IN_NONBLOCK | IN_CLOEXEC
    if (fd < 0) {
        return IoResult<void>.err(IoError.last());
    }
    watcher._handle = fd as long;
    return _io_inotify_add_tree(watcher, watcher.directory.to_string(), false);
}

[Target(OS(Linux))]
_io_watch_read(watcher: Watcher): IoResult<void> {
    var fd = watcher._handle as int;
    var count = read(fd, watcher._buffer, _IO_WATCH_BUFFER_SIZE);
    if (count < 0) {
        var code = _io_sys_last_error();
        if (code == 4) {  # EINTR
            return _io_ok_void();
        }
        if (code == 11) {  # EAGAIN: nothing yet
            return _io_socket_wait(fd as SocketHandle, _IO_READABLE);
        }
        return IoResult<void>.err(IoError(code, _io_sys_error_message(code)));
    }
    var offset: ulong = 0;
    while (offset + 16 <= count as ulong) {
        var event = watcher._buffer + offset;
        var wd = unsafe_cast<__ptr<int>>(event)[0];
        var mask = unsafe_cast<__ptr<uint>>(event + 4)[0];
        var length = unsafe_cast<__ptr<uint>>(event + 12)[0] as ulong;
        var name = "";
        if (length > 0) {
            name = String(unsafe_cast<__ptr<char>>(event + 16));
        }
        offset = offset + 16 + length;
        var handled = _io_inotify_event(watcher, wd as long, mask, name);
        if (handled.is_err()) {
            return handled;
        }
    }
    return _io_ok_void();
}

[Target(OS(Linux))]
_io_watch_close(handle: long, watches: HashMap<long, String>) {
    var fd = handle as int;
    _io_socket_forget(fd as SocketHandle);
    close(fd);
}

# Records one inotify event for the watch `wd`, about `name` in its
# directory (the directory itself when empty).
[Target(OS(Linux))]
_io_inotify_event(watcher: Watcher, wd: long, mask: uint, name: String): IoResult<void> {
    if ((mask & _IO_IN_Q_OVERFLOW) != 0) {
        watcher._report(ChangeKind.Overflow, watcher.directory.to_string());
        return _io_ok_void();
    }
    if (!watcher._watches.contains(wd)) {
        return _io_ok_void();
    }
    var directory = watcher._watches.get(wd);
    if ((mask & _IO_IN_IGNORED) != 0) {
        # The directory was removed, or moved away (then forgotten already).
        watcher._watches.remove(wd);
        if (directory == watcher.directory.to_string()) {
            watcher._report(ChangeKind.Removed, directory);
        }
        return _io_ok_void();
    }
    var path = directory;
    if (name != "") {
        path = Path(directory).join(Path(name)).to_string();
    }
    var is_directory = (mask & _IO_IN_ISDIR) != 0;
    if ((mask & (_IO_IN_CREATE | _IO_IN_MOVED_TO)) != 0) {
        watcher._report(ChangeKind.Created, path);
        if (is_directory) {
            return _io_inotify_add_tree(watcher, path, true);
        }
        return _io_ok_void();
    }
    if ((mask & (_IO_IN_DELETE | _IO_IN_MOVED_FROM)) != 0) {
        watcher._report(ChangeKind.Removed, path);
        if (is_directory && (mask & _IO_IN_MOVED_FROM) != 0) {
            _io_inotify_remove_tree(watcher, path);
        }
        return _io_ok_void();
    }
    if ((mask & (_IO_IN_MODIFY | _IO_IN_ATTRIB)) != 0) {
        watcher._report(ChangeKind.Modified, path);
    }
    return _io_ok_void();
}

# Watches `directory` and every directory below it. With `report`, for a
# directory that just appeared, what it holds is reported `Created`, and
# one gone again already is not an error.
[Target(OS(Linux))]
_io_inotify_add_tree(watcher: Watcher, directory: String, report: bool): IoResult<void> {
    var wd = inotify_add_watch(watcher._handle as int, directory.c_str(), _IO_INOTIFY_MASK);
    if (wd < 0) {
        var code = _io_sys_last_error();
        if (report && (code == 2 || code == 20)) {  # ENOENT, ENOTDIR
            return _io_ok_void();
        }
        return IoResult<void>.err(IoError(code, _io_sys_error_message(code)));
    }
    watcher._watches.insert(wd as long, directory);
    var listing = _io_list(Path(directory));
    if (listing.is_err()) {
        if (report) {
            return _io_ok_void();
        }
        return IoResult<void>.err(listing.error());
    }
    for (var entry in listing.value()) {
        var child = entry.path.to_string();
        if (report) {
            watcher._report(ChangeKind.Created, child);
        }
        if (!entry.is_directory) {
            continue;
        }
        var added = _io_inotify_add_tree(watcher, child, report);
        if (added.is_err()) {
            return added;
        }
    }
    return _io_ok_void();
}

# Stops watching `directory` and the directories below it, after it moved
# out of its place.
[Target(OS(Linux))]
_io_inotify_remove_tree(watcher: Watcher, directory: String) {
    var below = directory + "/";
    var gone = Array<long>();
    for (var (wd, path) in watcher._watches) {
        if (path == directory || path.starts_with(below)) {
            gone.append(wd);
        }
    }
    for (var wd in gone) {
        inotify_rm_watch(watcher._handle as int, wd as int);
        watcher._watches.remove(wd);
    }
}
io/watch_mac
9081
# The macOS layer of Watcher (see watch.pep): kqueue.
#
# A vnode filter (EVFILT_VNODE) reports changes to one open file, so every
# directory and file of the tree is opened for events only (O_EVTONLY) and
# registered on the Watcher's own kqueue. A directory's write means entries
# came or went: it is listed again and compared with the names last seen.
# A file's write or attribute change is `Modified`; a file deleted or
# renamed is forgotten, and watched again when a new file took its name (a
# save by rename). The kqueue descriptor becomes readable when events are
# queued, so the wait parks the task like a socket wait.
#
# struct kevent is 32 bytes: ident (u64) at 0, filter (i16) at 8, flags
# (u16) at 10, fflags (u32) at 12, data (i64) at 16, udata at 24.

import "directory";
import "path";
import "sys_posix";
import "types";
import "wait";
import "watch";

[Target(OS(Mac))]
extern int kqueue();
[Target(OS(Mac))]
extern int kevent(int queue, void* changes, int change_count, void* events, int event_count, void* timeout);

# The most events one read takes: the buffer holds this many.
const _IO_KQUEUE_EVENTS = 2048;

const _IO_NOTE_DELETE: uint = 1;
const _IO_NOTE_WRITE: uint = 2;
const _IO_NOTE_EXTEND: uint = 4;
const _IO_NOTE_ATTRIB: uint = 8;
const _IO_NOTE_RENAME: uint = 32;
const _IO_NOTE_REVOKE: uint = 64;
# Every NOTE_* the watch asks for.
const _IO_NOTE_ALL: uint = 127;

[Target(OS(Mac))]
_io_watch_open(watcher: Watcher): IoResult<void> {
    var queue = kqueue();
    if (queue < 0) {
        return IoResult<void>.err(IoError.last());
    }
    watcher._handle = queue as long;
    return _io_kqueue_add(watcher, watcher.directory.to_string(), true, false);
}

[Target(OS(Mac))]
_io_watch_read(watcher: Watcher): IoResult<void> {
    var queue = watcher._handle as int;
    __ptr<long> zero = _pep_malloc(16);  # a timespec of 0: do not block
    zero[0] = 0;
    zero[1] = 0;
    var count = kevent(queue, __null, 0, watcher._buffer, _IO_KQUEUE_EVENTS, zero);
    var code = _io_sys_last_error();
    _pep_free(zero);
    if (count < 0) {
        if (code == 4) {  # EINTR
            return _io_ok_void();
        }
        return IoResult<void>.err(IoError(code, _io_sys_error_message(code)));
    }
    if (count == 0) {
        return _io_socket_wait(queue as SocketHandle, _IO_READABLE);
    }
    var i: ulong = 0;
    while (i < count as ulong) {
        var event = watcher._buffer + i * 32;
        var descriptor = unsafe_cast<__ptr<ulong>>(event)[0] as long;
        var flags = unsafe_cast<__ptr<uint>>(event + 12)[0];
        var handled = _io_kqueue_event(watcher, descriptor, flags);
        if (handled.is_err()) {
            return handled;
        }
        i = i + 1;
    }
    return _io_ok_void();
}

[Target(OS(Mac))]
_io_watch_close(handle: long, watches: HashMap<long, String>) {
    for (var (descriptor, path) in watches) {
        close(descriptor as int);
    }
    var queue = handle as int;
    _io_socket_forget(queue as SocketHandle);
    close(queue);
}

# Records what the vnode event `flags` on `descriptor` means.
[Target(OS(Mac))]
_io_kqueue_event(watcher: Watcher, descriptor: long, flags: uint): IoResult<void> {
    if (!watcher._watches.contains(descriptor)) {
        return _io_ok_void();
    }
    var path = watcher._watches.get(descriptor);
    var gone = (flags & (_IO_NOTE_DELETE | _IO_NOTE_RENAME | _IO_NOTE_REVOKE)) != 0;
    if (watcher._listings.contains(path)) {
        # A directory: its parent's listing reports it going, except the
        # watched directory's own.
        if (gone) {
            if (path == watcher.directory.to_string()) {
                watcher._report(ChangeKind.Removed, path);
            }
            _io_kqueue_remove(watcher, path);
            return _io_ok_void();
        }
        if ((flags & _IO_NOTE_ATTRIB) != 0) {
            watcher._report(ChangeKind.Modified, path);
        }
        if ((flags & _IO_NOTE_WRITE) != 0) {
            return _io_kqueue_rescan(watcher, path);
        }
        return _io_ok_void();
    }
    if (!gone) {
        if ((flags & (_IO_NOTE_WRITE | _IO_NOTE_EXTEND | _IO_NOTE_ATTRIB)) != 0) {
            watcher._report(ChangeKind.Modified, path);
        }
        return _io_ok_void();
    }
    # The file was deleted or renamed. A new file under its name replaced
    # it; otherwise its directory's listing reports it removed.
    _io_kqueue_remove(watcher, path);
    if (!Path(path).exists()) {
        return _io_ok_void();
    }
    watcher._report(ChangeKind.Modified, path);
    return _io_kqueue_add(watcher, path, false, true);
}

# Lists `directory` again and reports the names that came and went.
[Target(OS(Mac))]
_io_kqueue_rescan(watcher: Watcher, directory: String): IoResult<void> {
    var listing = _io_list(Path(directory));
    if (listing.is_err()) {
        # Gone: its own event or its parent's reports it.
        return _io_ok_void();
    }
    var known = watcher._listings.get(directory);
    var current = HashSet<String>();
    for (var entry in listing.value()) {
        current.insert(entry.name);
        if (known.contains(entry.name)) {
            continue;
        }
        known.insert(entry.name);
        var child = entry.path.to_string();
        watcher._report(ChangeKind.Created, child);
        var added = _io_kqueue_add(watcher, child, entry.is_directory, true);
        if (added.is_err()) {
            return added;
        }
    }
    var removed = Array<String>();
    for (var name in known) {
        if (!current.contains(name)) {
            removed.append(name);
        }
    }
    for (var name in removed) {
        known.remove(name);
        var child = Path(directory).join(Path(name)).to_string();
        watcher._report(ChangeKind.Removed, child);
        _io_kqueue_remove(watcher, child);
    }
    return _io_ok_void();
}

# Watches `path`, and when it is a directory everything below it. With
# `report`, for a directory that just appeared, what it holds is reported
# `Created`, and a path gone again already is not an error.
[Target(OS(Mac))]
_io_kqueue_add(watcher: Watcher, path: String, is_directory: bool, report: bool): IoResult<void> {
    # O_EVTONLY | O_NONBLOCK | O_CLOEXEC: no read access needed, and a FIFO
    # does not block the open.
    var descriptor = open(path.c_str(), 16809988);
    if (descriptor < 0) {
        var code = _io_sys_last_error();
        if (report && code == 2) {  # ENOENT
            return _io_ok_void();
        }
        return IoResult<void>.err(IoError(code, _io_sys_error_message(code)));
    }
    __ptr<u8> change = _pep_malloc(32);
    unsafe_cast<__ptr<ulong>>(change)[0] = descriptor as ulong;
    unsafe_cast<__ptr<i16>>(change + 8)[0] = -4 as i16;   # EVFILT_VNODE
    unsafe_cast<__ptr<u16>>(change + 10)[0] = 33 as u16;  # EV_ADD | EV_CLEAR
    unsafe_cast<__ptr<uint>>(change + 12)[0] = _IO_NOTE_ALL;
    unsafe_cast<__ptr<long>>(change + 16)[0] = 0;
    unsafe_cast<__ptr<ulong>>(change + 24)[0] = 0;
    var registered = kevent(watcher._handle as int, change, 1, __null, 0, __null);
    var code = _io_sys_last_error();
    _pep_free(change);
    if (registered < 0) {
        close(descriptor);
        return IoResult<void>.err(IoError(code, _io_sys_error_message(code)));
    }
    watcher._watches.insert(descriptor as long, path);
    if (!is_directory) {
        return _io_ok_void();
    }
    var names = HashSet<String>();
    watcher._listings.insert(path, names);
    var listing = _io_list(Path(path));
    if (listing.is_err()) {
        if (report) {
            return _io_ok_void();
        }
        return IoResult<void>.err(listing.error());
    }
    for (var entry in listing.value()) {
        names.insert(entry.name);
        var child = entry.path.to_string();
        if (report) {
            watcher._report(ChangeKind.Created, child);
        }
        var added = _io_kqueue_add(watcher, child, entry.is_directory, report);
        if (added.is_err()) {
            return added;
        }
    }
    return _io_ok_void();
}

# Stops watching `path` and everything below it.
[Target(OS(Mac))]
_io_kqueue_remove(watcher: Watcher, path: String) {
    var below = path + "/";
    var gone = Array<long>();
    for (var (descriptor, watched) in watcher._watches) {
        if (watched == path || watched.starts_with(below)) {
            gone.append(descriptor);
        }
    }
    for (var descriptor in gone) {
        close(descriptor as int);
        watcher._watches.remove(descriptor);
    }
    var listings = Array<String>();
    for (var (directory, names) in watcher._listings) {
        if (directory == path || directory.starts_with(below)) {
            listings.append(directory);
        }
    }
    for (var directory in listings) {
        watcher._listings.remove(directory);
    }
}
io/watch_windows
6628
# The Windows layer of Watcher (see watch.pep): ReadDirectoryChangesW.
#
# The directory is opened for overlapped I/O, and one request watches the
# whole tree. In a task the request goes to the runtime
# (`_IoWaiter._directory_changes`), whose IOCP driver completes it on the
# worker's port; a cancel or timeout cancels it. Elsewhere, or when the
# runtime declines, the request completes on an event the thread waits for.
# Its event handle has the low bit set, so a completion never also goes to
# a port the directory is tied to.
#
# The system records changes from the first request on, also between
# requests, so `open` makes one and cancels it at once.

import "path";
import "sys_windows";
import "types";
import "wait";
import "watch";

[Target(OS(Windows))]
extern int ReadDirectoryChangesW(
    void* directory,
    void* buffer,
    uint length,
    int subtree,
    uint filter,
    uint* returned,
    void* overlapped,
    void* routine
);
[Target(OS(Windows))]
extern int GetOverlappedResult(void* file, void* overlapped, uint* transferred, int wait);
[Target(OS(Windows))]
extern void* CreateEventW(void* attributes, int manual_reset, int initial_state, ushort* name);
[Target(OS(Windows))]
extern int CancelIoEx(void* file, void* overlapped);

# FILE_NOTIFY_CHANGE_FILE_NAME | DIR_NAME | ATTRIBUTES | SIZE | LAST_WRITE.
const _IO_WATCH_FILTER: uint = 31;

# Starts watching the tree under `directory` for changes into the `count`
# bytes at `buffer`, completing through `overlapped`. For the async
# module's IOCP driver too.
[Target(OS(Windows))]
export _io_win_read_directory_changes(
    directory: __ptr<void>, buffer: __ptr<u8>, count: ulong, overlapped: __ptr<u8>
): bool {
    return ReadDirectoryChangesW(directory, buffer, count as uint, 1, _IO_WATCH_FILTER, __null, overlapped, __null)
        != 0;
}

[Target(OS(Windows))]
_io_watch_open(watcher: Watcher): IoResult<void> {
    var opened = _io_win_create(watcher.directory, 1, 3, 1073741824);  # FILE_LIST_DIRECTORY, OPEN_EXISTING, OVERLAPPED
    if (opened.is_err()) {
        return IoResult<void>.err(opened.error());
    }
    watcher._handle = _io_sys_handle_bits(opened.value());
    return _io_win_watch_blocking(watcher, true);
}

[Target(OS(Windows))]
_io_watch_read(watcher: Watcher): IoResult<void> {
    var slot = _io_waiter_slot();
    if (slot == __null || !slot[0]._in_task()) {
        return _io_win_watch_blocking(watcher, false);
    }
    var raw = slot[0]._directory_changes(
        watcher._handle as ulong, unsafe_cast<ulong>(watcher._buffer), _IO_WATCH_BUFFER_SIZE
    );
    if (raw == _IO_TRANSFER_DECLINED) {
        return _io_win_watch_blocking(watcher, false);
    }
    if (raw == _IO_TRANSFER_CANCELLED) {
        return IoResult<void>.err(IoError(_io_sys_code_cancelled(), "the task was cancelled"));
    }
    if (raw == _IO_TRANSFER_TIMED_OUT) {
        return IoResult<void>.err(_io_timed_out_error());
    }
    if (raw == _IO_TRANSFER_CLOSED) {
        return IoResult<void>.err(_io_watcher_closed_error());
    }
    if (raw < 0) {
        var code = (-1 - raw) as ErrorCode;
        return IoResult<void>.err(IoError(code, _io_sys_error_message(code)));
    }
    _io_win_watch_parse(watcher, raw as ulong);
    return _io_ok_void();
}

[Target(OS(Windows))]
_io_watch_close(handle: long, watches: HashMap<long, String>) {
    var directory = _io_sys_handle_from_bits(handle);
    # A request in flight in a task ends cancelled, and that wait fails.
    CancelIoEx(directory, __null);
    _io_socket_forget(handle as SocketHandle);
    CloseHandle(directory);
}

# Makes one request and waits for it, blocking the thread; with `cancel`,
# cancels it at once, which only starts the recording.
[Target(OS(Windows))]
_io_win_watch_blocking(watcher: Watcher, cancel: bool): IoResult<void> {
    var directory = _io_sys_handle_from_bits(watcher._handle);
    var event = CreateEventW(__null, 1, 0, __null);
    if (event == __null) {
        return IoResult<void>.err(IoError.last());
    }
    __ptr<u8> overlapped = _pep_malloc(32);
    __ptr<ulong> words = overlapped;
    words[0] = 0;
    words[1] = 0;
    words[2] = 0;
    words[3] = unsafe_cast<ulong>(event) | 1;
    var started = _io_win_read_directory_changes(directory, watcher._buffer, _IO_WATCH_BUFFER_SIZE, overlapped);
    var code = GetLastError();
    if (!started) {
        _pep_free(overlapped);
        CloseHandle(event);
        return IoResult<void>.err(IoError(code, _io_sys_error_message(code)));
    }
    if (cancel) {
        CancelIoEx(directory, overlapped);
    }
    __ptr<uint> transferred = _pep_malloc(4);
    transferred[0] = 0;
    var done = GetOverlappedResult(directory, overlapped, transferred, 1);
    code = GetLastError();
    var count = transferred[0] as ulong;
    _pep_free(transferred);
    _pep_free(overlapped);
    CloseHandle(event);
    if (done == 0) {
        if (cancel && code == 995) {  # ERROR_OPERATION_ABORTED
            return _io_ok_void();
        }
        return IoResult<void>.err(IoError(code, _io_sys_error_message(code)));
    }
    _io_win_watch_parse(watcher, count);
    return _io_ok_void();
}

# Records the FILE_NOTIFY_INFORMATION records a request wrote: `count`
# bytes, none when the system dropped changes.
[Target(OS(Windows))]
_io_win_watch_parse(watcher: Watcher, count: ulong) {
    if (count == 0) {
        watcher._report(ChangeKind.Overflow, watcher.directory.to_string());
        return;
    }
    ulong offset = 0;
    while (offset + 12 <= count) {
        var record = watcher._buffer + offset;
        var next = unsafe_cast<__ptr<uint>>(record)[0] as ulong;
        var action = unsafe_cast<__ptr<uint>>(record + 4)[0];
        var length = unsafe_cast<__ptr<uint>>(record + 8)[0];
        var name = _io_win_narrow(unsafe_cast<__ptr<u16>>(record + 12), (length / 2) as int);
        var path = watcher.directory.join(Path(name)).to_string();
        match (action) {
            1, 5 => {  # FILE_ACTION_ADDED, RENAMED_NEW_NAME
                watcher._report(ChangeKind.Created, path);
            }
            2, 4 => {  # FILE_ACTION_REMOVED, RENAMED_OLD_NAME
                watcher._report(ChangeKind.Removed, path);
            }
            3 => {  # FILE_ACTION_MODIFIED
                watcher._report(ChangeKind.Modified, path);
            }
            else => {}
        }
        if (next == 0) {
            return;
        }
        offset = offset + next;
    }
}
