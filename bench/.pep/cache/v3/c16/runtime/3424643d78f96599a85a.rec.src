export extend float {
    ## Parses `text` as a `float` written in decimal notation: an optional
    ## `+` or `-`, digits with an optional `.` among them (`"1.5"`, `".5"`,
    ## `"2."`), then an optional exponent (`"1e-3"`, `"2.5E8"`), and nothing
    ## else. The value is the nearest `float`. No spaces, `inf`, `nan` or
    ## hexadecimal are accepted.
    ##
    ## @param text the text to parse
    ## @returns the value, or none when `text` is not decimal notation or its
    ##   value is too large for a `float` (one too small rounds to zero)
    ## @example
    ##     assert(float.parse("0.25").value() == 0.25, "decimal");
    ##     assert(float.parse("1e39").is_empty(), "too big");
    static parse(text: String): float? {
        if (!_is_decimal(text)) {
            return Optional<float>.Empty;
        }
        var value = strtof(text.c_str(), __null);
        # An infinity minus itself is NaN, not zero: the value overflowed.
        if (value - value != 0) {
            return Optional<float>.Empty;
        }
        return Optional<float>.Value(value);
    }

    ## Returns the square root (`llvm.sqrt`, one instruction on most CPUs):
    ## NaN for a negative value, and `-0.0` for `-0.0`.
    ##
    ## @returns the non-negative square root
    ## @example
    ##     assert((2.25 as float).square_root() == 1.5, "exact");
    square_root(): float {
        return _square_root_32(this);
    }

    ## Returns the largest whole number not greater than this value
    ## (`llvm.floor`).
    ##
    ## @returns the value rounded toward negative infinity
    ## @example
    ##     assert((-1.5 as float).floor() == -2.0, "down");
    floor(): float {
        return _floor_32(this);
    }

    ## Returns the smallest whole number not less than this value
    ## (`llvm.ceil`).
    ##
    ## @returns the value rounded toward positive infinity
    ## @example
    ##     assert((-1.5 as float).ceiling() == -1.0, "up");
    ceiling(): float {
        return _ceiling_32(this);
    }

    ## Returns this value without its fractional part (`llvm.trunc`).
    ##
    ## @returns the value rounded toward zero
    ## @example
    ##     assert((-1.5 as float).truncate() == -1.0, "toward zero");
    truncate(): float {
        return _truncate_32(this);
    }

    ## Returns the nearest whole number, halfway cases away from zero
    ## (`llvm.round`).
    ##
    ## @returns the rounded value
    ## @example
    ##     assert((2.5 as float).round() == 3.0, "half away from zero");
    round(): float {
        return _round_32(this);
    }

    ## Returns the absolute value: this value with its sign bit cleared
    ## (`llvm.fabs`).
    ##
    ## @returns the value without its sign
    ## @example
    ##     assert((-2.0 as float).abs() == 2.0, "negative");
    abs(): float {
        return _abs_32(this);
    }

    ## Returns this value's magnitude with the sign of `sign`
    ## (`llvm.copysign`).
    ##
    ## @param sign the value whose sign the result takes
    ## @returns `abs()` of this value, negated when `sign` is negative
    ## @example
    ##     assert((3.0 as float).copy_sign(-0.0) == -3.0, "negative zero is negative");
    copy_sign(sign: float): float {
        return _copy_sign_32(this, sign);
    }

    ## Returns `this * factor + addend` with a single rounding, as one fused
    ## multiply-add (`llvm.fma`): more precise than the two operations, and
    ## one instruction where the CPU has it.
    ##
    ## @param factor the value to multiply by
    ## @param addend the value to add to the product
    ## @returns the fused product and sum
    ## @example
    ##     assert((2.0 as float).multiply_add(3.0, 1.0) == 7.0, "2 * 3 + 1");
    multiply_add(factor: float, addend: float): float {
        return _multiply_add_32(this, factor, addend);
    }

    ## Returns the smaller of this value and `other`; when one of them is
    ## NaN, the other (`llvm.minnum`).
    ##
    ## @param other the value to compare with
    ## @returns the smaller value
    ## @example
    ##     assert((1.5 as float).min(-2.0) == -2.0, "smaller");
    min(other: float): float {
        return _min_32(this, other);
    }

    ## Returns the larger of this value and `other`; when one of them is
    ## NaN, the other (`llvm.maxnum`).
    ##
    ## @param other the value to compare with
    ## @returns the larger value
    ## @example
    ##     assert((1.5 as float).max(-2.0) == 1.5, "larger");
    max(other: float): float {
        return _max_32(this, other);
    }

    ## Returns the sine of this angle, in radians (`llvm.sin`).
    ##
    ## @returns the sine, from -1 to 1; NaN for an infinity or NaN
    ## @example
    ##     assert((0.0 as float).sine() == 0.0, "sine of zero");
    sine(): float {
        return _sine_32(this);
    }

    ## Returns the cosine of this angle, in radians (`llvm.cos`).
    ##
    ## @returns the cosine, from -1 to 1; NaN for an infinity or NaN
    ## @example
    ##     assert((0.0 as float).cosine() == 1.0, "cosine of zero");
    cosine(): float {
        return _cosine_32(this);
    }

    ## Returns the tangent of this angle, in radians (`llvm.tan`).
    ##
    ## @returns the tangent; NaN for an infinity or NaN
    ## @example
    ##     assert((0.0 as float).tangent() == 0.0, "tangent of zero");
    tangent(): float {
        return _tangent_32(this);
    }

    ## Returns the angle, in radians, whose sine is this value (`llvm.asin`).
    ##
    ## @returns the angle, from -π/2 to π/2; NaN when this value is outside -1 to 1
    ## @example
    ##     assert((0.0 as float).arc_sine() == 0.0, "arc sine of zero");
    arc_sine(): float {
        return _arc_sine_32(this);
    }

    ## Returns the angle, in radians, whose cosine is this value (`llvm.acos`).
    ##
    ## @returns the angle, from 0 to π; NaN when this value is outside -1 to 1
    ## @example
    ##     assert((1.0 as float).arc_cosine() == 0.0, "arc cosine of one");
    arc_cosine(): float {
        return _arc_cosine_32(this);
    }

    ## Returns the angle, in radians, whose tangent is this value (`llvm.atan`).
    ##
    ## @returns the angle, from -π/2 to π/2
    ## @example
    ##     assert((0.0 as float).arc_tangent() == 0.0, "arc tangent of zero");
    arc_tangent(): float {
        return _arc_tangent_32(this);
    }

    ## Returns the angle, in radians, from the positive x axis to the point
    ## (`x`, this value), using both signs to pick the quadrant: C's
    ## `atan2(y, x)` with this value as `y` (`llvm.atan2`).
    ##
    ## @param x the x coordinate of the point
    ## @returns the angle, from -π to π
    ## @example
    ##     assert((0.0 as float).arc_tangent2(1.0) == 0.0, "along the positive x axis");
    ##     assert((1.0 as float).arc_tangent2(0.0) == (1.0 as float).arc_sine(), "straight up is π/2");
    arc_tangent2(x: float): float {
        return _arc_tangent2_32(this, x);
    }

    ## Returns the hyperbolic sine of this value (`llvm.sinh`).
    ##
    ## @returns the hyperbolic sine; an infinity when it is too large
    ## @example
    ##     assert((0.0 as float).hyperbolic_sine() == 0.0, "hyperbolic sine of zero");
    hyperbolic_sine(): float {
        return _hyperbolic_sine_32(this);
    }

    ## Returns the hyperbolic cosine of this value (`llvm.cosh`).
    ##
    ## @returns the hyperbolic cosine, at least 1; an infinity when it is too large
    ## @example
    ##     assert((0.0 as float).hyperbolic_cosine() == 1.0, "hyperbolic cosine of zero");
    hyperbolic_cosine(): float {
        return _hyperbolic_cosine_32(this);
    }

    ## Returns the hyperbolic tangent of this value (`llvm.tanh`).
    ##
    ## @returns the hyperbolic tangent, from -1 to 1
    ## @example
    ##     assert((0.0 as float).hyperbolic_tangent() == 0.0, "hyperbolic tangent of zero");
    hyperbolic_tangent(): float {
        return _hyperbolic_tangent_32(this);
    }

    ## Returns the value whose hyperbolic sine is this value (C's `asinh`).
    ##
    ## @returns the inverse hyperbolic sine
    ## @example
    ##     assert((0.0 as float).arc_hyperbolic_sine() == 0.0, "inverse of zero");
    arc_hyperbolic_sine(): float {
        return _arc_hyperbolic_sine_32(this);
    }

    ## Returns the non-negative value whose hyperbolic cosine is this value
    ## (C's `acosh`).
    ##
    ## @returns the inverse hyperbolic cosine; NaN when this value is less than 1
    ## @example
    ##     assert((1.0 as float).arc_hyperbolic_cosine() == 0.0, "inverse of one");
    arc_hyperbolic_cosine(): float {
        return _arc_hyperbolic_cosine_32(this);
    }

    ## Returns the value whose hyperbolic tangent is this value (C's `atanh`).
    ##
    ## @returns the inverse hyperbolic tangent; an infinity for -1 or 1, and NaN outside
    ## @example
    ##     assert((0.0 as float).arc_hyperbolic_tangent() == 0.0, "inverse of zero");
    arc_hyperbolic_tangent(): float {
        return _arc_hyperbolic_tangent_32(this);
    }

    ## Returns *e* raised to this value (`llvm.exp`).
    ##
    ## @returns *e* to the power of this value; an infinity when it is too large
    ## @example
    ##     assert((0.0 as float).exponential() == 1.0, "e to the zero");
    exponential(): float {
        return _exponential_32(this);
    }

    ## Returns 2 raised to this value (`llvm.exp2`).
    ##
    ## @returns 2 to the power of this value
    ## @example
    ##     assert((3.0 as float).exponential2() == 8.0, "2 cubed");
    exponential2(): float {
        return _exponential2_32(this);
    }

    ## Returns *e* raised to this value, minus 1 (C's `expm1`): precise even
    ## when this value is near zero, where `exponential() - 1` loses its digits.
    ##
    ## @returns `exponential() - 1`, computed without the loss
    ## @example
    ##     assert((0.0 as float).exponential_minus_one() == 0.0, "e to the zero, minus one");
    exponential_minus_one(): float {
        return _exponential_minus_one_32(this);
    }

    ## Returns the natural logarithm (base *e*) of this value (`llvm.log`).
    ##
    ## @returns the logarithm; negative infinity for zero, and NaN for a negative value
    ## @example
    ##     assert((1.0 as float).logarithm() == 0.0, "log of one");
    logarithm(): float {
        return _logarithm_32(this);
    }

    ## Returns the base-2 logarithm of this value (`llvm.log2`).
    ##
    ## @returns the logarithm; negative infinity for zero, and NaN for a negative value
    ## @example
    ##     assert((8.0 as float).logarithm2() == 3.0, "2 cubed is 8");
    logarithm2(): float {
        return _logarithm2_32(this);
    }

    ## Returns the base-10 logarithm of this value (`llvm.log10`).
    ##
    ## @returns the logarithm; negative infinity for zero, and NaN for a negative value
    ## @example
    ##     assert((1000.0 as float).logarithm10() == 3.0, "10 cubed is 1000");
    logarithm10(): float {
        return _logarithm10_32(this);
    }

    ## Returns the natural logarithm of 1 plus this value (C's `log1p`):
    ## precise even when this value is near zero, where `(1 + x).logarithm()`
    ## loses its digits.
    ##
    ## @returns the logarithm of `1 + this`; negative infinity for -1, and NaN below it
    ## @example
    ##     assert((0.0 as float).logarithm_one_plus() == 0.0, "log of one");
    logarithm_one_plus(): float {
        return _logarithm_one_plus_32(this);
    }

    ## Returns the cube root (C's `cbrt`), negative for a negative value.
    ##
    ## @returns the cube root
    ## @example
    ##     assert((-27.0 as float).cube_root() == -3.0, "a negative value has a cube root");
    cube_root(): float {
        return _cube_root_32(this);
    }

    ## Returns `(this * this + other * other).square_root()`, the length of
    ## the hypotenuse of a right triangle with sides this value and `other`
    ## (C's `hypot`), without overflowing or underflowing in between.
    ##
    ## @param other the length of the other side
    ## @returns the distance from the origin to (this, `other`)
    ## @example
    ##     assert((3.0 as float).hypotenuse(4.0) == 5.0, "a 3-4-5 triangle");
    hypotenuse(other: float): float {
        return _hypotenuse_32(this, other);
    }

    ## Returns the IEEE remainder of this value divided by `divisor` (C's
    ## `remainder`): `this - n * divisor`, where `n` is the quotient rounded to
    ## the nearest whole number, ties to even. It is never larger than half of
    ## `divisor`, and may be negative. `%` gives the remainder of the quotient
    ## rounded toward zero instead, with the sign of this value.
    ##
    ## @param divisor the value to divide by
    ## @returns the remainder; NaN when `divisor` is zero or this value is infinite
    ## @example
    ##     assert((7.0 as float).remainder(2.0) == -1.0, "7 / 2 = 3.5 rounds to 4");
    ##     assert((7.0 as float) % 2.0 == 1.0, "% rounds toward zero");
    remainder(divisor: float): float {
        return _remainder_32(this, divisor);
    }

    ## Returns whether this value is NaN (not a number), the one value not
    ## equal to itself.
    ##
    ## @returns true for NaN
    ## @example
    ##     assert(!(1.0 as float).is_nan(), "a number");
    ##     assert(((0.0 as float) / 0.0).is_nan(), "zero over zero");
    is_nan(): bool {
        return this != this;
    }

    ## Returns whether this value is positive or negative infinity.
    ##
    ## @returns true for an infinity
    ## @example
    ##     assert(((1.0 as float) / 0.0).is_infinite(), "one over zero");
    is_infinite(): bool {
        return !is_nan() && !is_finite();
    }

    ## Returns whether this value is neither an infinity nor NaN.
    ##
    ## @returns true for every other value
    ## @example
    ##     assert((1.0 as float).is_finite() && !((1.0 as float) / 0.0).is_finite(), "finite and infinite");
    is_finite(): bool {
        # An infinity or NaN minus itself is NaN, not zero.
        return this - this == 0;
    }

    ## Returns whether this value's sign bit is set: true for every negative
    ## value, `-0.0`, and a NaN with its sign bit set, which `< 0` does not
    ## tell apart.
    ##
    ## @returns true when the sign bit is set
    ## @example
    ##     assert((-0.0 as float).sign_bit() && !(0.0 as float).sign_bit(), "negative zero");
    sign_bit(): bool {
        return _copy_sign_32(1.0, this) < 0;
    }
}

export extend double {
    ## Parses `text` as a `double` written in decimal notation: an optional
    ## `+` or `-`, digits with an optional `.` among them (`"1.5"`, `".5"`,
    ## `"2."`), then an optional exponent (`"1e-3"`, `"2.5E8"`), and nothing
    ## else. The value is the nearest `double`. No spaces, `inf`, `nan` or
    ## hexadecimal are accepted.
    ##
    ## @param text the text to parse
    ## @returns the value, or none when `text` is not decimal notation or its
    ##   value is too large for a `double` (one too small rounds to zero)
    ## @example
    ##     assert(double.parse("-2.5e3").value() == -2500.0, "an exponent");
    ##     assert(double.parse("1.5.2").is_empty(), "not a number");
    static parse(text: String): double? {
        if (!_is_decimal(text)) {
            return Optional<double>.Empty;
        }
        var value = _number_strtod(text);
        # An infinity minus itself is NaN, not zero: the value overflowed.
        if (value - value != 0) {
            return Optional<double>.Empty;
        }
        return Optional<double>.Value(value);
    }

    ## Returns the square root (`llvm.sqrt`, one instruction on most CPUs):
    ## NaN for a negative value, and `-0.0` for `-0.0`.
    ##
    ## @returns the non-negative square root
    ## @example
    ##     assert((2.25 as double).square_root() == 1.5, "exact");
    square_root(): double {
        return _square_root_64(this);
    }

    ## Returns the largest whole number not greater than this value
    ## (`llvm.floor`).
    ##
    ## @returns the value rounded toward negative infinity
    ## @example
    ##     assert((-1.5 as double).floor() == -2.0, "down");
    floor(): double {
        return _floor_64(this);
    }

    ## Returns the smallest whole number not less than this value
    ## (`llvm.ceil`).
    ##
    ## @returns the value rounded toward positive infinity
    ## @example
    ##     assert((-1.5 as double).ceiling() == -1.0, "up");
    ceiling(): double {
        return _ceiling_64(this);
    }

    ## Returns this value without its fractional part (`llvm.trunc`).
    ##
    ## @returns the value rounded toward zero
    ## @example
    ##     assert((-1.5 as double).truncate() == -1.0, "toward zero");
    truncate(): double {
        return _truncate_64(this);
    }

    ## Returns the nearest whole number, halfway cases away from zero
    ## (`llvm.round`).
    ##
    ## @returns the rounded value
    ## @example
    ##     assert((2.5 as double).round() == 3.0, "half away from zero");
    round(): double {
        return _round_64(this);
    }

    ## Returns the absolute value: this value with its sign bit cleared
    ## (`llvm.fabs`).
    ##
    ## @returns the value without its sign
    ## @example
    ##     assert((-2.0 as double).abs() == 2.0, "negative");
    abs(): double {
        return _abs_64(this);
    }

    ## Returns this value's magnitude with the sign of `sign`
    ## (`llvm.copysign`).
    ##
    ## @param sign the value whose sign the result takes
    ## @returns `abs()` of this value, negated when `sign` is negative
    ## @example
    ##     assert((3.0 as double).copy_sign(-0.0) == -3.0, "negative zero is negative");
    copy_sign(sign: double): double {
        return _copy_sign_64(this, sign);
    }

    ## Returns `this * factor + addend` with a single rounding, as one fused
    ## multiply-add (`llvm.fma`): more precise than the two operations, and
    ## one instruction where the CPU has it.
    ##
    ## @param factor the value to multiply by
    ## @param addend the value to add to the product
    ## @returns the fused product and sum
    ## @example
    ##     assert((2.0 as double).multiply_add(3.0, 1.0) == 7.0, "2 * 3 + 1");
    multiply_add(factor: double, addend: double): double {
        return _multiply_add_64(this, factor, addend);
    }

    ## Returns the smaller of this value and `other`; when one of them is
    ## NaN, the other (`llvm.minnum`).
    ##
    ## @param other the value to compare with
    ## @returns the smaller value
    ## @example
    ##     assert((1.5 as double).min(-2.0) == -2.0, "smaller");
    min(other: double): double {
        return _min_64(this, other);
    }

    ## Returns the larger of this value and `other`; when one of them is
    ## NaN, the other (`llvm.maxnum`).
    ##
    ## @param other the value to compare with
    ## @returns the larger value
    ## @example
    ##     assert((1.5 as double).max(-2.0) == 1.5, "larger");
    max(other: double): double {
        return _max_64(this, other);
    }

    ## Returns the sine of this angle, in radians (`llvm.sin`).
    ##
    ## @returns the sine, from -1 to 1; NaN for an infinity or NaN
    ## @example
    ##     assert((0.0 as double).sine() == 0.0, "sine of zero");
    sine(): double {
        return _sine_64(this);
    }

    ## Returns the cosine of this angle, in radians (`llvm.cos`).
    ##
    ## @returns the cosine, from -1 to 1; NaN for an infinity or NaN
    ## @example
    ##     assert((0.0 as double).cosine() == 1.0, "cosine of zero");
    cosine(): double {
        return _cosine_64(this);
    }

    ## Returns the tangent of this angle, in radians (`llvm.tan`).
    ##
    ## @returns the tangent; NaN for an infinity or NaN
    ## @example
    ##     assert((0.0 as double).tangent() == 0.0, "tangent of zero");
    tangent(): double {
        return _tangent_64(this);
    }

    ## Returns the angle, in radians, whose sine is this value (`llvm.asin`).
    ##
    ## @returns the angle, from -π/2 to π/2; NaN when this value is outside -1 to 1
    ## @example
    ##     assert((0.0 as double).arc_sine() == 0.0, "arc sine of zero");
    arc_sine(): double {
        return _arc_sine_64(this);
    }

    ## Returns the angle, in radians, whose cosine is this value (`llvm.acos`).
    ##
    ## @returns the angle, from 0 to π; NaN when this value is outside -1 to 1
    ## @example
    ##     assert((1.0 as double).arc_cosine() == 0.0, "arc cosine of one");
    arc_cosine(): double {
        return _arc_cosine_64(this);
    }

    ## Returns the angle, in radians, whose tangent is this value (`llvm.atan`).
    ##
    ## @returns the angle, from -π/2 to π/2
    ## @example
    ##     assert((0.0 as double).arc_tangent() == 0.0, "arc tangent of zero");
    arc_tangent(): double {
        return _arc_tangent_64(this);
    }

    ## Returns the angle, in radians, from the positive x axis to the point
    ## (`x`, this value), using both signs to pick the quadrant: C's
    ## `atan2(y, x)` with this value as `y` (`llvm.atan2`).
    ##
    ## @param x the x coordinate of the point
    ## @returns the angle, from -π to π
    ## @example
    ##     assert((0.0 as double).arc_tangent2(1.0) == 0.0, "along the positive x axis");
    ##     assert((1.0 as double).arc_tangent2(0.0) == (1.0 as double).arc_sine(), "straight up is π/2");
    arc_tangent2(x: double): double {
        return _arc_tangent2_64(this, x);
    }

    ## Returns the hyperbolic sine of this value (`llvm.sinh`).
    ##
    ## @returns the hyperbolic sine; an infinity when it is too large
    ## @example
    ##     assert((0.0 as double).hyperbolic_sine() == 0.0, "hyperbolic sine of zero");
    hyperbolic_sine(): double {
        return _hyperbolic_sine_64(this);
    }

    ## Returns the hyperbolic cosine of this value (`llvm.cosh`).
    ##
    ## @returns the hyperbolic cosine, at least 1; an infinity when it is too large
    ## @example
    ##     assert((0.0 as double).hyperbolic_cosine() == 1.0, "hyperbolic cosine of zero");
    hyperbolic_cosine(): double {
        return _hyperbolic_cosine_64(this);
    }

    ## Returns the hyperbolic tangent of this value (`llvm.tanh`).
    ##
    ## @returns the hyperbolic tangent, from -1 to 1
    ## @example
    ##     assert((0.0 as double).hyperbolic_tangent() == 0.0, "hyperbolic tangent of zero");
    hyperbolic_tangent(): double {
        return _hyperbolic_tangent_64(this);
    }

    ## Returns the value whose hyperbolic sine is this value (C's `asinh`).
    ##
    ## @returns the inverse hyperbolic sine
    ## @example
    ##     assert((0.0 as double).arc_hyperbolic_sine() == 0.0, "inverse of zero");
    arc_hyperbolic_sine(): double {
        return _arc_hyperbolic_sine_64(this);
    }

    ## Returns the non-negative value whose hyperbolic cosine is this value
    ## (C's `acosh`).
    ##
    ## @returns the inverse hyperbolic cosine; NaN when this value is less than 1
    ## @example
    ##     assert((1.0 as double).arc_hyperbolic_cosine() == 0.0, "inverse of one");
    arc_hyperbolic_cosine(): double {
        return _arc_hyperbolic_cosine_64(this);
    }

    ## Returns the value whose hyperbolic tangent is this value (C's `atanh`).
    ##
    ## @returns the inverse hyperbolic tangent; an infinity for -1 or 1, and NaN outside
    ## @example
    ##     assert((0.0 as double).arc_hyperbolic_tangent() == 0.0, "inverse of zero");
    arc_hyperbolic_tangent(): double {
        return _arc_hyperbolic_tangent_64(this);
    }

    ## Returns *e* raised to this value (`llvm.exp`).
    ##
    ## @returns *e* to the power of this value; an infinity when it is too large
    ## @example
    ##     assert((0.0 as double).exponential() == 1.0, "e to the zero");
    exponential(): double {
        return _exponential_64(this);
    }

    ## Returns 2 raised to this value (`llvm.exp2`).
    ##
    ## @returns 2 to the power of this value
    ## @example
    ##     assert((3.0 as double).exponential2() == 8.0, "2 cubed");
    exponential2(): double {
        return _exponential2_64(this);
    }

    ## Returns *e* raised to this value, minus 1 (C's `expm1`): precise even
    ## when this value is near zero, where `exponential() - 1` loses its digits.
    ##
    ## @returns `exponential() - 1`, computed without the loss
    ## @example
    ##     assert((0.0 as double).exponential_minus_one() == 0.0, "e to the zero, minus one");
    exponential_minus_one(): double {
        return _exponential_minus_one_64(this);
    }

    ## Returns the natural logarithm (base *e*) of this value (`llvm.log`).
    ##
    ## @returns the logarithm; negative infinity for zero, and NaN for a negative value
    ## @example
    ##     assert((1.0 as double).logarithm() == 0.0, "log of one");
    logarithm(): double {
        return _logarithm_64(this);
    }

    ## Returns the base-2 logarithm of this value (`llvm.log2`).
    ##
    ## @returns the logarithm; negative infinity for zero, and NaN for a negative value
    ## @example
    ##     assert((8.0 as double).logarithm2() == 3.0, "2 cubed is 8");
    logarithm2(): double {
        return _logarithm2_64(this);
    }

    ## Returns the base-10 logarithm of this value (`llvm.log10`).
    ##
    ## @returns the logarithm; negative infinity for zero, and NaN for a negative value
    ## @example
    ##     assert((1000.0 as double).logarithm10() == 3.0, "10 cubed is 1000");
    logarithm10(): double {
        return _logarithm10_64(this);
    }

    ## Returns the natural logarithm of 1 plus this value (C's `log1p`):
    ## precise even when this value is near zero, where `(1 + x).logarithm()`
    ## loses its digits.
    ##
    ## @returns the logarithm of `1 + this`; negative infinity for -1, and NaN below it
    ## @example
    ##     assert((0.0 as double).logarithm_one_plus() == 0.0, "log of one");
    logarithm_one_plus(): double {
        return _logarithm_one_plus_64(this);
    }

    ## Returns the cube root (C's `cbrt`), negative for a negative value.
    ##
    ## @returns the cube root
    ## @example
    ##     assert((-27.0 as double).cube_root() == -3.0, "a negative value has a cube root");
    cube_root(): double {
        return _cube_root_64(this);
    }

    ## Returns `(this * this + other * other).square_root()`, the length of
    ## the hypotenuse of a right triangle with sides this value and `other`
    ## (C's `hypot`), without overflowing or underflowing in between.
    ##
    ## @param other the length of the other side
    ## @returns the distance from the origin to (this, `other`)
    ## @example
    ##     assert((3.0 as double).hypotenuse(4.0) == 5.0, "a 3-4-5 triangle");
    hypotenuse(other: double): double {
        return _hypotenuse_64(this, other);
    }

    ## Returns the IEEE remainder of this value divided by `divisor` (C's
    ## `remainder`): `this - n * divisor`, where `n` is the quotient rounded to
    ## the nearest whole number, ties to even. It is never larger than half of
    ## `divisor`, and may be negative. `%` gives the remainder of the quotient
    ## rounded toward zero instead, with the sign of this value.
    ##
    ## @param divisor the value to divide by
    ## @returns the remainder; NaN when `divisor` is zero or this value is infinite
    ## @example
    ##     assert((7.0 as double).remainder(2.0) == -1.0, "7 / 2 = 3.5 rounds to 4");
    ##     assert((7.0 as double) % 2.0 == 1.0, "% rounds toward zero");
    remainder(divisor: double): double {
        return _remainder_64(this, divisor);
    }

    ## Returns whether this value is NaN (not a number), the one value not
    ## equal to itself.
    ##
    ## @returns true for NaN
    ## @example
    ##     assert(!(1.0 as double).is_nan(), "a number");
    ##     assert(((0.0 as double) / 0.0).is_nan(), "zero over zero");
    is_nan(): bool {
        return this != this;
    }

    ## Returns whether this value is positive or negative infinity.
    ##
    ## @returns true for an infinity
    ## @example
    ##     assert(((1.0 as double) / 0.0).is_infinite(), "one over zero");
    is_infinite(): bool {
        return !is_nan() && !is_finite();
    }

    ## Returns whether this value is neither an infinity nor NaN.
    ##
    ## @returns true for every other value
    ## @example
    ##     assert((1.0 as double).is_finite() && !((1.0 as double) / 0.0).is_finite(), "finite and infinite");
    is_finite(): bool {
        # An infinity or NaN minus itself is NaN, not zero.
        return this - this == 0;
    }

    ## Returns whether this value's sign bit is set: true for every negative
    ## value, `-0.0`, and a NaN with its sign bit set, which `< 0` does not
    ## tell apart.
    ##
    ## @returns true when the sign bit is set
    ## @example
    ##     assert((-0.0 as double).sign_bit() && !(0.0 as double).sign_bit(), "negative zero");
    sign_bit(): bool {
        return _copy_sign_64(1.0, this) < 0;
    }
}
optional
6045
# A value that may be absent, like Rust's `Option<T>` and Swift's
# `Optional`: a value enum with an Empty and a Value case.

import "internals";

## A value of type `T` that may be absent: either Value, holding a `T`, or
## Empty, holding nothing, like Rust's `Option<T>` and Swift's `Optional`.
##
## Use it instead of a null reference or a sentinel (`-1`, `""`) wherever a
## value may be missing: the type says so, and reading the value goes through
## `value()`, which checks, or `value_or()`, which cannot fail. It works for
## every type, including those that have no null, such as `int`.
##
## `T?` is shorthand for `Optional<T>`, and a variable or field of an
## optional type that is not given a value starts as Empty.
##
## Build one with its cases (`Optional<int>.Value(1)`, `Optional<int>.Empty`).
## Test it with `is_value()` or `is_empty()`, as a condition by itself (`if (found)`), or with `match`
## and `is` on its cases (`if (found is Value(v))`).
##
## An optional is a [value enum](../language/value-structs.md): it is stored
## inline in whatever holds it, with no allocation, and copying one gives an
## independent optional. It is never null, and has no identity, so compare
## optionals with `==`, not `===`.
##
## @typeParam T the type of the value a Value optional holds
## @example
##     find_even(values: Array<int>): int? {
##         for (var v in values) {
##             if (v % 2 == 0) { return Optional<int>.Value(v); }
##         }
##         return Optional<int>.Empty;
##     }
##
##     main(): int {
##         var values = Array<int>();
##         values.append(3);
##         values.append(4);
##         var found = find_even(values);
##         if (!found) { return 1; }
##         return found.value() - 4;   # 0
##     }
[Value]
export enum Optional<T> {
    ## Holds no value. It is the first case, so an optional that is never
    ## given a value is Empty.
    Empty,
    ## Holds a value.
    ##
    ## @param value the value held
    Value(value: T),

    ## Deprecated: use the `Value` case, `Optional<T>.Value(value)`,
    ## instead.
    ##
    ## Returns a Value optional holding `value`.
    ##
    ## @param value the value to hold
    ## @returns a Value optional whose value is `value`
    [Deprecated("use the case 'Value' instead", "Value")]
    static some(value: T): Optional<T> {
        return Optional<T>.Value(value);
    }

    ## Deprecated: use the `Empty` case, `Optional<T>.Empty`, instead.
    ##
    ## Returns an Empty optional, one holding no value.
    ##
    ## @returns an Empty optional
    [Deprecated("use the case 'Optional<T>.Empty' instead")]
    static none(): Optional<T> {
        return Optional<T>.Empty;
    }

    ## Reports whether this optional holds a value.
    ##
    ## @returns true when the optional is Value
    ## @example
    ##     var found = Optional<int>.Value(7);
    ##     if (found.is_value()) { print(found.value()); }   # prints 7
    is_value(): bool {
        return this is Value;
    }

    ## Reports whether this optional holds no value.
    ##
    ## @returns true when the optional is Empty
    ## @example
    ##     var missing = Optional<int>.Empty;
    ##     if (missing.is_empty()) { print("missing"); }
    is_empty(): bool {
        return this is Empty;
    }

    ## Deprecated: use `is_value` instead.
    ##
    ## Reports whether this optional holds a value.
    ##
    ## @returns true when the optional is Value
    [Deprecated("use 'is_value' instead", "is_value")]
    is_some(): bool {
        return this is Value;
    }

    ## Deprecated: use `is_empty` instead.
    ##
    ## Reports whether this optional holds no value.
    ##
    ## @returns true when the optional is Empty
    [Deprecated("use 'is_empty' instead", "is_empty")]
    is_none(): bool {
        return this is Empty;
    }

    ## Reports whether this optional holds a value: the truth test, so an
    ## optional can stand as a condition by itself.
    ##
    ## `if (found)` means `if (found.is_value())`, `!found` means
    ## `found.is_empty()`, and the same holds in `while`, `&&`, `||` and
    ## `?:`.
    ##
    ## @returns true when the optional is Value
    ## @example
    ##     var found = Optional<int>.Value(7);
    ##     if (found) { print(found.value()); }   # prints 7
    !!(): bool {
        return this is Value;
    }

    ## Returns the value, panicking if this optional is Empty.
    ##
    ## For a struct `T` the caller gets its own reference; the optional keeps
    ## its reference too.
    ##
    ## @returns the value of a Value optional
    ## @panics if the optional is Empty ("Optional.value on an Empty optional")
    ## @example
    ##     var n = Optional<int>.Value(42).value();   # 42
    value(location: __ptr<char> = __caller_location()): T {
        if (this is Value(value)) {
            return value;
        }
        panic("Optional.value on an Empty optional", location);
    }

    # What `e?` lowers to (the builder's `lift_tries`): it returns early when
    # `_propagates()`, with the enclosing function's
    # `_from_residual(e._residual())`, an Empty optional.
    _propagates(): bool {
        return this is Empty;
    }

    _residual(): bool {
        return false;
    }

    static _from_residual(empty: bool): Optional<T> {
        return Optional<T>.Empty;
    }

    ## Returns the value, or `fallback` if this optional is Empty.
    ##
    ## Never panics. `fallback` is evaluated by the caller whether or not it
    ## is used.
    ##
    ## @param fallback the value to return when the optional is Empty
    ## @returns the value when the optional is Value, otherwise `fallback`
    ## @example
    ##     var n = Optional<int>.Empty.value_or(-1);   # -1
    value_or(fallback: T): T {
        if (this is Value(value)) {
            return value;
        }
        return fallback;
    }
}
ordered_map
11263
## `OrderedMap<K, V>`: a hash map that keeps its keys in the order they were
## first inserted.

# Entries live in parallel arrays in insertion order; a `_HashTable` maps
# each key to its entry's position. Removing an entry leaves a hole (its
# `_live` flag cleared, its key and value reset to the default so they are
# released at once), which iteration skips. Once holes outnumber the live
# entries the arrays are compacted and the table's positions rewritten, so
# removal is amortized O(1) and the arrays stay at most about twice the
# entry count.

## A hash map that iterates its entries in the order their keys were first
## inserted, like Python's `dict`.
##
## Keys are hashed with `hash<K>` and compared with `==`, as in `HashMap`.
## Lookups, inserts and removals take expected O(1) time. Setting the value
## of a key that is already present keeps its position; removing a key and
## inserting it again moves it to the end.
##
## `iterate()` visits the entries as `(key, value)` tuples in insertion
## order. The map holds one reference to each stored key and value, acquired
## when they are stored and released when they are overwritten, removed,
## cleared, or when the map is destroyed.
##
## @typeParam K the key type; hashed with `hash<K>` and compared with `==`
## @typeParam V the value type
## @example
##     var config = OrderedMap<String, String>();
##     config["name"] = "pepper";
##     config["version"] = "0.2";
##     config["license"] = "MIT";
##     for (var (key, value) in config) {
##         print($"{key} = {value}");   # name, version, license
##     }
export struct OrderedMap<K, V> {
    ## Maps each key to the position of its entry. Internal.
    _HashTable<K, ulong> _positions;
    ## The key of each entry, in insertion order. Internal.
    Array<K> _keys;
    ## The value of each entry, parallel to `_keys`. Internal.
    Array<V> _values;
    ## Whether each entry is live (false for a removed entry's hole). Internal.
    Array<bool> _live;
    ## The number of live entries. Internal.
    int _size;
    ## Counts the changes that add or remove entries, so an iterator can
    ## tell that the map changed under it. Internal.
    ulong _version;

    ## Creates an empty map whose table has room for at least
    ## `initial_capacity` slots (see `HashMap`).
    ##
    ## @param initial_capacity the minimum number of slots in the table
    construct(initial_capacity: ulong = 8) {
        _positions._init(initial_capacity);
        _keys = Array<K>();
        _values = Array<V>();
        _live = Array<bool>();
    }

    ## The number of entries in the map. O(1).
    var count: int {
        get {
            return _size;
        }
    }

    ## Whether the map has no entries. O(1).
    var is_empty: bool {
        get {
            return _size == 0;
        }
    }

    ## Removes every entry and releases the map's references to their keys
    ## and values. O(capacity).
    clear() {
        _positions._clear();
        _keys.clear();
        _values.clear();
        _live.clear();
        _size = 0;
        _version += 1;
    }

    ## Returns whether the map has an entry for `key`. Expected O(1).
    ##
    ## @param key the key to look up
    ## @returns true when `key` is present
    contains(key: K): bool {
        return _positions._find_slot(key) >= 0;
    }

    ## Maps `key` to `value`. A new key is added at the end of the order; an
    ## existing key keeps its position (and the key object the map already
    ## stores), and only its value is replaced. Expected O(1).
    ##
    ## @param key the key to add or update
    ## @param value the value to store for `key`
    ## @returns true when a new key was added, false when an existing key's
    ##   value was overwritten
    insert(key: K, value: V): bool {
        long slot = _positions._find_slot(key);
        if (slot >= 0) {
            _values[_positions._values._data[slot]] = value;
            return false;
        }
        _positions._insert(key, _keys.count);
        _keys.append(key);
        _values.append(value);
        _live.append(true);
        _size = _size + 1;
        _version += 1;
        return true;
    }

    ## Returns the value stored for `key`, or the default of `V` (0, or a
    ## null reference for struct types) when `key` is absent. A missing key
    ## is not inserted. Expected O(1).
    ##
    ## @param key the key to look up
    ## @returns the value for `key`, or the default of `V` when absent
    ## @see try_get
    get(key: K): V {
        long slot = _positions._find_slot(key);
        if (slot >= 0) {
            return _values[_positions._values._data[slot]];
        }
        return __default<V>();
    }

    ## Returns the value stored for `key`, or none when `key` is absent.
    ## Expected O(1).
    ##
    ## @param key the key to look up
    ## @returns the value for `key`, or none when absent
    try_get(key: K): V? {
        long slot = _positions._find_slot(key);
        if (slot >= 0) {
            return Optional<V>.Value(_values[_positions._values._data[slot]]);
        }
        return Optional<V>.Empty;
    }

    ## Removes the entry for `key`, releasing the map's references to its
    ## key and value. The other entries keep their order. Does nothing when
    ## `key` is absent. Amortized expected O(1).
    ##
    ## @param key the key to remove
    ## @returns true when `key` was present and removed, false when absent
    remove(key: K): bool {
        long slot = _positions._find_slot(key);
        if (slot < 0) {
            return false;
        }
        var position = _positions._values._data[slot];
        _positions._remove(key);
        _keys[position] = __default<K>();
        _values[position] = __default<V>();
        _live[position] = false;
        _size = _size - 1;
        _version += 1;
        if (_keys.count >= 16 and _keys.count > (_size as ulong) * 2) {
            _compact();
        }
        return true;
    }

    # Moves the live entries to the front, in order, drops the holes, and
    # points the table at the new positions.
    _compact() {
        ulong to = 0;
        ulong from = 0;
        var end = _keys.count;
        while (from < end) {
            if (_live[from]) {
                if (to != from) {
                    _keys.swap(to, from);
                    _values.swap(to, from);
                    _live.swap(to, from);
                    long slot = _positions._find_slot(_keys[to]);
                    _positions._values._data[slot] = to;
                }
                to = to + 1;
            }
            from = from + 1;
        }
        _keys.truncate(to);
        _values.truncate(to);
        _live.truncate(to);
    }

    ## Reads `m[key]`: the same as `get`. A missing key reads as the default
    ## of `V` and is not inserted.
    ##
    ## @param key the key to look up
    ## @returns the value for `key`, or the default of `V` when absent
    [](key: K): V {
        return get(key);
    }

    ## Writes `m[key] = value`: the same as `insert`.
    ##
    ## @param key the key to add or update
    ## @param value the value to store for `key`
    ## @returns `value`, the value of the assignment expression
    [](key: K, value: V): V {
        insert(key, value);
        return value;
    }

    ## Returns an iterator over the entries as `(key, value)` tuples in
    ## insertion order; `for (var (key, value) in map)` drives it.
    ##
    ## The iterator holds a reference to the map. Changing a value through
    ## an existing key while iterating is allowed; adding or removing an
    ## entry makes the iterator's next `next()` or `current()` panic.
    ##
    ## @returns an iterator positioned before the first entry
    iterate(): OrderedMapIterator<K, V> {
        return OrderedMapIterator<K, V>(this);
    }

    ## Returns a deep copy: a new map holding a copy of each key and value,
    ## in the same order, made with `copy`. This is how `copy(value)`
    ## copies an OrderedMap (the `Copyable<OrderedMap<K, V>>`
    ## implementation); call `copy(map)` rather than this method.
    ##
    ## @returns the copy
    copy(): OrderedMap<K, V> {
        var made = OrderedMap<K, V>(_positions._capacity);
        register_copy<OrderedMap<K, V>>(this, made);
        ulong i = 0;
        while (i < _keys.count) {
            if (_live[i]) {
                made.insert(copy<K>(_keys[i]), copy<V>(_values[i]));
            }
            i = i + 1;
        }
        return made;
    }
}

## An iterator over the entries of an `OrderedMap` as `(key, value)` tuples
## in insertion order; returned by `OrderedMap.iterate()` and driven by
## `for (var (key, value) in map)`.
##
## Holds a reference to the map. It is fail-fast: adding or removing an
## entry after the iterator was created makes its next `next()` or
## `current()` panic.
##
## @typeParam K the key type of the map
## @typeParam V the value type of the map
## @see OrderedMap.iterate
[Value]
export struct OrderedMapIterator<K, V> {
    ## The map being iterated.
    OrderedMap<K, V> _source;
    ## The position of the current entry; meaningful once `_started` is set.
    ulong _index;
    ## The map's `_version` when iteration began.
    ulong _version;
    ## Whether `next()` has been called.
    bool _started;

    ## Creates an iterator positioned before the first entry of `source`.
    ##
    ## @param source the map to iterate
    construct(source: OrderedMap<K, V>) {
        _source = source;
        _version = source._version;
    }

    ## Advances to the next entry.
    ##
    ## @returns true when there is a current entry, false once every entry was visited
    ## @panics if an entry was added or removed since the iterator was created ("OrderedMap modified during iteration")
    next(): bool {
        assert(_source._version == _version, "OrderedMap modified during iteration");
        var end = _source._keys.count;
        if (_started) {
            if (_index < end) {
                _index = _index + 1;
            }
        } else {
            _started = true;
        }
        while (_index < end and !_source._live[_index]) {
            _index = _index + 1;
        }
        return _index < end;
    }

    ## Returns the entry the last successful `next()` moved to.
    ##
    ## @returns the current entry as a `(key, value)` tuple
    ## @panics if an entry was added or removed since the iterator was created ("OrderedMap modified during iteration")
    ## @panics if `next()` was never called or already returned false ("OrderedMapIterator.current() without an entry")
    current(): (K, V) {
        assert(_source._version == _version, "OrderedMap modified during iteration");
        assert(_started and _index < _source._keys.count, "OrderedMapIterator.current() without an entry");
        return (_source._keys[_index], _source._values[_index]);
    }
}

extend OrderedMap<K, V> with Copyable<OrderedMap<K, V>>;
os/environment
6600
## The running process's environment variables: reading them, and setting
## and removing them for the process itself.
##
## Every read and change the runtime makes goes through one lock, so Pepper
## code never races with itself over the environment, on any thread. C code
## that calls `getenv` itself is outside that lock: on POSIX `setenv` races
## with such a call on another thread, as in every language. To give only a
## child process a different environment, use `process.Command`'s
## `environment`, `remove_environment` and `clear_environment` instead.

import async;
import "sys_posix";
import "sys_wasi";
import "sys_windows";

## Returns the value of the environment variable `name`, or none when it is
## not set.
##
## A variable set to the empty string is some empty String, not none. On
## Windows names are not case-sensitive (`Path` finds `PATH`), and values
## are read as UTF-16 and converted to UTF-8, so text outside the ANSI code
## page survives.
##
## @param name the variable's name
## @returns its value, or none when it is not set
## @example
##     import os;
##
##     main(): int {
##         var home = os.environment("HOME");
##         if (home) {
##             print(home.value());
##         }
##         return 0;
##     }
export environment(name: String): String? {
    if (name.is_empty) {
        return Optional<String>.Empty;
    }
    var value = Optional<String>.Empty;
    with (var held = _os_environment_lock.lock()) {
        value = _os_sys_environment(name);
    }
    return value;
}

## Returns whether the environment variable `name` turns a switch on: it is
## set to anything but the empty string or `0`, as `PEPPER_LOCKED=1` does.
##
## @param name the variable's name
## @returns true when it is set to a value other than empty or `0`
## @example
##     import os;
##
##     main(): int {
##         if (os.environment_flag("VERBOSE")) {
##             print("verbose");
##         }
##         return 0;
##     }
export environment_flag(name: String): bool {
    var value = environment(name);
    return value.is_value() and !value.value().is_empty and value.value() != "0";
}

## Sets the environment variable `name` to `value` for the running process,
## replacing any value it had.
##
## The process's own later reads see the change, and so do the children it
## starts afterwards. Safe from any thread for Pepper code; C code that calls
## `getenv` on another thread at the same time can race with it on POSIX
## (see this page's introduction). On Windows names are not case-sensitive.
## WASI keeps the change inside the program.
##
## @param name the variable's name
## @param value its new value; may be empty
## @panics if `name` is empty or contains `=` or a NUL byte, or `value`
##     contains a NUL byte
## @example
##     import os;
##
##     main(): int {
##         os.set_environment("GREETING", "hello");
##         print(os.environment("GREETING").value());   # hello
##         return 0;
##     }
export set_environment(name: String, value: String) {
    _os_check_environment_name(name);
    if (value.contains("\0")) {
        panic($"cannot set environment variable '{name}': its value contains a NUL byte");
    }
    with (var held = _os_environment_lock.lock()) {
        _os_sys_set_environment(name, value);
    }
}

## Removes the environment variable `name` from the running process.
##
## Removing a variable that is not set does nothing. The same thread-safety
## note as `set_environment`'s applies.
##
## @param name the variable's name
## @panics if `name` is empty or contains `=` or a NUL byte
## @example
##     import os;
##
##     main(): int {
##         os.remove_environment("GREETING");
##         print(os.environment("GREETING").is_empty());   # true
##         return 0;
##     }
export remove_environment(name: String) {
    _os_check_environment_name(name);
    with (var held = _os_environment_lock.lock()) {
        _os_sys_remove_environment(name);
    }
}

# Panics on a name no platform can set: as Rust's `set_var` does.
_os_check_environment_name(name: String) {
    if (name.is_empty) {
        panic("cannot change an environment variable with an empty name");
    }
    if (name.contains("=") || name.contains("\0")) {
        panic($"cannot change environment variable '{name}': its name contains '=' or a NUL byte");
    }
}

# The value `_os_environment_lock` guards: nothing; the lock is what matters.
[Shared]
struct _EnvironmentLock {
    construct() {}
}

# Held by every read and change of the process's environment.
const _os_environment_lock = async.Mutex<_EnvironmentLock>(_EnvironmentLock());

## Returns every environment variable of the running process, by name.
##
## The map has no order. On Windows it includes the variables whose names
## start with `=`, such as `=C:`, which `cmd.exe` uses for each drive's
## current directory; its keys keep the case the system reports, so look a
## name up with `environment(name)` to ignore case. When a POSIX
## environment holds one name twice, the first value wins, as `getenv`
## returns it.
##
## @returns a new map from each variable's name to its value
## @example
##     import os;
##
##     main(): int {
##         for (var (name, value) in os.environment_variables()) {
##             print($"{name}={value}");
##         }
##         return 0;
##     }
export environment_variables(): HashMap<String, String> {
    var variables = HashMap<String, String>();
    for (var entry in _os_environment_entries()) {
        # Search the bytes, not with `find`: a POSIX value need not be valid
        # UTF-8. The search starts at 1, past a Windows name's leading '='.
        ulong at = 1;
        while (at < entry.size && entry.byte_at(at) != '=') {
            at = at + 1;
        }
        if (at >= entry.size) {
            continue;
        }
        __ptr<char> data = entry.c_str();
        var name = String(data, at);
        if (!variables.contains(name)) {
            # A zero size measures to the terminating NUL: the value's end.
            variables.insert(name, String(data + at + 1));
        }
    }
    return variables;
}

# The environment as `NAME=VALUE` entries, for the process module too.
export _os_environment_entries(): Array<String> {
    var entries = Array<String>();
    with (var held = _os_environment_lock.lock()) {
        entries = _os_sys_environment_entries();
    }
    return entries;
}
os/machine
5294
## The machine the program runs on: its operating system, processor,
## memory and name.

import async;
import "sys_posix";
import "sys_wasi";
import "sys_windows";

## An operating system Pepper runs on, with the names `[Target(OS(...))]`
## uses.
##
## @see system_os
export enum OperatingSystem {
    ## Linux.
    Linux,
    ## macOS.
    Mac,
    ## Windows.
    Windows,
    ## WASI: a WebAssembly runtime such as wasmtime (`--target wasm32-wasip1`).
    Wasi,
    ## iOS and iPadOS, on a device or in the simulator (`--target
    ## aarch64-apple-ios`). `[Target(OS(Mac))]` covers it too.
    IOS,
    ## Android (`--target aarch64-linux-android`). `[Target(OS(Linux))]`
    ## covers it too.
    Android,
}

## Returns the operating system the program was built for.
##
## @returns the operating system
## @example
##     import os;
##
##     main(): int {
##         var executable = os.system_os() == os.OperatingSystem.Windows ? "tool.exe" : "tool";
##         print(executable);
##         return 0;
##     }
export system_os(): OperatingSystem {
    return _os_sys_os();
}

## Returns the name of the operating system the program was built for, in
## lowercase: `"linux"`, `"macos"`, `"windows"`, `"wasi"`, `"ios"` or
## `"android"`, for printing and for file and directory names.
##
## @returns the operating system's name
## @see system_os
export system_name(): String {
    match (system_os()) {
        Linux => { return "linux"; }
        Mac => { return "macos"; }
        Windows => { return "windows"; }
        Wasi => { return "wasi"; }
        IOS => { return "ios"; }
        Android => { return "android"; }
    }
}

## Returns the operating system's version: the kernel release on Linux
## (`uname -r`, such as `6.8.0-45-generic`), the product version on macOS
## (`sw_vers -productVersion`, such as `14.5`), and the major, minor and
## build numbers on Windows (such as `10.0.22631`). WASI does not report
## one.
##
## @returns the version, or an empty String when the system does not report
##   it
export system_version(): String {
    return _os_sys_version();
}

## Returns the processor architecture the program was built for: `"x64"`,
## `"aarch64"` or `"wasm32"`, the names `[Target(Arch(...))]` uses.
##
## @returns the architecture's name
[Target(Arch(x64))]
export architecture(): String {
    return "x64";
}

## Returns the processor architecture the program was built for: `"x64"`,
## `"aarch64"` or `"wasm32"`, the names `[Target(Arch(...))]` uses.
##
## @returns the architecture's name
[Target(Arch(aarch64))]
export architecture(): String {
    return "aarch64";
}

## Returns the processor architecture the program was built for: `"x64"`,
## `"aarch64"` or `"wasm32"`, the names `[Target(Arch(...))]` uses.
##
## @returns the architecture's name
[Target(Arch(wasm32))]
export architecture(): String {
    return "wasm32";
}

## Returns the machine's host name, as `hostname` prints it (on Windows its
## DNS host name). WASI does not report one.
##
## @returns the host name, or an empty String when the system does not
##   report it
export hostname(): String {
    return _os_sys_hostname();
}

## Returns the number of logical processors: every hardware thread, so a
## core with hyperthreading counts two or more times. On Linux a cgroup
## CPU quota (`docker run --cpus`) caps it, rounded up. The same as
## `async.logical_cpus()`.
##
## @returns the number of logical processors, at least 1
## @see physical_cpus
export logical_cpus(): ulong {
    return async.logical_cpus();
}

## Returns the number of physical processor cores: hardware threads that
## share a core count once. The same as `async.physical_cpus()`.
##
## @returns the number of physical cores, at least 1 and at most
##   `logical_cpus()`
## @see logical_cpus
export physical_cpus(): ulong {
    return async.physical_cpus();
}

## Returns the machine's physical memory in bytes. Inside a virtual
## machine this is what the guest sees. On Linux, a lower memory limit on
## the process's cgroup or any cgroup above it (cgroup v2's `memory.max`
## or v1's `memory.limit_in_bytes`, as `docker run --memory` sets) is
## returned instead, as the JVM does. WASI does not report it.
##
## @returns the total physical memory, or the container's memory limit when
##   that is lower, in bytes; 0 when the system does not report it
export total_memory(): ulong {
    return _os_sys_total_memory();
}

## Returns the most physical memory this process has held at once since it
## started: its peak resident set size (`ru_maxrss` on Linux and macOS, the
## peak working set on Windows). WASI does not report it.
##
## @returns the peak resident set size in bytes; 0 when the system does not
##   report it
## @example
##     var megabytes = os.peak_memory() / 1048576;
export peak_memory(): ulong {
    return _os_sys_peak_memory();
}

## Returns the size of a page of virtual memory in bytes: the unit the
## operating system maps memory in, usually 4096 (16384 on Apple silicon;
## 65536, WebAssembly's page, on WASI).
##
## @returns the page size in bytes
export page_size(): ulong {
    return _os_sys_page_size();
}
os/module
2068
## What the operating system provides beyond the running process:
## environment variables, clocks and time, and the machine and user.
##
## `os` is a module: bring it in with `import os` (and write
## `os.environment("HOME")`) or import names directly with
## `import [Instant, Duration] from os`.
##
## - [Environment](os-environment.md): `environment(name)`,
##   `environment_flag(name)`, `environment_variables()`,
##   `set_environment(name, value)` and
##   `remove_environment(name)`
## - [Time](os-time.md): `Duration`, `Instant` (a monotonic clock, for
##   measuring) and `SystemTime` (the wall clock)
## - [Machine](os-machine.md): `system_os()`, `system_name()`, `system_version()`,
##   `architecture()`, `hostname()`, processor counts, `total_memory()`,
##   `page_size()`
## - [User](os-user.md): `user_name()`, `home_directory()`,
##   `temp_directory()`, `is_elevated()`
##
## @example
##     import os;
##
##     main(): int {
##         var start = os.Instant.now();
##         var runtime = os.environment("PEPPER_RUNTIME").value_or("runtime");
##         print($"runtime at {runtime} on {os.hostname()}");
##         print($"took {os.Instant.now() - start}");
##         return 0;
##     }

# This file only gathers the module's public API from its other files.

import "environment";
import "machine";
import "sys_posix";
import "sys_wasi";
import "sys_windows";
import "time";
import "user";

export environment;
export environment_flag;
export environment_variables;
export set_environment;
export remove_environment;
export Duration;
export Instant;
export SystemTime;
export OperatingSystem;
export system_os;
export system_name;
export system_version;
export architecture;
export hostname;
export logical_cpus;
export physical_cpus;
export total_memory;
export peak_memory;
export page_size;
export user_name;
export home_directory;
export is_elevated;
export temp_directory;

# For the process module only: the environment a child inherits.
export _os_environment_entries;
os/sys_posix
10547
# POSIX (Linux, macOS) platform layer for os. Every declaration carries
# [Target(OS(Linux) || OS(Mac))] or a narrower target; sys_windows.pep declares the
# same `_os_sys_*` functions with the same signatures for Windows.

import async;
import io;
import "machine";
import "user";

[Target(OS(Linux) || OS(Mac))]
extern char* getenv(char* name);
[Target(OS(Linux) || OS(Mac))]
extern int setenv(char* name, char* value, int overwrite);
[Target(OS(Linux) || OS(Mac))]
extern int unsetenv(char* name);
[Target(OS(Linux))]
extern void* dlsym(void* handle, char* name);
[Target(OS(Mac))]
extern void* _NSGetEnviron();
[Target(OS(Linux) || OS(Mac))]
extern int clock_gettime(int clock, void* time);
[Target(OS(Linux) || OS(Mac))]
extern int gethostname(char* name, ulong size);
[Target(OS(Linux) || OS(Mac))]
extern int uname(void* name);
[Target(OS(Linux) || OS(Mac))]
extern long sysconf(int name);
[Target(OS(Mac))]
extern int sysctlbyname(char* name, void* value, void* size, void* new_value, ulong new_size);
[Target(OS(Linux) || OS(Mac))]
extern int getrusage(int who, void* usage);
[Target(OS(Linux) || OS(Mac))]
extern uint geteuid();
[Target(OS(Linux) || OS(Mac))]
extern int getpwuid_r(uint uid, void* entry, char* buffer, ulong size, void* result);

# ── Environment ──────────────────────────────────────────────────────────────

[Target(OS(Linux) || OS(Mac))]
_os_sys_environment(name: String): String? {
    # Under `_os_environment_lock`, as setenv and unsetenv are.
    __ptr<char> value = getenv(name.c_str());
    if (value == __null) {
        return Optional<String>.Empty;
    }
    return Optional<String>.Value(String(value));
}

[Target(OS(Linux) || OS(Mac))]
_os_sys_set_environment(name: String, value: String) {
    if (setenv(name.c_str(), value.c_str(), 1) != 0) {
        panic($"cannot set environment variable '{name}': out of memory");
    }
}

[Target(OS(Linux) || OS(Mac))]
_os_sys_remove_environment(name: String) {
    unsetenv(name.c_str());
}

# The `environ` array: NAME=VALUE strings, null-terminated.
[Target(OS(Linux))]
export _os_environ(): __ptr<__ptr<char>> {
    # `environ` is a variable, which an extern cannot name; dlsym finds it
    # (RTLD_DEFAULT is null on glibc).
    var name = "environ";
    __ptr<__ptr<__ptr<char>>> slot = dlsym(__null, name.c_str());
    if (slot == __null) {
        return __null;
    }
    return slot[0];
}

[Target(OS(Mac))]
export _os_environ(): __ptr<__ptr<char>> {
    __ptr<__ptr<__ptr<char>>> slot = _NSGetEnviron();
    return slot[0];
}

[Target(OS(Linux) || OS(Mac))]
_os_sys_environment_entries(): Array<String> {
    var entries = Array<String>();
    var values = _os_environ();
    if (values == __null) {
        return entries;
    }
    ulong index = 0;
    while (values[index] != __null) {
        entries.append(String(values[index]));
        index = index + 1;
    }
    return entries;
}

# ── Clocks ───────────────────────────────────────────────────────────────────

# CLOCK_MONOTONIC: 1 on Linux, 6 on macOS (as async's timeouts use).
[Target(OS(Linux))]
_os_sys_monotonic_nanoseconds(): ulong {
    return _os_clock_nanoseconds(1) as ulong;
}

[Target(OS(Mac))]
_os_sys_monotonic_nanoseconds(): ulong {
    return _os_clock_nanoseconds(6) as ulong;
}

# CLOCK_REALTIME is 0 on both.
[Target(OS(Linux) || OS(Mac))]
_os_sys_system_nanoseconds(): long {
    return _os_clock_nanoseconds(0);
}

[Target(OS(Linux) || OS(Mac))]
_os_clock_nanoseconds(clock: int): long {
    # struct timespec { time_t tv_sec; long tv_nsec; }
    __ptr<long> time = _pep_malloc(16);
    clock_gettime(clock, time);
    var nanoseconds = time[0] * 1000000000 + time[1];
    _pep_free(time);
    return nanoseconds;
}

# ── Machine ──────────────────────────────────────────────────────────────────

[Target(OS(Linux) && !OS(Android))]
_os_sys_os(): OperatingSystem {
    return OperatingSystem.Linux;
}

[Target(OS(Android))]
_os_sys_os(): OperatingSystem {
    return OperatingSystem.Android;
}

[Target(OS(Mac) && !OS(IOS))]
_os_sys_os(): OperatingSystem {
    return OperatingSystem.Mac;
}

[Target(OS(IOS))]
_os_sys_os(): OperatingSystem {
    return OperatingSystem.IOS;
}

# The release field of struct utsname: six 65-byte fields on Linux, release
# the third.
[Target(OS(Linux))]
_os_sys_version(): String {
    __ptr<char> fields = _pep_malloc(390);
    var version = uname(fields) == 0 ? String(fields + 130) : String();
    _pep_free(fields);
    return version;
}

[Target(OS(Mac))]
_os_sys_version(): String {
    return _os_sysctl_string("kern.osproductversion");
}

[Target(OS(Mac))]
_os_sysctl_string(name: String): String {
    __ptr<ulong> size = _pep_malloc(8);
    size[0] = 0;
    var text = String();
    if (sysctlbyname(name.c_str(), __null, size, __null, 0) == 0 && size[0] > 0) {
        __ptr<char> buffer = _pep_malloc(size[0]);
        if (sysctlbyname(name.c_str(), buffer, size, __null, 0) == 0) {
            text = String(buffer);
        }
        _pep_free(buffer);
    }
    _pep_free(size);
    return text;
}

[Target(OS(Linux) || OS(Mac))]
_os_sys_hostname(): String {
    # HOST_NAME_MAX is 64 on Linux and 255 on macOS; the last byte stays NUL
    # in case the name was cut short.
    __ptr<char> buffer = _pep_malloc(257);
    buffer[256] = 0;
    var name = gethostname(buffer, 256) == 0 ? String(buffer) : String();
    _pep_free(buffer);
    return name;
}

# _SC_PHYS_PAGES pages of _SC_PAGESIZE bytes, or less when a cgroup memory
# limit on this process's cgroup or an ancestor is lower: v2's `memory.max`
# ("max" when unlimited) or v1's `memory.limit_in_bytes` (a huge number when
# unlimited), as the JVM reads them.
[Target(OS(Linux))]
_os_sys_total_memory(): ulong {
    var pages = sysconf(_SC_PHYS_PAGES);
    ulong bytes = pages < 1 ? 0 : (pages as ulong) * _os_sys_page_size();
    for (var directory in async._async_sys_cgroup_directories("memory")) {
        var limit = io.File.read_to_string(io.Path(directory + "/memory.max"));
        if (!limit.is_ok()) {
            limit = io.File.read_to_string(io.Path(directory + "/memory.limit_in_bytes"));
        }
        if (limit.is_ok()) {
            var value = long.parse(limit.value().trim()).value_or(0);
            if (value > 0 && (bytes == 0 || (value as ulong) < bytes)) {
                bytes = value as ulong;
            }
        }
    }
    return bytes;
}

[Target(OS(Mac))]
_os_sys_total_memory(): ulong {
    __ptr<ulong> value = _pep_malloc(8);
    __ptr<ulong> size = _pep_malloc(8);
    value[0] = 0;
    size[0] = 8;
    var result = sysctlbyname("hw.memsize", value, size, __null, 0);
    var bytes = result == 0 ? value[0] : 0;
    _pep_free(value);
    _pep_free(size);
    return bytes;
}

# RUSAGE_SELF's struct rusage: two timevals, then ru_maxrss at byte 32 (144
# bytes in all), in kilobytes on Linux.
[Target(OS(Linux))]
_os_sys_peak_memory(): ulong {
    return _os_sys_max_rss() * 1024;
}

# macOS gives ru_maxrss in bytes.
[Target(OS(Mac))]
_os_sys_peak_memory(): ulong {
    return _os_sys_max_rss();
}

[Target(OS(Linux) || OS(Mac))]
_os_sys_max_rss(): ulong {
    __ptr<long> usage = _pep_malloc(144);
    var peak = getrusage(0, usage) == 0 && usage[4] > 0 ? usage[4] as ulong : 0;
    _pep_free(usage);
    return peak;
}

# sysconf's names: glibc's, and bionic's, which numbers them its own way.
[Target(OS(Linux) && !OS(Android))]
const _SC_PAGESIZE = 30;
[Target(OS(Linux) && !OS(Android))]
const _SC_PHYS_PAGES = 85;
[Target(OS(Android))]
const _SC_PAGESIZE = 39;
[Target(OS(Android))]
const _SC_PHYS_PAGES = 98;

# _SC_PAGESIZE: 30 on Linux (39 on Android), 29 on macOS.
[Target(OS(Linux))]
_os_sys_page_size(): ulong {
    return sysconf(_SC_PAGESIZE) as ulong;
}

[Target(OS(Mac))]
_os_sys_page_size(): ulong {
    return sysconf(29) as ulong;
}

# ── User ─────────────────────────────────────────────────────────────────────

# struct passwd starts with pw_name on both systems; pw_dir is at 32 on
# Linux and 48 on macOS (after pw_change and pw_class).
[Target(OS(Linux))]
const PASSWD_DIRECTORY_FIELD: ulong = 4;

[Target(OS(Mac))]
const PASSWD_DIRECTORY_FIELD: ulong = 6;

# The effective user's entry in the user database: field 0 is pw_name, and
# `field` picks another pointer-sized field. Empty when there is no entry.
[Target(OS(Linux) || OS(Mac))]
_os_passwd_field(field: ulong): String? {
    __ptr<__ptr<char>> entry = _pep_malloc(128);  # struct passwd: 48 or 72 bytes
    __ptr<__ptr<char>> result = _pep_malloc(8);
    ulong size = 1024;
    var found = Optional<String>.Empty;
    while (true) {
        __ptr<char> buffer = _pep_malloc(size);
        result[0] = __null;
        var error = getpwuid_r(geteuid(), entry, buffer, size, result);
        if (error == 34 && size < 1048576) {  # ERANGE: the buffer is too small
            _pep_free(buffer);
            size = size * 2;
            continue;
        }
        if (error == 0 && result[0] != __null && entry[field] != __null) {
            found = Optional<String>.Value(String(entry[field]));
        }
        _pep_free(buffer);
        break;
    }
    _pep_free(result);
    _pep_free(entry);
    return found;
}

[Target(OS(Linux) || OS(Mac))]
_os_sys_user_name(): String? {
    var name = _os_passwd_field(0);
    if (name.is_value() && !name.value().is_empty) {
        return name;
    }
    return _os_nonempty_environment("USER");
}

[Target(OS(Linux) || OS(Mac))]
_os_sys_is_elevated(): bool {
    return geteuid() == 0;
}

[Target(OS(Linux) || OS(Mac))]
_os_sys_home_directory(): String? {
    var home = _os_nonempty_environment("HOME");
    if (home.is_value()) {
        return home;
    }
    return _os_passwd_field(PASSWD_DIRECTORY_FIELD);
}
os/sys_wasi
4190
# WASI (WebAssembly) platform layer for os: the same `_os_sys_*` functions
# as sys_posix.pep and sys_windows.pep, each with [Target(OS(Wasi))]. WASI
# preview 1 has environment variables and clocks; it has no host name,
# user database, or memory and version queries, so those report nothing.

import "machine";
import "user";

[Target(OS(Wasi))]
extern char* getenv(char* name);
[Target(OS(Wasi))]
extern int setenv(char* name, char* value, int overwrite);
[Target(OS(Wasi))]
extern int unsetenv(char* name);
[Target(OS(Wasi))]
extern void* __wasilibc_get_environ();
[Target(OS(Wasi))]
extern ushort __wasi_clock_time_get(uint id, u64 precision, void* time);

# ── Environment ──────────────────────────────────────────────────────────────

[Target(OS(Wasi))]
_os_sys_environment(name: String): String? {
    __ptr<char> value = getenv(name.c_str());
    if (value == __null) {
        return Optional<String>.Empty;
    }
    return Optional<String>.Value(String(value));
}

# wasi-libc keeps the environment in the program's memory: a change stays
# inside the program.
[Target(OS(Wasi))]
_os_sys_set_environment(name: String, value: String) {
    if (setenv(name.c_str(), value.c_str(), 1) != 0) {
        panic($"cannot set environment variable '{name}': out of memory");
    }
}

[Target(OS(Wasi))]
_os_sys_remove_environment(name: String) {
    unsetenv(name.c_str());
}

# The `environ` array: NAME=VALUE strings, null-terminated. wasi-libc
# fills it from `environ_get` on first use.
[Target(OS(Wasi))]
export _os_environ(): __ptr<__ptr<char>> {
    return __wasilibc_get_environ();
}

[Target(OS(Wasi))]
_os_sys_environment_entries(): Array<String> {
    var entries = Array<String>();
    var values = _os_environ();
    if (values == __null) {
        return entries;
    }
    ulong index = 0;
    while (values[index] != __null) {
        entries.append(String(values[index]));
        index = index + 1;
    }
    return entries;
}

# ── Clocks ───────────────────────────────────────────────────────────────────

# WASI's clock ids: 0 is the wall clock, 1 the monotonic clock. The time
# is a 64-bit count of nanoseconds.
[Target(OS(Wasi))]
_os_clock_nanoseconds(clock: uint): u64 {
    __ptr<u64> time = _pep_malloc(8);
    time[0] = 0;
    __wasi_clock_time_get(clock, 1, time);
    var nanoseconds = time[0];
    _pep_free(time);
    return nanoseconds;
}

[Target(OS(Wasi))]
_os_sys_monotonic_nanoseconds(): ulong {
    return _os_clock_nanoseconds(1);
}

[Target(OS(Wasi))]
_os_sys_system_nanoseconds(): long {
    return _os_clock_nanoseconds(0) as long;
}

# ── Machine ──────────────────────────────────────────────────────────────────

[Target(OS(Wasi))]
_os_sys_os(): OperatingSystem {
    return OperatingSystem.Wasi;
}

[Target(OS(Wasi))]
_os_sys_version(): String {
    return String();
}

[Target(OS(Wasi))]
_os_sys_hostname(): String {
    return String();
}

[Target(OS(Wasi))]
_os_sys_total_memory(): ulong {
    return 0;
}

[Target(OS(Wasi))]
_os_sys_peak_memory(): ulong {
    return 0;
}

# WebAssembly's page: linear memory grows 64 KiB at a time.
[Target(OS(Wasi))]
_os_sys_page_size(): ulong {
    return 65536;
}

# ── User ─────────────────────────────────────────────────────────────────────

[Target(OS(Wasi))]
_os_sys_user_name(): String? {
    return _os_nonempty_environment("USER");
}

[Target(OS(Wasi))]
_os_sys_is_elevated(): bool {
    return false;
}

[Target(OS(Wasi))]
_os_sys_home_directory(): String? {
    return _os_nonempty_environment("HOME");
}
os/sys_windows
8646
# Windows platform layer for os: the same `_os_sys_*` functions as
# sys_posix.pep. Text crosses the Windows API as UTF-16 (the `W` functions)
# and is converted to UTF-8 with io's helpers.

import io;
import "machine";
import "user";

[Target(OS(Windows))]
extern uint GetEnvironmentVariableW(ushort* name, ushort* buffer, uint size);
[Target(OS(Windows))]
extern ushort* GetEnvironmentStringsW();
[Target(OS(Windows))]
extern int SetEnvironmentVariableW(ushort* name, ushort* value);
[Target(OS(Windows))]
extern int FreeEnvironmentStringsW(ushort* block);
[Target(OS(Windows))]
extern uint GetLastError();
[Target(OS(Windows))]
extern void SetLastError(uint code);
[Target(OS(Windows))]
extern int QueryPerformanceCounter(long* count);
[Target(OS(Windows))]
extern int QueryPerformanceFrequency(long* frequency);
[Target(OS(Windows))]
extern void GetSystemTimePreciseAsFileTime(void* time);
[Target(OS(Windows))]
extern int GetComputerNameExW(int format, ushort* buffer, uint* size);
[Target(OS(Windows))]
extern int GlobalMemoryStatusEx(void* status);
[Target(OS(Windows))]
extern void GetSystemInfo(void* info);
[Target(OS(Windows))]
extern void* GetCurrentProcess();
[Target(OS(Windows))]
extern int K32GetProcessMemoryInfo(void* process, void* counters, uint size);
[Target(OS(Windows))]
[Link("ntdll")]
extern int RtlGetVersion(void* info);
[Target(OS(Windows))]
[Link("advapi32")]
extern int GetUserNameW(ushort* buffer, uint* size);
[Target(OS(Windows))]
[Link("shell32")]
extern int IsUserAnAdmin();

# ── Environment ──────────────────────────────────────────────────────────────

[Target(OS(Windows))]
_os_sys_environment(name: String): String? {
    var wide_name = io._io_win_wide(name);
    uint capacity = 256;
    var found = Optional<String>.Empty;
    while (true) {
        __ptr<u16> buffer = _pep_malloc((capacity as ulong) * 2);
        # An empty value also returns 0, without setting an error.
        SetLastError(0);
        var length = GetEnvironmentVariableW(wide_name, buffer, capacity);
        if (length == 0) {
            if (GetLastError() != 203) {  # ERROR_ENVVAR_NOT_FOUND
                found = Optional<String>.Value(String());
            }
            _pep_free(buffer);
            break;
        }
        if (length < capacity) {
            found = Optional<String>.Value(io._io_win_narrow(buffer, length as int));
            _pep_free(buffer);
            break;
        }
        # Too small: `length` is the size needed, its NUL included.
        _pep_free(buffer);
        capacity = length;
    }
    _pep_free(wide_name);
    return found;
}

# The CRT's own copy of the environment (its `getenv`) does not see these
# changes; the runtime never reads it.
[Target(OS(Windows))]
_os_sys_set_environment(name: String, value: String) {
    var wide_name = io._io_win_wide(name);
    var wide_value = io._io_win_wide(value);
    var ok = SetEnvironmentVariableW(wide_name, wide_value);
    _pep_free(wide_value);
    _pep_free(wide_name);
    if (ok == 0) {
        panic($"cannot set environment variable '{name}': {io.IoError.last().message}");
    }
}

[Target(OS(Windows))]
_os_sys_remove_environment(name: String) {
    var wide_name = io._io_win_wide(name);
    SetEnvironmentVariableW(wide_name, __null);
    _pep_free(wide_name);
}

[Target(OS(Windows))]
_os_sys_environment_entries(): Array<String> {
    var entries = Array<String>();
    var block = GetEnvironmentStringsW();
    if (block == __null) {
        return entries;
    }
    # NAME=VALUE strings, each NUL-terminated, then an empty one.
    var start = 0;
    while (block[start] != 0) {
        var length = io._io_win_wide_len(block + start);
        entries.append(io._io_win_narrow(block + start, length));
        start = start + length + 1;
    }
    FreeEnvironmentStringsW(block);
    return entries;
}

# ── Clocks ───────────────────────────────────────────────────────────────────

[Target(OS(Windows))]
_os_sys_monotonic_nanoseconds(): ulong {
    __ptr<long> value = _pep_malloc(8);
    QueryPerformanceFrequency(value);
    var frequency = value[0] as ulong;
    QueryPerformanceCounter(value);
    var count = value[0] as ulong;
    _pep_free(value);
    # Split, so count * 10^9 cannot overflow.
    return (count / frequency) * 1000000000 + (count % frequency) * 1000000000 / frequency;
}

# A FILETIME counts 100-nanosecond ticks since 1601-01-01 UTC.
[Target(OS(Windows))]
_os_sys_system_nanoseconds(): long {
    __ptr<long> value = _pep_malloc(8);
    GetSystemTimePreciseAsFileTime(value);
    var ticks = value[0];
    _pep_free(value);
    return (ticks - 116444736000000000) * 100;
}

# ── Machine ──────────────────────────────────────────────────────────────────

[Target(OS(Windows))]
_os_sys_os(): OperatingSystem {
    return OperatingSystem.Windows;
}

# RTL_OSVERSIONINFOW: its size, then the major, minor and build numbers
# (276 bytes in all). GetVersionEx would report the version the program's
# manifest claims, not the system's.
[Target(OS(Windows))]
_os_sys_version(): String {
    __ptr<uint> info = _pep_malloc(276);
    info[0] = 276;
    var version = String();
    if (RtlGetVersion(info) == 0) {
        version = $"{info[1]}.{info[2]}.{info[3]}";
    }
    _pep_free(info);
    return version;
}

[Target(OS(Windows))]
_os_sys_hostname(): String {
    __ptr<uint> size = _pep_malloc(4);
    size[0] = 0;
    # ComputerNameDnsHostname. Asking with no buffer reports the size
    # needed, its NUL included.
    GetComputerNameExW(1, __null, size);
    var name = String();
    if (size[0] > 0) {
        __ptr<u16> buffer = _pep_malloc((size[0] as ulong) * 2);
        if (GetComputerNameExW(1, buffer, size) != 0) {
            name = io._io_win_narrow(buffer, size[0] as int);
        }
        _pep_free(buffer);
    }
    _pep_free(size);
    return name;
}

# MEMORYSTATUSEX: dwLength, dwMemoryLoad, then ullTotalPhys at byte 8
# (64 bytes in all).
[Target(OS(Windows))]
_os_sys_total_memory(): ulong {
    __ptr<uint> status = _pep_malloc(64);
    status[0] = 64;
    var bytes: ulong = 0;
    if (GlobalMemoryStatusEx(status) != 0) {
        __ptr<ulong> fields = unsafe_cast<__ptr<ulong>>(status);
        bytes = fields[1];
    }
    _pep_free(status);
    return bytes;
}

# PROCESS_MEMORY_COUNTERS: cb and PageFaultCount, then PeakWorkingSetSize
# at byte 8 (72 bytes in all).
[Target(OS(Windows))]
_os_sys_peak_memory(): ulong {
    __ptr<uint> counters = _pep_malloc(72);
    counters[0] = 72;
    var bytes: ulong = 0;
    if (K32GetProcessMemoryInfo(GetCurrentProcess(), counters, 72) != 0) {
        __ptr<ulong> fields = unsafe_cast<__ptr<ulong>>(counters);
        bytes = fields[1];
    }
    _pep_free(counters);
    return bytes;
}

# SYSTEM_INFO: two 16-bit fields, then dwPageSize at byte 4 (48 bytes in
# all on 64-bit Windows).
[Target(OS(Windows))]
_os_sys_page_size(): ulong {
    __ptr<uint> info = _pep_malloc(48);
    GetSystemInfo(info);
    var size = info[1] as ulong;
    _pep_free(info);
    return size;
}

# ── User ─────────────────────────────────────────────────────────────────────

[Target(OS(Windows))]
_os_sys_user_name(): String? {
    __ptr<uint> size = _pep_malloc(4);
    size[0] = 257;  # UNLEN + 1
    __ptr<u16> buffer = _pep_malloc(514);
    var found = Optional<String>.Empty;
    # On success `size` counts the NUL too.
    if (GetUserNameW(buffer, size) != 0 && size[0] > 1) {
        found = Optional<String>.Value(io._io_win_narrow(buffer, (size[0] - 1) as int));
    }
    _pep_free(buffer);
    _pep_free(size);
    if (found.is_value()) {
        return found;
    }
    return _os_nonempty_environment("USERNAME");
}

[Target(OS(Windows))]
_os_sys_is_elevated(): bool {
    return IsUserAnAdmin() != 0;
}

[Target(OS(Windows))]
_os_sys_home_directory(): String? {
    return _os_nonempty_environment("USERPROFILE");
}
os/time
18121
## Clocks and spans of time: `Duration`, `Instant` for measuring, and
## `SystemTime` for the wall clock.

import "sys_posix";
import "sys_wasi";
import "sys_windows";

const NANOSECONDS_PER_MICROSECOND: ulong = 1000;
const NANOSECONDS_PER_MILLISECOND: ulong = 1000000;
const NANOSECONDS_PER_SECOND: ulong = 1000000000;

## A span of time, counted in nanoseconds, like Rust's
## `std::time::Duration`. It is never negative and reaches about 584 years.
##
## Make one with `from_seconds`, `from_milliseconds`, `from_microseconds` or
## `from_nanoseconds`, or by subtracting two `Instant`s. A value struct: it
## is copied, compared with `==`, and allocates nothing.
##
## @example
##     import os;
##
##     main(): int {
##         var timeout = os.Duration.from_seconds(2) + os.Duration.from_milliseconds(500);
##         print(timeout.milliseconds());   # 2500
##         print(timeout);                  # 2.5s
##         return 0;
##     }
[Value]
export struct Duration {
    var _nanoseconds: ulong;

    ## Makes a zero-length duration.
    construct() {}

    ## Returns a duration of `nanoseconds` nanoseconds.
    ##
    ## @param nanoseconds the length in nanoseconds
    ## @returns the duration
    static from_nanoseconds(nanoseconds: ulong): Duration {
        var duration = Duration();
        duration._nanoseconds = nanoseconds;
        return duration;
    }

    ## Returns a duration of `microseconds` microseconds.
    ##
    ## @param microseconds the length in microseconds
    ## @returns the duration
    ## @panics if the duration does not fit in a `ulong` of nanoseconds
    static from_microseconds(microseconds: ulong): Duration {
        return Duration._scaled(microseconds, NANOSECONDS_PER_MICROSECOND);
    }

    ## Returns a duration of `milliseconds` milliseconds.
    ##
    ## @param milliseconds the length in milliseconds
    ## @returns the duration
    ## @panics if the duration does not fit in a `ulong` of nanoseconds
    static from_milliseconds(milliseconds: ulong): Duration {
        return Duration._scaled(milliseconds, NANOSECONDS_PER_MILLISECOND);
    }

    ## Returns a duration of `seconds` seconds.
    ##
    ## @param seconds the length in seconds
    ## @returns the duration
    ## @panics if the duration does not fit in a `ulong` of nanoseconds
    ##   (about 584 years)
    static from_seconds(seconds: ulong): Duration {
        return Duration._scaled(seconds, NANOSECONDS_PER_SECOND);
    }

    static _scaled(count: ulong, unit: ulong): Duration {
        assert(count <= 0xFFFFFFFFFFFFFFFF / unit, "os.Duration: the duration is too long");
        return Duration.from_nanoseconds(count * unit);
    }

    ## Returns the whole number of nanoseconds in this duration.
    ##
    ## @returns the length in nanoseconds
    nanoseconds(): ulong {
        return _nanoseconds;
    }

    ## Returns the whole number of microseconds in this duration, rounded
    ## down.
    ##
    ## @returns the length in microseconds
    microseconds(): ulong {
        return _nanoseconds / NANOSECONDS_PER_MICROSECOND;
    }

    ## Returns the whole number of milliseconds in this duration, rounded
    ## down.
    ##
    ## @returns the length in milliseconds
    milliseconds(): ulong {
        return _nanoseconds / NANOSECONDS_PER_MILLISECOND;
    }

    ## Returns the whole number of seconds in this duration, rounded down.
    ##
    ## @returns the length in seconds
    seconds(): ulong {
        return _nanoseconds / NANOSECONDS_PER_SECOND;
    }

    ## Returns this duration in seconds, with the fraction.
    ##
    ## @returns the length in seconds, as a `double`
    seconds_fraction(): double {
        return (_nanoseconds as double) / (NANOSECONDS_PER_SECOND as double);
    }

    ## Returns whether this duration is zero.
    ##
    ## @returns true for a zero-length duration
    is_zero(): bool {
        return _nanoseconds == 0;
    }

    ## Returns the sum of two durations.
    ##
    ## @param other the duration to add
    ## @returns the longer duration
    ## @panics if the sum does not fit in a `ulong` of nanoseconds
    +(other: Duration): Duration {
        var sum = _nanoseconds + other._nanoseconds;
        assert(sum >= _nanoseconds, "os.Duration: the duration is too long");
        return Duration.from_nanoseconds(sum);
    }

    ## Returns this duration less `other`.
    ##
    ## @param other the duration to take away
    ## @returns the difference
    ## @panics if `other` is longer than this duration: a duration is never
    ##   negative
    -(other: Duration): Duration {
        assert(other._nanoseconds <= _nanoseconds, "os.Duration: subtracting a longer duration");
        return Duration.from_nanoseconds(_nanoseconds - other._nanoseconds);
    }

    ## Returns this duration `times` times over.
    ##
    ## @param times the factor
    ## @returns the product
    ## @panics if the product does not fit in a `ulong` of nanoseconds
    *(times: ulong): Duration {
        if (_nanoseconds == 0) {
            return this;
        }
        return Duration._scaled(times, _nanoseconds);
    }

    ## Returns this duration split into `parts` equal parts, rounded down to
    ## a whole nanosecond.
    ##
    ## @param parts the divisor
    ## @returns the quotient
    ## @panics if `parts` is zero
    /(parts: ulong): Duration {
        assert(parts != 0, "os.Duration: dividing by zero");
        return Duration.from_nanoseconds(_nanoseconds / parts);
    }

    ## Returns whether this duration is shorter than `other`.
    ##
    ## @param other the duration to compare with
    ## @returns true when this one is shorter
    <(other: Duration): bool {
        return _nanoseconds < other._nanoseconds;
    }

    ## Returns whether this duration is shorter than or as long as `other`.
    ##
    ## @param other the duration to compare with
    ## @returns true when this one is not longer
    <=(other: Duration): bool {
        return _nanoseconds <= other._nanoseconds;
    }

    ## Returns whether this duration is longer than `other`.
    ##
    ## @param other the duration to compare with
    ## @returns true when this one is longer
    >(other: Duration): bool {
        return _nanoseconds > other._nanoseconds;
    }

    ## Returns whether this duration is longer than or as long as `other`.
    ##
    ## @param other the duration to compare with
    ## @returns true when this one is not shorter
    >=(other: Duration): bool {
        return _nanoseconds >= other._nanoseconds;
    }

    ## Returns this duration as text in the largest unit it reaches, with
    ## the fraction it needs and no trailing zeros: `2.5s`, `15ms`,
    ## `1.25µs`, `40ns`, `0s`.
    ##
    ## @returns the duration as text
    to_string(): String {
        if (_nanoseconds >= NANOSECONDS_PER_SECOND) {
            return _in_unit(NANOSECONDS_PER_SECOND, 9, "s");
        }
        if (_nanoseconds >= NANOSECONDS_PER_MILLISECOND) {
            return _in_unit(NANOSECONDS_PER_MILLISECOND, 6, "ms");
        }
        if (_nanoseconds >= NANOSECONDS_PER_MICROSECOND) {
            return _in_unit(NANOSECONDS_PER_MICROSECOND, 3, "µs");
        }
        if (_nanoseconds == 0) {
            return "0s";
        }
        return $"{_nanoseconds}ns";
    }

    # The whole units, then the fraction's `digits` digits without trailing
    # zeros.
    _in_unit(unit: ulong, digits: ulong, suffix: String): String {
        var whole = _nanoseconds / unit;
        var fraction = _nanoseconds % unit;
        if (fraction == 0) {
            return $"{whole}{suffix}";
        }
        var text = $"{fraction}";
        text = "0".repeat(digits - text.size) + text;
        var size = text.size;
        while (text.byte_at(size - 1) == '0') {
            size = size - 1;
        }
        return $"{whole}.{text.substr_bytes(0, size)}{suffix}";
    }
}

## A moment on a monotonic clock, for measuring how long something takes,
## like Rust's `std::time::Instant`.
##
## The clock only moves forward: setting the system's date and time does
## not change it. Its readings mean nothing by themselves, only the
## `Duration` between two of them, and they cannot be compared across
## processes or reboots. Use `SystemTime` for the date and time.
##
## The clock is `CLOCK_MONOTONIC` on Linux and macOS and
## `QueryPerformanceCounter` on Windows, read to the nanosecond.
##
## @example
##     import os;
##
##     main(): int {
##         var start = os.Instant.now();
##         var total = 0;
##         for (var i in 0..1000000) {
##             total = total + i;
##         }
##         var elapsed = os.Instant.now() - start;
##         print($"summed in {elapsed.milliseconds()} ms");
##         return 0;
##     }
[Value]
export struct Instant {
    var _nanoseconds: ulong;

    ## Makes the instant the clock started from; use `now()` to read the
    ## clock.
    construct() {}

    ## Reads the monotonic clock.
    ##
    ## @returns the current moment
    static now(): Instant {
        var instant = Instant();
        instant._nanoseconds = _os_sys_monotonic_nanoseconds();
        return instant;
    }

    ## Returns how long ago this instant was: `Instant.now() - this`.
    ##
    ## @returns the time since this instant
    elapsed(): Duration {
        return Instant.now() - this;
    }

    ## Returns the time from `earlier` to this instant.
    ##
    ## @param earlier an instant no later than this one
    ## @returns the time between them
    ## @panics if `earlier` is later than this instant
    -(earlier: Instant): Duration {
        assert(earlier._nanoseconds <= _nanoseconds, "os.Instant: subtracting a later instant");
        return Duration.from_nanoseconds(_nanoseconds - earlier._nanoseconds);
    }

    ## Returns the instant `duration` after this one.
    ##
    ## @param duration how far to move forward
    ## @returns the later instant
    ## @panics if the result does not fit the clock
    +(duration: Duration): Instant {
        var later = Instant();
        later._nanoseconds = _nanoseconds + duration._nanoseconds;
        assert(later._nanoseconds >= _nanoseconds, "os.Instant: the instant is out of range");
        return later;
    }

    ## Returns the instant `duration` before this one.
    ##
    ## @param duration how far to move back
    ## @returns the earlier instant
    ## @panics if the result is before the clock's start
    -(duration: Duration): Instant {
        assert(duration._nanoseconds <= _nanoseconds, "os.Instant: the instant is out of range");
        var earlier = Instant();
        earlier._nanoseconds = _nanoseconds - duration._nanoseconds;
        return earlier;
    }

    ## Returns whether this instant is earlier than `other`.
    ##
    ## @param other the instant to compare with
    ## @returns true when this one is earlier
    <(other: Instant): bool {
        return _nanoseconds < other._nanoseconds;
    }

    ## Returns whether this instant is earlier than or the same as `other`.
    ##
    ## @param other the instant to compare with
    ## @returns true when this one is not later
    <=(other: Instant): bool {
        return _nanoseconds <= other._nanoseconds;
    }

    ## Returns whether this instant is later than `other`.
    ##
    ## @param other the instant to compare with
    ## @returns true when this one is later
    >(other: Instant): bool {
        return _nanoseconds > other._nanoseconds;
    }

    ## Returns whether this instant is later than or the same as `other`.
    ##
    ## @param other the instant to compare with
    ## @returns true when this one is not earlier
    >=(other: Instant): bool {
        return _nanoseconds >= other._nanoseconds;
    }
}

## A date and time on the system's wall clock, counted in nanoseconds from
## the Unix epoch (1970-01-01 00:00:00 UTC), like Rust's
## `std::time::SystemTime`. It reaches from the year 1677 to 2262.
##
## The wall clock can jump, backwards too, when the system's time is set,
## so measure how long something takes with `Instant` instead. The `time`
## module turns it into dates, times of day and time zones, and back.
##
## @example
##     import os;
##
##     main(): int {
##         var now = os.SystemTime.now();
##         print($"{now.unix_seconds()} seconds since 1970");
##         return 0;
##     }
[Value]
export struct SystemTime {
    var _nanoseconds: long;

    ## Makes the Unix epoch, 1970-01-01 00:00:00 UTC.
    construct() {}

    ## Reads the wall clock.
    ##
    ## @returns the current date and time
    static now(): SystemTime {
        return SystemTime.from_unix_nanoseconds(_os_sys_system_nanoseconds());
    }

    ## Returns the time `nanoseconds` nanoseconds after the Unix epoch.
    ##
    ## @param nanoseconds nanoseconds since the epoch; negative for earlier
    ##   times
    ## @returns the time
    static from_unix_nanoseconds(nanoseconds: long): SystemTime {
        var time = SystemTime();
        time._nanoseconds = nanoseconds;
        return time;
    }

    ## Returns the time `seconds` seconds after the Unix epoch, as file
    ## systems and most protocols record it.
    ##
    ## @param seconds seconds since the epoch; negative for earlier times
    ## @returns the time
    ## @panics if the time is outside the years 1677 to 2262
    static from_unix_seconds(seconds: long): SystemTime {
        var limit = 9223372036 as long;
        assert(seconds <= limit && seconds >= 0 - limit, "os.SystemTime: the time is out of range");
        return SystemTime.from_unix_nanoseconds(seconds * (NANOSECONDS_PER_SECOND as long));
    }

    ## Returns the nanoseconds from the Unix epoch to this time.
    ##
    ## @returns nanoseconds since the epoch; negative for earlier times
    unix_nanoseconds(): long {
        return _nanoseconds;
    }

    ## Returns the milliseconds from the Unix epoch to this time, rounded
    ## down (towards the past).
    ##
    ## @returns milliseconds since the epoch; negative for earlier times
    unix_milliseconds(): long {
        return _floor_divide(NANOSECONDS_PER_MILLISECOND as long);
    }

    ## Returns the seconds from the Unix epoch to this time, rounded down
    ## (towards the past).
    ##
    ## @returns seconds since the epoch; negative for earlier times
    unix_seconds(): long {
        return _floor_divide(NANOSECONDS_PER_SECOND as long);
    }

    _floor_divide(unit: long): long {
        var quotient = _nanoseconds / unit;
        if (_nanoseconds % unit < 0) {
            quotient = quotient - 1;
        }
        return quotient;
    }

    ## Returns the time from `earlier` to this time, or none when `earlier`
    ## is later: the wall clock can be set back between two readings.
    ##
    ## @param earlier the time to measure from
    ## @returns the time between them, or none when `earlier` is later
    duration_since(earlier: SystemTime): Duration? {
        if (earlier._nanoseconds > _nanoseconds) {
            return Optional<Duration>.Empty;
        }
        var span = (_nanoseconds - earlier._nanoseconds) as ulong;
        return Optional<Duration>.Value(Duration.from_nanoseconds(span));
    }

    ## Returns how long ago this time was on the wall clock, or none when it
    ## is in the future.
    ##
    ## @returns the time since this one, or none when it is later than now
    elapsed(): Duration? {
        return SystemTime.now().duration_since(this);
    }

    ## Returns the time `duration` after this one.
    ##
    ## @param duration how far to move forward
    ## @returns the later time
    ## @panics if the result is after the year 2262
    +(duration: Duration): SystemTime {
        var limit = 9223372036854775807 as ulong;
        assert(
            duration._nanoseconds <= limit && _nanoseconds <= (limit - duration._nanoseconds) as long,
            "os.SystemTime: the time is out of range"
        );
        return SystemTime.from_unix_nanoseconds(_nanoseconds + duration._nanoseconds as long);
    }

    ## Returns the time `duration` before this one.
    ##
    ## @param duration how far to move back
    ## @returns the earlier time
    ## @panics if the result is before the year 1677
    -(duration: Duration): SystemTime {
        var limit = 9223372036854775807 as ulong;
        assert(
            duration._nanoseconds <= limit && _nanoseconds >= (0 - 9223372036854775807) + duration._nanoseconds as long,
            "os.SystemTime: the time is out of range"
        );
        return SystemTime.from_unix_nanoseconds(_nanoseconds - duration._nanoseconds as long);
    }

    ## Returns whether this time is earlier than `other`.
    ##
    ## @param other the time to compare with
    ## @returns true when this one is earlier
    <(other: SystemTime): bool {
        return _nanoseconds < other._nanoseconds;
    }

    ## Returns whether this time is earlier than or the same as `other`.
    ##
    ## @param other the time to compare with
    ## @returns true when this one is not later
    <=(other: SystemTime): bool {
        return _nanoseconds <= other._nanoseconds;
    }

    ## Returns whether this time is later than `other`.
    ##
    ## @param other the time to compare with
    ## @returns true when this one is later
    >(other: SystemTime): bool {
        return _nanoseconds > other._nanoseconds;
    }

    ## Returns whether this time is later than or the same as `other`.
    ##
    ## @param other the time to compare with
    ## @returns true when this one is not earlier
    >=(other: SystemTime): bool {
        return _nanoseconds >= other._nanoseconds;
    }
}
os/user
2318
## The user the program runs as: their name, directories, and whether they
## have administrator rights.

import io;
import "environment";
import "sys_posix";
import "sys_wasi";
import "sys_windows";

## Returns the name of the user the program runs as: on POSIX the login
## name of the effective user id (from the user database, else `USER`),
## on Windows `GetUserNameW`'s answer (else `USERNAME`), and on WASI
## `USER`.
##
## @returns the user name, or none when it cannot be found
export user_name(): String? {
    return _os_sys_user_name();
}

## Returns whether the program runs with administrator rights: on POSIX,
## as root (effective user id 0); on Windows, from an elevated
## ("Run as administrator") process of a member of Administrators
## (`IsUserAnAdmin`); never on WASI. Tools that need them, such as a
## profiler that reads kernel events, check this to say so up front.
##
## @returns true when the program runs as root or elevated
export is_elevated(): bool {
    return _os_sys_is_elevated();
}

## Returns the user's home directory: on POSIX `HOME`, or the user
## database's entry when `HOME` is unset or empty; on Windows
## `USERPROFILE`; on WASI `HOME`.
##
## @returns the home directory, or none when it cannot be found
## @example
##     import os;
##
##     main(): int {
##         var home = os.home_directory();
##         if (home) {
##             print(home.value().join(".config").to_string());
##         }
##         return 0;
##     }
export home_directory(): io.Path? {
    var path = _os_sys_home_directory();
    if (path.is_empty() || path.value().is_empty) {
        return Optional<io.Path>.Empty;
    }
    return Optional<io.Path>.Value(io.Path(path.value()));
}

## Returns the directory for temporary files: `TMPDIR` or `/tmp` on POSIX
## (`/data/local/tmp` on Android), `GetTempPathW` on Windows. The same as `io.Directory.temp()`.
##
## @returns the temporary directory
export temp_directory(): io.Path {
    return io.Directory.temp();
}

# A variable's value when it is set and not empty.
_os_nonempty_environment(name: String): String? {
    var value = environment(name);
    if (value.is_value() && value.value().is_empty) {
        return Optional<String>.Empty;
    }
    return value;
}
priority_queue
7165
## `PriorityQueue`: a binary heap that hands out its greatest element first.

import "array";
import "map";

# A binary max-heap in `_heap`: the parent of element `i` is `(i - 1) / 2`,
# and no element sorts after its parent under `_compare`, so element 0 is
# the greatest.

## A priority queue: `push` adds elements in any order and `pop` removes
## the greatest one.
##
## A binary heap over an `Array`: `push` and `pop` take O(log count),
## `peek` takes O(1), and building a queue from an array takes O(count).
## Use it for Dijkstra's and A* searches, schedulers, timers and top-k
## selection.
##
## Elements are ordered by `compare<T>` (numbers by value, `String` by
## content, a `Comparable` struct by its `compare`), or by a comparer given
## to the constructor, which returns a negative number, zero or a positive
## number as its first argument sorts before, with or after its second. The
## greatest element comes out first; reverse the comparer for the smallest
## first. Elements that sort together come out in no particular order.
##
## For a struct `T` the queue holds a counted reference to each element:
## pushing acquires it, and popping hands the queue's reference to the
## caller. A `PriorityQueue` is not `[Shared]`: keep each one on one
## thread.
##
## @typeParam T the element type
## @example
##     PriorityQueue<int> queue = [3, 1, 4];
##     queue.push(5);
##     assert(queue.pop() == 5, "the greatest first");
##     assert(queue.peek() == 4, "then 4");
##
##     # The smallest first, through a reversed comparer.
##     var earliest = PriorityQueue<int>((a, b) => b.compare(a));
##     earliest.push(30);
##     earliest.push(10);
##     assert(earliest.pop() == 10, "the smallest first");
export struct PriorityQueue<T> {
    ## The heap: each element sorts with or before its parent. Internal.
    T[] _heap;
    ## The order: negative, zero or positive as the first argument sorts
    ## before, with or after the second. Internal.
    (T, T) => int _compare;

    ## Creates an empty queue ordered by `compare<T>`.
    construct() {
        _compare = compare<T>;
    }

    ## Creates an empty queue ordered by `compare`.
    ##
    ## @param compare returns a negative number, zero or a positive number
    ##   as its first argument sorts before, with or after its second
    ## @example
    ##     var by_length = PriorityQueue<String>((a, b) => a.length.compare(b.length));
    construct(compare: (T, T) => int) {
        _compare = compare;
    }

    ## Creates a queue holding the elements of `items`, ordered by
    ## `compare<T>`. O(count). The array is copied, not shared.
    ##
    ## The constructor is `[Implicit]`: an array converts to a queue
    ## wherever a queue is expected, so an array literal can initialize one.
    ##
    ## @param items the elements, in any order
    [Implicit]
    construct(items: T[]) {
        _compare = compare<T>;
        _heapify(items);
    }

    ## Creates a queue holding the elements of `items`, ordered by
    ## `compare`. O(count). The array is copied, not shared.
    ##
    ## @param items the elements, in any order
    ## @param compare returns a negative number, zero or a positive number
    ##   as its first argument sorts before, with or after its second
    construct(items: T[], compare: (T, T) => int) {
        _compare = compare;
        _heapify(items);
    }

    # Takes a copy of `items` as the heap and sifts each parent down, from
    # the last up: O(count).
    _heapify(items: T[]) {
        _heap = items.clone();
        ulong parent = _heap.count / 2;
        while (parent > 0) {
            parent = parent - 1;
            _sift_down(parent, _heap.count);
        }
    }

    # Whether element `a` sorts after element `b`.
    _after(a: ulong, b: ulong): bool {
        return _compare(_heap[a], _heap[b]) > 0;
    }

    # Moves element `index` up until it sorts with or before its parent.
    _sift_up(index: ulong) {
        while (index > 0) {
            ulong parent = (index - 1) / 2;
            if (!_after(index, parent)) {
                return;
            }
            _heap.swap(index, parent);
            index = parent;
        }
    }

    # Moves element `index` down, within the first `end` elements, until
    # neither child sorts after it.
    _sift_down(index: ulong, end: ulong) {
        while (true) {
            ulong largest = index;
            ulong left = index * 2 + 1;
            ulong right = left + 1;
            if (left < end and _after(left, largest)) {
                largest = left;
            }
            if (right < end and _after(right, largest)) {
                largest = right;
            }
            if (largest == index) {
                return;
            }
            _heap.swap(index, largest);
            index = largest;
        }
    }

    ## The number of elements.
    var count: ulong {
        get {
            return _heap.count;
        }
    }

    ## Whether the queue has no elements.
    var is_empty: bool {
        get {
            return _heap.is_empty;
        }
    }

    ## Adds `item`. O(log count), amortized.
    ##
    ## @param item the element to add
    push(item: T) {
        _heap.append(item);
        _sift_up(_heap.count - 1);
    }

    ## Removes and returns the greatest element. O(log count).
    ##
    ## @returns the greatest element
    ## @panics if the queue is empty ("PriorityQueue pop on empty
    ##   PriorityQueue")
    pop(location: __ptr<char> = __caller_location()): T {
        assert(!_heap.is_empty, "PriorityQueue pop on empty PriorityQueue", location);
        _heap.swap(0, _heap.count - 1);
        var top = _heap.pop();
        _sift_down(0, _heap.count);
        return top;
    }

    ## Returns the greatest element without removing it. O(1).
    ##
    ## @returns the greatest element
    ## @panics if the queue is empty ("PriorityQueue peek on empty
    ##   PriorityQueue")
    peek(location: __ptr<char> = __caller_location()): T {
        assert(!_heap.is_empty, "PriorityQueue peek on empty PriorityQueue", location);
        return _heap[0];
    }

    ## Removes every element, releasing each one.
    clear() {
        _heap.clear();
    }

    ## Removes every element and returns them sorted from smallest to
    ## greatest. O(count log count). The queue is left empty, keeping its
    ## comparer.
    ##
    ## @returns the elements in ascending order
    ## @example
    ##     PriorityQueue<int> queue = [2, 3, 1];
    ##     var sorted = queue.into_sorted_array();   # [1, 2, 3]
    into_sorted_array(): T[] {
        # Heap sort: the greatest of the first `end` elements moves to the
        # end of them, one at a time.
        ulong end = _heap.count;
        while (end > 1) {
            end = end - 1;
            _heap.swap(0, end);
            _sift_down(0, end);
        }
        var sorted = _heap;
        _heap = Array<T>();
        return sorted;
    }
}
