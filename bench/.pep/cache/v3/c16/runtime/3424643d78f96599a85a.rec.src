# ── Name resolution ──────────────────────────────────────────────────────────

[Target(OS(Wasi))]
_io_sys_resolve(host: String, port: u16): IoResult<SocketAddress[]> {
    return IoResult<SocketAddress[]>.err(_io_wasi_no_sockets());
